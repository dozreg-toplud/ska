open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- **`SixD` with the jump at no entry.** -/
abbrev SixDN (lib : Lib) (N : Needs) (env : CallEnv) (P : Noun → Prop) (f : Noun) (nm : Nomm) (k : Nat) : Prop :=
  ∀ {sup : Option Nomm} {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S},
    1 ≤ g0.bo → g0.drop = false → UpBelow g0 → Clear g0 → CondBelow g0 →
    runLC env sup nm (CGoalL.done : CGoalL S) region g0 = some (nex, g1) →
    RunOKGB lib N P f (CGoal.done : CGoal S) g0 g1 nex ∧ (entries nex.laz).length ≤ k ∧
      nex.th.there ∉ (entries nex.laz).map Prod.fst

/-- **`DoneE` from `DoneOK` and a result without entries**, the shape in
which track J's `tailN_done` (`DoneOK`) plugs in. -/
theorem doneE_of {lib : Lib} {N : Needs} {env : CallEnv} {P : Noun → Prop} {f : Noun} {nm : Nomm}
    (H : ∀ {sup : Option Nomm} {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S},
      1 ≤ g0.bo → g0.drop = false → UpBelow g0 → Clear g0 → CondBelow g0 →
      runLC env sup nm (CGoalL.done : CGoalL S) region g0 = some (nex, g1) → DoneOK lib N P f g0 g1 nex)
    (E : ∀ {sup : Option Nomm} {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S},
      1 ≤ g0.bo → g0.drop = false → UpBelow g0 → Clear g0 → CondBelow g0 →
      runLC env sup nm (CGoalL.done : CGoalL S) region g0 = some (nex, g1) → entries nex.laz = []) :
    DoneE (S := S) (Map := Map) lib N env P f nm :=
  fun b0 d0 hu hcl hcb hr => ⟨H b0 d0 hu hcl hcb hr, E b0 d0 hu hcl hcb hr⟩

