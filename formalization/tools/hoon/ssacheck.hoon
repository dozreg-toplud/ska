      [19 %s [0 [[1 2] [[3 4] 5]]] [7 [[6 [[0 12] [[0 2] [6 [[5 [[0 14] [1 5]]] [[5 [[0 14] [1 5]]] [0 1]]]]]]] [6 [[0 6] [[0 6] [0 2]]]]]]]
  ==
=*  cas  ,[nam=* kind=@tas sub=* fol=*]
=/  tx=(list cas)
  %+  turn  ta
  |=(c=[nam=@ud kind=@tas sub=* fol=*] ^-(cas [[%a nam.c] %k sub.c fol.c]))
=/  ty=(list cas)
  %-  zing
  ^-  (list (list cas))
  %+  weld
    %+  turn  tb
    |=  c=[nam=@ud kind=@tas sub=* fol=*]
    ^-  (list cas)
    ~[[[%b nam.c] %u sub.c fol.c] [[%b nam.c] %k sub.c fol.c]]
  %+  turn  tc
  |=  c=[nam=@ud kind=@tas sub=* fol=*]
  ^-  (list cas)
  ~[[[%c nam.c] %u sub.c fol.c] [[%c nam.c] %k sub.c fol.c]]
=.  cases  (weld `(list cas)`cases (weld tx ty))
::  AliasSSA of lemmas/Ska/OptAliasField.lean on a map of blocks
::
::  dst: the register an op writes (aliasDst); reads: its other registers,
::  the first occurrence of dst removed (aliasReads)
::
=/  dst
  |=  op=*
  ^-  (unit @uvre)
  ?.  ?=([@ *] op)  ~
  ?+  -.op  ~
    %imm  `;;(@uvre +>.op)
    %mov  `;;(@uvre +>.op)
    %inc  `;;(@uvre +>.op)
    %hed  `;;(@uvre +>.op)
    %tal  `;;(@uvre +>.op)
    %con  `;;(@uvre +>+.op)
    %spy  `;;(@uvre +>+.op)
    %nok  `;;(@uvre +>+.op)
    %cal  `;;(@uvre +>+.op)
    %csl  `;;(@uvre +>+.op)
    %caf  `;;(@uvre +>+<.op)
    %cam  `;;(@uvre +>+<.op)
    %csf  `;;(@uvre +>+<.op)
    %csm  `;;(@uvre +>+<.op)
  ==
=/  reads
  |=  op=pole
  ^-  (list @uvre)
  =/  l  (get-regs op)
  =/  d  (dst op)
  ?~  d  l
  =/  i  (find ~[u.d] l)
  ?~  i  l
  (oust [u.i 1] l)
=/  bdefs  |=(b=blob ^-((list @uvre) (weld par.b (murn `(list *)`body.b dst))))
=/  dupes
  |=  all=(list @uvre)
  ^-  (list @uvre)
  =|  saw=(set @uvre)
  =|  out=(list @uvre)
  |-  ^-  (list @uvre)
  ?~  all  out
  ?:  (~(has in saw) i.all)  $(all t.all, out [i.all out])
  $(all t.all, saw (~(put in saw) i.all))
=/  argset
  |=  n=@ud
  ^-  (set @uvre)
  =|  s=(set @uvre)
  |-  ^-  (set @uvre)
  ?:  =(0 n)  s
  $(n (dec n), s (~(put in s) (dec n)))
::  DefFirst: a forward must-analysis over bb-topo, a block's start the
::  intersection of its predecessors' ends (rev-cfg) and its parameters,
::  block 0 starting with .ent; a read of r (where .only allows r) must
::  find r defined.  Returns the reads checked and the failures [o i r]
::
=/  first
  |=  [bl=(map @uwoo blob) ent=(set @uvre) only=(unit (set @uvre))]
  ^-  [nread=@ud bad=(list [@uwoo @ud @uvre])]
  =/  topo  (bb-topo bl)
  =/  rev  (rev-cfg bl (sy topo))
  =|  out=(map @uwoo (set @uvre))
  =|  bad=(list [@uwoo @ud @uvre])
  =|  nr=@ud
  |-  ^-  [nread=@ud bad=(list [@uwoo @ud @uvre])]
  ?~  topo  [nr bad]
  =/  o  i.topo
  =/  b  (~(got by bl) o)
  =/  ps  (~(get ja rev) o)
  =/  sin=(set @uvre)
    ?:  =(`@`0 o)  ent
    ?~  ps  ent
    =/  acc  (~(got by out) i.ps)
    =/  t  t.ps
    |-  ^-  (set @uvre)
    ?~  t  acc
    $(t t.t, acc (~(int in acc) (~(got by out) i.t)))
  =/  def=(set @uvre)  (~(gas in sin) par.b)
  =/  chk  |=(r=@uvre ?~(only & (~(has in u.only) r)))
  =/  body  body.b
  =|  i=@ud
  |-  ^-  [nread=@ud bad=(list [@uwoo @ud @uvre])]
  ?~  body
    =/  fr  (skim (get-regs fin.b) chk)
    %=  ^$
      topo  t.topo
      out  (~(put by out) o def)
      nr  (add nr (lent fr))
      bad  (weld (murn fr |=(r=@uvre ?:((~(has in def) r) ~ `[o i r]))) bad)
    ==
  =/  rs  (skim (reads i.body) chk)
  =/  d  (dst i.body)
  %=  $
    body  t.body
    i  +(i)
    nr  (add nr (lent rs))
    bad  (weld (murn rs |=(r=@uvre ?:((~(has in def) r) ~ `[o i r]))) bad)
    def  ?~(d def (~(put in def) u.d))
  ==
::  DefOnceB, the weaker form, on the blocks reachable from 0 (bb-topo): a
::  register has at most one definition that is not a dead fill.  A dead
::  fill of x is an %imm into x in a block that ends in %bom, followed there
::  by %imm ops only, with every read of x in that block before it (the
::  fill of +crash-need: [%cel a] [%imm 0 x] .. [%bom ~], where x is a or a
::  fresh register).  Returns the registers that fail it
::
=/  onceb
  |=  bl=(map @uwoo blob)
  ^-  (list @uvre)
  =/  bs  (turn (bb-topo bl) |=(o=@uwoo [o (~(got by bl) o)]))
  =/  ds=(list [r=@uvre o=@uwoo i=(unit @ud) bom=?])
    %-  zing
    %+  turn  bs
    |=  [o=@uwoo b=blob]
    ^-  (list [r=@uvre o=@uwoo i=(unit @ud) bom=?])
    =/  bom=?  =(%bom -.fin.b)
    =/  body=(list *)  body.b
    =|  i=@ud
    =/  out=(list [r=@uvre o=@uwoo i=(unit @ud) bom=?])
      (turn par.b |=(r=@uvre [r o ~ |]))
    |-  ^+  out
    ?~  body  out
    =/  d  (dst i.body)
    =/  fil=?  &(bom (levy `(list *)`body |=(op=* ?=([%imm *] op))))
    $(body t.body, i +(i), out ?~(d out [[u.d o `i fil] out]))
  =/  rs=(list [r=@uvre o=@uwoo i=@ud])
    %-  zing
    %+  turn  bs
    |=  [o=@uwoo b=blob]
    ^-  (list [r=@uvre o=@uwoo i=@ud])
    =/  body  body.b
    =|  i=@ud
    =|  out=(list [r=@uvre o=@uwoo i=@ud])
    |-  ^+  out
    ?~  body  (weld (turn (get-regs fin.b) |=(r=@uvre [r o i])) out)
    $(body t.body, i +(i), out (weld (turn (reads i.body) |=(r=@uvre [r o i])) out))
  =/  dup  (dupes (turn ds |=([r=@uvre *] r)))
  %+  skip  dup
  |=  x=@uvre
  =/  dx  (skim ds |=([r=@uvre o=@uwoo i=(unit @ud) bom=?] =(r x)))
  =/  rx  (skim rs |=([r=@uvre o=@uwoo i=@ud] =(r x)))
  =/  dead
    |=  [r=@uvre o=@uwoo i=(unit @ud) bom=?]
    ?&  bom
        ?=(^ i)
        (levy rx |=([r=@uvre o2=@uwoo i2=@ud] &(=(o2 o) (lth i2 u.i))))
    ==
  (lte (lent (skip dx dead)) 1)
::  the checks on one map: DefOnce, DefFirst (the Lean form: no register at
::  the entry, only registers with a definition checked), DefFirst with the
::  arguments 0 .. n-args - 1 defined at the entry and every read checked
::  (firstx), and argument registers that have a definition (argdef)
::
=*  res  ,[defs=@ud reads=@ud allreads=@ud once=? onceb=? first=? firstx=? argdef=?]
=/  ck
  |=  [nam=* kind=@tas tag=* n=@ud bl=(map @uwoo blob)]
  ^-  res
  =/  all=(list @uvre)  (zing (turn ~(val by bl) bdefs))
  =/  dup  (dupes all)
  =/  as  (argset n)
  =/  f1  (first bl ~ `(~(gas in *(set @uvre)) all))
  =/  f2  (first bl as ~)
  =/  ad  (skim all |=(r=@uvre (~(has in as) r)))
  =/  ob  (onceb bl)
  ~?  !=(~ dup)  [%once-fail nam kind tag dup]
  ~?  !=(~ ob)  [%onceb-fail nam kind tag ob]
  ~?  !=(~ bad.f1)  [%first-fail nam kind tag bad.f1]
  ~?  !=(~ bad.f2)  [%firstx-fail nam kind tag bad.f2]
  ~?  !=(~ ad)  [%argdef nam kind tag ad]
  [(lent all) nread.f1 nread.f2 =(~ dup) =(~ ob) =(~ bad.f1) =(~ bad.f2) =(~ ad)]
=*  row  ,[n=@ud defs=@ud reads=@ud allreads=@ud once=@ud onceb=@ud first=@ud firstx=@ud argdef=@ud]
=/  tally
  |=  [m=(map @tas row) tag=@tas r=res]
  ^-  (map @tas row)
  =/  w=row  (~(gut by m) tag *row)
  %+  ~(put by m)  tag
  :*  +(n.w)  (add defs.w defs.r)  (add reads.w reads.r)  (add allreads.w allreads.r)
      ?:(once.r once.w +(once.w))  ?:(onceb.r onceb.w +(onceb.w))  ?:(first.r first.w +(first.w))
      ?:(firstx.r firstx.w +(firstx.w))  ?:(argdef.r argdef.w +(argdef.w))
  ==
=|  tal=(map @tas row)
=|  ncomp=@ud
|-  ^-  @
?~  cases
  ~&  [%summary comp=ncomp]
  ~&  [%tally ~(tap by tal)]
  0
=^  [func=bell new=(list [pax=path tem=sock clue=*])]  long-ska.state
  (ska-poke [?:(?=(%k kind.i.cases) [& sub.i.cases] [| ~]) ?>(?=(^ fol.i.cases) fol.i.cases)] long-ska.state ~(key by jets-hot.state))
=^  scc=(set bell)  sccs.cache.state
  (scc-of func calls.long-ska.state sccs.cache.state)
=^  raw=straight  cache.state  (compiled-mono func scc)
=.  ncomp  +(ncomp)
=/  nam  nam.i.cases
=/  kind  kind.i.cases
=/  n  n-args.raw
=.  tal  (tally tal %raw (ck nam kind %raw n blocks.raw))
=/  s=straight  raw
=|  r=@ud
|-  ^-  @
=/  topo  (bb-topo blocks.s)
=/  rev  (rev-cfg blocks.s (sy topo))
=^  [topo=(list @uwoo) rev=(jar @uwoo @uwoo) tl=(map @tas row)]  blocks.s
  |-  ^-  [[(list @uwoo) (jar @uwoo @uwoo) (map @tas row)] (map @uwoo blob)]
  =^  c-hops=?  blocks.s  (remove-hops blocks.s rev topo)
  =.  tal  (tally tal %hops (ck nam kind [%hops r] n blocks.s))
  =^  c-branch=?  blocks.s  (remove-useless-branching blocks.s)
  =.  tal  (tally tal %rub (ck nam kind [%rub r] n blocks.s))
  =^  c-middle=?  blocks.s  (remove-empty-middle blocks.s)
  =.  tal  (tally tal %mid (ck nam kind [%mid r] n blocks.s))
  ?.  |(c-hops c-branch c-middle)  [[topo rev tal] blocks.s]
  =.  topo  (bb-topo blocks.s)
  =.  rev  (rev-cfg blocks.s (sy topo))
  $
=.  tal  tl
=.  tal  (tally tal %alias-in (ck nam kind [%alias-in r] n blocks.s))
=^  f-alias=?  blocks.s  (alias n-args.s blocks.s rev topo)
=.  tal  (tally tal %alias-out (ck nam kind [%alias-out r] n blocks.s))
=.  topo  (skim topo ~(has by blocks.s))
=.  rev  (rev-cfg blocks.s (sy topo))
=.  blocks.s  (trim-trace-hints blocks.s topo rev)
=.  tal  (tally tal %trim (ck nam kind [%trim r] n blocks.s))
=.  blocks.s  (remove-dead-code blocks.s (flop topo))
=.  tal  (tally tal %dead (ck nam kind [%dead r] n blocks.s))
=^  c-hops=?  blocks.s  (remove-hops blocks.s rev topo)
=.  tal  (tally tal %hops2 (ck nam kind [%hops2 r] n blocks.s))
=^  c-branch=?  blocks.s  (remove-useless-branching blocks.s)
=.  tal  (tally tal %rub2 (ck nam kind [%rub2 r] n blocks.s))
=^  c-middle=?  blocks.s  (remove-empty-middle blocks.s)
=.  tal  (tally tal %mid2 (ck nam kind [%mid2 r] n blocks.s))
?:  |(f-alias c-hops c-branch c-middle)  $(r +(r))
^$(cases t.cases)
