      [61 %r [1 [5 [7 8]]] [10 [[6 [0 7]] [7 [[6 [[5 [[0 15] [1 5]]] [[6 [[0 2] [[0 7] [0 2]]]] [6 [[3 [0 6]] [[6 [[3 [0 6]] [[0 2] [6 [[0 2] [[0 0] [0 7]]]]]]] [0 7]]]]]]] [6 [[1 1] [[5 [[0 7] [1 5]]] [6 [[1 1] [[0 6] [1 1]]]]]]]]]]]]
      [62 %r [0 [5 9]] [[7 [[6 [[3 [0 7]] [[5 [[0 3] [0 3]]] [6 [[1 1] [[6 [[1 1] [[5 [[0 12] [0 0]]] [6 [[1 0] [[0 1] [0 6]]]]]]] [6 [[5 [[0 1] [1 5]]] [[3 [0 6]] [5 [[1 1] [1 [0 1]]]]]]]]]]]]] [6 [[5 [[1 1] [1 5]]] [[[7 [[1 5] [0 6]]] [5 [[0 14] [0 3]]]] [6 [[3 [0 7]] [[5 [[0 14] [0 3]]] [7 [[1 5] [0 6]]]]]]]]]]] [6 [[5 [[0 1] [1 5]]] [[3 [0 6]] [5 [[1 1] [1 [0 1]]]]]]]]]
      [63 %r [1 [5 [7 8]]] [4 [7 [[6 [[6 [[0 2] [[1 0] [1 1]]]] [[6 [[7 [[0 14] [1 0]]] [[1 [0 1]] [6 [[0 2] [[0 3] [1 1]]]]]]] [6 [[5 [[0 2] [1 5]]] [[6 [[0 2] [[0 3] [1 1]]]] [1 [0 1]]]]]]]] [6 [[5 [[0 2] [1 5]]] [[[6 [[0 2] [[1 0] [0 7]]]] [1 5]] [6 [[6 [[0 2] [[1 0] [1 1]]]] [[1 5] [6 [[0 2] [[1 0] [0 7]]]]]]]]]]]]]]
      [64 %s [1 [5 [7 8]]] [7 [[6 [[0 2] [[0 14] [6 [[0 2] [[6 [[0 2] [[0 3] [1 1]]]] [1 [0 1]]]]]]]] [6 [[0 2] [[1 0] [0 7]]]]]]]
      [65 %r [1 [5 [7 8]]] [7 [[6 [[3 [0 2]] [[6 [[0 2] [[0 12] [0 2]]]] [6 [[3 [0 2]] [[4 [0 1]] [6 [[1 1] [[0 12] [0 15]]]]]]]]]] [[6 [[1 0] [[10 [[7 [0 13]] [0 15]]] [[1 1] [1 5]]]]] [6 [[5 [[1 1] [1 5]]] [[4 [0 3]] [0 3]]]]]]]]
      [66 %r [0 [5 9]] [7 [[6 [[1 0] [[6 [[1 0] [[6 [[1 0] [[0 2] [0 1]]]] [6 [[0 2] [[0 6] [0 2]]]]]]] [6 [[6 [[1 1] [[1 1] [0 2]]]] [[6 [[0 2] [[0 6] [0 2]]]] [6 [[1 0] [[0 2] [0 1]]]]]]]]]] [4 [6 [[6 [[1 1] [[1 1] [0 2]]]] [[0 0] [10 [[1 [1 0]] [1 1]]]]]]]]]]
      [67 %r [1 [5 [7 8]]] [4 [7 [[6 [[6 [[0 2] [[0 2] [0 2]]]] [[6 [[0 2] [[0 2] [0 1]]]] [6 [[0 2] [[6 [[0 2] [[[1 [0 1]] [1 [0 1]]] [3 [0 3]]]]] [4 [1 0]]]]]]]] [4 [6 [[1 0] [[6 [[0 2] [[1 0] [0 6]]]] [4 [0 15]]]]]]]]]]
      [68 %r [0 [[1 2] [[3 4] 5]]] [7 [[6 [[0 2] [[6 [[0 2] [[[0 2] [0 12]] [3 [1 5]]]]] [0 2]]]] [5 [[6 [[6 [[1 0] [[0 2] [1 1]]]] [[5 [[0 13] [0 13]]] [10 [[6 [1 1]] [0 3]]]]]] [6 [[1 0] [[1 [0 1]] [6 [[0 2] [[1 [0 1]] [1 1]]]]]]]]]]]]
      [69 %r [0 [[1 2] [[3 4] 5]]] [10 [[6 [6 [[7 [[0 12] [1 1]]] [[6 [[0 2] [[0 1] [0 6]]]] [6 [[1 0] [[0 6] [0 2]]]]]]]] [7 [[6 [[3 [1 0]] [[6 [[6 [[1 0] [[0 2] [1 1]]]] [[0 14] [6 [[0 2] [[0 1] [0 3]]]]]]] [6 [[6 [[0 2] [[1 1] [1 1]]]] [[6 [[0 2] [[0 1] [0 3]]]] [0 14]]]]]]] [6 [[6 [[0 2] [[1 1] [1 1]]]] [[[0 2] [6 [[1 1] [[0 15] [0 6]]]]] [6 [[3 [1 0]] [[6 [[1 1] [[0 15] [0 6]]]] [0 2]]]]]]]]]]]]
      [70 %r [0 [5 9]] [4 [7 [[6 [[1 0] [[6 [[1 1] [[4 [0 2]] [6 [[1 0] [[1 5] [0 6]]]]]]] [6 [[6 [[1 1] [[0 2] [0 2]]]] [[6 [[1 0] [[1 5] [0 6]]]] [4 [0 2]]]]]]]] [5 [[6 [[6 [[1 1] [[0 2] [0 2]]]] [[6 [[1 1] [[1 0] [0 6]]]] [[0 14] [0 13]]]]] [3 [1 5]]]]]]]]
      [71 %r [0 [5 9]] [[7 [[6 [[1 0] [[6 [[5 [[1 0] [1 5]]] [[3 [0 7]] [[1 0] [0 1]]]]] [6 [[1 1] [[1 0] [1 1]]]]]]] [5 [[6 [[1 0] [[6 [[1 1] [[0 15] [0 1]]]] [5 [[0 6] [0 6]]]]]] [0 2]]]]] [0 2]]]
      [72 %r [0 [[1 2] [[3 4] 5]]] [7 [[6 [[0 2] [[6 [[1 1] [[6 [[0 2] [[1 0] [0 14]]]] [6 [[1 1] [[1 1] [0 7]]]]]]] [6 [[0 2] [[6 [[1 1] [[1 1] [0 7]]]] [6 [[0 2] [[1 0] [0 14]]]]]]]]]] [6 [[0 2] [[3 [0 7]] [3 [1 [0 1]]]]]]]]]
      [73 %r [0 [[1 2] [[3 4] 5]]] [4 [7 [[6 [[6 [[0 2] [[1 1] [1 1]]]] [[0 13] [6 [[3 [0 15]] [[6 [[1 1] [[0 14] [0 6]]]] [6 [[0 2] [[0 3] [1 0]]]]]]]]]] [4 [6 [[7 [[0 6] [1 1]]] [[[0 14] [1 [0 1]]] [6 [[1 1] [[0 13] [1 5]]]]]]]]]]]]
  ==
::  the other formulas of this directory: fix.hoon (17 raw, 5 of hoon.hoon),
::  deadcrash.hoon (9), proxy-dump.hoon (2); %u with the subject unknown, %k
::  with it known
=/  more=(list [nam=@ud kind=@tas sub=* fol=*])
  =/  spot  [11 [%spot 1 0] 0 0]
  =/  raw=(list [sub=* fol=*])
    :~  [0 [11 [[1 0] 1 0] 1 42]]
        [42 [2 [0 1] 7 [0 0] 1 0 1]]
        [42 [2 [0 1] 7 [0 1] 1 0 1]]
        [0 [5 spot 0]]
        [0 [2 spot 0]]
        [0 [7 spot 0]]
        [0 [6 [1 1] 0 [1 42]]]
        [0 [6 [1 0] 0 [1 42]]]
        [0 [6 spot 0 0]]
        [0 [10 [2 0] [1 1 2]]]
        [0 [11 [%spot 1 0] 0]]
        [0 [12 [1 0] 0]]
        [0 [[1 1] 0]]
        [0 [8 [1 1] 0]]
        [0 [11 %bare 1 42]]
        [0 [11 %bare 11 [%spot 1 0] 0 0]]
        [7 [7 [0 1] 11 %bare 4 0 1]]
        [0 [7 [0 2] [1 5]]]
        [0 [7 [[0 2] [0 3]] [1 5]]]
        [[1 2] [7 [4 [0 1]] [1 5]]]
        [[1 2] [7 [0 6] [1 5]]]
        [[1 2] [8 [4 [0 1]] [1 5]]]
        [0 [6 [1 0] [7 [0 3] [1 5]] [1 6]]]
        [0 [7 [10 [2 [1 1]] [0 1]] [1 5]]]
        [0 [7 [5 [0 2] [0 3]] [1 5]]]
        [0 [7 [0 2] [7 [4 [1 1]] [1 5]]]]
        [[1 0 0 5] [7 [6 [0 2] [1 0] [6 [0 6] [0 7] [0 1]]] [6 [0 2] [0 3] [0 1]]]]
        [[0 5] [7 [4 [0 3]] [6 [5 [0 1] [1 6]] [0 1] [1 5]]]]
        ::  trace hints (%spot, %mean) around formulas that cannot crash;
        ::  on these +trim-trace-hints dropped nothing (2026-11-24)
        [[1 2] [11 [1.953.460.339 1 0] 0 2]]
        [[1 2] [11 [1.851.876.717 1 0] 0 3]]
        [0 [11 [1.953.460.339 1 0] 1 5]]
        [[1 2] [11 [1.953.460.339 1 0] 11 [1.851.876.717 1 7] [0 3] [0 2]]]
    ==
  =/  hon=(list *)
    =>  ..ska-poke
    :~  !=((add 2 3))
        !=((dec 0))
        !=((roll (gulf 1 6) add))
        !:(!=(~|([%a (add 1 2)] (dec 0))))
        !=((sort ~[3 1 2] lth))
    ==
  =|  i=@ud
  =|  out=(list [nam=@ud kind=@tas sub=* fol=*])
  |-  ^+  out
  ?^  raw
    $(raw t.raw, i +(i), out [[(add 100 i) %k i.raw] [(add 100 i) %u i.raw] out])
  ?~  hon  (flop out)
  $(hon t.hon, i +(i), out [[(add 100 i) %u ..ska-poke i.hon] out])
=.  cases  (weld cases more)
::  the model of lemmas/Ska/OptSwitch.lean (switchChains), written again
::  with lists, on the blocks as nouns (the library's list types do not
::  fuse with ours): usesOf, testOf, chainOf, plainOf, plainsOf, casesOf
::  (hsort, casesAcc), stree, nexOf, freshIds, switchTag, switchPlain,
::  switchWalk
::
=*  mb  ,[par=(list @) body=(list *) fin=*]
=/  m-ment
  |=  b=blob
  ^-  (list @uvre)
  =/  x=(list @uvre)  (get-regs fin.b)
  =/  y=(list @uvre)  (zing (turn `(list $%(pole termin))`body.b get-regs))
  =/  z=(list @uvre)  par.b
  (weld z (weld x y))
=/  m-uses
  |=  [bl=(map @uwoo blob) r=@]
  ^-  @ud
  =/  l=(list @)  (zing (turn ~(val by bl) m-ment))
  (lent (skim l |=(x=@ =(x r))))
=/  m-small  |=(n=* ^-((unit @) ?.(?=(@ n) ~ ?.((lth n (bex 31)) ~ `n))))
=*  mt  ,[s=@ c=@ hit=@ miss=@ y=@ d=@ r=@]
=*  mp  ,[d=@ c=@ hit=@ miss=@ r=@]
=*  mc  ,[c=@ hit=@ r=@]
=/  m-test
  |=  [bl0=(map @uwoo blob) bl=(map @ mb) rev=(jar @uwoo @uwoo) p=@]
  ^-  (unit mt)
  =/  b  (~(got by bl) p)
  =/  f  fin.b
  ?.  ?=([%clq @ [~ @] [~ @]] f)  ~
  =/  y  +.+>-.f
  =/  n  +.+>+.f
  ?.  =((~(get ja rev) y) ~[p])  ~
  =/  yb  (~(got by bl) y)
  ?.  =(~ par.yb)  ~
  =/  g  fin.yb
  ?.  ?=([%eqq @ @ [~ @] [~ @]] g)  ~
  ?.  =(n +.+>+>.g)  ~
  =/  bod  body.yb
  ?.  ?=([* * ~] bod)  ~
  =/  i0  i.bod
  =/  i1  i.t.bod
  =/  h=(unit [@ @])
    ?:  ?=([%hed @ @] i0)  `[+<.i0 +>.i0]
    ?:  ?=([%hed @ @] i1)  `[+<.i1 +>.i1]
    ~
  =/  m=(unit [* @])
    ?:  ?=([%imm * @] i0)  `[+<.i0 +>.i0]
    ?:  ?=([%imm * @] i1)  `[+<.i1 +>.i1]
    ~
  ?~  h  ~
  ?~  m  ~
  ?.  =(-.u.h +<.f)  ~
  =/  c  (m-small -.u.m)
  ?~  c  ~
  ?.  |(=([+<.g +>-.g] [+.u.h +.u.m]) =([+<.g +>-.g] [+.u.m +.u.h]))  ~
  ?.  &(=(2 (m-uses bl0 +.u.h)) =(2 (m-uses bl0 +.u.m)))  ~
  `[+<.f u.c +.+>+<.g n y +.u.h +.u.m]
=/  m-chain
  |=  [bl0=(map @uwoo blob) bl=(map @ mb) rev=(jar @uwoo @uwoo) p=@]
  ^-  (list mt)
  =/  t  (m-test bl0 bl rev p)
  ?~  t  ~
  :-  u.t
  =/  nb  (~(got by bl) miss.u.t)
  ?.  &(=(~ par.nb) =(~ body.nb))  ~
  =/  rm  (~(get ja rev) miss.u.t)
  ?.  |(=(rm ~[p y.u.t]) =(rm ~[y.u.t p]))  ~
  =/  t2  (m-test bl0 bl rev miss.u.t)
  ?~  t2  ~
  ?.  =(s.u.t2 s.u.t)  ~
  $(p miss.u.t)
=/  m-imm-into
  |=  [l=@ r=@ bod=(list *)]
  ^-  (unit [* @])
  ?~  bod  ~
  =/  i  i.bod
  ?:  &(?=([%imm * @] i) |(=(+>.i l) =(+>.i r)))  `[+<.i +>.i]
  $(bod t.bod)
=/  m-plain
  |=  [bl0=(map @uwoo blob) bl=(map @ mb) p=@]
  ^-  (unit mp)
  =/  b  (~(got by bl) p)
  =/  g  fin.b
  ?.  ?=([%eqq @ @ [~ @] [~ @]] g)  ~
  =/  m  (m-imm-into +<.g +>-.g body.b)
  ?~  m  ~
  =/  c  (m-small -.u.m)
  ?~  c  ~
  ?:  =(+<.g +>-.g)  ~
  ?.  =(2 (m-uses bl0 +.u.m))  ~
  `[?:(=(+.u.m +<.g) +>-.g +<.g) u.c +.+>+<.g +.+>+>.g +.u.m]
=/  m-plains
  |=  [bl0=(map @uwoo blob) bl=(map @ mb) rev=(jar @uwoo @uwoo) p=@]
  ^-  (list [p=@ t=mp])
  =/  t  (m-plain bl0 bl p)
  ?~  t  ~
  :-  [p u.t]
  =/  nb  (~(got by bl) miss.u.t)
  ?.  =(~ par.nb)  ~
  =/  bod  body.nb
  ?.  ?=([[%imm *] ~] bod)  ~
  ?.  =((~(get ja rev) miss.u.t) ~[p])  ~
  =/  t2  (m-plain bl0 bl miss.u.t)
  ?~  t2  ~
  ?.  =(d.u.t2 d.u.t)  ~
  $(p miss.u.t)
=/  m-hsort
  |=  l=(list mc)
  ^-  (list mc)
  ?~  l  ~
  =/  p  (skim t.l |=(x=mc (lth c.x c.i.l)))
  =/  q  (skip t.l |=(x=mc (lth c.x c.i.l)))
  (weld $(l p) [i.l $(l q)])
=/  m-cases
  |=  ces=(list mc)
  =|  [saw=(list @) acc=(list mc)]
  |-  ^-  (list mc)
  ?~  ces  (m-hsort acc)
  ?^  (find ~[c.i.ces] saw)  $(ces t.ces)
  $(ces t.ces, saw [c.i.ces saw], acc [i.ces acc])
=/  m-tree
  |=  [d=@ mis=@ cas=(list mc) ids=(list @) out=(map @ *)]
  ^-  [(list *) * (list @) (map @ *)]
  ?>  ?=(^ cas)
  ?~  t.cas
    [~[[%imm c.i.cas r.i.cas]] [%eqq d r.i.cas [~ hit.i.cas] [~ mis]] ids out]
  =/  haf  (div (lent cas) 2)
  =/  hi  (slag haf `(list mc)`cas)
  ?>  ?=(^ hi)
  ?>  ?=([* * *] ids)
  =/  l  $(cas (scag haf `(list mc)`cas), ids t.t.ids)
  =/  lout  (~(put by +>+.l) i.ids [~ -.l +<.l])
  =/  r  $(cas hi, ids +>-.l, out lout)
  [~ [%lti c.i.hi d [~ i.ids] [~ i.t.ids]] +>-.r (~(put by +>+.r) i.t.ids [~ -.r +<.r])]
=/  m-fresh
  |=  [ids=(list @) ned=@ud nex=@]
  |-  ^-  [(list @) @]
  ?:  (gte (lent ids) ned)  [ids nex]
  $(ids [nex ids], nex +(nex))
=/  m-switch
  |=  bl0=(map @uwoo blob)
  ^-  (map @ *)
  =/  bl  ;;((map @ mb) bl0)
  =/  topo=(list @)  (bb-topo bl0)
  =/  rev  (rev-cfg bl0 (sy (bb-topo bl0)))
  =/  out=(map @ *)  bl
  =|  done=(list @)
  =/  ks=(list @)  ~(tap in ~(key by bl))
  =/  nex=@  (roll ks |=([o=@ m=@] ?:((gte o m) +(o) m)))
  |-  ^-  (map @ *)
  ?~  topo  out
  ?^  (find ~[i.topo] done)  $(topo t.topo)
  =/  cs=(list mt)  (m-chain bl0 bl rev i.topo)
  ?:  (gte (lent cs) 4)
    ?>  ?=(^ cs)
    =/  mis  miss:(rear cs)
    =/  ids=(list @)  (weld (turn t.cs |=(t=mt y.t)) (turn (snip `(list mt)`cs) |=(t=mt miss.t)))
    =.  done  (weld ids done)
    =.  out  (roll ids |=([o=@ a=_out] (~(del by a) o)))
    =/  cas  (m-cases (turn `(list mt)`cs |=(t=mt [c hit r]:t)))
    =/  nod  (m-tree d.i.cs mis cas ids out)
    =.  out  (~(put by +>+.nod) y.i.cs [~ [[%hed s.i.cs d.i.cs] -.nod] +<.nod])
    =/  b  (~(got by bl) i.topo)
    =.  out  (~(put by out) i.topo [par.b body.b [%clq s.i.cs [~ y.i.cs] [~ mis]]])
    $(topo t.topo)
  =/  ps=(list [p=@ t=mp])  (m-plains bl0 bl rev i.topo)
  ?:  (lth (lent ps) 4)  $(topo t.topo)
  ?>  ?=(^ ps)
  =/  mis  miss.t:(rear ps)
  =/  old=(list @)  (turn t.ps |=([p=@ *] p))
  =.  done  (weld old done)
  =.  out  (roll old |=([o=@ a=_out] (~(del by a) o)))
  =/  cas  (m-cases (turn `(list [p=@ t=mp])`ps |=(x=[p=@ t=mp] [c hit r]:t.x)))
  =/  ned  (sub (mul 2 (lent cas)) 2)
  =/  fr  (m-fresh (scag ned old) ned nex)
  =.  nex  +.fr
  =/  nod  (m-tree d.t.i.ps mis cas -.fr out)
  =/  b  (~(got by bl) i.topo)
  =/  bod=(list *)  (skip body.b |=(op=* &(?=([%imm * @] op) =(+>.op r.t.i.ps))))
  =.  out  (~(put by +>+.nod) i.topo [par.b (weld bod -.nod) +<.nod])
  $(topo t.topo)
=|  cnt=[n=@ud fired=@ud lti=@ud mis=@ud]
|-  ^-  @
?~  cases
  ~&  [%summary cnt]
  0
=^  [func=bell new=(list [pax=path tem=sock clue=*])]  long-ska.state
  (ska-poke [?:(?=(%k kind.i.cases) [& sub.i.cases] [| ~]) ?>(?=(^ fol.i.cases) fol.i.cases)] long-ska.state ~(key by jets-hot.state))
=^  scc=(set bell)  sccs.cache.state
  (scc-of func calls.long-ska.state sccs.cache.state)
=^  raw=straight  cache.state  (compiled-mono func scc)
=/  pre=straight
  =/  s=straight  raw
  |-  ^-  straight
  =/  o  (optimize-once s)
  ?.  -.o  +.o
  $(s +.o)
=/  bo=(map @uwoo blob-out)  (switch-chains blocks.pre)
=/  mo  (m-switch blocks.pre)
=/  nl=@ud  (lent (skim ~(val by bo) |=(b=blob-out ?=(%lti -.fin.b))))
=.  n.cnt  +(n.cnt)
=.  lti.cnt  (add lti.cnt nl)
=?  fired.cnt  !=(`*`bo `*`blocks.pre)  +(fired.cnt)
=?  mis.cnt  !=(`*`mo `*`bo)  +(mis.cnt)
~?  !=(`*`mo `*`bo)  [%model-differs nam.i.cases kind.i.cases]
$(cases t.cases)
