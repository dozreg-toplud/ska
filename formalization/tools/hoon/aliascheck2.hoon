::  the other formulas of this directory: fix.hoon (17 raw, 5 of hoon.hoon),
::  deadcrash.hoon (9), proxy-dump.hoon (2); %u with the subject unknown, %k
::  with it known
=/  more=(list [nam=* kind=@tas sub=* fol=*])
  =/  spot  [11 [%spot 1 0] 0 0]
  =/  raw=(list [sub=* fol=*])
    :~  [0 [11 [[1 0] 1 0] 1 42]]
        [42 [2 [0 1] 7 [0 0] 1 0 1]]
        [42 [2 [0 1] 7 [0 1] 1 0 1]]
        [0 [5 spot 0]]
        [0 [2 spot 0]]
        [0 [7 spot 0]]
        [0 [6 [1 1] 0 [1 42]]]
        [0 [6 [1 0] 0 [1 42]]]
        [0 [6 spot 0 0]]
        [0 [10 [2 0] [1 1 2]]]
        [0 [11 [%spot 1 0] 0]]
        [0 [12 [1 0] 0]]
        [0 [[1 1] 0]]
        [0 [8 [1 1] 0]]
        [0 [11 %bare 1 42]]
        [0 [11 %bare 11 [%spot 1 0] 0 0]]
        [7 [7 [0 1] 11 %bare 4 0 1]]
        [0 [7 [0 2] [1 5]]]
        [0 [7 [[0 2] [0 3]] [1 5]]]
        [[1 2] [7 [4 [0 1]] [1 5]]]
        [[1 2] [7 [0 6] [1 5]]]
        [[1 2] [8 [4 [0 1]] [1 5]]]
        [0 [6 [1 0] [7 [0 3] [1 5]] [1 6]]]
        [0 [7 [10 [2 [1 1]] [0 1]] [1 5]]]
        [0 [7 [5 [0 2] [0 3]] [1 5]]]
        [0 [7 [0 2] [7 [4 [1 1]] [1 5]]]]
        [[1 0 0 5] [7 [6 [0 2] [1 0] [6 [0 6] [0 7] [0 1]]] [6 [0 2] [0 3] [0 1]]]]
        [[0 5] [7 [4 [0 3]] [6 [5 [0 1] [1 6]] [0 1] [1 5]]]]
        ::  trace hints (%spot, %mean) around formulas that cannot crash;
        ::  on these +trim-trace-hints dropped nothing (2026-11-24)
        [[1 2] [11 [1.953.460.339 1 0] 0 2]]
        [[1 2] [11 [1.851.876.717 1 0] 0 3]]
        [0 [11 [1.953.460.339 1 0] 1 5]]
        [[1 2] [11 [1.953.460.339 1 0] 11 [1.851.876.717 1 7] [0 3] [0 2]]]
    ==
  =/  hon=(list *)
    =>  ..ska-poke
    :~  !=((add 2 3))
        !=((dec 0))
        !=((roll (gulf 1 6) add))
        !:(!=(~|([%a (add 1 2)] (dec 0))))
        !=((sort ~[3 1 2] lth))
    ==
  =|  i=@ud
  =|  out=(list [nam=* kind=@tas sub=* fol=*])
  |-  ^+  out
  ?^  raw
    $(raw t.raw, i +(i), out [[(add 100 i) %k i.raw] [(add 100 i) %u i.raw] out])
  ?~  hon  (flop out)
  $(hon t.hon, i +(i), out [[(add 100 i) %u ..ska-poke i.hon] out])
=.  cases  (weld cases more)
=/  sp  |=(f=* [11 [%spot 1 0] f])
=/  acases=(list [nam=@tas fol=* subs=(list *)])
  :~  [%mov [7 [0 2] [0 1]] ~[[1 2] 5]]
      [%mov-cons [[0 2] [0 2] [0 3]] ~[[1 2] 5]]
      [%eq-self [6 [5 [0 1] [0 1]] [1 1] [1 2]] ~[0 [1 2]]]
      [%eq-self-push [8 [0 1] [6 [5 [0 2] [0 2]] [1 1] [1 2]]] ~[0 [1 2]]]
      [%cell-twice [6 [3 0 1] [6 [3 0 1] [1 1] [1 2]] [1 3]] ~[0 [1 2]]]
      [%cell-twice-hed [6 [3 0 1] [6 [3 0 2] [1 1] [1 2]] [6 [3 0 1] [1 3] [1 4]]] ~[0 [1 2] [[1 2] 3]]]
      [%loob-yes [6 [0 1] [6 [0 1] [1 5] [1 6]] [1 7]] ~[0 1 2 [1 2]]]
      [%loob-no [6 [0 1] [1 7] [6 [0 1] [1 5] [1 6]]] ~[0 1 2 [1 2]]]
      [%loob-push [8 [5 [0 2] [0 3]] [6 [0 2] [1 5] [1 6]]] ~[[1 1] [1 2] 0]]
      [%loob-push2 [8 [5 [0 2] [0 3]] [6 [0 2] [6 [0 2] [1 5] [1 6]] [1 7]]] ~[[1 1] [1 2] 0]]
      [%loob-join [8 [6 [3 0 1] [1 0] [1 1]] [6 [0 2] [1 5] [1 6]]] ~[0 [1 2]]]
      [%nonloob-join [8 [6 [3 0 1] [1 7] [1 7]] [6 [0 2] [1 5] [1 6]]] ~[0 [1 2]]]
      [%nonloob-join2 [8 [6 [3 0 1] [1 7] [1 9]] [6 [0 2] [1 5] [1 6]]] ~[0 [1 2]]]
      [%nonloob-inc [8 [4 0 1] [6 [5 [0 2] [1 0]] [1 5] [6 [0 2] [1 6] [1 7]]]] ~[0 1 5]]
      [%join-cell [7 [6 [5 [0 2] [1 0]] [0 1] [0 1]] [6 [3 0 1] [1 1] [1 2]]] ~[0 [0 2] [1 2]]]
      [%join-cell-one [7 [6 [3 0 1] [0 1] [0 1]] [6 [3 0 1] [1 1] [1 2]]] ~[0 [0 2] [1 2]]]
      [%join-hed [8 [6 [3 0 1] [0 2] [0 1]] [[0 2] [0 6]]] ~[0 [0 2] [[1 2] 3]]]
      [%hed-twice [[0 2] [0 2] [0 3] [0 3]] ~[0 [1 2]]]
      [%hed-cons [7 [[0 1] [1 5]] [0 2]] ~[0 [1 2]]]
      [%inc-dec [7 [4 0 1] [0 1]] ~[0 5 [1 2]]]
      [%imm-twice [[1 5] [1 5] [1 6]] ~[0]]
      [%imm-join [8 [6 [3 0 1] [1 5] [1 5]] [[0 2] [1 5]]] ~[0 [1 2]]]
      [%drop-block [6 [0 1] [6 [0 1] [0 0] [1 6]] [1 7]] ~[0 1 2]]
      [%spot-fold (sp [6 [3 0 1] [6 [3 0 1] [0 2] [0 0]] [0 0]]) ~[0 [1 2] [[1 2] 3]]]
      [%spot-loob (sp [6 [0 1] [6 [0 1] (sp [0 0]) [1 6]] (sp [0 2])]) ~[0 1 2 [1 2]]]
      [%spot-join [7 [6 [3 0 1] (sp [0 2]) (sp [4 0 1])] (sp [0 2])] ~[0 [1 2] [[1 2] 3]]]
      [%spot-brn (sp [8 [5 [0 2] [0 3]] [6 [0 2] (sp [0 0]) [1 6]]]) ~[[1 1] [1 2] 0]]
      [%spot-nonloob (sp [8 [6 [3 0 1] [1 7] [1 7]] [6 [0 2] [1 5] [1 6]]]) ~[0 [1 2]]]
      ::  facts at a block with two predecessors: agreeing, disagreeing, one side
      ::
      [%j-agree-cell [6 [3 0 1] [7 [6 [5 [0 2] [1 0]] [0 1] [0 1]] [6 [3 0 1] [1 4] [1 5]]] [1 3]] ~[0 [0 2] [1 2]]]
      [%j-agree-cell3 [6 [3 0 3] [7 [6 [5 [0 2] [1 0]] [0 1] [0 1]] [6 [3 0 3] [1 4] [1 5]]] [1 3]] ~[0 [0 2] [1 2] [1 2 3]]]
      [%j-agree-loob [6 [0 2] [7 [6 [5 [0 3] [1 0]] [0 1] [0 1]] [6 [0 2] [1 4] [1 5]]] [1 3]] ~[[0 0] [1 0] [0 1] [2 0]]]
      [%j-agree-hed [8 [0 2] [7 [6 [5 [0 7] [1 0]] [0 1] [0 1]] [[0 6] [0 2]]]] ~[0 [0 2] [1 0] [1 2 3]]]
      [%j-agree-imm [8 [4 0 2] [7 [6 [5 [0 7] [1 0]] [0 1] [0 1]] [6 [5 [0 2] [4 0 6]] [1 4] [1 5]]]] ~[0 [0 2] [1 0] [1 2 3]]]
      [%j-disagree-loob [7 [6 [0 2] [0 1] [0 1]] [6 [0 2] [1 4] [1 5]]] ~[[0 0] [1 0] [2 0] 0]]
      [%j-one-cell [7 [6 [5 [0 2] [1 0]] [6 [3 0 3] [0 1] [0 0]] [0 1]] [6 [3 0 3] [1 4] [1 5]]] ~[[0 0] [0 1 2] [1 0] [1 1 2] 0]]
      [%j-two-cell [7 [6 [5 [0 2] [1 0]] [6 [3 0 3] [0 1] [0 0]] [6 [3 0 3] [0 1] [0 0]]] [6 [3 0 3] [1 4] [1 5]]] ~[[0 0] [0 1 2] [1 0] [1 1 2] 0]]
      [%j-par-agree [8 [6 [5 [0 2] [1 0]] [0 3] [0 3]] [6 [3 0 2] [1 4] [1 5]]] ~[[0 0] [0 1 2] [1 0] [1 1 2] 0]]
      [%j-par-loob [8 [6 [3 0 1] [5 [0 2] [0 3]] [1 1]] [6 [0 2] [1 4] [1 5]]] ~[0 [1 2] [1 1]]]
      ::  aimed at a %brn on a known non-loobean ([%bom ~])
      ::
      [%bom-a [6 [8 [1 7] [0 2]] [1 4] [1 5]] ~[0]]
      [%bom-b [8 [1 7] [7 [6 [3 0 3] [0 1] [0 1]] [6 [0 2] [1 4] [1 5]]]] ~[0 [1 2]]]
      [%bom-c [8 [6 [3 0 1] [1 7] [0 0]] [6 [0 2] [1 4] [1 5]]] ~[0 [1 2]]]
  ==
=.  cases
  %+  weld  cases
  ^-  (list [nam=* kind=@tas sub=* fol=*])
  %-  zing
  %+  turn  acases
  |=  [nam=@tas fol=* subs=(list *)]
  ^-  (list [nam=* kind=@tas sub=* fol=*])
  [[nam %u 0 fol] (turn subs |=(s=* [nam %k s fol]))]
::  the model of lemmas/Ska/OptAliasModel.lean (aliasM) written again on
::  nouns, with lists for the sets of registers, maps for the functions,
::  the join pointwise (jrege), the member of a set the root of its treap
::  (pick), rev.gen deduplicated in list order (dedup), not in +tap:in order
::
=*  mb  ,[par=(list @) body=(list *) fin=*]
=*  jm  ,[args=(list (unit @)) there=@]
=*  inf  ,[cel=? lob=? hof=(list @) tof=(list @) hh=(unit @) ht=(unit @) dof=(unit @) imm=(unit *)]
=/  i0=inf  [| | ~ ~ ~ ~ ~ ~]
=*  rm  (map @ inf)
=*  im  (map * (list @))
=*  gen  ,[new=(map @ mb) old=(map @ @) info=(map @ rm) imms=(map @ im) rev=(map @ (list @)) folded=?]
=*  bst  ,[old=(map @ @) loc=rm imml=im]
=/  mem  |=([x=@ l=(list @)] ?=(^ (find ~[x] l)))
=/  ins  |=([l=(list @) x=@] ^-((list @) ?:((mem x l) l [x l])))
=/  pick  |=(l=(list @) ^-(@ =/(s (silt l) ?>(?=(^ s) n.s))))
=/  dedup
  |=  l=(list @)
  ^-  (list @)
  ?~  l  ~
  =/  r  $(l t.l)
  ?:((mem i.l r) r [i.l r])
=/  erase
  |=  [l=(list @) x=@]
  ^-  (list @)
  ?~  l  ~
  ?:  =(i.l x)  t.l
  [i.l $(l t.l)]
=/  delju
  |=  [r=(map @ (list @)) k=@ o=@]
  ^-  (map @ (list @))
  (~(put by r) k (erase (~(gut by r) k ~) o))
=/  jab
  |=  [m=rm k=@ g=$-(inf inf)]
  ^-  rm
  (~(put by m) k (g (~(got by m) k)))
=/  jreg
  |=  [a=inf b=inf]
  ^-  inf
  :*  &(cel.a cel.b)
      &(|(lob.a ?=([~ ?] imm.a)) |(lob.b ?=([~ ?] imm.b)))
      (skim hof.a |=(x=@ (mem x hof.b)))
      (skim tof.a |=(x=@ (mem x tof.b)))
      ?:(=(hh.a hh.b) hh.a ~)
      ?:(=(ht.a ht.b) ht.a ~)
      ?:(=(dof.a dof.b) dof.a ~)
      ?:(=(imm.a imm.b) imm.a ~)
  ==
=/  jrege  |=([a=inf b=inf] ^-(inf ?:(=(a b) a (jreg a b))))
=/  pinfo
  |=  l=(list (unit inf))
  ^-  inf
  =/  have=(list inf)  (murn l same)
  ?~  have  i0
  =/  j=inf  (roll t.have |:([a=i0 b=i.have] (jreg a b)))
  ?:  =((lent have) (lent l))  j
  j(hof ~, tof ~, hh ~, ht ~, dof ~)
=/  jinfo
  |=  [a=rm b=rm]
  ^-  rm
  %-  ~(gas by *rm)
  %+  murn  ~(tap by a)
  |=  [k=@ v=inf]
  ^-  (unit [@ inf])
  ?~  w=(~(get by b) k)  ~
  `[k (jrege v u.w)]
=/  jimms
  |=  [a=im b=im]
  ^-  im
  %-  ~(gas by *im)
  %+  murn  ~(tap by a)
  |=  [k=* v=(list @)]
  ^-  (unit [* (list @)])
  =/  w  (~(gut by b) k ~)
  =/  f  (skim v |=(x=@ (mem x w)))
  ?~  f  ~
  `[k f]
=/  jmps
  |=  f=*
  ^-  (list jm)
  ?:  ?=([?(%clq %brn %brz) @ * *] f)  ~[;;(jm +>-.f) ;;(jm +>+.f)]
  ?:  ?=([%eqq @ @ * *] f)  ~[;;(jm +>+<.f) ;;(jm +>+>.f)]
  ?:  ?=([%hop *] f)  ~[;;(jm +.f)]
  ~
=/  mop
  |=  [st=bst op=*]
  ^-  [(unit *) bst]
  =/  rn  |=(r=@ ^-(@ (~(gut by old.st) r r)))
  =/  rl  |=(v=* ^-((list @) (turn ;;((list @) v) rn)))
  =/  fresh  |=(d=@ ^-(bst st(loc (~(put by loc.st) d i0))))
  ?:  ?=([%imm * @] op)
    =/  n  +<.op
    =/  d  +>.op
    =/  l  (~(gut by imml.st) n ~)
    ?^  l  [~ st(old (~(put by old.st) d (pick l)))]
    :-  `op
    st(loc (~(put by loc.st) d i0(imm `n)), imml (~(put by imml.st) n (ins l d)))
  ?:  ?=([%mov @ @] op)  [~ st(old (~(put by old.st) +>.op (rn +<.op)))]
  ?:  ?=([%inc @ @] op)
    =/  arg  (rn +<.op)
    =/  d  +>.op
    =/  ai  (~(got by loc.st) arg)
    ?^  dof.ai  [~ st(old (~(put by old.st) d u.dof.ai))]
    =/  l1  (~(put by loc.st) d i0)
    [`[%inc arg d] st(loc (jab l1 arg |=(i=inf i(dof `d))))]
  ?:  ?=([%con @ @ @] op)
    =/  h  (rn +<.op)
    =/  t  (rn +>-.op)
    =/  d  +>+.op
    =/  hi  (~(got by loc.st) h)
    =/  ti  (~(got by loc.st) t)
    =/  int  (skim hof.hi |=(x=@ (mem x tof.ti)))
    ?^  int  [~ st(old (~(put by old.st) d (pick int)))]
    =/  l1  (~(put by loc.st) d i0(hh `h, ht `t, cel &))
    =/  l2  (jab l1 h |=(i=inf i(hof (ins hof.i d))))
    [`[%con h t d] st(loc (jab l2 t |=(i=inf i(tof (ins tof.i d)))))]
  ?:  ?=([%hed @ @] op)
    =/  arg  (rn +<.op)
    =/  d  +>.op
    =/  ai  (~(got by loc.st) arg)
    ?^  hh.ai  [~ st(old (~(put by old.st) d u.hh.ai))]
    =/  l1  (~(put by loc.st) d i0(hof ~[arg]))
    [`[%hed arg d] st(loc (jab l1 arg |=(i=inf i(hh `d))))]
  ?:  ?=([%tal @ @] op)
    =/  arg  (rn +<.op)
    =/  d  +>.op
    =/  ai  (~(got by loc.st) arg)
    ?^  ht.ai  [~ st(old (~(put by old.st) d u.ht.ai))]
    =/  l1  (~(put by loc.st) d i0(tof ~[arg]))
    [`[%tal arg d] st(loc (jab l1 arg |=(i=inf i(ht `d))))]
  ?:  ?=([%cel @] op)
    =/  arg  (rn +.op)
    =/  ai  (~(got by loc.st) arg)
    ?:  cel.ai  [~ st]
    [`[%cel arg] st(loc (jab loc.st arg |=(i=inf i(cel &))))]
  ?:  ?=([%lob @] op)
    =/  arg  (rn +.op)
    =/  ai  (~(got by loc.st) arg)
    ?:  |(lob.ai ?=([~ ?] imm.ai))  [~ st]
    [`[%lob arg] st(loc (jab loc.st arg |=(i=inf i(lob &))))]
  ?:  ?=([%equ @ @] op)
    =/  l  (rn +<.op)
    =/  r  (rn +>.op)
    ?:  =(l r)  [~ st]
    [`[%equ l r] st]
  ?:  ?=([?(%hsp %hse %hcp %hce) *] op)  [`op st]
  ?:  ?=([?(%hdp %hde) * @ *] op)  [`[-.op +<.op (rn +>-.op) +>+.op] st]
  ?:  ?=([?(%hmp %hme) * * *] op)  [`[-.op +<.op (rl +>-.op) +>+.op] st]
  ?:  ?=([?(%spy %nok) @ @ @] op)  [`[-.op (rn +<.op) (rn +>-.op) +>+.op] (fresh +>+.op)]
  ?:  ?=([%cal * * @] op)  [`[-.op +<.op (rl +>-.op) +>+.op] (fresh +>+.op)]
  ?:  ?=([?(%caf %cam) * * @ *] op)  [`[-.op +<.op (rl +>-.op) +>+<.op +>+>.op] (fresh +>+<.op)]
  ?:  ?=([%csl * @ @] op)  [`[-.op +<.op (rn +>-.op) +>+.op] (fresh +>+.op)]
  ?:  ?=([?(%csf %csm) * @ @ *] op)  [`[-.op +<.op (rn +>-.op) +>+<.op +>+>.op] (fresh +>+<.op)]
  ~|([%model-unknown-op op] !!)
=/  mbody
  |=  [l=(list *) st=bst]
  ^-  [(list *) bst]
  =|  out=(list *)
  |-  ^-  [(list *) bst]
  ?~  l  [(flop out) st]
  =/  r  (mop st i.l)
  $(l t.l, st +.r, out ?~(-.r out [u.-.r out]))
=/  mfin
  |=  [old=(map @ @) loc=rm rev=(map @ (list @)) f=? o=@ fin=*]
  ^-  [* (map @ (list @)) ?]
  =/  rn  |=(r=@ ^-(@ (~(gut by old) r r)))
  =/  rl  |=(v=* ^-((list @) (turn ;;((list @) v) rn)))
  =/  fold  |=([go=@ cut=@] ^-([* (map @ (list @)) ?] [[%hop ~ go] ?:(=(go cut) rev (delju rev cut o)) &]))
  ?:  ?=([?(%clq %brn %brz) @ * *] fin)
    =/  z  ;;(jm +>-.fin)
    =/  y  ;;(jm +>+.fin)
    ?>  &(=(~ args.z) =(~ args.y))
    =/  c  (rn +<.fin)
    =/  ic  (~(got by loc) c)
    ?:  ?=(%clq -.fin)
      ?:  |(cel.ic ?=([~ ^] imm.ic))  (fold there.z there.y)
      ?:  |(lob.ic ?=([~ @] imm.ic))  (fold there.y there.z)
      [[%clq c z y] rev f]
    ?:  ?=(%brn -.fin)
      ?~  imm.ic
        ?:  lob.ic  [[%brz c z y] rev &]
        [[%brn c z y] rev f]
      ?:  =(0 u.imm.ic)  (fold there.z there.y)
      ?:  =(1 u.imm.ic)  (fold there.y there.z)
      [[%bom ~] (delju (delju rev there.y o) there.z o) f]
    =/  zero=(unit ?)
      ?^  imm.ic  `=(0 u.imm.ic)
      ?:(cel.ic `| ~)
    ?~  zero  [[%brz c z y] rev f]
    ?:  u.zero  (fold there.z there.y)
    (fold there.y there.z)
  ?:  ?=([%eqq @ @ * *] fin)
    =/  z  ;;(jm +>+<.fin)
    =/  y  ;;(jm +>+>.fin)
    ?>  &(=(~ args.z) =(~ args.y))
    =/  l  (rn +<.fin)
    =/  r  (rn +>-.fin)
    ?.  =(l r)  [[%eqq l r z y] rev f]
    (fold there.z there.y)
  ?:  ?=([%hop *] fin)
    =/  t  ;;(jm +.fin)
    [[%hop (turn args.t |=(a=(unit @) (bind a rn))) there.t] rev f]
  ?:  ?=([%jmp * *] fin)  [[%jmp +<.fin (rl +>.fin)] rev f]
  ?:  ?=([%jmf * * *] fin)  [[%jmf +<.fin (rl +>-.fin) +>+.fin] rev f]
  ?:  ?=([%jsp * @] fin)  [[%jsp +<.fin (rn +>.fin)] rev f]
  ?:  ?=([%jsf * @ *] fin)  [[%jsf +<.fin (rn +>-.fin) +>+.fin] rev f]
  ?:  ?=([%don @] fin)  [[%don (rn +.fin)] rev f]
  [fin rev f]
=/  start
  |=  [g=gen o=@ pre=(list @)]
  ^-  rm
  ?>  ?=(^ pre)
  =/  info=rm  (~(got by info.g) i.pre)
  =/  t  t.pre
  =.  info
    |-  ^-  rm
    ?~  t  info
    $(t t.t, info (jinfo info (~(got by info.g) i.t)))
  ?^  t.pre  info
  =/  fin  fin:(~(got by new.g) i.pre)
  ?:  ?=([?(%clq %brn %brz) @ * *] fin)
    =/  s  +<.fin
    =/  zt  there:;;(jm +>-.fin)
    =/  ot  there:;;(jm +>+.fin)
    ?:  ?=(%brn -.fin)
      ?:  &(=(zt o) !=(ot o))  (jab info s |=(i=inf i(imm `0)))
      ?:  &(=(ot o) !=(zt o))  (jab info s |=(i=inf i(imm `1)))
      ?>  &(=(zt ot) =(zt o))
      (jab info s |=(i=inf i(lob &)))
    ?:  ?=(%brz -.fin)
      ?:  &(=(zt o) !=(ot o))  (jab info s |=(i=inf i(imm `0)))
      ?:  &(=(ot o) !=(zt o))
        ?:  lob:(~(got by info) s)  (jab info s |=(i=inf i(imm `1)))
        info
      info
    ?:  &(=(zt o) !=(ot o))  (jab info s |=(i=inf i(cel &)))
    ?>  =(ot o)
    info
  info
=/  start-imms
  |=  [g=gen pre=(list @)]
  ^-  im
  ?~  pre  ~
  =/  m=im  (~(got by imms.g) i.pre)
  =/  t  t.pre
  |-  ^-  im
  ?~  t  m
  $(t t.t, m (jimms m (~(got by imms.g) i.t)))
=/  m-alias
  |=  [n-args=@ bl=(map @ mb) rev0=(map @ (list @)) topo=(list @)]
  ^-  [? (map @ mb)]
  =/  g=gen  [~ ~ ~ ~ (~(run by rev0) dedup) |]
  |-  ^-  [? (map @ mb)]
  ?~  topo  [folded.g new.g]
  =/  o  i.topo
  =/  pre=(list @)  (~(gut by rev.g) o ~)
  ?:  &(=(~ pre) !=(0 o))
    =/  b  (~(got by bl) o)
    =.  rev.g  (roll (jmps fin.b) |=([j=jm acc=_rev.g] (delju acc there.j o)))
    $(topo t.topo, folded.g &)
  =/  info=rm
    ?^  pre  (start g o pre)
    =|  m=rm
    =/  r  0
    |-  ^-  rm
    ?:  =(r n-args)  m
    $(r +(r), m (~(put by m) r i0))
  =/  imms=im  (start-imms g pre)
  =/  b  (~(got by bl) o)
  =/  edges=(list [p=@ args=(list (unit @))])
    %-  zing
    %+  turn  pre
    |=  p=@
    %+  murn  (jmps fin:(~(got by new.g) p))
    |=  j=jm
    ^-  (unit [p=@ args=(list (unit @))])
    ?.  =(there.j o)  ~
    `[p args.j]
  =/  loc0=rm
    =/  ps  par.b
    =/  loc  info
    |-  ^-  rm
    ?~  ps  loc
    =/  ins=(list (unit inf))
      %+  turn  edges
      |=  [p=@ args=(list (unit @))]
      ^-  (unit inf)
      ?>  ?=(^ args)
      ?~  i.args  ~
      `(~(got by (~(got by info.g) p)) u.i.args)
    %=  $
      ps  t.ps
      loc  (~(put by loc) i.ps (pinfo ins))
      edges  (turn edges |=([p=@ args=(list (unit @))] [p ?>(?=(^ args) t.args)]))
    ==
  =/  rb  (mbody body.b [old.g loc0 imms])
  =/  rf  (mfin old.+.rb loc.+.rb rev.g folded.g o fin.b)
  %=  $
    topo  t.topo
    new.g  (~(put by new.g) o [par.b -.rb -.rf])
    old.g  old.+.rb
    info.g  (~(put by info.g) o loc.+.rb)
    imms.g  (~(put by imms.g) o imml.+.rb)
    rev.g  +<.rf
    folded.g  +>.rf
  ==
=|  cnt=[comp=@ud calls=@ud changed=@ud mis=@ud]
|-  ^-  @
?~  cases
  ~&  [%summary cnt]
  0
=^  [func=bell new=(list [pax=path tem=sock clue=*])]  long-ska.state
  (ska-poke [?:(?=(%k kind.i.cases) [& sub.i.cases] [| ~]) ?>(?=(^ fol.i.cases) fol.i.cases)] long-ska.state ~(key by jets-hot.state))
=^  scc=(set bell)  sccs.cache.state
  (scc-of func calls.long-ska.state sccs.cache.state)
=^  raw=straight  cache.state  (compiled-mono func scc)
=.  comp.cnt  +(comp.cnt)
=/  s=straight  raw
|-  ^-  @
=/  topo  (bb-topo blocks.s)
=/  rev  (rev-cfg blocks.s (sy topo))
=^  [topo=(list @uwoo) rev=(jar @uwoo @uwoo)]  blocks.s
  |-  ^-  [[(list @uwoo) (jar @uwoo @uwoo)] (map @uwoo blob)]
  =^  c-hops=?  blocks.s  (remove-hops blocks.s rev topo)
  =^  c-branch=?  blocks.s  (remove-useless-branching blocks.s)
  =^  c-middle=?  blocks.s  (remove-empty-middle blocks.s)
  ?.  |(c-hops c-branch c-middle)  [[topo rev] blocks.s]
  =.  topo  (bb-topo blocks.s)
  =.  rev  (rev-cfg blocks.s (sy topo))
  $
=/  pre  blocks.s
=/  real  (alias n-args.s blocks.s rev topo)
=/  mo  (m-alias n-args.s ;;((map @ mb) pre) ;;((map @ (list @)) rev) topo)
=.  calls.cnt  +(calls.cnt)
=?  changed.cnt  |(-.real !=(`*`+.real `*`pre))  +(changed.cnt)
=?  mis.cnt  !=(`*`real `*`mo)  +(mis.cnt)
~?  !=(`*`real `*`mo)  [%model-differs nam.i.cases kind.i.cases sub.i.cases]
=^  f-alias=?  blocks.s  real
=.  topo  (skim topo ~(has by blocks.s))
=.  rev  (rev-cfg blocks.s (sy topo))
=.  blocks.s  (trim-trace-hints blocks.s topo rev)
=.  blocks.s  (remove-dead-code blocks.s (flop topo))
=^  c-hops=?  blocks.s  (remove-hops blocks.s rev topo)
=^  c-branch=?  blocks.s  (remove-useless-branching blocks.s)
=^  c-middle=?  blocks.s  (remove-empty-middle blocks.s)
?:  |(f-alias c-hops c-branch c-middle)  $
^$(cases t.cases)
