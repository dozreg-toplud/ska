:: +run-shape on raw samples, written by tools/gen/runshapecheck.py; do not edit by hand.
:: Each case prints [%rs name laze id-gen sofs], the sets as lists (order of +rep:in).

=/  pre
  |=  [t=* acc=*]
  ^-  *
  ?@  t  acc
  ?>  ?=([* * *] t)
  [-.t $(t +<.t, acc $(t +>.t))]
=/  plain
  |=  l=*
  ^-  *
  ?>  ?=([[* *] * *] l)
  =/  fk=*  +<.l
  =/  bd=*  +>.l
  :+  [-<.l (pre ->.l 0)]
    |-  ^-  *
    ?@  fk  0
    ?>  ?=([[[* *] [* *]] *] fk)
    [[[-<-.fk ^$(l -<+.fk)] [->-.fk ^$(l ->+.fk)]] $(fk +.fk)]
  |-  ^-  *
  ?@  bd  0
  ?>  ?=([[* *] *] bd)
  [[-<.bd ^$(l ->.bd)] $(bd +.bd)]
=/  ax  |=([a=@ n=*] .*(n [0 a]))

=/  ba=*  [[1 0] [0 2]]
=/  bb=*  [[1 0] [0 3]]
=/  bc=*  [[1 0] [0 6]]
=/  bd=*  [[1 0] [0 7]]
=/  be=*  [[[0 1] [5 0]] [0 14]]
=/  code=*  (~(gas by *(map * *)) `(list [* *])`~[[ba [[[0 2] [0 3]] & &]] [bb [[0 6] | &]] [bc [[1 5] & &]] [bd [[0 1] & &]] [be [[[0 6] [0 7]] | &]]])
=/  scc=*  (silt `(list *)`~[ba bb bc be])
=/  ml=*  (~(gas by *(map * *)) `(list [* *])`~[[ba [[[1.936.287.860 0] [1.701.736.302 0]] 0 ~]] [be [[[1.701.736.302 0] [[1.936.287.860 0] [1.936.287.860 0]]] 0 ~]]])
=/  top=*  (~(gas by *(map * *)) `(list [* *])`~[[bb [1.752.461.154 [[1.936.287.860 0] [1.701.736.302 0]]]]])
=/  nary=*  (~(gas by *(map * *)) `(list [* *])`~[[bd [[1.936.287.860 0] 0 ~]]])
=/  sure=*  (~(gas by *(map * *)) `(list [* *])`~[[ba [1.936.287.860 0]] [be [[1.701.736.302 0] [1.936.287.860 0]]]])
=/  lon=*  [code jets.long-ska.state ~]
=/  cmp  (comp *(set bell) [code jets calls]:long-ska.state ~ ~ ~ *bell)
=/  g=*  ~(run-shape cmp *line-short)
=/  ctx=*  [(ax 62 g) [[scc lon ~ ml top ba] (ax 127 g)]]
=/  run
  |=  [nam=@tas sam=* idg=@ sofs=*]
  ^-  @
  =/  gen=*  [0 1 idg %drop ~ ~ ~ [nary ~ ~ ~ sure] ~ sofs]
  =/  res=*  .*([(ax 2 g) [sam [(ax 14 g) [gen ctx]]]] [9 2 0 1])
  ~&  [%rs nam `*`[(plain (ax 2 res)) (ax 14 (ax 3 res)) (pre (ax 1.023 (ax 3 res)) 0)]]
  0
