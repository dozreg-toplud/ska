      [61 %s [1 [5 [7 8]]] [7 [[6 [[5 [[0 14] [1 5]]] [[0 2] [6 [[0 2] [[6 [[0 2] [[0 3] [0 6]]]] [0 1]]]]]]] [6 [[0 2] [[0 3] [0 0]]]]]]]
