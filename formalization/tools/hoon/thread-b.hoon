      [64 %r [0 [1 [0 1]]] [5 [[7 [[6 [[6 [[5 [[0 14] [1 5]]] [[3 [0 12]] [5 [[0 6] [1 5]]]]]] [[6 [[3 [0 12]] [[0 3] [5 [[1 5] [0 7]]]]]] [6 [[0 6] [[5 [[1 5] [0 7]]] [0 3]]]]]]] [4 [6 [[0 6] [[0 7] [5 [[1 [0 1]] [0 3]]]]]]]]] [0 0]]]]
