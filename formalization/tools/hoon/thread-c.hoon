  ==
=/  run
  |=  [s=* code=straight-out]
  ^-  (each tone tang)
  (mule |.(-:(eval-blob [[[`@`0 s] ~ ~] ~] (~(got by blocks.code) 0w0) code ~ ~)))
=/  judge
  |=  [a=toon r=(each tone tang)]
  ^-  @tas
  ?:  ?=(%| -.r)  %icrash
  ?:  &(?=(%0 -.a) ?=(%0 -.p.r))  ?:(=(p.a product.p.r) %same %diff)
  ?:  &(?=(%2 -.a) ?=(%2 -.p.r))  %same
  %diff
::  +optimize without +remove-empty-middle (and without +switch-chains)
=/  noem
  |=  s=straight
  ^-  straight
  |-  ^-  straight
  =^  changed=?  s
    =/  topo  (bb-topo blocks.s)
    =/  rev  (rev-cfg blocks.s (sy topo))
    =^  [topo=(list @uwoo) rev=(jar @uwoo @uwoo)]  blocks.s
      |-  ^-  [[(list @uwoo) (jar @uwoo @uwoo)] (map @uwoo blob)]
      =^  c-hops=?  blocks.s  (remove-hops blocks.s rev topo)
      =^  c-branch=?  blocks.s  (remove-useless-branching blocks.s)
      ?.  |(c-hops c-branch)  [[topo rev] blocks.s]
      =.  topo  (bb-topo blocks.s)
      =.  rev  (rev-cfg blocks.s (sy topo))
      $
    =^  f-alias=?  blocks.s  (alias n-args.s blocks.s rev topo)
    =.  topo  (skim topo ~(has by blocks.s))
    =.  rev  (rev-cfg blocks.s (sy topo))
    =.  blocks.s  (trim-trace-hints blocks.s topo rev)
    =.  blocks.s  (remove-dead-code blocks.s (flop topo))
    =^  c-hops=?  blocks.s  (remove-hops blocks.s rev topo)
    =^  c-branch=?  blocks.s  (remove-useless-branching blocks.s)
    [|(f-alias c-hops c-branch) s]
  ?.  changed  s
  $(s s)
::  +remove-empty-middle alone, to a fixed point
=/  remo
  |=  s=straight
  ^-  straight
  |-  ^-  straight
  =^  c=?  blocks.s  (remove-empty-middle blocks.s)
  ?.  c  s
  $(s s)
=|  cnt=[n=@ud raw-bad=@ud opt-bad=@ud noem-bad=@ud remo-bad=@ud]
|-  ^-  @
?~  cases
  ~&  [%summary cnt]
  0
=/  a=toon  (mook (mink [sub fol]:i.cases ~))
::  the %full branch of +poke, with a subject sock that knows nothing
=^  [func=bell new=(list [pax=path tem=sock clue=*])]  long-ska.state
  (ska-poke [[| ~] ?>(?=(^ fol.i.cases) fol.i.cases)] long-ska.state ~(key by jets-hot.state))
=^  scc=(set bell)  sccs.cache.state
  (scc-of func calls.long-ska.state sccs.cache.state)
=^  raw=straight  cache.state  (compiled-mono func scc)
?>  =(1 n-args.raw)
?>  =([%this ~] need.raw)
=/  opt=straight-out  (optimize raw)
=/  jr  (judge a (run sub.i.cases raw))
=/  jo  (judge a (run sub.i.cases opt))
=/  jn  (judge a (run sub.i.cases (noem raw)))
=/  jm  (judge a (run sub.i.cases (remo raw)))
=.  n.cnt  +(n.cnt)
=?  raw-bad.cnt  !=(%same jr)  +(raw-bad.cnt)
=?  opt-bad.cnt  !=(%same jo)  +(opt-bad.cnt)
=?  noem-bad.cnt  !=(%same jn)  +(noem-bad.cnt)
=?  remo-bad.cnt  !=(%same jm)  +(remo-bad.cnt)
~&  [nam.i.cases kind.i.cases raw=jr opt=jo noem=jn remo=jm blk=[~(wyt by blocks.raw) ~(wyt by blocks.opt)]]
$(cases t.cases)

