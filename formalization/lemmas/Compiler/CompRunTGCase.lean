/-- The fork-free hypothesis on the parts from the general one. -/
theorem hp_toLRTG (hYk : YOk X Y) {env : CallEnv} {msup : Option Nomm} {p : Nomm} {region : List Nat}
    (hp : ∀ (goal : CGoalL CSet) (g1 : Gen (TreapMap mugF)), GInv g1 goal →
      CompRunAtXT (runLCMR env true msup) ctx X Y p goal region g1) :
    ∀ s th g1, CrInv g1 (CGoal.next s th) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next s th)) region g1 :=
  fun s th g1 hi => hp _ g1 (crInv_gInv hi)

/-- **The case `%4` of `+run`** on a fork-free goal with no look at `0`:
`%done` and `%pick` take two registers and emit the increment; `%next` runs
`+collapse-lazy-atom` (or takes a fresh register when the goal needs nothing,
where the `?>` on the arguments of `then` crashes as the model does), then the
increment with a `%hop`; then `p` into the argument register. -/
theorem comp_run_n4CRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p : Nomm) (gl : CGoal CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) (hinv : CrInv g gl)
    (hp : ∀ s th g1, CrInv g1 (CGoal.next s th) → CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next s th)) region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n4 p) (CGoal.toL gl) region g := by
  have hlok := hinv.1
  have hd := hinv.2.1
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  simp only [Nomm.toNoun]
  rw [cr_disp_n4]
  cases gl with
  | done =>
    have hre := comp_re' ctx x g
    have hre2 := comp_re' ctx x { g with re := g.re + 1 }
    have he := cf_emit (x := x) hc { g with re := g.re + 1 + 1 }
      ⟨[], [Pole.inc (g.re + 1) g.re], Termin.don g.re⟩
    simp only [Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.don, Tag.inc] at he
    obtain ⟨x, hy1, hr⟩ := hp (lazyReg (g.re + 1)) (jmp0 g.bo) (cfEmitG ⟨[], [Pole.inc (g.re + 1) g.re], Termin.don g.re⟩
      { g with re := g.re + 1 + 1 }) (cri_reg_emit _ _ _ _ _ (by omega) hd) x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [cr_goal_reg] at hr
    simp only [crSubj, compCore] at hr
    have hD1 := comp_re_at
    have hD2 := comp_emit_at
    simp only [compCore] at hre hre2 ⊢
    generalize comp.door = Dr at hD1 hD2 he hre hre2 hr ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crK4
    simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hre, hre2, hD1, hD2, comp_emit_arm, he,
      cr_bat_dol, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, hr, runLCMR, re, bind, StateT.bind, cf_emit_g]
  | pick z o =>
    have hre := comp_re' ctx x g
    have hre2 := comp_re' ctx x { g with re := g.re + 1 }
    have he := cf_emit (x := x) hc { g with re := g.re + 1 + 1 }
      ⟨[], [Pole.inc (g.re + 1) g.re], Termin.brn g.re z o⟩
    simp only [Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.brn, Tag.inc] at he
    obtain ⟨x, hy2, hr⟩ := hp (lazyReg (g.re + 1)) (jmp0 g.bo) (cfEmitG ⟨[], [Pole.inc (g.re + 1) g.re], Termin.brn g.re z o⟩
      { g with re := g.re + 1 + 1 }) (cri_reg_emit _ _ _ _ _ (by omega) hd) x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy2
    replace hx := hYk.soft hx hy2
    replace hX := hYk.pres hX hy2
    rw [cr_goal_reg] at hr
    simp only [crSubj, compCore] at hr
    have hD1 := comp_re_at
    have hD2 := comp_emit_at
    simp only [compCore] at hre hre2 ⊢
    generalize comp.door = Dr at hD1 hD2 he hre hre2 hr ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crK4
    simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hre, hre2, hD1, hD2, comp_emit_arm, he,
      cr_bat_dol, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, hr, runLCMR, re, bind, StateT.bind, cf_emit_g]
  | next laz th =>
    obtain ⟨args, there⟩ := th
    have hcl := comp_collapse_lazy_atom h7 x g laz ⟨args, there⟩ hlok (hx there) (fun _ g' _ => hx g'.bo)
    have hDc := comp_cla_at
    have hD1 := comp_re_at
    have hD2 := comp_emit_at
    simp only [compCore, Jmp.toNoun] at hcl ⊢
    rcases ecl : collapseLazyAtomL (⟨Lazy.ofSure laz, ⟨args, there⟩⟩ : NextL CSet) g with _ | ⟨a, g1⟩
    · rw [ecl] at hcl
      generalize comp.door = Dr at hDc hD1 hD2 hcl ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open crK4
      simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind,
        StateT.bind, Jmp.toNoun, Lazy.toNoun_ofSure]
    · rw [ecl] at hcl
      rcases a with _ | ⟨pro, th'⟩
      · cases args with
        | cons a0 rest =>
          have hre := comp_re' ctx x g1
          simp only [listNoun, unitNoun, Option.map_some] at hcl
          generalize comp.door = Dr at hDc hD1 hD2 hcl hre ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open crK4
          simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind,
            StateT.bind, Jmp.toNoun, Lazy.toNoun_ofSure, hre, hD1, unitNoun, listNoun, re]
        | nil =>
          simp only [listNoun] at hcl
          have hre := comp_re' ctx x g1
          have hre2 := comp_re' ctx x { g1 with re := g1.re + 1 }
          have he := cf_emit (x := x) hc { g1 with re := g1.re + 1 + 1 }
            ⟨[], [Pole.inc (g1.re + 1) g1.re], Termin.hop (jmp0 there)⟩
          rw [cr_blob_inc_hop] at he
          obtain ⟨x, hy3, hr⟩ := hp (lazyReg (g1.re + 1)) (jmp0 g1.bo) (cfEmitG ⟨[], [Pole.inc (g1.re + 1) g1.re], Termin.hop (jmp0 there)⟩
            { g1 with re := g1.re + 1 + 1 }) (cri_reg_emit _ _ _ _ _ (by omega) (cri_cla hd ecl).2) x mono sup hx hX
          replace hY0 := hYk.trans hY0 hy3
          replace hx := hYk.soft hx hy3
          replace hX := hYk.pres hX hy3
          rw [cr_goal_reg] at hr
          simp only [crSubj, compCore] at hr hre hre2
          generalize comp.door = Dr at hDc hD1 hD2 hcl hre hre2 he hr ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open crK4
          simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind,
            StateT.bind, Jmp.toNoun, Lazy.toNoun_ofSure, hre, hre2, hD1, hD2, comp_emit_arm, he, unitNoun,
            listNoun, re, pure, StateT.pure, cr_bat_dol, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, hr,
            cf_emit_g]
      · have hre := comp_re' ctx x g1
        have he := cf_emit (x := x) hc { g1 with re := g1.re + 1 }
          ⟨[], [Pole.inc g1.re pro], Termin.hop (jmp0 th')⟩
        rw [cr_blob_inc_hop] at he
        obtain ⟨x, hy4, hr⟩ := hp (lazyReg g1.re) (jmp0 g1.bo) (cfEmitG ⟨[], [Pole.inc g1.re pro], Termin.hop (jmp0 th')⟩
          { g1 with re := g1.re + 1 }) (cri_reg_emit _ _ _ _ _ (by omega) (cri_cla hd ecl).2) x mono sup hx hX
        replace hY0 := hYk.trans hY0 hy4
        replace hx := hYk.soft hx hy4
        replace hX := hYk.pres hX hy4
