          cf_emit_g]

/-- **The case `%3` of `+run`** on a fork-free goal with no look at `0`: on a
`%next` goal whose need is `+none-equivalent`, `p` with the same goal;
otherwise `%done` makes the two blocks of `0` and `1`, `%next` runs
`+collapse-lazy-atom` (a crash on `~`) and `+forl`, and a `%clq` block on a
fresh register is the goal of `p` (`lazy-from-need`). -/
theorem comp_run_n3CRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p : Nomm) (gl : CGoal CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) (hinv : CrInv g gl)
    (hg : CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL gl) region g)
    (hp : ∀ s th g1, CrInv g1 (CGoal.next s th) → CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next s th)) region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n3 p) (CGoal.toL gl) region g := by
  have hlok := hinv.1
  have hd := hinv.2.1
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  simp only [Nomm.toNoun]
  rw [cr_disp_n3]
  cases gl with
  | pick z o =>
    have hre := comp_re' ctx x g
    have he := cf_emit (x := x) hc { g with re := g.re + 1 } ⟨[], [], Termin.clq g.re z o⟩
    rw [cr_blob_clq] at he
    obtain ⟨x, hy1, hr⟩ := hp (lazyReg g.re) (jmp0 g.bo) (cfEmitG ⟨[], [], Termin.clq g.re z o⟩ { g with re := g.re + 1 })
      (cri_reg_emit _ _ _ _ _ (by omega) hd) x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [cr_goal_reg] at hr
    simp only [crSubj, compCore] at hr
    have hD1 := comp_re_at
    have hD2 := comp_emit_at
    simp only [compCore] at hre ⊢
    generalize comp.door = Dr at hD1 hD2 he hre hr ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crK3
    simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hre, hD1, hD2, comp_emit_arm, he,
      cr_bat_dol, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, hr, runLCMR, re, bind, StateT.bind, cf_emit_g]
  | done =>
    have hre0 := comp_re' ctx x g
    have hre1 := comp_re' ctx x { g with re := g.re + 1 }
    have he0 := cf_emit (x := x) hc { g with re := g.re + 1 + 1 } ⟨[], [Pole.imm (A 0) g.re], Termin.don g.re⟩
    rw [cr_blob_imm_don] at he0
    have he1 := cf_emit (x := x) hc (cfEmitG ⟨[], [Pole.imm (A 0) g.re], Termin.don g.re⟩
      { g with re := g.re + 1 + 1 }) ⟨[], [Pole.imm (A 1) (g.re + 1)], Termin.don (g.re + 1)⟩
    rw [cr_blob_imm_don] at he1
    generalize hgC : cfEmitG ⟨[], [Pole.imm (A 1) (g.re + 1)], Termin.don (g.re + 1)⟩
      (cfEmitG ⟨[], [Pole.imm (A 0) g.re], Termin.don g.re⟩ { g with re := g.re + 1 + 1 }) = gC at he1
    have hre2 := comp_re' ctx x gC
    have he2 := cf_emit (x := x) hc { gC with re := gC.re + 1 }
      ⟨[], [], Termin.clq gC.re (jmp0 g.bo) (jmp0 (g.bo + 1))⟩
    rw [cr_blob_clq0] at he2
    obtain ⟨x, hy2, hr⟩ := hp (lazyReg gC.re) (jmp0 gC.bo) (cfEmitG ⟨[], [], Termin.clq gC.re (jmp0 g.bo) (jmp0 (g.bo + 1))⟩
      { gC with re := gC.re + 1 }) (cri_reg_emit _ _ _ _ _ (by omega)
        (by rw [← hgC, cf_emitG_drop, cf_emitG_drop]; exact hd)) x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy2
    replace hx := hYk.soft hx hy2
    replace hX := hYk.pres hX hy2
    rw [cr_goal_reg] at hr
    simp only [crSubj, compCore] at hr
    have hD1 := comp_re_at
    have hD2 := comp_emit_at
    simp only [compCore, cf_emitG_bo] at hre0 hre1 hre2 he1 ⊢
    have hm : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup (Nomm.n3 p) (CGoal.toL CGoal.done) region g
        = runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg gC.re) (jmp0 gC.bo))) region
            (cfEmitG ⟨[], [], Termin.clq gC.re (jmp0 g.bo) (jmp0 (g.bo + 1))⟩ { gC with re := gC.re + 1 }) := by
      rw [← hgC]
      simp [runLCMR, CGoal.toL, doneBlocks, re, bind, StateT.bind, pure, StateT.pure, cf_emit_g, cf_emitG_bo,
        cf_emitG_re]
    rw [hm]
    generalize comp.door = Dr at hD1 hD2 he0 he1 he2 hre0 hre1 hre2 hr ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crK3
    simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, hre0, hre1, hre2, hD1, hD2, comp_emit_arm, he0, he1,
      he2, cr_bat_dol, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, hr, cf_emitG_bo]
  | next laz th =>
    obtain ⟨args, there⟩ := th
    have hD0 := compK_ne
    by_cases hne : noneEquivalent laz = true
    · obtain ⟨x, hy3, hr⟩ := hg x mono sup hx hX
      replace hY0 := hYk.trans hY0 hy3
      replace hx := hYk.soft hx hy3
      replace hX := hYk.pres hX hy3
      simp only [crSubj, compCore, CGoal.toL, CGoalL.toNoun, Lazy.toNoun_ofSure] at hr
      simp only [compCore]
      generalize comp.door = Dr at hr ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open crK3
      simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, Lazy.toNoun_ofSure, h7, hD0, ne_arm, ne_gate,
        hne, loob, cr_bat_dol, hr, runLCMR, Lazy.noneEquivalentL_ofSure]
    · have hne' : noneEquivalent laz = false := by simpa using hne
      have hcl := comp_collapse_lazy_atom h7 x g laz ⟨args, there⟩ hlok (hx there) (fun _ g' _ => hx g'.bo)
      have hDc := comp_cla_at
      have hD1 := comp_re_at
      have hD2 := comp_emit_at
      have hDf := comp_fl_at
      simp only [compCore, Jmp.toNoun] at hcl ⊢
      rcases ecl : collapseLazyAtomL (⟨Lazy.ofSure laz, ⟨args, there⟩⟩ : NextL CSet) g with _ | ⟨a, g1⟩
      · rw [ecl] at hcl
        generalize comp.door = Dr at hDc hD1 hD2 hDf hcl ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crK3
        simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, Lazy.toNoun_ofSure, h7, hD0, ne_arm, ne_gate,
          hne', loob, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind, StateT.bind, Jmp.toNoun,
          Lazy.noneEquivalentL_ofSure]
      · rw [ecl] at hcl
        rcases a with _ | ⟨r, o⟩
        · generalize comp.door = Dr at hDc hD1 hD2 hDf hcl ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open crK3
          simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, Lazy.toNoun_ofSure, h7, hD0, ne_arm, ne_gate,
            hne', loob, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind, StateT.bind, Jmp.toNoun,
            Lazy.noneEquivalentL_ofSure, unitNoun]
        · have hfl := comp_forl (x := x) hc g1 r o
          rw [fl_forl_eq] at hfl
          simp only [cf_emitG_bo, Option.map_some] at hfl
          generalize hg2 : cfEmitG (flB3 (g1.re + 1) g1.bo) (cfEmitG (flB2 g1.re g1.bo)
            (cfEmitG (flB1 r o) { g1 with re := g1.re + 1 + 1 })) = g2 at hfl
          have hre := comp_re' ctx x g2
          have he := cf_emit (x := x) hc { g2 with re := g2.re + 1 }
            ⟨[], [], Termin.clq g2.re (jmp0 (g1.bo + 1)) (jmp0 (g1.bo + 1 + 1))⟩
          rw [cr_blob_clq0] at he
          obtain ⟨x, hy4, hr⟩ := hp (lazyReg g2.re) (jmp0 g2.bo) (cfEmitG ⟨[], [], Termin.clq g2.re (jmp0 (g1.bo + 1)) (jmp0 (g1.bo + 1 + 1))⟩
            { g2 with re := g2.re + 1 }) (cri_reg_emit _ _ _ _ _ (by omega)
              (by rw [← hg2, cf_emitG_drop, cf_emitG_drop, cf_emitG_drop]; exact (cri_cla hd ecl).2)) x mono sup hx hX
          replace hY0 := hYk.trans hY0 hy4
          replace hx := hYk.soft hx hy4
          replace hX := hYk.pres hX hy4
          rw [cr_goal_reg] at hr
          simp only [crSubj, compCore, cf_emitG_bo, Option.map_some] at hr hre hfl
          have hm : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup (Nomm.n3 p) (CGoal.toL (CGoal.next laz ⟨args, there⟩))
              region g = runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg g2.re) (jmp0 g2.bo))) region
                (cfEmitG ⟨[], [], Termin.clq g2.re (jmp0 (g1.bo + 1)) (jmp0 (g1.bo + 1 + 1))⟩
                  { g2 with re := g2.re + 1 }) := by
            rw [← hg2]
            simp [runLCMR, CGoal.toL, Lazy.noneEquivalentL_ofSure, hne', ecl, fl_forl_eq, re, bind, StateT.bind,
              pure, StateT.pure, cf_emit_g, cf_emitG_bo, cf_emitG_re]
          rw [hm]
          generalize comp.door = Dr at hDc hD1 hD2 hDf hcl hre he hr hfl ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open crK3
          simp [nock_exec, crSubj, CGoal.toL, CGoalL.toNoun, Lazy.toNoun_ofSure, h7, hD0, ne_arm, ne_gate,
            hne', loob, hDc, cr_cla_arm, hcl, Jmp.toNoun, unitNoun, hDf, comp_fl_arm, hfl, hre, hD1, hD2,
            comp_emit_arm, he, cr_bat_dol, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, hr, cf_emitG_bo]

/-- **The case `%4` of `+run` on a lazy `%next` goal**: `+collapse-lazy-atom`
(`comp_collapse_lazy_atom_all`), or a fresh register when the goal needs
nothing, then the increment and `p` into the argument register. -/
theorem comp_run_n4_nextRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p : Nomm)
    (sur : Sure CSet) (fk : List (Lazy.ForkE CSet)) (bd : List (Nat × Lazy CSet)) (args : List (Option Nat))
    (there : Nat) (region : List Nat) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (hlok : LAll CrLok (Lazy.mk sur fk bd))
    (hp : ∀ s th g1, CrInv g1 (CGoal.next s th) → CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next s th)) region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n4 p) (CGoalL.next (Lazy.mk sur fk bd) ⟨args, there⟩) region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  simp only [Nomm.toNoun]
  rw [cr_disp_n4]
  obtain ⟨hF, hB⟩ := walk_mdP_parts hx hlok
  have hcl := comp_collapse_lazy_atom_all h7 x g sur fk bd ⟨args, there⟩ hlok.1 hF hB (hx there)
    (fun _ g' _ => hx g'.bo)
  have hDc := comp_cla_at
  have hD1 := comp_re_at
  have hD2 := comp_emit_at
  simp only [compCore, Jmp.toNoun] at hcl ⊢
  rcases ecl : collapseLazyAtomL (⟨Lazy.mk sur fk bd, ⟨args, there⟩⟩ : NextL CSet) g with _ | ⟨a, g1⟩
  · rw [ecl] at hcl
    generalize comp.door = Dr at hDc hD1 hD2 hcl ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crK4
    simp [nock_exec, crSubj, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind, StateT.bind, Jmp.toNoun]
  · rw [ecl] at hcl
    have d1 := (km_drop (km_collapseLazyAtomL _) ecl hd).2.2
    rcases a with _ | ⟨pro, th'⟩
    · cases args with
      | cons a0 rest =>
        have hre := comp_re' ctx x g1
        simp only [listNoun, unitNoun, Option.map_some] at hcl
        generalize comp.door = Dr at hDc hD1 hD2 hcl hre ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crK4
        simp [nock_exec, crSubj, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind,
          StateT.bind, Jmp.toNoun, hre, hD1, unitNoun, listNoun, re]
      | nil =>
        simp only [listNoun] at hcl
        have hre := comp_re' ctx x g1
        have hre2 := comp_re' ctx x { g1 with re := g1.re + 1 }
        have he := cf_emit (x := x) hc { g1 with re := g1.re + 1 + 1 }
          ⟨[], [Pole.inc (g1.re + 1) g1.re], Termin.hop (jmp0 there)⟩
        rw [cr_blob_inc_hop] at he
        obtain ⟨x, hy1, hr⟩ := hp (lazyReg (g1.re + 1)) (jmp0 g1.bo) (cfEmitG ⟨[], [Pole.inc (g1.re + 1) g1.re], Termin.hop (jmp0 there)⟩
          { g1 with re := g1.re + 1 + 1 }) (cri_reg_emit _ _ _ _ _ (by omega) d1) x mono sup hx hX
        replace hY0 := hYk.trans hY0 hy1
        replace hx := hYk.soft hx hy1
        replace hX := hYk.pres hX hy1
        rw [cr_goal_reg] at hr
        simp only [crSubj, compCore] at hr hre hre2
        generalize comp.door = Dr at hDc hD1 hD2 hcl hre hre2 he hr ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crK4
        simp [nock_exec, crSubj, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind,
          StateT.bind, Jmp.toNoun, hre, hre2, hD1, hD2, comp_emit_arm, he, unitNoun,
          listNoun, re, pure, StateT.pure, cr_bat_dol, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, hr, CGoal.toL,
          cf_emit_g]
    · have hre := comp_re' ctx x g1
      have he := cf_emit (x := x) hc { g1 with re := g1.re + 1 }
        ⟨[], [Pole.inc g1.re pro], Termin.hop (jmp0 th')⟩
      rw [cr_blob_inc_hop] at he
      obtain ⟨x, hy2, hr⟩ := hp (lazyReg g1.re) (jmp0 g1.bo) (cfEmitG ⟨[], [Pole.inc g1.re pro], Termin.hop (jmp0 th')⟩
        { g1 with re := g1.re + 1 }) (cri_reg_emit _ _ _ _ _ (by omega) d1) x mono sup hx hX
      replace hY0 := hYk.trans hY0 hy2
      replace hx := hYk.soft hx hy2
      replace hX := hYk.pres hX hy2
      rw [cr_goal_reg] at hr
      simp only [crSubj, compCore] at hr hre
      generalize comp.door = Dr at hDc hD1 hD2 hcl hre he hr ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open crK4
      simp [nock_exec, crSubj, CGoalL.toNoun, hDc, cr_cla_arm, hcl, runLCMR, ecl, bind,
        StateT.bind, Jmp.toNoun, hre, hD1, hD2, comp_emit_arm, he, unitNoun,
        listNoun, re, pure, StateT.pure, cr_bat_dol, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, hr, CGoal.toL,
        cf_emit_g]

/-- **The case `%4` on every goal with the invariant.** -/
theorem comp_run_n4LRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p : Nomm)
    (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF)) (hi : GInv g goal)
    (hp : ∀ (goal' : CGoalL CSet) (g1 : Gen (TreapMap mugF)), GInv g1 goal' →
      CompRunAtXT (runLCMR env true msup) ctx X Y p goal' region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n4 p) goal region g := by
  cases goal with
  | next laz th =>
    obtain ⟨sur, fk, bd⟩ := laz
    obtain ⟨args, there⟩ := th
    exact comp_run_n4_nextRTG hYk h7 env msup p sur fk bd args there region g hi.2.1 (lall_mono (fun _ hs => hs.1) hi.1.1)
      (hp_toLRTG hYk hp)
  | pick z o => exact comp_run_n4CRTG hYk h7 env msup p (CGoal.pick z o) region g (gInv_crInv hi) (hp_toLRTG hYk hp)
  | done => exact comp_run_n4CRTG hYk h7 env msup p CGoal.done region g (gInv_crInv hi) (hp_toLRTG hYk hp)

/-- **The case `%3` of `+run` on a lazy `%next` goal**: `+none-equivalent`
(`ne_all`), then either `p` for the goal itself, or `+collapse-lazy-atom`,
`+forl` and a `%clq` block on a fresh register for `p`. -/
theorem comp_run_n3_nextRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p : Nomm)
    (sur : Sure CSet) (fk : List (Lazy.ForkE CSet)) (bd : List (Nat × Lazy CSet)) (args : List (Option Nat))
    (there : Nat) (region : List Nat) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (hlok : LAll CrLok (Lazy.mk sur fk bd))
    (hg : CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.next (Lazy.mk sur fk bd) ⟨args, there⟩) region g)
    (hp : ∀ s th g1, CrInv g1 (CGoal.next s th) → CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next s th)) region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n3 p) (CGoalL.next (Lazy.mk sur fk bd) ⟨args, there⟩) region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  simp only [Nomm.toNoun]
  rw [cr_disp_n3]
  have hD0 := compK_ne
  have hne0 := ne_all (Lazy.mk sur fk bd)
  by_cases hne : Lazy.noneEquivalentL (Lazy.mk sur fk bd) = true
  · obtain ⟨x, hy1, hr⟩ := hg x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    simp only [crSubj, compCore, CGoalL.toNoun] at hr
    simp only [compCore]
    generalize comp.door = Dr at hr ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crK3
    simp [nock_exec, crSubj, CGoalL.toNoun, h7, hD0, ne_arm, hne0, hne, loob, cr_bat_dol, hr, runLCMR]
  · have hne' : Lazy.noneEquivalentL (Lazy.mk sur fk bd) = false := by simpa using hne
    obtain ⟨hF, hB⟩ := walk_mdP_parts hx hlok
    have hcl := comp_collapse_lazy_atom_all h7 x g sur fk bd ⟨args, there⟩ hlok.1 hF hB (hx there)
      (fun _ g' _ => hx g'.bo)
    have hDc := comp_cla_at
    have hD1 := comp_re_at
    have hD2 := comp_emit_at
    have hDf := comp_fl_at
    simp only [compCore, Jmp.toNoun] at hcl ⊢
    rcases ecl : collapseLazyAtomL (⟨Lazy.mk sur fk bd, ⟨args, there⟩⟩ : NextL CSet) g with _ | ⟨a, g1⟩
    · rw [ecl] at hcl
      generalize comp.door = Dr at hDc hD1 hD2 hDf hcl ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open crK3
      simp [nock_exec, crSubj, CGoalL.toNoun, h7, hD0, ne_arm, hne0, hne', loob, hDc, cr_cla_arm, hcl, runLCMR,
        ecl, bind, StateT.bind, Jmp.toNoun]
    · rw [ecl] at hcl
      have d1 := (km_drop (km_collapseLazyAtomL _) ecl hd).2.2
      rcases a with _ | ⟨r, o⟩
      · generalize comp.door = Dr at hDc hD1 hD2 hDf hcl ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crK3
        simp [nock_exec, crSubj, CGoalL.toNoun, h7, hD0, ne_arm, hne0, hne', loob, hDc, cr_cla_arm, hcl, runLCMR,
          ecl, bind, StateT.bind, Jmp.toNoun, unitNoun]
      · have hfl := comp_forl (x := x) hc g1 r o
        rw [fl_forl_eq] at hfl
        simp only [cf_emitG_bo, Option.map_some] at hfl
        generalize hg2 : cfEmitG (flB3 (g1.re + 1) g1.bo) (cfEmitG (flB2 g1.re g1.bo)
          (cfEmitG (flB1 r o) { g1 with re := g1.re + 1 + 1 })) = g2 at hfl
        have hre := comp_re' ctx x g2
        have he := cf_emit (x := x) hc { g2 with re := g2.re + 1 }
          ⟨[], [], Termin.clq g2.re (jmp0 (g1.bo + 1)) (jmp0 (g1.bo + 1 + 1))⟩
        rw [cr_blob_clq0] at he
        obtain ⟨x, hy2, hr⟩ := hp (lazyReg g2.re) (jmp0 g2.bo) (cfEmitG ⟨[], [], Termin.clq g2.re (jmp0 (g1.bo + 1)) (jmp0 (g1.bo + 1 + 1))⟩
          { g2 with re := g2.re + 1 }) (cri_reg_emit _ _ _ _ _ (by omega)
            (by rw [← hg2, cf_emitG_drop, cf_emitG_drop, cf_emitG_drop]; exact d1)) x mono sup hx hX
        replace hY0 := hYk.trans hY0 hy2
        replace hx := hYk.soft hx hy2
        replace hX := hYk.pres hX hy2
        rw [cr_goal_reg] at hr
        simp only [crSubj, compCore, cf_emitG_bo, Option.map_some] at hr hre hfl
        have hm : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup (Nomm.n3 p)
            (CGoalL.next (Lazy.mk sur fk bd) ⟨args, there⟩) region g
            = runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg g2.re) (jmp0 g2.bo))) region
              (cfEmitG ⟨[], [], Termin.clq g2.re (jmp0 (g1.bo + 1)) (jmp0 (g1.bo + 1 + 1))⟩
                { g2 with re := g2.re + 1 }) := by
          rw [← hg2]
          simp [runLCMR, CGoal.toL, hne', ecl, fl_forl_eq, re, bind, StateT.bind,
            pure, StateT.pure, cf_emit_g, cf_emitG_bo, cf_emitG_re]
        rw [hm]
        generalize comp.door = Dr at hDc hD1 hD2 hDf hcl hre he hr hfl ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crK3
        simp [nock_exec, crSubj, CGoalL.toNoun, h7, hD0, ne_arm, hne0, hne', loob, hDc, cr_cla_arm, hcl,
          Jmp.toNoun, unitNoun, hDf, comp_fl_arm, hfl, hre, hD1, hD2, comp_emit_arm, he, cr_bat_dol, h15,
          ct_lfn_at, ct_lfn_arm, ct_lfn_gate, hr, cf_emitG_bo]

/-- **The case `%3` on every goal with the invariant.** -/
theorem comp_run_n3LRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p : Nomm)
    (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF)) (hi : GInv g goal)
    (hp : ∀ (goal' : CGoalL CSet) (g1 : Gen (TreapMap mugF)), GInv g1 goal' →
      CompRunAtXT (runLCMR env true msup) ctx X Y p goal' region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n3 p) goal region g := by
  cases goal with
  | next laz th =>
    obtain ⟨sur, fk, bd⟩ := laz
    obtain ⟨args, there⟩ := th
    exact comp_run_n3_nextRTG hYk h7 env msup p sur fk bd args there region g hi.2.1 (lall_mono (fun _ hs => hs.1) hi.1.1)
      (hp _ g hi) (hp_toLRTG hYk hp)
  | pick z o =>
    exact comp_run_n3CRTG hYk h7 env msup p (CGoal.pick z o) region g (gInv_crInv hi) (hp _ g hi) (hp_toLRTG hYk hp)
  | done => exact comp_run_n3CRTG hYk h7 env msup p CGoal.done region g (gInv_crInv hi) (hp _ g hi) (hp_toLRTG hYk hp)

/-- **The tail of the cons case for a `%next` goal**, from `+split` on:
`+past` of `[%next hed ~ o]` over `q`, `q` into `tel`, `+past` over `p`,
`p` into the first `+past`'s need, `+copy`; every need lazy. -/
theorem crc_ntailLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (hpn : PastAt ctx env.cod p)
    (hqn : PastAt ctx env.cod q) (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup : Noun)
    (hed tel : Lazy CSet) (o : Nat) (g1 : Gen (TreapMap mugF))
    (hq : ∀ nexh g2, pastL env.cod ⟨hed, jmp0 o⟩ q region g1 = some (nexh, g2) →
      CompRunAtXT (runLCMR env true msup) ctx X Y q (CGoalL.next tel nexh.th) region g2)
    (hp : ∀ nexh g2 n2 g3 n2' g4, pastL env.cod ⟨hed, jmp0 o⟩ q region g1 = some (nexh, g2) →
      runLCMR env true msup q (CGoalL.next tel nexh.th) region g2 = some (n2, g3) →
      pastL env.cod n2 p region g3 = some (n2', g4) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.next nexh.laz n2'.th) region g4)
    (hcp : ∀ nexh g2 n2 g3 n2' g4 n1 g5, pastL env.cod ⟨hed, jmp0 o⟩ q region g1 = some (nexh, g2) →
      runLCMR env true msup q (CGoalL.next tel nexh.th) region g2 = some (n2, g3) →
      pastL env.cod n2 p region g3 = some (n2', g4) →
      runLCMR env true msup p (CGoalL.next nexh.laz n2'.th) region g4 = some (n1, g5) → CopyH g5.re n1.laz n2'.laz) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (C hed.toNoun (C tel.toNoun (A o))) (crSubj mono (Nomm.cons p q).toNoun goalN
      (listNoun A region) sup (compCore g1 x ctx))) crcNTail
      = ((do
          let nexh ← pastL env.cod ⟨hed, jmp0 o⟩ q region
          let nex2 ← runLCMR env true msup q (CGoalL.next tel nexh.th) region
          let nex2 ← pastL env.cod nex2 p region
          let nex1 ← runLCMR env true msup p (CGoalL.next nexh.laz nex2.th) region
          copyL nex1 nex2.laz : CM (TreapMap mugF) (NextL CSet)) g1).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  have hpa1 := hqn x g1 ⟨hed, jmp0 o⟩ region
  simp only [cr_next_nounL, cr_jmp0, compCore] at hpa1
  have hD1 := cr_past_at
  have hD2 := comp_cp_at
  simp only [compCore]
  cases e1 : pastL (S := CSet) (Map := TreapMap mugF) env.cod ⟨hed, jmp0 o⟩ q region g1 with
  | none =>
    rw [e1] at hpa1
    generalize comp.door = Dr at hpa1 hD1 hD2 ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crcNTail
    simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1, e1]
  | some r1 =>
    obtain ⟨nexh, g2⟩ := r1
    rw [e1] at hpa1
    simp only [Option.map_some, cr_next_nounL] at hpa1
    obtain ⟨x, hy1, hq1⟩ := hq nexh g2 e1 x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    simp only [crSubj, compCore, cgl_next_noun] at hq1
    cases e2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q (CGoalL.next tel nexh.th) region g2 with
    | none =>
      rw [e2] at hq1
      generalize comp.door = Dr at hpa1 hD1 hD2 hq1 ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open crcNTail
      simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1, e1,
        hq1, e2, cgl_next_noun]
    | some r2 =>
      obtain ⟨n2, g3⟩ := r2
      rw [e2] at hq1
      simp only [Option.map_some, cr_next_nounL] at hq1
      have hpa2 := hpn x g3 n2 region
      simp only [cr_next_nounL, compCore] at hpa2
      cases e3 : pastL (S := CSet) (Map := TreapMap mugF) env.cod n2 p region g3 with
      | none =>
        rw [e3] at hpa2
        generalize comp.door = Dr at hpa1 hD1 hD2 hq1 hpa2 ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crcNTail
        simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1,
          e1, hq1, e2, hpa2, e3, cgl_next_noun]
      | some r3 =>
        obtain ⟨n2', g4⟩ := r3
        rw [e3] at hpa2
        simp only [Option.map_some, cr_next_nounL] at hpa2
        obtain ⟨x, hy2, hp1⟩ := hp nexh g2 n2 g3 n2' g4 e1 e2 e3 x mono sup hx hX
        replace hY0 := hYk.trans hY0 hy2
        replace hx := hYk.soft hx hy2
        replace hX := hYk.pres hX hy2
        simp only [crSubj, compCore, cgl_next_noun] at hp1
        cases e4 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup p (CGoalL.next nexh.laz n2'.th) region g4 with
        | none =>
          rw [e4] at hp1
          generalize comp.door = Dr at hpa1 hD1 hD2 hq1 hpa2 hp1 ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open crcNTail
          simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1,
            e1, hq1, e2, hpa2, e3, hp1, e4, cgl_next_noun]
        | some r4 =>
          obtain ⟨n1, g5⟩ := r4
          rw [e4] at hp1
          simp only [Option.map_some, cr_next_nounL] at hp1
          have hcpy := comp_copy_all h7 x g5 n1 n2'.laz (hcp nexh g2 n2 g3 n2' g4 n1 g5 e1 e2 e3 e4)
          simp only [compCore, cr_next_nounL] at hcpy
          generalize comp.door = Dr at hpa1 hD1 hD2 hq1 hpa2 hp1 hcpy ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open crcNTail
          simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1,
            e1, hq1, e2, hpa2, e3, hp1, e4, hD2, cr_cp_arm, hcpy, cgl_next_noun, cr_next_nounL]

/-- **The `%next` branch of the cons case on a lazy goal**: `+split`
(`comp_split_all`), then `crc_ntailLRTG hYk`. -/
theorem crc_nextLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (P : PartRTR env msup ctx X Y p region) (Q : PartRTR env msup ctx X Y q region)
    (x : GenRest) (hx : x.NoSoft) (mono sup : Noun) (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF))
    (hinv : GInv g (CGoalL.next laz th)) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (crSubj mono (Nomm.cons p q).toNoun (CGoalL.next laz th).toNoun (listNoun A region) sup
      (compCore g x ctx)) crKc
      = (runLCMR env true msup (Nomm.cons p q) (CGoalL.next laz th) region g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  have hpn := P.past
  have hqn := Q.past
  have hsp := comp_split_all h7 x g ⟨laz, th⟩ (crInvL_lok (crInvL_of_gInv hinv) 0)
  simp only [cr_next_nounL, compCore] at hsp
  have hDs := cr_split_at
  rw [runLC_cons_nextRG, crc_eq, cgl_next_noun]
  cases es : splitL (Map := TreapMap mugF) ⟨laz, th⟩ g with
  | none =>
    rw [es] at hsp
    simp only [crSubj, compCore, Option.map_none] at hsp ⊢
    generalize comp.door = Dr at hDs hsp ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crcHead
    simp [nock_exec, hDs, crc_split_arm, hsp, bind, StateT.bind, es]
  | some r =>
    obtain ⟨⟨hed, tel, o⟩, g1⟩ := r
    rw [es] at hsp
    obtain ⟨l1, b1, d1, ih, it, nd, -⟩ := splitL_inv hinv es
    obtain ⟨x, hy1, ht⟩ := crc_ntailLRTG hYk h7 hcode env msup p q hpn hqn region x hx mono
      (C (A 0x7478656e) (C laz.toNoun th.toNoun)) sup hed tel o g1
      (fun nexh g2 e1 => by
        obtain ⟨r2, b2, d2, i2, j2, rg2⟩ := pastL_inv ih (jmpIn_jmp0 _ _) e1
        exact Q.link _ _ ⟨linv_mono it (by omega) b2, d2.trans d1, j2⟩)
      (fun nexh g2 n2 g3 n2' g4 e1 e2 e3 => by
        obtain ⟨r2, b2, d2, i2, j2, rg2⟩ := pastL_inv ih (jmpIn_jmp0 _ _) e1
        have hq : GInv g2 (CGoalL.next tel nexh.th) := ⟨linv_mono it (by omega) b2, d2.trans d1, j2⟩
        exact P.link _ _ (tail_pgoal hq i2 (Q.res _ _ _ _ hq e2) e3).1)
      (fun nexh g2 n2 g3 n2' g4 n1 g5 e1 e2 e3 e4 => by
        obtain ⟨r2, b2, d2, i2, j2, rg2⟩ := pastL_inv ih (jmpIn_jmp0 _ _) e1
        have hq : GInv g2 (CGoalL.next tel nexh.th) := ⟨linv_mono it (by omega) b2, d2.trans d1, j2⟩
        have R2 := Q.res _ _ _ _ hq e2
        have R1 := P.res _ _ _ _ (tail_pgoal hq i2 R2 e3).1 e4
        exact (tail_copyH hq i2 (by rw [rg2]; exact nd) R2 e3 R1).1)
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    simp only [crSubj, compCore, Option.map_some] at hsp ht ⊢
    generalize (Nomm.cons p q).toNoun = NN at ht ⊢
    generalize comp.door = Dr at hDs hsp ht ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crcHead
    simp [nock_exec, hDs, crc_split_arm, hsp, ht, bind, StateT.bind, es]

/-- **The branch `%pick` of the cons case**, with lazy results: the
`[%bom ~]` block `o`, `q` for `[%next *need-lazy ~ o]`, `+past` over `p`,
`p` for `[%next *need-lazy then]`, `+copy`. -/
theorem crc_pickLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (P : PartRTR env msup ctx X Y p region) (Q : PartRTR env msup ctx X Y q region)
    (x : GenRest) (hx : x.NoSoft) (mono goalN sup : Noun) (g : Gen (TreapMap mugF)) (hd : g.drop = false) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (crSubj mono (Nomm.cons p q).toNoun goalN (listNoun A region) sup (compCore g x ctx)) crcPick
      = ((do
          let nex2 ← runLCMR env true msup q (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 g.bo)) region
          let nex2 ← pastL env.cod nex2 p region
          let nex1 ← runLCMR env true msup p (CGoalL.next (Lazy.ofSure Sure.bunt) nex2.th) region
          copyL nex1 nex2.laz : CM (TreapMap mugF) (NextL CSet)) (cfEmitG ⟨[], [], Termin.bom Option.none⟩ g)).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hpn := P.past
  have he := cf_emit (x := x) hc g ⟨[], [], Termin.bom Option.none⟩
  rw [crc_blob_bom] at he
  have hq0 : GInv (cfEmitG ⟨[], [], Termin.bom Option.none⟩ g) (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 g.bo)) :=
    ginv_bunt_j (by rw [cf_emitG_drop]; exact hd) (jmpIn_jmp0 _ _)
  obtain ⟨x, hy1, hv1⟩ := Q.link _ _ hq0 x mono sup hx hX
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  rw [cgl_next_noun, Lazy.toNoun_ofSure, cr_bunt_lazy, cr_jmp0] at hv1
  simp only [crSubj, compCore] at hv1
  have hD0 := comp_emit_at
  have hD1 := cr_past_at
  have hD2 := comp_cp_at
  simp only [compCore]
  cases eq : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 g.bo))
      region (cfEmitG ⟨[], [], Termin.bom Option.none⟩ g) with
  | none =>
    rw [eq] at hv1
    generalize comp.door = Dr at hv1 hD0 hD1 hD2 he ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crcPick
    simp [nock_exec, crSubj, Nomm.toNoun, hD0, comp_emit_arm, he, cr_bat_dol, hv1, bind, StateT.bind, eq]
  | some r =>
    obtain ⟨nex2, g2⟩ := r
    rw [eq] at hv1
    simp only [Option.map_some, cr_next_nounL] at hv1
    have hpa2 := hpn x g2 nex2 region
    simp only [cr_next_nounL, compCore] at hpa2
    cases e3 : pastL (S := CSet) (Map := TreapMap mugF) env.cod nex2 p region g2 with
    | none =>
      rw [e3] at hpa2
      generalize comp.door = Dr at hv1 hD0 hD1 hD2 he hpa2 ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open crcPick
      simp [nock_exec, crSubj, Nomm.toNoun, hD0, comp_emit_arm, he, cr_bat_dol, hv1, bind, StateT.bind, eq,
        h7, hcode, hD1, cr_past_arm, hpa2, e3]
    | some r3 =>
      obtain ⟨n2', g3⟩ := r3
      rw [e3] at hpa2
      simp only [Option.map_some, cr_next_nounL] at hpa2
      have R2 := Q.res _ _ _ _ hq0 eq
      have pg := tail_pgoal hq0 (linv_bunt _ _) R2 e3
      obtain ⟨x, hy2, hq1⟩ := P.link _ _ pg.1 x mono sup hx hX
      replace hY0 := hYk.trans hY0 hy2
      replace hx := hYk.soft hx hy2
      replace hX := hYk.pres hX hy2
      rw [cgl_next_noun, Lazy.toNoun_ofSure, cr_bunt_lazy] at hq1
      simp only [crSubj, compCore] at hq1
      cases eq2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup p (CGoalL.next (Lazy.ofSure Sure.bunt) n2'.th)
          region g3 with
      | none =>
        rw [eq2] at hq1
        generalize comp.door = Dr at hv1 hD0 hD1 hD2 he hpa2 hq1 ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crcPick
        simp [nock_exec, crSubj, Nomm.toNoun, hD0, comp_emit_arm, he, cr_bat_dol, hv1, bind, StateT.bind, eq,
          h7, hcode, hD1, cr_past_arm, hpa2, e3, hq1, eq2]
      | some r' =>
        obtain ⟨nex1, g4⟩ := r'
        rw [eq2] at hq1
        simp only [Option.map_some, cr_next_nounL] at hq1
        have R1 := P.res _ _ _ _ pg.1 eq2
        have hcpy := comp_copy_all h7 x g4 nex1 n2'.laz
          (tail_copyH hq0 (linv_bunt _ _) (by simp [lregs_bunt]) R2 e3 R1).1
        simp only [compCore, cr_next_nounL] at hcpy
        generalize comp.door = Dr at hv1 hD0 hD1 hD2 he hpa2 hq1 hcpy ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open crcPick
        simp [nock_exec, crSubj, Nomm.toNoun, hD0, comp_emit_arm, he, cr_bat_dol, hv1, bind, StateT.bind, eq,
          h7, hcode, hD1, cr_past_arm, hpa2, e3, hq1, eq2, hD2, cr_cp_arm, hcpy, cr_next_nounL]

/-- **The cons case of `+run` on every goal with the invariant**, for `p`
and `q` of the plain class, given their links and results on every goal
with the invariant (`PartL`). -/
theorem comp_run_consLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (P : PartRTR env msup ctx X Y p region) (Q : PartRTR env msup ctx X Y q region)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.cons p q) goal region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  obtain ⟨a, b, hab⟩ := crc_nomm_cell p
  have hnn : (Nomm.cons p q).toNoun = C (C a b) q.toNoun := by
    rw [show (Nomm.cons p q).toNoun = C p.toNoun q.toNoun from rfl, hab]
  rw [hnn, cr_disp_cons, ← hnn]
  cases goal with
  | next laz th => exact crc_nextLRTG hYk h7 hcode env msup p q P Q x hx mono sup laz th g hinv
  | done =>
    have e : (CGoalL.done : CGoalL CSet).toNoun = (CGoal.toL CGoal.done).toNoun := rfl
    rw [e, crc_eq, crc_done_step h7, ← crc_eq, runLCM_cons_doneG]
    simp only [bind_apply, re_apply, Option.bind_some, cf_emit_g]
    exact xt_trans hYk hY0 (crc_nextLRTG hYk h7 hcode env msup p q P Q x hx mono sup _ _ _
      (ginv_reg _ (by rw [cf_emitG_re]; simp) (by rw [cf_emitG_drop]; exact hinv)))
  | pick z o =>
    obtain ⟨x, hy2, hpk⟩ := crc_pickLRTG hYk h7 hcode env msup p q P Q x hx mono (CGoalL.pick (S := CSet) z o).toNoun sup g hinv.1
    replace hY0 := hYk.trans hY0 hy2
    replace hx := hYk.soft hx hy2
    replace hX := hYk.pres hX hy2
    rw [runLC_cons_pickRG, crc_eq]
    simp only [crSubj, compCore, CGoalL.toNoun] at hpk ⊢
    generalize (Nomm.cons p q).toNoun = NN at hpk ⊢
    generalize comp.door = Dr at hpk ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open crcHead
    simp [nock_exec, CGoalL.toNoun, hpk, bind, StateT.bind, cf_emit_g]

/-- **The tail of `%5`** with lazy results: `q` into the comparison block
`o`, `+past` over `p`, `p` with the `then` of `q`'s `+past`, `+copy`. -/
theorem cr5_tailLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (hpn : PastAt ctx env.cod p)
    (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup : Noun) (rp rq o : Nat)
    (g1 : Gen (TreapMap mugF))
    (hq : CompRunAtXT (runLCMR env true msup) ctx X Y q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rq) (jmp0 o))) region g1)
    (hp : ∀ nexF g2 nexF' g3, runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rq) (jmp0 o))) region g1 = some (nexF, g2) →
      pastL env.cod nexF p region g2 = some (nexF', g3) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rp) nexF'.th)) region g3)
    (hcp : ∀ nexF g2 nexF' g3 nexS g4, runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rq) (jmp0 o))) region g1 = some (nexF, g2) →
      pastL env.cod nexF p region g2 = some (nexF', g3) →
      runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rp) nexF'.th)) region g3 = some (nexS, g4) →
      CopyH g4.re nexS.laz nexF'.laz) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (A o) (C (A rq) (C (A rp)
      (crSubj mono (Nomm.n5 p q).toNoun goalN (listNoun A region) sup (compCore g1 x ctx))))) cr5Tail
      = ((do
          let nexF ← runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rq) (jmp0 o))) region
          let nexF ← pastL env.cod nexF p region
          let nexS ← runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rp) nexF.th)) region
          copyL nexS nexF.laz : CM (TreapMap mugF) (NextL CSet)) g1).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  have h15 := cr_ctx15 h7
  obtain ⟨x, hy1, hq1⟩ := hq x mono sup hx hX
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  rw [cr_goal_reg] at hq1
  simp only [crSubj, compCore] at hq1
  have hD1 := cr_past_at
  have hD2 := comp_cp_at
  simp only [compCore]
  cases eq : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rq) (jmp0 o)))
      region g1 with
  | none =>
    rw [eq] at hq1
    generalize comp.door = Dr at hq1 hD1 hD2 ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr5Tail
    simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
      StateT.bind, eq]
  | some r =>
    obtain ⟨nexF, g2⟩ := r
    rw [eq] at hq1
    simp only [Option.map_some, cr_next_nounL] at hq1
    have hpa := hpn x g2 nexF region
    simp only [cr_next_nounL, compCore] at hpa
    cases e3 : pastL (S := CSet) (Map := TreapMap mugF) env.cod nexF p region g2 with
    | none =>
      rw [e3] at hpa
      generalize comp.door = Dr at hq1 hD1 hD2 hpa ⊢
      unfold cr5Tail cr5T2 cr5T3
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
        StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, eq, e3]
    | some r3 =>
      obtain ⟨nexF', g3⟩ := r3
      rw [e3] at hpa
      simp only [Option.map_some, cr_next_nounL] at hpa
      obtain ⟨x, hy2, hp1⟩ := hp nexF g2 nexF' g3 eq e3 x mono sup hx hX
      replace hY0 := hYk.trans hY0 hy2
      replace hx := hYk.soft hx hy2
      replace hX := hYk.pres hX hy2
      rw [cr_goal_reg'] at hp1
      simp only [crSubj, compCore] at hp1
      cases eq2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rp) nexF'.th))
          region g3 with
      | none =>
        rw [eq2] at hp1
        generalize comp.door = Dr at hq1 hD1 hD2 hpa hp1 ⊢
        unfold cr5Tail cr5T2 cr5T3
        refine ⟨x, hY0, ?_⟩
        simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
          StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, hp1, eq2, eq, e3]
      | some r' =>
        obtain ⟨nexS, g4⟩ := r'
        rw [eq2] at hp1
        simp only [Option.map_some, cr_next_nounL] at hp1
        have hcpy := comp_copy_all h7 x g4 nexS nexF'.laz (hcp nexF g2 nexF' g3 nexS g4 eq e3 eq2)
        simp only [compCore, cr_next_nounL] at hcpy
        generalize comp.door = Dr at hq1 hD1 hD2 hpa hp1 hcpy ⊢
        unfold cr5Tail cr5T2 cr5T3
        refine ⟨x, hY0, ?_⟩
        simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
          StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, hp1, eq2, hD2, cr_cp_arm, hcpy, eq, e3, cr_next_nounL]

/-- **The case `%5` of `+run` on every goal with the invariant**, `p` and
`q` of the plain class (`PartL`). -/
theorem comp_run_n5LRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (P : PartRTR env msup ctx X Y p region) (Q : PartRTR env msup ctx X Y q region)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n5 p q) goal region g := by
  have hpn := P.past
  have hd := ginv_drop hinv
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hre0 := comp_re' ctx x g
  have hre1 := comp_re' ctx x { g with re := g.re + 1 }
  have hbr := cr5_brL h7 x hx goal g hinv mono (Nomm.n5 p q).toNoun (listNoun A region) sup g.re (g.re + 1)
    { g with re := g.re + 1 + 1 }
  have hD1 := comp_re_at
  have hnn : (Nomm.n5 p q).toNoun = C (A 5) (C p.toNoun q.toNoun) := rfl
  rw [cr5_modelLRG, hnn, cr_disp_n5, cr5_eq]
  rw [hnn] at hbr
  cases eb : cr5BrML g.re (g.re + 1) goal { g with re := g.re + 1 + 1 } with
  | none =>
    rw [eb] at hbr
    simp only [crSubj, compCore, Option.map_none] at hbr hre0 hre1 ⊢
    generalize goal.toNoun = GN at hbr ⊢
    generalize C (A 5) (C p.toNoun q.toNoun) = NN at hbr ⊢
    generalize comp.door = Dr at hD1 hre0 hre1 hbr ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr5Head
    simp [nock_exec, hre0, hre1, hD1, hbr, bind, StateT.bind, eb]
  | some r =>
    obtain ⟨o, g1⟩ := r
    rw [eb] at hbr
    obtain ⟨l1, b1, d1⟩ := km_drop (km_cr5BrML _ _ _) eb hd
    simp only at l1
    have iq : GInv g1 (CGoal.toL (CGoal.next (lazyReg (S := CSet) (g.re + 1)) (jmp0 o))) := ginv_reg o (by omega) d1
    have lp : LInv g1.re g1.bo (Lazy.ofSure (lazyReg (S := CSet) g.re)) := linv_reg (by omega)
    have ap : (lregs (Lazy.ofSure (lazyReg (S := CSet) g.re)) ++ lregs (Lazy.ofSure (lazyReg (S := CSet) (g.re + 1)))).Nodup := by
      simp [lregs_reg]
    obtain ⟨x, hy1, ht⟩ := cr5_tailLRTG hYk h7 hcode env msup p q hpn region x hx mono goal.toNoun sup g.re (g.re + 1) o g1
      (Q.link _ _ iq)
      (fun nexF g2 nexF' g3 e e3 => P.link _ _ (tail_pgoal iq lp (Q.res _ _ _ _ iq e) e3).1)
      (fun nexF g2 nexF' g3 nexS g4 e e3 e4 => by
        have R2 := Q.res _ _ _ _ iq e
        exact (tail_copyH iq lp ap R2 e3 (P.res _ _ _ _ (tail_pgoal iq lp R2 e3).1 e4)).1)
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [hnn] at ht
    simp only [crSubj, compCore, Option.map_some] at hbr hre0 hre1 ht ⊢
    generalize goal.toNoun = GN at hbr ht ⊢
    generalize C (A 5) (C p.toNoun q.toNoun) = NN at hbr ht ⊢
    generalize comp.door = Dr at hD1 hre0 hre1 hbr ht ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr5Head
    simp [nock_exec, hre0, hre1, hD1, hbr, ht, bind, StateT.bind, eb]

/-- **The tail of the indirect call** with lazy results: `q` into the call
block `o`, `+past` over `p`, `p` with the `then` of `q`'s `+past`, `+copy`. -/
theorem cr2_tailLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (hpn : PastAt ctx env.cod p)
    (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup nexN : Noun) (out pro rSub rFol o : Nat)
    (g1 : Gen (TreapMap mugF))
    (hq : CompRunAtXT (runLCMR env true msup) ctx X Y q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rFol) (jmp0 o))) region g1)
    (hp : ∀ nexF g2 nexF' g3, runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rFol) (jmp0 o))) region g1
      = some (nexF, g2) → pastL env.cod nexF p region g2 = some (nexF', g3) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rSub) nexF'.th)) region g3)
    (hcp : ∀ nexF g2 nexF' g3 nexS g4, runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rFol) (jmp0 o)))
      region g1 = some (nexF, g2) → pastL env.cod nexF p region g2 = some (nexF', g3) →
      runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rSub) nexF'.th)) region g3 = some (nexS, g4) →
      CopyH g4.re nexS.laz nexF'.laz) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (A o) (C (A rFol) (C (A rSub) (C (C (A out) (A pro)) (C nexN
      (crSubj mono (Nomm.n2 p q Option.none).toNoun goalN (listNoun A region) sup (compCore g1 x ctx))))))) cr2Tail
      = ((do
          let nexF ← runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rFol) (jmp0 o))) region
          let nexF ← pastL env.cod nexF p region
          let nexS ← runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rSub) nexF.th)) region
          copyL nexS nexF.laz : CM (TreapMap mugF) (NextL CSet)) g1).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  have h15 := cr_ctx15 h7
  obtain ⟨x, hy1, hq1⟩ := hq x mono sup hx hX
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  rw [cr_goal_reg] at hq1
  simp only [crSubj, compCore] at hq1
  have hD1 := cr_past_at
  have hD2 := comp_cp_at
  simp only [compCore]
  cases eq : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q (CGoal.toL (CGoal.next (lazyReg rFol) (jmp0 o)))
      region g1 with
  | none =>
    rw [eq] at hq1
    generalize comp.door = Dr at hq1 hD1 hD2 ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr2Tail
    simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
      StateT.bind, eq]
  | some r =>
    obtain ⟨nexF, g2⟩ := r
    rw [eq] at hq1
    simp only [Option.map_some, cr_next_nounL] at hq1
    have hpa := hpn x g2 nexF region
    simp only [cr_next_nounL, compCore] at hpa
    cases e3 : pastL (S := CSet) (Map := TreapMap mugF) env.cod nexF p region g2 with
    | none =>
      rw [e3] at hpa
      generalize comp.door = Dr at hq1 hD1 hD2 hpa ⊢
      unfold cr2Tail cr2T2 cr2T3
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
        StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, eq, e3]
    | some r3 =>
      obtain ⟨nexF', g3⟩ := r3
      rw [e3] at hpa
      simp only [Option.map_some, cr_next_nounL] at hpa
      obtain ⟨x, hy2, hp1⟩ := hp nexF g2 nexF' g3 eq e3 x mono sup hx hX
      replace hY0 := hYk.trans hY0 hy2
      replace hx := hYk.soft hx hy2
      replace hX := hYk.pres hX hy2
      rw [cr_goal_reg'] at hp1
      simp only [crSubj, compCore] at hp1
      cases eq2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup p (CGoal.toL (CGoal.next (lazyReg rSub) nexF'.th))
          region g3 with
      | none =>
        rw [eq2] at hp1
        generalize comp.door = Dr at hq1 hD1 hD2 hpa hp1 ⊢
        unfold cr2Tail cr2T2 cr2T3
        refine ⟨x, hY0, ?_⟩
        simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
          StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, hp1, eq2, eq, e3]
      | some r' =>
        obtain ⟨nexS, g4⟩ := r'
        rw [eq2] at hp1
        simp only [Option.map_some, cr_next_nounL] at hp1
        have hcpy := comp_copy_all h7 x g4 nexS nexF'.laz (hcp nexF g2 nexF' g3 nexS g4 eq e3 eq2)
        simp only [compCore, cr_next_nounL] at hcpy
        generalize comp.door = Dr at hq1 hD1 hD2 hpa hp1 hcpy ⊢
        unfold cr2Tail cr2T2 cr2T3
        refine ⟨x, hY0, ?_⟩
        simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hq1, bind,
          StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, hp1, eq2, hD2, cr_cp_arm, hcpy, eq, e3, cr_next_nounL,
          Function.comp_def]

/-- **From `+kerf` on, on a lazy `next`**: `+kerf` (`comp_kerf_all`), the
two registers, the call block and `cr2_tailLRTG hYk`. -/
theorem cr2_kfLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (P : PartRTR env msup ctx X Y p region) (Q : PartRTR env msup ctx X Y q region)
    (x : GenRest) (hx : x.NoSoft) (mono goalN sup : Noun) (nex0 : NextL CSet)
    (g1 : Gen (TreapMap mugF)) (hd : g1.drop = false) (hlok : LAll CrLok nex0.laz) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun
      (crSubj mono (Nomm.n2 p q Option.none).toNoun goalN (listNoun A region) sup (compCore g1 x ctx))) cr2Kf
      = (cr2KfMLRG env msup p q region nex0 g1).map fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, hl, hm⟩ := comp_ctx_pill ctx h7
  have hpn := P.past
  have hk := comp_kerf_all hc hl hm x g1 nex0 (walk_mdP hx g1.bo hlok)
  have hD1 := comp_kerf_at
  have hD2 := comp_re_at
  have hD3 := comp_emit_at
  rw [cr_next_nounL]
  simp only [compCore] at hk ⊢
  cases ek : kerf nex0 g1 with
  | none =>
    rw [ek] at hk
    generalize comp.door = Dr at hk hD1 hD2 hD3 ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr2Kf
    simp [nock_exec, crSubj, hD1, comp_kerf_arm, hk, cr2KfMLRG, bind, StateT.bind, ek]
  | some r =>
    obtain ⟨⟨out, pro⟩, g2⟩ := r
    rw [ek] at hk
    simp only [Option.map_some] at hk
    obtain ⟨-, -, d2⟩ := km_drop (km_kerf _) ek hd
    have hre0 := comp_re' ctx x g2
    have hre1 := comp_re' ctx x { g2 with re := g2.re + 1 }
    have he := cf_emit (x := x) hc { { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 }
      ⟨[], [Pole.nok g2.re (g2.re + 1) pro], Termin.hop (jmp0 out)⟩
    rw [cr_blob_nok_hop] at he
    generalize hg5 : cfEmitG ⟨[], [Pole.nok g2.re (g2.re + 1) pro], Termin.hop (jmp0 out)⟩
      { { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 } = g5 at he
    have r5 : g5.re = g2.re + 1 + 1 := by rw [← hg5, cf_emitG_re]
    have d5 : g5.drop = false := by rw [← hg5, cf_emitG_drop]; exact d2
    have iq : GInv g5 (CGoal.toL (CGoal.next (lazyReg (S := CSet) (g2.re + 1)) (jmp0 g2.bo))) :=
      ginv_reg g2.bo (by omega) d5
    have lp : LInv g5.re g5.bo (Lazy.ofSure (lazyReg (S := CSet) g2.re)) := linv_reg (by omega)
    have ap : (lregs (Lazy.ofSure (lazyReg (S := CSet) g2.re)) ++
        lregs (Lazy.ofSure (lazyReg (S := CSet) (g2.re + 1)))).Nodup := by simp [lregs_reg]
    obtain ⟨x, hy1, ht⟩ := cr2_tailLRTG hYk h7 hcode env msup p q hpn region x hx mono goalN sup
      (C (A 0x7478656e) (C nex0.laz.toNoun nex0.th.toNoun)) out pro g2.re (g2.re + 1) g2.bo g5 (Q.link _ _ iq)
      (fun nexF g6 nexF' g7 e e3 => P.link _ _ (tail_pgoal iq lp (Q.res _ _ _ _ iq e) e3).1)
      (fun nexF g6 nexF' g7 nexS g8 e e3 e4 => by
        have R2 := Q.res _ _ _ _ iq e
        exact (tail_copyH iq lp ap R2 e3 (P.res _ _ _ _ (tail_pgoal iq lp R2 e3).1 e4)).1)
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    simp only [crSubj, compCore] at ht hre0 hre1
    generalize comp.door = Dr at hk hD1 hD2 hD3 hre0 hre1 he ht ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr2Kf
    simp [nock_exec, crSubj, hD1, comp_kerf_arm, hk, hD2, hre0, hre1, hD3, comp_emit_arm, he, ht, cr2KfMLRG, bind,
      StateT.bind, ek, re, cf_emit_g, hg5]

/-- **The case `%2` of `+run` for an indirect call on every goal with the
invariant**, `p` and `q` of the plain class (`PartL`): `+simple-next`,
`+kerf` of the lazy `next`, two registers, the block `[%nok r-sub r-fol
pro]`, `q`, `+past` over `p`, `p`, `+copy`. -/
theorem comp_run_n2LRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (P : PartRTR env msup ctx X Y p region) (Q : PartRTR env msup ctx X Y q region)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n2 p q Option.none) goal region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hmod : (runLCMR env true msup (Nomm.n2 p q Option.none) goal region : CM (TreapMap mugF) (NextL CSet)) =
      simpleNextL goal >>= cr2KfMLRG env msup p q region := by
    rfl
  rw [hmod, cr2_noun, cr_disp_n2, cr2_ind]
  have hsn := comp_simple_next hc x g goal mono (C (A 2) (C p.toNoun (C q.toNoun (A 0)))) (listNoun A region) sup
  rw [bind_apply]
  cases e : simpleNextL (S := CSet) (Map := TreapMap mugF) goal g with
  | none =>
    rw [e] at hsn
    simp only [Option.map_none] at hsn
    simp only [crSubj, compCore] at hsn ⊢
    generalize comp.door = Dr at hsn ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr2Ind
    simp [nock_exec, crSubj, hsn, cr_bat_sn]
  | some r =>
    obtain ⟨nex0, g1⟩ := r
    rw [e] at hsn
    simp only [Option.map_some] at hsn
    obtain ⟨-, -, ⟨⟨lnb, -⟩, d1, -⟩, -⟩ := simpleNextL_res hinv e
    obtain ⟨x, hy1, hk⟩ := cr2_kfLRTG hYk h7 hcode env msup p q P Q x hx mono goal.toNoun sup nex0 g1 d1 (lall_mono (fun _ hs => hs.1) lnb)
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [cr2_noun] at hk
    simp only [crSubj, compCore] at hsn hk ⊢
    generalize comp.door = Dr at hsn hk ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr2Ind
    simp [nock_exec, crSubj, hsn, cr_bat_sn, hk]

/-- **The tail of `%10`** with lazy results. -/
theorem cr10_tailLRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (a : Nat) (v q : Nomm) (hvn : PastAt ctx env.cod v)
    (hqn : PastAt ctx env.cod q) (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup nextN : Noun)
    (don rec : Lazy CSet) (o : Nat) (g1 : Gen (TreapMap mugF))
    (hv : ∀ nexR g2, pastL env.cod ⟨rec, jmp0 o⟩ v region g1 = some (nexR, g2) →
      CompRunAtXT (runLCMR env true msup) ctx X Y v (CGoalL.next don nexR.th) region g2)
    (hq : ∀ nexR g2 n2 g3 n2' g4, pastL env.cod ⟨rec, jmp0 o⟩ v region g1 = some (nexR, g2) →
      runLCMR env true msup v (CGoalL.next don nexR.th) region g2 = some (n2, g3) →
      pastL env.cod n2 q region g3 = some (n2', g4) →
      CompRunAtXT (runLCMR env true msup) ctx X Y q (CGoalL.next nexR.laz n2'.th) region g4)
    (hcp : ∀ nexR g2 n2 g3 n2' g4 n1 g5, pastL env.cod ⟨rec, jmp0 o⟩ v region g1 = some (nexR, g2) →
      runLCMR env true msup v (CGoalL.next don nexR.th) region g2 = some (n2, g3) →
      pastL env.cod n2 q region g3 = some (n2', g4) →
      runLCMR env true msup q (CGoalL.next nexR.laz n2'.th) region g4 = some (n1, g5) → CopyH g5.re n1.laz n2'.laz) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (C don.toNoun (C rec.toNoun (A o))) (C nextN (crSubj mono (Nomm.n10 a v q).toNoun goalN
      (listNoun A region) sup (compCore g1 x ctx)))) cr10Tail
      = ((do
          let nexR ← pastL env.cod ⟨rec, jmp0 o⟩ v region
          let nexD ← runLCMR env true msup v (CGoalL.next don nexR.th) region
          let nexD ← pastL env.cod nexD q region
          let nexQ ← runLCMR env true msup q (CGoalL.next nexR.laz nexD.th) region
          copyL nexQ nexD.laz : CM (TreapMap mugF) (NextL CSet)) g1).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  have hpa1 := hvn x g1 ⟨rec, jmp0 o⟩ region
  simp only [cr_next_nounL, cr_jmp0, compCore] at hpa1
  have hD1 := cr_past_at
  have hD2 := comp_cp_at
  simp only [compCore]
  cases e1 : pastL (S := CSet) (Map := TreapMap mugF) env.cod ⟨rec, jmp0 o⟩ v region g1 with
  | none =>
    rw [e1] at hpa1
    generalize comp.door = Dr at hpa1 hD1 hD2 ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr10Tail
    simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1, e1]
  | some r1 =>
    obtain ⟨nexR, g2⟩ := r1
    rw [e1] at hpa1
    simp only [Option.map_some, cr_next_nounL] at hpa1
    obtain ⟨x, hy1, hv1⟩ := hv nexR g2 e1 x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    simp only [crSubj, compCore, cgl_next_noun] at hv1
    cases e2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup v (CGoalL.next don nexR.th) region g2 with
    | none =>
      rw [e2] at hv1
      generalize comp.door = Dr at hpa1 hD1 hD2 hv1 ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open cr10Tail
      simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1, e1,
        hv1, e2, cgl_next_noun]
    | some r2 =>
      obtain ⟨n2, g3⟩ := r2
      rw [e2] at hv1
      simp only [Option.map_some, cr_next_nounL] at hv1
      have hpa2 := hqn x g3 n2 region
      simp only [cr_next_nounL, compCore] at hpa2
      cases e3 : pastL (S := CSet) (Map := TreapMap mugF) env.cod n2 q region g3 with
      | none =>
        rw [e3] at hpa2
        generalize comp.door = Dr at hpa1 hD1 hD2 hv1 hpa2 ⊢
        refine ⟨x, hY0, ?_⟩
        nock_open cr10Tail
        simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1,
          e1, hv1, e2, hpa2, e3, cgl_next_noun]
      | some r3 =>
        obtain ⟨n2', g4⟩ := r3
        rw [e3] at hpa2
        simp only [Option.map_some, cr_next_nounL] at hpa2
        obtain ⟨x, hy2, hq1⟩ := hq nexR g2 n2 g3 n2' g4 e1 e2 e3 x mono sup hx hX
        replace hY0 := hYk.trans hY0 hy2
        replace hx := hYk.soft hx hy2
        replace hX := hYk.pres hX hy2
        simp only [crSubj, compCore, cgl_next_noun] at hq1
        cases e4 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q (CGoalL.next nexR.laz n2'.th) region g4 with
        | none =>
          rw [e4] at hq1
          generalize comp.door = Dr at hpa1 hD1 hD2 hv1 hpa2 hq1 ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open cr10Tail
          simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1,
            e1, hv1, e2, hpa2, e3, hq1, e4, cgl_next_noun]
        | some r4 =>
          obtain ⟨n1, g5⟩ := r4
          rw [e4] at hq1
          simp only [Option.map_some, cr_next_nounL] at hq1
          have hcpy := comp_copy_all h7 x g5 n1 n2'.laz (hcp nexR g2 n2 g3 n2' g4 n1 g5 e1 e2 e3 e4)
          simp only [compCore, cr_next_nounL] at hcpy
          generalize comp.door = Dr at hpa1 hD1 hD2 hv1 hpa2 hq1 hcpy ⊢
          refine ⟨x, hY0, ?_⟩
          nock_open cr10Tail
          simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, bind, StateT.bind, h7, hcode, hD1, cr_past_arm, hpa1,
            e1, hv1, e2, hpa2, e3, hq1, e4, hD2, cr_cp_arm, hcpy, cgl_next_noun, cr_next_nounL]

/-- **The case `%10` of `+run` on every goal with the invariant**, for an
axis not `0`, `v` and `q` of the plain class (`PartL`). -/
theorem comp_run_n10LRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (a : Nat) (ha : a ≠ 0) (v q : Nomm) (V : PartRTR env msup ctx X Y v region)
    (Q : PartRTR env msup ctx X Y q region) (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n10 a v q) goal region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hvn := V.past
  have hqn := Q.past
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hnn : (Nomm.n10 a v q).toNoun = C (A 10) (C (C (A a) v.toNoun) q.toNoun) := rfl
  have hsn := comp_simple_next hc x g goal mono (Nomm.n10 a v q).toNoun (listNoun A region) sup
  have hD := comp_int_at
  rw [runLC_n10RG, hnn, cr_disp_n10, cr10_eq]
  rw [hnn] at hsn
  rw [bind_apply]
  cases es : simpleNextL (S := CSet) (Map := TreapMap mugF) goal g with
  | none =>
    rw [es] at hsn
    simp only [crSubj, compCore, Option.map_none] at hsn ⊢
    generalize goal.toNoun = GN at hsn ⊢
    generalize comp.door = Dr at hD hsn ⊢
    refine ⟨x, hY0, ?_⟩
    nock_open cr10Head
    simp [nock_exec, cr_bat_sn, hsn, bind, StateT.bind, es]
  | some r =>
    obtain ⟨nex, g1⟩ := r
    rw [es] at hsn
    simp only [crSubj, compCore, Option.map_some, cr_next_nounL] at hsn
    have S := simpleNextL_res hinv es
    obtain ⟨-, -, si, -⟩ := S
    have hin := comp_into_all h7 x g1 nex a ha (crInvL_lok (crInvL_of_gInv si) 0)
    simp only [cr_next_nounL, compCore] at hin
    simp only [Option.bind_some]
    cases ei : intoL (Map := TreapMap mugF) nex a g1 with
    | none =>
      rw [ei] at hin
      simp only [crSubj, compCore, Option.map_none] at hin ⊢
      generalize goal.toNoun = GN at hsn ⊢
      generalize comp.door = Dr at hD hsn hin ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open cr10Head
      simp [nock_exec, cr_bat_sn, hsn, bind, StateT.bind, hD, cr_int_arm, hin, ei]
    | some r' =>
      obtain ⟨⟨don, rec, o⟩, g2⟩ := r'
      rw [ei] at hin
      simp only [Option.map_some] at hin
      obtain ⟨l2, b2, d2, id, ir, nd, -⟩ := intoL_inv ha si ei
      have nd' : (lregs rec ++ lregs don).Nodup := by
        rw [List.nodup_append]
        obtain ⟨a1, a2, a3⟩ := List.nodup_append.1 nd
        exact ⟨a2, a1, fun x hx y hy e => a3 y hy x hx e.symm⟩
      have hvg : ∀ nexR g3, pastL env.cod ⟨rec, jmp0 o⟩ v region g2 = some (nexR, g3) →
          GInv g3 (CGoalL.next don nexR.th) ∧ LInv g3.re g3.bo nexR.laz ∧ lregs nexR.laz = lregs rec := by
        intro nexR g3 e1
        obtain ⟨r3, b3, d3, i3, j3, rg3⟩ := pastL_inv ir (jmpIn_jmp0 _ _) e1
        exact ⟨⟨linv_mono id (by omega) b3, d3.trans d2, j3⟩, i3, rg3⟩
      obtain ⟨x, hy1, ht⟩ := cr10_tailLRTG hYk h7 hcode env msup a v q hvn hqn region x hx mono goal.toNoun sup
        (C (A 0x7478656e) (C nex.laz.toNoun nex.th.toNoun)) don rec o g2
        (fun nexR g3 e1 => V.link _ _ (hvg nexR g3 e1).1)
        (fun nexR g3 n2 g4 n2' g5 e1 e2 e3 => by
          obtain ⟨hq, il, -⟩ := hvg nexR g3 e1
          exact Q.link _ _ (tail_pgoal hq il (V.res _ _ _ _ hq e2) e3).1)
        (fun nexR g3 n2 g4 n2' g5 n1 g6 e1 e2 e3 e4 => by
          obtain ⟨hq, il, rg⟩ := hvg nexR g3 e1
          have R2 := V.res _ _ _ _ hq e2
          have R1 := Q.res _ _ _ _ (tail_pgoal hq il R2 e3).1 e4
          exact (tail_copyH hq il (by rw [rg]; exact nd') R2 e3 R1).1)
      replace hY0 := hYk.trans hY0 hy1
      replace hx := hYk.soft hx hy1
      replace hX := hYk.pres hX hy1
      rw [hnn] at ht
      simp only [crSubj, compCore] at ht ⊢
      generalize goal.toNoun = GN at hsn ht ⊢
      generalize comp.door = Dr at hD hsn hin ht ⊢
      refine ⟨x, hY0, ?_⟩
      nock_open cr10Head
      simp [nock_exec, cr_bat_sn, hsn, bind, StateT.bind, hD, cr_int_arm, hin, ei, ht]

