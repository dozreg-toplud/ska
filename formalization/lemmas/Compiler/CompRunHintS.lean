import lemmas.Compiler.CompRunRClass
import lemmas.Ska.CompHintEq

/-!
# The hint cases of `+run`: the case noun of `%11` and the dropped static tag (README Gaps 25)

`crK11` (the case `%11` of the `?-` of `crDol`, door axis `18011890248581118`)
is `[6 cr11T cr11St cr11Dy]` (`cr11_eq`, the parts cut by
`tools/gen/runhint.py`): `cr11T` is `?@  p.nomm`, `cr11St` the atom tag
`[6 cr11TS cr11Kept cr11Rec]` (`cr11TS` the test `?=(hint-static p.nomm)`,
`cr11Rec` the recursion `$(nomm q.nomm)`), `cr11Dy` the cell tag.

* `cr_disp_n11`: `crDol` on a nomm `[11 t]` is `crK11`.
* **`comp_run_n11s_ns`**: a static hint whose tag is not `hint-static`, on
  every goal, against any model `R` that runs it as its formula, from the
  link of `q` at a rest predicate (`CompRunAtX`); `res_n11s_ns`: its result.
* `runLCH_n11s_ns`: `runLCH` runs it as its formula; **`comp_run_n11sH`**,
  **`res_n11sH`**: the case against `runLCH env snd true msup`.
* `PartH`: what a hint case takes of a part (`PartR` with `runLCH`).
-/

namespace Formalization
namespace Compiler

open Nock Pill Hoon SkaModel SkaModel.Comp

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

variable {ctx : Noun}

/-! ## The case noun (generated by `tools/gen/runhint.py`) -/

def cr11T : Noun :=
  (C (A 6) (C (C (A 3) (C (A 0) (A 234))) (C (C (A 1) (A 1)) (C (A 1) (A 0)))))

def cr11TS : Noun :=
  (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x79617278)) (C (A 0) (A 234)))) (C (C (A 1) (A 0)) (C (A 5) (C (C (A 1) (A 0x74756f62)) (C (A 0) (A 234)))))))

def cr11Rec : Noun :=
  (C (A 9) (C (A 5) (C (A 10) (C (C (A 58) (C (A 0) (A 470))) (C (A 0) (A 1))))))

def cr11Kept : Noun := (slot? 1152760975909191606 comp.door).getD (A 0)

def cr11St : Noun := C (A 6) (C cr11TS (C cr11Kept cr11Rec))

def cr11TD : Noun :=
  (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x79617278)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x6e697073)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x74756f62)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x6b6e7568)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x646e6168)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x676f6c73)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x6e61656d)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x65736f6c)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 5) (C (C (A 1) (A 0x746f7073)) (C (A 0) (A 468))))))))))))))))))) (C (C (A 1) (A 0)) (C (A 6) (C (C (A 5) (C (C (A 1) (A 0x786e696a)) (C (A 0) (A 468)))) (C (C (A 1) (A 0)) (C (A 5) (C (C (A 1) (A 0x6576696c)) (C (A 0) (A 468)))))))))))))))))))

def cr11DKept : Noun := (slot? 1152760975909191614 comp.door).getD (A 0)

def cr11NDyn : Noun := (slot? 1152760975909191615 comp.door).getD (A 0)

def cr11Dy : Noun := C (A 6) (C cr11TD (C cr11DKept cr11NDyn))

def cr11Head : Noun := C (A 6) (C cr11T (C cr11St cr11Dy))

/-- **The case `%11` of `crDol` cut into its tests.** -/
theorem cr11_eq : crK11 = cr11Head := by kernel_rfl

/-- The dispatch: `crDol` on `[11 t]` is `crK11`. -/
theorem cr_disp_n11 (t mono goal region sup D : Noun) :
    nock (crSubj mono (C (A 11) t) goal region sup D) crDol
      = nock (crSubj mono (C (A 11) t) goal region sup D) crK11 := by
  nock_open crDol
  simp [nock_exec, crSubj, crTc, crT]

/-- The atom tag `tag`, not `hint-static`: `crK11` recurses on `q`. -/
theorem cr11_ns {tag : Nat} (hs : hintStatic tag = false) (q : Noun) (mono body goal region sup D : Noun) :
    nock (crSubj mono (C (A 11) (C (A tag) (C q body))) goal region sup D) crK11
      = nock (crSubj mono q goal region sup D) crDol := by
  have h1 : tag ≠ 0x74756f62 := by
    intro h; subst h; simp [hintStatic, HintTag.bout] at hs
  have h2 : tag ≠ 0x79617278 := by
    intro h; subst h; simp [hintStatic, HintTag.xray] at hs
  rw [cr11_eq]
  unfold cr11Head cr11St cr11T cr11TS cr11Rec
  simp [nock_exec, crSubj, h1, h2, cr_bat_dol, Ne.symm h1, Ne.symm h2]

/-! ## The dropped static tag against any model -/

/-- **A static hint whose tag is not `hint-static`, on every goal**: the
link of `q` at a rest predicate gives the link of `[11 tag q]` against any
model that runs it as `q`. -/
theorem comp_run_n11s_ns {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)}
    {X : GenRest → Noun → Noun → Prop} {tag : Nat} (hs : hintStatic tag = false) (q : Nomm) (body : Noun)
    (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF))
    (hR : R (Nomm.n11s tag q body) goal region g = R q goal region g)
    (hq : CompRunAtX R ctx X q goal region g) :
    CompRunAtX R ctx X (Nomm.n11s tag q body) goal region g := by
  intro x mono sup hx hX
  rw [hR, ← hq x mono sup hx hX]
  simp only [Nomm.toNoun]
  rw [cr_disp_n11, cr11_ns hs]

/-- Its result: what `q` returns. -/
theorem res_n11s_ns {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)} {tag : Nat}
    (q : Nomm) (body : Noun) (region : List Nat)
    (hR : ∀ goal g, R (Nomm.n11s tag q body) goal region g = R q goal region g)
    (hq : ResForR R q region) : ResForR R (Nomm.n11s tag q body) region := by
  intro goal g g' nex hg he
  rw [hR] at he
  exact hq goal g g' nex hg he

/-! ## Against `runLCH` -/

/-- `runLCH` runs a static hint whose tag is not `hint-static` as its formula. -/
theorem runLCH_n11s_ns (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (mono : Bool) {tag : Nat}
    (hs : hintStatic tag = false) (sup : Option Nomm) (q : Nomm) (body : Noun) (goal : CGoalL CSet)
    (region : List Nat) :
    (runLCH env snd mono sup (Nomm.n11s tag q body) goal region : CM (TreapMap mugF) (NextL CSet)) =
      runLCH env snd mono sup q goal region := by
  simp only [runLCH, hs, Bool.not_false, if_true]

/-- **The dropped static tag against `runLCH env snd true msup`**, on every
goal, for every rest predicate. -/
theorem comp_run_n11sH (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm)
    {X : GenRest → Noun → Noun → Prop} {tag : Nat} (hs : hintStatic tag = false) (q : Nomm) (body : Noun)
    (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF))
    (hq : CompRunAtX (runLCH env snd true msup) ctx X q goal region g) :
    CompRunAtX (runLCH env snd true msup) ctx X (Nomm.n11s tag q body) goal region g :=
  comp_run_n11s_ns hs q body goal region g (by rw [runLCH_n11s_ns env snd true hs]) hq

theorem res_n11sH (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) {tag : Nat}
    (hs : hintStatic tag = false) (q : Nomm) (body : Noun) (region : List Nat)
    (hq : ResForR (runLCH env snd true msup) q region) :
    ResForR (runLCH env snd true msup) (Nomm.n11s tag q body) region :=
  res_n11s_ns q body region (fun _ _ => by rw [runLCH_n11s_ns env snd true hs]) hq

/-! ## What a hint case takes of a part -/

/-- **`PartR` against `runLCH env snd true msup`**: the link at a rest
predicate on every goal with `GInv`, the result, and `+past` over it. -/
structure PartH (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) (ctx : Noun)
    (X : GenRest → Noun → Noun → Prop) (n : Nomm) (region : List Nat) : Prop where
  link : ∀ (goal : CGoalL CSet) (g : Gen (TreapMap mugF)), GInv g goal →
    CompRunAtX (runLCH env snd true msup) ctx X n goal region g
  res : ResForR (runLCH env snd true msup) n region
  past : PastAt ctx env.cod n

/-- A hint-free `PartR` is a `PartH`. -/
theorem partH_of_partR {env : CallEnv} {snd : Nomm → NeedOrd → Bool} {msup : Option Nomm}
    {X : GenRest → Noun → Noun → Prop} {n : Nomm} {region : List Nat} (hh : n.noHint = true)
    (h : PartR env msup ctx X n region) : PartH env snd msup ctx X n region := by
  have e : ∀ goal g, (runLCH env snd true msup n goal region : CM (TreapMap mugF) (NextL CSet)) g =
      runLCM env true msup n goal region g := fun goal g => by rw [runLCH_eq env snd true n hh]
  refine ⟨fun goal g hg => ?_, fun goal g g' nex hg he => ?_, h.past⟩
  · intro x mono sup hx hX
    rw [e]; exact h.link goal g hg x mono sup hx hX
  · rw [e] at he; exact h.res goal g g' nex hg he

/-- **The dropped static tag from a `PartH`.** -/
theorem partH_n11s {env : CallEnv} {snd : Nomm → NeedOrd → Bool} {msup : Option Nomm}
    {X : GenRest → Noun → Noun → Prop} {tag : Nat} (hs : hintStatic tag = false) {q : Nomm} (body : Noun)
    {region : List Nat} (hq : PartH env snd msup ctx X q region) (hpa : PastAt ctx env.cod (Nomm.n11s tag q body)) :
    PartH env snd msup ctx X (Nomm.n11s tag q body) region :=
  ⟨fun goal g hg => comp_run_n11sH env snd msup hs q body goal region g (hq.link goal g hg),
   res_n11sH env snd msup hs q body region hq.res, hpa⟩

