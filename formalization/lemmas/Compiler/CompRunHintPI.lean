/-! ## `+sound` -/

/-- **`+sound` on `nom` returns `snd nom`**, for every need and state. -/
def SoundAt (ctx : Noun) (snd : Nomm → NeedOrd → Bool) (nom : Nomm) : Prop :=
  ∀ (g : Gen (TreapMap mugF)) (x : GenRest) (ned : NeedOrd),
    nock (C sndBat (C (C nom.toNoun ned.toNoun) (compCore g x ctx))) sndBat = some (loob (snd nom ned))

/-- `SoundAt` when `snd` is `+sound-far` of the code table at depth `3`. -/
theorem soundAt_of (h7 : slot? 7 ctx = some compK) {CODE : Noun} (hcode : slot? 52 ctx = some CODE)
    {snd : Nomm → NeedOrd → Bool} {nom : Nomm}
    (hs : ∀ ned, soundFar (nommOf CODE) 3 nom ned = some (snd nom ned)) : SoundAt ctx snd nom := by
  intro g x ned
  rw [snd_gate h7 hcode g x nom.toNoun ned.toNoun]
  exact sf_gate (nommOf CODE) CODE (codeNomms_nommOf CODE) 3 nom ned _ (hs ned)

/-! ## The test of the lock -/

theorem pi_lok (bat rest D th : Noun) (laz : Lazy CSet) :
    nock (C bat (C (C (C (A 0x7478656e) (C laz.toNoun th)) rest) D)) piLok
      = some (loob (HoonSet.small laz.sure.lok)) := by
  obtain ⟨⟨ned, lok⟩, f, b⟩ := laz
  unfold piLok
  rcases cs_small_cases lok with ⟨hsm, hl | hl⟩ | ⟨hsm, n, l, r, hl, hne⟩
  · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, eqCode, loob, hl, hsm]
  · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, eqCode, loob, hl, hsm]
  · rcases n with k | ⟨n1, n2⟩
    · by_cases hk : k = 1
      · subst hk
        rcases l with l | ⟨l1, l2⟩
        · by_cases hl0 : l = 0
          · subst hl0
            rcases r with r | ⟨r1, r2⟩
            · have hr0 : r ≠ 0 := fun e => hne ⟨rfl, rfl, by rw [e]⟩
              simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, loob, hl, hsm, Ne.symm hr0]
            · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, eqCode, loob, hl, hsm]
          · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, loob, hl, hsm, Ne.symm hl0]
        · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, eqCode, loob, hl, hsm]
      · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, loob, hl, hsm, Ne.symm hk]
    · simp [nock_exec, Lazy.toNoun, Sure.toNoun, Lazy.sure, eqCode_atom, eqCode, loob, hl, hsm]

/-! ## The link -/

/-- **`+past-if` is `pastIfL snd`** on every `next`, on a nomm on which
`+sound` returns `snd` (`SoundAt`), in a context with `K` at axis `7`. -/
theorem comp_past_if (h7 : slot? 7 ctx = some compK) {snd : Nomm → NeedOrd → Bool}
    (x : GenRest) (g : Gen (TreapMap mugF)) (nex : NextL CSet) (nom : Nomm) (region : List Nat)
    (hs : SoundAt ctx snd nom) :
    nock (C piBat (C (C nex.goal.toNoun (C nom.toNoun (listNoun A region))) (compCore g x ctx))) piBat
      = (pastIfL snd nex nom region g).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  obtain ⟨⟨sr, fk, bd⟩, ⟨args, there⟩⟩ := nex
  have hl := pi_lok piBat (C nom.toNoun (listNoun A region)) (compCore g x ctx) (Jmp.toNoun ⟨args, there⟩)
    (Lazy.mk sr fk bd)
  have hsnd := hs g x (needToOrd sr.ned)
  have hnt := nta_gate compK sr.ned
  have hK := nta_at
  have hS := comp_sound_at
  have he := cf_emit (x := x) hc g ⟨[], [], Termin.hop ⟨args, there⟩⟩
  simp only [Blob.toNoun, listNoun, Termin.toNoun, Tag.hop, Jmp.toNoun] at he
  have hst := comp_set_tag x hc (cfEmitG ⟨[], [], Termin.hop ⟨args, there⟩⟩ g) g.bo region
  have hD2 := comp_emit_at
  have hD3 := comp_set_tag_at
  simp only [NextL.goal, CGoalL.toNoun]
  simp only [compCore] at hst hsnd hl ⊢
  generalize comp.door = Dr at hD2 hD3 he hst hsnd hS hl ⊢
  nock_open piBat
  cases es : HoonSet.small sr.lok <;> cases ed : snd nom (needToOrd sr.ned)
  all_goals
    simp [nock_exec, Lazy.toNoun, Lazy.forksNoun, Lazy.bondsNoun, Sure.toNoun, Lazy.sure, Lazy.fork, Lazy.bond,
      Jmp.toNoun, es, ed, loob] at hl
    simp [nock_exec, hl, es, ed, loob, hsnd, hnt, hK, ntaHint, hS, snd_arm, h7, pastIfL, pure, StateT.pure,
      NextL.goal, CGoalL.toNoun, hD2, hD3, comp_emit_arm, he, comp_set_tag_arm, hst, cf_emit_g, setTag, bind,
      StateT.bind, Lazy.toNoun, Lazy.forksNoun, Lazy.bondsNoun, Sure.toNoun, Sure.bunt, Need.toNoun, Tag.none,
      HoonSet.toNoun_empty, jmp0, listNoun, Lazy.sure, Lazy.fork, Lazy.bond, Jmp.toNoun, piSnd, piRest]

