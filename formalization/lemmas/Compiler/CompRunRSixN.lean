          let (s0, s1) ← forkSure s th.there o0 o1
          let rid ← idM
          sixNfKR env msup p q r region s0 s1 o0 o1 rid) := by
  show sixNextLC env.cod _ _ _ p q r 3 (Lazy.mk s [] []) th region = _
  rw [sixNextLC_fork_free]
  rfl

/-- **The case `%6` of `+run` under a fork-free `%next` goal** (no fork, no
bond: phase S), on every state with the invariant, given the links and
results of the parts (`SixParts`): the test `p` in the case's region, the
branches `q` and `r` in every region `rid :: region` (they run in the
region of the fork). -/
theorem comp_run_n6_nfR (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsR env msup ctx X p region) (Q : ∀ rid, SixPartsR env msup ctx X q (rid :: region))
    (R : ∀ rid, SixPartsR env msup ctx X r (rid :: region))
    (s : Sure CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next (Lazy.mk s [] []) th)) :
    CompRunAtX (runLCM env true msup) ctx X (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region g := by
  intro x mono sup hx hX
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hd : g.drop = false := ginv_drop hinv
  have hl0 : CrLok s := hinv.1.1.1.1
  rw [cr6s_head_nf h7, runLC_n6_nfR]
  refine cr6s_s01 hc p q r s th region x g mono sup (sixNfKR env msup p q r region) (fun s0 s1 g3 ef => ?_)
  obtain ⟨-, -, d3, lk0, lk1, D0, D1, -, fr⟩ := forkSure_inv ef
  have dI : (idG g3).drop = false := d3.trans hd
  have gi1 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) :=
    ginv_ofSure (fun y hy => hl0 y (lk1 ▸ hy)) (fun y hy => (fr y (Or.inr hy)).2) D1 dI
  have gi0 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_ofSure (fun y hy => hl0 y (lk0 ▸ hy)) (fun y hy => (fr y (Or.inl hy)).2) D0 dI
  exact cr6s_midR (ctx := ctx) env msup p q r (g3.id :: region) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo))
    (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) x hx (idG g3) mono
    (CGoalL.next (Lazy.mk s [] []) th).toNoun (listNoun A region) sup (A 0)
    (fun cb cbw nex0 nex1 => sixLynNR env msup p region (g3.id :: region) g.bo (g.bo + 1) cb cbw nex0 nex1)
    ((R g3.id).link _ _ gi1)
    (fun nex1 g1 e1 => (Q g3.id).link _ g1 (by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      exact ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)))
    (fun nex1 g1 nex0 g2 e1 e2 => by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      have hi0 := ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)
      obtain ⟨l2, -, gi2, -⟩ := (Q g3.id).res _ g1 g2 nex0 hi0 e2
      exact cr6s_lyn_nR h7 hcode env msup p q r region (g3.id :: region) P.pf
        (fun yes nuh g' hd' => P.link _ g' ⟨hd', jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) P.res x hx g2 (ginv_drop gi2)
        nex0 nex1 gi2.1.1 (lnb_mono l2 0 gi1'.1.1) (Lazy.ofSure s0) (Lazy.ofSure s1) g.bo (g.bo + 1)
        (idG g3).cond g1.cond mono (C (Lazy.mk s [] []).toNoun th.toNoun) sup (A 0))

/-- **What `%6` returns under a fork-free `%next` goal**: `GRes`, given what
the runs of the parts return; every register of the result is fresh (the
branch goals' registers come from `+fork-sure`, the branches' needs are
apart, the fork of `+sect` meets `LInv`). -/
theorem res_n6_nfR {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCM env true msup) p region) (ihq : ∀ rid, ResForR (runLCM env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCM env true msup) r (rid :: region))
    (s : Sure CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next (Lazy.mk s [] []) th))
    (h : runLCM env true msup (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region g = some (nex, g')) :
    GRes g (CGoalL.next (Lazy.mk s [] []) th) g' nex := by
  have hd := ginv_drop hi
  have hl0 : CrLok s := hi.1.1.1.1
  rw [runLC_n6_nfR] at h
  obtain ⟨o0, gA, eA, h⟩ := bind_some h
  rw [oo_ap] at eA
  simp only [Option.some.injEq, Prod.mk.injEq] at eA
  obtain ⟨rfl, rfl⟩ := eA
  obtain ⟨o1, gB, eB, h⟩ := bind_some h
  rw [oo_ap, ooG_bo] at eB
  simp only [Option.some.injEq, Prod.mk.injEq] at eB
  obtain ⟨rfl, rfl⟩ := eB
  obtain ⟨⟨s0, s1⟩, g3, ef, h⟩ := bind_some h
  obtain ⟨r3, b3, d3, lk0, lk1, D0, D1, aps, fr⟩ := forkSure_inv ef
  obtain ⟨rid, gI, eI, h⟩ := bind_some h
  rw [idM_ap] at eI
  simp only [Option.some.injEq, Prod.mk.injEq] at eI
  obtain ⟨rfl, rfl⟩ := eI
  have dI : (idG g3).drop = false := d3.trans hd
  have gi1 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) :=
    ginv_ofSure (fun y hy => hl0 y (lk1 ▸ hy)) (fun y hy => (fr y (Or.inr hy)).2) D1 dI
  have gi0 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_ofSure (fun y hy => hl0 y (lk0 ▸ hy)) (fun y hy => (fr y (Or.inl hy)).2) D0 dI
  unfold sixNfKR at h
  obtain ⟨c0, g0, e0, h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e0
  obtain ⟨-, rfl⟩ := e0
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  obtain ⟨c1, g1', e1', h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e1'
  obtain ⟨-, rfl⟩ := e1'
  obtain ⟨nex0, g2, e2, h⟩ := bind_some h
  obtain ⟨l1, b1, gj1, s1r⟩ := ihr g3.id _ _ g1 nex1 gi1 e1
  have hi0 : GInv g1 (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_mono gi0 l1 b1 ((ginv_drop gj1).trans dI.symm)
  obtain ⟨l2, b2, gj2, s2r⟩ := ihq g3.id _ g1 g2 nex0 hi0 e2
  have d2 : g2.drop = false := ginv_drop gj2
  unfold sixLynNR at h
  obtain ⟨⟨lz, yes, nuh⟩, g4, e3, h⟩ := bind_some h
  have hlz := sect_lazy e3
  obtain ⟨k4r, k4b, k4d⟩ := (km_sect nex0 nex1 g.bo (g.bo + 1) (g3.id :: region) c0 c1).keep _ _ _ e3
  obtain ⟨hy, hn⟩ := sect_labels e3
  subst hlz
  have d4 : g4.drop = false := k4d.trans d2
  unfold sixPMR at h
  obtain ⟨lazy, g7, e7, h⟩ := bind_some h
  simp only [liftO] at e7
  cases epf : Lazy.pastFork env.cod (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) p with
  | none => rw [epf] at e7; cases e7
  | some lz' =>
  rw [epf] at e7
  simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at e7
  obtain ⟨rfl, rfl⟩ := e7
  obtain ⟨nexC, g8, e8, h⟩ := bind_some h
  obtain ⟨l8, b8, gi8, s8⟩ := ihp _ g4 g8 nexC
    (show GInv g4 (CGoalL.pick (jmp0 yes) (jmp0 nuh)) from ⟨d4, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) e8
  -- the registers of the branches' needs: fresh, or of the goals of `+fork-sure`
  have rI : (idG g3).re = g3.re := rfl
  have rO : (ooG (ooG g)).re = g.re := rfl
  have bI : (idG g3).bo = g3.bo := rfl
  have f0 : ∀ y ∈ lregs nex0.laz, g1.re ≤ y ∨ NMem s0.ned y := fun y hy => by
    rcases s2r y hy with e | e
    · exact Or.inl e
    · simp only [gregs, lregs_ofSure] at e
      exact Or.inr ((mem_flatten _ _).1 e)
  have f1 : ∀ y ∈ lregs nex1.laz, g3.re ≤ y ∨ NMem s1.ned y := fun y hy => by
    rcases s1r y hy with e | e
    · exact Or.inl e
    · simp only [gregs, lregs_ofSure] at e
      exact Or.inr ((mem_flatten _ _).1 e)
  have lv0 : LInv g4.re g4.bo nex0.laz := linv_mono gj2.1 k4r k4b
  have lv1 : LInv g4.re g4.bo nex1.laz := linv_mono gj1.1 (by omega) (by omega)
  have ap01 : ∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz := fun y hy hy' => by
    have hb1 := lnb_regs gj1.1.1 y hy'
    rcases f0 y hy with e | e
    · omega
    · have := (fr y (Or.inl e)).2
      rcases f1 y hy' with e' | e'
      · omega
      · exact aps y e e'
  have lvF := lyn_linv lv0 lv1 ap01 hy hn
  have lvP : LInv g4.re g4.bo lz' := linv_pastFork epf lvF
  have hC : LInv g8.re g8.bo nexC.laz := gi8.1
  have hP8 : LInv g8.re g8.bo lz' := linv_mono lvP l8 b8
  have ap8 : (lregs nexC.laz ++ lregs lz').Nodup := by
    refine List.nodup_append.2 ⟨gi8.1.2.1, lvP.2.1, fun a ha b hb e => ?_⟩
    subst e
    have := lnb_regs lvP.1 a hb
    rcases s8 a ha with e | e
    · omega
    · simp [gregs] at e
  obtain ⟨l9, b9, gi9, s9⟩ := six_tail_res hC hP8 ap8 (ginv_drop gi8) h
  have rg3 : g.re ≤ g3.re := rO ▸ r3
  refine ⟨by omega, by simp only [ooG_bo] at b3; omega, gi9, fun y hy => Or.inl ?_⟩
  rcases s9 y hy with e | e
  · rcases List.mem_append.1 e with e | e
    · rcases s8 y e with e' | e'
      · omega
      · simp [gregs] at e'
    · rw [lregs_pastFork epf] at e
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append] at e
      rcases e with e | e
      · rcases f0 y e with e' | e'
        · omega
        · have := (fr y (Or.inl e')).1; omega
      · rcases f1 y e with e' | e'
        · omega
        · have := (fr y (Or.inr e')).1; omega
  · omega

/-- The model of `%6` under a `%next` goal whose `+leap` is `~`, whose need
with the bunt sure is not `+none-equivalent` and whose `+kerf` test holds:
`+kerf`, then the case on the goal `[%next [[%this pro] ~] ~ ~] ~ out]`. -/
theorem runLC_n6_kR (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false) (hkt : kerfTest q r laz = true) :
    (runLCM env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let (out, pro) ← kerf ⟨laz, th⟩
          runLCM env true msup (Nomm.n6 p q r)
            (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region) := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region = _
  unfold kerfTest at hkt
  rw [sixNextLC.eq_2]
  simp only [hlp, hne, Bool.not_false, if_true, hkt]
  congr 1
  funext v
  obtain ⟨out, pro⟩ := v
  have e : ∀ L J, (runLCM env true msup (Nomm.n6 p q r) (CGoalL.next L J) region : CM (TreapMap mugF) (NextL CSet))
      = sixNextLC env.cod (runLCM env true msup p) (runLCM env true msup q) (runLCM env true msup r) p q r 3 L J region :=
    fun _ _ => rfl
  rw [e]
  simp only [Lazy.ofSure, sixNextLC_fork_free]

/-- **Phase K** (`cr6K0`, `cr6K1`): `+kerf` of the goal (`comp_kerf_all`),
the state put back, then `$` again on the goal `[%next (lazy-from-need
this+pro) ~ out]`, given the link of that run. -/
theorem cr6k_eqR (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (laz : Lazy CSet) (th : Jmp) (region : List Nat) (x : GenRest) (g : Gen (TreapMap mugF))
    (mono sup LEP : Noun) (hP : WalkP (mdP x) g.bo laz)
    (hK : ∀ out pro g', kerf ⟨laz, th⟩ g = some ((out, pro), g') →
      nock (crSubj mono (Nomm.n6 p q r).toNoun
        (CGoalL.next (Lazy.ofSure (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet)) (jmp0 out)).toNoun
          (listNoun A region) sup
        (compCore g' x ctx)) crDol
      = (runLCM (S := CSet) env true msup (Nomm.n6 p q r)
          (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region g').map
          fun p => C p.1.goal.toNoun (genNoun p.2 x)) (hX : X x mono sup := by assumption) :
    nock (C LEP (crSubj mono (Nomm.n6 p q r).toNoun (CGoalL.next laz th).toNoun (listNoun A region) sup
      (compCore g x ctx))) cr6K0
      = ((do
          let (out, pro) ← kerf ⟨laz, th⟩
          runLCM env true msup (Nomm.n6 p q r)
            (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region :
            CM (TreapMap mugF) (NextL CSet)) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, hl, hm⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  have hkf := comp_kerf_all hc hl hm x g ⟨laz, th⟩ hP
  have hD := comp_kerf_at
  simp only [compCore] at hkf
  rw [bind_apply]
  cases ek : kerf ⟨laz, th⟩ g with
  | none =>
    rw [ek] at hkf
    simp only [Option.bind_none, Option.map_none]
    simp only [crSubj, compCore, CGoalL.toNoun] at hkf ⊢
    generalize comp.door = Dr at hD hkf ⊢
    unfold cr6K0
    simp [nock_exec, hD, comp_kerf_arm, hkf]
  | some v =>
    obtain ⟨⟨out, pro⟩, g'⟩ := v
    rw [ek] at hkf
    have hr := hK out pro g' ek
    rw [goalK_noun] at hr
    simp only [Option.bind_some, Option.map_some] at hkf ⊢
    simp only [crSubj, compCore, CGoalL.toNoun] at hkf hr ⊢
    generalize comp.door = Dr at hD hkf hr ⊢
    unfold cr6K0 cr6K1
    simp [nock_exec, hD, comp_kerf_arm, hkf, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hr]

/-- **The case `%6` of `+run` in phase K**: under a `%next` goal with
`GInv` whose `+leap` is `~` (`hlp`, in the model; the Nock of `+leap` is the
model's by `lp6_leap_none`, for `q` and `r` with no axis `0`, `hq`, `hr`),
whose need with the bunt sure is not `+none-equivalent` and whose `+kerf`
test holds, given the parts (`SixParts`, the branches in the regions
`rid :: region`): `+kerf`, then phase S on the fork-free goal
(`comp_run_n6_nfR`). -/
theorem comp_run_n6_kR (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsR env msup ctx X p region) (Q : ∀ rid, SixPartsR env msup ctx X q (rid :: region))
    (R : ∀ rid, SixPartsR env msup ctx X r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (hlp : leap laz q r = some Option.none) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = true) :
    CompRunAtX (runLCM env true msup) ctx X (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hd := ginv_drop hinv
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  rw [cr6k_head h7 p q r laz th region x hx g mono sup (lp6_leap_none h7 hl hq hr g hlp x hx) hne hkt,
    runLC_n6_kR env msup p q r laz th region hlp hne hkt]
  exact cr6k_eqR h7 env msup p q r laz th region x g mono sup (A 0) (walk_mdP hx _ hl)
    (fun out pro g' ek => comp_run_n6_nfR h7 hcode env msup p q r region P Q R ⟨Need.this pro, HoonSet.empty⟩
      (jmp0 out) g' (ginv_kerf ek hd) x mono sup hx hX)

/-- **What `%6` returns in phase K**: `GRes`, given what the runs of the
parts return (`res_n6_nfR` after `+kerf`; the register of `+kerf` is fresh). -/
theorem res_n6_kR {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCM env true msup) p region) (ihq : ∀ rid, ResForR (runLCM env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCM env true msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = true)
    (h : runLCM env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_kR env msup p q r laz th region hlp hne hkt] at h
  obtain ⟨⟨out, pro⟩, g1, ek, h⟩ := bind_some h
  obtain ⟨-, hrp, hp, hb, -⟩ := kerf_inv ek
  obtain ⟨r1, b1, gi, fr⟩ := res_n6_nfR ihp ihq ihr ⟨Need.this pro, HoonSet.empty⟩ (jmp0 out) g1 g' nex
    (ginv_kerf ek (ginv_drop hi)) h
  refine ⟨by omega, by omega, gi, fun y hy => Or.inl ?_⟩
  rcases fr y hy with e | e
  · omega
  · change y ∈ lregs (Lazy.ofSure (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet)) at e
    rw [show (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet) = lazyReg pro from rfl, lregs_reg pro] at e
    have ey : y = pro := by simpa using e
    omega

end Compiler
