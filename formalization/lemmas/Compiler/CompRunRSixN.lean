(`sixNextLC_fork_free`). -/
theorem runLC_n6_nfR (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (s : Sure CSet) (th : Jmp)
    (region : List Nat) :
    (runLCM env true msup (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let o0 ← oo
