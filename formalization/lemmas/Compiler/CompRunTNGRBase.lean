/-- With no direct call, `runLCMR` is `runLC` at `mono` `|` (`runLCMR_eq`, `runLCM_false`). -/
theorem ringFreeN_of_noDirectNG (env : CallEnv) : ∀ (nm : Nomm), nm.noDirect = true → RingFreeN env nm := by
  intro nm
  induction nm with
  | cons p q ihp ihq =>
    intro h; simp only [Nomm.noDirect, Bool.and_eq_true] at h; exact ⟨ihp h.1, ihq h.2⟩
  | n2 p q info ihp ihq =>
    intro h; simp only [Nomm.noDirect, Bool.and_eq_true] at h
    refine ⟨fun b k hk => ?_, ihp h.1.2, ihq h.2⟩
    rw [hk] at h; simp at h
  | n3 p ihp => intro h; exact ihp h
  | n4 p ihp => intro h; exact ihp h
  | n5 p q ihp ihq =>
    intro h; simp only [Nomm.noDirect, Bool.and_eq_true] at h; exact ⟨ihp h.1, ihq h.2⟩
  | n6 p q r ihp ihq ihr =>
    intro h; simp only [Nomm.noDirect, Bool.and_eq_true] at h; exact ⟨ihp h.1.1, ihq h.1.2, ihr h.2⟩
  | n7 p q ihp ihq =>
    intro h; simp only [Nomm.noDirect, Bool.and_eq_true] at h; exact ⟨ihp h.1, ihq h.2⟩
  | n10 a v q ihv ihq =>
    intro h; simp only [Nomm.noDirect, Bool.and_eq_true] at h; exact ⟨ihv h.1, ihq h.2⟩
  | n0 _ => intro _; trivial
  | n1 _ => intro _; trivial
  | n11s _ _ _ _ => intro _; trivial
  | n11d _ _ _ _ _ _ => intro _; trivial
  | n12 _ _ _ _ => intro _; trivial
  | mean _ _ _ _ _ _ _ => intro _; trivial

theorem runLCMR_false_ndNG {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]
    (env : CallEnv) {nm : Nomm} (h : nm.noDirect = true) (sup : Option Nomm) :
    (runLCMR env false sup nm : CGoalL S → List Nat → CM Map (NextL S)) = runLC env sup nm := by
  funext goal region
  rw [runLCMR_eq env false nm (ringFreeN_of_noDirectNG env nm h) sup goal region, runLCM_false]

/-- `runLC_n2_none` (`CompIndirect.lean`) for `runLCMR env false`: the indirect call. -/
theorem runLCM_n2_noneNG {env : CallEnv} {sup : Option Nomm} {p q : Nomm} {goal : CGoalL S} {region : List Nat}
    {g0 g' : Gen Map} {nex : NextL S}
    (h : runLCMR env false sup (Nomm.n2 p q Option.none) goal region g0 = some (nex, g')) :
    ∃ (nex0 : NextL S) (g1 : Gen Map) (out pro : Nat) (g2 : Gen Map) (o : Nat) (g3 : Gen Map)
      (nexF : NextL S) (g4 : Gen Map) (nexF' : NextL S) (g5 : Gen Map) (nexS : NextL S) (g6 : Gen Map),
      simpleNextL goal g0 = some (nex0, g1) ∧ kerf nex0 g1 = some ((out, pro), g2) ∧
      emit ⟨[], [Pole.nok g2.re (g2.re + 1) pro], Termin.hop (jmp0 out)⟩
        { { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 } = some (o, g3) ∧
      runLCMR env false sup q (CGoalL.next (Lazy.ofSure (lazyReg (g2.re + 1))) (jmp0 o)) region g3 = some (nexF, g4) ∧
      pastL env.cod nexF p region g4 = some (nexF', g5) ∧
      runLCMR env false sup p (CGoalL.next (Lazy.ofSure (lazyReg g2.re)) nexF'.th) region g5 = some (nexS, g6) ∧
      copyL nexS nexF'.laz g6 = some (nex, g') := by
  simp only [runLCMR, callLMR, callLR] at h
  obtain ⟨nex0, g1, h1, h⟩ := bind_some h
  obtain ⟨⟨out, pro⟩, g2, h2, h⟩ := bind_some h
  obtain ⟨rSub, ga, ha, h⟩ := bind_some h
  rw [re_apply] at ha
  simp only [Option.some.injEq, Prod.mk.injEq] at ha
  obtain ⟨rfl, rfl⟩ := ha
  obtain ⟨rFol, gb, hb, h⟩ := bind_some h
  rw [re_apply] at hb
  simp only [Option.some.injEq, Prod.mk.injEq] at hb
  obtain ⟨rfl, rfl⟩ := hb
  obtain ⟨o, g3, h3, h⟩ := bind_some h
  obtain ⟨nexF, g4, h4, h⟩ := bind_some h
  obtain ⟨nexF', g5, h5, h⟩ := bind_some h
  obtain ⟨nexS, g6, h6, h⟩ := bind_some h
  exact ⟨nex0, g1, out, pro, g2, o, g3, nexF, g4, nexF', g5, nexS, g6, h1, h2, h3, h4, h5, h6, h⟩

/-- `runLC_cons_done` (`CompConsCallTop.lean`) for `runLCMR env false`. -/
theorem runLCM_cons_doneNG (env : CallEnv) (sup : Option Nomm) (p q : Nomm) (region : List Nat) :
    (runLCMR env false sup (Nomm.cons p q) CGoalL.done region : CM Map (NextL S)) = (do
      let r ← re
      let o ← emit ⟨[], [], Termin.don r⟩
      runLCMR env false sup (Nomm.cons p q) (CGoalL.next (Lazy.ofSure (lazyReg r)) (jmp0 o)) region) := by
  conv => lhs; unfold runLCMR
  rfl

end

