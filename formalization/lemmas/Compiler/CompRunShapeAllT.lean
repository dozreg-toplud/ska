/-!
# `+run-shape`: the induction with `%6`, threading the rest of `gen` (track A, 2026-11-28)

Generated by `tools/gen/runshapet.py` from `rs_clsE6` / `rs_doneE6` (`CompRunShapeAll6.lean`): the
case lemmas replaced by their threaded copies (`CompRunShapeTCases/TSixDP/TSixN/TTwo.lean`), so a
need push that compiles a callee (a miss in `nary.cache`, `+callee-compiled`) is covered.

* **`rs_clsT6`**, **`rs_doneT6`** (the sweeps' call under `[%done ~]`, `sup` `~`).
-/

namespace Formalization
namespace Compiler

open Nock Pill Hoon SkaModel SkaModel.Comp

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

variable {ctx : Noun}

section
variable (hc : CompIn ctx) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
  (env : ShapeEnv) (hcn : CodeNomms env.cod cod) (E : RsRest → Prop) (Rl : RsRest → RsRest → Prop)
  (hR : RlPre Rl)
include hc h7 hcode hcn hR

/-- **The induction threading the rest**: `rs_clsE6` on `RsAtT` (a callee compiled inside a need push moves the rest). -/
theorem rs_clsT6 : ∀ (n : Nomm), RsClsE6 env n → CallCode cod (shapeCE env) n → ∀ sup, ShapeOKT ctx env E Rl sup n →
    ∀ goal st, GoalNZ goal → RsAtT ctx env E Rl n sup goal st
  | Nomm.n0 a, _, _, sup, _, goal, st, hg => rsAtT_of hR (rs_n0W hc env a sup goal st hg)
  | Nomm.n1 k, _, _, sup, _, goal, st, _ => rsAtT_of hR (rs_n1 env k sup goal st)
  | Nomm.n3 p, hp, hcc, sup, hs, goal, st, hg =>
    rs_n3T hc env hR p sup goal st (rs_clsT6 p hp hcc sup hs goal st hg)
      (rs_clsT6 p hp hcc sup hs (GoalS.next thisL) st lzNZ_thisL)
  | Nomm.n4 p, hp, hcc, sup, hs, goal, st, _ =>
    rs_n4T env hR p sup goal st (rs_clsT6 p hp hcc sup hs (GoalS.next thisL) st lzNZ_thisL)
  | Nomm.n7 p q, ⟨hp, hq⟩, ⟨hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, hg =>
    rs_n7T env hR p q sup goal st (rs_clsT6 q hq hcq (some p) hsq goal st hg)
      (fun l st1 e => rs_clsT6 p hp hcp sup hsp (GoalS.next l) st1
        (runShape_nzE6 env q hq (some p) goal st l st1 hg e))
  | Nomm.cons p q, ⟨hp, hq⟩, ⟨hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, hg =>
    rs_consT hc h7 hcode env hR p q sup goal hg st hcp hcq
      (fun l st1 hl => rs_clsT6 q hq hcq sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsT6 p hp hcp sup hsp (GoalS.next l) st1 hl)
  | Nomm.n10 a v q, ⟨hv, hq⟩, ⟨hcv, hcq⟩, sup, ⟨hsv, hsq⟩, goal, st, hg =>
    rs_n10T hc h7 hcode env hR a v q sup goal hg st hcv hcq
      (fun l st1 hl => rs_clsT6 q hq hcq sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsT6 v hv hcv sup hsv (GoalS.next l) st1 hl)
  | Nomm.n5 p q, ⟨hp, hq⟩, ⟨hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, _ =>
    rs_n5T hc h7 hcode env hR p q sup goal st hcp
      (fun st1 => rs_clsT6 q hq hcq sup hsq (GoalS.next thisL) st1 lzNZ_thisL)
      (fun st1 => rs_clsT6 p hp hcp sup hsp (GoalS.next thisL) st1 lzNZ_thisL)
  | Nomm.n2 p q Option.none, ⟨hp, hq⟩, ⟨_, hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, _ =>
    rs_n2iT hc h7 hcode env hR p q sup goal st hcp
      (fun st1 => rs_clsT6 q hq hcq sup hsq (GoalS.next thisL) st1 lzNZ_thisL)
      (fun st1 => rs_clsT6 p hp hcp sup hsp (GoalS.next thisL) st1 lzNZ_thisL)
  | Nomm.n2 p q (some (b, k)), ⟨hp, hq⟩, hcc, sup, ⟨hsc, hsp, hsq⟩, goal, st, _ =>
    rs_n2dT hc h7 hcode env hR hcn p q b k sup goal st hcc hsc
      (fun l st1 hl => rs_clsT6 q hq hcc.2.2 sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsT6 p hp hcc.2.1 sup hsp (GoalS.next l) st1 hl)
  | Nomm.n6 p q r, ⟨hp, hq, hr, hq0, hr0, hun, hdeep⟩, ⟨hcp, hcq, hcr⟩, sup, ⟨hsp, hsq, hsr⟩, goal, st, hg => by
    cases goal with
    | next laz =>
      exact rs_n6NT hc h7 hcode env hR hcn p q r sup laz hg st hcp hq0 hr0 hun (hdeep laz hg)
        (fun g st1 hg1 => rs_clsT6 r hr hcr sup hsr g st1 hg1)
        (fun g st1 hg1 => rs_clsT6 q hq hcq sup hsq g st1 hg1)
        (fun g st1 hg1 => rs_clsT6 p hp hcp sup hsp g st1 hg1)
    | done =>
      exact rs_n6DPT hc h7 hcode env hR p q r sup GoalS.done (Or.inl rfl) st hcp
        (fun st1 => rs_clsT6 r hr hcr sup hsr GoalS.done st1 trivial)
        (fun st1 => rs_clsT6 q hq hcq sup hsq GoalS.done st1 trivial)
        (fun st1 => rs_clsT6 p hp hcp sup hsp GoalS.pick st1 trivial)
    | pick =>
      exact rs_n6DPT hc h7 hcode env hR p q r sup GoalS.pick (Or.inr rfl) st hcp
        (fun st1 => rs_clsT6 r hr hcr sup hsr GoalS.pick st1 trivial)
        (fun st1 => rs_clsT6 q hq hcq sup hsq GoalS.pick st1 trivial)
        (fun st1 => rs_clsT6 p hp hcp sup hsp GoalS.pick st1 trivial)

/-- **For track I, threading the rest**: the sweeps' call `(~(run-shape comp gen) nomm [%done ~] ~)` on
every nomm of `RsClsE6 env` whose direct calls are in the code table and read the door as
`ShapeCallT` says at the rests of `E`, from every state and every rest `y` of `E`, is
`runShape env none nomm GoalS.done`, with the rest `y'` of `E` that the run returns, `Rl y y'`. -/
theorem rs_doneT6 (n : Nomm) (hn : RsClsE6 env n) (hcc : CallCode cod (shapeCE env) n)
    (hs : ShapeOKT ctx env E Rl Option.none n) (st : RSt CSet) (y : RsRest) (hy : E y) :
    ∃ y', Rl y y' ∧ E y' ∧
      nock (rsCoreG n.toNoun (GoalS.done : GoalS CSet).toNoun (A 0) (rsDoor st y ctx)) rsGate
        = (runShape env Option.none n GoalS.done st).map fun p => C p.1.toNoun (rsGenNoun p.2 y') :=
  rs_clsT6 hc h7 hcode env hcn E Rl hR n hn hcc Option.none hs GoalS.done st trivial y hy

end

