/-- **The model of `%6` under a goal whose `+leap` is `~` and whose need
with the bunt sure is `+none-equivalent`**: phase S (`sixNextSimpleC`), the
forks and bonds dropped by `forkSure laz.sure`. -/
theorem runLC_n6_neRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true) :
    (runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let o0 ← oo
          let o1 ← oo
          let (s0, s1) ← forkSure laz.sure th.there o0 o1
          let rid ← idM
          sixNfKRNG env msup p q r region s0 s1 o0 o1 rid) := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region = _
  rw [sixNextLC.eq_2]
  simp only [hlp, hne, Bool.not_true, Bool.false_eq_true, if_false]
  rfl

/-- The model on such a goal is the one on `[%next [sure ~ ~] then]`. -/
theorem runLC_n6_ne_eqRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true) :
    (runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next (Lazy.mk laz.sure [] []) th) region := by
  rw [runLC_n6_neRNG env msup p q r laz th region hlp hne, runLC_n6_nfRNG]

/-- **What `%6` returns in phase S on such a goal**: `GRes` (by `res_n6_nfRNG`
on the goal with its sure need only). -/
theorem res_n6_neRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env false msup) p region) (ihq : ∀ rid, ResForR (runLCMR env false msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env false msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true)
    (h : runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_ne_eqRNG env msup p q r laz th region hlp hne] at h
  obtain ⟨l, b, gi, fr⟩ := res_n6_nfRNG ihp ihq ihr laz.sure th g g' nex (ginv_sureOnly hi) h
  refine ⟨l, b, gi, fun y hy => ?_⟩
  rcases fr y hy with e | e
  · exact Or.inl e
  · obtain ⟨s, fk, bd⟩ := laz
    simp only [gregs, lregs, fregs, bregs, List.append_nil] at e ⊢
    exact Or.inr (List.mem_append_left _ e)

/-- **What `%6` returns under a `%next` goal whose `+leap` is `~`.** -/
theorem res_n6_nlRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env false msup) p region) (ihq : ∀ rid, ResForR (runLCMR env false msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env false msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (h : runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  cases hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) with
  | true => exact res_n6_neRNG ihp ihq ihr laz th g g' nex hi hlp hne h
  | false =>
    cases hkt : kerfTest q r laz with
    | true => exact res_n6_kRNG ihp ihq ihr laz th g g' nex hi hlp hne hkt h
    | false => exact res_n6_fRNG ihp ihq ihr laz th g g' nex hi hlp hne hkt h

/-- The model of `%6` when `+leap` crashes. -/
theorem runLC_n6_crashRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = Option.none) (g : Gen (TreapMap mugF)) :
    (runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g : Option (NextL CSet × Gen (TreapMap mugF)))
      = Option.none := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region g = _
  rw [sixNextLC.eq_2]
  simp only [hlp]

/-- **What `%6` returns under every `%next` goal with `GInv`.** -/
theorem res_n6_nextRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env false msup) p region) (ihq : ∀ rid, ResForR (runLCMR env false msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env false msup) r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th))
    (h : runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  cases hlp : leap laz q r with
  | none => rw [runLC_n6_crashRNG env msup p q r laz th region hlp g] at h; cases h
  | some l =>
    cases l with
    | none => exact res_n6_nlRNG ihp ihq ihr laz th g g' nex hi hlp h
    | some v =>
      obtain ⟨rest, bys⟩ := v
      have hi' := ginv_rest hi (leapInv hi.1 hq hr) hlp
      have h2 := leapTwice_noAx0 (laz := laz) hq hr rest bys hlp
      exact res_n6_l_twRNG laz th g g' nex rest bys hlp hi hq hr
        (fun nex' g'' e => res_n6_nlRNG ihp ihq ihr rest th g g'' nex' hi' h2 e) h

/-- **What `%6` returns on every goal with `GInv`.** -/
theorem res_n6_allRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env false msup) p region) (ihq0 : ResForR (runLCMR env false msup) q region) (ihr0 : ResForR (runLCMR env false msup) r region)
    (ihq : ∀ rid, ResForR (runLCMR env false msup) q (rid :: region)) (ihr : ∀ rid, ResForR (runLCMR env false msup) r (rid :: region))
    (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r) : ResForR (runLCMR env false msup) (Nomm.n6 p q r) region := by
  intro goal g g' nex hi h
  cases goal with
  | next laz th => exact res_n6_nextRNG ihp ihq ihr hq hr laz th g g' nex hi h
  | done => exact res_n6_dpRNG ihp ihq0 ihr0 _ (fun _ _ h => by cases h) g g' nex hi h
  | pick z o => exact res_n6_dpRNG ihp ihq0 ihr0 _ (fun _ _ h => by cases h) g g' nex hi h

