/-- **The case `[3 p]`** from the run of `p` on the goal and on `[%next this]`. -/
theorem rs_n3E (hc : CompIn ctx) (env : ShapeEnv) (p : Nomm) (sup : Option Nomm) (goal : GoalS CSet)
    (st : RSt CSet) (hp1 : RsAtE ctx env E p sup goal st) (hp2 : RsAtE ctx env E p sup (GoalS.next thisL) st) :
    RsAtE ctx env E (Nomm.n3 p) sup goal st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n3]
  have h1 := hp1 y hy
  have h2 := hp2 y hy
  simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun] at h1 h2
  nock_open rsK3
  cases goal with
  | pick =>
    simp only [GoalS.toNoun] at h1
    simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun]
    exact h2
  | done =>
    simp only [GoalS.toNoun] at h1
    simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun]
    exact h2
  | next l =>
    have hl := lne_all hc (rsGenNoun st y) l
    cases e : noneEq l
    · rw [e] at hl
      simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, lne_at', lneArm, hl, e, loob]
      exact h2
    · rw [e] at hl
      simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, lne_at', lneArm, hl, e, loob]
      exact h1

/-- **The case `[4 p]`**: `p` under `[%next this]`. -/
theorem rs_n4E (env : ShapeEnv) (p : Nomm) (sup : Option Nomm) (goal : GoalS CSet) (st : RSt CSet)
    (hp : RsAtE ctx env E p sup (GoalS.next thisL) st) :
    RsAtE ctx env E (Nomm.n4 p) sup goal st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n4]
  have hp' := hp y hy
  simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun] at hp'
  nock_open rsK4
  simp [nock_exec, rsS, rsCoreG, rsDoor, runShape]
  exact hp'

/-- **The case `[7 p q]`** from the run of `q` and the run of `p` on the `laze` that `q`
returns. -/
theorem rs_n7E (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (goal : GoalS CSet) (st : RSt CSet)
    (hq : RsAtE ctx env E q (some p) goal st)
    (hp : ∀ l st1, runShape env (some p) q goal st = some (l, st1) → RsAtE ctx env E p sup (GoalS.next l) st1) :
    RsAtE ctx env E (Nomm.n7 p q) sup goal st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n7]
  have hq' := hq y hy
  simp only [rsCoreG, supNoun, unitNoun, rsDoor] at hq'
  nock_open rsK7
  cases e : runShape env (some p) q goal st with
  | none =>
    rw [e] at hq'
    simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e, bind, StateT.bind]
  | some r =>
    obtain ⟨l, st1⟩ := r
    rw [e] at hq'
    have hp' := hp l st1 e y hy
    simp only [rsCoreG, rsDoor, GoalS.toNoun] at hp'
    simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e, bind, StateT.bind]
    exact hp'

