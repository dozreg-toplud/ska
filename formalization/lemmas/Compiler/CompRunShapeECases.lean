/-- **The case `[5 p q]`**: the run of `q` under `[%next this]`, `+laze-past` of its `laze` over
`p`, the run of `p` under `[%next this]`, `+laze-copy` of the two. -/
theorem rs_n5E (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (goal : GoalS CSet) (st : RSt CSet)
    (hcp : CallCode cod (shapeCE env) p)
    (hq : ∀ st1, RsAtE ctx env E q sup (GoalS.next thisL) st1)
    (hp : ∀ st1, RsAtE ctx env E p sup (GoalS.next thisL) st1) :
    RsAtE ctx env E (Nomm.n5 p q) sup goal st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n5]
  have hq' := hq st y hy
  simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun] at hq'
  unfold rsK5
  cases e1 : runShape env sup q (GoalS.next thisL) st with
  | none =>
    rw [e1] at hq'
    simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind]
  | some r1 =>
    obtain ⟨lq, st1⟩ := r1
    rw [e1] at hq'
    have hpa := lzp_gate h7 hcode env p hcp st1 y lq
    simp only [rsDoor] at hpa
    cases e2 : lazePast env lq p st1 with
    | none =>
      rw [e2] at hpa
      simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2]
    | some r2 =>
      obtain ⟨lq', st2⟩ := r2
      rw [e2] at hpa
      have hp' := hp st2 y hy
      simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun] at hp'
      cases e3 : runShape env sup p (GoalS.next thisL) st2 with
      | none =>
        rw [e3] at hp'
        simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2,
          hp', e3]
      | some r3 =>
        obtain ⟨lp, st3⟩ := r3
        rw [e3] at hp'
        have hlc := lc_all hc h7 (rsGenNoun st3 y) lp lq'
        cases e4 : lazeCopy lp lq' with
        | none =>
          rw [e4] at hlc
          simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2,
            hp', e3, lc_at', lc_arm, hlc, e4, shLiftS]
        | some l =>
          rw [e4] at hlc
          simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2,
            hp', e3, lc_at', lc_arm, hlc, e4, shLiftS]

/-- **The cons case under `[%next laz]`**: `+laze-split` of `laz`, `+laze-past` of the head
over `q`, the run of `q` on the tail, `+laze-past` of its `laze` over `p`, the run of `p` on
the head, `+laze-copy` of the two (`consNext`). -/
theorem rs_consNE (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (laz : Laze CSet) (hl : LzNZ laz)
    (st : RSt CSet) (hcp : CallCode cod (shapeCE env) p) (hcq : CallCode cod (shapeCE env) q)
    (hq : ∀ l st1, LzNZ l → RsAtE ctx env E q sup (GoalS.next l) st1)
    (hp : ∀ l st1, LzNZ l → RsAtE ctx env E p sup (GoalS.next l) st1) :
    RsAtE ctx env E (Nomm.cons p q) sup (GoalS.next laz) st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_c]
  obtain ⟨hed, tel, es⟩ := lazeSplit_ex laz hl
  obtain ⟨hnz, tnz⟩ := lazeSplit_nz laz hl hed tel es
  have hsp := lsp_all hc (rsGenNoun st y) laz hl
  rw [es] at hsp
  simp only [Option.map_some] at hsp
  have hpa1 := lzp_gate h7 hcode env q hcq st y hed
  simp only [rsDoor] at hpa1
  unfold rsKc
  cases e2 : lazePast env hed q st with
  | none =>
    rw [e2] at hpa1
    simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, consNext, GoalS.toNoun, rsSimpleN, simpleS, es, shLiftS,
      bind, StateT.bind, lsp_at', lsp_arm, hsp, lzp_at', lzpArm, hpa1, e2]
  | some r2 =>
    obtain ⟨hed', st1⟩ := r2
    rw [e2] at hpa1
    have hq' := hq tel st1 tnz y hy
    simp only [rsCoreG, rsDoor, GoalS.toNoun] at hq'
    cases e3 : runShape env sup q (GoalS.next tel) st1 with
    | none =>
      rw [e3] at hq'
      simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, consNext, GoalS.toNoun, rsSimpleN, simpleS, es, shLiftS,
        bind, StateT.bind, lsp_at', lsp_arm, hsp, lzp_at', lzpArm, hpa1, e2, hq', e3]
    | some r3 =>
      obtain ⟨l2, st2⟩ := r3
      rw [e3] at hq'
      have hpa2 := lzp_gate h7 hcode env p hcp st2 y l2
      simp only [rsDoor] at hpa2
      cases e4 : lazePast env l2 p st2 with
      | none =>
        rw [e4] at hpa2
        simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, consNext, GoalS.toNoun, rsSimpleN, simpleS, es, shLiftS,
          bind, StateT.bind, lsp_at', lsp_arm, hsp, lzp_at', lzpArm, hpa1, e2, hq', e3, hpa2, e4]
      | some r4 =>
        obtain ⟨l2', st3⟩ := r4
        rw [e4] at hpa2
        have hp' := hp hed' st3 (lazePast_nz env hed q st hed' st1 hnz e2) y hy
        simp only [rsCoreG, rsDoor, GoalS.toNoun] at hp'
        cases e5 : runShape env sup p (GoalS.next hed') st3 with
        | none =>
          rw [e5] at hp'
          simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, consNext, GoalS.toNoun, rsSimpleN, simpleS, es, shLiftS,
            bind, StateT.bind, lsp_at', lsp_arm, hsp, lzp_at', lzpArm, hpa1, e2, hq', e3, hpa2, e4, hp', e5]
        | some r5 =>
          obtain ⟨l1, st4⟩ := r5
          rw [e5] at hp'
          have hlc := lc_all hc h7 (rsGenNoun st4 y) l1 l2'
          cases e6 : lazeCopy l1 l2' with
          | none =>
            rw [e6] at hlc
            simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, consNext, GoalS.toNoun, rsSimpleN, simpleS, es,
              shLiftS, bind, StateT.bind, lsp_at', lsp_arm, hsp, lzp_at', lzpArm, hpa1, e2, hq', e3, hpa2, e4, hp',
              e5, lc_at', lc_arm, hlc, e6]
          | some l =>
            rw [e6] at hlc
            simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, consNext, GoalS.toNoun, rsSimpleN, simpleS, es,
              shLiftS, bind, StateT.bind, lsp_at', lsp_arm, hsp, lzp_at', lzpArm, hpa1, e2, hq', e3, hpa2, e4, hp',
              e5, lc_at', lc_arm, hlc, e6]

/-- **The cons case under `%pick`**: the run of `q` under `[%next none]`, `+laze-past` over `p`,
the run of `p` under `[%next none]`, `+laze-copy`. -/
theorem rs_consPE (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (st : RSt CSet)
    (hcp : CallCode cod (shapeCE env) p)
    (hq : ∀ st1, RsAtE ctx env E q sup (GoalS.next noneL) st1)
    (hp : ∀ st1, RsAtE ctx env E p sup (GoalS.next noneL) st1) :
    RsAtE ctx env E (Nomm.cons p q) sup GoalS.pick st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_c]
  have hq' := hq st y hy
  simp only [rsCoreG, rsDoor, GoalS.toNoun, noneL_noun] at hq'
  unfold rsKc
  cases e1 : runShape env sup q (GoalS.next noneL) st with
  | none =>
    rw [e1] at hq'
    simp [nock_exec, rsS, rsCoreG, rsDoor, GoalS.toNoun, hq', runShape, e1, bind, StateT.bind]
  | some r1 =>
    obtain ⟨lq, st1⟩ := r1
    rw [e1] at hq'
    have hpa := lzp_gate h7 hcode env p hcp st1 y lq
    simp only [rsDoor] at hpa
    cases e2 : lazePast env lq p st1 with
    | none =>
      rw [e2] at hpa
      simp [nock_exec, rsS, rsCoreG, rsDoor, GoalS.toNoun, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm,
        hpa, e2]
    | some r2 =>
      obtain ⟨lq', st2⟩ := r2
      rw [e2] at hpa
      have hp' := hp st2 y hy
      simp only [rsCoreG, rsDoor, GoalS.toNoun, noneL_noun] at hp'
      cases e3 : runShape env sup p (GoalS.next noneL) st2 with
      | none =>
        rw [e3] at hp'
        simp [nock_exec, rsS, rsCoreG, rsDoor, GoalS.toNoun, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm,
          hpa, e2, hp', e3]
      | some r3 =>
        obtain ⟨lp, st3⟩ := r3
        rw [e3] at hp'
        have hlc := lc_all hc h7 (rsGenNoun st3 y) lp lq'
        cases e4 : lazeCopy lp lq' with
        | none =>
          rw [e4] at hlc
          simp [nock_exec, rsS, rsCoreG, rsDoor, GoalS.toNoun, hq', runShape, e1, bind, StateT.bind, lzp_at',
            lzpArm, hpa, e2, hp', e3, lc_at', lc_arm, hlc, e4, shLiftS]
        | some l =>
          rw [e4] at hlc
          simp [nock_exec, rsS, rsCoreG, rsDoor, GoalS.toNoun, hq', runShape, e1, bind, StateT.bind, lzp_at',
            lzpArm, hpa, e2, hp', e3, lc_at', lc_arm, hlc, e4, shLiftS]

/-- **The cons case under `%done`**: the gate runs again under `[%next this]`. -/
theorem rs_consDE (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (st : RSt CSet)
    (hn : RsAtE ctx env E (Nomm.cons p q) sup (GoalS.next thisL) st) :
    RsAtE ctx env E (Nomm.cons p q) sup GoalS.done st := by
  intro y hy
  have hn' := hn y hy
  simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun, Nomm.toNoun] at hn'
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_c]
  unfold rsKc
  simp [nock_exec, rsS, rsCoreG, rsDoor, GoalS.toNoun, hn']
  rfl

/-- **The cons case** on every goal of `GoalNZ`. -/
theorem rs_consE (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (goal : GoalS CSet) (hg : GoalNZ goal)
    (st : RSt CSet) (hcp : CallCode cod (shapeCE env) p) (hcq : CallCode cod (shapeCE env) q)
    (hq : ∀ l st1, LzNZ l → RsAtE ctx env E q sup (GoalS.next l) st1)
    (hp : ∀ l st1, LzNZ l → RsAtE ctx env E p sup (GoalS.next l) st1) :
    RsAtE ctx env E (Nomm.cons p q) sup goal st := by
  cases goal with
  | next laz => exact rs_consNE hc h7 hcode env p q sup laz hg st hcp hcq hq hp
  | pick =>
    exact rs_consPE hc h7 hcode env p q sup st hcp (fun st1 => hq _ st1 lzNZ_noneL) (fun st1 => hp _ st1 lzNZ_noneL)
  | done =>
    exact rs_consDE hc h7 hcode env p q sup st (rs_consNE hc h7 hcode env p q sup thisL lzNZ_thisL st hcp hcq hq hp)

/-- **The case `[10 [a v] q]`** on every goal of `GoalNZ`. -/
theorem rs_n10E (env : ShapeEnv) (a : Nat) (v q : Nomm) (sup : Option Nomm) (goal : GoalS CSet)
    (hg : GoalNZ goal) (st : RSt CSet) (hcv : CallCode cod (shapeCE env) v) (hcq : CallCode cod (shapeCE env) q)
    (hq : ∀ l st1, LzNZ l → RsAtE ctx env E q sup (GoalS.next l) st1)
    (hv : ∀ l st1, LzNZ l → RsAtE ctx env E v sup (GoalS.next l) st1) :
    RsAtE ctx env E (Nomm.n10 a v q) sup goal st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n10]
  have hsi := lzi_all hc h7 (rsGenNoun st y) a (simpleS goal) (simpleS_nz goal hg)
  unfold rsK10
  cases e1 : lazeInto a (simpleS goal) with
  | none =>
    rw [e1] at hsi
    simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
      lzi_at', lzi_arm, hsi, e1]
  | some dr =>
    obtain ⟨don, rec⟩ := dr
    rw [e1] at hsi
    simp only [Option.map_some] at hsi
    obtain ⟨dnz, rnz⟩ := lazeInto_nz a (simpleS goal) (simpleS_nz goal hg) don rec e1
    have hpa1 := lzp_gate h7 hcode env v hcv st y rec
    simp only [rsDoor] at hpa1
    cases e2 : lazePast env rec v st with
    | none =>
      rw [e2] at hpa1
      simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
        lzi_at', lzi_arm, hsi, e1, lzp_at', lzpArm, hpa1, e2]
    | some r2 =>
      obtain ⟨rec', st1⟩ := r2
      rw [e2] at hpa1
      have hv' := hv don st1 dnz y hy
      simp only [rsCoreG, rsDoor, GoalS.toNoun] at hv'
      cases e3 : runShape env sup v (GoalS.next don) st1 with
      | none =>
        rw [e3] at hv'
        simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
          lzi_at', lzi_arm, hsi, e1, lzp_at', lzpArm, hpa1, e2, hv', e3]
      | some r3 =>
        obtain ⟨ld, st2⟩ := r3
        rw [e3] at hv'
        have hpa2 := lzp_gate h7 hcode env q hcq st2 y ld
        simp only [rsDoor] at hpa2
        cases e4 : lazePast env ld q st2 with
        | none =>
          rw [e4] at hpa2
          simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
            lzi_at', lzi_arm, hsi, e1, lzp_at', lzpArm, hpa1, e2, hv', e3, hpa2, e4]
        | some r4 =>
          obtain ⟨ld', st3⟩ := r4
          rw [e4] at hpa2
          have hq' := hq rec' st3 (lazePast_nz env rec v st rec' st1 rnz e2) y hy
          simp only [rsCoreG, rsDoor, GoalS.toNoun] at hq'
          cases e5 : runShape env sup q (GoalS.next rec') st3 with
          | none =>
            rw [e5] at hq'
            simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
              lzi_at', lzi_arm, hsi, e1, lzp_at', lzpArm, hpa1, e2, hv', e3, hpa2, e4, hq', e5]
          | some r5 =>
            obtain ⟨lr, st4⟩ := r5
            rw [e5] at hq'
            have hlc := lc_all hc h7 (rsGenNoun st4 y) lr ld'
            cases e6 : lazeCopy lr ld' with
            | none =>
              rw [e6] at hlc
              simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
                lzi_at', lzi_arm, hsi, e1, lzp_at', lzpArm, hpa1, e2, hv', e3, hpa2, e4, hq', e5, lc_at', lc_arm,
                hlc, e6]
            | some l =>
              rw [e6] at hlc
              simp [nock_exec, rsS, rsCoreG, rsDoor, runShape, GoalS.toNoun, rsSimpleN, shLiftS, bind, StateT.bind,
                lzi_at', lzi_arm, hsi, e1, lzp_at', lzpArm, hpa1, e2, hv', e3, hpa2, e4, hq', e5, lc_at', lc_arm,
                hlc, e6]

/-- **The indirect case `[2 p q ~]`**: the run of `q` under `[%next this]`, `+laze-past` of its
`laze` over `p`, the run of `p` under `[%next this]`, `+laze-copy` of the two. -/
theorem rs_n2iE (env : ShapeEnv) (p q : Nomm) (sup : Option Nomm) (goal : GoalS CSet) (st : RSt CSet)
    (hcp : CallCode cod (shapeCE env) p)
    (hq : ∀ st1, RsAtE ctx env E q sup (GoalS.next thisL) st1)
    (hp : ∀ st1, RsAtE ctx env E p sup (GoalS.next thisL) st1) :
    RsAtE ctx env E (Nomm.n2 p q Option.none) sup goal st := by
  intro y hy
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n2]
  simp only [unitNoun]
  have hq' := hq st y hy
  simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun] at hq'
  rw [rsK2_eq]
  unfold rsdArm rsdI
  cases e1 : runShape env sup q (GoalS.next thisL) st with
  | none =>
    rw [e1] at hq'
    simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind]
  | some r1 =>
    obtain ⟨lq, st1⟩ := r1
    rw [e1] at hq'
    have hpa := lzp_gate h7 hcode env p hcp st1 y lq
    simp only [rsDoor] at hpa
    cases e2 : lazePast env lq p st1 with
    | none =>
      rw [e2] at hpa
      simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2]
    | some r2 =>
      obtain ⟨lq', st2⟩ := r2
      rw [e2] at hpa
      have hp' := hp st2 y hy
      simp only [rsCoreG, rsDoor, GoalS.toNoun, thisL_noun] at hp'
      cases e3 : runShape env sup p (GoalS.next thisL) st2 with
      | none =>
        rw [e3] at hp'
        simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2,
          hp', e3]
      | some r3 =>
        obtain ⟨lp, st3⟩ := r3
        rw [e3] at hp'
        have hlc := lc_all hc h7 (rsGenNoun st3 y) lp lq'
        cases e4 : lazeCopy lp lq' with
        | none =>
          rw [e4] at hlc
          simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2,
            hp', e3, lc_at', lc_arm, hlc, e4, shLiftS]
        | some l =>
          rw [e4] at hlc
          simp [nock_exec, rsS, rsCoreG, rsDoor, hq', runShape, e1, bind, StateT.bind, lzp_at', lzpArm, hpa, e2,
            hp', e3, lc_at', lc_arm, hlc, e4, shLiftS]

/-- **The case `[6 p q r]` under `%done` and `%pick`**: the runs of `r` and `q` on the goal,
`+laze-sect`, `+laze-past-fork` over `p`, `this` if `+laze-big`, the run of `p` under `%pick`,
`+laze-copy` (`sixBranch`). -/
theorem rs_n6DPE (env : ShapeEnv) (p q r : Nomm) (sup : Option Nomm) (goal : GoalS CSet)
    (hnn : goal = GoalS.done ∨ goal = GoalS.pick) (st : RSt CSet) (hcp : CallCode cod (shapeCE env) p)
    (hr : ∀ st1, RsAtE ctx env E r sup goal st1)
    (hq : ∀ st1, RsAtE ctx env E q sup goal st1)
    (hp : ∀ st1, RsAtE ctx env E p sup GoalS.pick st1) :
    RsAtE ctx env E (Nomm.n6 p q r) sup goal st := by
  intro y hy
  obtain ⟨tag, htag, hne⟩ := rs6_goal goal hnn
  have hne' : ¬ (0x7478656e = tag) := fun h => hne h.symm
  rw [rs6_model env sup p q r goal hnn]
  simp only [Nomm.toNoun]
  rw [rs_push, rs_disp_n6, rsK6_eq, htag]
  unfold rs6Arm
  have hr' := hr st y hy
  simp only [rsCoreG, rsDoor, htag] at hr'
  cases e1 : runShape env sup r goal st with
  | none => rw [e1] at hr'; six_simp [hr', e1]
  | some r1 =>
    obtain ⟨l1, st1⟩ := r1
    rw [e1] at hr'
    have hq' := hq st1 y hy
    simp only [rsCoreG, rsDoor, htag] at hq'
    cases e2 : runShape env sup q goal st1 with
    | none => rw [e2] at hq'; six_simp [hr', e1, hq', e2]
    | some r2 =>
      obtain ⟨l0, st2⟩ := r2
      rw [e2] at hq'
      have hs := lzs_gate (ctx := ctx) st2 y l0 l1
      simp only [rsDoor] at hs
      cases e3 : lazeSect l0 l1 st2 with
      | none => rw [e3] at hs; six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3]
      | some r3 =>
        obtain ⟨lz, st3⟩ := r3
        rw [e3] at hs
        have hpf := lpf_gate hc h7 hcode env p hcp (rsGenNoun st3 y) lz
        cases e4 : lazePastFork env lz p with
        | none =>
          rw [e4] at hpf
          six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3, lpf_at', lpf_arm, hpf, e4]
        | some lz' =>
          rw [e4] at hpf
          have hbg := lbg_gate hc h7 st3 y lz'
          simp only [rsDoor] at hbg
          have hp' := hp st3 y hy
          simp only [rsCoreG, rsDoor, GoalS.toNoun] at hp'
          cases e5 : runShape env sup p GoalS.pick st3 with
          | none =>
            rw [e5] at hp'
            by_cases hb : lazeBig (sofsHas st3.sofs) lz' = true <;>
            · six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3, lpf_at', lpf_arm, hpf, e4,
                lbg_at', lbg_arm, hbg, hb, loob, hp', e5]
          | some r5 =>
            obtain ⟨lc, st4⟩ := r5
            rw [e5] at hp'
            by_cases hb : lazeBig (sofsHas st3.sofs) lz' = true
            · have hlc := lc_all hc h7 (rsGenNoun st4 y) lc thisL
              rw [thisL_noun] at hlc
              cases e6 : lazeCopy lc thisL with
              | none =>
                rw [e6] at hlc
                six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3, lpf_at', lpf_arm, hpf, e4,
                  lbg_at', lbg_arm, hbg, hb, loob, hp', e5, lc_at', lc_arm, hlc, e6]
              | some l =>
                rw [e6] at hlc
                six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3, lpf_at', lpf_arm, hpf, e4,
                  lbg_at', lbg_arm, hbg, hb, loob, hp', e5, lc_at', lc_arm, hlc, e6]
            · simp only [Bool.not_eq_true] at hb
              have hlc := lc_all hc h7 (rsGenNoun st4 y) lc lz'
              cases e6 : lazeCopy lc lz' with
              | none =>
                rw [e6] at hlc
                six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3, lpf_at', lpf_arm, hpf, e4,
                  lbg_at', lbg_arm, hbg, hb, loob, hp', e5, lc_at', lc_arm, hlc, e6]
              | some l =>
                rw [e6] at hlc
                six_simp [hr', e1, hq', e2, lzs_at', lzs_arm, hs, e3, lpf_at', lpf_arm, hpf, e4,
                  lbg_at', lbg_arm, hbg, hb, loob, hp', e5, lc_at', lc_arm, hlc, e6]

end

