/-- The model of `%6` when `+leap` crashes. -/
theorem runLC_n6_crashR (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = Option.none) (g : Gen (TreapMap mugF)) :
    (runLCM env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g : Option (NextL CSet × Gen (TreapMap mugF)))
      = Option.none := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region g = _
  rw [sixNextLC.eq_2]
  simp only [hlp]

/-- **The case `%6` of `+run` under every `%next` goal with `GInv`**, given
the parts (`SixParts`) and `Bake.NoAx0` of the branches: `+leap` crashes
(so do the Hoon and the model), gives `~` (`comp_run_n6_nlR`: phases S, K,
F), or gives a rest (phase L, `comp_run_n6_l_twR`, re-entering
`comp_run_n6_nlR` on the rest, whose `+leap` is `~` by
`leapTwice_noAx0`). -/
theorem comp_run_n6_nextR (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsR env msup ctx X p region) (Q : ∀ rid, SixPartsR env msup ctx X q (rid :: region))
    (R : ∀ rid, SixPartsR env msup ctx X r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th)) :
    CompRunAtX (runLCM env true msup) ctx X (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  cases hlp : leap laz q r with
  | none =>
    intro x mono sup hx hX
    have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
    have hLp := lp6_leap h7 laz q r hl hq hr g x
    rw [hlp, Option.map_none] at hLp
    rw [cr6_head_crash p q r laz th region x g mono sup hLp, runLC_n6_crashR env msup p q r laz th region hlp g]
    rfl
  | some l =>
    cases l with
    | none => exact comp_run_n6_nlR h7 hcode env msup p q r region P Q R hq hr laz th g hinv hlp
    | some v =>
      obtain ⟨rest, bys⟩ := v
      have hi := ginv_rest hinv (leapInv hinv.1 hq hr) hlp
      have h2 := leapTwice_noAx0 (laz := laz) hq hr rest bys hlp
      exact comp_run_n6_l_twR h7 env msup p q r region hq hr laz th g hinv rest bys hlp
        (comp_run_n6_nlR h7 hcode env msup p q r region P Q R hq hr rest th g hi h2)
        (fun nex g' e => res_n6_nlR P.res (fun rid => (Q rid).res) (fun rid => (R rid).res) rest th g g' nex hi h2 e)

/-- **What `%6` returns under every `%next` goal with `GInv`.** -/
theorem res_n6_nextR {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCM env true msup) p region) (ihq : ∀ rid, ResForR (runLCM env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCM env true msup) r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th))
    (h : runLCM env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  cases hlp : leap laz q r with
  | none => rw [runLC_n6_crashR env msup p q r laz th region hlp g] at h; cases h
  | some l =>
    cases l with
    | none => exact res_n6_nlR ihp ihq ihr laz th g g' nex hi hlp h
    | some v =>
      obtain ⟨rest, bys⟩ := v
      have hi' := ginv_rest hi (leapInv hi.1 hq hr) hlp
      have h2 := leapTwice_noAx0 (laz := laz) hq hr rest bys hlp
      exact res_n6_l_twR laz th g g' nex rest bys hlp hi hq hr
        (fun nex' g'' e => res_n6_nlR ihp ihq ihr rest th g g'' nex' hi' h2 e) h

/-- **The case `%6` of `+run` on every goal with `GInv`**: `%done` and
`%pick` by `comp_run_n6_dpR` (the branches in the case's region), `%next` by
`comp_run_n6_nextR` (the branches in the regions `rid :: region`). -/
theorem comp_run_n6_allR (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsR env msup ctx X p region) (Q0 : SixPartsR env msup ctx X q region)
    (R0 : SixPartsR env msup ctx X r region) (Q : ∀ rid, SixPartsR env msup ctx X q (rid :: region))
    (R : ∀ rid, SixPartsR env msup ctx X r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtX (runLCM env true msup) ctx X (Nomm.n6 p q r) goal region g := by
  cases goal with
  | next laz th => exact comp_run_n6_nextR h7 hcode env msup p q r region P Q R hq hr laz th g hinv
  | done => exact comp_run_n6_dpR h7 hcode env msup p q r region P Q0 R0 _ (fun _ _ h => by cases h) g hinv
  | pick z o => exact comp_run_n6_dpR h7 hcode env msup p q r region P Q0 R0 _ (fun _ _ h => by cases h) g hinv

/-- **What `%6` returns on every goal with `GInv`.** -/
theorem res_n6_allR {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCM env true msup) p region) (ihq0 : ResForR (runLCM env true msup) q region) (ihr0 : ResForR (runLCM env true msup) r region)
    (ihq : ∀ rid, ResForR (runLCM env true msup) q (rid :: region)) (ihr : ∀ rid, ResForR (runLCM env true msup) r (rid :: region))
    (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r) : ResForR (runLCM env true msup) (Nomm.n6 p q r) region := by
  intro goal g g' nex hi h
  cases goal with
  | next laz th => exact res_n6_nextR ihp ihq ihr hq hr laz th g g' nex hi h
  | done => exact res_n6_dpR ihp ihq0 ihr0 _ (fun _ _ h => by cases h) g g' nex hi h
  | pick z o => exact res_n6_dpR ihp ihq0 ihr0 _ (fun _ _ h => by cases h) g g' nex hi h

