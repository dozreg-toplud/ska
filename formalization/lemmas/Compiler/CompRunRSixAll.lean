/-- **What `%6` returns in phase S on such a goal**: `GRes` (by `res_n6_nfR`
on the goal with its sure need only). -/
theorem res_n6_neR {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCM env true msup) p region) (ihq : ∀ rid, ResForR (runLCM env true msup) q (rid :: region))
