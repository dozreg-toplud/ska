import lemmas.Compiler.CompSccLoopClose

/-! # `PrintId` for the pill (README Gaps 21.14)

The print of `csfRec` pulls the gate `print-comp` from axis `1022` of `K` (axis `0xfffffe` of
the trap's subject).  Since `comp-verb` is not defined, the gate's battery is `same` (the pull
`[9 97710 [0 511]]`, `print_comp.battery`, as `print_ska.battery` is for `cg_print`), so its
product is the gate `same` (`[[0 6] [0 layer2]]`), which gives back its sample.
**`printId_pill`**: `PrintId p` for every `p`.  `tools/gen/noprint.py` makes the corollaries of the
loop's gate theorems without `PrintId`: `csi_gate_loop_np`, `csi_gate_loop_d_np`,
`csi_gate_ranked_np`, `hcsi_of_loop_np`. -/

namespace Formalization
namespace Compiler

open Nock Pill Hoon SkaModel SkaModel.Comp SkaModel.SccLoop

/-- The gate `print-comp` in `K`. -/
noncomputable def pcGate : Noun := (slot? 1022 compK).getD (A 0)

theorem pc_at : slot? 1022 compK = some pcGate := by kernel_rfl

theorem pc_bat : slot? 2 pcGate = some print_comp.battery := by kernel_rfl

theorem pc_l2 : slot? 511 pcGate = some layer2 := by kernel_rfl

/-- The arm `same` of `layer2` (the same fact as `same_at` of `Compiler/SkaCallgraph.lean`). -/
theorem pc_same : slot? 97710 layer2
    = some (C (A 8) (C (C (A 1) (A 0)) (C (C (A 1) (C (A 0) (A 6))) (C (A 0) (A 1))))) := by kernel_rfl

theorem pc_shape : ∃ GS GC, pcGate = C print_comp.battery (C GS GC) ∧ slot? 127 GC = some layer2 := by
  have hb := pc_bat
  have hl := pc_l2
  generalize pcGate = G at hb hl ⊢
  rcases G with _ | ⟨GB, _ | ⟨GS, GC⟩⟩
  · simp [nock_exec] at hb
  · simp [nock_exec] at hl
  · simp only [nock_exec, Option.some.injEq] at hb hl
    exact ⟨GS, GC, by rw [hb], hl⟩

/-- The print gate of the trap's subject is `K`'s. -/
theorem pc_slot (p : LoopP) (k : Nat) (ST ML CA RES : Noun) :
    slot? 0xfffffe (C RES (p.core (A k) ST ML CA)) = some pcGate := by
  rw [← pc_at]
  simp [LoopP.core, csfCore, LoopP.subj, csiSam, nock_exec]

/-- **`PrintId` holds in the pill**: the print of `csfRec` returns the gate `same`. -/
theorem printId_pill (p : LoopP) : PrintId p := by
  intro k ST ML CA RES
  obtain ⟨GS, GC, hG, h127⟩ := pc_shape
  have hs := pc_slot p k ST ML CA RES
  rw [hG] at hs
  refine ⟨C (A 0) (A 6), A 0, layer2, ?_, fun x => by simp [nock_exec]⟩
  unfold csfRecPrint
  generalize p.core (A k) ST ML CA = CORE at hs
  simp [nock_exec, hs, h127, print_comp.battery, pc_same]

/-! ## The gate theorems without `PrintId` (generated by `tools/gen/noprint.py`) -/

/-- `csi_gate_loop` with `PrintId` discharged (`printId_pill`). -/
theorem csi_gate_loop_np {N : Type} [DecidableEq N] (c : Cfg Noun N) (R : (Noun → Option N) → (Noun → Option N) → Noun → Noun → Prop) (SCC LONG JH CA0 KIDS ORD : Noun) (hlevy : nock (C csiBody (C (csiSam SCC LONG JH CA0) compK)) csiLevy = some (A 1)) (hkidsP : nock (C (A 0) (C csiBody (C (csiSam SCC LONG JH CA0) compK))) csiKids = some KIDS) (hdn : nock (C KIDS (C (A 0) (C csiBody (C (csiSam SCC LONG JH CA0) compK)))) csiDone
      = some (A 1)) (p : LoopP) (hp : p = ⟨A 1, KIDS, SCC, LONG, JH, CA0, A 0, A 0, ORD⟩) (hR0 : ∀ ml sure ML CA, R ml sure ML CA → R (fun _ => none) sure (A 0) CA) (hmay : MemGate c R p.ctx (fun _ => c.none) (A 0) Mode.may (A 0x79616d)) (hdone : MemGate c R p.ctx (fun _ => c.none) (A 0) Mode.done (A 0x656e6f64)) (st0 : St Noun N) (hmust : ∀ MAY CA1, R (maySweep c st0).ml (maySweep c st0).sure MAY CA1 →
      ∃ TOP, nock (C MAY (C ORD (p.subj (A 0) CA1))) csfTop = some TOP ∧
        MemGate c R p.ctx (topOf c (maySweep c st0)) TOP Mode.must (A 0x7473756d)) (hkids : KidsN c KIDS) (hscc : SccN c SCC) (hord : ORD = listN c.order) (hsub : ∀ b ∈ c.order, b ∈ c.scc) (hdfs : nock (p.subj (A 0) CA0) csfOrder = some ORD) (hR : R st0.ml st0.sure (A 0) CA0) (fuel : Nat) (s : St Noun N) (hs : compileSccIn c false fuel st0 = some s) :
    ∃ M CA', R s.ml s.sure M CA' ∧ ∀ NARY REST NARYU, CA' = C NARY REST →
      nock (C by.uni.battery (C M (C by.battery (C NARY layer2)))) by.uni.battery = some NARYU →
      nock (C csiBody (C (csiSam SCC LONG JH CA0) compK)) csiBody = some (C M (C NARYU REST)) :=
  csi_gate_loop c R SCC LONG JH CA0 KIDS ORD hlevy hkidsP hdn p hp hR0 hmay hdone st0 hmust hkids hscc hord hsub hdfs (fun _ _ => printId_pill _) hR fuel s hs

/-- `csi_gate_loop_d` with `PrintId` discharged (`printId_pill`). -/
theorem csi_gate_loop_d_np (c : Cfg Noun NeedOrd) (bs : List Noun) (outC : Noun → List Noun) (nout : Noun → NeedOrd) (Q : Noun → Prop) (SCC CODE JETS CALLS JH NARY CR : Noun) (hsam : SamOK SCC CALLS NARY) (hmiss : ∃ b ∈ tapList SCC, getF mugF b NARY = some (A 0)) (hnd : (∀ n, SCC ≠ C n (C (A 0) (A 0))) ∨ ∃ n, SCC = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n) (hcfg : CfgOf c SCC (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR))) (hmay : MemGate c (LoopR bs outC nout Q) (csiCtx (A 1) (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR))
      SCC (C CODE (C JETS CALLS)) JH (C NARY CR)) (fun _ => c.none) (A 0) Mode.may (A 0x79616d)) (hdone : MemGate c (LoopR bs outC nout Q) (csiCtx (A 1) (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR))
      SCC (C CODE (C JETS CALLS)) JH (C NARY CR)) (fun _ => c.none) (A 0) Mode.done (A 0x656e6f64)) (st0 : St Noun NeedOrd) (hmust : ∀ TOP, TopN (maySweep c st0).ml TOP → MemGate c (LoopR bs outC nout Q)
      (csiCtx (A 1) (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR)) SCC (C CODE (C JETS CALLS)) JH (C NARY CR))
      (topOf c (maySweep c st0)) TOP Mode.must (A 0x7473756d)) (hQ : ∀ CA, Q CA → ∃ NR REST, CA = C NR REST ∧ IsMap mugF NR) (hml0 : ∀ b, st0.ml b = none) (hsu0 : SureHolds bs st0.sure (C NARY CR)) (hq0 : Q (C NARY CR)) (fuel : Nat) (s : St Noun NeedOrd) (hs : compileSccIn c false fuel st0 = some s) :
    (∀ b ∈ c.scc, (s.ml b).isSome) ∧ (∀ k, k ∉ c.scc → s.ml k = none) ∧
    ∃ M NR REST NARYU, LoopR bs outC nout Q s.ml s.sure M (C NR REST) ∧ IsMap mugF NR ∧
      IsMap mugF NARYU ∧ UniSpec NR M NARYU ∧
      nock (C csiBody (C (csiSam SCC (C CODE (C JETS CALLS)) JH (C NARY CR)) compK)) csiBody
        = some (C M (C NARYU REST)) :=
  csi_gate_loop_d c bs outC nout Q SCC CODE JETS CALLS JH NARY CR hsam hmiss hnd hcfg hmay hdone st0 hmust hQ (fun _ _ => printId_pill _) hml0 hsu0 hq0 fuel s hs

/-- `csi_gate_ranked` with `PrintId` discharged (`printId_pill`). -/
theorem csi_gate_ranked_np (c : Cfg Noun NeedOrd) (r : Ranked c) (bs : List Noun) (outC : Noun → List Noun) (nout : Noun → NeedOrd) (Q : Noun → Prop) (SCC CODE JETS CALLS JH NARY CR : Noun) (hsam : SamOK SCC CALLS NARY) (hmiss : ∃ b ∈ tapList SCC, getF mugF b NARY = some (A 0)) (hnd : (∀ n, SCC ≠ C n (C (A 0) (A 0))) ∨ ∃ n, SCC = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n) (hcfg : CfgOf c SCC (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR))) (hmay : MemGate c (LoopR bs outC nout Q) (csiCtx (A 1) (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR))
      SCC (C CODE (C JETS CALLS)) JH (C NARY CR)) (fun _ => c.none) (A 0) Mode.may (A 0x79616d)) (hdone : MemGate c (LoopR bs outC nout Q) (csiCtx (A 1) (kidsOf SCC (C CODE (C JETS CALLS)) JH (C NARY CR))
      SCC (C CODE (C JETS CALLS)) JH (C NARY CR)) (fun _ => c.none) (A 0) Mode.done (A 0x656e6f64)) (st0 : St Noun NeedOrd) (hmust : ∀ TOP, TopN (maySweep c st0).ml TOP → MemGate c (LoopR bs outC nout Q)
