/-- `hcsi_of_loop` with `PrintId` discharged (`printId_pill`). -/
theorem hcsi_of_loop_np {N : Type} [DecidableEq N] (c : Cfg Noun N) (R : (Noun → Option N) → (Noun → Option N) → Noun → Noun → Prop) (FUNC SCC CODE LSR JH CA0 KIDS ORD : Noun) (hlevy : nock (C csiBody (C (csiSam SCC (C CODE LSR) JH CA0) compK)) csiLevy = some (A 1)) (hkidsP : nock (C (A 0) (C csiBody (C (csiSam SCC (C CODE LSR) JH CA0) compK))) csiKids
      = some KIDS) (hdn : nock (C KIDS (C (A 0) (C csiBody (C (csiSam SCC (C CODE LSR) JH CA0) compK)))) csiDone
      = some (A 1)) (p : LoopP) (hp : p = ⟨A 1, KIDS, SCC, C CODE LSR, JH, CA0, A 0, A 0, ORD⟩) (hR0 : ∀ ml sure ML CA, R ml sure ML CA → R (fun _ => none) sure (A 0) CA) (hmay : MemGate c R p.ctx (fun _ => c.none) (A 0) Mode.may (A 0x79616d)) (hdone : MemGate c R p.ctx (fun _ => c.none) (A 0) Mode.done (A 0x656e6f64)) (st0 : St Noun N) (hmust : ∀ MAY CA1, R (maySweep c st0).ml (maySweep c st0).sure MAY CA1 →
      ∃ TOP, nock (C MAY (C ORD (p.subj (A 0) CA1))) csfTop = some TOP ∧
        MemGate c R p.ctx (topOf c (maySweep c st0)) TOP Mode.must (A 0x7473756d)) (hkids : KidsN c KIDS) (hscc : SccN c SCC) (hord : ORD = listN c.order) (hsub : ∀ b ∈ c.order, b ∈ c.scc) (hdfs : nock (p.subj (A 0) CA0) csfOrder = some ORD) (hR : R st0.ml st0.sure (A 0) CA0) (fuel : Nat) (s : St Noun N) (hs : compileSccIn c false fuel st0 = some s) (hfin : ∀ M CA', R s.ml s.sure M CA' → ∃ NARY REST NARYU, CA' = C NARY REST ∧
      nock (C by.uni.battery (C M (C by.battery (C NARY layer2)))) by.uni.battery = some NARYU) :
    ∃ M NARY REST NARYU, R s.ml s.sure M (C NARY REST) ∧
      nock (cuTC (cuSam FUNC SCC CODE LSR JH CA0)) cuCsi = some (C M (C NARYU REST)) :=
  hcsi_of_loop c R FUNC SCC CODE LSR JH CA0 KIDS ORD hlevy hkidsP hdn p hp hR0 hmay hdone st0 hmust hkids hscc hord hsub hdfs (fun _ _ => printId_pill _) hR fuel s hs hfin

