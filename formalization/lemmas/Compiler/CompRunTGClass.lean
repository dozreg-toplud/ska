/-! ## Hand-written: the call through a ring -/

/-- **What one direct call takes, threaded, ring or not**: `CallOkT` with the callee's ring
`env.ring b` (a ring noun, `RinOk`) in place of "no ring", and the call's nouns `CallNounMTG` at
that ring (no hot driver: `RinAt`). -/
def CallOkTG (env : CallEnv) (cod ctx : Noun) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop)
    (msup : Option Nomm) (p q : Nomm) (b : Bell) : Prop :=
  CodePure cod env b ∧ env.cod b = some (env.pure b) ∧ RinOk (env.ring b) ∧
    ∃ nb, env.need b = some nb ∧ ∀ x, x.NoSoft → E x → ∃ x' sur SOF, Y x x' ∧
      CallNounMTG msup ctx p q b nb sur x x' (A 0) SOF (env.ring b)

/-- The old `CallOkT` (no ring) is `CallOkTG`. -/
theorem callOkTG_of_T {env : CallEnv} {cod : Noun} {E : GenRest → Prop} {Y : GenRest → GenRest → Prop}
    {msup : Option Nomm} {p q : Nomm} {b : Bell} (h : CallOkT env cod ctx E Y msup p q b) :
    CallOkTG env cod ctx E Y msup p q b := by
  obtain ⟨h1, h2, h3, nb, h4, h5⟩ := h
  refine ⟨h1, h2, by rw [h3]; trivial, nb, h4, fun x hx hE => ?_⟩
  obtain ⟨x', sur, SOF, hy, hT, -⟩ := h5 x hx hE
  rw [h3]
  exact ⟨x', sur, SOF, hy, callNounMTG_of_mt hT⟩

/-- **The case `%7` of `+run`, threaded**: `q` with `sup` set to `p` at the
rest `x`, giving `x1`, then `p` at `x1` with the goal `q` returned. -/
theorem comp_run_n7TG {X : GenRest → Noun → Noun → Prop} {Y : GenRest → GenRest → Prop} (hYk : YOk X Y)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (goal : CGoalL CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) {Xq : GenRest → Noun → Noun → Prop}
    (hq : CompRunAtXT (runLCMR env true (some p)) ctx Xq Y q goal region g)
    (hXq : ∀ x mono sup, X x mono sup → Xq x mono (C (A 0) p.toNoun))
    (hp : ∀ nex g1, runLCMR env true (some p) q goal region g = some (nex, g1) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p nex.goal region g1) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n7 p q) goal region g := by
  intro x mono sup hx hX
  obtain ⟨x1, hy1, h1⟩ := hq x mono (C (A 0) p.toNoun) hx (hXq x mono sup hX)
  simp only [crSubj, compCore] at h1
  simp only [Nomm.toNoun]
  rw [cr_disp_n7]
  cases e : runLCMR (S := CSet) (Map := TreapMap mugF) env true (some p) q goal region g with
  | none =>
    rw [e] at h1
    refine ⟨x1, hy1, ?_⟩
    simp only [compCore]
    generalize comp.door = Dr at h1 ⊢
    nock_open crK7
    simp [nock_exec, crSubj, cr_bat_dol, h1, runLCMR, e, bind, StateT.bind]
  | some r =>
    obtain ⟨nex, g1⟩ := r
    rw [e] at h1
    obtain ⟨x2, hy2, h2⟩ := hp nex g1 e x1 mono sup (hYk.soft hx hy1) (hYk.pres hX hy1)
    refine ⟨x2, hYk.trans hy1 hy2, ?_⟩
    simp only [crSubj, compCore] at h2 h1
    simp only [compCore]
    generalize comp.door = Dr at h1 h2 ⊢
    nock_open crK7
    simp [nock_exec, crSubj, cr_bat_dol, h1, h2, runLCMR, e, bind, StateT.bind]

/-- **`CallOkTG` of every direct call**, each at the `msup` its run gets,
the subject and formula of a direct call included (a call there may miss
too: the tail of the call is threaded, `comp_run_n2_directXTTG`). -/
def DirCallsTG (env : CallEnv) (cod ctx : Noun) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) :
    Option Nomm → Nomm → Prop
  | ms, Nomm.cons p q => DirCallsTG env cod ctx E Y ms p ∧ DirCallsTG env cod ctx E Y ms q
  | ms, Nomm.n2 p q Option.none => DirCallsTG env cod ctx E Y ms p ∧ DirCallsTG env cod ctx E Y ms q
  | ms, Nomm.n2 p q (some (b, _)) =>
      CallOkTG env cod ctx E Y ms p q b ∧ DirCallsTG env cod ctx E Y ms p ∧ DirCallsTG env cod ctx E Y ms q
  | ms, Nomm.n3 p => DirCallsTG env cod ctx E Y ms p
  | ms, Nomm.n4 p => DirCallsTG env cod ctx E Y ms p
  | ms, Nomm.n5 p q => DirCallsTG env cod ctx E Y ms p ∧ DirCallsTG env cod ctx E Y ms q
  | ms, Nomm.n6 p q r =>
      DirCallsTG env cod ctx E Y ms p ∧ DirCallsTG env cod ctx E Y ms q ∧ DirCallsTG env cod ctx E Y ms r
  | ms, Nomm.n7 p q => DirCallsTG env cod ctx E Y ms p ∧ DirCallsTG env cod ctx E Y (some p) q
  | ms, Nomm.n10 _ v q => DirCallsTG env cod ctx E Y ms v ∧ DirCallsTG env cod ctx E Y ms q
  | _, _ => True

theorem callCode_of_dirTG {env : CallEnv} {cod : Noun} {E : GenRest → Prop} {Y : GenRest → GenRest → Prop} :
    ∀ (n : Nomm), DirOk n = true → ∀ (ms : Option Nomm), DirCallsTG env cod ctx E Y ms n → CallCode cod env n
  | Nomm.cons p q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTG p h.1 ms hd.1, callCode_of_dirTG q h.2 ms hd.2⟩
  | Nomm.n0 _, _, _, _ => trivial
  | Nomm.n1 _, _, _, _ => trivial
  | Nomm.n2 p q Option.none, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨trivial, callCode_of_dirTG p h.1 ms hd.1, callCode_of_dirTG q h.2 ms hd.2⟩
  | Nomm.n2 p q (some (b, Option.none)), h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨⟨hd.1.1, hd.1.2.1⟩, callCode_of_dirTG p h.1 ms hd.2.1, callCode_of_dirTG q h.2 ms hd.2.2⟩
  | Nomm.n2 _ _ (some (_, some _)), h, _, _ => by simp [DirOk] at h
  | Nomm.n3 p, h, ms, hd => by
    simp only [DirOk] at h; simp only [DirCallsTG] at hd; simp only [CallCode]; exact callCode_of_dirTG p h ms hd
  | Nomm.n4 p, h, ms, hd => by
    simp only [DirOk] at h; simp only [DirCallsTG] at hd; simp only [CallCode]; exact callCode_of_dirTG p h ms hd
  | Nomm.n5 p q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTG p h.1 ms hd.1, callCode_of_dirTG q h.2 ms hd.2⟩
  | Nomm.n7 p q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTG p h.1 ms hd.1, callCode_of_dirTG q h.2 (some p) hd.2⟩
  | Nomm.n10 a v q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTG v h.1.2 ms hd.1, callCode_of_dirTG q h.2 ms hd.2⟩
  | Nomm.n6 p q r, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTG p h.1.1 ms hd.1, callCode_of_dirTG q h.1.2 ms hd.2.1, callCode_of_dirTG r h.2 ms hd.2.2⟩
  | Nomm.n11s _ _ _, h, _, _ => by simp [DirOk] at h
  | Nomm.n11d _ _ _ _, h, _, _ => by simp [DirOk] at h
  | Nomm.n12 _ _, h, _, _ => by simp [DirOk] at h
  | Nomm.mean _ _ _ _ _, h, _, _ => by simp [DirOk] at h

theorem sixRT_ofG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    {env : CallEnv} {msup : Option Nomm} {X : GenRest → Noun → Noun → Prop} {Y : GenRest → GenRest → Prop}
    {n : Nomm} {region : List Nat}
    (N : PartRTR env msup ctx X Y n region) (hcc : CallCode cod env n) : SixPartsRTG env msup ctx X Y n region :=
  ⟨N.link, N.res, pastForkAt_code h7 hcode env hcc⟩

/-- **The threaded run link at `mono` `&` on the class with direct calls**:
every nomm of `DirOk` whose direct calls meet `CallOkTG` is a `PartRTR` at
`XM E msup` (link threading the rest, result, `+past`), for every `Y` that is
a preorder keeping `NoSoft` and `E` (`YOk`). -/
theorem comp_run_dirTG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XM E msup) Y) :
    ∀ (n : Nomm), DirOk n = true → ∀ (msup : Option Nomm) (region : List Nat),
      DirCallsTG env cod ctx E Y msup n → PartRTR env msup ctx (XM E msup) Y n region
  | Nomm.cons p q, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_consLRTG (hY msup) h7 hcode env msup p q P Q goal g hi, res_consRG P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n0 ax, _, msup, region, _ =>
    ⟨fun goal g hi => crxt_of_x (hY msup).refl
        (crx_of_runLCG rfl (crc_of_pure env rfl (comp_run_n0L h7 ax goal region g hi) msup)),
      resR_of_resG rfl (res_n0 env msup ax region), pastAt_nd h7 hcode env.cod trivial⟩
  | Nomm.n1 k, _, msup, region, _ =>
    ⟨fun goal g hi => crxt_of_x (hY msup).refl
        (crx_of_runLCG rfl (crc_of_pure env rfl (comp_run_n1L h7 k goal region g hi) msup)),
      resR_of_resG rfl (res_n1 env msup k region), pastAt_nd h7 hcode env.cod trivial⟩
  | Nomm.n2 p q Option.none, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_n2LRTG (hY msup) h7 hcode env msup p q P Q goal g hi, res_n2RG P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n2 p q (some (b, Option.none)), h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd
    obtain ⟨⟨hcd, -, hro, nb, hnb, hE⟩, hdp, hdq⟩ := hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h.1 msup region hdp
    have Q := comp_run_dirTG h7 hcode env E Y hY q h.2 msup region hdq
    exact ⟨fun goal g hi => comp_run_n2_directXTTG (hY msup) h7 hcode env p q P Q b hcd (env.ring b) rfl hro nb hE hnb goal g hi,
      res_n2_directMonoG P.res Q.res hnb, pastAt_code h7 hcode env hc⟩
  | Nomm.n2 _ _ (some (_, some _)), h, _, _, _ => by simp [DirOk] at h
  | Nomm.n3 p, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk] at h; simp only [DirCallsTG] at hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h msup region hd
    exact ⟨fun goal g hi => comp_run_n3LRTG (hY msup) h7 env msup p goal region g hi P.link, res_n3RG P.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n4 p, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk] at h; simp only [DirCallsTG] at hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h msup region hd
    exact ⟨fun goal g hi => comp_run_n4LRTG (hY msup) h7 env msup p goal region g hi P.link, res_n4RG P.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n5 p q, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_n5LRTG (hY msup) h7 hcode env msup p q P Q goal g hi, res_n5RG P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n7 p q, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd
    have P := comp_run_dirTG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTG h7 hcode env E Y hY q h.2 (some p) region hd.2
    exact ⟨fun goal g hi => comp_run_n7TG (hY msup) env msup p q goal region g (Q.link goal g hi)
        (fun x mono sup hX => ⟨hX.1, hX.2.1, rfl⟩)
        (fun nex g1 e => P.link nex.goal g1 (Q.res goal g g1 nex hi e).2.2.1),
      res_n7RG Q.res P.res, pastAt_code h7 hcode env hc⟩
  | Nomm.n10 a v q, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true, bne_iff_ne, ne_eq] at h; simp only [DirCallsTG] at hd
    have V := comp_run_dirTG h7 hcode env E Y hY v h.1.2 msup region hd.1
    have Q := comp_run_dirTG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_n10LRTG (hY msup) h7 hcode env msup a h.1.1 v q V Q goal g hi,
      res_n10RG h.1.1 V.res Q.res, pastAt_code h7 hcode env hc⟩
  | Nomm.n6 p q r, h, msup, region, hd => by
    have hc := callCode_of_dirTG (ctx := ctx) _ h msup hd
    have ha := noAx0_of_dir _ h
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTG] at hd; simp only [Bake.NoAx0] at ha
    have hc' := hc
    simp only [CallCode] at hc'
    have P := comp_run_dirTG h7 hcode env E Y hY p h.1.1 msup region hd.1
    have Q := fun rg => comp_run_dirTG h7 hcode env E Y hY q h.1.2 msup rg hd.2.1
    have R := fun rg => comp_run_dirTG h7 hcode env E Y hY r h.2 msup rg hd.2.2
    exact ⟨fun goal g hi => comp_run_n6_allRTG (hY msup) h7 hcode env msup p q r region (sixRT_ofG h7 hcode P hc'.1)
        (sixRT_ofG h7 hcode (Q region) hc'.2.1) (sixRT_ofG h7 hcode (R region) hc'.2.2)
        (fun rid => sixRT_ofG h7 hcode (Q (rid :: region)) hc'.2.1)
        (fun rid => sixRT_ofG h7 hcode (R (rid :: region)) hc'.2.2) ha.2.1 ha.2.2 goal g hi,
      res_n6_allRG P.res (Q region).res (R region).res (fun rid => (Q (rid :: region)).res)
        (fun rid => (R (rid :: region)).res) ha.2.1 ha.2.2,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n11s _ _ _, h, _, _, _ => by simp [DirOk] at h
  | Nomm.n11d _ _ _ _, h, _, _, _ => by simp [DirOk] at h
  | Nomm.n12 _ _, h, _, _, _ => by simp [DirOk] at h
  | Nomm.mean _ _ _ _ _, h, _, _, _ => by simp [DirOk] at h

/-- **The threaded run link on every goal with `GInv`**. -/
theorem comp_run_dirXTG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XM E msup) Y)
    (n : Nomm) (hn : DirOk n = true) (msup : Option Nomm) (region : List Nat)
    (hd : DirCallsTG env cod ctx E Y msup n) (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hi : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx (XM E msup) Y n goal region g :=
  (comp_run_dirTG h7 hcode env E Y hY n hn msup region hd).link goal g hi

/-- What a run of the class returns (threaded hypotheses). -/
theorem res_dirTG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XM E msup) Y)
    (n : Nomm) (hn : DirOk n = true) (msup : Option Nomm) (region : List Nat)
    (hd : DirCallsTG env cod ctx E Y msup n) : ResForR (runLCMR env true msup) n region :=
  (comp_run_dirTG h7 hcode env E Y hY n hn msup region hd).res

/-- **The old `DirCallsT` (no ring) is `DirCallsTG`.** -/
theorem dirCallsTG_of_T {env : CallEnv} {cod : Noun} {E : GenRest → Prop} {Y : GenRest → GenRest → Prop} :
    ∀ (ms : Option Nomm) (n : Nomm), DirCallsT env cod ctx E Y ms n → DirCallsTG env cod ctx E Y ms n
  | ms, Nomm.cons p q, h => ⟨dirCallsTG_of_T ms p h.1, dirCallsTG_of_T ms q h.2⟩
  | _, Nomm.n0 _, _ => trivial
  | _, Nomm.n1 _, _ => trivial
  | ms, Nomm.n2 p q Option.none, h => ⟨dirCallsTG_of_T ms p h.1, dirCallsTG_of_T ms q h.2⟩
  | ms, Nomm.n2 p q (some (_, _)), h => ⟨callOkTG_of_T h.1, dirCallsTG_of_T ms p h.2.1, dirCallsTG_of_T ms q h.2.2⟩
  | ms, Nomm.n3 p, h => dirCallsTG_of_T ms p h
  | ms, Nomm.n4 p, h => dirCallsTG_of_T ms p h
  | ms, Nomm.n5 p q, h => ⟨dirCallsTG_of_T ms p h.1, dirCallsTG_of_T ms q h.2⟩
  | ms, Nomm.n6 p q r, h => ⟨dirCallsTG_of_T ms p h.1, dirCallsTG_of_T ms q h.2.1, dirCallsTG_of_T ms r h.2.2⟩
  | ms, Nomm.n7 p q, h => ⟨dirCallsTG_of_T ms p h.1, dirCallsTG_of_T (some p) q h.2⟩
  | ms, Nomm.n10 _ v q, h => ⟨dirCallsTG_of_T ms v h.1, dirCallsTG_of_T ms q h.2⟩
  | _, Nomm.n11s _ _ _, _ => trivial
  | _, Nomm.n11d _ _ _ _, _ => trivial
  | _, Nomm.n12 _ _, _ => trivial
  | _, Nomm.mean _ _ _ _ _, _ => trivial

