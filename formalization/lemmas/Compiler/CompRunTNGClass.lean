/-! ## The direct call through a ring -/

/-- **What one direct call takes, threaded, through its ring** (`CallOkTN` with `env.ring b = none`
replaced by `RinOkN (env.ring b)`, the entry `env.ring b` read by `CallNounMTG`). -/
def CallOkTNG (env : CallEnv) (cod ctx : Noun) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop)
    (msup : Option Nomm) (p q : Nomm) (b : Bell) : Prop :=
  CodePure cod env b ∧ env.cod b = some (env.pure b) ∧ RinOkN (env.ring b) ∧
    ∃ nb, env.need b = some nb ∧ env.sof (made p msup) p q b nb = false ∧ ∀ x, x.NoSoft → E x → ∃ x' sur, Y x x' ∧
      CallNounMTG msup ctx p q b nb sur x x' (A 1) (A 1) (env.ring b)

/-- The old `CallOkTN` (no ring) is a `CallOkTNG`. -/
theorem callOkTNG_of_TN {env : CallEnv} {cod : Noun} {E : GenRest → Prop} {Y : GenRest → GenRest → Prop}
    {msup : Option Nomm} {p q : Nomm} {b : Bell} (h : CallOkTN env cod ctx E Y msup p q b) :
    CallOkTNG env cod ctx E Y msup p q b := by
  obtain ⟨h1, h2, h3, nb, h4, h5, h6⟩ := h
  refine ⟨h1, h2, by rw [h3]; trivial, nb, h4, h5, fun x hx hE => ?_⟩
  obtain ⟨x', sur, hy, hT, -⟩ := h6 x hx hE
  exact ⟨x', sur, hy, by rw [h3]; exact callNounMTG_of_mt hT⟩

/-- With `mono` `|` the link against `runLC` is one against `runLCMR env false`. -/
theorem crx_of_runLCNG {env : CallEnv} {msup : Option Nomm} {X : GenRest → Noun → Noun → Prop} {n : Nomm}
    (hn : n.noDirect = true) {goal : CGoalL CSet} {region : List Nat} {g : Gen (TreapMap mugF)}
    (h : CompRunAtR (runLC env msup) ctx n goal region g) :
    CompRunAtX (runLCMR env false msup) ctx X n goal region g := by
  intro x mono sup hx _
  rw [runLCMR_false_ndNG env hn msup]
  exact h x mono sup hx

/-- `ResFor` is `ResForR (runLCMR env false msup)`. -/
theorem resR_of_resNG {env : CallEnv} {msup : Option Nomm} {n : Nomm} {region : List Nat} (hn : n.noDirect = true)
    (h : ResFor env msup n region) : ResForR (runLCMR env false msup) n region := by
  intro goal g g' nex hi e
  rw [runLCMR_false_ndNG env hn msup] at e
  exact h goal g g' nex hi e

/-- **The case `%7` of `+run`, threaded**: `q` with `sup` set to `p` at the
rest `x`, giving `x1`, then `p` at `x1` with the goal `q` returned. -/
theorem comp_run_n7TNG {X : GenRest → Noun → Noun → Prop} {Y : GenRest → GenRest → Prop} (hYk : YOk X Y)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (goal : CGoalL CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) {Xq : GenRest → Noun → Noun → Prop}
    (hq : CompRunAtXT (runLCMR env false (some p)) ctx Xq Y q goal region g)
    (hXq : ∀ x mono sup, X x mono sup → Xq x mono (C (A 0) p.toNoun))
    (hp : ∀ nex g1, runLCMR env false (some p) q goal region g = some (nex, g1) →
      CompRunAtXT (runLCMR env false msup) ctx X Y p nex.goal region g1) :
    CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n7 p q) goal region g := by
  intro x mono sup hx hX
  obtain ⟨x1, hy1, h1⟩ := hq x mono (C (A 0) p.toNoun) hx (hXq x mono sup hX)
  simp only [crSubj, compCore] at h1
  simp only [Nomm.toNoun]
  rw [cr_disp_n7]
  cases e : runLCMR (S := CSet) (Map := TreapMap mugF) env false (some p) q goal region g with
  | none =>
    rw [e] at h1
    refine ⟨x1, hy1, ?_⟩
    simp only [compCore]
    generalize comp.door = Dr at h1 ⊢
    nock_open crK7
    simp [nock_exec, crSubj, cr_bat_dol, h1, runLCMR, e, bind, StateT.bind]
  | some r =>
    obtain ⟨nex, g1⟩ := r
    rw [e] at h1
    obtain ⟨x2, hy2, h2⟩ := hp nex g1 e x1 mono sup (hYk.soft hx hy1) (hYk.pres hX hy1)
    refine ⟨x2, hYk.trans hy1 hy2, ?_⟩
    simp only [crSubj, compCore] at h2 h1
    simp only [compCore]
    generalize comp.door = Dr at h1 h2 ⊢
    nock_open crK7
    simp [nock_exec, crSubj, cr_bat_dol, h1, h2, runLCMR, e, bind, StateT.bind]

/-- **`CallOkTNG` of every direct call**, each at the `msup` its run gets,
the subject and formula of a direct call included (a call there may miss
too: the tail of the call is threaded, `comp_run_n2_directXTT`). -/
def DirCallsTNG (env : CallEnv) (cod ctx : Noun) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) :
    Option Nomm → Nomm → Prop
  | ms, Nomm.cons p q => DirCallsTNG env cod ctx E Y ms p ∧ DirCallsTNG env cod ctx E Y ms q
  | ms, Nomm.n2 p q Option.none => DirCallsTNG env cod ctx E Y ms p ∧ DirCallsTNG env cod ctx E Y ms q
  | ms, Nomm.n2 p q (some (b, _)) =>
      CallOkTNG env cod ctx E Y ms p q b ∧ DirCallsTNG env cod ctx E Y ms p ∧ DirCallsTNG env cod ctx E Y ms q
  | ms, Nomm.n3 p => DirCallsTNG env cod ctx E Y ms p
  | ms, Nomm.n4 p => DirCallsTNG env cod ctx E Y ms p
  | ms, Nomm.n5 p q => DirCallsTNG env cod ctx E Y ms p ∧ DirCallsTNG env cod ctx E Y ms q
  | ms, Nomm.n6 p q r =>
      DirCallsTNG env cod ctx E Y ms p ∧ DirCallsTNG env cod ctx E Y ms q ∧ DirCallsTNG env cod ctx E Y ms r
  | ms, Nomm.n7 p q => DirCallsTNG env cod ctx E Y ms p ∧ DirCallsTNG env cod ctx E Y (some p) q
  | ms, Nomm.n10 _ v q => DirCallsTNG env cod ctx E Y ms v ∧ DirCallsTNG env cod ctx E Y ms q
  | _, _ => True

theorem callCode_of_dirTNG {env : CallEnv} {cod : Noun} {E : GenRest → Prop} {Y : GenRest → GenRest → Prop} :
    ∀ (n : Nomm), DirOk n = true → ∀ (ms : Option Nomm), DirCallsTNG env cod ctx E Y ms n → CallCode cod env n
  | Nomm.cons p q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTNG p h.1 ms hd.1, callCode_of_dirTNG q h.2 ms hd.2⟩
  | Nomm.n0 _, _, _, _ => trivial
  | Nomm.n1 _, _, _, _ => trivial
  | Nomm.n2 p q Option.none, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨trivial, callCode_of_dirTNG p h.1 ms hd.1, callCode_of_dirTNG q h.2 ms hd.2⟩
  | Nomm.n2 p q (some (b, Option.none)), h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨⟨hd.1.1, hd.1.2.1⟩, callCode_of_dirTNG p h.1 ms hd.2.1, callCode_of_dirTNG q h.2 ms hd.2.2⟩
  | Nomm.n2 _ _ (some (_, some _)), h, _, _ => by simp [DirOk] at h
  | Nomm.n3 p, h, ms, hd => by
    simp only [DirOk] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]; exact callCode_of_dirTNG p h ms hd
  | Nomm.n4 p, h, ms, hd => by
    simp only [DirOk] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]; exact callCode_of_dirTNG p h ms hd
  | Nomm.n5 p q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTNG p h.1 ms hd.1, callCode_of_dirTNG q h.2 ms hd.2⟩
  | Nomm.n7 p q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTNG p h.1 ms hd.1, callCode_of_dirTNG q h.2 (some p) hd.2⟩
  | Nomm.n10 a v q, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTNG v h.1.2 ms hd.1, callCode_of_dirTNG q h.2 ms hd.2⟩
  | Nomm.n6 p q r, h, ms, hd => by
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [CallCode]
    exact ⟨callCode_of_dirTNG p h.1.1 ms hd.1, callCode_of_dirTNG q h.1.2 ms hd.2.1, callCode_of_dirTNG r h.2 ms hd.2.2⟩
  | Nomm.n11s _ _ _, h, _, _ => by simp [DirOk] at h
  | Nomm.n11d _ _ _ _, h, _, _ => by simp [DirOk] at h
  | Nomm.n12 _ _, h, _, _ => by simp [DirOk] at h
  | Nomm.mean _ _ _ _ _, h, _, _ => by simp [DirOk] at h

theorem sixRT_ofNG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    {env : CallEnv} {msup : Option Nomm} {X : GenRest → Noun → Noun → Prop} {Y : GenRest → GenRest → Prop}
    {n : Nomm} {region : List Nat}
    (N : PartRTNR env msup ctx X Y n region) (hcc : CallCode cod env n) : SixPartsRTNG env msup ctx X Y n region :=
  ⟨N.link, N.res, pastForkAt_code h7 hcode env hcc⟩

/-- **The threaded run link at `mono` `|` on the class with direct calls**:
every nomm of `DirOk` whose direct calls meet `CallOkTNG` is a `PartRTNR` at
`XN E msup` (link threading the rest, result, `+past`), for every `Y` that is
a preorder keeping `NoSoft` and `E` (`YOk`). -/
theorem comp_run_dirTNG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XN E msup) Y) :
    ∀ (n : Nomm), DirOk n = true → ∀ (msup : Option Nomm) (region : List Nat),
      DirCallsTNG env cod ctx E Y msup n → PartRTNR env msup ctx (XN E msup) Y n region
  | Nomm.cons p q, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTNG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_consLRTNG (hY msup) h7 hcode env msup p q P Q goal g hi, res_consRNG P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n0 ax, _, msup, region, _ =>
    ⟨fun goal g hi => crxt_of_x (hY msup).refl
        (crx_of_runLCNG rfl (crc_of_pure env rfl (comp_run_n0L h7 ax goal region g hi) msup)),
      resR_of_resNG rfl (res_n0 env msup ax region), pastAt_nd h7 hcode env.cod trivial⟩
  | Nomm.n1 k, _, msup, region, _ =>
    ⟨fun goal g hi => crxt_of_x (hY msup).refl
        (crx_of_runLCNG rfl (crc_of_pure env rfl (comp_run_n1L h7 k goal region g hi) msup)),
      resR_of_resNG rfl (res_n1 env msup k region), pastAt_nd h7 hcode env.cod trivial⟩
  | Nomm.n2 p q Option.none, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTNG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_n2LRTNG (hY msup) h7 hcode env msup p q P Q goal g hi, res_n2RNG P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n2 p q (some (b, Option.none)), h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd
    obtain ⟨⟨hcd, -, hro, nb, hnb, hsof, hE⟩, hdp, hdq⟩ := hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h.1 msup region hdp
    have Q := comp_run_dirTNG h7 hcode env E Y hY q h.2 msup region hdq
    exact ⟨fun goal g hi => comp_run_n2_directNTTG (hY msup) h7 hcode env p q P Q b hcd (env.ring b) hro nb hE rfl hnb hsof goal g hi,
      res_n2_directNR P.res Q.res hnb hsof, pastAt_code h7 hcode env hc⟩
  | Nomm.n2 _ _ (some (_, some _)), h, _, _, _ => by simp [DirOk] at h
  | Nomm.n3 p, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk] at h; simp only [DirCallsTNG] at hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h msup region hd
    exact ⟨fun goal g hi => comp_run_n3LRTNG (hY msup) h7 env msup p goal region g hi P.link, res_n3RNG P.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n4 p, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk] at h; simp only [DirCallsTNG] at hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h msup region hd
    exact ⟨fun goal g hi => comp_run_n4LRTNG (hY msup) h7 env msup p goal region g hi P.link, res_n4RNG P.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n5 p q, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTNG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_n5LRTNG (hY msup) h7 hcode env msup p q P Q goal g hi, res_n5RNG P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n7 p q, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd
    have P := comp_run_dirTNG h7 hcode env E Y hY p h.1 msup region hd.1
    have Q := comp_run_dirTNG h7 hcode env E Y hY q h.2 (some p) region hd.2
    exact ⟨fun goal g hi => comp_run_n7TNG (hY msup) env msup p q goal region g (Q.link goal g hi)
        (fun x mono sup hX => ⟨hX.1, hX.2.1, rfl⟩)
        (fun nex g1 e => P.link nex.goal g1 (Q.res goal g g1 nex hi e).2.2.1),
      res_n7RNG Q.res P.res, pastAt_code h7 hcode env hc⟩
  | Nomm.n10 a v q, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    simp only [DirOk, Bool.and_eq_true, bne_iff_ne, ne_eq] at h; simp only [DirCallsTNG] at hd
    have V := comp_run_dirTNG h7 hcode env E Y hY v h.1.2 msup region hd.1
    have Q := comp_run_dirTNG h7 hcode env E Y hY q h.2 msup region hd.2
    exact ⟨fun goal g hi => comp_run_n10LRTNG (hY msup) h7 hcode env msup a h.1.1 v q V Q goal g hi,
      res_n10RNG h.1.1 V.res Q.res, pastAt_code h7 hcode env hc⟩
  | Nomm.n6 p q r, h, msup, region, hd => by
    have hc := callCode_of_dirTNG (ctx := ctx) _ h msup hd
    have ha := noAx0_of_dir _ h
    simp only [DirOk, Bool.and_eq_true] at h; simp only [DirCallsTNG] at hd; simp only [Bake.NoAx0] at ha
    have hc' := hc
    simp only [CallCode] at hc'
    have P := comp_run_dirTNG h7 hcode env E Y hY p h.1.1 msup region hd.1
    have Q := fun rg => comp_run_dirTNG h7 hcode env E Y hY q h.1.2 msup rg hd.2.1
    have R := fun rg => comp_run_dirTNG h7 hcode env E Y hY r h.2 msup rg hd.2.2
    exact ⟨fun goal g hi => comp_run_n6_allRTNG (hY msup) h7 hcode env msup p q r region (sixRT_ofNG h7 hcode P hc'.1)
        (sixRT_ofNG h7 hcode (Q region) hc'.2.1) (sixRT_ofNG h7 hcode (R region) hc'.2.2)
        (fun rid => sixRT_ofNG h7 hcode (Q (rid :: region)) hc'.2.1)
        (fun rid => sixRT_ofNG h7 hcode (R (rid :: region)) hc'.2.2) ha.2.1 ha.2.2 goal g hi,
      res_n6_allRNG P.res (Q region).res (R region).res (fun rid => (Q (rid :: region)).res)
        (fun rid => (R (rid :: region)).res) ha.2.1 ha.2.2,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n11s _ _ _, h, _, _, _ => by simp [DirOk] at h
  | Nomm.n11d _ _ _ _, h, _, _, _ => by simp [DirOk] at h
  | Nomm.n12 _ _, h, _, _, _ => by simp [DirOk] at h
  | Nomm.mean _ _ _ _ _, h, _, _, _ => by simp [DirOk] at h

/-- **The threaded run link on every goal with `GInv`**. -/
theorem comp_run_dirXTNG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XN E msup) Y)
    (n : Nomm) (hn : DirOk n = true) (msup : Option Nomm) (region : List Nat)
    (hd : DirCallsTNG env cod ctx E Y msup n) (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hi : GInv g goal) :
    CompRunAtXT (runLCMR env false msup) ctx (XN E msup) Y n goal region g :=
  (comp_run_dirTNG h7 hcode env E Y hY n hn msup region hd).link goal g hi

/-- What a run of the class returns (threaded hypotheses). -/
theorem res_dirTNG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XN E msup) Y)
    (n : Nomm) (hn : DirOk n = true) (msup : Option Nomm) (region : List Nat)
    (hd : DirCallsTNG env cod ctx E Y msup n) : ResForR (runLCMR env false msup) n region :=
  (comp_run_dirTNG h7 hcode env E Y hY n hn msup region hd).res


/-- **`mem_runN` is track I's `hrunN`**: it instantiates `mem_gate_done_R` (the gate `member`
on `%done` for a member of a real SCC) at the rest `x1` the run leaves. -/
example (cape : Cape) (DATA FOL : Noun) (keep : Bool) (ML CACHE DN KIDS ML0 CB SCC CODE LSR JH CACHE0 : Noun)
    (nm : Nomm) (CA1 : Noun)
    (hinl : nock (C inlBody (C (C (C (C cape.toNoun DATA) FOL) (C (C CODE LSR) (C JH CACHE))) compK)) inlBody
      = some (C nm.toNoun CA1))
    (env : CallEnv) (nex : NextL CSet) (g1 : Gen (TreapMap mugF))
    (hrunL : runLC env Option.none nm (CGoalL.done : CGoalL CSet) [] (gen0 : Gen (TreapMap mugF)) = some (nex, g1))
    (E : GenRest → Prop) (Y : GenRest → GenRest → Prop) (hY : ∀ msup, YOk (XN E msup) Y) (hn : DirOk nm = true)
    (hd : DirCallsTN env CODE (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)) E Y Option.none nm)
    (hE : E (cuRest CA1)) : True := by
  obtain ⟨x1, -, hrunN⟩ := mem_runN SCC CODE LSR JH ML (A 0) (C (C cape.toNoun DATA) FOL) env E Y hY nm hn hd CA1 hE
    nex g1 hrunL
  have := mem_gate_done_R cape DATA FOL keep ML CACHE DN KIDS ML0 CB SCC CODE LSR JH CACHE0 nm CA1 hinl env nex g1
    hrunL x1 hrunN
  trivial


/-- **`DirCallsTN` gives `DirCallsTNG`**: the old hypothesis (no ring at any call) is the new one. -/
theorem dirCallsTNG_of_TN {env : CallEnv} {cod : Noun} {E : GenRest → Prop} {Y : GenRest → GenRest → Prop} :
    ∀ (ms : Option Nomm) (n : Nomm), DirCallsTN env cod ctx E Y ms n → DirCallsTNG env cod ctx E Y ms n
  | ms, Nomm.cons p q, h => ⟨dirCallsTNG_of_TN ms p h.1, dirCallsTNG_of_TN ms q h.2⟩
  | ms, Nomm.n2 p q Option.none, h => ⟨dirCallsTNG_of_TN ms p h.1, dirCallsTNG_of_TN ms q h.2⟩
  | ms, Nomm.n2 p q (some (b, _)), h => ⟨callOkTNG_of_TN h.1, dirCallsTNG_of_TN ms p h.2.1, dirCallsTNG_of_TN ms q h.2.2⟩
  | ms, Nomm.n3 p, h => dirCallsTNG_of_TN ms p h
  | ms, Nomm.n4 p, h => dirCallsTNG_of_TN ms p h
