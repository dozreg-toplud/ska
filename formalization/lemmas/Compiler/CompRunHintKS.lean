/-- A static tag: `crK11` is `cr11Kept`. -/
theorem cr11_kept {tag : Nat} (hs : hintStatic tag = true) (q : Noun) (mono body goal region sup D : Noun) :
    nock (crSubj mono (C (A 11) (C (A tag) (C q body))) goal region sup D) crK11
      = nock (crSubj mono (C (A 11) (C (A tag) (C q body))) goal region sup D) cr11Kept := by
  rcases hd_static_cases tag with ⟨-, h | h⟩ | ⟨h, -⟩
  · subst h; rw [cr11_eq]; unfold cr11Head cr11St cr11T cr11TS; simp [nock_exec, crSubj]
  · subst h; rw [cr11_eq]; unfold cr11Head cr11St cr11T cr11TS; simp [nock_exec, crSubj]
  · rw [hs] at h; exact absurd h (by decide)

/-! ## The parts -/

/-- The model from the run of `q` on. -/
noncomputable def ckTail (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)) (q : Nomm)
    (tag : Nat) (body : Noun) (laz : Lazy CSet) (epil : Nat) (region : List Nat) :
    CM (TreapMap mugF) (NextL CSet) := do
  let nexFol ← R q (CGoalL.next laz (jmp0 epil)) region
  let nexFol ← lazyBound nexFol region
  let prol ← emit ⟨[], [Pole.hsp tag body], Termin.hop nexFol.th⟩
  pure ⟨nexFol.laz, jmp0 prol⟩

/-- **From the run of `q` on**: `q`, `+lazy-bound`, the prologue, the result. -/
theorem ck_p3 (h7 : slot? 7 ctx = some compK) {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)}
    {X : GenRest → Noun → Noun → Prop} (tag : Nat) (q : Nomm) (body : Noun) (region : List Nat) (x : GenRest)
    (hx : x.NoSoft) (mono goalN sup nex0N : Noun) (nex1 : NextL CSet) (epil : Nat) (g3 : Gen (TreapMap mugF))
    (hq : CompRunAtX R ctx X q (CGoalL.next nex1.laz (jmp0 epil)) region g3) (hX : X x mono sup) :
    nock (C (A epil) (C nex1.goal.toNoun (C nex0N (crSubj mono (Nomm.n11s tag q body).toNoun goalN
      (listNoun A region) sup (compCore g3 x ctx))))) ckP3
      = (ckTail R q tag body nex1.laz epil region g3).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hq1 := hq x mono sup hx hX
  simp only [crSubj, compCore, cgl_next_noun, cr_jmp0] at hq1
  have hD1 := comp_lb_at
  have hD2 := comp_emit_at
  simp only [compCore, cr_next_nounL]
  cases e1 : R q (CGoalL.next nex1.laz (jmp0 epil)) region g3 with
  | none =>
    rw [e1] at hq1
    generalize comp.door = Dr at hq1 hD1 hD2 ⊢
    unfold ckP3
    simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, hq1, ckTail, bind, StateT.bind, e1]
  | some r1 =>
    obtain ⟨n1, g4⟩ := r1
    rw [e1] at hq1
    simp only [Option.map_some, cr_next_nounL] at hq1
    have hlb := comp_lazy_bound hc x g4 n1 region
    simp only [compCore, cr_next_nounL] at hlb
    cases e2 : lazyBound (S := CSet) (Map := TreapMap mugF) n1 region g4 with
    | none =>
      rw [e2] at hlb
      generalize comp.door = Dr at hq1 hD1 hD2 hlb ⊢
      unfold ckP3
      simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, hq1, ckTail, bind, StateT.bind, e1, hD1, lb_arm, hlb, e2]
    | some r2 =>
      obtain ⟨n2, g5⟩ := r2
      rw [e2] at hlb
      simp only [Option.map_some, cr_next_nounL] at hlb
      have he := cf_emit (x := x) hc g5 ⟨[], [Pole.hsp tag body], Termin.hop n2.th⟩
      simp only [Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.hop, Tag.hsp] at he
      generalize comp.door = Dr at hq1 hD1 hD2 hlb he ⊢
      unfold ckP3
      simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, hq1, ckTail, bind, StateT.bind, e1, hD1, lb_arm, hlb, e2,
        hD2, comp_emit_arm, he, cf_emit_g, pure, StateT.pure, cr_next_nounL, cr_jmp0]

/-- The model from `+past-if` on. -/
noncomputable def ckFrom (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet))
    (snd : Nomm → NeedOrd → Bool) (q : Nomm) (tag : Nat) (body : Noun) (region : List Nat) (nex : NextL CSet) :
    CM (TreapMap mugF) (NextL CSet) := do
  let nex ← pastIfL snd nex q region
  let epil ← emit ⟨[], [Pole.hse tag body], Termin.hop nex.th⟩
  ckTail R q tag body nex.laz epil region

/-- The blob of the epilogue. -/
abbrev ckEpil (tag : Nat) (body : Noun) (th : Jmp) : Blob := ⟨[], [Pole.hse tag body], Termin.hop th⟩

/-- **From `+past-if` on**: `+past-if` (`comp_past_if`), the epilogue, `ck_p3`. -/
theorem ck_p1 (h7 : slot? 7 ctx = some compK) {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)}
    {X : GenRest → Noun → Noun → Prop} {snd : Nomm → NeedOrd → Bool} (tag : Nat) (q : Nomm) (body : Noun)
    (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup : Noun) (nex0 : NextL CSet)
    (g1 : Gen (TreapMap mugF)) (hs : SoundAt ctx snd q)
    (hq : ∀ nex1 g2, pastIfL snd nex0 q region g1 = some (nex1, g2) →
      CompRunAtX R ctx X q (CGoalL.next nex1.laz (jmp0 g2.bo)) region (cfEmitG (ckEpil tag body nex1.th) g2))
    (hX : X x mono sup) :
    nock (C nex0.goal.toNoun (crSubj mono (Nomm.n11s tag q body).toNoun goalN (listNoun A region) sup
      (compCore g1 x ctx))) ckP1
      = (ckFrom R snd q tag body region nex0 g1).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hpi := comp_past_if h7 x g1 nex0 q region hs
  simp only [compCore, cr_next_nounL] at hpi ⊢
  have hD1 := comp_past_if_at
  have hD2 := comp_emit_at
  cases e1 : pastIfL snd nex0 q region g1 with
  | none =>
    rw [e1] at hpi
    generalize comp.door = Dr at hpi hD1 hD2 ⊢
    nock_open ckP1
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pi_arm, hpi, ckFrom, bind, StateT.bind, e1]
  | some r =>
    obtain ⟨nex1, g2⟩ := r
    rw [e1] at hpi
    simp only [Option.map_some, cr_next_nounL] at hpi
    have he := cf_emit (x := x) hc g2 (ckEpil tag body nex1.th)
    simp only [ckEpil, Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.hop, Tag.hse] at he
    have ht := ck_p3 h7 tag q body region x hx mono goalN sup nex0.goal.toNoun nex1 g2.bo _ (hq nex1 g2 e1) hX
    simp only [crSubj, compCore, cr_next_nounL, Nomm.toNoun] at ht
    generalize comp.door = Dr at hpi hD1 hD2 he ht ⊢
    nock_open ckP1
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pi_arm, hpi, hD2, comp_emit_arm, he, ht, ckFrom, bind, StateT.bind,
      e1, cf_emit_g]

/-! ## The case -/

theorem runLCH_n11s_kept (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) {tag : Nat}
    (hst : hintStatic tag = true) (q : Nomm) (body : Noun) (goal : CGoalL CSet) (region : List Nat) :
    (runLCH env snd true msup (Nomm.n11s tag q body) goal region : CM (TreapMap mugF) (NextL CSet)) =
      simpleNextL goal >>= ckFrom (runLCH env snd true msup) snd q tag body region := by
  simp only [runLCH, hst, Bool.not_true, Bool.false_eq_true, if_false]
  rfl

/-- **The kept static tag on every goal** (`%bout`, `%xray`), against
`runLCH env snd true msup`: from `SoundAt` of `q` and the link of `q` at the
goal it gets (`[%next laz ~ epil]` after `+simple-next` and `+past-if`). -/
theorem comp_run_n11s_kept (h7 : slot? 7 ctx = some compK) (env : CallEnv) (snd : Nomm → NeedOrd → Bool)
    (msup : Option Nomm) {X : GenRest → Noun → Noun → Prop} {tag : Nat} (hst : hintStatic tag = true)
    (q : Nomm) (body : Noun) (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF))
    (hs : SoundAt ctx snd q)
    (hq : ∀ nex0 g1 nex1 g2, simpleNextL goal g = some (nex0, g1) → pastIfL snd nex0 q region g1 = some (nex1, g2) →
      CompRunAtX (runLCH env snd true msup) ctx X q (CGoalL.next nex1.laz (jmp0 g2.bo)) region
        (cfEmitG (ckEpil tag body nex1.th) g2)) :
    CompRunAtX (runLCH env snd true msup) ctx X (Nomm.n11s tag q body) goal region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  intro x mono sup hx hX
  rw [runLCH_n11s_kept env snd msup hst]
  simp only [Nomm.toNoun]
  rw [cr_disp_n11, cr11_kept hst, ck_eq]
  have hsn := comp_simple_next hc x g goal mono (C (A 11) (C (A tag) (C q.toNoun body))) (listNoun A region) sup
  rw [bind_apply]
  cases e : simpleNextL (S := CSet) (Map := TreapMap mugF) goal g with
  | none =>
    rw [e] at hsn
    simp only [Option.map_none] at hsn
    simp only [crSubj, compCore] at hsn ⊢
    generalize comp.door = Dr at hsn ⊢
    nock_open ckHead
    simp [nock_exec, crSubj, hsn, cr_bat_sn]
  | some r =>
    obtain ⟨nex0, g1⟩ := r
    rw [e] at hsn
    simp only [Option.map_some] at hsn
    have hk := ck_p1 h7 tag q body region x hx mono goal.toNoun sup nex0 g1 hs (fun nex1 g2 e1 => hq nex0 g1 nex1 g2 e e1) hX
    simp only [crSubj, compCore, Nomm.toNoun] at hsn hk ⊢
    generalize comp.door = Dr at hsn hk ⊢
    nock_open ckHead
    simp [nock_exec, crSubj, hsn, cr_bat_sn, hk]

