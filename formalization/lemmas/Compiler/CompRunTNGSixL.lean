/-- **The case `%6` of `+run` in phase L**: under a `%next` goal with `GInv`
whose `+leap` gives `[~ rest bys]` (`hlp`; the Nock is `lp6_leap`, which needs
`Bake.NoAx0` of the branches), with `LeapTwice`, given the link of the case on the goal `[%next rest then]` in
the same state (`hRe`, whatever phase it takes: `comp_run_n6_nfRTNG hYk`,
`comp_run_n6_kRTNG hYk`, phase F) and what that run returns (`hReR`): the run on the
rest, then `+copy` of each `by` (`copyAll`). -/
theorem comp_run_n6_lRTNG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (region : List Nat) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (htw : LeapTwice laz q r)
    (hRe : CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next rest th) region g)
    (hReR : ∀ nex g', runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex) :
    CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hli := leapInv hinv.1 hq hr
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  have hLp := lp6_leap h7 laz q r hl hq hr g x
  rw [hlp, Option.map_some] at hLp
  rw [cr6l_head p q r laz rest th bys region x g mono sup hLp,
    runLC_n6_lRNG env msup p q r laz rest th bys region hlp (htw rest bys hlp)]
  exact xt_trans hYk hY0 (cr6l_eqT hYk h7 x g mono _ _ _ sup _ bys _ (hRe x mono sup hx hX)
    (fun nex g' e => (chain_l hli hlp (hReR nex g' e)).1))

/-- **Phase L** (`comp_run_n6_lRTNG hYk`) without `LeapTwice`. -/
theorem comp_run_n6_l_twRTNG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (region : List Nat) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (hRe : CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next rest th) region g)
    (hReR : ∀ nex g', runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex) :
    CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g :=
  comp_run_n6_lRTNG hYk h7 env msup p q r region hq hr laz th g hinv rest bys hlp (leapTwice_noAx0 hq hr) hRe hReR

