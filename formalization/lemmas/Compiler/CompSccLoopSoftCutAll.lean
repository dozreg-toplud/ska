/-- **`+sure-at` is `sureAt`**, on every axis, sure need and sock. -/
theorem sq_sa_gate : ∀ (axe : Nat) (sur : NeedOrd) (k : Sock),
    nock (C sqSaBat (C (C (A axe) (C sur.toNoun k.toNoun)) compK)) sqSaBat = (sureAt axe sur k).map loob := by
  intro axe
  induction axe using Nat.strongRecOn with
  | ind axe ih =>
    intro sur k
    have hK := compK_cs
    have hca := cellsure_arm
    have hcs := cellsure_gate compK sur k
    have hl := compK_lib
    have hl1 := compK_layer1M
    have hhed := so_hed_gate (C so.battery lib) k
    have htel := so_tel_gate (C so.battery lib) k
    have hho := hon_gate compK sur
    have hto := ton_gate compK sur
    have hha := hon_at
    have hta := ton_at
    have hhr := hon_arm
    have htr := ton_arm
    have har := cf_arith
    by_cases a1 : axe = 1
    · subst a1
      rw [sureAt]
      conv => { lhs; arg 2; unfold sqSaBat }
      simp [nock_exec, hK, hca, hcs]
    by_cases a0 : axe = 0
    · subst a0
      rw [sureAt]
      have hc0 := cap_gate_lt layer1 0 (by decide)
      conv => { lhs; arg 2; unfold sqSaBat }
      simp [nock_exec, hl1, cap_arm, cap.arm_at, hc0]
    have h2 : 2 ≤ axe := by omega
    have hcap := cap_gate layer1 har.2.2.2 axe h2
    have hmas := mas_gate layer1 har axe h2
    have hmlt : mas axe < axe := mas_lt axe h2
    have hne : ¬ (1 = axe) := by omega
    rw [sureAt]
    simp only [a1, a0, dif_neg, not_false_eq_true]
    rcases capF_cases axe h2 with hc2 | hc3
    · have hc : cap axe = 2 := by rw [← capF_eq_cap]; exact hc2
      have e := ih (mas axe) hmlt (ordHed sur) (So.hed k)
      rw [hc2] at hcap
      rw [masF_eq_mas] at hmas
      simp only [hc, if_true]
      conv => { lhs; arg 2; unfold sqSaBat }
      simp [nock_exec, hne, hl1, cap_arm, cap.arm_at, hcap, mas_arm, mas.arm_at, hmas, hha, hhr, hho, hl,
        so.lib.arm_at, so_lib_arm, so.hed.arm_at, so_hed_arm, hhed, e]
    · have hc : cap axe ≠ 2 := by rw [← capF_eq_cap, hc3]; omega
      have e := ih (mas axe) hmlt (ordTel sur) (So.tel k)
      rw [hc3] at hcap
      rw [masF_eq_mas] at hmas
      simp only [hc, if_false]
      conv => { lhs; arg 2; unfold sqSaBat }
      simp [nock_exec, hne, hl1, cap_arm, cap.arm_at, hcap, mas_arm, mas.arm_at, hmas, hta, htr, hto, hl,
        so.lib.arm_at, so_lib_arm, so.tel.arm_at, so_tel_arm, htel, e]

/-! ## `+soft-pair` -/

/-- The noun of a `SoftAx`: `%any`, `%no`, `[%at q]`. -/
def saxN : SoftAx → Noun
  | SoftAx.any => A 0x796e61
  | SoftAx.no => A 0x6f6e
  | SoftAx.at q => C (A 0x7461) (A q)

/-- `qh` (`qt` with `par` `1`): `~` for `%any` / `%no`, `[~ 0]` off parity, `[~ q/2]`. -/
def sqQN (par : Nat) : SoftAx → Noun
  | SoftAx.at q => if 1 < q ∧ q % 2 = par then C (A 0) (A (q / 2)) else C (A 0) (A 0)
  | _ => A 0

theorem sq_layer1 {ctx : Noun} (hc : CompIn ctx) : slot? 524287 ctx = some layer1 := by
  have h := slot_bit 262143 (by decide) 1 (by decide) ctx
  rw [hc] at h
  rw [show (524287 : Nat) = 2 * 262143 + 1 from rfl, h]
  exact (slot_three layer2).symm.trans layer2_layer1

theorem sq_logic : LteIn layer1 ∧ EndIn layer2 ∧ RshIn layer2 := by
  obtain ⟨ha, hs, hm, _, hlte, _, _, _, _, _, hdv, hmd⟩ := arith_layer1
  have hbex : BexIn layer2 := ⟨bex.arm_at, hm⟩
  exact ⟨hlte, ⟨end.arm_at, hbex, hmd⟩, ⟨rsh.arm_at, hbex, hdv⟩⟩

/-- **`qh`**: the push `sqSpQh`. -/
theorem sq_qh {ctx : Noun} (hc : CompIn ctx) (Dr G : Noun) (h t : SoftAx) :
    nock (C sqSpBat (C (C (saxN h) (saxN t)) (C Dr (C G ctx)))) sqSpQh = some (sqQN 0 h) := by
  obtain ⟨hlte, hend, hrsh⟩ := sq_logic
  have hl1 := sq_layer1 hc
  cases h with
  | any => simp [nock_exec, sqSpQh, saxN, sqQN]
  | no => simp [nock_exec, sqSpQh, saxN, sqQN]
  | «at» q =>
    have hg := gth_gate layer1 hlte q 1
    have he := end_gate layer2 hend (A 0) 0 1 q (BiteIs.atom 0)
    have hr := rsh_gate layer2 hrsh (A 0) 0 1 q (BiteIs.atom 0)
    simp only [Nat.pow_zero, Nat.one_mul, Nat.pow_one] at he hr
    by_cases h1 : 1 < q
    · by_cases h2 : q % 2 = 0
      · simp [nock_exec, sqSpQh, saxN, sqQN, hc, hl1, gth_arm, gth.arm_at, hg, end_arm, end.arm_at, he,
          rsh_arm, rsh.arm_at, hr, h1, h2, loob]
      · have h2' : ¬ (0 = q % 2) := fun e => h2 e.symm
        simp [nock_exec, sqSpQh, saxN, sqQN, hc, hl1, gth_arm, gth.arm_at, hg, end_arm, end.arm_at, he,
          rsh_arm, rsh.arm_at, hr, h1, h2, h2', loob]
    · simp [nock_exec, sqSpQh, saxN, sqQN, hc, hl1, gth_arm, gth.arm_at, hg, h1, loob]

/-- **`qt`**: the push `sqSpQt`. -/
theorem sq_qt {ctx : Noun} (hc : CompIn ctx) (Dr G QH : Noun) (h t : SoftAx) :
    nock (C QH (C sqSpBat (C (C (saxN h) (saxN t)) (C Dr (C G ctx))))) sqSpQt = some (sqQN 1 t) := by
  obtain ⟨hlte, hend, hrsh⟩ := sq_logic
  have hl1 := sq_layer1 hc
  cases t with
  | any => simp [nock_exec, sqSpQt, saxN, sqQN]
  | no => simp [nock_exec, sqSpQt, saxN, sqQN]
  | «at» q =>
    have hg := gth_gate layer1 hlte q 1
    have he := end_gate layer2 hend (A 0) 0 1 q (BiteIs.atom 0)
    have hr := rsh_gate layer2 hrsh (A 0) 0 1 q (BiteIs.atom 0)
    simp only [Nat.pow_zero, Nat.one_mul, Nat.pow_one] at he hr
    by_cases h1 : 1 < q
    · by_cases h2 : q % 2 = 1
      · simp [nock_exec, sqSpQt, saxN, sqQN, hc, hl1, gth_arm, gth.arm_at, hg, end_arm, end.arm_at, he,
          rsh_arm, rsh.arm_at, hr, h1, h2, loob]
      · have h2' : ¬ (1 = q % 2) := fun e => h2 e.symm
        simp [nock_exec, sqSpQt, saxN, sqQN, hc, hl1, gth_arm, gth.arm_at, hg, end_arm, end.arm_at, he,
          rsh_arm, rsh.arm_at, hr, h1, h2, h2', loob]
    · simp [nock_exec, sqSpQt, saxN, sqQN, hc, hl1, gth_arm, gth.arm_at, hg, h1, loob]

/-- **`+soft-pair` is `softPair`.** -/
theorem sq_sp_gate {ctx : Noun} (hc : CompIn ctx) (Dr G : Noun) (h t : SoftAx) :
    nock (C sqSpBat (C (C (saxN h) (saxN t)) (C Dr (C G ctx)))) sqSpBat = some (saxN (softPair h t)) := by
  have hqh := sq_qh hc Dr G h t
  have hqt := sq_qt hc Dr G (sqQN 0 h) h t
  conv => { lhs; arg 2; unfold sqSpBat }
  cases h with
  | no => simp [nock_exec, sqSpNo, saxN, softPair]
  | any =>
    cases t with
    | no => simp [nock_exec, sqSpNo, saxN, softPair]
    | any =>
      simp only [saxN, sqQN] at hqh hqt
      simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin]
    | «at» q2 =>
      by_cases c2 : 1 < q2 ∧ q2 % 2 = 1
      · have hq : q2 / 2 ≠ 0 := by omega
        have hq' : ¬ (0 = q2 / 2) := fun e => hq e.symm
        simp only [saxN, sqQN, c2, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c2, hq, hq']
      · simp only [saxN, sqQN, c2, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c2]
  | «at» q1 =>
    cases t with
    | no => simp [nock_exec, sqSpNo, saxN, softPair]
    | any =>
      by_cases c1 : 1 < q1 ∧ q1 % 2 = 0
      · have hq : q1 / 2 ≠ 0 := by omega
        have hq' : ¬ (0 = q1 / 2) := fun e => hq e.symm
        simp only [saxN, sqQN, c1, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1, hq, hq']
      · simp only [saxN, sqQN, c1, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1]
    | «at» q2 =>
      by_cases c1 : 1 < q1 ∧ q1 % 2 = 0 <;> by_cases c2 : 1 < q2 ∧ q2 % 2 = 1
      · have hq : q1 / 2 ≠ 0 := by omega
        have hq' : ¬ (0 = q1 / 2) := fun e => hq e.symm
        simp only [saxN, sqQN, c1, c2, and_self, if_true, if_false] at hqh hqt
        by_cases e : q1 / 2 = q2 / 2
        · simp only [e] at hqh hqt hq hq'
          simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1, c2, hq, hq', e]
        · have e' : ¬ (q2 / 2 = q1 / 2) := fun x => e x.symm
          simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1, c2, hq, hq', e, e']
      · have hq : q1 / 2 ≠ 0 := by omega
        have hq' : ¬ (0 = q1 / 2) := fun e => hq e.symm
        simp only [saxN, sqQN, c1, c2, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1, c2, hq, hq']
      · simp only [saxN, sqQN, c1, c2, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1, c2]
      · simp only [saxN, sqQN, c1, c2, and_self, if_true, if_false] at hqh hqt
        simp [nock_exec, sqSpNo, saxN, softPair, hqh, hqt, sqSpFin, c1, c2]

/-! ## `+soft-axis` -/

theorem sq_saxN_any : saxN SoftAx.any = A 0x796e61 := rfl
theorem sq_saxN_no : saxN SoftAx.no = A 0x6f6e := rfl
theorem sq_saxN_at (q : Nat) : saxN (SoftAx.at q) = C (A 0x7461) (A q) := rfl

theorem sq_sp_arm (d : Noun) : nock d sqSpArm = some (C sqSpBat (C sqSpBunt d)) := by
  unfold sqSpArm; generalize sqSpBat = B; generalize sqSpBunt = U; simp [nock_exec]

/-- **`+soft-axis` is `softAxis`**, on every need. -/
theorem sq_sx {ctx : Noun} (hc : CompIn ctx) (Dr G M : Noun) (hsp : slot? 13652 Dr = some sqSpArm)
    {axs : List (Nat × Nat)} (hM : AxsRel M axs) : ∀ ned : Need,
    nock (C sxBat (C (C ned.toNoun M) (C Dr (C G ctx)))) sxBat = some (saxN (softAxis axs ned))
  | Need.none => by
    have h := sx_none Dr G ctx M
    simp only [Need.toNoun, Tag.none, softAxis, saxN] at h ⊢
    exact h
  | Need.this r => by
    have h := sx_this hc Dr G M hM r
    simp only [Need.toNoun, Tag.this, softAxis] at h ⊢
    rw [h]
    cases axs.lookup r <;> rfl
  | Need.pair h t => by
    have ihh := sq_sx hc Dr G M hsp hM h
    have iht := sq_sx hc Dr G M hsp hM t
    have hsg := sq_sp_gate hc Dr G (softAxis axs h) (softAxis axs t)
    obtain ⟨a, b, e⟩ : ∃ a b, h.toNoun = C a b := by cases h <;> exact ⟨_, _, rfl⟩
    conv => { lhs; arg 2; unfold sxBat }
    rw [sq_sxCell_eq]
    simp only [Need.toNoun, e] at ihh ⊢
    simp [nock_exec, sqSxPair, e, hsp, sq_sp_arm, ihh, iht, hsg, softAxis, Tag.none, Tag.this]
  | Need.both r h t => by
    have ihh := sq_sx hc Dr G M hsp hM h
    have iht := sq_sx hc Dr G M hsp hM t
    have hsg := sq_sp_gate hc Dr G (softAxis axs h) (softAxis axs t)
    have hgc : SomeIn layer2 ∧ GorIn mugF layer2 := ⟨someIn_layer2, gorIn_morIn_layer2.1⟩
    conv => { lhs; arg 2; unfold sxBat }
    rw [sq_sxCell_eq]
    generalize hb : softPair (softAxis axs h) (softAxis axs t) = b at hsg
    cases hl : axs.lookup r with
    | none =>
      have hg := get_gate layer2 hgc (A r) M _ (axsRel_get_none hM hl)
      cases b <;>
      simp [nock_exec, sqSxB0, sqSxBH0, sqSxB1, sqSxBH1, sqSxB2, sqSxHint, hsp, sq_sp_arm, ihh, iht, hsg,
        softAxis, hb, hl, Need.toNoun, Tag.none, Tag.this, Tag.both, sq_saxN_any, sq_saxN_no, sq_saxN_at, hc, by_arm, by.arm_at,
        by.get.arm_at, get_arm, hg]
    | some q =>
      have hg := get_gate layer2 hgc (A r) M _ (axsRel_get_some hM hl)
      cases b with
      | «at» q' =>
        by_cases e : q' = q
        · subst e
          simp [nock_exec, sqSxB0, sqSxBH0, sqSxB1, sqSxBH1, sqSxB2, sqSxHint, hsp, sq_sp_arm, ihh, iht, hsg,
            softAxis, hb, hl, Need.toNoun, Tag.none, Tag.this, Tag.both, sq_saxN_any, sq_saxN_no, sq_saxN_at, hc, by_arm, by.arm_at,
            by.get.arm_at, get_arm, hg]
        · have e' : ¬ (q = q') := fun x => e x.symm
          simp [nock_exec, sqSxB0, sqSxBH0, sqSxB1, sqSxBH1, sqSxB2, sqSxHint, hsp, sq_sp_arm, ihh, iht, hsg,
            softAxis, hb, hl, Need.toNoun, Tag.none, Tag.this, Tag.both, sq_saxN_any, sq_saxN_no, sq_saxN_at, hc, by_arm, by.arm_at,
            by.get.arm_at, get_arm, hg, e, e']
      | _ =>
        simp [nock_exec, sqSxB0, sqSxBH0, sqSxB1, sqSxBH1, sqSxB2, sqSxHint, hsp, sq_sp_arm, ihh, iht, hsg,
          softAxis, hb, hl, Need.toNoun, Tag.none, Tag.this, Tag.both, sq_saxN_any, sq_saxN_no, sq_saxN_at, hc, by_arm, by.arm_at,
          by.get.arm_at, get_arm, hg]

end Compiler
