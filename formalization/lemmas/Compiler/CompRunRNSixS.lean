variable {ctx : Noun} {X : GenRest → Noun → Noun → Prop}

/-- The parts of `%6` against `runLCM env false msup` (`SixParts` with the
link `CompRunAtX`, the result `ResForR`, and `+past-fork` as `PastForkAt`). -/
structure SixPartsRN (env : CallEnv) (msup : Option Nomm) (ctx : Noun) (X : GenRest → Noun → Noun → Prop) (n : Nomm)
    (region : List Nat) : Prop where
  link : ∀ (goal : CGoalL CSet) (g : Gen (TreapMap mugF)), GInv g goal →
    CompRunAtX (runLCM env false msup) ctx X n goal region g
  res : ResForR (runLCM env false msup) n region
  pf : PastForkAt ctx env.cod n

/-- Phase S from `+past-fork` on, in the model. -/
noncomputable def sixPMRN (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region : List Nat) (lazy : Lazy CSet)
    (yes nuh : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let lazy ← liftO (Lazy.pastFork env.cod lazy p)
  let nexCond ← runLCM env false msup p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region
  sixTail nexCond lazy

/-- **Phase S from `+past-fork` on** (`cr6S7`): `+past-fork` over `p`, the
run of `p` for `[%pick ~^yes ~^nuh]`, and the tail (`cr6s_tail`), given the
link of `p` on that goal and what its runs return, the registers of `lazy`
below the counter and no look at axis `0` in it. -/
theorem cr6s_pRN (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (hpn : PastForkAt ctx env.cod p)
    (yes nuh : Nat)
    (hP : ∀ g' : Gen (TreapMap mugF), g'.drop = false →
      CompRunAtX (runLCM env false msup) ctx X p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g')
    (hR : ResForR (runLCM env false msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (lazy : Lazy CSet) (hlz : ∀ y ∈ lregs lazy, y < g.re) (hlok : LAll CrLok lazy)
    (mono goalN sup V6 V5 V4 V3 V2 V1 V0 : Noun) (hX : X x mono sup := by assumption) :
    nock (C (C lazy.toNoun (C (A yes) (A nuh))) (C V6 (C V5 (C V4 (C V3 (C V2 (C V1 (C V0
      (crSubj mono (Nomm.n6 p q r).toNoun goalN (listNoun A region) sup (compCore g x ctx)))))))))) cr6S7
      = (sixPMRN env msup p region lazy yes nuh g).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  have hpf := hpn (genNoun g x) lazy
  have hD1 := pf_at
  unfold sixPMRN
  simp only [compCore] at hpf ⊢
  cases e1 : Lazy.pastFork env.cod lazy p with
  | none =>
    rw [e1] at hpf
    generalize comp.door = Dr at hpf hD1 ⊢
    unfold cr6S7
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind]
  | some lazy' =>
    rw [e1] at hpf
    simp only [Option.map_some] at hpf
    have hq1 := hP g hd x mono sup hx hX
    rw [pick_noun] at hq1
    simp only [crSubj, compCore] at hq1
    cases e2 : runLCM (S := CSet) (Map := TreapMap mugF) env false msup p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g with
    | none =>
      rw [e2] at hq1
      generalize comp.door = Dr at hpf hD1 hq1 ⊢
      unfold cr6S7 cr6S8
      simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hq1, e2, cr_bat_dol]
    | some rr =>
      obtain ⟨nexCond, g'⟩ := rr
      rw [e2] at hq1
      simp only [Option.map_some] at hq1
      obtain ⟨l1, -, gi, fr⟩ := hR (CGoalL.pick (jmp0 yes) (jmp0 nuh)) g g' nexCond
        (show GInv g (CGoalL.pick (jmp0 yes) (jmp0 nuh)) from ⟨hd, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) e2
      have hf : ∀ y ∈ lregs nexCond.laz, y < g'.re := lnb_regs gi.1.1
      have hs' : ∀ y ∈ lregs lazy', y < g'.re := fun y hy => by
        rw [lregs_pastFork e1] at hy; have := hlz y hy; omega
      have ap : ∀ y ∈ lregs nexCond.laz, y ∉ lregs lazy' := fun y hy hy' => by
        rw [lregs_pastFork e1] at hy'
        have := hlz y hy'
        rcases fr y hy with h | h
        · omega
        · simp [gregs] at h
      have ht := cr6s_tail h7 x hx g' nexCond lazy' (C (A yes) (A nuh)) V6 V5 V4 V3 V2 V1 V0 crBat crB
        (C mono (C (Nomm.n6 p q r).toNoun (C goalN (C (listNoun A region) sup)))) hf hs' ap
        (lall_pastFork (fun y hy => by simp [Sure.bunt] at hy; exact absurd hy (HoonSet.mem_empty y)) e1 hlok)
      simp only [compCore, Nomm.toNoun] at ht
      generalize comp.door = Dr at hpf hD1 hq1 ht ⊢
      unfold cr6S7 cr6S8
      simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hq1, e2, cr_bat_dol, ht]

/-- Phase S under `%done` and `%pick` from the two runs on: the two `%hop`
blocks, their tags, the asserts, and the rest from `+past-fork` on. -/
noncomputable def sixLynDPRN (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region : List Nat)
    (nex0 nex1 : NextL CSet) : CM (TreapMap mugF) (NextL CSet) := do
  let yes ← emit ⟨[], [], Termin.hop nex0.th⟩
  let nuh ← emit ⟨[], [], Termin.hop nex1.th⟩
  setTag yes region
  setTag nuh region
  if nex0.th.args ≠ [] then fun _ => Option.none else
  if nex1.th.args ≠ [] then fun _ => Option.none else
  sixPMRN env msup p region (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) yes nuh

/-- **The pair of `%hop` blocks under `%done` and `%pick`** (`cr6S6`, its
non-`%next` branch, then `cr6S7`). -/
theorem cr6s_lyn_dpRN (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (hpn : PastForkAt ctx env.cod p)
    (hP : ∀ (yes nuh : Nat) (g' : Gen (TreapMap mugF)), g'.drop = false →
      CompRunAtX (runLCM env false msup) ctx X p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g')
    (hR : ResForR (runLCM env false msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (nex0 nex1 : NextL CSet) (h0 : LAll (LNB g.re) nex0.laz) (h1 : LAll (LNB g.re) nex1.laz)
    (mono grest sup cbw cb RB GG LEP : Noun) (tag : Nat) (htag : tag ≠ 0x7478656e) (hX : X x mono sup := by assumption) :
    nock (C nex0.goal.toNoun (C cbw (C nex1.goal.toNoun (C cb (C RB (C GG (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun (C (A tag) grest) (listNoun A region) sup (compCore g x ctx))))))))) cr6S6
      = (sixLynDPRN env msup p region nex0 nex1 g).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have htag' : ¬ ((0x7478656e : Nat) = tag) := fun h => htag h.symm
  obtain ⟨l0, ⟨a0, t0⟩⟩ := nex0
  obtain ⟨l1, ⟨a1, t1⟩⟩ := nex1
  simp only [NextL.goal, cgl_next_noun6]
  have he1 := cf_emit (x := x) hc g ⟨[], [], Termin.hop ⟨a0, t0⟩⟩
  generalize hg1 : cfEmitG ⟨[], [], Termin.hop ⟨a0, t0⟩⟩ g = g1 at he1
  have he2 := cf_emit (x := x) hc g1 ⟨[], [], Termin.hop ⟨a1, t1⟩⟩
  generalize hg2 : cfEmitG ⟨[], [], Termin.hop ⟨a1, t1⟩⟩ g1 = g2 at he2
  have hst1 := comp_set_tag x hc g2 g.bo region
  have hst2 := comp_set_tag x hc (stG g.bo region g2) g1.bo region
  have r1 : g1.re = g.re := by rw [← hg1, cf_emitG_re]
  have r2 : g2.re = g.re := by rw [← hg2, cf_emitG_re, r1]
  have d1 : g1.drop = false := by rw [← hg1, cf_emitG_drop]; exact hd
  have d2 : g2.drop = false := by rw [← hg2, cf_emitG_drop]; exact d1
  simp only [Blob.toNoun, listNoun, Termin.toNoun, Tag.hop, Jmp.toNoun] at he1 he2
  simp only [st_apply, Option.map_some] at hst1 hst2
  have hD1 := comp_emit_at
  have hD2 := comp_set_tag_at
  unfold sixLynDPRN
  simp only [bind_apply, cf_emit_g, hg1, hg2, Option.bind_some, st_apply]
  generalize hg4 : stG g1.bo region (stG g.bo region g2) = g4 at hst2 ⊢
  have d4 : g4.drop = false := by rw [← hg4, stG_drop, stG_drop]; exact d2
  have r4 : g4.re = g.re := by rw [← hg4, stG_re, stG_re]; exact r2
  rcases a0 with _ | ⟨a0h, a0t⟩
  · rcases a1 with _ | ⟨a1h, a1t⟩
    · simp only [listNoun] at he1 he2
      have hlz : ∀ y ∈ lregs (Lazy.mk Sure.bunt [((g.bo, l0), (g1.bo, l1))] [] : Lazy CSet), y < g4.re := by
        intro y hy
        simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
          List.mem_append] at hy
        rw [r4]
        rcases hy with hy | hy
        · exact lnb_regs h0 y hy
        · exact lnb_regs h1 y hy
      have hlok : LAll CrLok (Lazy.mk Sure.bunt [((g.bo, l0), (g1.bo, l1))] [] : Lazy CSet) :=
        ⟨fun y hy => by simp [Sure.bunt] at hy; exact absurd hy (HoonSet.mem_empty y),
          ⟨by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h0,
           by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h1, trivial⟩, trivial⟩
      have hpm := cr6s_pRN h7 hcode env msup p q r region hpn g.bo g1.bo (hP g.bo g1.bo) hR x hx g4 d4
        _ hlz hlok mono (C (A tag) grest) sup
        (C (A 0x7478656e) (C l0.toNoun (C (A 0) (A t0)))) cbw
        (C (A 0x7478656e) (C l1.toNoun (C (A 0) (A t1)))) cb RB GG LEP
      rw [lyn_lazy_noun] at hpm
      simp only [crSubj, compCore] at hpm hst1 hst2 ⊢
      generalize comp.door = Dr at he1 he2 hst1 hst2 hD1 hD2 hpm ⊢
      unfold cr6S6 cr6SA6
      simp only [Nomm.toNoun, NextL.goal] at hpm
      simp [nock_exec, htag, htag', hD1, comp_emit_arm, he1, he2, hD2, comp_set_tag_arm, hst1, hst2, hpm,
        listNoun, Nomm.toNoun, NextL.goal]
    · simp only [listNoun] at he1 he2
      simp only [crSubj, compCore] at hst1 hst2 ⊢
      generalize comp.door = Dr at he1 he2 hst1 hst2 hD1 hD2 ⊢
      unfold cr6S6 cr6SA6
      simp [nock_exec, htag, htag', hD1, comp_emit_arm, he1, he2, hD2, comp_set_tag_arm, hst1, hst2, listNoun,
        Nomm.toNoun]
  · simp only [listNoun] at he1 he2
    simp only [crSubj, compCore] at hst1 hst2 ⊢
    generalize comp.door = Dr at he1 he2 hst1 hst2 hD1 hD2 ⊢
    unfold cr6S6 cr6SA6
    simp [nock_exec, htag, htag', hD1, comp_emit_arm, he1, he2, hD2, comp_set_tag_arm, hst1, hst2, listNoun,
      Nomm.toNoun]

/-- **The two runs of the branches** (`cr6S2` to `cr6S5`): `cond-before`,
the run of `r` for `goal-1` in `region-branch`, `cond-between`, the run of
`q` for `goal-0`, then a continuation `K` from `cr6S6` on, given the links
of the two runs. -/
theorem cr6s_midRN (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (rb : List Nat)
    (goal0 goal1 : CGoalL CSet) (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF))
    (mono goalN regionN sup LEP : Noun)
    (K : TreapMap mugF (Nat × List Nat) → TreapMap mugF (Nat × List Nat) → NextL CSet → NextL CSet →
      CM (TreapMap mugF) (NextL CSet))
    (hr : CompRunAtX (runLCM env false msup) ctx X r goal1 rb g)
    (hq : ∀ nex1 g1, runLCM env false msup r goal1 rb g = some (nex1, g1) → CompRunAtX (runLCM env false msup) ctx X q goal0 rb g1)
    (hK : ∀ nex1 g1 nex0 g2, runLCM env false msup r goal1 rb g = some (nex1, g1) →
      runLCM env false msup q goal0 rb g1 = some (nex0, g2) →
      nock (C nex0.goal.toNoun (C (condN g1) (C nex1.goal.toNoun (C (condN g) (C (listNoun A rb)
        (C (C goal0.toNoun goal1.toNoun) (C LEP
          (crSubj mono (Nomm.n6 p q r).toNoun goalN regionN sup (compCore g2 x ctx))))))))) cr6S6
        = (K g.cond g1.cond nex0 nex1 g2).map fun p => C p.1.goal.toNoun (genNoun p.2 x)) (hX : X x mono sup := by assumption) :
    nock (C (listNoun A rb) (C (C goal0.toNoun goal1.toNoun) (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun goalN regionN sup (compCore g x ctx))))) cr6S2
      = ((do
          let cb ← getCond
          let nex1 ← runLCM env false msup r goal1 rb
          let cbw ← getCond
          let nex0 ← runLCM env false msup q goal0 rb
          K cb cbw nex0 nex1 : CM (TreapMap mugF) (NextL CSet)) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  have hr1 := hr x mono sup hx hX
  simp only [crSubj, compCore, genNoun] at hr1
  simp only [bind_apply, getCond, Option.bind_some]
  cases e1 : runLCM (S := CSet) (Map := TreapMap mugF) env false msup r goal1 rb g with
  | none =>
    rw [e1] at hr1
    unfold cr6S2 cr6S3
    simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, genNoun]
  | some rr =>
    obtain ⟨nex1, g1⟩ := rr
    rw [e1] at hr1
    simp only [Option.map_some] at hr1
    have hq1 := hq nex1 g1 e1 x mono sup hx hX
    simp only [crSubj, compCore, genNoun] at hq1
    cases e2 : runLCM (S := CSet) (Map := TreapMap mugF) env false msup q goal0 rb g1 with
    | none =>
      rw [e2] at hq1
      unfold cr6S2 cr6S3 cr6S4 cr6S5
      simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, hq1, genNoun, e2]
    | some rr =>
      obtain ⟨nex0, g2⟩ := rr
      rw [e2] at hq1
      simp only [Option.map_some] at hq1
      have hk := hK nex1 g1 nex0 g2 e1 e2
      simp only [crSubj, compCore, condN, genNoun, Nomm.toNoun] at hk
      unfold cr6S2 cr6S3 cr6S4 cr6S5
      simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, hq1, hk, genNoun, e2]

/-- The model of `%6` under `%done` and `%pick`, with the reads of `cond`
that phase S makes for `+sect` (they change nothing here). -/
theorem runLC_n6_dpRN (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (goal : CGoalL CSet)
    (hg : ∀ laz th, goal ≠ CGoalL.next laz th) (region : List Nat) :
    (runLCM env false msup (Nomm.n6 p q r) goal region : CM (TreapMap mugF) (NextL CSet)) = (do
      let _ ← getCond
      let nex1 ← runLCM env false msup r goal region
      let _ ← getCond
      let nex0 ← runLCM env false msup q goal region
      sixLynDPRN env msup p region nex0 nex1) := by
  funext g0
  cases goal with
  | next laz th => exact absurd rfl (hg laz th)
  | done => rfl
  | pick z o => rfl

/-- **The case `%6` of `+run` under `%done` and `%pick`**, on every state with
the invariant, given the links and results of the parts (`SixParts`) in the
region of the case (under `%done` and `%pick` the branches are compiled in
the case's own region). -/
theorem comp_run_n6_dpRN (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRN env msup ctx X p region) (Q : SixPartsRN env msup ctx X q region) (R : SixPartsRN env msup ctx X r region)
    (goal : CGoalL CSet) (hg : ∀ laz th, goal ≠ CGoalL.next laz th) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtX (runLCM env false msup) ctx X (Nomm.n6 p q r) goal region g := by
  intro x mono sup hx hX
  have hd : g.drop = false := ginv_drop hinv
  obtain ⟨tag, grest, hgn, htag⟩ : ∃ (tag : Nat) (grest : Noun), goal.toNoun = C (A tag) grest ∧ tag ≠ 0x7478656e := by
    cases goal with
    | next laz th => exact absurd rfl (hg laz th)
    | done => exact ⟨_, _, rfl, by decide⟩
    | pick z o => exact ⟨_, _, rfl, by decide⟩
  have htag' : ¬ ((0x7478656e : Nat) = tag) := fun h => htag h.symm
  rw [runLC_n6_dpRN env msup p q r goal hg region]
  have hm := cr6s_midRN (ctx := ctx) env msup p q r region goal goal x hx g mono goal.toNoun (listNoun A region) sup
    (A 0) (fun _ _ nex0 nex1 => sixLynDPRN env msup p region nex0 nex1) (R.link goal g hinv)
    (fun nex1 g1 e1 => Q.link goal g1 (by
      obtain ⟨l1, b1, gi1, -⟩ := R.res goal g g1 nex1 hinv e1
      exact ginv_mono hinv l1 b1 ((ginv_drop gi1).trans hd.symm)))
    (fun nex1 g1 nex0 g2 e1 e2 => by
      obtain ⟨l1, b1, gi1, -⟩ := R.res goal g g1 nex1 hinv e1
      have hi1 : GInv g1 goal := ginv_mono hinv l1 b1 ((ginv_drop gi1).trans hd.symm)
      obtain ⟨l2, b2, gi2, -⟩ := Q.res goal g1 g2 nex0 hi1 e2
      have d2 : g2.drop = false := ginv_drop gi2
      rw [hgn]
      exact cr6s_lyn_dpRN h7 hcode env msup p q r region P.pf
        (fun yes nuh g' hd' => P.link _ g' ⟨hd', jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) P.res x hx g2 d2 nex0 nex1
        gi2.1.1 (lnb_mono l2 0 gi1.1.1) mono grest sup (condN g1) (condN g) (listNoun A region)
        (C (C (A tag) grest) (C (A tag) grest)) (A 0) tag htag)
  rw [hgn] at hm
  rw [Nomm.toNoun, cr_disp_n6, cr6_eq, hgn]
  simp only [crSubj, compCore, Nomm.toNoun] at hm ⊢
  generalize comp.door = Dr at hm ⊢
  unfold cr6Head cr6NoLep cr6S0 cr6S1 cr6Lep cr6T2 cr6SA0 cr6SA1
  simp [nock_exec, htag', hm]

/-- **What `%6` returns under `%done` and `%pick`.** -/
theorem res_n6_dpRN {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCM env false msup) p region) (ihq : ResForR (runLCM env false msup) q region) (ihr : ResForR (runLCM env false msup) r region)
    (goal : CGoalL CSet) (hg : ∀ laz th, goal ≠ CGoalL.next laz th) (g g' : Gen (TreapMap mugF))
    (nex : NextL CSet) (hi : GInv g goal) (h : runLCM env false msup (Nomm.n6 p q r) goal region g = some (nex, g')) :
    GRes g goal g' nex := by
  have hgr : gregs goal = [] := by cases goal with
    | next laz th => exact absurd rfl (hg laz th)
    | done => rfl
    | pick z o => rfl
  have hd := ginv_drop hi
  rw [runLC_n6_dpRN env msup p q r goal hg region] at h
  obtain ⟨c0, g0, e0, h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e0
  obtain ⟨-, rfl⟩ := e0
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  obtain ⟨c1, g1', e1', h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e1'
  obtain ⟨-, rfl⟩ := e1'
  obtain ⟨nex0, g2, e2, h⟩ := bind_some h
  obtain ⟨l1, b1, gi1, s1⟩ := ihr goal g g1 nex1 hi e1
  have hi1 : GInv g1 goal := ginv_mono hi l1 b1 ((ginv_drop gi1).trans hd.symm)
  obtain ⟨l2, b2, gi2, s2⟩ := ihq goal g1 g2 nex0 hi1 e2
  have d2 : g2.drop = false := ginv_drop gi2
  unfold sixLynDPRN at h
  obtain ⟨yes, g3, e3, h⟩ := bind_some h
  rw [emit_apply] at e3
  simp only [Option.some.injEq, Prod.mk.injEq] at e3
  obtain ⟨rfl, rfl⟩ := e3
  obtain ⟨nuh, g4, e4, h⟩ := bind_some h
  rw [emit_apply] at e4
  simp only [Option.some.injEq, Prod.mk.injEq] at e4
  obtain ⟨rfl, rfl⟩ := e4
  obtain ⟨u5, g5, e5, h⟩ := bind_some h
  rw [st_apply] at e5
  simp only [Option.some.injEq, Prod.mk.injEq] at e5
  obtain ⟨-, rfl⟩ := e5
  obtain ⟨u6, g6, e6, h⟩ := bind_some h
  rw [st_apply] at e6
  simp only [Option.some.injEq, Prod.mk.injEq] at e6
  obtain ⟨-, rfl⟩ := e6
  split at h
  · cases h
  split at h
  · cases h
  -- the state after the two blocks and their tags
  generalize hG : stG (g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo region
    (stG g2.bo region ((g2.emitted ⟨[], [], Termin.hop nex0.th⟩).emitted ⟨[], [], Termin.hop nex1.th⟩)) = G at h
  have rG : G.re = g2.re := by rw [← hG, stG_re, stG_re]; rfl
  have bG : G.bo = g2.bo + 2 := by rw [← hG, stG_bo, stG_bo]; rfl
  have dG : G.drop = false := by rw [← hG, stG_drop, stG_drop]; exact d2
  unfold sixPMRN at h
  obtain ⟨lazy, g7, e7, h⟩ := bind_some h
  simp only [liftO] at e7
  cases epf : Lazy.pastFork env.cod (Lazy.mk Sure.bunt [((g2.bo, nex0.laz), ((g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo, nex1.laz))] []) p with
  | none => rw [epf] at e7; cases e7
  | some lz =>
  rw [epf] at e7
  simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at e7
  obtain ⟨rfl, rfl⟩ := e7
  obtain ⟨nexC, g8, e8, h⟩ := bind_some h
  obtain ⟨l8, b8, gi8, s8⟩ := ihp _ G g8 nexC
    (show GInv G (CGoalL.pick (jmp0 g2.bo) (jmp0 (g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo)) from
      ⟨dG, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) e8
  -- the fork of the two blocks
  have f0 : ∀ y ∈ lregs nex0.laz, g1.re ≤ y := fun y hy => by
    rcases s2 y hy with e | e
    · exact e
    · simp [hgr] at e
  have f1 : ∀ y ∈ lregs nex1.laz, g.re ≤ y := fun y hy => by
    rcases s1 y hy with e | e
    · exact e
    · simp [hgr] at e
  have lv0 : LInv G.re G.bo nex0.laz := linv_mono gi2.1 (by omega) (by omega)
  have lv1 : LInv G.re G.bo nex1.laz := linv_mono gi1.1 (by omega) (by omega)
  have ap01 : ∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz := fun y hy hy' => by
    have := f0 y hy; have := lnb_regs gi1.1.1 y hy'; omega
  have lvF := lyn_linv lv0 lv1 ap01 (yes := g2.bo) (nuh := (g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo)
    (by omega) (by simp [emitted_bo]; omega)
  have lvP : LInv G.re G.bo lz := linv_pastFork epf lvF
  have hC : LInv g8.re g8.bo nexC.laz := gi8.1
  have hP8 : LInv g8.re g8.bo lz := linv_mono lvP l8 b8
  have ap8 : (lregs nexC.laz ++ lregs lz).Nodup := by
    refine List.nodup_append.2 ⟨gi8.1.2.1, lvP.2.1, fun a ha b hb e => ?_⟩
    subst e
    have := lnb_regs lvP.1 a hb
    rcases s8 a ha with e | e
    · omega
    · simp [gregs] at e
  have d8 : g8.drop = false := ginv_drop gi8
  obtain ⟨l9, b9, gi9, s9⟩ := six_tail_res hC hP8 ap8 d8 h
  refine ⟨by omega, by omega, gi9, fun y hy => Or.inl ?_⟩
  rcases s9 y hy with e | e
  · rcases List.mem_append.1 e with e | e
    · rcases s8 y e with e' | e'
      · omega
      · simp [gregs] at e'
    · rw [lregs_pastFork epf] at e
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append] at e
      rcases e with e | e
      · have := f0 y e; omega
      · exact f1 y e
  · omega

end Compiler
