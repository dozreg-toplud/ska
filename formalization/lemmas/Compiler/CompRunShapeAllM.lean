/-!
# `+run-shape`: the induction on every constructor, threading the rest (track A, 2026-11-28)

Generated by `tools/gen/runshapet.py`: `RsClsM` is `RsClsE6` with `%11` (`rs_n11sT`, `rs_n11dT`),
`%12` (`rs_n12T`) and `%mean` (`rs_nmeanT`), each under conditions that are facts of the nomm;
`ShapeOKM` adds `MeanNeedT` (the `+callee-need` of a `%mean`, which may compile the callee) to
`ShapeOKT`.  The induction and the sweeps' call are copied from `rs_clsT6` / `rs_doneT6`.

* `runShape_nzM`, **`rs_clsTM`**, **`rs_doneTM`**.
-/

namespace Formalization
namespace Compiler

open Nock Pill Hoon SkaModel SkaModel.Comp

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

variable {ctx : Noun}

/-- **The nomms linked on every goal of `GoalNZ`, every constructor**: `RsClsE6` with `%11`, `%12`
and `%mean`, whose conditions are facts of the nomm: `SfClosed` of the hinted nomm (`+laze-past-if`),
the code entries of the subterms of `%12` and `%mean` (`CallCode`, which is `True` there), and of
`%mean` `MeanPure` (`+mean-konst`) and the totality of `+sound` on `p`. -/
def RsClsM (env : ShapeEnv) (cod : Noun) : Nomm → Prop
  | Nomm.n0 _ => True
  | Nomm.n1 _ => True
  | Nomm.n3 p => RsClsM env cod p
  | Nomm.n4 p => RsClsM env cod p
  | Nomm.n7 p q => RsClsM env cod p ∧ RsClsM env cod q
  | Nomm.cons p q => RsClsM env cod p ∧ RsClsM env cod q
  | Nomm.n5 p q => RsClsM env cod p ∧ RsClsM env cod q
  | Nomm.n10 _ v q => RsClsM env cod v ∧ RsClsM env cod q
  | Nomm.n2 p q _ => RsClsM env cod p ∧ RsClsM env cod q
  | Nomm.n6 p q r => RsClsM env cod p ∧ RsClsM env cod q ∧ RsClsM env cod r ∧ Bake.NoAx0 q ∧ Bake.NoAx0 r ∧
      (∀ ned, unsS env q r ned ≠ Option.none) ∧ (∀ laz, LzNZ laz → SixDeep q r sixFuel laz)
  | Nomm.n11s _ q _ => RsClsM env cod q ∧ SfClosed env.cod 3 q
  | Nomm.n11d _ h q _ => RsClsM env cod h ∧ RsClsM env cod q ∧ SfClosed env.cod 3 q
  | Nomm.n12 p q => RsClsM env cod p ∧ RsClsM env cod q ∧ CallCode cod (shapeCE env) p ∧
      CallCode cod (shapeCE env) q
  | Nomm.mean p b q _ k => RsClsM env cod p ∧ RsClsM env cod q ∧ SfClosed env.cod 3 q ∧
      CallCode cod (shapeCE env) p ∧ CallCode cod (shapeCE env) q ∧ MeanPure cod env b k ∧
      (∀ ned, soundS env p ned ≠ Option.none)

/-- **`ShapeOKT` on every constructor**: `ShapeCallT` at every direct call and `MeanNeedT` at every
`%mean`, at every rest of `E`, with the `sup` each runs under. -/
def ShapeOKM (ctx : Noun) (env : ShapeEnv) (E : RsRest → Prop) (Rl : RsRest → RsRest → Prop) :
    Option Nomm → Nomm → Prop
  | sup, Nomm.n2 p q (some (b, k)) =>
    (∀ y, E y → ShapeCallT ctx env E Rl p q b k sup y) ∧ ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n2 p q Option.none => ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n7 p q => ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl (some p) q
  | sup, Nomm.n6 p q r => ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q ∧ ShapeOKM ctx env E Rl sup r
  | sup, Nomm.n3 p => ShapeOKM ctx env E Rl sup p
  | sup, Nomm.n4 p => ShapeOKM ctx env E Rl sup p
  | sup, Nomm.cons p q => ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n5 p q => ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n10 _ v q => ShapeOKM ctx env E Rl sup v ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n11s _ q _ => ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n11d _ h q _ => ShapeOKM ctx env E Rl sup h ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.n12 p q => ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q
  | sup, Nomm.mean p b q _ k =>
    (∀ y, E y → MeanNeedT ctx env E Rl b k y) ∧ ShapeOKM ctx env E Rl sup p ∧ ShapeOKM ctx env E Rl sup q
  | _, _ => True

/-- **What a run of `RsClsM` returns looks at no axis `0`** when its goal does not. -/
theorem runShape_nzM (env : ShapeEnv) (cod : Noun) : ∀ (n : Nomm), RsClsM env cod n → ∀ sup (goal : GoalS CSet) st l st1,
    GoalNZ goal → runShape env sup n goal st = some (l, st1) → LzNZ l
  | Nomm.n0 a, _, sup, goal, st, l, st1, hg, e => runShape_nz env (Nomm.n0 a) trivial sup goal st l st1 hg e
  | Nomm.n1 k, _, sup, goal, st, l, st1, hg, e => runShape_nz env (Nomm.n1 k) trivial sup goal st l st1 hg e
  | Nomm.n3 p, hp, sup, goal, st, l, st1, hg, e => by
    cases goal with
    | next l0 =>
      by_cases hn : noneEq l0 = true
      · simp only [runShape, hn, if_true] at e; exact runShape_nzM env cod p hp sup _ st l st1 hg e
      · simp only [runShape, hn] at e
        exact runShape_nzM env cod p hp sup (GoalS.next thisL) st l st1 lzNZ_thisL e
    | pick =>
      simp only [runShape] at e; exact runShape_nzM env cod p hp sup (GoalS.next thisL) st l st1 lzNZ_thisL e
    | done =>
      simp only [runShape] at e; exact runShape_nzM env cod p hp sup (GoalS.next thisL) st l st1 lzNZ_thisL e
  | Nomm.n4 p, hp, sup, goal, st, l, st1, hg, e => by
    simp only [runShape] at e
    exact runShape_nzM env cod p hp sup (GoalS.next thisL) st l st1 lzNZ_thisL e
  | Nomm.n7 p q, ⟨hp, hq⟩, sup, goal, st, l, st1, hg, e => by
    simp only [runShape, bind, StateT.bind] at e
    cases e1 : runShape env (some p) q goal st with
    | none => rw [e1] at e; cases e
    | some r =>
      obtain ⟨l1, st2⟩ := r
      rw [e1] at e
      exact runShape_nzM env cod p hp sup (GoalS.next l1) st2 l st1
        (runShape_nzM env cod q hq (some p) goal st l1 st2 hg e1) e
  | Nomm.cons p q, ⟨hp, hq⟩, sup, goal, st, l, st1, hg, e => by
    have hrp : ∀ g st l st1, GoalNZ g → runShape env sup p g st = some (l, st1) → LzNZ l :=
      fun g st l st1 hg e => runShape_nzM env cod p hp sup g st l st1 hg e
    have hrq : ∀ g st l st1, GoalNZ g → runShape env sup q g st = some (l, st1) → LzNZ l :=
      fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e
    cases goal with
    | next laz =>
      simp only [runShape] at e; exact consNext_nz env _ _ p q hrp hrq laz hg st l st1 e
    | done =>
      simp only [runShape] at e; exact consNext_nz env _ _ p q hrp hrq thisL lzNZ_thisL st l st1 e
    | pick =>
      simp only [runShape] at e
      obtain ⟨l2, s1, e1, e⟩ := sm_bind_some e
      obtain ⟨l2', s2, e2, e⟩ := sm_bind_some e
      obtain ⟨l1, s3, e3, e⟩ := sm_bind_some e
      have h2 := hrq (GoalS.next noneL) _ _ _ lzNZ_noneL e1
      exact lazeCopyEnd_nz (hrp (GoalS.next noneL) _ _ _ lzNZ_noneL e3) (lazePast_nz env l2 p _ l2' s2 h2 e2) e
  | Nomm.n10 a v q, ⟨hv, hq⟩, sup, goal, st, l, st1, hg, e =>
    tenNz env a v q sup goal hg
      (fun g st l st1 hg e => runShape_nzM env cod v hv sup g st l st1 hg e)
      (fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e) st l st1 e
  | Nomm.n5 p q, ⟨hp, hq⟩, sup, goal, st, l, st1, hg, e => by
    simp only [runShape] at e
    obtain ⟨l2, s1, e1, e⟩ := sm_bind_some e
    obtain ⟨l2', s2, e2, e⟩ := sm_bind_some e
    obtain ⟨l1, s3, e3, e⟩ := sm_bind_some e
    have h2 := runShape_nzM env cod q hq sup (GoalS.next thisL) _ _ _ lzNZ_thisL e1
    exact lazeCopyEnd_nz (runShape_nzM env cod p hp sup (GoalS.next thisL) _ _ _ lzNZ_thisL e3)
      (lazePast_nz env l2 p _ l2' s2 h2 e2) e
  | Nomm.n2 p q Option.none, ⟨hp, hq⟩, sup, goal, st, l, st1, hg, e => by
    simp only [runShape] at e
    obtain ⟨l2, s1, e1, e⟩ := sm_bind_some e
    obtain ⟨l2', s2, e2, e⟩ := sm_bind_some e
    obtain ⟨l1, s3, e3, e⟩ := sm_bind_some e
    have h2 := runShape_nzM env cod q hq sup (GoalS.next thisL) _ _ _ lzNZ_thisL e1
    exact lazeCopyEnd_nz (runShape_nzM env cod p hp sup (GoalS.next thisL) _ _ _ lzNZ_thisL e3)
      (lazePast_nz env l2 p _ l2' s2 h2 e2) e
  | Nomm.n2 p q (some (b, k)), ⟨hp, hq⟩, sup, goal, st, l, st1, hg, e =>
    twoNz env p q b k sup goal
      (fun g st l st1 hg e => runShape_nzM env cod p hp sup g st l st1 hg e)
      (fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e) st l st1 e
  | Nomm.n6 p q r, ⟨hp, hq, hr, hq0, hr0, _, _⟩, sup, goal, st, l, st1, hg, e => by
    have hrp : ∀ g st l st1, GoalNZ g → runShape env sup p g st = some (l, st1) → LzNZ l :=
      fun g st l st1 hg e => runShape_nzM env cod p hp sup g st l st1 hg e
    have hrq : ∀ g st l st1, GoalNZ g → runShape env sup q g st = some (l, st1) → LzNZ l :=
      fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e
    have hrr : ∀ g st l st1, GoalNZ g → runShape env sup r g st = some (l, st1) → LzNZ l :=
      fun g st l st1 hg e => runShape_nzM env cod r hr sup g st l st1 hg e
    cases goal with
    | next laz =>
      exact sixShape_nz env _ _ _ p q r hq0 hr0 hrp hrq hrr sixFuel laz st l st1 hg e
    | done =>
      exact runShape_n6DP_nz env sup p q r GoalS.done (Or.inl rfl) (fun st l st1 e => hrp GoalS.pick st l st1 trivial e)
        (fun st l st1 e => hrq GoalS.done st l st1 trivial e) (fun st l st1 e => hrr GoalS.done st l st1 trivial e) st l st1 e
    | pick =>
      exact runShape_n6DP_nz env sup p q r GoalS.pick (Or.inr rfl) (fun st l st1 e => hrp GoalS.pick st l st1 trivial e)
        (fun st l st1 e => hrq GoalS.pick st l st1 trivial e) (fun st l st1 e => hrr GoalS.pick st l st1 trivial e) st l st1 e
  | Nomm.n11s tag q body, ⟨hq, _⟩, sup, goal, st, l, st1, hg, e =>
    elevenSNz env tag q body sup goal hg (fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e)
      st l st1 e
  | Nomm.n11d tag h q body, ⟨hh, hq, _⟩, sup, goal, st, l, st1, hg, e =>
    elevenDNz env tag h q body sup goal hg (fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e)
      (fun g st l st1 hg e => runShape_nzM env cod h hh sup g st l st1 hg e) st l st1 e
  | Nomm.n12 p q, ⟨hp, hq, _⟩, sup, goal, st, l, st1, hg, e =>
    twelveNz env p q sup goal (fun st l st1 e => runShape_nzM env cod p hp sup (GoalS.next thisL) st l st1 (lzNZ_thisL : GoalNZ (GoalS.next (thisL : Laze CSet))) e)
      (fun st l st1 e => runShape_nzM env cod q hq sup (GoalS.next thisL) st l st1 (lzNZ_thisL : GoalNZ (GoalS.next (thisL : Laze CSet))) e) st l st1 e
  | Nomm.mean p b q body k, ⟨hp, hq, _⟩, sup, goal, st, l, st1, hg, e =>
    meanNz env p b q body k sup goal hg (fun g st l st1 hg e => runShape_nzM env cod p hp sup g st l st1 hg e)
      (fun g st l st1 hg e => runShape_nzM env cod q hq sup g st l st1 hg e) st l st1 e

section
variable (hc : CompIn ctx) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
  (env : ShapeEnv) (hcn : CodeNomms env.cod cod) (E : RsRest → Prop) (Rl : RsRest → RsRest → Prop)
  (hR : RlPre Rl)
include hc h7 hcode hcn hR

/-- **The induction threading the rest, every constructor**: `rs_clsT6` with `%11`, `%12` and `%mean` (a callee compiled inside a need push moves the rest). -/
theorem rs_clsTM : ∀ (n : Nomm), RsClsM env cod n → CallCode cod (shapeCE env) n → ∀ sup, ShapeOKM ctx env E Rl sup n →
    ∀ goal st, GoalNZ goal → RsAtT ctx env E Rl n sup goal st
  | Nomm.n0 a, _, _, sup, _, goal, st, hg => rsAtT_of hR (rs_n0W hc env a sup goal st hg)
  | Nomm.n1 k, _, _, sup, _, goal, st, _ => rsAtT_of hR (rs_n1 env k sup goal st)
  | Nomm.n3 p, hp, hcc, sup, hs, goal, st, hg =>
    rs_n3T hc env hR p sup goal st (rs_clsTM p hp hcc sup hs goal st hg)
      (rs_clsTM p hp hcc sup hs (GoalS.next thisL) st lzNZ_thisL)
  | Nomm.n4 p, hp, hcc, sup, hs, goal, st, _ =>
    rs_n4T env hR p sup goal st (rs_clsTM p hp hcc sup hs (GoalS.next thisL) st lzNZ_thisL)
  | Nomm.n7 p q, ⟨hp, hq⟩, ⟨hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, hg =>
    rs_n7T env hR p q sup goal st (rs_clsTM q hq hcq (some p) hsq goal st hg)
      (fun l st1 e => rs_clsTM p hp hcp sup hsp (GoalS.next l) st1
        (runShape_nzM env cod q hq (some p) goal st l st1 hg e))
  | Nomm.cons p q, ⟨hp, hq⟩, ⟨hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, hg =>
    rs_consT hc h7 hcode env hR p q sup goal hg st hcp hcq
      (fun l st1 hl => rs_clsTM q hq hcq sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsTM p hp hcp sup hsp (GoalS.next l) st1 hl)
  | Nomm.n10 a v q, ⟨hv, hq⟩, ⟨hcv, hcq⟩, sup, ⟨hsv, hsq⟩, goal, st, hg =>
    rs_n10T hc h7 hcode env hR a v q sup goal hg st hcv hcq
      (fun l st1 hl => rs_clsTM q hq hcq sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsTM v hv hcv sup hsv (GoalS.next l) st1 hl)
  | Nomm.n5 p q, ⟨hp, hq⟩, ⟨hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, _ =>
    rs_n5T hc h7 hcode env hR p q sup goal st hcp
      (fun st1 => rs_clsTM q hq hcq sup hsq (GoalS.next thisL) st1 lzNZ_thisL)
      (fun st1 => rs_clsTM p hp hcp sup hsp (GoalS.next thisL) st1 lzNZ_thisL)
  | Nomm.n2 p q Option.none, ⟨hp, hq⟩, ⟨_, hcp, hcq⟩, sup, ⟨hsp, hsq⟩, goal, st, _ =>
    rs_n2iT hc h7 hcode env hR p q sup goal st hcp
      (fun st1 => rs_clsTM q hq hcq sup hsq (GoalS.next thisL) st1 lzNZ_thisL)
      (fun st1 => rs_clsTM p hp hcp sup hsp (GoalS.next thisL) st1 lzNZ_thisL)
  | Nomm.n2 p q (some (b, k)), ⟨hp, hq⟩, hcc, sup, ⟨hsc, hsp, hsq⟩, goal, st, _ =>
    rs_n2dT hc h7 hcode env hR hcn p q b k sup goal st hcc hsc
      (fun l st1 hl => rs_clsTM q hq hcc.2.2 sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsTM p hp hcc.2.1 sup hsp (GoalS.next l) st1 hl)
  | Nomm.n6 p q r, ⟨hp, hq, hr, hq0, hr0, hun, hdeep⟩, ⟨hcp, hcq, hcr⟩, sup, ⟨hsp, hsq, hsr⟩, goal, st, hg => by
    cases goal with
    | next laz =>
      exact rs_n6NT hc h7 hcode env hR hcn p q r sup laz hg st hcp hq0 hr0 hun (hdeep laz hg)
        (fun g st1 hg1 => rs_clsTM r hr hcr sup hsr g st1 hg1)
        (fun g st1 hg1 => rs_clsTM q hq hcq sup hsq g st1 hg1)
        (fun g st1 hg1 => rs_clsTM p hp hcp sup hsp g st1 hg1)
    | done =>
      exact rs_n6DPT hc h7 hcode env hR p q r sup GoalS.done (Or.inl rfl) st hcp
        (fun st1 => rs_clsTM r hr hcr sup hsr GoalS.done st1 trivial)
        (fun st1 => rs_clsTM q hq hcq sup hsq GoalS.done st1 trivial)
        (fun st1 => rs_clsTM p hp hcp sup hsp GoalS.pick st1 trivial)
    | pick =>
      exact rs_n6DPT hc h7 hcode env hR p q r sup GoalS.pick (Or.inr rfl) st hcp
        (fun st1 => rs_clsTM r hr hcr sup hsr GoalS.pick st1 trivial)
        (fun st1 => rs_clsTM q hq hcq sup hsq GoalS.pick st1 trivial)
        (fun st1 => rs_clsTM p hp hcp sup hsp GoalS.pick st1 trivial)
  | Nomm.n11s tag q body, ⟨hq, hsf⟩, hcq, sup, hsq, goal, st, hg =>
    rs_n11sT hc h7 hcode env hR hcn tag q body sup goal hg st hsf
      (fun st1 => rs_clsTM q hq hcq sup hsq goal st1 hg)
      (fun l st1 hl => rs_clsTM q hq hcq sup hsq (GoalS.next l) st1 hl)
  | Nomm.n11d tag h q body, ⟨hh, hq, hsf⟩, ⟨hch, hcq⟩, sup, ⟨hsh, hsq⟩, goal, st, hg =>
    rs_n11dT hc h7 hcode env hR hcn tag h q body sup goal hg st hsf hch
      (fun st1 => rs_clsTM q hq hcq sup hsq goal st1 hg)
      (fun l st1 hl => rs_clsTM q hq hcq sup hsq (GoalS.next l) st1 hl)
      (fun st1 => rs_clsTM h hh hch sup hsh (GoalS.next noneL) st1 lzNZ_noneL)
      (fun st1 => rs_clsTM h hh hch sup hsh (GoalS.next thisL) st1 lzNZ_thisL)
  | Nomm.n12 p q, ⟨hp, hq, hcp, hcq⟩, _, sup, ⟨hsp, hsq⟩, goal, st, _ =>
    rs_n12T hc h7 hcode env hR p q sup goal st hcp
      (fun st1 => rs_clsTM q hq hcq sup hsq (GoalS.next thisL) st1 lzNZ_thisL)
      (fun st1 => rs_clsTM p hp hcp sup hsp (GoalS.next thisL) st1 lzNZ_thisL)
  | Nomm.mean p b q body k, ⟨hp, hq, hsf, hcp, hcq, hmp, hsnd⟩, _, sup, ⟨hmn, hsp, hsq⟩, goal, st, hg =>
    rs_nmeanT hc h7 hcode env hR hcn p b q body k sup goal hg st hsf hcp hmp hmn hsnd
      (fun l st1 hl => rs_clsTM q hq hcq sup hsq (GoalS.next l) st1 hl)
      (fun l st1 hl => rs_clsTM p hp hcp sup hsp (GoalS.next l) st1 hl)

/-- **For track I, threading the rest**: the sweeps' call `(~(run-shape comp gen) nomm [%done ~] ~)` on
every nomm of `RsClsM env cod` whose direct calls are in the code table and read the door as
`ShapeCallT` and `MeanNeedT` say at the rests of `E`, from every state and every rest `y` of `E`, is
`runShape env none nomm GoalS.done`, with the rest `y'` of `E` that the run returns, `Rl y y'`. -/
theorem rs_doneTM (n : Nomm) (hn : RsClsM env cod n) (hcc : CallCode cod (shapeCE env) n)
    (hs : ShapeOKM ctx env E Rl Option.none n) (st : RSt CSet) (y : RsRest) (hy : E y) :
    ∃ y', Rl y y' ∧ E y' ∧
      nock (rsCoreG n.toNoun (GoalS.done : GoalS CSet).toNoun (A 0) (rsDoor st y ctx)) rsGate
        = (runShape env Option.none n GoalS.done st).map fun p => C p.1.toNoun (rsGenNoun p.2 y') :=
  rs_clsTM hc h7 hcode env hcn E Rl hR n hn hcc Option.none hs GoalS.done st trivial y hy

end

