/-- **The `%next` branch of `cr6S6`, then `cr6S7`**: the asserts that both
branch goals are `%next`, the call of `+sect` on `[nex-0 nex-1 there.then.goal-0
there.then.goal-1 region-branch cond-before cond-between]`, and the rest
from `+past-fork` on (`cr6s_pRTNG hYk`), given the links of `p` and that the needs of
the branches' results are below the counter. -/
theorem cr6s_lyn_nRTNG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region rb : List Nat)
    (hpn : PastForkAt ctx env.cod p)
    (hP : ∀ (yes nuh : Nat) (g' : Gen (TreapMap mugF)), g'.drop = false →
      CompRunAtXT (runLCMR env false msup) ctx X Y p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g')
    (hR : ResForR (runLCMR env false msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (nex0 nex1 : NextL CSet) (h0 : LAll (LNB g.re) nex0.laz) (h1 : LAll (LNB g.re) nex1.laz)
    (l0 l1 : Lazy CSet) (o0 o1 : Nat) (cb cbw : TreapMap mugF (Nat × List Nat))
    (mono grest sup LEP : Noun) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun (C (HoonMap.toNoun condValNoun cbw) (C nex1.goal.toNoun
      (C (HoonMap.toNoun condValNoun cb) (C (listNoun A rb)
      (C (C (CGoalL.next l0 (jmp0 o0)).toNoun (CGoalL.next l1 (jmp0 o1)).toNoun) (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun (C (A 0x7478656e) grest) (listNoun A region) sup
        (compCore g x ctx))))))))) cr6S6
      = (sixLynNRNG env msup p region rb o0 o1 cb cbw nex0 nex1 g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hs := comp_sect (x := x) hc nex0 nex1 o0 o1 rb cb cbw g
  have hD := sect_at
  simp only [scSmp] at hs
  unfold sixLynNRNG
  rw [bind_apply]
  cases e : sect nex0 nex1 o0 o1 rb cb cbw g with
  | none =>
    rw [e] at hs
    simp only [Option.map_none, Option.bind_none]
    rw [next_jmp0_noun, next_jmp0_noun]
    simp only [crSubj, compCore] at hs ⊢
    generalize nex0.goal.toNoun = N0 at hs ⊢
    generalize nex1.goal.toNoun = N1 at hs ⊢
    generalize comp.door = Dr at hs hD ⊢
    unfold cr6S6 cr6SA6
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, sect_arm, hs]
  | some v =>
    obtain ⟨⟨lazy, yes, nuh⟩, g'⟩ := v
    rw [e] at hs
    simp only [Option.map_some, Option.bind_some] at hs ⊢
    have hl := sect_lazy e
    obtain ⟨kr, -, kd⟩ := (km_sect nex0 nex1 o0 o1 rb cb cbw).keep _ _ _ e
    subst hl
    have hlz : ∀ y ∈ lregs (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet), y < g'.re := by
      intro y hy
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append] at hy
      rcases hy with hy | hy
      · exact Nat.lt_of_lt_of_le (lnb_regs h0 y hy) kr
      · exact Nat.lt_of_lt_of_le (lnb_regs h1 y hy) kr
    have hlok : LAll CrLok (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet) :=
      ⟨fun y hy => by simp [Sure.bunt] at hy; exact absurd hy (HoonSet.mem_empty y),
        ⟨by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h0,
         by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h1, trivial⟩, trivial⟩
    obtain ⟨x, hy1, hpm⟩ := cr6s_pRTNG hYk h7 hcode env msup p q r region hpn yes nuh (hP yes nuh) hR x hx g' (kd.trans hd)
      _ hlz hlok mono (C (A 0x7478656e) grest) sup nex0.goal.toNoun (HoonMap.toNoun condValNoun cbw)
      nex1.goal.toNoun (HoonMap.toNoun condValNoun cb) (listNoun A rb)
      (C (CGoalL.next l0 (jmp0 o0)).toNoun (CGoalL.next l1 (jmp0 o1)).toNoun) LEP
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [next_jmp0_noun, next_jmp0_noun] at hpm ⊢
    simp only [crSubj, compCore] at hs hpm ⊢
    generalize nex0.goal.toNoun = N0 at hs hpm ⊢
    generalize nex1.goal.toNoun = N1 at hs hpm ⊢
    generalize (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet).toNoun = LZ at hs hpm ⊢
    generalize comp.door = Dr at hs hD hpm ⊢
    unfold cr6S6 cr6SA6
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, sect_arm, hs, hpm]

/-- **The case `%6` of `+run` under a fork-free `%next` goal** (no fork, no
bond: phase S), on every state with the invariant, given the links and
results of the parts (`SixParts`): the test `p` in the case's region, the
branches `q` and `r` in every region `rid :: region` (they run in the
region of the fork). -/
theorem comp_run_n6_nfRTNG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTNG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTNG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTNG env msup ctx X Y r (rid :: region))
    (s : Sure CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next (Lazy.mk s [] []) th)) :
    CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hd : g.drop = false := ginv_drop hinv
  have hl0 : CrLok s := hinv.1.1.1.1
  rw [cr6s_head_nf h7, runLC_n6_nfRNG]
  refine cr6s_s01T hYk hc p q r s th region x g mono sup (sixNfKRNG env msup p q r region) (fun s0 s1 g3 ef => ?_)
  obtain ⟨-, -, d3, lk0, lk1, D0, D1, -, fr⟩ := forkSure_inv ef
  have dI : (idG g3).drop = false := d3.trans hd
  have gi1 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) :=
    ginv_ofSure (fun y hy => hl0 y (lk1 ▸ hy)) (fun y hy => (fr y (Or.inr hy)).2) D1 dI
  have gi0 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_ofSure (fun y hy => hl0 y (lk0 ▸ hy)) (fun y hy => (fr y (Or.inl hy)).2) D0 dI
  exact xt_trans hYk hY0 (cr6s_midRTNG hYk (ctx := ctx) env msup p q r (g3.id :: region) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo))
    (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) x hx (idG g3) mono
    (CGoalL.next (Lazy.mk s [] []) th).toNoun (listNoun A region) sup (A 0)
    (fun cb cbw nex0 nex1 => sixLynNRNG env msup p region (g3.id :: region) g.bo (g.bo + 1) cb cbw nex0 nex1)
    ((R g3.id).link _ _ gi1)
    (fun nex1 g1 e1 => (Q g3.id).link _ g1 (by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      exact ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)))
    (fun nex1 g1 nex0 g2 e1 e2 x hx hX => by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      have hi0 := ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)
      obtain ⟨l2, -, gi2, -⟩ := (Q g3.id).res _ g1 g2 nex0 hi0 e2
      exact cr6s_lyn_nRTNG hYk h7 hcode env msup p q r region (g3.id :: region) P.pf
        (fun yes nuh g' hd' => P.link _ g' ⟨hd', jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) P.res x hx g2 (ginv_drop gi2)
        nex0 nex1 gi2.1.1 (lnb_mono l2 0 gi1'.1.1) (Lazy.ofSure s0) (Lazy.ofSure s1) g.bo (g.bo + 1)
        (idG g3).cond g1.cond mono (C (Lazy.mk s [] []).toNoun th.toNoun) sup (A 0)))

/-- **Phase K** (`cr6K0`, `cr6K1`): `+kerf` of the goal (`comp_kerf_all`),
the state put back, then `$` again on the goal `[%next (lazy-from-need
this+pro) ~ out]`, given the link of that run. -/
theorem cr6k_eqRTNG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (laz : Lazy CSet) (th : Jmp) (region : List Nat) (x : GenRest) (g : Gen (TreapMap mugF))
    (mono sup LEP : Noun) (hP : WalkP (mdP x) g.bo laz)
    (hK : ∀ out pro g', kerf ⟨laz, th⟩ g = some ((out, pro), g') →
      ∃ x', Y x x' ∧ nock (crSubj mono (Nomm.n6 p q r).toNoun
        (CGoalL.next (Lazy.ofSure (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet)) (jmp0 out)).toNoun
          (listNoun A region) sup
        (compCore g' x ctx)) crDol
      = (runLCMR (S := CSet) env false msup (Nomm.n6 p q r)
          (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region g').map
          fun p => C p.1.goal.toNoun (genNoun p.2 x')) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C LEP (crSubj mono (Nomm.n6 p q r).toNoun (CGoalL.next laz th).toNoun (listNoun A region) sup
      (compCore g x ctx))) cr6K0
      = ((do
          let (out, pro) ← kerf ⟨laz, th⟩
          runLCMR env false msup (Nomm.n6 p q r)
            (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region :
            CM (TreapMap mugF) (NextL CSet)) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, hl, hm⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  have hkf := comp_kerf_all hc hl hm x g ⟨laz, th⟩ hP
  have hD := comp_kerf_at
  simp only [compCore] at hkf
  rw [bind_apply]
  cases ek : kerf ⟨laz, th⟩ g with
  | none =>
    rw [ek] at hkf
    simp only [Option.bind_none, Option.map_none]
    simp only [crSubj, compCore, CGoalL.toNoun] at hkf ⊢
    generalize comp.door = Dr at hD hkf ⊢
    unfold cr6K0
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, comp_kerf_arm, hkf]
  | some v =>
    obtain ⟨⟨out, pro⟩, g'⟩ := v
    rw [ek] at hkf
    obtain ⟨xK1, hy1, hr⟩ := hK out pro g' ek
    have hY0K1 := hYk.trans hY0 hy1
    rw [goalK_noun] at hr
    simp only [Option.bind_some, Option.map_some] at hkf ⊢
    simp only [crSubj, compCore, CGoalL.toNoun] at hkf hr ⊢
    generalize comp.door = Dr at hD hkf hr ⊢
    unfold cr6K0 cr6K1
    refine ⟨xK1, hY0K1, ?_⟩
    simp [nock_exec, hD, comp_kerf_arm, hkf, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hr]

/-- **The case `%6` of `+run` in phase K**: under a `%next` goal with
`GInv` whose `+leap` is `~` (`hlp`, in the model; the Nock of `+leap` is the
model's by `lp6_leap_none`, for `q` and `r` with no axis `0`, `hq`, `hr`),
whose need with the bunt sure is not `+none-equivalent` and whose `+kerf`
test holds, given the parts (`SixParts`, the branches in the regions
`rid :: region`): `+kerf`, then phase S on the fork-free goal
(`comp_run_n6_nfRTNG hYk`). -/
theorem comp_run_n6_kRTNG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTNG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTNG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTNG env msup ctx X Y r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (hlp : leap laz q r = some Option.none) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = true) :
    CompRunAtXT (runLCMR env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hd := ginv_drop hinv
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  rw [cr6k_head h7 p q r laz th region x hx g mono sup (lp6_leap_none h7 hl hq hr g hlp x hx) hne hkt,
    runLC_n6_kRNG env msup p q r laz th region hlp hne hkt]
  exact xt_trans hYk hY0 (cr6k_eqRTNG hYk h7 env msup p q r laz th region x g mono sup (A 0) (walk_mdP hx _ hl)
    (fun out pro g' ek => comp_run_n6_nfRTNG hYk h7 hcode env msup p q r region P Q R ⟨Need.this pro, HoonSet.empty⟩
      (jmp0 out) g' (ginv_kerf ek hd) x mono sup hx hX))

