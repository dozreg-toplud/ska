    (htw : LeapTwice laz q r)
    (hRe : CompRunAtXT (runLCM env false msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next rest th) region g)
    (hReR : ∀ nex g', runLCM env false msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
