/-! ## The model -/

/-- The model of `%12` from `+kerf` on. -/
noncomputable def c12KfM (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) (p q : Nomm)
    (region : List Nat) (nex : NextL CSet) : CM (TreapMap mugF) (NextL CSet) := do
  let (out, pro) ← kerf nex
  let rPath ← re
  let rRef ← re
  let o ← emit ⟨[], [Pole.spy rRef rPath pro], Termin.hop (jmp0 out)⟩
  let nexF ← runLCH env snd true msup q (CGoal.toL (CGoal.next (lazyReg rPath) (jmp0 o))) region
  let nexF ← pastL env.cod nexF p region
  let nexS ← runLCH env snd true msup p (CGoal.toL (CGoal.next (lazyReg rRef) nexF.th)) region
  copyL nexS nexF.laz

theorem runLCH_n12 (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (goal : CGoalL CSet) :
    (runLCH env snd true msup (Nomm.n12 p q) goal region : CM (TreapMap mugF) (NextL CSet)) =
      simpleNextL goal >>= c12KfM env snd msup p q region := by
  rfl

/-! ## The tail -/

/-- **The tail of `%12`**: `q` under `r-path` into the `%spy` block `o`,
`+past` over `p`, `p` under `r-ref` with the `then` of `q`'s `+past`,
`+copy`. -/
theorem c12_tail (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (hpn : PastAt ctx env.cod p)
    (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup nexN : Noun) (out pro rPath rRef o : Nat)
    (g1 : Gen (TreapMap mugF))
    (hq : CompRunAtX (runLCH env snd true msup) ctx X q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rPath) (jmp0 o))) region g1)
    (hp : ∀ nexF g2 nexF' g3, runLCH env snd true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rPath) (jmp0 o))) region g1
      = some (nexF, g2) → pastL env.cod nexF p region g2 = some (nexF', g3) →
      CompRunAtX (runLCH env snd true msup) ctx X p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rRef) nexF'.th)) region g3)
    (hcp : ∀ nexF g2 nexF' g3 nexS g4, runLCH env snd true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rPath) (jmp0 o)))
      region g1 = some (nexF, g2) → pastL env.cod nexF p region g2 = some (nexF', g3) →
      runLCH env snd true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rRef) nexF'.th)) region g3 = some (nexS, g4) →
      CopyH g4.re nexS.laz nexF'.laz) (hX : X x mono sup) :
    nock (C (A o) (C (A rRef) (C (A rPath) (C (C (A out) (A pro)) (C nexN
      (crSubj mono (Nomm.n12 p q).toNoun goalN (listNoun A region) sup (compCore g1 x ctx))))))) c12Tail
      = ((do
          let nexF ← runLCH env snd true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) rPath) (jmp0 o))) region
          let nexF ← pastL env.cod nexF p region
          let nexS ← runLCH env snd true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) rRef) nexF.th)) region
          copyL nexS nexF.laz : CM (TreapMap mugF) (NextL CSet)) g1).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  have h15 := cr_ctx15 h7
  have hq1 := hq x mono sup hx hX
  rw [cr_goal_reg] at hq1
  simp only [crSubj, compCore] at hq1
  have hD1 := cr_past_at
  have hD2 := comp_cp_at
  simp only [compCore]
  cases eq : runLCH (S := CSet) (Map := TreapMap mugF) env snd true msup q (CGoal.toL (CGoal.next (lazyReg rPath) (jmp0 o)))
      region g1 with
  | none =>
    rw [eq] at hq1
    generalize comp.door = Dr at hq1 hD1 hD2 ⊢
    nock_open c12Tail
    simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, cr_bat_dol, hq1, bind,
      StateT.bind, eq]
  | some r =>
    obtain ⟨nexF, g2⟩ := r
    rw [eq] at hq1
    simp only [Option.map_some, cr_next_nounL] at hq1
    have hpa := hpn x g2 nexF region
    simp only [cr_next_nounL, compCore] at hpa
    cases e3 : pastL (S := CSet) (Map := TreapMap mugF) env.cod nexF p region g2 with
    | none =>
      rw [e3] at hpa
      generalize comp.door = Dr at hq1 hD1 hD2 hpa ⊢
      unfold c12Tail c12T2 c12T3
      simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, cr_bat_dol, hq1, bind,
        StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, eq, e3]
    | some r3 =>
      obtain ⟨nexF', g3⟩ := r3
      rw [e3] at hpa
      simp only [Option.map_some, cr_next_nounL] at hpa
      have hp1 := hp nexF g2 nexF' g3 eq e3 x mono sup hx hX
      rw [cr_goal_reg'] at hp1
      simp only [crSubj, compCore] at hp1
      cases eq2 : runLCH (S := CSet) (Map := TreapMap mugF) env snd true msup p (CGoal.toL (CGoal.next (lazyReg rRef) nexF'.th))
          region g3 with
      | none =>
        rw [eq2] at hp1
        generalize comp.door = Dr at hq1 hD1 hD2 hpa hp1 ⊢
        unfold c12Tail c12T2 c12T3
        simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, cr_bat_dol, hq1, bind,
          StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, hp1, eq2, eq, e3]
      | some r' =>
        obtain ⟨nexS, g4⟩ := r'
        rw [eq2] at hp1
        simp only [Option.map_some, cr_next_nounL] at hp1
        have hcpy := comp_copy_all h7 x g4 nexS nexF'.laz (hcp nexF g2 nexF' g3 nexS g4 eq e3 eq2)
        simp only [compCore, cr_next_nounL] at hcpy
        generalize comp.door = Dr at hq1 hD1 hD2 hpa hp1 hcpy ⊢
        unfold c12Tail c12T2 c12T3
        simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, cr_bat_dol, hq1, bind,
          StateT.bind, h7, hcode, hD1, cr_past_arm, hpa, hp1, eq2, hD2, cr_cp_arm, hcpy, eq, e3, cr_next_nounL,
          Function.comp_def]

