/-- The noun of `[12 p q]`. -/
theorem c12_noun (p q : Nomm) : (Nomm.n12 p q).toNoun = C (A 12) (C p.toNoun q.toNoun) := rfl

/-- The dispatch: `crDol` on `[12 t]` is `crLast`. -/
theorem cr_disp_n12 (t mono goal region sup D : Noun) :
    nock (crSubj mono (C (A 12) t) goal region sup D) crDol
      = nock (crSubj mono (C (A 12) t) goal region sup D) crLast := by
  nock_open crDol
  simp [nock_exec, crSubj, crTc, crT]

/-- The clue of the hint returns: `crLast` on `[12 P Q]` is its body. -/
theorem c12_head (P Q mono goal region sup D : Noun) :
    nock (crSubj mono (C (A 12) (C P Q)) goal region sup D) crLast
      = nock (crSubj mono (C (A 12) (C P Q)) goal region sup D) c12Ind := by
  rw [c12_eq]
  unfold c12Head c12Clue
  simp [nock_exec, crSubj]

