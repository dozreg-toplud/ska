/-- The environment of a member compile on the state `st` of the final pass, for `cfgRealS2`. -/
noncomputable def envDoneS2 (r : RealCfg) (snd : Nomm → NeedOrd → Bool) (order : List Noun) (kids : Noun → List Noun)
    (st : St Noun NeedOrd) : CallEnv :=
  envView r.env r.scc (viewN (fun _ => NeedOrd.none) st) (viewS (cfgRealS2 r snd order kids) st)

/-- **`memDoneMS2` from the pieces of the run.** -/
theorem memDoneMS2_eqP (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (nm : Nomm) (cape : Cape) (DATA : Noun)
    (fuel : Nat) (nex : NextL CSet) (g1 : GenSf (TreapMap mugF))
    (hrunL : runLCS2 env snd Option.none nm (CGoalL.done : CGoalL CSet) [] (GenSf.ofGen gen0) = some (nex, g1))
    (hargs : nex.th.args = []) (ord : NeedOrd) (hcol : shapeCol fuel nex.laz cape = some ord) (nedF : Need)
    (g2 : Gen (TreapMap mugF)) (hnoar : needOrdAllocRegs ord g1.g = some (nedF, g2)) (sur : NeedOrd)
    (hsur : sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur) :
    memDoneMS2 env snd ⟨nm, cape, DATA, fuel⟩ = some ⟨needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1, sur⟩ := by
  simp [memDoneMS2, hrunL, hargs, hcol, hnoar, hsur]

/-- `+compile-scc-in`'s `%done` compile on the fixed model, from its pieces. -/
theorem compRealS2_done (r : RealCfg) (snd : Nomm → NeedOrd → Bool) (b : Noun) (vn vs : Noun → NeedOrd)
    (o : Out NeedOrd) (h : memDoneMS2 (envView r.env r.scc vn vs) snd (r.info b) = some o) :
    compRealS2 r snd b Mode.done vn vs = o := by
  simp [compRealS2, h]

/-- **The pill's `finish` gate on the fixed model, tries allowed** (the named hypothesis):
`fin_gate_finishLFCS_BC` on the fixed model (the run `runLCS2`, the straight `finishLFCS2`), and
no `hreq`. -/
def FinGateS2 (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (ctx : Noun) : Prop :=
  ∀ (c2 c6 c14 NEWN SUR REST G0 : Noun) (less : Cape), slot? 6 REST = some (C comp.door (C G0 ctx)) →
    slot? 14 REST = some (A 0) → slot? 496 REST = some less.toNoun → slot? 0x3ffffff REST = some layer2 →
    ∀ (x : GenRest) (nm : Nomm) (ord : NeedOrd) (nex : NextL CSet) (g1 : GenSf (TreapMap mugF))
      (g2 : Gen (TreapMap mugF)) (nedF : Need) (know : Sock), x.soft = softMapNoun g1.soft →
    runLCS2 (S := CSet) (Map := TreapMap mugF) env snd Option.none nm (CGoalL.done : CGoalL CSet) []
      (GenSf.ofGen gen0) = some (nex, g1) →
    nex.th.args = [] → needOrdAllocRegs ord g1.g = some (nedF, g2) →
    isRun (flattenNeed (bakeNeed nedF know).1) ((flattenNeed (bakeNeed nedF know).1).headD 0) 0 = true →
    nock (C finBody (C (A 0) (finCtx c2 c6 c14 NEWN nex.laz.toNoun nedF.toNoun (bakeNeed nedF know).1.toNoun
        (immNoun (bakeNeed nedF know).2) nex.th.there SUR (genNoun g2 x) REST))) finBody
      = (finishLFCS2 (S := CSet) (Map := TreapMap mugF) env snd TreapMap.tap nm ord less
          (fun n => bakeNeed n know)).map Straight.toNoun

/-- **The straight of `finishLFCS2` has the need `need-new`.** -/
theorem finishLFCS2_need (env : CallEnv) (snd : Nomm → NeedOrd → Bool)
    (tapS : TreapMap mugF SoftCall → List (Nat × SoftCall)) (nm : Nomm) (ord : NeedOrd) (less : Cape)
    (bake : Need → Need × List (Nat × Noun)) (nex : NextL CSet) (g1 : GenSf (TreapMap mugF))
    (hrunL : runLCS2 env snd Option.none nm (CGoalL.done : CGoalL CSet) [] (GenSf.ofGen gen0) = some (nex, g1))
    (nedF : Need) (g2 : Gen (TreapMap mugF)) (hnoar : needOrdAllocRegs ord g1.g = some (nedF, g2))
    (s : Straight (TreapMap mugF))
    (h : finishLFCS2 (S := CSet) (Map := TreapMap mugF) env snd tapS nm ord less bake = some s) :
    s.need = needToOrd (bake nedF).1 := by
  unfold finishLFCS2 at h
  rw [hrunL] at h
  simp only [Option.bind_some] at h
  by_cases ha : nex.th.args ≠ []
  · simp [ha] at h
  · simp only [ha, if_false, hnoar, Option.bind_some] at h
    cases e1 : coerceLazyLS nedF less nex.th.there nex.laz ⟨g2, g1.soft⟩ with
    | none => simp [e1] at h
    | some r1 =>
      simp only [e1, Option.bind_some] at h
      cases e2 : softDone2 tapS r1.2 with
      | none => simp [e2] at h
      | some g3 =>
        simp only [e2, Option.bind_some] at h
        cases e3 : addOps nex.th.there ((bake nedF).2.map fun (r, v) => Pole.imm v r) g3 with
        | none => simp [e3] at h
        | some r2 =>
          simp only [e3, Option.bind_some] at h
          exact toStraightF_need _ _ _ _ s h

/-- **The product of `member` on `%done` with soft calls**: `mem_gate_done_R` with the run
`runLCS2 env snd ~` and the gate `FinGateS2`. -/
theorem mem_gate_done_RS2 (cape : Cape) (DATA FOL : Noun) (keep : Bool)
    (ML CACHE DN KIDS ML0 CB SCC CODE LSR JH CACHE0 : Noun)
    (nm : Nomm) (CA1 : Noun)
    (hinl : nock (C inlBody (C (C (C (C cape.toNoun DATA) FOL) (C (C CODE LSR) (C JH CACHE))) compK)) inlBody
      = some (C nm.toNoun CA1))
    (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (nex : NextL CSet) (g1 : GenSf (TreapMap mugF))
    (hrunL : runLCS2 env snd Option.none nm (CGoalL.done : CGoalL CSet) [] (GenSf.ofGen gen0) = some (nex, g1))
    (x1 : GenRest)
    (hrunN : nock (crSubj (A 1) nm.toNoun (C (A 0x656e6f64) (A 0)) (A 0) (A 0)
        (compCore genEntry (cuRest CA1) (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)))) crDol
      = some (C nex.goal.toNoun (genNoun g1.g x1)))
    (C1 C2 C3 C4 SURE : Noun) (hx1 : x1.cache = cacheN C1 C2 C3 C4 SURE) (hs1 : x1.soft = softMapNoun g1.soft)
    (ord : NeedOrd) (hsc : nock (C scBody (C (C nex.laz.toNoun cape.toNoun) compK)) scBody = some ord.toNoun)
    (hargs : nex.th.args = []) (nedF : Need) (g2 : Gen (TreapMap mugF))
    (hnoar : needOrdAllocRegs ord g1.g = some (nedF, g2))
    (hrun : isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
      ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true)
    (hfin2 : FinGateS2 env snd (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)))
    (sur : NeedOrd) (hsur : sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur)
    (WAS SURE' : Noun) (hwas : getF mugF (C (C cape.toNoun DATA) FOL) SURE = some WAS)
    (hw : WAS = A 0 ∨ ∃ u, WAS = C (A 0) u)
    (hput : putF mugF (C (C cape.toNoun DATA) FOL) (memSurKN keep WAS sur.toNoun) SURE = some SURE')
    (hml : IsMap mugF ML) :
    (getF mugF (C (C cape.toNoun DATA) FOL) ML = some (A 0) →
      nock (C memBody (C (memSam (C (C cape.toNoun DATA) FOL) (A 0x656e6f64) (loob keep) ML (A 0) CACHE)
          (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0))) memBody
        = (finishLFCS2 (S := CSet) (Map := TreapMap mugF) env snd TreapMap.tap nm ord cape
            (fun n => bakeNeed n (Sock.mk cape DATA))).bind fun st =>
            (putF mugF (C (C cape.toNoun DATA) FOL) st.toNoun ML).map fun ML' =>
              C (memChgN (memMovedN keep WAS sur.toNoun) (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun)
                (C ML' (cacheN C1 C2 C3 C4 SURE'))) ∧
    (∀ (prev : NeedOrd) (REST : Noun),
      getF mugF (C (C cape.toNoun DATA) FOL) ML = some (C (A 0) (C prev.toNoun REST)) →
      nock (C memBody (C (memSam (C (C cape.toNoun DATA) FOL) (A 0x656e6f64) (loob keep) ML (A 0) CACHE)
          (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0))) memBody
        = (if (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun
              = (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun then
            (finishLFCS2 (S := CSet) (Map := TreapMap mugF) env snd TreapMap.tap nm ord cape
              (fun n => bakeNeed n (Sock.mk cape DATA))).map Straight.toNoun
          else nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
            (memFCR keep WAS sur.toNoun
              (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
              (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
              nex.th.there (genNoun g2 x1) nm.toNoun
              (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)) (C (C cape.toNoun DATA) FOL) ML
              (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody).bind
          fun ST => (putF mugF (C (C cape.toNoun DATA) FOL) ST ML).map fun ML' =>
            C (memChgO (memMovedN keep WAS sur.toNoun)
                (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun prev.toNoun)
              (C ML' (cacheN C1 C2 C3 C4 SURE'))) := by
  have hto := mem_to_finish_R cape DATA FOL keep ML (A 0) CACHE DN KIDS ML0 CB SCC CODE LSR JH CACHE0 nm CA1 hinl
    nex g1.g x1 hrunN C1 C2 C3 C4 SURE hx1 ord hsc hargs nedF g2 hnoar sur hsur WAS SURE' hwas hw hput
  have hmv : memMovedN keep WAS sur.toNoun = A 0 ∨ memMovedN keep WAS sur.toNoun = A 1 := by
    unfold memMovedN; split <;> simp
  obtain ⟨hs6, hs14, hs496, hl2⟩ := mem_rest_slots nm.toNoun SCC (C CODE LSR) JH ML (A 0) cape.toNoun DATA FOL
    (loob keep) (cacheN C1 C2 C3 C4 SURE') DN KIDS ML0 CB CACHE0
  have hf := hfin2
    (memMovedN keep WAS sur.toNoun) (memSurKN keep WAS sur.toNoun) WAS
    (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun
    sur.toNoun _ cuBunt cape hs6 hs14 hs496 hl2 x1 nm ord nex g1 g2
    nedF (Sock.mk cape DATA) hs1 hrunL hargs hnoar hrun
  refine ⟨fun hnone => ?_, fun prev REST hprev => ?_⟩
  · have hnn : ∃ p q, (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun = C p q := nord_cell _
    rw [hto]
    unfold memFCR memFCB
    rw [mem_prod_newM (hmv := hmv) (hnn := hnn) (hml := hml) (hnone := hnone)]
    try unfold memFCR memFCB at hf
    rw [hf, Option.bind_map]
    rfl
  · have hmsg := msg_gate_K (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape
    unfold msgS at hmsg
    rw [hto]
    unfold memFCR memFCB
    rw [mem_prod_oldM (hmv := hmv) (hml := hml) (hprev := hprev) (hmsg := hmsg)]
    by_cases hnp : (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun
        = (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun
    · rw [if_pos hnp, if_pos hnp]
      try unfold memFCR memFCB at hf
      rw [hf]
    · rw [if_neg hnp, if_neg hnp]

theorem mem_done_stepS2 (r : RealCfg) (snd : Nomm → NeedOrd → Bool) (order : List Noun) (kids : Noun → List Noun)
    (outC : Noun → List Noun) (nout : Noun → NeedOrd) (envK : CallEnv) (RR : GenRest → Prop) (P : Noun → Prop)
    (S : Noun) (x : GenRest)
    (hRR : ∀ NR MO SC INL SU SU' s f : Noun, RR ⟨cacheN NR MO SC INL SU, s, f⟩ → RR ⟨cacheN NR MO SC INL SU', s, f⟩)
    (st : St Noun NeedOrd) (keep : Bool) (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat)
    (hinfo : r.info (C (C cape.toNoun DATA) FOL) = ⟨nm, cape, DATA, fuel⟩)
    (hbr : C (C cape.toNoun DATA) FOL ∈ r.scc) (hbS : C (C cape.toNoun DATA) FOL ∈ tapList S)
    (hxS : ∀ N u, slot? 31 x.cache = some N → getF mugF (C (C cape.toNoun DATA) FOL) N ≠ some (C (A 0) u))
    (ML CACHE DN KIDS ML0 CB SCC CODE LSR JH CACHE0 : Noun)
    (hR : LoopRS r.scc outC nout (QK envK RR P S x) st.ml st.sure ML CACHE)
    (CA1 : Noun)
    (hinl : nock (C inlBody (C (C (C (C cape.toNoun DATA) FOL) (C (C CODE LSR) (C JH CACHE))) compK)) inlBody
      = some (C nm.toNoun CA1))
    (nex : NextL CSet) (g1 : GenSf (TreapMap mugF))
    (hrunL : runLCS2 (envView r.env r.scc (viewN (fun _ => NeedOrd.none) st) (viewS (cfgRealS2 r snd order kids) st))
      snd Option.none nm (CGoalL.done : CGoalL CSet) [] (GenSf.ofGen gen0) = some (nex, g1))
    (x1 : GenRest)
    (hrunN : nock (crSubj (A 1) nm.toNoun (C (A 0x656e6f64) (A 0)) (A 0) (A 0)
        (compCore genEntry (cuRest CA1) (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)))) crDol
      = some (C nex.goal.toNoun (genNoun g1.g x1)))
    (C1 C2 C3 C4 SURE : Noun) (hx1 : x1.cache = cacheN C1 C2 C3 C4 SURE) (hs1 : x1.soft = softMapNoun g1.soft)
    (hQ1 : QK envK RR P S x (cacheN C1 C2 C3 C4 SURE))
    (hsh1 : SureHolds r.scc st.sure (cacheN C1 C2 C3 C4 SURE))
    (hout1 : ∀ b', ((st.ml b').isSome ∨ b' = C (C cape.toNoun DATA) FOL) → ∀ k ∈ outC b', ∃ NR u,
      slot? 2 (cacheN C1 C2 C3 C4 SURE) = some NR ∧ getF mugF k NR = some (C (A 0) u) ∧ slot? 2 u = some (nout k).toNoun)
    (ord : NeedOrd) (hcol : shapeCol fuel nex.laz cape = some ord)
    (hargs : nex.th.args = []) (nedF : Need) (g2 : Gen (TreapMap mugF))
    (hnoar : needOrdAllocRegs ord g1.g = some (nedF, g2))
    (hrun : isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
      ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true)
    (hfin2 : FinGateS2 (envView r.env r.scc (viewN (fun _ => NeedOrd.none) st) (viewS (cfgRealS2 r snd order kids) st))
      snd (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)))
    (sur : NeedOrd) (hsur : sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur)
    (hfin : ∃ s, finishLFCS2 (S := CSet) (Map := TreapMap mugF)
      (envView r.env r.scc (viewN (fun _ => NeedOrd.none) st) (viewS (cfgRealS2 r snd order kids) st)) snd
        TreapMap.tap nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s)
    (hcs : ∀ (prev : NeedOrd) (SURE' : Noun), st.ml (C (C cape.toNoun DATA) FOL) = some prev →
      msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
      ∃ t, (∃ s : Straight (TreapMap mugF), C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t = s.toNoun) ∧ nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
            (memFCR keep (wasN (st.sure (C (C cape.toNoun DATA) FOL))) sur.toNoun
              (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
              (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
              nex.th.there (genNoun g2 x1) nm.toNoun
              (memDCtx SCC (C CODE LSR) JH ML (A 0) (C (C cape.toNoun DATA) FOL)) (C (C cape.toNoun DATA) FOL) ML
              (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
        = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)) :
    ∃ ML' CA', nock (C memBody (C (memSam (C (C cape.toNoun DATA) FOL) (A 0x656e6f64) (loob keep) ML (A 0) CACHE)
        (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0))) memBody
        = some (C (loob (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none)
            (C (C cape.toNoun DATA) FOL) Mode.done keep st).1) (C ML' CA')) ∧
      LoopRS r.scc outC nout (QK envK RR P S x)
        (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) (C (C cape.toNoun DATA) FOL) Mode.done keep st).2.ml
        (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) (C (C cape.toNoun DATA) FOL) Mode.done keep st).2.sure
        ML' CA' := by
  obtain ⟨hR, hRS⟩ := hR
  generalize hB : C (C cape.toNoun DATA) FOL = B at *
  -- the model's compile
  have ho : compRealS2 r snd B Mode.done (viewN (fun _ => NeedOrd.none) st) (viewS (cfgRealS2 r snd order kids) st)
      = ⟨needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1, sur⟩ :=
    compRealS2_done r snd B _ _ _ (by rw [hinfo]; exact memDoneMS2_eqP _ snd nm cape DATA fuel nex g1 hrunL hargs ord hcol nedF g2 hnoar sur hsur)
  have hnone0 : (cfgRealS2 r snd order kids).none = NeedOrd.none := rfl
  have hcomp : (cfgRealS2 r snd order kids).comp B Mode.done (viewN (fun _ => NeedOrd.none) st) (viewS (cfgRealS2 r snd order kids) st)
      = ⟨needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1, sur⟩ := ho
  generalize hNN : needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 = nn at *
  -- `sure.cache` at `b`
  have hmS : IsMap mugF SURE := qK_map hQ1
  have hwas := sureHolds_was hsh1 hbr
  obtain ⟨SURE', hput, -, -⟩ := putF_spec mugF SURE B (memSurKN keep (wasN (st.sure B)) sur.toNoun) hmS
  have hput' := hput
  rw [memSurKN_was] at hput'
  have hQ' := (csQK_put hRR hQ1 hput' hbS hxS).1
  have hSH' := csSureHolds_put hsh1 hmS hput'
  have hml := hR.1.1
  have hg := mem_gate_done_RS2 cape DATA FOL keep ML CACHE DN KIDS ML0 CB SCC CODE LSR JH CACHE0 nm CA1
    (by rw [hB]; exact hinl) _ snd nex g1 hrunL x1 (by rw [hB]; exact hrunN) C1 C2 C3 C4 SURE hx1 hs1 ord
    (sc_gate _ _ _ _ hcol) hargs nedF g2 hnoar hrun (by rw [hB]; exact hfin2) sur hsur (wasN (st.sure B)) SURE'
    (by rw [hB]; exact hwas) (wasN_shape _) (by rw [hB]; exact hput) hml
  rw [hB, hNN] at hg
  obtain ⟨s, hs⟩ := hfin
  have hsn : s.need = nn := by
    rw [← hNN]; exact finishLFCS2_need _ snd _ nm ord cape _ nex g1 hrunL nedF g2 hnoar s hs
  have hout' : ∀ np : NeedOrd, OutsHeld outC nout (upd st.ml B (some np)) (cacheN C1 C2 C3 C4 SURE') := by
    intro np b' hb' k hk
    obtain ⟨NR, u, h2, h3, h4⟩ := hout1 b' (by
      by_cases e : b' = B
      · exact Or.inr e
      · left; simpa [upd, e] using hb') k hk
    rw [cacheN_slot2] at h2
    exact ⟨NR, u, by rw [cacheN_slot2]; exact h2, h3, h4⟩
  rw [memMovedN_was] at hg
  cases hm : st.ml B with
  | none =>
    have hnone : getF mugF B ML = some (A 0) :=
      getF_none hml (fun v hv => by obtain ⟨n, t, hn, -⟩ := hR.1.2.1 B v hv; rw [hm] at hn; cases hn)
    obtain ⟨ML', hp, -, -⟩ := putF_spec mugF ML B s.toNoun hml
    have hp' : putF mugF B (C nn.toNoun (C (A s.nargs) (HoonMap.toNoun Blob.toNoun s.blocks))) ML = some ML' := by
      rw [← hsn]; exact hp
    refine ⟨ML', cacheN C1 C2 C3 C4 SURE', ?_, ?_⟩
    · rw [hg.1 hnone, hs]
      simp only [Option.bind_some, hp, Option.map_some, memChgN_loob]
      simp [member, hnone0, hcomp, hm]
    · have e1 : (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) B Mode.done keep st).2.ml
          = upd st.ml B (some nn) := by simp [member, hnone0, hcomp, hm]
      have e2 : (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) B Mode.done keep st).2.sure
          = upd st.sure B (some (if keep then (st.sure B).getD sur else sur)) := by simp [member, hnone0, hcomp, hm]
      rw [e1, e2]
      exact ⟨⟨csMlExact_put hR.1 hp', hSH', hout' nn, hQ'⟩, mlStr_put hRS ⟨s, rfl⟩ hml hp⟩
  | some prev =>
    obtain ⟨t, ht⟩ := hR.1.2.2 B prev hm
    have hprev : getF mugF B ML = some (C (A 0) (C prev.toNoun t)) := getF_some hml ht
    have hg2 := hg.2 prev t hprev
    have hmsg : (cfgRealS2 r snd order kids).msg B nn prev = msgOrd nn prev cape := by simp [cfgRealS2, hinfo]
    by_cases hnp : msgOrd nn prev cape = nn
    · rw [if_pos (by rw [hnp]), hs] at hg2
      obtain ⟨ML', hp, -, -⟩ := putF_spec mugF ML B s.toNoun hml
      have hp' : putF mugF B (C (msgOrd nn prev cape).toNoun (C (A s.nargs) (HoonMap.toNoun Blob.toNoun s.blocks))) ML
          = some ML' := by rw [hnp, ← hsn]; exact hp
      refine ⟨ML', cacheN C1 C2 C3 C4 SURE', ?_, ?_⟩
      · rw [hg2]
        simp only [Option.map_some, Option.bind_some, hp, memChgO_loob]
        simp [member, hnone0, hcomp, hm, hmsg]
      · have e1 : (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) B Mode.done keep st).2.ml
            = upd st.ml B (some (msgOrd nn prev cape)) := by simp [member, hnone0, hcomp, hm, hmsg]
        have e2 : (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) B Mode.done keep st).2.sure
            = upd st.sure B (some (if keep then (st.sure B).getD sur else sur)) := by simp [member, hnone0, hcomp, hm]
        rw [e1, e2]
        exact ⟨⟨csMlExact_put hR.1 hp', hSH', hout' _, hQ'⟩, mlStr_put hRS ⟨s, rfl⟩ hml hp⟩
    · have hne : (msgOrd nn prev cape).toNoun ≠ nn.toNoun := fun h => hnp (needOrd_toNoun_inj h)
      rw [if_neg hne] at hg2
      obtain ⟨t', ⟨s', hs'⟩, ht'⟩ := hcs prev SURE' hm hnp
      rw [ht'] at hg2
      obtain ⟨ML', hp, -, -⟩ := putF_spec mugF ML B (C (msgOrd nn prev cape).toNoun t') hml
      refine ⟨ML', cacheN C1 C2 C3 C4 SURE', ?_, ?_⟩
      · rw [hg2]
        simp only [Option.bind_some, hp, Option.map_some, memChgO_loob]
        simp [member, hnone0, hcomp, hm, hmsg]
      · have e1 : (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) B Mode.done keep st).2.ml
            = upd st.ml B (some (msgOrd nn prev cape)) := by simp [member, hnone0, hcomp, hm, hmsg]
        have e2 : (member (cfgRealS2 r snd order kids) (fun _ => (cfgRealS2 r snd order kids).none) B Mode.done keep st).2.sure
            = upd st.sure B (some (if keep then (st.sure B).getD sur else sur)) := by simp [member, hnone0, hcomp, hm]
        rw [e1, e2]
        exact ⟨⟨csMlExact_put hR.1 hp, hSH', hout' _, hQ'⟩, mlStr_put hRS ⟨s', hs'⟩ hml hp⟩

def MemDoneCallS2 (r : RealCfg) (snd : Nomm → NeedOrd → Bool) (order : List Noun) (kids : Noun → List Noun) (outC : Noun → List Noun)
    (nout : Noun → NeedOrd) (envK : CallEnv) (RR : GenRest → Prop) (P : Noun → Prop) (S : Noun) (x : GenRest)
    (st : St Noun NeedOrd) (keep : Bool) (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun) : Prop :=
  ∃ (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat), b = C (C cape.toNoun DATA) FOL ∧
    r.info b = ⟨nm, cape, DATA, fuel⟩ ∧ ∃ CA1,
    nock (C inlBody (C (C b (C (C CODE LSR) (C JH CACHE))) compK)) inlBody = some (C nm.toNoun CA1) ∧
    ∃ (nex : NextL CSet) (g1 : GenSf (TreapMap mugF)),
      runLCS2 (envDoneS2 r snd order kids st) snd Option.none nm (CGoalL.done : CGoalL CSet) [] (GenSf.ofGen gen0)
        = some (nex, g1) ∧
    ∃ (X : GenRest → Noun → Noun → Prop) (Y : GenRest → GenRest → Prop),
      CompRunAtXTS (runLCS2 (envDoneS2 r snd order kids st) snd Option.none) (memDCtx SCC (C CODE LSR) JH ML (A 0) b) X Y
        nm CGoalL.done [] (GenSf.ofGen genEntry) ∧ X (cuRest CA1) (A 1) (A 0) ∧
      (∀ x1, Y (cuRest CA1) x1 → ∃ C1 C2 C3 C4 SURE, x1.cache = cacheN C1 C2 C3 C4 SURE ∧
        QK envK RR P S x (cacheN C1 C2 C3 C4 SURE) ∧ SureHolds r.scc st.sure (cacheN C1 C2 C3 C4 SURE) ∧
        ∀ b', ((st.ml b').isSome ∨ b' = b) → ∀ k ∈ outC b', ∃ NR u,
          slot? 2 (cacheN C1 C2 C3 C4 SURE) = some NR ∧ getF mugF k NR = some (C (A 0) u) ∧ slot? 2 u = some (nout k).toNoun) ∧
    ∃ ord, shapeCol fuel nex.laz cape = some ord ∧ nex.th.args = [] ∧
    ∃ (nedF : Need) (g2 : Gen (TreapMap mugF)), needOrdAllocRegs ord g1.g = some (nedF, g2) ∧
      isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
        ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true ∧
      FinGateS2 (envDoneS2 r snd order kids st) snd (memDCtx SCC (C CODE LSR) JH ML (A 0) b) ∧
    ∃ sur, sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur ∧
      (∃ s, finishLFCS2 (S := CSet) (Map := TreapMap mugF) (envDoneS2 r snd order kids st) snd TreapMap.tap nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s) ∧
      ∀ (x1 : GenRest) (C1 C2 C3 C4 SURE' : Noun) (prev : NeedOrd), st.ml b = some prev →
        msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
        ∃ t, (∃ s : Straight (TreapMap mugF), C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t = s.toNoun) ∧ nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
              (memFCR keep (wasN (st.sure b)) sur.toNoun
                (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
                (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
                nex.th.there (genNoun g2 x1) nm.toNoun
                (memDCtx SCC (C CODE LSR) JH ML (A 0) b) b ML
                (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
          = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)

theorem memGate_done_realS2 (r : RealCfg) (snd : Nomm → NeedOrd → Bool) (order : List Noun) (kids : Noun → List Noun) (outC : Noun → List Noun)
    (nout : Noun → NeedOrd) (envK : CallEnv) (RR : GenRest → Prop) (P : Noun → Prop) (S : Noun) (x : GenRest)
    (hRR : ∀ NR MO SC INL SU SU' s f : Noun, RR ⟨cacheN NR MO SC INL SU, s, f⟩ → RR ⟨cacheN NR MO SC INL SU', s, f⟩)
    (hS : ∀ b ∈ r.scc, b ∈ tapList S)
    (hxS : ∀ b ∈ r.scc, ∀ N u, slot? 31 x.cache = some N → getF mugF b N ≠ some (C (A 0) u))
    (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 : Noun)
    (hcall : ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
      LoopR r.scc outC nout (QK envK RR P S x) st.ml st.sure ML CACHE →
      MemDoneCallS2 r snd order kids outC nout envK RR P S x st keep DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE) :
    MemGate (cfgRealS2 r snd order kids) (LoopRS (cfgRealS2 r snd order kids).scc outC nout (QK envK RR P S x))
      (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0) (fun _ => (cfgRealS2 r snd order kids).none) (A 0) Mode.done
      (A 0x656e6f64) := by
  intro st keep b ML CA hb hR
  obtain ⟨cape, DATA, FOL, nm, fuel, rfl, hinfo, CA1, hinl, nex, g1, hrunL, X, Y, hXT, hX, hY, ord, hcol, hargs,
    nedF, g2, hnoar, hrun, hfin2, sur, hsur, hfin, hcs⟩ := hcall st keep b ML CA hb hR.1
  obtain ⟨x1, hY1, heq⟩ := hXT (cuRest CA1) (A 1) (A 0) (softMapNoun_empty).symm hX
  have hge : (genEntry : Gen (TreapMap mugF)) = gen0 := rfl
  rw [hge, hrunL] at heq
  obtain ⟨C1, C2, C3, C4, SURE, hx1, hQ1, hsh1, hout1⟩ := hY x1 hY1
  exact mem_done_stepS2 r snd order kids outC nout envK RR P S x hRR st keep cape DATA FOL nm fuel hinfo hb (hS _ hb)
    (hxS _ hb) ML CA DN KIDS ML0 CB SCC CODE LSR JH CACHE0 hR CA1 hinl nex g1 hrunL { x1 with soft := softMapNoun g1.soft } heq C1 C2 C3 C4 SURE hx1 rfl
    hQ1 hsh1 hout1 ord hcol hargs nedF g2 hnoar hrun hfin2 sur hsur hfin
    (fun prev SURE' hm hnp => hcs _ C1 C2 C3 C4 SURE' prev hm hnp)

theorem memGate_done_KS2 (r : RealCfg) (snd : Nomm → NeedOrd → Bool) (order : List Noun) (kids : Noun → List Noun) (outC : Noun → List Noun)
    (nout : Noun → NeedOrd) (env : CallEnv) (SC0 : Noun) (inl : Noun → Option Nomm) (P : Noun → Prop)
    (S CODE JETS CALLS JH : Noun) (x : GenRest) (NR CR : Noun)
    (hS : ∀ b ∈ r.scc, b ∈ tapList S)
    (hxS : ∀ b ∈ r.scc, ∀ N u, slot? 31 x.cache = some N → getF mugF b N ≠ some (C (A 0) u))
    (hcall : ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
      LoopR r.scc outC nout (QK env (RK SC0 inl) P S x) st.ml st.sure ML CACHE →
      MemDoneCallS2 r snd order kids outC nout env (RK SC0 inl) P S x st keep (A 1)
        (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE) :
    MemGate (cfgRealS2 r snd order kids) (LoopRS (cfgRealS2 r snd order kids).scc outC nout (QK env (RK SC0 inl) P S x))
      (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
      (fun _ => (cfgRealS2 r snd order kids).none) (A 0) Mode.done (A 0x656e6f64) :=
  memGate_done_realS2 r snd order kids outC nout env (RK SC0 inl) P S x rK_sure hS hxS (A 1) _ (A 0) csiBody S CODE
    (C JETS CALLS) JH (C NR CR) hcall

