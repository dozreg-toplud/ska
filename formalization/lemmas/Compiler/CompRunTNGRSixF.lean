variable {ctx : Noun} {X : GenRest → Noun → Noun → Prop}

/-- Phase F from `+past-fork` on, in the model. -/
noncomputable def sixPFRNG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region : List Nat) (rc : Nat)
    (lazy : Lazy CSet) (yes nuh : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let lazy ← liftO (Lazy.pastFork env.cod lazy p)
  let o ← emit ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩
  let lazy ← lazyShut o lazy
  let nexCond ← runLCMR env false msup p (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 o)) region
  copyL nexCond lazy

/-- Phase F from the two runs on: `+sect`, then the rest from `+past-fork` on. -/
noncomputable def sixLynFRNG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region rb : List Nat) (rc o0 o1 : Nat)
    (cb cbw : TreapMap mugF (Nat × List Nat)) (nex0 nex1 : NextL CSet) : CM (TreapMap mugF) (NextL CSet) := do
  let (lazy, yes, nuh) ← sect nex0 nex1 o0 o1 rb cb cbw
  sixPFRNG env msup p region rc lazy yes nuh

/-- The model of `%6` under a `%next` goal whose `+leap` is `~`, whose need
with the bunt sure is not `+none-equivalent` and whose `+kerf` test fails:
phase F (`sixNextForkC`). -/
theorem runLC_n6_fRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false) (hkt : kerfTest q r laz = false) :
    (runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = sixNextForkC env.cod (runLCMR env false msup p) (runLCMR env false msup q) (runLCMR env false msup r) p laz th region := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region = _
  unfold kerfTest at hkt
  rw [sixNextLC.eq_2]
  simp only [hlp, hne, Bool.not_false, if_true, hkt, Bool.false_eq_true, if_false]

/-- **What the two runs of phase F return**: the branch needs meet `LInv`,
are apart, and every register of them is above `r-cond` (the registers of
the goals of `+fork` are fresh after `+re`, the rest is fresh after `+fork`). -/
theorem six_f_runsRNG {env : CallEnv} {msup : Option Nomm} {q r : Nomm} {rb : List Nat}
    (ihq : ResForR (runLCMR env false msup) q rb) (ihr : ResForR (runLCMR env false msup) r rb)
    {laz : Lazy CSet} {th : Jmp} {g g3 g1 g2 : Gen (TreapMap mugF)} {n0 n1 nex0 nex1 : NextL CSet}
    (hinv : GInv g (CGoalL.next laz th)) (ef : forkL ⟨laz, th⟩ g.re (reG g) = some ((n0, n1), g3))
    (e1 : runLCMR env false msup r n1.goal rb (idG g3) = some (nex1, g1))
    (e2 : runLCMR env false msup q n0.goal rb g1 = some (nex0, g2)) :
    g.re < g2.re ∧ g.bo ≤ g2.bo ∧ g2.drop = false ∧ LInv g2.re g2.bo nex0.laz ∧ LInv g2.re g2.bo nex1.laz ∧
      (∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz) ∧ (∀ y ∈ lregs nex0.laz ++ lregs nex1.laz, g.re < y) := by
  have hR : GInv (reG g) (CGoalL.next laz th) := ginv_mono hinv (Nat.le_succ _) (Nat.le_refl _) rfl
  obtain ⟨gi0, gi1⟩ := ginv_forkL hR ef
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  obtain ⟨-, -, F, -, -, -⟩ := forkL_spec hl ef
  obtain ⟨k3r, k3b, -⟩ := (km_forkL (Map := TreapMap mugF) (S := CSet) _ _).keep _ _ _ ef
  rw [reG_re] at F k3r
  rw [reG_bo] at k3b
  have gi1' : GInv (idG g3) n1.goal := gi1
  obtain ⟨l1, b1, gj1, s1r⟩ := ihr _ (idG g3) g1 nex1 gi1' e1
  have hi0 : GInv g1 n0.goal := ginv_mono gi0 l1 b1 ((ginv_drop gj1).trans (ginv_drop gi1').symm)
  obtain ⟨l2, b2, gj2, s2r⟩ := ihq _ g1 g2 nex0 hi0 e2
  have rI : (idG g3).re = g3.re := rfl
  have bI : (idG g3).bo = g3.bo := rfl
  rw [rI] at l1 s1r
  rw [bI] at b1
  have f0 : ∀ y ∈ lregs nex0.laz, g1.re ≤ y ∨ y ∈ lregs n0.laz := s2r
  have f1 : ∀ y ∈ lregs nex1.laz, g3.re ≤ y ∨ y ∈ lregs n1.laz := s1r
  refine ⟨by omega, by omega, ginv_drop gj2, gj2.1, linv_mono gj1.1 l2 b2, ?_, ?_⟩
  · intro y hy hy'
    have hb1 := lnb_regs gj1.1.1 y hy'
    rcases f0 y hy with e | e
    · omega
    · rcases f1 y hy' with e' | e'
      · have := (F.2 y (List.mem_append_left _ e)).2; omega
      · exact (List.nodup_append.1 F.1).2.2 y e y e' rfl
  · intro y hy
    rcases List.mem_append.1 hy with hy | hy
    · rcases f0 y hy with e | e
      · omega
      · have := (F.2 y (List.mem_append_left _ e)).1; omega
    · rcases f1 y hy with e | e
      · omega
      · have := (F.2 y (List.mem_append_right _ e)).1; omega

/-- Phase F after `+id`, in the model: the rest of `sixNextForkC`. -/
noncomputable def sixFKRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (n0 n1 : NextL CSet) (rc rid : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let cb ← getCond
  let nex1 ← runLCMR env false msup r (CGoalL.next n1.laz n1.th) (rid :: region)
  let cbw ← getCond
  let nex0 ← runLCMR env false msup q (CGoalL.next n0.laz n0.th) (rid :: region)
  sixLynFRNG env msup p region (rid :: region) rc n0.th.there n1.th.there cb cbw nex0 nex1

theorem sixNextForkC_eqRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) :
    (sixNextForkC env.cod (runLCMR env false msup p) (runLCMR env false msup q) (runLCMR env false msup r) p laz th region :
      CM (TreapMap mugF) (NextL CSet))
      = (do
          let rc ← re
          let (n0, n1) ← forkL ⟨laz, th⟩ rc
          let rid ← idM
          sixFKRNG env msup p q r region n0 n1 rc rid) := rfl

/-- **What `%6` returns in phase F**: `GRes`, given what the runs of the
parts return.  Every register of the result is fresh: `r-cond` and the
registers of the goals of `+fork` are taken after the call, the branch
needs are made of those or fresh ones, the register of `+lazy-shut` is
fresh, and the run of `p` reads only `r-cond`. -/
theorem res_n6_fRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env false msup) p region) (ihq : ∀ rid, ResForR (runLCMR env false msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env false msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = false)
    (h : runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_fRNG env msup p q r laz th region hlp hne hkt, sixNextForkC_eqRNG] at h
  obtain ⟨rc, gR, eR, h⟩ := bind_some h
  rw [re_ap] at eR
  simp only [Option.some.injEq, Prod.mk.injEq] at eR
  obtain ⟨rfl, rfl⟩ := eR
  obtain ⟨⟨n0, n1⟩, g3, ef, h⟩ := bind_some h
  obtain ⟨rid, gI, eI, h⟩ := bind_some h
  rw [idM_ap] at eI
  simp only [Option.some.injEq, Prod.mk.injEq] at eI
  obtain ⟨rfl, rfl⟩ := eI
  unfold sixFKRNG at h
  obtain ⟨c0, g0, e0, h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e0
  obtain ⟨-, rfl⟩ := e0
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  obtain ⟨c1, g1', e1', h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e1'
  obtain ⟨-, rfl⟩ := e1'
  obtain ⟨nex0, g2, e2, h⟩ := bind_some h
  obtain ⟨lt2, bt2, d2, h0, h1, ap01, fr⟩ := six_f_runsRNG (ihq g3.id) (ihr g3.id) hi ef e1 e2
  unfold sixLynFRNG at h
  obtain ⟨⟨lz, yes, nuh⟩, g4, e3, h⟩ := bind_some h
  have hlz := sect_lazy e3
  obtain ⟨k4r, k4b, k4d⟩ := (km_sect nex0 nex1 _ _ _ _ _).keep _ _ _ e3
  obtain ⟨hy, hn⟩ := sect_labels e3
  subst hlz
  have d4 : g4.drop = false := k4d.trans d2
  have lvF := lyn_linv (linv_mono h0 k4r k4b) (linv_mono h1 k4r k4b) ap01 hy hn
  unfold sixPFRNG at h
  obtain ⟨lazy, g5, e5, h⟩ := bind_some h
  simp only [liftO] at e5
  cases epf : Lazy.pastFork env.cod (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) p with
  | none => rw [epf] at e5; cases e5
  | some lz' =>
  rw [epf] at e5
  simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at e5
  obtain ⟨rfl, rfl⟩ := e5
  have lvP : LInv g4.re g4.bo lz' := linv_pastFork epf lvF
  have rP : ∀ y ∈ lregs lz', g.re < y := fun y hy => by
    rw [lregs_pastFork epf] at hy
    simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil] at hy
    exact fr y hy
  obtain ⟨o, g6, e6, h⟩ := bind_some h
  rw [emit_apply] at e6
  simp only [Option.some.injEq, Prod.mk.injEq] at e6
  obtain ⟨rfl, rfl⟩ := e6
  obtain ⟨lz'', g7, e7, h⟩ := bind_some h
  obtain ⟨k7r, k7b, k7d, lv7, f7⟩ := lazyShut_inv
    (linv_mono lvP (Nat.le_of_eq (emitted_re _ _).symm) (by rw [emitted_bo]; omega)) e7
  simp only [emitted_re, emitted_bo, emitted_drop] at k7r k7b k7d f7
  have d7 : g7.drop = false := k7d.trans d4
  obtain ⟨nexC, g8, e8, h⟩ := bind_some h
  obtain ⟨l8, b8, gi8, s8⟩ := ihp _ g7 g8 nexC (ginv_rc (by omega) d7) e8
  have hC : LInv g8.re g8.bo nexC.laz := gi8.1
  have hP8 : LInv g8.re g8.bo lz'' := linv_mono lv7 l8 b8
  have sC : ∀ y ∈ lregs nexC.laz, g7.re ≤ y ∨ y = g.re := fun y hy => by
    rcases s8 y hy with e | e
    · exact Or.inl e
    · change y ∈ lregs (Lazy.ofSure (lazyReg g.re : Sure CSet)) at e
      rw [lregs_reg, List.mem_singleton] at e
      exact Or.inr e
  have sL : ∀ y ∈ lregs lz'', g.re < y := fun y hy => by
    rcases f7 y hy with e | e
    · exact rP y e
    · omega
  have ap8 : (lregs nexC.laz ++ lregs lz'').Nodup := by
    refine List.nodup_append.2 ⟨gi8.1.2.1, lv7.2.1, fun a ha b hb e => ?_⟩
    subst e
    have := lnb_regs lv7.1 a hb
    have := sL a hb
    rcases sC a ha with e | e
    · omega
    · omega
  obtain ⟨l9, b9, gi9, s9⟩ := copyL_inv hC hP8 ap8 (ginv_drop gi8) h
  refine ⟨by omega, by omega, gi9, fun y hy => Or.inl ?_⟩
  rcases s9 y hy with e | e
  · rcases List.mem_append.1 e with e | e
    · rcases sC y e with e' | e'
      · omega
      · omega
    · have := sL y e; omega
  · omega

