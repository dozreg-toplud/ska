    simp only [crSubj, compCore] at ht hre0 hre1
    generalize comp.door = Dr at hk hD1 hD2 hD3 hre0 hre1 he ht ⊢
    nock_open cr2Kf
    simp [nock_exec, crSubj, hD1, comp_kerf_arm, hk, hD2, hre0, hre1, hD3, comp_emit_arm, he, ht, cr2KfMLRH, bind,
