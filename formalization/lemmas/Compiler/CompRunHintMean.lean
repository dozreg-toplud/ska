/-! ## `+mean-konst` -/

/-- **`+mean-konst` is `meanKonst`**: `~` on no product; on a product
`k` when the code entry of `b` is pure. -/
theorem comp_mean_konst (hc : CompIn ctx) {cod : Noun} (hcode : slot? 52 ctx = some cod) (env : CallEnv)
    (b : Bell) (k : Option Noun) (g : Gen (TreapMap mugF)) (x : GenRest)
    (hcd : k.isSome = true → CodePure cod env b) :
    nock (C mkBat (C (C b.toNoun (unitNoun id k)) (compCore g x ctx))) mkBat
      = some (unitNoun id (meanKonst env b k)) := by
  cases k with
  | none =>
    unfold mkBat
    simp [nock_exec, unitNoun, meanKonst]
  | some n =>
    obtain ⟨V, hgot, hv⟩ := hcd rfl
    have hgt := got_gate (mug := mugF) layer2 ⟨need.arm_at, someIn_layer2, gorIn_morIn_layer2.1⟩ b.toNoun cod V hgot
    unfold mkBat mkPure
    cases ep : env.pure b <;>
      simp [nock_exec, compCore, hc, hcode, by.arm_at, by_arm, by.got.arm_at, got_arm, hgt, hv, ep, loob, unitNoun,
        meanKonst]

/-! ## The dispatch and the test -/

/-- The dispatch: `crDol` on `[%mean t]` is `crKmean`. -/
theorem cr_disp_mean (t mono goal region sup D : Noun) :
    nock (crSubj mono (C (A Tag.mean) t) goal region sup D) crDol
      = nock (crSubj mono (C (A Tag.mean) t) goal region sup D) crKmean := by
  nock_open crDol
  simp [nock_exec, crSubj, crTc, crT, Tag.mean]

/-- With no constant the model at `mono` `&` is that of `n11d %mean`. -/
theorem runLCH_mean_none (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) {p q : Nomm} {b : Bell}
    {body : Noun} {k : Option Noun} (hk : meanKonst env b k = Option.none) (goal : CGoalL CSet) (region : List Nat) :
    (runLCH env snd true msup (Nomm.mean p b q body k) goal region : CM (TreapMap mugF) (NextL CSet)) =
      runLCH env snd true msup (Nomm.n11d Tag.mean p q body) goal region := by
  have hd : hintDynamic Tag.mean = true := by decide
  simp only [runLCH, hk, hd, Bool.not_true, Bool.false_eq_true, if_false, if_true]

/-! ## The branch `YES` -/

/-- **The case `%mean` with no constant**, on every goal, at `mono` `&`:
the link of `n11d %mean p q body` at the same goal. -/
theorem comp_run_mean_yes (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) {E : GenRest → Prop}
    (p q : Nomm) (b : Bell) (body : Noun) (k : Option Noun) (goal : CGoalL CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) (hk : meanKonst env b k = Option.none) (hcd : k.isSome = true → CodePure cod env b)
    (hD : CompRunAtX (runLCH env snd true msup) ctx (XM E msup) (Nomm.n11d Tag.mean p q body) goal region g) :
    CompRunAtX (runLCH env snd true msup) ctx (XM E msup) (Nomm.mean p b q body k) goal region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  intro x mono sup hx hX
  obtain ⟨hE, rfl, rfl⟩ := hX
  have hd := hD x (A 0) (unitNoun Nomm.toNoun msup) hx ⟨hE, rfl, rfl⟩
  rw [runLCH_mean_none env snd msup hk]
  rw [← hd]
  simp only [Nomm.toNoun]
  rw [cr_disp_mean, cm_eq]
  have hmk : nock (C mkBat (C (C b.toNoun (unitNoun id k)) (compCore g x ctx))) mkBat = some (A 0) := by
    rw [comp_mean_konst hc hcode env b k g x hcd, hk]; rfl
  have hD1 := mk_at
  simp only [crSubj, compCore] at hmk ⊢
  generalize comp.door = Dr at hmk hD1 ⊢
  unfold cmHead cmKonst cmTest cmYes
  simp [nock_exec, hD1, mk_arm, hmk, cr_bat_dol, Tag.mean]
