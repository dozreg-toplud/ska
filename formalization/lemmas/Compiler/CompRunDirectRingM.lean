variable {ctx : Noun}

/-- **The ring of `rin` is a ring noun** (what `+cole-put` keeps: P). -/
def RinOk : Option Noun → Prop
  | Option.none => True
  | some u => RingNoun u

/-- **The model of step `7` under `mono` `&`, rings included**: `crdBlockMM` with the ops
`jumpOpR b rin` / `callOpR b rin`. -/
noncomputable def crdBlockMMR (b : Bell) (rin : Option Noun) (subV : List Nat) :
    CGoalL CSet → CM (TreapMap mugF) (Nat × Nat × Nat)
  | CGoalL.done => do
      let subPes ← re
      let opt ← emit ⟨[], [], jumpOpR b rin Option.none subV⟩
      let pes ← emit ⟨[], [], jumpOpR b rin (some subPes) subV⟩
      pure (opt, subPes, pes)
  | g => do
      let nex ← simpleNextL g
      let (out, pro) ← kerf nex
      let merged ← re
      let subPes ← re
      let merge ← emit ⟨[merged], [Pole.mov merged pro], Termin.hop (jmp0 out)⟩
      let proOpt ← re
      let proPes ← re
      let opt ← emit ⟨[], [callOpR b rin Option.none subV proOpt], Termin.hop ⟨[some proOpt], merge⟩⟩
      let pes ← emit ⟨[], [callOpR b rin (some subPes) subV proPes], Termin.hop ⟨[some proPes], merge⟩⟩
      pure (opt, subPes, pes)

/-- With no ring it is `crdBlockMM`. -/
theorem crdBlockMMR_none (b : Bell) (subV : List Nat) : crdBlockMMR b Option.none subV = crdBlockMM b subV := by
  funext goal
  cases goal <;> rfl

/-- **`monoBlocksR`** is the blocks of step `7` then `+mono-try-call`. -/
theorem monoBlocksR_eq (b : Bell) (rin : Option Noun) (subNed : Need) (goal : CGoalL CSet) :
    (monoBlocksR b rin subNed goal : CM (TreapMap mugF) (Nat × Nat)) = (do
      let (opt, subPes, pes) ← crdBlockMMR b rin (flattenNeed subNed) goal
      let o ← monoTryCall subNed opt subPes pes
      pure (subPes, o)) := by
  funext g
  cases goal with
  | done =>
    simp only [monoBlocksR, crdBlockMMR, bind_apply, re_apply, cf_emit_g, Option.bind_some, pure_apply]
  | next laz th =>
    simp only [monoBlocksR, crdBlockMMR, bind_apply]
    cases e1 : simpleNextL (S := CSet) (Map := TreapMap mugF) (CGoalL.next laz th) g with
    | none => rfl
    | some r =>
      simp only [Option.bind_some]
      cases e2 : kerf (Map := TreapMap mugF) r.1 r.2 with
      | none => rfl
      | some r2 => simp only [Option.bind_some, re_apply, cf_emit_g, pure_apply]
  | pick z o =>
    simp only [monoBlocksR, crdBlockMMR, bind_apply]
    cases e1 : simpleNextL (S := CSet) (Map := TreapMap mugF) (CGoalL.pick z o) g with
    | none => rfl
    | some r =>
      simp only [Option.bind_some]
      cases e2 : kerf (Map := TreapMap mugF) r.1 r.2 with
      | none => rfl
      | some r2 => simp only [Option.bind_some, re_apply, cf_emit_g, pure_apply]

/-- **Step `7` under `%done` and `mono` `&`, rings included** (`crD7Dm`): `+re`, the `+emit` of
`[~ ~ (jump-op ~)]` and of `[~ ~ (jump-op `sub-pes)]`: `%jmf` / `%jsf` on a ring. -/
theorem crd_blkMR_done (hc : CompIn ctx) (x : GenRest) (SOF V5 V2 PV : Noun) (subNed : Need) (p q : Nomm)
    (b : Bell) (rin : Option Noun) (hro : RinOk rin) (region : List Nat) (sup : Noun) (g : Gen (TreapMap mugF)) :
    nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 (unitNoun id rin) PV
      (crSubj (A 0) (crdN p q b) (CGoalL.done : CGoalL CSet).toNoun (listNoun A region) sup (compCore g x ctx)))
      crDKc7
      = (crdBlockMMR b rin (flattenNeed subNed) CGoalL.done g).map fun p => crdBlkN p x := by
  cases rin with
  | none =>
    rw [crdBlockMMR_none]
    exact crd_blkM_done hc x SOF V5 V2 PV subNed p q b region sup g
  | some u =>
    have hu : (ringOfNoun u).toNoun = u := hro
    rw [show unitNoun id (some u) = C (A 0) u from rfl]
    have hre := comp_re' ctx x g
    have he1 := cf_emit (x := x) hc (mtcReG g) ⟨[], [], Termin.jmf b (flattenNeed subNed) (ringOfNoun u)⟩
    have he2 := cf_emit (x := x) hc (cfEmitG ⟨[], [], Termin.jmf b (flattenNeed subNed) (ringOfNoun u)⟩ (mtcReG g))
      ⟨[], [], Termin.jsf b g.re (ringOfNoun u)⟩
    simp only [Blob.toNoun, listNoun, Termin.toNoun, Tag.jmf, Tag.jsf, hu] at he1 he2
    have hD := comp_emit_at
    have hDr := comp_re_at
    simp only [crdBlockMMR, jumpOpR, bind_apply, re_apply, cf_emit_g, Option.bind_some, pure_apply, Option.map_some]
    simp only [crSubj, compCore, mtcReG] at hre he1 he2 ⊢
    generalize comp.door = Dr at hre he1 he2 hD hDr ⊢
    unfold crDKc7 crD7 crD7Op crD7Jop crD7T crD7D crD7Dm
    simp [nock_exec, CGoalL.toNoun, hD, hDr, hre, comp_emit_arm, he1, he2, crdBlkN, cf_emitG_re]

/-! ## The cut of `crD7Nm` with `rin` the noun `RIN` (copies of `crNM_0` .. `crNM_4`, `crNM_L`) -/

/-- The subject of `crD7Nm` after the pushes `l`, with `rin` the noun `RIN`. -/
noncomputable abbrev crNSR (l : List Nat) (KP NEX JG OG SOF V5 SV SN V2 RIN PV mono N GN RG sup : Noun)
    (g : Gen (TreapMap mugF)) (x : GenRest) (ctx : Noun) : Noun :=
  l.foldr (fun a s => C (A a) s)
    (C KP (C NEX (C JG (C OG (crdS6mR SOF V5 SV SN V2 RIN PV (crSubj mono N GN RG sup (compCore g x ctx)))))))

