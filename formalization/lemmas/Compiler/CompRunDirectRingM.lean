theorem crNM_5F (hc : CompIn ctx) (hu : RingNoun u) (a5 a4 a3 a2 a1 : Nat) (g0 g : Gen (TreapMap mugF)) :
    nock (crNSR [a5, a4, a3, a2, a1] KP NEX JG
      (crOGR SOF V5 (listNoun A (flattenNeed subNed)) SN V2 (C (A 0) u) PV mono (crdN p q b) GN RG sup g0 x ctx)
      SOF V5 (listNoun A (flattenNeed subNed)) SN V2 (C (A 0) u) PV mono (crdN p q b) GN RG sup g x ctx) crNMr5
      = nock (crNSR [g.bo, a5, a4, a3, a2, a1] KP NEX JG
          (crOGR SOF V5 (listNoun A (flattenNeed subNed)) SN V2 (C (A 0) u) PV mono (crdN p q b) GN RG sup g0 x ctx)
          SOF V5 (listNoun A (flattenNeed subNed)) SN V2 (C (A 0) u) PV mono (crdN p q b) GN RG sup
          (cfEmitG (crOptF b (flattenNeed subNed) a4 a3 (ringOfNoun u)) g) x ctx) crNMr6 := by
  have hD := comp_emit_at
  have he := cf_emit (x := x) hc g (crOptF b (flattenNeed subNed) a4 a3 (ringOfNoun u))
  rw [crOptF_noun, show (ringOfNoun u).toNoun = u from hu] at he
  conv => { lhs; arg 2; unfold crNMr5 }
  simp only [crNSR, crOGR, crSubj, compCore, List.foldr] at he ⊢
  generalize comp.door = Dr at hD he ⊢
  simp [nock_exec, crNMv5, crOpBat, crD7Op, crdN, hD, comp_emit_arm, he]

