/-! ## The blocks `opt` and `pes` on a ring -/

/-- The block `opt` through the ring `r`. -/
def crOptF (b : Bell) (subV : List Nat) (proOpt merge : Nat) (r : Ring) : Blob :=
  ⟨[], [Pole.caf b subV proOpt r], Termin.hop ⟨[some proOpt], merge⟩⟩

/-- The block `pes` through the ring `r`. -/
def crPesF (b : Bell) (subPes proPes merge : Nat) (r : Ring) : Blob :=
  ⟨[], [Pole.csf b subPes proPes r], Termin.hop ⟨[some proPes], merge⟩⟩

theorem crOptF_noun (b : Bell) (subV : List Nat) (proOpt merge : Nat) (r : Ring) :
    (crOptF b subV proOpt merge r).toNoun
    = C (A 0) (C (C (C (A 0x666163) (C b.toNoun (C (listNoun A subV) (C (A proOpt) r.toNoun)))) (A 0))
        (C (A 0x706f68) (C (C (C (A 0) (A proOpt)) (A 0)) (A merge)))) := by
  simp [crOptF, Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.hop, Tag.caf, Jmp.toNoun, unitNoun]

theorem crPesF_noun (b : Bell) (subPes proPes merge : Nat) (r : Ring) : (crPesF b subPes proPes merge r).toNoun
    = C (A 0) (C (C (C (A 0x667363) (C b.toNoun (C (A subPes) (C (A proPes) r.toNoun)))) (A 0))
        (C (A 0x706f68) (C (C (C (A 0) (A proPes)) (A 0)) (A merge)))) := by
  simp [crPesF, Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.hop, Tag.csf, Jmp.toNoun, unitNoun]

/-- The gate `call-op` made on the subject of step `7` with `rin` the noun `RIN`. -/
noncomputable abbrev crOGR (SOF V5 SV SN V2 RIN PV mono N GN RG sup : Noun) (g0 : Gen (TreapMap mugF))
    (x : GenRest) (ctx : Noun) : Noun :=
  C crOpBat (C (C (A 0) (A 0)) (crdS6mR SOF V5 SV SN V2 RIN PV (crSubj mono N GN RG sup (compCore g0 x ctx))))

/-- The gate `jump-op` made on the subject of step `7` with `rin` the noun `RIN`. -/
noncomputable abbrev crJGR (SOF V5 SV SN V2 RIN PV mono N GN RG sup : Noun) (g0 : Gen (TreapMap mugF))
    (x : GenRest) (ctx : Noun) : Noun :=
  C crJopBat (C (A 0) (C (crOGR SOF V5 SV SN V2 RIN PV mono N GN RG sup g0 x ctx)
    (crdS6mR SOF V5 SV SN V2 RIN PV (crSubj mono N GN RG sup (compCore g0 x ctx)))))

