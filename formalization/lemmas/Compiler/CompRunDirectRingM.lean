theorem crd7_nmR (h7 : slot? 7 ctx = some compK) (x : GenRest) (SOF V5 SV SN V2 RIN PV : Noun) (p q : Nomm) (b : Bell)
    (RG sup : Noun) (goal : CGoalL CSet) (k : Nat) (hk : goal.toNoun = C (A k) (crdGoalT goal))
    (hkd : k ≠ 0x656e6f64) (g g1 g2 : Gen (TreapMap mugF)) (nex0 : NextL CSet) (out pro : Nat)
    (hsn : nock (crSubj (A 0) (crdN p q b) goal.toNoun RG sup (compCore g x ctx)) crSn
      = some (C nex0.goal.toNoun (genNoun g1 x)))
    (hkf : nock (C kerfBat (C nex0.goal.toNoun (compCore g1 x ctx))) kerfBat
      = some (C (C (A out) (A pro)) (genNoun g2 x))) :
    nock (crdS6mR SOF V5 SV SN V2 RIN PV (crSubj (A 0) (crdN p q b) goal.toNoun RG sup (compCore g x ctx))) crDKc7
      = nock (crNSR [] (C (A out) (A pro)) nex0.goal.toNoun (crJGR SOF V5 SV SN V2 RIN PV (A 0) (crdN p q b) goal.toNoun RG sup g x ctx)
          (crOGR SOF V5 SV SN V2 RIN PV (A 0) (crdN p q b) goal.toNoun RG sup g x ctx)
          SOF V5 SV SN V2 RIN PV (A 0) (crdN p q b) goal.toNoun RG sup g2 x ctx) crNMr0 := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hkd' : (0x656e6f64 : Nat) ≠ k := fun h => hkd h.symm
  have hD1 := comp_kerf_at
  rw [← crNM_eq]
  simp only [crNSR, crJGR, crOGR, crSubj, compCore, List.foldr] at hsn hkf ⊢
  rw [hk] at hsn ⊢
  generalize comp.door = Dr at hsn hkf hD1 ⊢
  unfold crDKc7 crD7 crD7T crD7Nr0 crD7Nc0 crD7Nr1 crD7Nc1 crD7Ne
  rw [crD7Op_eq, crD7Jop_eq]
  simp [nock_exec, crdS6mR, hsn, cr_bat_sn, hkd, hkd', hD1, comp_kerf_arm, hkf]

/-- Step `7` on a `%next` or `%pick` goal through the ring `u` (`crD7Nm`). -/
theorem crd_blkMS_next (h7 : slot? 7 ctx = some compK) (x : GenRest) (hx : x.NoSoft) (SOF V5 V2 PV : Noun)
    (subNed : Need) (p q : Nomm) (b : Bell) (u : Noun) (hu : RingNoun u) (region : List Nat) (sup : Noun)
    (goal : CGoalL CSet) (hgd : goal ≠ CGoalL.done) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 (C (A 0) u) PV
      (crSubj (A 0) (crdN p q b) goal.toNoun (listNoun A region) sup (compCore g x ctx))) crDKc7
      = (crdBlockMMR b (some u) (flattenNeed subNed) goal g).map fun p => crdBlkN p x := by
  obtain ⟨hc, hl, hm⟩ := comp_ctx_pill ctx h7
  have hmod : crdBlockMMR b (some u) (flattenNeed subNed) goal = (do
      let nex ← simpleNextL goal
      let (out, pro) ← kerf nex
      let merged ← re
      let subPes ← re
      let merge ← emit (crMerge merged pro out)
      let proOpt ← re
      let proPes ← re
      let opt ← emit (crOptF b (flattenNeed subNed) proOpt merge (ringOfNoun u))
      let pes ← emit (crPesF b subPes proPes merge (ringOfNoun u))
      pure (opt, subPes, pes) : CM (TreapMap mugF) (Nat × Nat × Nat)) := by
    cases goal with
    | done => exact absurd rfl hgd
    | _ => rfl
  have htd : ∃ k, goal.toNoun = C (A k) (crdGoalT goal) ∧ k ≠ 0x656e6f64 := by
    cases goal with
    | done => exact absurd rfl hgd
    | next laz th => exact ⟨_, rfl, by decide⟩
    | pick z o => exact ⟨_, rfl, by decide⟩
  obtain ⟨k, hk, hkd⟩ := htd
  have hkd' : (0x656e6f64 : Nat) ≠ k := fun h => hkd h.symm
  have hsn := comp_simple_next hc x g goal (A 0) (crdN p q b) (listNoun A region) sup
  rw [hmod, bind_apply]
  cases e : simpleNextL (S := CSet) (Map := TreapMap mugF) goal g with
  | none =>
    rw [e] at hsn
    simp only [Option.map_none] at hsn
    simp only [crSubj, compCore] at hsn ⊢
    rw [hk] at hsn ⊢
    generalize comp.door = Dr at hsn ⊢
    unfold crDKc7 crD7 crD7Op crD7Jop crD7T crD7Nr0 crD7Nc0
    simp [nock_exec, crdS6mR, hsn, cr_bat_sn, hkd, hkd']
  | some r =>
    obtain ⟨nex0, g1⟩ := r
    rw [e] at hsn
    simp only [Option.map_some] at hsn
    obtain ⟨-, -, ⟨⟨lnb, -⟩, d1, -⟩, -⟩ := simpleNextL_res hinv e
    have hkf := comp_kerf_all hc hl hm x g1 nex0 (walk_mdP hx g1.bo (lall_mono (fun _ hs => hs.1) lnb))
    have hD1 := comp_kerf_at
    rw [cr_next_nounL] at hsn
    cases ek : kerf nex0 g1 with
    | none =>
      rw [ek] at hkf
      simp only [crSubj, compCore] at hsn hkf ⊢
      rw [hk] at hsn ⊢
      generalize comp.door = Dr at hsn hkf hD1 ⊢
      unfold crDKc7 crD7 crD7Op crD7Jop crD7T crD7Nr0 crD7Nc0 crD7Nr1 crD7Nc1
      simp [nock_exec, crdS6mR, hsn, cr_bat_sn, hkd, hkd', hD1, comp_kerf_arm, hkf, bind, StateT.bind, ek]
    | some r2 =>
      obtain ⟨⟨out, pro⟩, g2⟩ := r2
      rw [ek] at hkf
      simp only [Option.map_some] at hkf
      rw [← cr_next_nounL] at hsn hkf
      rw [crd7_nmR h7 x SOF V5 _ _ V2 (C (A 0) u) PV p q b _ sup goal k hk hkd g g1 g2 nex0 out pro hsn hkf]
      rw [crNM_0R, crNM_1R, crNM_2R (hc := hc), crNM_3R, crNM_4R, crNM_5F (hc := hc) (hu := hu),
        crNM_6F (hc := hc) (hu := hu), crNM_LR]
      simp [Option.bind_some, re_apply, cf_emit_g, pure_apply, bind_apply, crdBlkN, cf_emitG_re, cf_emitG_bo, ek,
        Functor.map, StateT.map, mtcReG]

/-- **Step `7` on a `%next` or `%pick` goal under `mono` `&`, rings included** (`crD7Nm`): the
blocks `opt` (`call-op ~ pro-opt`: `%caf` on a ring) and `pes` (`call-op `sub-pes pro-pes`:
`%csf`). -/
theorem crd_blkMR_next (h7 : slot? 7 ctx = some compK) (x : GenRest) (hx : x.NoSoft) (SOF V5 V2 PV : Noun)
    (subNed : Need) (p q : Nomm) (b : Bell) (rin : Option Noun) (hro : RinOk rin) (region : List Nat) (sup : Noun)
    (goal : CGoalL CSet) (hgd : goal ≠ CGoalL.done) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 (unitNoun id rin) PV
      (crSubj (A 0) (crdN p q b) goal.toNoun (listNoun A region) sup (compCore g x ctx))) crDKc7
      = (crdBlockMMR b rin (flattenNeed subNed) goal g).map fun p => crdBlkN p x := by
  cases rin with
  | none =>
    rw [crdBlockMMR_none]
    exact crd_blkM_next h7 x hx SOF V5 V2 PV subNed p q b region sup goal hgd g hinv
  | some u => exact crd_blkMS_next h7 x hx SOF V5 V2 PV subNed p q b u hro region sup goal hgd g hinv

/-! ## Steps `7` to `14` with `rin` the noun `RIN` -/

theorem crd_7to9MR (h7 : slot? 7 ctx = some compK) (x : GenRest) (hx : x.NoSoft) (SOF V5 V2 RIN PV : Noun)
    (subNed : Need) (p q : Nomm) (b : Bell) (rin : Option Noun) (RG sup : Noun) (goal : CGoalL CSet) (g : Gen (TreapMap mugF))
    (hblk : nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 RIN PV
      (crSubj (A 0) (crdN p q b) goal.toNoun RG sup (compCore g x ctx))) crDKc7
      = (crdBlockMMR b rin (flattenNeed subNed) goal g).map fun p => crdBlkN p x) :
    nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 RIN PV
      (crSubj (A 0) (crdN p q b) goal.toNoun RG sup (compCore g x ctx))) crDKr7
      = (crdBlockMMR b rin (flattenNeed subNed) goal g).bind fun r =>
          (monoTryCall subNed r.1.1 r.1.2.1 r.1.2.2 r.2).bind fun r' =>
          nock (crdS9 (crdArg (Need.this r.1.2.1) r'.1).goal.toNoun (C (Need.this r.1.2.1).toNoun (A r'.1))
            (C (A r.1.1) (C (A r.1.2.1) (A r.1.2.2))) SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2
            RIN PV (crSubj (A 0) (crdN p q b) goal.toNoun RG sup (compCore r'.2 x ctx))) crDKr10 := by
  have h15 := cr_ctx15 h7
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hD := mtc_at
  simp only [crSubj, compCore, crdS6mR] at hblk ⊢
  cases eb : crdBlockMMR b rin (flattenNeed subNed) goal g with
  | none =>
    rw [eb] at hblk
    generalize comp.door = Dr at hblk hD ⊢
    unfold crDKr7
    simp [nock_exec, hblk]
  | some r =>
    obtain ⟨⟨opt, subPes, pes⟩, g1⟩ := r
    rw [eb] at hblk
    simp only [Option.map_some, crdBlkN] at hblk
    have hm := mtc_gate x hc subNed opt subPes pes g1
    simp only [compCore] at hm
    simp only [Option.bind_some]
    cases em : monoTryCall (Map := TreapMap mugF) subNed opt subPes pes g1 with
    | none =>
      rw [em] at hm
      generalize comp.door = Dr at hblk hD hm ⊢
      unfold crDKr7 crDKr8 crDKc8
      simp [nock_exec, hblk, hD, mtc_arm, hm]
    | some r' =>
      obtain ⟨o, g2⟩ := r'
      rw [em] at hm
      simp only [Option.map_some] at hm
      have hs := crn_has x o (hx o)
      simp only [Option.bind_some]
      rw [crd_arg_noun]
      generalize comp.door = Dr at hblk hD hm ⊢
      unfold crDKr7 crDKr8 crDKc8 crDKr9 crDKc9
      simp [nock_exec, hblk, hD, mtc_arm, hm, h15, hc, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, by_arm, by.arm_at,
        by.has.arm_at, has_arm, hs, Need.toNoun, Tag.this]

/-- **The model of the call from step `7` on under `mono` `&`, rings included**: `crdCallMM`
with `monoBlocksR b rin`. -/
noncomputable def crdCallMMR (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet))
    (cd : Bell → Option Bool) (p q : Nomm) (b : Bell) (rin : Option Noun) (subNed : Need) (goal : CGoalL CSet)
    (region : List Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let (subPes, o) ← monoBlocksR b rin subNed goal
  crdTailMR R cd p q ⟨Lazy.ofSure (lazyReg subPes), jmp0 o⟩ region

theorem crd_from7MTR (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)) (cd : Bell → Option Bool) (p q : Nomm)
    (hpn : PastAt ctx cd p) (region : List Nat) (x : GenRest) (hx : x.NoSoft) (SOF V5 V2 RIN PV sup : Noun)
    (subNed : Need) (b : Bell) (rin : Option Noun) (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) {Y : GenRest → GenRest → Prop}
    (hr : ∀ x, Y x x) (ht : ∀ {x y z : GenRest}, Y x y → Y y z → Y x z)
    (hblk : nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 RIN PV
      (crSubj (A 0) (crdN p q b) goal.toNoun (listNoun A region) sup (compCore g x ctx))) crDKc7
      = (crdBlockMMR b rin (flattenNeed subNed) goal g).map fun p => crdBlkN p x)
    (hq : ∀ s o g1, monoBlocksR b rin subNed goal g = some ((s, o), g1) →
      RunAtRT R ctx Y x (A 0) sup q (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 o)) region g1)
    (hp : ∀ x1, Y x x1 → ∀ s o g1 nexF g2 nexF' g3, monoBlocksR b rin subNed goal g = some ((s, o), g1) →
      crdFqR R q (jmp0 o) region g1 = some (nexF, g2) → pastL cd nexF p region g2 = some (nexF', g3) →
      RunAtRT R ctx Y x1 (A 0) sup p (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g3)
    (hcp : ∀ s o g1 nexF g2 nexF' g3 nexS g4, monoBlocksR b rin subNed goal g = some ((s, o), g1) →
      crdFqR R q (jmp0 o) region g1 = some (nexF, g2) → pastL cd nexF p region g2 = some (nexF', g3) →
      R p (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g3 = some (nexS, g4) →
      CopyH g4.re nexS.laz nexF'.laz) :
    ∃ x', Y x x' ∧ nock (crdS6mR SOF V5 (listNoun A (flattenNeed subNed)) subNed.toNoun V2 RIN PV
      (crSubj (A 0) (crdN p q b) goal.toNoun (listNoun A region) sup (compCore g x ctx))) crDKr7
      = (crdCallMMR R cd p q b rin subNed goal region g).map fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  rw [crd_7to9MR h7 x hx SOF V5 V2 RIN PV subNed p q b rin (listNoun A region) sup goal g hblk]
  unfold crdCallMMR
  rw [monoBlocksR_eq]
  simp only [bind_apply]
  cases eb : crdBlockMMR b rin (flattenNeed subNed) goal g with
  | none => exact ⟨x, hr x, rfl⟩
  | some r =>
    obtain ⟨⟨opt, s, pes⟩, g1⟩ := r
    simp only [Option.bind_some]
    cases em : monoTryCall (Map := TreapMap mugF) subNed opt s pes g1 with
    | none => exact ⟨x, hr x, rfl⟩
    | some r' =>
      obtain ⟨o, g2⟩ := r'
      have hmb : monoBlocksR b rin subNed goal g = some ((s, o), g2) := by
        rw [monoBlocksR_eq]; simp [bind_apply, eb, em, pure_apply, Functor.map, StateT.map]
      simp only [Option.bind_some, pure_apply]
      have ht' := crd_ctailRT h7 hcode R cd p q hpn region x (A 0) (C (A 0) (C b.toNoun (A 0))) sup goal.toNoun
        (crdArg (Need.this s) o) (C (Need.this s).toNoun (A o)) (C (A opt) (C (A s) (A pes))) SOF V5
        (listNoun A (flattenNeed subNed)) subNed.toNoun V2 RIN PV g2 hr ht (hq s o g2 hmb)
        (fun x1 hy1 nexF g3 nexF' g4 e e3 => hp x1 hy1 s o g2 nexF g3 nexF' g4 hmb e e3)
        (fun nexF g3 nexF' g4 nexS g5 e e3 e4 => hcp s o g2 nexF g3 nexF' g4 nexS g5 hmb e e3 e4)
      rw [crdArg_this] at ht'
      exact ht'

/-! ## The call through a ring, steps `0` to `14`, and the case `%2` -/

/-- **The call under `mono` `&` through a ring, the rest threaded** (`crd_callMT` with
`CallNounMTG`): steps `0` to `6` (`crd_head6MTG`, the need step from `x` to `x'`), the blocks
with `rin` (`crd_blkMR_done`, `crd_blkMR_next`), then `crd_from7MTR` from `x'`. -/
theorem crd_callMTG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)) (cd : Bell → Option Bool)
    (msup : Option Nomm) (p q : Nomm) (hpn : PastAt ctx cd p) (b : Bell) (nb : NeedOrd) (sur SOF : Noun)
    (rin : Option Noun) (hro : RinOk rin) {Y : GenRest → GenRest → Prop}
    (hr : ∀ x, Y x x) (ht : ∀ {x y z : GenRest}, Y x y → Y y z → Y x z)
    (x x' : GenRest) (hy : Y x x') (hx' : x'.NoSoft)
    (hn : CallNounMTG msup ctx p q b nb sur x x' (A 0) SOF rin) (PV : Noun) (goal : CGoalL CSet) (region : List Nat)
    (g : Gen (TreapMap mugF))
    (hinv : ∀ subNed g1, needOrdAllocRegs nb g = some (subNed, g1) → GInv g1 goal)
    (hq : ∀ subNed g1 s o g2, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      RunAtRT R ctx Y x' (A 0) (unitNoun Nomm.toNoun msup) q (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 o)) region g2)
    (hp : ∀ x1, Y x' x1 → ∀ subNed g1 s o g2 nexF g3 nexF' g4, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      crdFqR R q (jmp0 o) region g2 = some (nexF, g3) → pastL cd nexF p region g3 = some (nexF', g4) →
      RunAtRT R ctx Y x1 (A 0) (unitNoun Nomm.toNoun msup) p (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g4)
    (hcp : ∀ subNed g1 s o g2 nexF g3 nexF' g4 nexS g5, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      crdFqR R q (jmp0 o) region g2 = some (nexF, g3) → pastL cd nexF p region g3 = some (nexF', g4) →
      R p (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g4 = some (nexS, g5) →
      CopyH g5.re nexS.laz nexF'.laz) :
    ∃ x'', Y x x'' ∧ nock (C PV (crSubj (A 0) (crdN p q b) goal.toNoun (listNoun A region) (unitNoun Nomm.toNoun msup)
      (compCore g x ctx))) crDCall
      = ((needOrdAllocRegs nb >>= fun subNed => crdCallMMR R cd p q b rin subNed goal region) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x'') := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  rw [crd_head6MTG h7 msup p q b nb sur x x' (A 0) SOF rin hn PV goal.toNoun region g, bind_apply]
  cases e : needOrdAllocRegs nb g with
  | none => exact ⟨x, hr x, rfl⟩
  | some r =>
    obtain ⟨subNed, g1⟩ := r
    simp only [Option.bind_some]
    have hblk : nock (crdS6mR SOF sur (listNoun A (flattenNeed subNed)) subNed.toNoun nb.toNoun (unitNoun id rin) PV
        (crSubj (A 0) (crdN p q b) goal.toNoun (listNoun A region) (unitNoun Nomm.toNoun msup) (compCore g1 x' ctx)))
        crDKc7 = (crdBlockMMR b rin (flattenNeed subNed) goal g1).map fun p => crdBlkN p x' := by
      cases goal with
      | done => exact crd_blkMR_done hc x' SOF sur nb.toNoun PV subNed p q b rin hro region _ g1
      | next laz th =>
        exact crd_blkMR_next h7 x' hx' SOF sur nb.toNoun PV subNed p q b rin hro region _ _ (by simp) g1
          (hinv subNed g1 e)
      | pick z o =>
        exact crd_blkMR_next h7 x' hx' SOF sur nb.toNoun PV subNed p q b rin hro region _ _ (by simp) g1
          (hinv subNed g1 e)
    obtain ⟨x'', hy2, h⟩ := crd_from7MTR h7 hcode R cd p q hpn region x' hx' SOF sur nb.toNoun (unitNoun id rin) PV _
      subNed b rin goal g1 hr ht hblk
      (fun s o g2 h => hq subNed g1 s o g2 e h)
      (fun x1 hy1 s o g2 nexF g3 nexF' g4 h h3 h4 => hp x1 hy1 subNed g1 s o g2 nexF g3 nexF' g4 e h h3 h4)
      (fun s o g2 nexF g3 nexF' g4 nexS g5 h h3 h4 h5 => hcp subNed g1 s o g2 nexF g3 nexF' g4 nexS g5 e h h3 h4 h5)
    exact ⟨x'', ht hy hy2, h⟩

/-- **The model of the call under `mono` `&`, rings included** (`callDMR` with the runs `R`, a
known callee, no key, not dropped): `+need-ord-alloc-regs`, then `crdCallMMR` at `env.ring b`. -/
theorem crd_model_callMR (env : CallEnv) (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet))
    (p q : Nomm) (b : Bell) (nb : NeedOrd) (goal : CGoalL CSet) (region : List Nat)
    (hdr : crdDrop (env.pure b) goal = false) (hnb : env.need b = some nb) :
    (callDMR env (R p) (R q) p q b Option.none goal region : CM (TreapMap mugF) (NextL CSet))
      = needOrdAllocRegs nb >>= fun subNed => crdCallMMR R env.cod p q b (env.ring b) subNed goal region := by
  cases goal with
  | next laz th =>
    simp only [crdDrop] at hdr
    simp only [callDMR, hdr, hnb, Bool.false_eq_true, if_false]
    unfold crdCallMMR crdTailMR crdFqR
    rfl
  | done =>
    simp only [callDMR, hnb]
    unfold crdCallMMR crdTailMR crdFqR
    rfl
  | pick z o =>
    simp only [callDMR, hnb]
    unfold crdCallMMR crdTailMR crdFqR
    rfl

/-- `runLCMR env true` on a direct call is `callDMR`. -/
theorem runLCMR_n2_directM (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (b : Bell) (key : Option Noun)
    (goal : CGoalL CSet) (region : List Nat) :
    (runLCMR env true msup (Nomm.n2 p q (some (b, key))) goal region : CM (TreapMap mugF) (NextL CSet))
      = callDMR env (runLCMR env true msup p) (runLCMR env true msup q) p q b key goal region := by
  rw [runLCMR]; rfl

/-- **The model of the case at `mono` `&` through a ring**: `crdCallMMR` with the runs
`runLCMR env true msup`. -/
theorem crd_model_n2MR (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (b : Bell) (nb : NeedOrd)
    (goal : CGoalL CSet) (region : List Nat) (hdr : crdDrop (env.pure b) goal = false)
    (hnb : env.need b = some nb) :
    (runLCMR env true msup (Nomm.n2 p q (some (b, Option.none))) goal region : CM (TreapMap mugF) (NextL CSet))
      = needOrdAllocRegs nb >>= fun subNed =>
          crdCallMMR (runLCMR env true msup) env.cod p q b (env.ring b) subNed goal region := by
  rw [runLCMR_n2_directM]
  exact crd_model_callMR env (runLCMR env true msup) p q b nb goal region hdr hnb

/-- **The case `%2` on a direct call through a ring under `mono` `&`, threaded**
(`comp_run_n2_callMonoTT` against `runLCMR`): a callee with no memo key, not dropped, its ring
`env.ring b = rin` a ring noun with no hot driver (`CallNounMTG`), the need step from `x` to
`x'`, then the tail from `x'` with the blocks of `monoBlocksR b rin`. -/
theorem comp_run_n2_callMonoTTG (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm)
    (hpn : PastAt ctx env.cod p) (b : Bell) (hcd : CodePure cod env b) (nb : NeedOrd) (sur SOF : Noun)
    (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF)) (hinv : GInv g goal)
    (hdr : crdDrop (env.pure b) goal = false) (rin : Option Noun) (hri : env.ring b = rin) (hro : RinOk rin)
    (hnb : env.need b = some nb)
    {Y : GenRest → GenRest → Prop} (hr : ∀ x, Y x x) (ht : ∀ {x y z : GenRest}, Y x y → Y y z → Y x z)
    (x x' : GenRest) (hy : Y x x') (hx' : x'.NoSoft) (hT : CallNounMTG msup ctx p q b nb sur x x' (A 0) SOF rin)
    (hq : ∀ subNed g1 s o g2, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      RunAtRT (runLCMR env true msup) ctx Y x' (A 0) (unitNoun Nomm.toNoun msup) q
        (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 o)) region g2)
    (hp : ∀ x1, Y x' x1 → ∀ subNed g1 s o g2 nexF g3 nexF' g4, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      crdFqR (runLCMR env true msup) q (jmp0 o) region g2 = some (nexF, g3) →
      pastL env.cod nexF p region g3 = some (nexF', g4) →
      RunAtRT (runLCMR env true msup) ctx Y x1 (A 0) (unitNoun Nomm.toNoun msup) p
        (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g4)
    (hcp : ∀ subNed g1 s o g2 nexF g3 nexF' g4 nexS g5, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      crdFqR (runLCMR env true msup) q (jmp0 o) region g2 = some (nexF, g3) →
      pastL env.cod nexF p region g3 = some (nexF', g4) →
      runLCMR env true msup p (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g4 = some (nexS, g5) →
      CopyH g5.re nexS.laz nexF'.laz) :
    ∃ x'', Y x x'' ∧ nock (crSubj (A 0) (Nomm.n2 p q (some (b, Option.none))).toNoun goal.toNoun (listNoun A region)
        (unitNoun Nomm.toNoun msup) (compCore g x ctx)) crDol
      = (runLCMR env true msup (Nomm.n2 p q (some (b, Option.none))) goal region g).map
          fun r => C r.1.goal.toNoun (genNoun r.2 x'') := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  obtain ⟨V, hgot, hv⟩ := hcd
  obtain ⟨x'', hy2, hcall⟩ := crd_callMTG h7 hcode (runLCMR env true msup) env.cod msup p q hpn b nb sur SOF rin hro
    hr ht x x' hy hx' hT (loob (env.pure b)) goal region g (fun _ _ e => ginv_noar hinv e) hq hp hcp
  refine ⟨x'', hy2, ?_⟩
  rw [crd_model_n2MR env msup p q b nb goal region hdr hnb, hri, crd_noun, cr_disp_n2, cr2_dir, crd_eq]
  have hpure := crd_pure hc hcode p.toNoun q.toNoun b.toNoun (unitNoun id Option.none) V _ (A 0)
    goal.toNoun (listNoun A region) (unitNoun Nomm.toNoun msup) g x hgot hv
  have ht0 := crd_test_all h7 (C (A 2) (C p.toNoun (C q.toNoun (C (A 0) (C b.toNoun (unitNoun id Option.none))))))
    (A 0) (listNoun A region) (unitNoun Nomm.toNoun msup) (env.pure b) goal g x
  rw [hdr] at ht0
  simp only [crdN] at hcall
  have hu : unitNoun (id : Noun → Noun) Option.none = A 0 := rfl
  rw [hu] at hpure ht0 ⊢
  have hl : loob false = A 1 := rfl
  rw [hl] at ht0
  unfold crDHead
  simp [nock_exec, hpure, ht0, hcall]

/-! ## The blocks with a ring keep the counters (copies of `km_crdBlockMM` .. `crd_goalsM`) -/

theorem km_crdBlockMMR (b : Bell) (rin : Option Noun) (subV : List Nat) (goal : CGoalL CSet) :
    KM (crdBlockMMR b rin subV goal : CM (TreapMap mugF) (Nat × Nat × Nat)) := by
  cases goal with
  | done =>
    exact KM.bind' KM.re' fun _ => KM.bind' (KM.emit' _) fun _ => KM.bind' (KM.emit' _) fun _ => KM.pure' _
  | next laz th =>
    exact KM.bind' (km_simpleNextL _) fun nex => KM.bind' (km_kerf nex) fun r => by
      obtain ⟨out, pro⟩ := r
      exact KM.bind' KM.re' fun _ => KM.bind' KM.re' fun _ => KM.bind' (KM.emit' _) fun _ =>
        KM.bind' KM.re' fun _ => KM.bind' KM.re' fun _ => KM.bind' (KM.emit' _) fun _ =>
          KM.bind' (KM.emit' _) fun _ => KM.pure' _
  | pick z o =>
    exact KM.bind' (km_simpleNextL _) fun nex => KM.bind' (km_kerf nex) fun r => by
      obtain ⟨out, pro⟩ := r
      exact KM.bind' KM.re' fun _ => KM.bind' KM.re' fun _ => KM.bind' (KM.emit' _) fun _ =>
        KM.bind' KM.re' fun _ => KM.bind' KM.re' fun _ => KM.bind' (KM.emit' _) fun _ =>
          KM.bind' (KM.emit' _) fun _ => KM.pure' _

theorem km_monoBlocksR (b : Bell) (rin : Option Noun) (subNed : Need) (goal : CGoalL CSet) :
    KM (monoBlocksR b rin subNed goal : CM (TreapMap mugF) (Nat × Nat)) := by
  rw [monoBlocksR_eq]
  exact KM.bind' (km_crdBlockMMR _ _ _ _) fun r => by
    obtain ⟨opt, s, pes⟩ := r
    exact KM.bind' (km_monoTryLoop _ _ _ _) fun _ => KM.pure' _

theorem crdBlockMMR_sub {b : Bell} {rin : Option Noun} {subV : List Nat} {goal : CGoalL CSet} {g g' : Gen (TreapMap mugF)}
    {opt s pes : Nat} (h : crdBlockMMR b rin subV goal g = some ((opt, s, pes), g')) : g.re ≤ s ∧ s < g'.re := by
  cases goal with
  | done =>
    simp only [crdBlockMMR, bind_apply, re_apply, Option.bind_some, cf_emit_g, pure_apply, Option.some.injEq,
      Prod.mk.injEq] at h
    obtain ⟨⟨-, rfl, -⟩, rfl⟩ := h
    simp [cf_emitG_re]
  | next laz th =>
    simp only [crdBlockMMR] at h
    obtain ⟨nex, g1, e1, h⟩ := bind_some h
    obtain ⟨⟨out, pro⟩, g2, e2, h⟩ := bind_some h
    simp only [bind_apply, re_apply, Option.bind_some, cf_emit_g, pure_apply, Option.some.injEq,
      Prod.mk.injEq] at h
    obtain ⟨⟨-, rfl, -⟩, rfl⟩ := h
    have k1 := (km_simpleNextL _).keep _ _ _ e1
    have k2 := (km_kerf _).keep _ _ _ e2
    simp only [cf_emitG_re]
    omega
  | pick z o =>
    simp only [crdBlockMMR] at h
    obtain ⟨nex, g1, e1, h⟩ := bind_some h
    obtain ⟨⟨out, pro⟩, g2, e2, h⟩ := bind_some h
    simp only [bind_apply, re_apply, Option.bind_some, cf_emit_g, pure_apply, Option.some.injEq,
      Prod.mk.injEq] at h
    obtain ⟨⟨-, rfl, -⟩, rfl⟩ := h
    have k1 := (km_simpleNextL _).keep _ _ _ e1
    have k2 := (km_kerf _).keep _ _ _ e2
    simp only [cf_emitG_re]
    omega

theorem monoBlocksR_sub {b : Bell} {rin : Option Noun} {subNed : Need} {goal : CGoalL CSet} {g g' : Gen (TreapMap mugF)} {s o : Nat}
    (h : monoBlocksR b rin subNed goal g = some ((s, o), g')) : g.re ≤ s ∧ s < g'.re := by
  rw [monoBlocksR_eq] at h
  obtain ⟨⟨opt, s', pes⟩, g1, e1, h⟩ := bind_some h
  obtain ⟨o', g2, e2, h⟩ := bind_some h
  simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h
  obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
  have k1 := crdBlockMMR_sub e1
  have k2 := (km_monoTryLoop _ _ _ _).keep _ _ _ e2
  omega

theorem crd_goalsMR {nb : NeedOrd} {b : Bell} {rin : Option Noun} {goal : CGoalL CSet} {g g1 g2 : Gen (TreapMap mugF)} {subNed : Need}
    {s o : Nat} (hinv : GInv g goal) (e : needOrdAllocRegs nb g = some (subNed, g1))
    (eb : monoBlocksR b rin subNed goal g1 = some ((s, o), g2)) :
    GInv g2 (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 o)) ∧
      LInv g2.re g2.bo (Lazy.ofSure (lazyReg s : Sure CSet)) ∧
      g.re ≤ g2.re ∧ g.bo ≤ g2.bo ∧ g.re ≤ s := by
  obtain ⟨⟨k, hk⟩, hre, -, -⟩ := needOrdAllocRegs_spec nb g g1 subNed e
  have hd0 : g.drop = false := ginv_drop hinv
  have hd1 : g1.drop = false := by rw [hk]; exact hd0
  have hb1 : g1.bo = g.bo := by rw [hk]
  obtain ⟨l2, b2, d2⟩ := km_drop (km_monoBlocksR _ _ _ _) eb hd1
  obtain ⟨s1, s2⟩ := monoBlocksR_sub eb
  exact ⟨ginv_bunt_j d2 (jmpIn_jmp0 _ _), linv_reg s2, by omega, by omega, by omega⟩

/-! ## Threaded parts against `runLCMR`, the dropped call, and the case `%2` dropped or not -/

/-- **A threaded part against `runLCMR`** (`PartRT` with the runs through rings). -/
structure PartRTR (env : CallEnv) (msup : Option Nomm) (ctx : Noun) (X : GenRest → Noun → Noun → Prop)
    (Y : GenRest → GenRest → Prop) (n : Nomm) (region : List Nat) : Prop where
  link : ∀ (goal : CGoalL CSet) (g : Gen (TreapMap mugF)), GInv g goal →
    CompRunAtXT (runLCMR env true msup) ctx X Y n goal region g
  res : ResForR (runLCMR env true msup) n region
  past : PastAt ctx env.cod n

theorem crd_hpqMTR {E : GenRest → Prop} {Y : GenRest → GenRest → Prop} {msup : Option Nomm}
    (hYk : YOk (XM E msup) Y) (env : CallEnv) (p q : Nomm) {region : List Nat}
    (P : PartRTR env msup ctx (XM E msup) Y p region) (Q : PartRTR env msup ctx (XM E msup) Y q region) (b : Bell) (rin : Option Noun)
    (nb : NeedOrd) (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) (x : GenRest) (hx : x.NoSoft)
    (hE : E x) :
    (∀ subNed g1 s o g2, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      RunAtRT (runLCMR env true msup) ctx Y x (A 0) (unitNoun Nomm.toNoun msup) q
        (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 o)) region g2) ∧
    (∀ x1, Y x x1 → ∀ subNed g1 s o g2 nexF g3 nexF' g4, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      crdFqR (runLCMR env true msup) q (jmp0 o) region g2 = some (nexF, g3) →
      pastL env.cod nexF p region g3 = some (nexF', g4) →
      RunAtRT (runLCMR env true msup) ctx Y x1 (A 0) (unitNoun Nomm.toNoun msup) p
        (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g4) ∧
    (∀ subNed g1 s o g2 nexF g3 nexF' g4 nexS g5, needOrdAllocRegs nb g = some (subNed, g1) →
      monoBlocksR b rin subNed goal g1 = some ((s, o), g2) →
      crdFqR (runLCMR env true msup) q (jmp0 o) region g2 = some (nexF, g3) →
      pastL env.cod nexF p region g3 = some (nexF', g4) →
      runLCMR env true msup p (CGoalL.next (Lazy.ofSure (lazyReg s)) nexF'.th) region g4 = some (nexS, g5) →
      CopyH g5.re nexS.laz nexF'.laz) := by
  have hX : XM E msup x (A 0) (unitNoun Nomm.toNoun msup) := ⟨hE, rfl, rfl⟩
  refine ⟨fun subNed g1 s o g2 e eb => Q.link _ g2 (crd_goalsMR hinv e eb).1 x _ _ hx hX,
    fun x1 hy1 subNed g1 s o g2 nexF g3 nexF' g4 e eb ef e3 => ?_,
    fun subNed g1 s o g2 nexF g3 nexF' g4 nexS g5 e eb ef e3 e4 => ?_⟩
  · obtain ⟨hq2, hp2, -⟩ := crd_goalsMR hinv e eb
    exact P.link _ _ (tail_pgoal hq2 hp2 (crd_fq_resR Q.res hq2.2.1 hq2.2.2 ef) e3).1 x1 _ _ (hYk.soft hx hy1)
      (hYk.pres hX hy1)
  · obtain ⟨hq2, hp2, -⟩ := crd_goalsMR hinv e eb
    have R2 := crd_fq_resR Q.res hq2.2.1 hq2.2.2 ef
    have ap : (lregs (Lazy.ofSure (lazyReg s : Sure CSet)) ++ lregs (Lazy.ofSure (Sure.bunt : Sure CSet))).Nodup := by
      rw [lregs_bunt, List.append_nil]; exact hp2.2.1
    exact (tail_copyH hq2 hp2 ap R2 e3 (P.res _ _ _ _ (tail_pgoal hq2 hp2 R2 e3).1 e4)).1

theorem crd_model_dropMR (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (b : Bell) (key : Option Noun)
    (laz : Lazy CSet) (th : Jmp) (region : List Nat) (hpu : env.pure b = true)
    (hne : Lazy.noneEquivalentL laz = true) :
    (runLCMR env true msup (Nomm.n2 p q (some (b, key))) (CGoalL.next laz th) region
        : CM (TreapMap mugF) (NextL CSet))
      = crdTailMR (runLCMR env true msup) env.cod p q ⟨Lazy.ofSure Sure.bunt, th⟩ region := by
  rw [runLCMR_n2_directM]
  simp only [callDMR, hpu, hne, Bool.and_self, if_true]
  unfold crdTailMR crdFqR
  rfl

theorem comp_run_n2_dropMonoTR (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q : Nomm)
    (hpn : PastAt ctx env.cod p) (b : Bell) (key : Option Noun) (hcd : CodePure cod env b)
    (laz : Lazy CSet) (th : Jmp) (region : List Nat) (g : Gen (TreapMap mugF)) (hpu : env.pure b = true)
    (hne : Lazy.noneEquivalentL laz = true) (x : GenRest) (mono sup : Noun) {Y : GenRest → GenRest → Prop}
    (hr : ∀ x, Y x x) (ht : ∀ {x y z : GenRest}, Y x y → Y y z → Y x z)
    (hq : RunAtRT (runLCMR env true msup) ctx Y x mono sup q (CGoalL.next (Lazy.ofSure Sure.bunt) th) region g)
    (hp : ∀ x1, Y x x1 → ∀ nexF g2 nexF' g3, crdFqR (runLCMR env true msup) q th region g = some (nexF, g2) →
      pastL env.cod nexF p region g2 = some (nexF', g3) →
      RunAtRT (runLCMR env true msup) ctx Y x1 mono sup p (CGoalL.next (Lazy.ofSure Sure.bunt) nexF'.th) region g3)
    (hcp : ∀ nexF g2 nexF' g3 nexS g4, crdFqR (runLCMR env true msup) q th region g = some (nexF, g2) →
      pastL env.cod nexF p region g2 = some (nexF', g3) →
      runLCMR env true msup p (CGoalL.next (Lazy.ofSure Sure.bunt) nexF'.th) region g3 = some (nexS, g4) →
      CopyH g4.re nexS.laz nexF'.laz) :
    RunAtRT (runLCMR env true msup) ctx Y x mono sup (Nomm.n2 p q (some (b, key))) (CGoalL.next laz th) region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  obtain ⟨V, hgot, hv⟩ := hcd
  obtain ⟨x', hy, hdr⟩ := crd_dropRT h7 hcode (runLCMR env true msup) env.cod p q hpn region x mono
    (C (A 0) (C b.toNoun (unitNoun id key))) sup laz th g hr ht hq hp hcp
  refine ⟨x', hy, ?_⟩
  rw [crd_model_dropMR env msup p q b key laz th region hpu hne, crd_noun, cr_disp_n2, cr2_dir, crd_eq]
  have hpure := crd_pure hc hcode p.toNoun q.toNoun b.toNoun (unitNoun id key) V _ mono
    (CGoalL.next laz th).toNoun (listNoun A region) sup g x hgot hv
  rw [hpu] at hpure
  have ht0 := crd_test h7 (C (A 2) (C p.toNoun (C q.toNoun (C (A 0) (C b.toNoun (unitNoun id key)))))) mono
    (listNoun A region) sup laz th g x
  rw [hne] at ht0
  unfold crDHead
  simp [nock_exec, hpure, ht0, loob, hdr]

/-- **The direct call under `mono` `&` through a ring, threaded through its parts**
(`comp_run_n2_directXTT` against `runLCMR`): dropped (`comp_run_n2_dropMonoTR`) or not (the need
step to `x'`, then `comp_run_n2_callMonoTTG`), its ring `env.ring b = rin` a ring noun, `p` and
`q` threaded parts against `runLCMR` (`PartRTR`). -/
theorem comp_run_n2_directXTTG {E : GenRest → Prop} {Y : GenRest → GenRest → Prop} {msup : Option Nomm}
    (hYk : YOk (XM E msup) Y) (h7 : slot? 7 ctx = some compK) {cod : Noun}
    (hcode : slot? 52 ctx = some cod) (env : CallEnv) (p q : Nomm) {region : List Nat}
    (P : PartRTR env msup ctx (XM E msup) Y p region) (Q : PartRTR env msup ctx (XM E msup) Y q region) (b : Bell)
    (hcd : CodePure cod env b) (rin : Option Noun) (hri : env.ring b = rin) (hro : RinOk rin)
    (nb : NeedOrd) (hE : ∀ x, x.NoSoft → E x → ∃ x' sur SOF, Y x x' ∧
      CallNounMTG msup ctx p q b nb sur x x' (A 0) SOF rin)
    (hnb : env.need b = some nb)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx (XM E msup) Y (Nomm.n2 p q (some (b, Option.none))) goal region g := by
  cases hdr : crdDrop (env.pure b) goal with
  | false =>
    rintro x mono sup hx ⟨hEx, rfl, rfl⟩
    obtain ⟨x', sur, SOF, hy, hT⟩ := hE x hx hEx
    have hx' := hYk.soft hx hy
    have hE' : E x' := (hYk.pres (show XM E msup x (A 0) (unitNoun Nomm.toNoun msup) from ⟨hEx, rfl, rfl⟩) hy).1
    obtain ⟨hq, hp, hcp⟩ := crd_hpqMTR hYk env p q P Q b rin nb goal g hinv x' hx' hE'
    exact comp_run_n2_callMonoTTG h7 hcode env msup p q P.past b hcd nb sur SOF goal region g hinv hdr rin hri hro hnb
      hYk.refl hYk.trans x x' hy hx' hT hq hp hcp
  | true =>
    cases goal with
    | done => simp [crdDrop] at hdr
    | pick z o => simp [crdDrop] at hdr
    | next laz th =>
      simp only [crdDrop, Bool.and_eq_true] at hdr
      obtain ⟨hpu, hne⟩ := hdr
      have hd : g.drop = false := hinv.2.1
      have hj : JmpIn (· < g.re) th := hinv.2.2
      rintro x mono sup hx ⟨hEx, rfl, rfl⟩
      have hX : XM E msup x (A 0) (unitNoun Nomm.toNoun msup) := ⟨hEx, rfl, rfl⟩
      exact comp_run_n2_dropMonoTR h7 hcode env msup p q P.past b Option.none hcd laz th region g hpu hne x _ _
        hYk.refl hYk.trans
        (Q.link _ g (ginv_bunt_j hd hj) x _ _ hx hX)
        (fun x1 hy1 nexF g2 nexF' g3 e e3 =>
          P.link _ _ (tail_pgoal (ginv_bunt_j hd hj) (linv_bunt _ _) (crd_fq_resR Q.res hd hj e) e3).1 x1 _ _
            (hYk.soft hx hy1) (hYk.pres hX hy1))
        (fun nexF g2 nexF' g3 nexS g4 e e3 e4 => by
          have R2 := crd_fq_resR Q.res hd hj e
          exact (tail_copyH (ginv_bunt_j hd hj) (linv_bunt _ _) (by simp [lregs_bunt]) R2 e3
            (P.res _ _ _ _ (tail_pgoal (ginv_bunt_j hd hj) (linv_bunt _ _) R2 e3).1 e4)).1)

