/-!
# `+mede` at a soft rest (README Gaps 19 (g))

Generated by `tools/gen/softmede.py`; do not edit.  `+mede` (the case `%1` on a `%next` goal)
reads `soft.gen` only in `+crash-need` (line 5961: `?:  (~(has by soft.gen) o)  (soft-ask ..)`),
which it reaches only where the constant is an atom and the need asks a cell.  After a soft tail
call the goal holds the bond `+soft-bond` made, whose block is a key of `soft`, so `mdP`
(`x.SoftOut` at every visited block) fails there; `mdPF` asks `x.SoftOut o` or `MedeFits`
(no `+crash-need` on the need `+sure-require-look` gives).  The model `medeL` has no
`+soft-ask`, so where `MedeFits` fails at a soft block the model (`runLCS`'s `%1`, a lift of
`runL`) and the Hoon part ways: the hypothesis is needed, not an artefact of the proof.

* `MedeFits som ned`: the constant has a cell wherever the need asks one;
* `md_loopF`, `md_gateF`, **`comp_mede_allF`**: `md_loop`, `md_gate`, `comp_mede_all` with
  `x.SoftOut o ∨ MedeFits`;
* **`comp_run_n1_nextF`**: the case `%1` on a `%next` goal at any rest, under `WalkP (mdPF x k)`.
-/

namespace Formalization
namespace Compiler

open Nock Pill Hoon SkaModel SkaModel.Comp

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

variable {ctx : Noun}

/-- **The constant fits the need**: no `+crash-need` in `+mede`'s loop (a cell wherever the need
is `^` or `%both`). -/
def MedeFits : Noun → Need → Prop
  | Noun.cell a b, Need.pair p q => MedeFits a p ∧ MedeFits b q
  | Noun.cell a b, Need.both _ h t => MedeFits a h ∧ MedeFits b t
  | Noun.atom _, Need.pair _ _ => False
  | Noun.atom _, Need.both _ _ _ => False
  | _, _ => True

/-- What the walk of `+mede` needs at a visited block: not a key of `soft`, or no `+crash-need`
on the need `+sure-require-look` gives there; and no lock at axis `0`. -/
def mdPF (x : GenRest) (som : Noun) (o : Nat) (s : Sure CSet) : Prop :=
  (∀ (g : Gen (TreapMap mugF)) ned g1, sureRequireLook s g = some (ned, g1) → x.SoftOut o ∨ MedeFits som ned) ∧ lok0 o s

theorem mdPF_of_mdP {x : GenRest} {som : Noun} {o : Nat} {s : Sure CSet} (h : mdP x o s) : mdPF x som o s :=
  ⟨fun _ _ _ _ => Or.inl h.1, h.2⟩

theorem md_loopF (hc : CompIn ctx) (x : GenRest) (SUR GI B TH LAZ : Noun) (o o' : Nat)
 : ∀ (ned : Need) (som : Noun) (g : Gen (TreapMap mugF)), (x.SoftOut o' ∨ MedeFits som ned) →
    nock (mdT x ctx SUR GI B TH LAZ o o' ned som g) mdLoop
      = (medeLoop o' som ned g).map fun p => genNoun p.2 x := by
  have hD2 := comp_add_ops_at
  have hD4 := comp_crn_at
  intro ned
  induction ned with
  | none =>
    intro som g hs
    nock_open mdLoop
    simp [nock_exec, mdT, Need.toNoun, Tag.none, medeLoop, pure, StateT.pure]
  | this r =>
    intro som g hs
    have hao := comp_add_ops x hc g o' [Pole.imm som r]
    simp only [listNoun, Pole.toNoun, Tag.imm] at hao
    simp only [compCore] at hao
    unfold mdT
    nock_open mdLoop
    generalize comp.door = Dr at hD2 hD4 hao ⊢
    simp [nock_exec, Need.toNoun, Tag.none, Tag.this, medeLoop, hD2, comp_add_ops_arm, hao]
  | pair p q ihp ihq =>
    intro som g hs
    obtain ⟨u, v, hp⟩ := cd_need_cell p
    cases som with
    | atom n =>
      have hcr := comp_crash_need hc x g o' (Sum.inl n) (Need.pair p q) (hs.resolve_right (by simp [MedeFits]))
      simp only [compCore, crnAtomNoun, Need.toNoun, hp] at hcr
      unfold mdT
      nock_open mdLoop
      generalize comp.door = Dr at hD2 hD4 hcr ⊢
      simp [nock_exec, Need.toNoun, hp, Tag.none, Tag.this, medeLoop, hD4, comp_crn_arm, hcr]
    | cell a b =>
      have h1 := ihp a g (hs.imp id fun h => by simp only [MedeFits] at h; exact h.1)
      simp only [mdT, Need.toNoun, hp] at h1
      cases e1 : medeLoop o' a p g with
      | none =>
        rw [e1] at h1
        nock_open mdLoop
        simp [nock_exec, mdT, Need.toNoun, hp, Tag.none, Tag.this, medeLoop, h1, e1, bind,
          StateT.bind]
      | some r1 =>
        obtain ⟨u1, g1⟩ := r1
        rw [e1] at h1
        have h2 := ihq b g1 (hs.imp id fun h => by simp only [MedeFits] at h; exact h.2)
        simp only [mdT, Need.toNoun] at h2
        nock_open mdLoop
        simp [nock_exec, mdT, Need.toNoun, hp, Tag.none, Tag.this, medeLoop, h1, e1, h2, bind,
          StateT.bind]
  | both r h t ihh iht =>
    intro som g hs
    cases som with
    | atom n =>
      have hcr := comp_crash_need hc x g o' (Sum.inl n) (Need.both r h t) (hs.resolve_right (by simp [MedeFits]))
      simp only [compCore, crnAtomNoun, Need.toNoun, Tag.both] at hcr
      unfold mdT
      nock_open mdLoop
      generalize comp.door = Dr at hD2 hD4 hcr ⊢
      simp [nock_exec, Need.toNoun, Tag.none, Tag.this, Tag.both, medeLoop, hD4, comp_crn_arm,
        hcr]
    | cell a b =>
      have hao := comp_add_ops x hc g o' [Pole.imm (C a b) r]
      simp only [listNoun, Pole.toNoun, Tag.imm] at hao
      simp only [compCore] at hao
      cases e0 : addOps (Map := TreapMap mugF) o' [Pole.imm (C a b) r] g with
      | none =>
        rw [e0] at hao
        unfold mdT
        nock_open mdLoop
        generalize comp.door = Dr at hD2 hD4 hao ⊢
        simp [nock_exec, Need.toNoun, Tag.none, Tag.this, Tag.both, medeLoop, hD2, comp_add_ops_arm,
          hao, e0, bind, StateT.bind]
      | some r0 =>
        obtain ⟨u0, g0⟩ := r0
        rw [e0] at hao
        have h1 := ihh a g0 (hs.imp id fun h => by simp only [MedeFits] at h; exact h.1)
        simp only [mdT] at h1
        cases e1 : medeLoop o' a h g0 with
        | none =>
          rw [e1] at h1
          unfold mdT
          nock_open mdLoop
          generalize comp.door = Dr at hD2 hD4 hao h1 ⊢
          simp [nock_exec, Need.toNoun, Tag.none, Tag.this, Tag.both, medeLoop, hD2, comp_add_ops_arm,
            hao, e0, h1, e1, bind, StateT.bind]
        | some r1 =>
          obtain ⟨u1, g1⟩ := r1
          rw [e1] at h1
          have h2 := iht b g1 (hs.imp id fun h => by simp only [MedeFits] at h; exact h.2)
          simp only [mdT] at h2
          unfold mdT
          nock_open mdLoop
          generalize comp.door = Dr at hD2 hD4 hao h1 h2 ⊢
          simp [nock_exec, Need.toNoun, Tag.none, Tag.this, Tag.both, medeLoop, hD2, comp_add_ops_arm,
            hao, e0, h1, e1, h2, bind, StateT.bind]

/-- The gate of `+mede` with `mdPF`. -/
theorem md_gateF (hc : CompIn ctx) (hl : CompLib ctx) (x : GenRest) (G0 B TH LAZ : Noun)
    (o o' : Nat) (som : Noun) (sur : Sure CSet) (g : Gen (TreapMap mugF))
    (hs : ∀ ned g1, sureRequireLook sur g = some (ned, g1) → x.SoftOut o' ∨ MedeFits som ned)
    (h0 : ∀ y ∈ HoonSet.toList sur.lok, y ≠ 0) :
    nock (C mdGate (C (C (A o') (C sur.toNoun (genNoun g x)))
      (C (A o) (C B (C (C TH (C som LAZ)) (C comp.door (C G0 ctx))))))) mdGate
      = ((do let ned ← sureRequireLook sur; medeLoop o' som ned : CM (TreapMap mugF) Unit) g).map
        fun p => genNoun p.2 x := by
  have hsrl := comp_sure_require_look (x := x) hc hl g sur h0
  have hD := comp_srl_at
  simp only [compCore] at hsrl
  cases e : sureRequireLook sur g with
  | none =>
    rw [e] at hsrl
    nock_open mdGate
    generalize comp.door = Dr at hD hsrl ⊢
    simp [nock_exec, hD, comp_srl_arm, hsrl, e, bind, StateT.bind]
  | some p =>
    obtain ⟨ned, g1⟩ := p
    rw [e] at hsrl
    have hlp := md_loopF hc x sur.toNoun (genNoun g x) B TH LAZ o o' ned som g1 (hs ned g1 e)
    unfold mdT at hlp
    nock_open mdGate
    generalize comp.door = Dr at hD hsrl hlp ⊢
    simp [nock_exec, hD, comp_srl_arm, hsrl, e, hlp, bind, StateT.bind]

/-- **`+mede` on every lazy need at a soft rest.** -/
theorem comp_mede_allF (hc : CompIn ctx) (hl : CompLib ctx) (hm : CompMolds ctx) (x : GenRest)
    (g : Gen (TreapMap mugF)) (th : Jmp) (som : Noun) (laz : Lazy CSet) (hP : WalkP (mdPF x som) g.bo laz) :
    nock (C mdBat (C (C th.toNoun (C som laz.toNoun)) (compCore g x ctx))) mdBat
      = (medeL th som laz g).map fun p => C (A p.1) (genNoun p.2 x) := by
  have hm' := hm
  obtain ⟨hm191, ⟨Q, a2, M2, m2, v2, hQ, ha2, hM2, hm2, hv2⟩⟩ := hm'
  have he := cf_emit (x := x) hc g ⟨[], [], Termin.hop th⟩
  simp only [Blob.toNoun, listNoun, Termin.toNoun, Tag.hop] at he
  have hd : (cfEmitG ⟨[], [], Termin.hop th⟩ g).drop = g.drop := by unfold cfEmitG; split <;> rfl
  obtain ⟨bunt, hwa⟩ := comp_wl_arm hm comp.door (genNoun (cfEmitG ⟨[], [], Termin.hop th⟩ g) x)
  have hwl := comp_walk_lazy_all (ctx := ctx) hc hm191 x mdGate
    (C (A 0) (C v2 (genNoun (cfEmitG ⟨[], [], Termin.hop th⟩ g) x)))
    (C (A g.bo) (C mdBat (C (C th.toNoun (C som laz.toNoun))
      (C comp.door (C (genNoun (cfEmitG ⟨[], [], Termin.hop th⟩ g) x) ctx)))))
    comp.door (fun o sur => do let ned ← sureRequireLook sur; medeLoop o som ned) (mdPF x som)
    (fun o s g' hp => md_gateF hc hl x _ mdBat th.toNoun laz.toNoun g.bo o som s g' (hp.1 g') hp.2)
    laz g.bo (cfEmitG ⟨[], [], Termin.hop th⟩ g) hP
  have hD1 := comp_drop_at
  have hD2 := comp_emit_at
  have hD3 := comp_wl_at
  simp only [compCore] at hwa ⊢
  generalize comp.door = Dr at hD1 hD2 hD3 he hwa hwl ⊢
  cases hdr : g.drop
  · cases ew : Lazy.walkLazy (fun o sur => do let ned ← sureRequireLook sur; medeLoop o som ned) g.bo laz
        (cfEmitG ⟨[], [], Termin.hop th⟩ g) with
    | none =>
      rw [ew] at hwl
      have ew' := ew
      simp only [bind] at ew'
      nock_open mdBat
      simp [nock_exec, hD1, hD2, hD3, comp_emit_arm, he, hd, hdr, dropArm, cgModeNoun, hwa, hwl, hQ,
        ha2, hM2, hm2, hv2, medeL, cf_emit_g, bind, StateT.bind, get, getThe, MonadStateOf.get,
        StateT.get, pure, ew, ew']
    | some p =>
      obtain ⟨u, g3⟩ := p
      rw [ew] at hwl
      have ew' := ew
      simp only [bind] at ew'
      nock_open mdBat
      simp [nock_exec, hD1, hD2, hD3, comp_emit_arm, he, hd, hdr, dropArm, cgModeNoun, hwa, hwl, hQ,
        ha2, hM2, hm2, hv2, medeL, cf_emit_g, bind, StateT.bind, get, getThe, MonadStateOf.get,
        StateT.get, pure, StateT.pure, ew, ew']
  · nock_open mdBat
    simp [nock_exec, hD1, hD2, comp_emit_arm, he, hd, hdr, dropArm, cgModeNoun, medeL, cf_emit_g,
      bind, StateT.bind, get, getThe, MonadStateOf.get, StateT.get, pure, StateT.pure]

/-- **The case `%1` on a `%next` goal at any rest.** -/
theorem comp_run_n1_nextF (h7 : slot? 7 ctx = some compK) (k : Noun) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (g : Gen (TreapMap mugF)) (x : GenRest) (hP : WalkP (mdPF x k) g.bo laz)
    (mono sup : Noun) :
    nock (crSubj mono (Nomm.n1 k).toNoun (CGoalL.next laz th).toNoun (listNoun A region) sup (compCore g x ctx)) crDol
      = (runL (Nomm.n1 k) (CGoalL.next laz th) region g).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, hl, hm⟩ := comp_ctx_pill ctx h7
  simp only [Nomm.toNoun]
  rw [cr_disp_n1]
  have hmd := comp_mede_allF hc hl hm x g th k laz hP
  have hD := comp_md_at
  simp only [compCore, Jmp.toNoun] at hmd ⊢
  generalize comp.door = Dr at hmd hD ⊢
  nock_open crK1
  cases e : medeL th k laz g with
  | none =>
    rw [e] at hmd
    simp [nock_exec, crSubj, hD, comp_md_arm, CGoalL.toNoun, Jmp.toNoun, hmd, runL, e, bind, StateT.bind]
  | some r =>
    rw [e] at hmd
    simp [nock_exec, crSubj, hD, comp_md_arm, CGoalL.toNoun, Jmp.toNoun, hmd, runL, e, bind, StateT.bind,
      pure, StateT.pure, NextL.goal, Lazy.toNoun_ofSure, cr_bunt_noun, cr_bunt_lazy, jmp0, listNoun]

