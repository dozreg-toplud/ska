variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- `runLC_n2_none` (`CompIndirect.lean`) for `runLCMR env true`: the indirect call. -/
theorem runLCM_n2_noneG {env : CallEnv} {sup : Option Nomm} {p q : Nomm} {goal : CGoalL S} {region : List Nat}
    {g0 g' : Gen Map} {nex : NextL S}
    (h : runLCMR env true sup (Nomm.n2 p q Option.none) goal region g0 = some (nex, g')) :
    ∃ (nex0 : NextL S) (g1 : Gen Map) (out pro : Nat) (g2 : Gen Map) (o : Nat) (g3 : Gen Map)
      (nexF : NextL S) (g4 : Gen Map) (nexF' : NextL S) (g5 : Gen Map) (nexS : NextL S) (g6 : Gen Map),
      simpleNextL goal g0 = some (nex0, g1) ∧ kerf nex0 g1 = some ((out, pro), g2) ∧
      emit ⟨[], [Pole.nok g2.re (g2.re + 1) pro], Termin.hop (jmp0 out)⟩
        { { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 } = some (o, g3) ∧
      runLCMR env true sup q (CGoalL.next (Lazy.ofSure (lazyReg (g2.re + 1))) (jmp0 o)) region g3 = some (nexF, g4) ∧
      pastL env.cod nexF p region g4 = some (nexF', g5) ∧
      runLCMR env true sup p (CGoalL.next (Lazy.ofSure (lazyReg g2.re)) nexF'.th) region g5 = some (nexS, g6) ∧
      copyL nexS nexF'.laz g6 = some (nex, g') := by
  simp only [runLCMR, callLM_none, callL] at h
  obtain ⟨nex0, g1, h1, h⟩ := bind_some h
  obtain ⟨⟨out, pro⟩, g2, h2, h⟩ := bind_some h
  obtain ⟨rSub, ga, ha, h⟩ := bind_some h
  rw [re_apply] at ha
  simp only [Option.some.injEq, Prod.mk.injEq] at ha
  obtain ⟨rfl, rfl⟩ := ha
  obtain ⟨rFol, gb, hb, h⟩ := bind_some h
  rw [re_apply] at hb
  simp only [Option.some.injEq, Prod.mk.injEq] at hb
  obtain ⟨rfl, rfl⟩ := hb
  obtain ⟨o, g3, h3, h⟩ := bind_some h
  obtain ⟨nexF, g4, h4, h⟩ := bind_some h
  obtain ⟨nexF', g5, h5, h⟩ := bind_some h
  obtain ⟨nexS, g6, h6, h⟩ := bind_some h
  exact ⟨nex0, g1, out, pro, g2, o, g3, nexF, g4, nexF', g5, nexS, g6, h1, h2, h3, h4, h5, h6, h⟩

end

/-- **The tail through the runs' results.** -/
theorem tail_allRG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihq : ResForR (runLCMR env true msup) q region) (ihp : ResForR (runLCMR env true msup) p region)
    {Gq Gp : Lazy CSet} {thq : Jmp} {g g2 g3 g4 g' : Gen (TreapMap mugF)} {n2 n2' n1 nex : NextL CSet}
    (hq : GInv g (CGoalL.next Gq thq)) (hp : LInv g.re g.bo Gp) (ap : (lregs Gp ++ lregs Gq).Nodup)
    (e1 : runLCMR env true msup q (CGoalL.next Gq thq) region g = some (n2, g2))
    (e2 : pastL env.cod n2 p region g2 = some (n2', g3))
    (e3 : runLCMR env true msup p (CGoalL.next Gp n2'.th) region g3 = some (n1, g4))
    (e4 : copyL n1 n2'.laz g4 = some (nex, g')) :
    g.re ≤ g'.re ∧ g.bo ≤ g'.bo ∧ GInv g' nex.goal ∧ ∀ x ∈ lregs nex.laz, x ∈ lregs Gp ++ lregs Gq ∨ g.re ≤ x := by
  have R2 := ihq _ _ _ _ hq e1
  have P := tail_pgoal hq hp R2 e2
  have R1 := ihp _ _ _ _ P.1 e3
  exact tail_res hq hp ap R2 e2 R1 e4

/-- The tail with two fresh registers `rp < rq` below the state's counter,
both at or above `k`. -/
theorem tail_freshRG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihq : ResForR (runLCMR env true msup) q region) (ihp : ResForR (runLCMR env true msup) p region)
    {rp rq k : Nat} {thq : Jmp} {g1 g2 g3 g4 g' : Gen (TreapMap mugF)} {n2 n2' n1 nex : NextL CSet}
    (hk : k ≤ rp) (hpq : rp < rq) (hrq : rq < g1.re) (hd : g1.drop = false) (hj : JmpIn (· < g1.re) thq)
    (e1 : runLCMR env true msup q (CGoalL.next (Lazy.ofSure (lazyReg rq)) thq) region g1 = some (n2, g2))
    (e2 : pastL env.cod n2 p region g2 = some (n2', g3))
    (e3 : runLCMR env true msup p (CGoalL.next (Lazy.ofSure (lazyReg rp)) n2'.th) region g3 = some (n1, g4))
    (e4 : copyL n1 n2'.laz g4 = some (nex, g')) :
    g1.re ≤ g'.re ∧ g1.bo ≤ g'.bo ∧ GInv g' nex.goal ∧ ∀ x ∈ lregs nex.laz, k ≤ x := by
  obtain ⟨l, b, i, s⟩ := tail_allRG ihq ihp (ginv_reg_j hrq hd hj) (linv_reg (by omega))
    (by simp [lregs_reg]; omega) e1 e2 e3 e4
  refine ⟨l, b, i, fun x hx => ?_⟩
  rcases s x hx with e | e
  · simp [lregs_reg] at e; omega
  · omega

/-- The tail with two needs that ask nothing. -/
theorem tail_buntRG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihq : ResForR (runLCMR env true msup) q region) (ihp : ResForR (runLCMR env true msup) p region)
    {thq : Jmp} {g1 g2 g3 g4 g' : Gen (TreapMap mugF)} {n2 n2' n1 nex : NextL CSet}
    (hd : g1.drop = false) (hj : JmpIn (· < g1.re) thq)
    (e1 : runLCMR env true msup q (CGoalL.next (Lazy.ofSure Sure.bunt) thq) region g1 = some (n2, g2))
    (e2 : pastL env.cod n2 p region g2 = some (n2', g3))
    (e3 : runLCMR env true msup p (CGoalL.next (Lazy.ofSure Sure.bunt) n2'.th) region g3 = some (n1, g4))
    (e4 : copyL n1 n2'.laz g4 = some (nex, g')) :
    g1.re ≤ g'.re ∧ g1.bo ≤ g'.bo ∧ GInv g' nex.goal ∧ ∀ x ∈ lregs nex.laz, g1.re ≤ x := by
  obtain ⟨l, b, i, s⟩ := tail_allRG ihq ihp (ginv_bunt_j hd hj) (linv_bunt _ _) (by simp [lregs_bunt]) e1 e2 e3 e4
  refine ⟨l, b, i, fun x hx => ?_⟩
  rcases s x hx with e | e
  · simp [lregs_bunt] at e
  · exact e

/-- The end of `%3` and `%4`: a block, then `p` for a fresh register's goal. -/
theorem res_lastRG {env : CallEnv} {msup : Option Nomm} {p : Nomm} {region : List Nat}
    (ih : ResForR (runLCMR env true msup) p region) {goal : CGoalL CSet} {g g1 g2 g' : Gen (TreapMap mugF)} {r oc : Nat}
    {b : Blob} {nex : NextL CSet} (e : emit b g1 = some (oc, g2))
    (h : runLCMR env true msup p (CGoalL.next (Lazy.ofSure (lazyReg r)) (jmp0 oc)) region g2 = some (nex, g'))
    (hd : g1.drop = false) (hr : g.re ≤ r) (hr1 : r < g1.re) (hl : g.re ≤ g1.re) (hb : g.bo ≤ g1.bo) :
    GRes g goal g' nex := by
  obtain ⟨l2, b2, d2⟩ := km_drop (KM.emit' _) e hd
  exact gres_fresh (ih _ _ _ _ (ginv_reg oc (by omega) d2) h) hr (by omega) (by omega)

theorem res_n3RG {env : CallEnv} {msup : Option Nomm} {p : Nomm} {region : List Nat}
    (ih : ResForR (runLCMR env true msup) p region) : ResForR (runLCMR env true msup) (Nomm.n3 p) region := by
  intro goal g g' nex hi h
  have hd := ginv_drop hi
  cases goal with
  | next laz th =>
    simp only [runLCMR] at h
    split at h
    · exact ih _ _ _ _ hi h
    · obtain ⟨a, g1, e1, h⟩ := bind_some h
      obtain ⟨l1, b1, d1⟩ := km_drop (km_collapseLazyAtomL _) e1 hd
      rcases a with _ | ⟨r, o⟩
      · cases h
      · obtain ⟨⟨z, o'⟩, g2, e2, h⟩ := bind_some h
        obtain ⟨l2, b2, d2⟩ := km_drop (km_forl _ _) e2 d1
        obtain ⟨r', g3, e3, h⟩ := bind_some h
        obtain ⟨rfl, rfl⟩ := re_step e3
        obtain ⟨oc, g4, e4, h⟩ := bind_some h
        refine res_lastRG ih e4 h d2 ?_ ?_ ?_ ?_ <;> (try simp) <;> omega
  | pick z o =>
    simp only [runLCMR] at h
    obtain ⟨r, g1, e1, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e1
    obtain ⟨oc, g2, e2, h⟩ := bind_some h
    refine res_lastRG ih e2 h hd ?_ ?_ ?_ ?_ <;> (try simp) <;> omega
  | done =>
    simp only [runLCMR] at h
    obtain ⟨⟨o0, o1⟩, g1, e1, h⟩ := bind_some h
    obtain ⟨l1, b1, d1⟩ := km_drop km_doneBlocks e1 hd
    obtain ⟨r, g2, e2, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e2
    obtain ⟨oc, g3, e3, h⟩ := bind_some h
    refine res_lastRG ih e3 h d1 ?_ ?_ ?_ ?_ <;> (try simp) <;> omega

theorem res_n4RG {env : CallEnv} {msup : Option Nomm} {p : Nomm} {region : List Nat}
    (ih : ResForR (runLCMR env true msup) p region) : ResForR (runLCMR env true msup) (Nomm.n4 p) region := by
  intro goal g g' nex hi h
  have hd := ginv_drop hi
  cases goal with
  | done =>
    simp only [runLCMR] at h
    obtain ⟨pro, g1, e1, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e1
    obtain ⟨arg, g2, e2, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e2
    obtain ⟨o, g3, e3, h⟩ := bind_some h
    refine res_lastRG ih e3 h hd ?_ ?_ ?_ ?_ <;> (try simp) <;> omega
  | pick z o =>
    simp only [runLCMR] at h
    obtain ⟨pro, g1, e1, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e1
    obtain ⟨arg, g2, e2, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e2
    obtain ⟨o', g3, e3, h⟩ := bind_some h
    refine res_lastRG ih e3 h hd ?_ ?_ ?_ ?_ <;> (try simp) <;> omega
  | next laz th =>
    simp only [runLCMR] at h
    obtain ⟨a, g1, e1, h⟩ := bind_some h
    obtain ⟨l1, b1, d1⟩ := km_drop (km_collapseLazyAtomL _) e1 hd
    obtain ⟨⟨pro, th'⟩, g2, e2, h⟩ := bind_some h
    have k2 : g1.re ≤ g2.re ∧ g1.bo ≤ g2.bo ∧ g2.drop = false := by
      rcases a with _ | x
      · simp only at e2
        obtain ⟨r, g5, h5, e2⟩ := bind_some e2
        obtain ⟨rfl, rfl⟩ := re_step h5
        split at e2
        · simp only [pure, StateT.pure, Option.some.injEq, Prod.mk.injEq] at e2
          obtain ⟨-, rfl⟩ := e2
          exact ⟨by simp, by simp, d1⟩
        · cases e2
      · simp only [pure, StateT.pure, Option.some.injEq, Prod.mk.injEq] at e2
        obtain ⟨-, rfl⟩ := e2
        exact ⟨Nat.le_refl _, Nat.le_refl _, d1⟩
    obtain ⟨arg, g3, e3, h⟩ := bind_some h
    obtain ⟨rfl, rfl⟩ := re_step e3
    obtain ⟨o, g4, e4, h⟩ := bind_some h
    refine res_lastRG ih e4 h k2.2.2 ?_ ?_ ?_ ?_ <;> (try simp) <;> omega

theorem res_n7RG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihq : ResForR (runLCMR env true (some p)) q region) (ihp : ResForR (runLCMR env true msup) p region) : ResForR (runLCMR env true msup) (Nomm.n7 p q) region := by
  intro goal g g' nex hi h
  simp only [runLCMR] at h
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  have R1 := ihq _ _ _ _ hi e1
  exact gres_comp R1 (ihp _ _ _ _ R1.2.2.1 h)

theorem res_n5RG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region) : ResForR (runLCMR env true msup) (Nomm.n5 p q) region := by
  intro goal g g' nex hi h
  have hd := ginv_drop hi
  simp only [runLCMR] at h
  obtain ⟨rp, g1, e1, h⟩ := bind_some h
  obtain ⟨rfl, rfl⟩ := re_step e1
  obtain ⟨rq, g2, e2, h⟩ := bind_some h
  obtain ⟨rfl, rfl⟩ := re_step e2
  obtain ⟨o, g3, e3, h⟩ := bind_some h
  have k3 := (?_ : KM _).keep _ _ _ e3
  rotate_left
  · cases goal with
    | pick z o' => exact KM.emit' _
    | done => exact KM.bind' km_doneBlocks fun _ => KM.emit' _
    | next laz th =>
      refine KM.bind' (km_collapseLazyAtomL _) fun a => ?_
      rcases a with _ | ⟨r, o'⟩
      · exact KM.ite' _ (KM.emit' _) KM.fail
      · exact KM.bind' (km_forl _ _) fun _ => KM.emit' _
  obtain ⟨n2, g4, e4, h⟩ := bind_some h
  obtain ⟨n2', g5, e5, h⟩ := bind_some h
  obtain ⟨n1, g6, e6, e7⟩ := bind_some h
  simp only at k3
  obtain ⟨l, b, i, s⟩ := tail_freshRG ihq ihp (k := g.re) (Nat.le_refl _) (Nat.lt_succ_self _) (by omega)
    (by rw [k3.2.2]; exact hd) (jmpIn_jmp0 _ _) e4 e5 e6 e7
  exact ⟨by omega, by omega, i, fun x hx => Or.inl (s x hx)⟩

theorem res_n2RG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region) :
    ResForR (runLCMR env true msup) (Nomm.n2 p q Option.none) region := by
  intro goal g g' nex hi h
  have hd := ginv_drop hi
  obtain ⟨nex0, g1, out, pro, g2, o, g3, nexF, g4, nexF', g5, nexS, g6, h1, h2, h3, h4, h5, h6, h7⟩ :=
    runLCM_n2_noneG h
  obtain ⟨l1, b1, d1⟩ := km_drop (km_simpleNextL _) h1 hd
  obtain ⟨l2, b2, d2⟩ := km_drop (km_kerf _) h2 d1
  obtain ⟨l3, b3, d3⟩ := km_drop (KM.emit' _) h3 d2
  simp only at l3 b3
  obtain ⟨l, b, i, s⟩ := tail_freshRG ihq ihp (k := g.re) (by omega) (Nat.lt_succ_self _) (by omega) d3
    (jmpIn_jmp0 _ _) h4 h5 h6 h7
  exact ⟨by omega, by omega, i, fun x hx => Or.inl (s x hx)⟩

/-- The `%next` branch of the cons. -/
theorem res_cons_nextRG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region) {laz : Lazy CSet} {th : Jmp}
    {g g1 g2 g3 g4 g5 g' : Gen (TreapMap mugF)} {hed tel : Lazy CSet} {o : Nat} {nexh n2 n2' n1 nex : NextL CSet}
    (hi : GInv g (CGoalL.next laz th))
    (e1 : splitL ⟨laz, th⟩ g = some ((hed, tel, o), g1))
    (e2 : pastL env.cod ⟨hed, jmp0 o⟩ q region g1 = some (nexh, g2))
    (e3 : runLCMR env true msup q (CGoalL.next tel nexh.th) region g2 = some (n2, g3))
    (e4 : pastL env.cod n2 p region g3 = some (n2', g4))
    (e5 : runLCMR env true msup p (CGoalL.next nexh.laz n2'.th) region g4 = some (n1, g5))
    (e6 : copyL n1 n2'.laz g5 = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  obtain ⟨l1, b1, d1, ih, it, nd, src⟩ := splitL_inv hi e1
  obtain ⟨r2, b2, d2, i2, j2, rg2⟩ := pastL_inv ih (jmpIn_jmp0 _ _) e2
  have hq : GInv g2 (CGoalL.next tel nexh.th) := ⟨linv_mono it (by omega) b2, d2.trans d1, j2⟩
  obtain ⟨l, b, i, s⟩ := tail_allRG ihq ihp hq i2 (by rw [rg2]; exact nd) e3 e4 e5 e6
  refine ⟨by omega, by omega, i, fun x hx => ?_⟩
  rcases s x hx with e | e
  · rw [rg2] at e
    rcases src x e with e' | e'
    · exact Or.inr e'
    · exact Or.inl e'
  · exact Or.inl (by omega)

theorem res_consRG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region) : ResForR (runLCMR env true msup) (Nomm.cons p q) region := by
  intro goal g g' nex hi h
  have hd := ginv_drop hi
  simp only [runLCMR] at h
  obtain ⟨goal', g1, e1, h⟩ := bind_some h
  -- the goal after the `=>` for `%done`
  have G : GInv g1 goal' ∧ g.re ≤ g1.re ∧ g.bo ≤ g1.bo ∧ (∀ x ∈ gregs goal', g.re ≤ x ∨ x ∈ gregs goal) := by
    cases goal with
    | done =>
      simp only at e1
      obtain ⟨r, g5, h5, e1⟩ := bind_some e1
      obtain ⟨rfl, rfl⟩ := re_step h5
      obtain ⟨o, g6, h6, e1⟩ := bind_some e1
      simp only [pure, StateT.pure, Option.some.injEq, Prod.mk.injEq] at e1
      obtain ⟨rfl, rfl⟩ := e1
      obtain ⟨l6, b6, d6⟩ := km_drop (KM.emit' _) h6 hd
      simp only at l6 b6
      refine ⟨ginv_reg _ (by omega) d6, by omega, by omega, fun x hx => ?_⟩
      simp [gregs, lregs_ofSure, lazyReg, flattenNeed] at hx
      exact Or.inl (by omega)
    | pick z o =>
      simp only [pure, StateT.pure, Option.some.injEq, Prod.mk.injEq] at e1
      obtain ⟨rfl, rfl⟩ := e1
      exact ⟨hi, Nat.le_refl _, Nat.le_refl _, fun x hx => Or.inr hx⟩
    | next laz th =>
      simp only [pure, StateT.pure, Option.some.injEq, Prod.mk.injEq] at e1
      obtain ⟨rfl, rfl⟩ := e1
      exact ⟨hi, Nat.le_refl _, Nat.le_refl _, fun x hx => Or.inr hx⟩
  obtain ⟨gi, gl, gb, gs⟩ := G
  cases goal' with
  | pick z o =>
    obtain ⟨o', g2, e2, h⟩ := bind_some h
    obtain ⟨l2, b2, d2⟩ := km_drop (KM.emit' _) e2 gi.1
    obtain ⟨n2, g3, e3, h⟩ := bind_some h
    obtain ⟨n2', g4, e4, h⟩ := bind_some h
    obtain ⟨n1, g5, e5, e6⟩ := bind_some h
    obtain ⟨l, b, i, s⟩ := tail_buntRG ihq ihp d2 (jmpIn_jmp0 _ _) e3 e4 e5 e6
    exact ⟨by omega, by omega, i, fun x hx => Or.inl (by have := s x hx; omega)⟩
  | done => cases h
  | next laz th =>
    obtain ⟨⟨hed, tel, o⟩, g2, e2, h⟩ := bind_some h
    obtain ⟨nexh, g3, e3, h⟩ := bind_some h
    obtain ⟨n2, g4, e4, h⟩ := bind_some h
    obtain ⟨n2', g5, e5, h⟩ := bind_some h
    obtain ⟨n1, g6, e6, e7⟩ := bind_some h
    exact gres_pre (res_cons_nextRG ihp ihq gi e2 e3 e4 e5 e6 e7) gl gb gs

theorem res_n10RG {env : CallEnv} {msup : Option Nomm} {a : Nat} {v q : Nomm} {region : List Nat} (ha : a ≠ 0)
    (ihv : ResForR (runLCMR env true msup) v region) (ihq : ResForR (runLCMR env true msup) q region) :
    ResForR (runLCMR env true msup) (Nomm.n10 a v q) region := by
  intro goal g g' nex hi h
  simp only [runLCMR] at h
  obtain ⟨nx, g1, e1, h⟩ := bind_some h
  have S := simpleNextL_res hi e1
  obtain ⟨⟨don, rec, o⟩, g2, e2, h⟩ := bind_some h
  obtain ⟨nexR, g3, e3, h⟩ := bind_some h
  obtain ⟨n2, g4, e4, h⟩ := bind_some h
  obtain ⟨n2', g5, e5, h⟩ := bind_some h
  obtain ⟨n1, g6, e6, e7⟩ := bind_some h
  obtain ⟨sl, sb, si, ss⟩ := S
  obtain ⟨l2, b2, d2, id, ir, nd, src⟩ := intoL_inv ha si e2
  obtain ⟨r3, b3, d3, i3, j3, rg3⟩ := pastL_inv ir (jmpIn_jmp0 _ _) e3
  have hq : GInv g3 (CGoalL.next don nexR.th) := ⟨linv_mono id (by omega) b3, d3.trans d2, j3⟩
  have nd' : (lregs nexR.laz ++ lregs don).Nodup := by
    rw [rg3, List.nodup_append]
    obtain ⟨a1, a2, a3⟩ := List.nodup_append.1 nd
    exact ⟨a2, a1, fun x hx y hy e => a3 y hy x hx e.symm⟩
  obtain ⟨l, b, i, s⟩ := tail_allRG ihv ihq hq i3 nd' e4 e5 e6 e7
  refine ⟨by omega, by omega, i, fun x hx => ?_⟩
  rcases s x hx with e | e
  · have e' : x ∈ lregs don ++ lregs rec := by
      rw [rg3] at e
      rcases List.mem_append.1 e with e | e
      · exact List.mem_append_right _ e
      · exact List.mem_append_left _ e
    rcases src x e' with e'' | e''
    · rcases ss x e'' with f | f
      · exact Or.inl f
      · exact Or.inr f
    · exact Or.inl (by omega)
  · exact Or.inl (by omega)

theorem runLC_cons_nextRG (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) :
    (runLCMR env true msup (Nomm.cons p q) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet)) = (do
      let (hed, tel, o) ← splitL ⟨laz, th⟩
      let nexh ← pastL env.cod ⟨hed, jmp0 o⟩ q region
      let nex2 ← runLCMR env true msup q (CGoalL.next tel nexh.th) region
      let nex2 ← pastL env.cod nex2 p region
      let nex1 ← runLCMR env true msup p (CGoalL.next nexh.laz nex2.th) region
      copyL nex1 nex2.laz) := by
  conv => lhs; unfold runLCMR
  rfl

theorem runLC_cons_pickRG (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (z o : Jmp) (region : List Nat) :
    (runLCMR env true msup (Nomm.cons p q) (CGoalL.pick z o) region : CM (TreapMap mugF) (NextL CSet)) = (do
      let o ← emit ⟨[], [], Termin.bom Option.none⟩
      let nex2 ← runLCMR env true msup q (CGoalL.next (Lazy.ofSure Sure.bunt) (jmp0 o)) region
      let nex2 ← pastL env.cod nex2 p region
      let nex1 ← runLCMR env true msup p (CGoalL.next (Lazy.ofSure Sure.bunt) nex2.th) region
      copyL nex1 nex2.laz) := by
  conv => lhs; unfold runLCMR
  rfl

/-- The model of `%5` against `runLCMR` on a lazy goal. -/
theorem cr5_modelLRG (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (goal : CGoalL CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) :
    (runLCMR env true msup (Nomm.n5 p q) goal region : CM (TreapMap mugF) (NextL CSet)) g = (do
      let o ← cr5BrML g.re (g.re + 1) goal
      let nexF ← runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) (g.re + 1)) (jmp0 o))) region
      let nexF ← pastL env.cod nexF p region
      let nexS ← runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) g.re) nexF.th)) region
      copyL nexS nexF.laz : CM (TreapMap mugF) (NextL CSet)) { g with re := g.re + 1 + 1 } := by
  cases goal <;> simp [runLCMR, CGoal.toL, cr5BrML, re, bind, StateT.bind, pure, StateT.pure] <;> rfl

/-- The model of the indirect call from `+kerf` on, with `+past` on the
empty code table. -/
noncomputable def cr2KfMLRG (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (region : List Nat) (nex : NextL CSet) :
    CM (TreapMap mugF) (NextL CSet) := do
  let (out, pro) ← kerf nex
  let rSub ← re
  let rFol ← re
  let o ← emit ⟨[], [Pole.nok rSub rFol pro], Termin.hop (jmp0 out)⟩
  let nexF ← runLCMR env true msup q (CGoal.toL (CGoal.next (lazyReg rFol) (jmp0 o))) region
  let nexF ← pastL env.cod nexF p region
  let nexS ← runLCMR env true msup p (CGoal.toL (CGoal.next (lazyReg rSub) nexF.th)) region
  copyL nexS nexF.laz

theorem runLC_n10RG (env : CallEnv) (msup : Option Nomm) (a : Nat) (v q : Nomm) (goal : CGoalL CSet)
    (region : List Nat) :
    (runLCMR env true msup (Nomm.n10 a v q) goal region : CM (TreapMap mugF) (NextL CSet)) = (do
      let next ← simpleNextL goal
      let (don, rec, o) ← intoL next a
      let nexR ← pastL env.cod ⟨rec, jmp0 o⟩ v region
      let nexD ← runLCMR env true msup v (CGoalL.next don nexR.th) region
      let nexD ← pastL env.cod nexD q region
      let nexQ ← runLCMR env true msup q (CGoalL.next nexR.laz nexD.th) region
      copyL nexQ nexD.laz) := by
  conv => lhs; unfold runLCMR

/-- Phase S from `+past-fork` on, in the model. -/
noncomputable def sixPMRG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region : List Nat) (lazy : Lazy CSet)
    (yes nuh : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let lazy ← liftO (Lazy.pastFork env.cod lazy p)
  let nexCond ← runLCMR env true msup p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region
  sixTail nexCond lazy

/-- Phase S under `%done` and `%pick` from the two runs on: the two `%hop`
blocks, their tags, the asserts, and the rest from `+past-fork` on. -/
noncomputable def sixLynDPRG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region : List Nat)
    (nex0 nex1 : NextL CSet) : CM (TreapMap mugF) (NextL CSet) := do
  let yes ← emit ⟨[], [], Termin.hop nex0.th⟩
  let nuh ← emit ⟨[], [], Termin.hop nex1.th⟩
  setTag yes region
  setTag nuh region
  if nex0.th.args ≠ [] then fun _ => Option.none else
  if nex1.th.args ≠ [] then fun _ => Option.none else
  sixPMRG env msup p region (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) yes nuh

/-- The model of `%6` under `%done` and `%pick`, with the reads of `cond`
that phase S makes for `+sect` (they change nothing here). -/
theorem runLC_n6_dpRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (goal : CGoalL CSet)
    (hg : ∀ laz th, goal ≠ CGoalL.next laz th) (region : List Nat) :
    (runLCMR env true msup (Nomm.n6 p q r) goal region : CM (TreapMap mugF) (NextL CSet)) = (do
      let _ ← getCond
      let nex1 ← runLCMR env true msup r goal region
      let _ ← getCond
      let nex0 ← runLCMR env true msup q goal region
      sixLynDPRG env msup p region nex0 nex1) := by
  funext g0
  cases goal with
  | next laz th => exact absurd rfl (hg laz th)
  | done => rfl
  | pick z o => rfl

/-- **What `%6` returns under `%done` and `%pick`.** -/
theorem res_n6_dpRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region) (ihr : ResForR (runLCMR env true msup) r region)
    (goal : CGoalL CSet) (hg : ∀ laz th, goal ≠ CGoalL.next laz th) (g g' : Gen (TreapMap mugF))
    (nex : NextL CSet) (hi : GInv g goal) (h : runLCMR env true msup (Nomm.n6 p q r) goal region g = some (nex, g')) :
    GRes g goal g' nex := by
  have hgr : gregs goal = [] := by cases goal with
    | next laz th => exact absurd rfl (hg laz th)
    | done => rfl
    | pick z o => rfl
  have hd := ginv_drop hi
  rw [runLC_n6_dpRG env msup p q r goal hg region] at h
  obtain ⟨c0, g0, e0, h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e0
  obtain ⟨-, rfl⟩ := e0
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  obtain ⟨c1, g1', e1', h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e1'
  obtain ⟨-, rfl⟩ := e1'
  obtain ⟨nex0, g2, e2, h⟩ := bind_some h
  obtain ⟨l1, b1, gi1, s1⟩ := ihr goal g g1 nex1 hi e1
  have hi1 : GInv g1 goal := ginv_mono hi l1 b1 ((ginv_drop gi1).trans hd.symm)
  obtain ⟨l2, b2, gi2, s2⟩ := ihq goal g1 g2 nex0 hi1 e2
  have d2 : g2.drop = false := ginv_drop gi2
  unfold sixLynDPRG at h
  obtain ⟨yes, g3, e3, h⟩ := bind_some h
  rw [emit_apply] at e3
  simp only [Option.some.injEq, Prod.mk.injEq] at e3
  obtain ⟨rfl, rfl⟩ := e3
  obtain ⟨nuh, g4, e4, h⟩ := bind_some h
  rw [emit_apply] at e4
  simp only [Option.some.injEq, Prod.mk.injEq] at e4
  obtain ⟨rfl, rfl⟩ := e4
  obtain ⟨u5, g5, e5, h⟩ := bind_some h
  rw [st_apply] at e5
  simp only [Option.some.injEq, Prod.mk.injEq] at e5
  obtain ⟨-, rfl⟩ := e5
  obtain ⟨u6, g6, e6, h⟩ := bind_some h
  rw [st_apply] at e6
  simp only [Option.some.injEq, Prod.mk.injEq] at e6
  obtain ⟨-, rfl⟩ := e6
  split at h
  · cases h
  split at h
  · cases h
  -- the state after the two blocks and their tags
  generalize hG : stG (g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo region
    (stG g2.bo region ((g2.emitted ⟨[], [], Termin.hop nex0.th⟩).emitted ⟨[], [], Termin.hop nex1.th⟩)) = G at h
  have rG : G.re = g2.re := by rw [← hG, stG_re, stG_re]; rfl
  have bG : G.bo = g2.bo + 2 := by rw [← hG, stG_bo, stG_bo]; rfl
  have dG : G.drop = false := by rw [← hG, stG_drop, stG_drop]; exact d2
  unfold sixPMRG at h
  obtain ⟨lazy, g7, e7, h⟩ := bind_some h
  simp only [liftO] at e7
  cases epf : Lazy.pastFork env.cod (Lazy.mk Sure.bunt [((g2.bo, nex0.laz), ((g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo, nex1.laz))] []) p with
  | none => rw [epf] at e7; cases e7
  | some lz =>
  rw [epf] at e7
  simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at e7
  obtain ⟨rfl, rfl⟩ := e7
  obtain ⟨nexC, g8, e8, h⟩ := bind_some h
  obtain ⟨l8, b8, gi8, s8⟩ := ihp _ G g8 nexC
    (show GInv G (CGoalL.pick (jmp0 g2.bo) (jmp0 (g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo)) from
      ⟨dG, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) e8
  -- the fork of the two blocks
  have f0 : ∀ y ∈ lregs nex0.laz, g1.re ≤ y := fun y hy => by
    rcases s2 y hy with e | e
    · exact e
    · simp [hgr] at e
  have f1 : ∀ y ∈ lregs nex1.laz, g.re ≤ y := fun y hy => by
    rcases s1 y hy with e | e
    · exact e
    · simp [hgr] at e
  have lv0 : LInv G.re G.bo nex0.laz := linv_mono gi2.1 (by omega) (by omega)
  have lv1 : LInv G.re G.bo nex1.laz := linv_mono gi1.1 (by omega) (by omega)
  have ap01 : ∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz := fun y hy hy' => by
    have := f0 y hy; have := lnb_regs gi1.1.1 y hy'; omega
  have lvF := lyn_linv lv0 lv1 ap01 (yes := g2.bo) (nuh := (g2.emitted ⟨[], [], Termin.hop nex0.th⟩).bo)
    (by omega) (by simp [emitted_bo]; omega)
  have lvP : LInv G.re G.bo lz := linv_pastFork epf lvF
  have hC : LInv g8.re g8.bo nexC.laz := gi8.1
  have hP8 : LInv g8.re g8.bo lz := linv_mono lvP l8 b8
  have ap8 : (lregs nexC.laz ++ lregs lz).Nodup := by
    refine List.nodup_append.2 ⟨gi8.1.2.1, lvP.2.1, fun a ha b hb e => ?_⟩
    subst e
    have := lnb_regs lvP.1 a hb
    rcases s8 a ha with e | e
    · omega
    · simp [gregs] at e
  have d8 : g8.drop = false := ginv_drop gi8
  obtain ⟨l9, b9, gi9, s9⟩ := six_tail_res hC hP8 ap8 d8 h
  refine ⟨by omega, by omega, gi9, fun y hy => Or.inl ?_⟩
  rcases s9 y hy with e | e
  · rcases List.mem_append.1 e with e | e
    · rcases s8 y e with e' | e'
      · omega
      · simp [gregs] at e'
    · rw [lregs_pastFork epf] at e
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append] at e
      rcases e with e | e
      · have := f0 y e; omega
      · exact f1 y e
  · omega

/-- Phase S under `%next` from the two runs on: `+sect`, then the rest from
`+past-fork` on. -/
noncomputable def sixLynNRG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region rb : List Nat) (o0 o1 : Nat)
    (cb cbw : TreapMap mugF (Nat × List Nat)) (nex0 nex1 : NextL CSet) : CM (TreapMap mugF) (NextL CSet) := do
  let (lazy, yes, nuh) ← sect nex0 nex1 o0 o1 rb cb cbw
  sixPMRG env msup p region lazy yes nuh

/-- Phase S under `%next` after `+id`: the reads of `cond`, the two runs in
the region `rid :: region`, `+sect` and the rest. -/
noncomputable def sixNfKRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (s0 s1 : Sure CSet) (o0 o1 rid : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let cb ← getCond
  let nex1 ← runLCMR env true msup r (CGoalL.next (Lazy.ofSure s1) (jmp0 o1)) (rid :: region)
  let cbw ← getCond
  let nex0 ← runLCMR env true msup q (CGoalL.next (Lazy.ofSure s0) (jmp0 o0)) (rid :: region)
  sixLynNRG env msup p region (rid :: region) o0 o1 cb cbw nex0 nex1

/-- **The model of `%6` under a fork-free `%next` goal** is phase S
(`sixNextLC_fork_free`). -/
theorem runLC_n6_nfRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (s : Sure CSet) (th : Jmp)
    (region : List Nat) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let o0 ← oo
          let o1 ← oo
          let (s0, s1) ← forkSure s th.there o0 o1
          let rid ← idM
          sixNfKRG env msup p q r region s0 s1 o0 o1 rid) := by
  show sixNextLC env.cod _ _ _ p q r 3 (Lazy.mk s [] []) th region = _
  rw [sixNextLC_fork_free]
  rfl

/-- **What `%6` returns under a fork-free `%next` goal**: `GRes`, given what
the runs of the parts return; every register of the result is fresh (the
branch goals' registers come from `+fork-sure`, the branches' needs are
apart, the fork of `+sect` meets `LInv`). -/
theorem res_n6_nfRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region))
    (s : Sure CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next (Lazy.mk s [] []) th))
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region g = some (nex, g')) :
    GRes g (CGoalL.next (Lazy.mk s [] []) th) g' nex := by
  have hd := ginv_drop hi
  have hl0 : CrLok s := hi.1.1.1.1
  rw [runLC_n6_nfRG] at h
  obtain ⟨o0, gA, eA, h⟩ := bind_some h
  rw [oo_ap] at eA
  simp only [Option.some.injEq, Prod.mk.injEq] at eA
  obtain ⟨rfl, rfl⟩ := eA
  obtain ⟨o1, gB, eB, h⟩ := bind_some h
  rw [oo_ap, ooG_bo] at eB
  simp only [Option.some.injEq, Prod.mk.injEq] at eB
  obtain ⟨rfl, rfl⟩ := eB
  obtain ⟨⟨s0, s1⟩, g3, ef, h⟩ := bind_some h
  obtain ⟨r3, b3, d3, lk0, lk1, D0, D1, aps, fr⟩ := forkSure_inv ef
  obtain ⟨rid, gI, eI, h⟩ := bind_some h
  rw [idM_ap] at eI
  simp only [Option.some.injEq, Prod.mk.injEq] at eI
  obtain ⟨rfl, rfl⟩ := eI
  have dI : (idG g3).drop = false := d3.trans hd
  have gi1 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) :=
    ginv_ofSure (fun y hy => hl0 y (lk1 ▸ hy)) (fun y hy => (fr y (Or.inr hy)).2) D1 dI
  have gi0 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_ofSure (fun y hy => hl0 y (lk0 ▸ hy)) (fun y hy => (fr y (Or.inl hy)).2) D0 dI
  unfold sixNfKRG at h
  obtain ⟨c0, g0, e0, h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e0
  obtain ⟨-, rfl⟩ := e0
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  obtain ⟨c1, g1', e1', h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e1'
  obtain ⟨-, rfl⟩ := e1'
  obtain ⟨nex0, g2, e2, h⟩ := bind_some h
  obtain ⟨l1, b1, gj1, s1r⟩ := ihr g3.id _ _ g1 nex1 gi1 e1
  have hi0 : GInv g1 (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_mono gi0 l1 b1 ((ginv_drop gj1).trans dI.symm)
  obtain ⟨l2, b2, gj2, s2r⟩ := ihq g3.id _ g1 g2 nex0 hi0 e2
  have d2 : g2.drop = false := ginv_drop gj2
  unfold sixLynNRG at h
  obtain ⟨⟨lz, yes, nuh⟩, g4, e3, h⟩ := bind_some h
  have hlz := sect_lazy e3
  obtain ⟨k4r, k4b, k4d⟩ := (km_sect nex0 nex1 g.bo (g.bo + 1) (g3.id :: region) c0 c1).keep _ _ _ e3
  obtain ⟨hy, hn⟩ := sect_labels e3
  subst hlz
  have d4 : g4.drop = false := k4d.trans d2
  unfold sixPMRG at h
  obtain ⟨lazy, g7, e7, h⟩ := bind_some h
  simp only [liftO] at e7
  cases epf : Lazy.pastFork env.cod (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) p with
  | none => rw [epf] at e7; cases e7
  | some lz' =>
  rw [epf] at e7
  simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at e7
  obtain ⟨rfl, rfl⟩ := e7
  obtain ⟨nexC, g8, e8, h⟩ := bind_some h
  obtain ⟨l8, b8, gi8, s8⟩ := ihp _ g4 g8 nexC
    (show GInv g4 (CGoalL.pick (jmp0 yes) (jmp0 nuh)) from ⟨d4, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) e8
  -- the registers of the branches' needs: fresh, or of the goals of `+fork-sure`
  have rI : (idG g3).re = g3.re := rfl
  have rO : (ooG (ooG g)).re = g.re := rfl
  have bI : (idG g3).bo = g3.bo := rfl
  have f0 : ∀ y ∈ lregs nex0.laz, g1.re ≤ y ∨ NMem s0.ned y := fun y hy => by
    rcases s2r y hy with e | e
    · exact Or.inl e
    · simp only [gregs, lregs_ofSure] at e
      exact Or.inr ((mem_flatten _ _).1 e)
  have f1 : ∀ y ∈ lregs nex1.laz, g3.re ≤ y ∨ NMem s1.ned y := fun y hy => by
    rcases s1r y hy with e | e
    · exact Or.inl e
    · simp only [gregs, lregs_ofSure] at e
      exact Or.inr ((mem_flatten _ _).1 e)
  have lv0 : LInv g4.re g4.bo nex0.laz := linv_mono gj2.1 k4r k4b
  have lv1 : LInv g4.re g4.bo nex1.laz := linv_mono gj1.1 (by omega) (by omega)
  have ap01 : ∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz := fun y hy hy' => by
    have hb1 := lnb_regs gj1.1.1 y hy'
    rcases f0 y hy with e | e
    · omega
    · have := (fr y (Or.inl e)).2
      rcases f1 y hy' with e' | e'
      · omega
      · exact aps y e e'
  have lvF := lyn_linv lv0 lv1 ap01 hy hn
  have lvP : LInv g4.re g4.bo lz' := linv_pastFork epf lvF
  have hC : LInv g8.re g8.bo nexC.laz := gi8.1
  have hP8 : LInv g8.re g8.bo lz' := linv_mono lvP l8 b8
  have ap8 : (lregs nexC.laz ++ lregs lz').Nodup := by
    refine List.nodup_append.2 ⟨gi8.1.2.1, lvP.2.1, fun a ha b hb e => ?_⟩
    subst e
    have := lnb_regs lvP.1 a hb
    rcases s8 a ha with e | e
    · omega
    · simp [gregs] at e
  obtain ⟨l9, b9, gi9, s9⟩ := six_tail_res hC hP8 ap8 (ginv_drop gi8) h
  have rg3 : g.re ≤ g3.re := rO ▸ r3
  refine ⟨by omega, by simp only [ooG_bo] at b3; omega, gi9, fun y hy => Or.inl ?_⟩
  rcases s9 y hy with e | e
  · rcases List.mem_append.1 e with e | e
    · rcases s8 y e with e' | e'
      · omega
      · simp [gregs] at e'
    · rw [lregs_pastFork epf] at e
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append] at e
      rcases e with e | e
      · rcases f0 y e with e' | e'
        · omega
        · have := (fr y (Or.inl e')).1; omega
      · rcases f1 y e with e' | e'
        · omega
        · have := (fr y (Or.inr e')).1; omega
  · omega

/-- The model of `%6` under a `%next` goal whose `+leap` is `~`, whose need
with the bunt sure is not `+none-equivalent` and whose `+kerf` test holds:
`+kerf`, then the case on the goal `[%next [[%this pro] ~] ~ ~] ~ out]`. -/
theorem runLC_n6_kRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false) (hkt : kerfTest q r laz = true) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let (out, pro) ← kerf ⟨laz, th⟩
          runLCMR env true msup (Nomm.n6 p q r)
            (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region) := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region = _
  unfold kerfTest at hkt
  rw [sixNextLC.eq_2]
  simp only [hlp, hne, Bool.not_false, if_true, hkt]
  congr 1
  funext v
  obtain ⟨out, pro⟩ := v
  have e : ∀ L J, (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next L J) region : CM (TreapMap mugF) (NextL CSet))
      = sixNextLC env.cod (runLCMR env true msup p) (runLCMR env true msup q) (runLCMR env true msup r) p q r 3 L J region :=
    fun _ _ => rfl
  rw [e]
  simp only [Lazy.ofSure, sixNextLC_fork_free]

/-- **What `%6` returns in phase K**: `GRes`, given what the runs of the
parts return (`res_n6_nfRG` after `+kerf`; the register of `+kerf` is fresh). -/
theorem res_n6_kRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = true)
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_kRG env msup p q r laz th region hlp hne hkt] at h
  obtain ⟨⟨out, pro⟩, g1, ek, h⟩ := bind_some h
  obtain ⟨-, hrp, hp, hb, -⟩ := kerf_inv ek
  obtain ⟨r1, b1, gi, fr⟩ := res_n6_nfRG ihp ihq ihr ⟨Need.this pro, HoonSet.empty⟩ (jmp0 out) g1 g' nex
    (ginv_kerf ek (ginv_drop hi)) h
  refine ⟨by omega, by omega, gi, fun y hy => Or.inl ?_⟩
  rcases fr y hy with e | e
  · omega
  · change y ∈ lregs (Lazy.ofSure (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet)) at e
    rw [show (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet) = lazyReg pro from rfl, lregs_reg pro] at e
    have ey : y = pro := by simpa using e
    omega

/-- Phase F from `+past-fork` on, in the model. -/
noncomputable def sixPFRG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region : List Nat) (rc : Nat)
    (lazy : Lazy CSet) (yes nuh : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let lazy ← liftO (Lazy.pastFork env.cod lazy p)
  let o ← emit ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩
  let lazy ← lazyShut o lazy
  let nexCond ← runLCMR env true msup p (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 o)) region
  copyL nexCond lazy

/-- Phase F from the two runs on: `+sect`, then the rest from `+past-fork` on. -/
noncomputable def sixLynFRG (env : CallEnv) (msup : Option Nomm) (p : Nomm) (region rb : List Nat) (rc o0 o1 : Nat)
    (cb cbw : TreapMap mugF (Nat × List Nat)) (nex0 nex1 : NextL CSet) : CM (TreapMap mugF) (NextL CSet) := do
  let (lazy, yes, nuh) ← sect nex0 nex1 o0 o1 rb cb cbw
  sixPFRG env msup p region rc lazy yes nuh

/-- The model of `%6` under a `%next` goal whose `+leap` is `~`, whose need
with the bunt sure is not `+none-equivalent` and whose `+kerf` test fails:
phase F (`sixNextForkC`). -/
theorem runLC_n6_fRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false) (hkt : kerfTest q r laz = false) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = sixNextForkC env.cod (runLCMR env true msup p) (runLCMR env true msup q) (runLCMR env true msup r) p laz th region := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region = _
  unfold kerfTest at hkt
  rw [sixNextLC.eq_2]
  simp only [hlp, hne, Bool.not_false, if_true, hkt, Bool.false_eq_true, if_false]

/-- **What the two runs of phase F return**: the branch needs meet `LInv`,
are apart, and every register of them is above `r-cond` (the registers of
the goals of `+fork` are fresh after `+re`, the rest is fresh after `+fork`). -/
theorem six_f_runsRG {env : CallEnv} {msup : Option Nomm} {q r : Nomm} {rb : List Nat}
    (ihq : ResForR (runLCMR env true msup) q rb) (ihr : ResForR (runLCMR env true msup) r rb)
    {laz : Lazy CSet} {th : Jmp} {g g3 g1 g2 : Gen (TreapMap mugF)} {n0 n1 nex0 nex1 : NextL CSet}
    (hinv : GInv g (CGoalL.next laz th)) (ef : forkL ⟨laz, th⟩ g.re (reG g) = some ((n0, n1), g3))
    (e1 : runLCMR env true msup r n1.goal rb (idG g3) = some (nex1, g1))
    (e2 : runLCMR env true msup q n0.goal rb g1 = some (nex0, g2)) :
    g.re < g2.re ∧ g.bo ≤ g2.bo ∧ g2.drop = false ∧ LInv g2.re g2.bo nex0.laz ∧ LInv g2.re g2.bo nex1.laz ∧
      (∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz) ∧ (∀ y ∈ lregs nex0.laz ++ lregs nex1.laz, g.re < y) := by
  have hR : GInv (reG g) (CGoalL.next laz th) := ginv_mono hinv (Nat.le_succ _) (Nat.le_refl _) rfl
  obtain ⟨gi0, gi1⟩ := ginv_forkL hR ef
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  obtain ⟨-, -, F, -, -, -⟩ := forkL_spec hl ef
  obtain ⟨k3r, k3b, -⟩ := (km_forkL (Map := TreapMap mugF) (S := CSet) _ _).keep _ _ _ ef
  rw [reG_re] at F k3r
  rw [reG_bo] at k3b
  have gi1' : GInv (idG g3) n1.goal := gi1
  obtain ⟨l1, b1, gj1, s1r⟩ := ihr _ (idG g3) g1 nex1 gi1' e1
  have hi0 : GInv g1 n0.goal := ginv_mono gi0 l1 b1 ((ginv_drop gj1).trans (ginv_drop gi1').symm)
  obtain ⟨l2, b2, gj2, s2r⟩ := ihq _ g1 g2 nex0 hi0 e2
  have rI : (idG g3).re = g3.re := rfl
  have bI : (idG g3).bo = g3.bo := rfl
  rw [rI] at l1 s1r
  rw [bI] at b1
  have f0 : ∀ y ∈ lregs nex0.laz, g1.re ≤ y ∨ y ∈ lregs n0.laz := s2r
  have f1 : ∀ y ∈ lregs nex1.laz, g3.re ≤ y ∨ y ∈ lregs n1.laz := s1r
  refine ⟨by omega, by omega, ginv_drop gj2, gj2.1, linv_mono gj1.1 l2 b2, ?_, ?_⟩
  · intro y hy hy'
    have hb1 := lnb_regs gj1.1.1 y hy'
    rcases f0 y hy with e | e
    · omega
    · rcases f1 y hy' with e' | e'
      · have := (F.2 y (List.mem_append_left _ e)).2; omega
      · exact (List.nodup_append.1 F.1).2.2 y e y e' rfl
  · intro y hy
    rcases List.mem_append.1 hy with hy | hy
    · rcases f0 y hy with e | e
      · omega
      · have := (F.2 y (List.mem_append_left _ e)).1; omega
    · rcases f1 y hy with e | e
      · omega
      · have := (F.2 y (List.mem_append_right _ e)).1; omega

/-- Phase F after `+id`, in the model: the rest of `sixNextForkC`. -/
noncomputable def sixFKRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (n0 n1 : NextL CSet) (rc rid : Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let cb ← getCond
  let nex1 ← runLCMR env true msup r (CGoalL.next n1.laz n1.th) (rid :: region)
  let cbw ← getCond
  let nex0 ← runLCMR env true msup q (CGoalL.next n0.laz n0.th) (rid :: region)
  sixLynFRG env msup p region (rid :: region) rc n0.th.there n1.th.there cb cbw nex0 nex1

theorem sixNextForkC_eqRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) :
    (sixNextForkC env.cod (runLCMR env true msup p) (runLCMR env true msup q) (runLCMR env true msup r) p laz th region :
      CM (TreapMap mugF) (NextL CSet))
      = (do
          let rc ← re
          let (n0, n1) ← forkL ⟨laz, th⟩ rc
          let rid ← idM
          sixFKRG env msup p q r region n0 n1 rc rid) := rfl

/-- **What `%6` returns in phase F**: `GRes`, given what the runs of the
parts return.  Every register of the result is fresh: `r-cond` and the
registers of the goals of `+fork` are taken after the call, the branch
needs are made of those or fresh ones, the register of `+lazy-shut` is
fresh, and the run of `p` reads only `r-cond`. -/
theorem res_n6_fRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = false)
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_fRG env msup p q r laz th region hlp hne hkt, sixNextForkC_eqRG] at h
  obtain ⟨rc, gR, eR, h⟩ := bind_some h
  rw [re_ap] at eR
  simp only [Option.some.injEq, Prod.mk.injEq] at eR
  obtain ⟨rfl, rfl⟩ := eR
  obtain ⟨⟨n0, n1⟩, g3, ef, h⟩ := bind_some h
  obtain ⟨rid, gI, eI, h⟩ := bind_some h
  rw [idM_ap] at eI
  simp only [Option.some.injEq, Prod.mk.injEq] at eI
  obtain ⟨rfl, rfl⟩ := eI
  unfold sixFKRG at h
  obtain ⟨c0, g0, e0, h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e0
  obtain ⟨-, rfl⟩ := e0
  obtain ⟨nex1, g1, e1, h⟩ := bind_some h
  obtain ⟨c1, g1', e1', h⟩ := bind_some h
  simp only [getCond, Option.some.injEq, Prod.mk.injEq] at e1'
  obtain ⟨-, rfl⟩ := e1'
  obtain ⟨nex0, g2, e2, h⟩ := bind_some h
  obtain ⟨lt2, bt2, d2, h0, h1, ap01, fr⟩ := six_f_runsRG (ihq g3.id) (ihr g3.id) hi ef e1 e2
  unfold sixLynFRG at h
  obtain ⟨⟨lz, yes, nuh⟩, g4, e3, h⟩ := bind_some h
  have hlz := sect_lazy e3
  obtain ⟨k4r, k4b, k4d⟩ := (km_sect nex0 nex1 _ _ _ _ _).keep _ _ _ e3
  obtain ⟨hy, hn⟩ := sect_labels e3
  subst hlz
  have d4 : g4.drop = false := k4d.trans d2
  have lvF := lyn_linv (linv_mono h0 k4r k4b) (linv_mono h1 k4r k4b) ap01 hy hn
  unfold sixPFRG at h
  obtain ⟨lazy, g5, e5, h⟩ := bind_some h
  simp only [liftO] at e5
  cases epf : Lazy.pastFork env.cod (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) p with
  | none => rw [epf] at e5; cases e5
  | some lz' =>
  rw [epf] at e5
  simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at e5
  obtain ⟨rfl, rfl⟩ := e5
  have lvP : LInv g4.re g4.bo lz' := linv_pastFork epf lvF
  have rP : ∀ y ∈ lregs lz', g.re < y := fun y hy => by
    rw [lregs_pastFork epf] at hy
    simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil] at hy
    exact fr y hy
  obtain ⟨o, g6, e6, h⟩ := bind_some h
  rw [emit_apply] at e6
  simp only [Option.some.injEq, Prod.mk.injEq] at e6
  obtain ⟨rfl, rfl⟩ := e6
  obtain ⟨lz'', g7, e7, h⟩ := bind_some h
  obtain ⟨k7r, k7b, k7d, lv7, f7⟩ := lazyShut_inv
    (linv_mono lvP (Nat.le_of_eq (emitted_re _ _).symm) (by rw [emitted_bo]; omega)) e7
  simp only [emitted_re, emitted_bo, emitted_drop] at k7r k7b k7d f7
  have d7 : g7.drop = false := k7d.trans d4
  obtain ⟨nexC, g8, e8, h⟩ := bind_some h
  obtain ⟨l8, b8, gi8, s8⟩ := ihp _ g7 g8 nexC (ginv_rc (by omega) d7) e8
  have hC : LInv g8.re g8.bo nexC.laz := gi8.1
  have hP8 : LInv g8.re g8.bo lz'' := linv_mono lv7 l8 b8
  have sC : ∀ y ∈ lregs nexC.laz, g7.re ≤ y ∨ y = g.re := fun y hy => by
    rcases s8 y hy with e | e
    · exact Or.inl e
    · change y ∈ lregs (Lazy.ofSure (lazyReg g.re : Sure CSet)) at e
      rw [lregs_reg, List.mem_singleton] at e
      exact Or.inr e
  have sL : ∀ y ∈ lregs lz'', g.re < y := fun y hy => by
    rcases f7 y hy with e | e
    · exact rP y e
    · omega
  have ap8 : (lregs nexC.laz ++ lregs lz'').Nodup := by
    refine List.nodup_append.2 ⟨gi8.1.2.1, lv7.2.1, fun a ha b hb e => ?_⟩
    subst e
    have := lnb_regs lv7.1 a hb
    have := sL a hb
    rcases sC a ha with e | e
    · omega
    · omega
  obtain ⟨l9, b9, gi9, s9⟩ := copyL_inv hC hP8 ap8 (ginv_drop gi8) h
  refine ⟨by omega, by omega, gi9, fun y hy => Or.inl ?_⟩
  rcases s9 y hy with e | e
  · rcases List.mem_append.1 e with e | e
    · rcases sC y e with e' | e'
      · omega
      · omega
    · have := sL y e; omega
  · omega

/-- **The model of phase L**: where `+leap` gives `[~ rest bys]` and, on the
rest, `~` (`LeapTwice`), the case is the case on `[%next rest then]`, then
`copyAll` of `bys`. -/
theorem runLC_n6_lRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz rest : Lazy CSet) (th : Jmp)
    (bys : List (Lazy CSet)) (region : List Nat) (hlp : leap laz q r = some (some (rest, bys)))
    (h2 : leap rest q r = some Option.none) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let nex ← runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next rest th) region
          copyAll nex bys) := by
  have e : ∀ L J, (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next L J) region : CM (TreapMap mugF) (NextL CSet))
      = sixNextLC env.cod (runLCMR env true msup p) (runLCMR env true msup q) (runLCMR env true msup r) p q r 3 L J region :=
    fun _ _ => rfl
  rw [e, e, sixNextLC.eq_2]
  simp only [hlp]
  rw [sixNextLC_leap_none env.cod _ _ _ p q r 0 1 rest th region h2]

/-- **What `%6` returns in phase L**: `GRes`, given what the run on the rest
returns. -/
theorem res_n6_lRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (htw : LeapTwice laz q r) (hi : GInv g (CGoalL.next laz th)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hReR : ∀ nex g', runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex)
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_lRG env msup p q r laz rest th bys region hlp (htw rest bys hlp)] at h
  obtain ⟨n1, g1, e1, e2⟩ := bind_some h
  exact (chain_l (leapInv hi.1 hq hr) hlp (hReR n1 g1 e1)).2 nex g' e2

/-- **What phase L returns** (`res_n6_lRG`) without `LeapTwice`. -/
theorem res_n6_l_twRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (hi : GInv g (CGoalL.next laz th)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hReR : ∀ nex g', runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex)
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex :=
  res_n6_lRG laz th g g' nex rest bys hlp (leapTwice_noAx0 hq hr) hi hq hr hReR h

/-- **The model of `%6` under a goal whose `+leap` is `~` and whose need
with the bunt sure is `+none-equivalent`**: phase S (`sixNextSimpleC`), the
forks and bonds dropped by `forkSure laz.sure`. -/
theorem runLC_n6_neRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let o0 ← oo
          let o1 ← oo
          let (s0, s1) ← forkSure laz.sure th.there o0 o1
          let rid ← idM
          sixNfKRG env msup p q r region s0 s1 o0 o1 rid) := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region = _
  rw [sixNextLC.eq_2]
  simp only [hlp, hne, Bool.not_true, Bool.false_eq_true, if_false]
  rfl

/-- The model on such a goal is the one on `[%next [sure ~ ~] then]`. -/
theorem runLC_n6_ne_eqRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next (Lazy.mk laz.sure [] []) th) region := by
  rw [runLC_n6_neRG env msup p q r laz th region hlp hne, runLC_n6_nfRG]

/-- **What `%6` returns in phase S on such a goal**: `GRes` (by `res_n6_nfRG`
on the goal with its sure need only). -/
theorem res_n6_neRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true)
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_ne_eqRG env msup p q r laz th region hlp hne] at h
  obtain ⟨l, b, gi, fr⟩ := res_n6_nfRG ihp ihq ihr laz.sure th g g' nex (ginv_sureOnly hi) h
  refine ⟨l, b, gi, fun y hy => ?_⟩
  rcases fr y hy with e | e
  · exact Or.inl e
  · obtain ⟨s, fk, bd⟩ := laz
    simp only [gregs, lregs, fregs, bregs, List.append_nil] at e ⊢
    exact Or.inr (List.mem_append_left _ e)

/-- **What `%6` returns under a `%next` goal whose `+leap` is `~`.** -/
theorem res_n6_nlRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th)) (hlp : leap laz q r = some Option.none)
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  cases hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) with
  | true => exact res_n6_neRG ihp ihq ihr laz th g g' nex hi hlp hne h
  | false =>
    cases hkt : kerfTest q r laz with
    | true => exact res_n6_kRG ihp ihq ihr laz th g g' nex hi hlp hne hkt h
    | false => exact res_n6_fRG ihp ihq ihr laz th g g' nex hi hlp hne hkt h

/-- The model of `%6` when `+leap` crashes. -/
theorem runLC_n6_crashRG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz : Lazy CSet) (th : Jmp)
    (region : List Nat) (hlp : leap laz q r = Option.none) (g : Gen (TreapMap mugF)) :
    (runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g : Option (NextL CSet × Gen (TreapMap mugF)))
      = Option.none := by
  show sixNextLC env.cod _ _ _ p q r 3 laz th region g = _
  rw [sixNextLC.eq_2]
  simp only [hlp]

/-- **What `%6` returns under every `%next` goal with `GInv`.** -/
theorem res_n6_nextRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region))
    (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (hi : GInv g (CGoalL.next laz th))
    (h : runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  cases hlp : leap laz q r with
  | none => rw [runLC_n6_crashRG env msup p q r laz th region hlp g] at h; cases h
  | some l =>
    cases l with
    | none => exact res_n6_nlRG ihp ihq ihr laz th g g' nex hi hlp h
    | some v =>
      obtain ⟨rest, bys⟩ := v
      have hi' := ginv_rest hi (leapInv hi.1 hq hr) hlp
      have h2 := leapTwice_noAx0 (laz := laz) hq hr rest bys hlp
      exact res_n6_l_twRG laz th g g' nex rest bys hlp hi hq hr
        (fun nex' g'' e => res_n6_nlRG ihp ihq ihr rest th g g'' nex' hi' h2 e) h

/-- **What `%6` returns on every goal with `GInv`.** -/
theorem res_n6_allRG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq0 : ResForR (runLCMR env true msup) q region) (ihr0 : ResForR (runLCMR env true msup) r region)
    (ihq : ∀ rid, ResForR (runLCMR env true msup) q (rid :: region)) (ihr : ∀ rid, ResForR (runLCMR env true msup) r (rid :: region))
    (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r) : ResForR (runLCMR env true msup) (Nomm.n6 p q r) region := by
  intro goal g g' nex hi h
  cases goal with
  | next laz th => exact res_n6_nextRG ihp ihq ihr hq hr laz th g g' nex hi h
  | done => exact res_n6_dpRG ihp ihq0 ihr0 _ (fun _ _ h => by cases h) g g' nex hi h
  | pick z o => exact res_n6_dpRG ihp ihq0 ihr0 _ (fun _ _ h => by cases h) g g' nex hi h

/-- `ResFor` of a nomm with no direct call is `ResForR (runLCMR env true msup)`. -/
theorem resR_of_resG {env : CallEnv} {msup : Option Nomm} {n : Nomm} {region : List Nat} (hn : n.noDirect = true)
    (h : ResFor env msup n region) : ResForR (runLCMR env true msup) n region := by
  intro goal g g' nex hi e
  rw [runLCM_trueG env hn msup] at e
  exact h goal g g' nex hi e

/-- **What the call under `mono` `&` returns** (`GRes`): a direct call with
no key, not dropped, no ring, `env.need b = some nb`, on every goal with
`GInv`.  A register of the result is one of the goal's or at or above the
counter (`sub-pes` and the fresh registers of the runs). -/
theorem res_n2_callMonoG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region)
    {b : Bell} {nb : NeedOrd} {goal : CGoalL CSet}
    (hdr : crdDrop (env.pure b) goal = false) (hnb : env.need b = some nb)
    {g g' : Gen (TreapMap mugF)} {nex : NextL CSet} (hi : GInv g goal)
    (h : runLCMR env true msup (Nomm.n2 p q (some (b, Option.none))) goal region g = some (nex, g')) :
    GRes g goal g' nex := by
  rw [crd_model_n2MR env msup p q b nb goal region hdr hnb] at h
  obtain ⟨subNed, g1, e, h⟩ := bind_some h
  unfold crdCallMMR at h
  obtain ⟨⟨s, o⟩, g2, eb, h⟩ := bind_some h
  unfold crdTailMR at h
  obtain ⟨nexF, g3, ef, h⟩ := bind_some h
  obtain ⟨nexF', g4, e3, h⟩ := bind_some h
  obtain ⟨nexS, g5, e4, e5⟩ := bind_some h
  obtain ⟨hq2, hp2, l2, b2, hs⟩ := crd_goalsMR hi e eb
  have R2 := crd_fq_resR ihq hq2.2.1 hq2.2.2 ef
  have P3 := tail_pgoal hq2 hp2 R2 e3
  have ap : (lregs (Lazy.ofSure (lazyReg s : Sure CSet)) ++ lregs (Lazy.ofSure (Sure.bunt : Sure CSet))).Nodup := by
    rw [lregs_bunt, List.append_nil]; exact hp2.2.1
  obtain ⟨l, bb, i, s'⟩ := tail_res hq2 hp2 ap R2 e3 (ihp _ _ _ _ P3.1 e4) e5
  refine ⟨Nat.le_trans l2 l, Nat.le_trans b2 bb, i, fun r hr => ?_⟩
  rcases s' r hr with e' | e'
  · rw [lregs_bunt, List.append_nil, lregs_reg, List.mem_singleton] at e'
    subst e'
    exact Or.inl hs
  · exact Or.inl (Nat.le_trans l2 e')

/-- **What the dropped call at `mono` `&` returns** (`GRes`). -/
theorem res_n2_dropMonoG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region)
    {b : Bell} {key : Option Noun} {laz : Lazy CSet} {th : Jmp}
    (hpu : env.pure b = true) (hne : Lazy.noneEquivalentL laz = true) {g g' : Gen (TreapMap mugF)}
    {nex : NextL CSet} (hi : GInv g (CGoalL.next laz th))
    (h : runLCMR env true msup (Nomm.n2 p q (some (b, key))) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  have hd : g.drop = false := hi.2.1
  have hj : JmpIn (· < g.re) th := hi.2.2
  rw [crd_model_dropMR env msup p q b key laz th region hpu hne] at h
  unfold crdTailMR at h
  obtain ⟨n2, g2, e1, h⟩ := bind_some h
  obtain ⟨n2', g3, e2, h⟩ := bind_some h
  obtain ⟨n1, g4, e3, e4⟩ := bind_some h
  have R2 := crd_fq_resR ihq hd hj e1
  have P3 := tail_pgoal (ginv_bunt_j hd hj) (linv_bunt _ _) R2 e2
  obtain ⟨l, bb, i, s⟩ := tail_res (ginv_bunt_j hd hj) (linv_bunt _ _) (by simp [lregs_bunt]) R2 e2
    (ihp _ _ _ _ P3.1 e3) e4
  refine ⟨l, bb, i, fun r hr => ?_⟩
  rcases s r hr with e | e
  · simp [lregs_bunt] at e
  · exact Or.inl e

/-- **What the case `%2` on a direct call with no memo key under `mono` `&`
returns** (`GRes`), dropped or not, on every goal with `GInv`. -/
theorem res_n2_directMonoG {env : CallEnv} {msup : Option Nomm} {p q : Nomm} {region : List Nat}
    (ihp : ResForR (runLCMR env true msup) p region) (ihq : ResForR (runLCMR env true msup) q region)
    {b : Bell} {nb : NeedOrd}
    (hnb : env.need b = some nb) :
    ResForR (runLCMR env true msup) (Nomm.n2 p q (some (b, Option.none))) region := by
  intro goal g g' nex hi h
  cases hdr : crdDrop (env.pure b) goal with
  | false => exact res_n2_callMonoG ihp ihq hdr hnb hi h
  | true =>
    cases goal with
    | done => simp [crdDrop] at hdr
    | pick z o => simp [crdDrop] at hdr
    | next laz th =>
      simp only [crdDrop, Bool.and_eq_true] at hdr
      exact res_n2_dropMonoG ihp ihq hdr.1 hdr.2 hi h

