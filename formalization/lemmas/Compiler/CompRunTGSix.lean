variable {ctx : Noun} {X : GenRest → Noun → Noun → Prop} {Y : GenRest → GenRest → Prop}

/-- The parts of `%6` against `runLCMR env true msup` (`SixParts` with the
link `CompRunAtX`, the result `ResForR`, and `+past-fork` as `PastForkAt`). -/
structure SixPartsRTG (env : CallEnv) (msup : Option Nomm) (ctx : Noun) (X : GenRest → Noun → Noun → Prop) (Y : GenRest → GenRest → Prop) (n : Nomm)
    (region : List Nat) : Prop where
  link : ∀ (goal : CGoalL CSet) (g : Gen (TreapMap mugF)), GInv g goal →
    CompRunAtXT (runLCMR env true msup) ctx X Y n goal region g
  res : ResForR (runLCMR env true msup) n region
  pf : PastForkAt ctx env.cod n

/-- **Phase S from `+past-fork` on** (`cr6S7`): `+past-fork` over `p`, the
run of `p` for `[%pick ~^yes ~^nuh]`, and the tail (`cr6s_tail`), given the
link of `p` on that goal and what its runs return, the registers of `lazy`
below the counter and no look at axis `0` in it. -/
theorem cr6s_pRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (hpn : PastForkAt ctx env.cod p)
    (yes nuh : Nat)
    (hP : ∀ g' : Gen (TreapMap mugF), g'.drop = false →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g')
    (hR : ResForR (runLCMR env true msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (lazy : Lazy CSet) (hlz : ∀ y ∈ lregs lazy, y < g.re) (hlok : LAll CrLok lazy)
    (mono goalN sup V6 V5 V4 V3 V2 V1 V0 : Noun) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (C lazy.toNoun (C (A yes) (A nuh))) (C V6 (C V5 (C V4 (C V3 (C V2 (C V1 (C V0
      (crSubj mono (Nomm.n6 p q r).toNoun goalN (listNoun A region) sup (compCore g x ctx)))))))))) cr6S7
      = (sixPMRG env msup p region lazy yes nuh g).map fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  have hpf := hpn (genNoun g x) lazy
  have hD1 := pf_at
  unfold sixPMRG
  simp only [compCore] at hpf ⊢
  cases e1 : Lazy.pastFork env.cod lazy p with
  | none =>
    rw [e1] at hpf
    generalize comp.door = Dr at hpf hD1 ⊢
    unfold cr6S7
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind]
  | some lazy' =>
    rw [e1] at hpf
    simp only [Option.map_some] at hpf
    obtain ⟨x, hy1, hq1⟩ := hP g hd x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [pick_noun] at hq1
    simp only [crSubj, compCore] at hq1
    cases e2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g with
    | none =>
      rw [e2] at hq1
      generalize comp.door = Dr at hpf hD1 hq1 ⊢
      unfold cr6S7 cr6S8
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hq1, e2, cr_bat_dol]
    | some rr =>
      obtain ⟨nexCond, g'⟩ := rr
      rw [e2] at hq1
      simp only [Option.map_some] at hq1
      obtain ⟨l1, -, gi, fr⟩ := hR (CGoalL.pick (jmp0 yes) (jmp0 nuh)) g g' nexCond
        (show GInv g (CGoalL.pick (jmp0 yes) (jmp0 nuh)) from ⟨hd, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) e2
      have hf : ∀ y ∈ lregs nexCond.laz, y < g'.re := lnb_regs gi.1.1
      have hs' : ∀ y ∈ lregs lazy', y < g'.re := fun y hy => by
        rw [lregs_pastFork e1] at hy; have := hlz y hy; omega
      have ap : ∀ y ∈ lregs nexCond.laz, y ∉ lregs lazy' := fun y hy hy' => by
        rw [lregs_pastFork e1] at hy'
        have := hlz y hy'
        rcases fr y hy with h | h
        · omega
        · simp [gregs] at h
      have ht := cr6s_tail h7 x hx g' nexCond lazy' (C (A yes) (A nuh)) V6 V5 V4 V3 V2 V1 V0 crBat crB
        (C mono (C (Nomm.n6 p q r).toNoun (C goalN (C (listNoun A region) sup)))) hf hs' ap
        (lall_pastFork (fun y hy => by simp [Sure.bunt] at hy; exact absurd hy (HoonSet.mem_empty y)) e1 hlok)
      simp only [compCore, Nomm.toNoun] at ht
      generalize comp.door = Dr at hpf hD1 hq1 ht ⊢
      unfold cr6S7 cr6S8
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hq1, e2, cr_bat_dol, ht]

/-- **The pair of `%hop` blocks under `%done` and `%pick`** (`cr6S6`, its
non-`%next` branch, then `cr6S7`). -/
theorem cr6s_lyn_dpRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (hpn : PastForkAt ctx env.cod p)
    (hP : ∀ (yes nuh : Nat) (g' : Gen (TreapMap mugF)), g'.drop = false →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g')
    (hR : ResForR (runLCMR env true msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (nex0 nex1 : NextL CSet) (h0 : LAll (LNB g.re) nex0.laz) (h1 : LAll (LNB g.re) nex1.laz)
    (mono grest sup cbw cb RB GG LEP : Noun) (tag : Nat) (htag : tag ≠ 0x7478656e) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun (C cbw (C nex1.goal.toNoun (C cb (C RB (C GG (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun (C (A tag) grest) (listNoun A region) sup (compCore g x ctx))))))))) cr6S6
      = (sixLynDPRG env msup p region nex0 nex1 g).map fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have htag' : ¬ ((0x7478656e : Nat) = tag) := fun h => htag h.symm
  obtain ⟨l0, ⟨a0, t0⟩⟩ := nex0
  obtain ⟨l1, ⟨a1, t1⟩⟩ := nex1
  simp only [NextL.goal, cgl_next_noun6]
  have he1 := cf_emit (x := x) hc g ⟨[], [], Termin.hop ⟨a0, t0⟩⟩
  generalize hg1 : cfEmitG ⟨[], [], Termin.hop ⟨a0, t0⟩⟩ g = g1 at he1
  have he2 := cf_emit (x := x) hc g1 ⟨[], [], Termin.hop ⟨a1, t1⟩⟩
  generalize hg2 : cfEmitG ⟨[], [], Termin.hop ⟨a1, t1⟩⟩ g1 = g2 at he2
  have hst1 := comp_set_tag x hc g2 g.bo region
  have hst2 := comp_set_tag x hc (stG g.bo region g2) g1.bo region
  have r1 : g1.re = g.re := by rw [← hg1, cf_emitG_re]
  have r2 : g2.re = g.re := by rw [← hg2, cf_emitG_re, r1]
  have d1 : g1.drop = false := by rw [← hg1, cf_emitG_drop]; exact hd
  have d2 : g2.drop = false := by rw [← hg2, cf_emitG_drop]; exact d1
  simp only [Blob.toNoun, listNoun, Termin.toNoun, Tag.hop, Jmp.toNoun] at he1 he2
  simp only [st_apply, Option.map_some] at hst1 hst2
  have hD1 := comp_emit_at
  have hD2 := comp_set_tag_at
  unfold sixLynDPRG
  simp only [bind_apply, cf_emit_g, hg1, hg2, Option.bind_some, st_apply]
  generalize hg4 : stG g1.bo region (stG g.bo region g2) = g4 at hst2 ⊢
  have d4 : g4.drop = false := by rw [← hg4, stG_drop, stG_drop]; exact d2
  have r4 : g4.re = g.re := by rw [← hg4, stG_re, stG_re]; exact r2
  rcases a0 with _ | ⟨a0h, a0t⟩
  · rcases a1 with _ | ⟨a1h, a1t⟩
    · simp only [listNoun] at he1 he2
      have hlz : ∀ y ∈ lregs (Lazy.mk Sure.bunt [((g.bo, l0), (g1.bo, l1))] [] : Lazy CSet), y < g4.re := by
        intro y hy
        simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
          List.mem_append] at hy
        rw [r4]
        rcases hy with hy | hy
        · exact lnb_regs h0 y hy
        · exact lnb_regs h1 y hy
      have hlok : LAll CrLok (Lazy.mk Sure.bunt [((g.bo, l0), (g1.bo, l1))] [] : Lazy CSet) :=
        ⟨fun y hy => by simp [Sure.bunt] at hy; exact absurd hy (HoonSet.mem_empty y),
          ⟨by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h0,
           by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h1, trivial⟩, trivial⟩
      obtain ⟨x, hy1, hpm⟩ := cr6s_pRTG hYk h7 hcode env msup p q r region hpn g.bo g1.bo (hP g.bo g1.bo) hR x hx g4 d4
        _ hlz hlok mono (C (A tag) grest) sup
        (C (A 0x7478656e) (C l0.toNoun (C (A 0) (A t0)))) cbw
        (C (A 0x7478656e) (C l1.toNoun (C (A 0) (A t1)))) cb RB GG LEP
      replace hY0 := hYk.trans hY0 hy1
      replace hx := hYk.soft hx hy1
      replace hX := hYk.pres hX hy1
      rw [lyn_lazy_noun] at hpm
      simp only [crSubj, compCore] at hpm hst1 hst2 ⊢
      generalize comp.door = Dr at he1 he2 hst1 hst2 hD1 hD2 hpm ⊢
      unfold cr6S6 cr6SA6
      simp only [Nomm.toNoun, NextL.goal] at hpm
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, htag, htag', hD1, comp_emit_arm, he1, he2, hD2, comp_set_tag_arm, hst1, hst2, hpm,
        listNoun, Nomm.toNoun, NextL.goal]
    · simp only [listNoun] at he1 he2
      simp only [crSubj, compCore] at hst1 hst2 ⊢
      generalize comp.door = Dr at he1 he2 hst1 hst2 hD1 hD2 ⊢
      unfold cr6S6 cr6SA6
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, htag, htag', hD1, comp_emit_arm, he1, he2, hD2, comp_set_tag_arm, hst1, hst2, listNoun,
        Nomm.toNoun]
  · simp only [listNoun] at he1 he2
    simp only [crSubj, compCore] at hst1 hst2 ⊢
    generalize comp.door = Dr at he1 he2 hst1 hst2 hD1 hD2 ⊢
    unfold cr6S6 cr6SA6
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, htag, htag', hD1, comp_emit_arm, he1, he2, hD2, comp_set_tag_arm, hst1, hst2, listNoun,
      Nomm.toNoun]

/-- **The two runs of the branches** (`cr6S2` to `cr6S5`): `cond-before`,
the run of `r` for `goal-1` in `region-branch`, `cond-between`, the run of
`q` for `goal-0`, then a continuation `K` from `cr6S6` on, given the links
of the two runs. -/
theorem cr6s_midRTG (hYk : YOk X Y) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (rb : List Nat)
    (goal0 goal1 : CGoalL CSet) (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF))
    (mono goalN regionN sup LEP : Noun)
    (K : TreapMap mugF (Nat × List Nat) → TreapMap mugF (Nat × List Nat) → NextL CSet → NextL CSet →
      CM (TreapMap mugF) (NextL CSet))
    (hr : CompRunAtXT (runLCMR env true msup) ctx X Y r goal1 rb g)
    (hq : ∀ nex1 g1, runLCMR env true msup r goal1 rb g = some (nex1, g1) → CompRunAtXT (runLCMR env true msup) ctx X Y q goal0 rb g1)
    (hK : ∀ nex1 g1 nex0 g2, runLCMR env true msup r goal1 rb g = some (nex1, g1) →
      runLCMR env true msup q goal0 rb g1 = some (nex0, g2) →
      ∀ x, x.NoSoft → X x mono sup → ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun (C (condN g1) (C nex1.goal.toNoun (C (condN g) (C (listNoun A rb)
        (C (C goal0.toNoun goal1.toNoun) (C LEP
          (crSubj mono (Nomm.n6 p q r).toNoun goalN regionN sup (compCore g2 x ctx))))))))) cr6S6
        = (K g.cond g1.cond nex0 nex1 g2).map fun p => C p.1.goal.toNoun (genNoun p.2 x')) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (listNoun A rb) (C (C goal0.toNoun goal1.toNoun) (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun goalN regionN sup (compCore g x ctx))))) cr6S2
      = ((do
          let cb ← getCond
          let nex1 ← runLCMR env true msup r goal1 rb
          let cbw ← getCond
          let nex0 ← runLCMR env true msup q goal0 rb
          K cb cbw nex0 nex1 : CM (TreapMap mugF) (NextL CSet)) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨x, hy1, hr1⟩ := hr x mono sup hx hX
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  simp only [crSubj, compCore, genNoun] at hr1
  simp only [bind_apply, getCond, Option.bind_some]
  cases e1 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup r goal1 rb g with
  | none =>
    rw [e1] at hr1
    unfold cr6S2 cr6S3
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, genNoun]
  | some rr =>
    obtain ⟨nex1, g1⟩ := rr
    rw [e1] at hr1
    simp only [Option.map_some] at hr1
    obtain ⟨x, hy2, hq1⟩ := hq nex1 g1 e1 x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy2
    replace hx := hYk.soft hx hy2
    replace hX := hYk.pres hX hy2
    simp only [crSubj, compCore, genNoun] at hq1
    cases e2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q goal0 rb g1 with
    | none =>
      rw [e2] at hq1
      unfold cr6S2 cr6S3 cr6S4 cr6S5
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, hq1, genNoun, e2]
    | some rr =>
      obtain ⟨nex0, g2⟩ := rr
      rw [e2] at hq1
      simp only [Option.map_some] at hq1
      obtain ⟨xK3, hy3, hk⟩ := hK nex1 g1 nex0 g2 e1 e2 x hx hX
      have hY0K3 := hYk.trans hY0 hy3
      simp only [crSubj, compCore, condN, genNoun, Nomm.toNoun] at hk
      unfold cr6S2 cr6S3 cr6S4 cr6S5
      refine ⟨xK3, hY0K3, ?_⟩
      simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, hq1, hk, genNoun, e2]

/-- **The case `%6` of `+run` under `%done` and `%pick`**, on every state with
the invariant, given the links and results of the parts (`SixParts`) in the
region of the case (under `%done` and `%pick` the branches are compiled in
the case's own region). -/
theorem comp_run_n6_dpRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : SixPartsRTG env msup ctx X Y q region) (R : SixPartsRTG env msup ctx X Y r region)
    (goal : CGoalL CSet) (hg : ∀ laz th, goal ≠ CGoalL.next laz th) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) goal region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hd : g.drop = false := ginv_drop hinv
  obtain ⟨tag, grest, hgn, htag⟩ : ∃ (tag : Nat) (grest : Noun), goal.toNoun = C (A tag) grest ∧ tag ≠ 0x7478656e := by
    cases goal with
    | next laz th => exact absurd rfl (hg laz th)
    | done => exact ⟨_, _, rfl, by decide⟩
    | pick z o => exact ⟨_, _, rfl, by decide⟩
  have htag' : ¬ ((0x7478656e : Nat) = tag) := fun h => htag h.symm
  rw [runLC_n6_dpRG env msup p q r goal hg region]
  obtain ⟨x, hy1, hm⟩ := cr6s_midRTG hYk (ctx := ctx) env msup p q r region goal goal x hx g mono goal.toNoun (listNoun A region) sup
    (A 0) (fun _ _ nex0 nex1 => sixLynDPRG env msup p region nex0 nex1) (R.link goal g hinv)
    (fun nex1 g1 e1 => Q.link goal g1 (by
      obtain ⟨l1, b1, gi1, -⟩ := R.res goal g g1 nex1 hinv e1
      exact ginv_mono hinv l1 b1 ((ginv_drop gi1).trans hd.symm)))
    (fun nex1 g1 nex0 g2 e1 e2 x hx hX => by
      obtain ⟨l1, b1, gi1, -⟩ := R.res goal g g1 nex1 hinv e1
      have hi1 : GInv g1 goal := ginv_mono hinv l1 b1 ((ginv_drop gi1).trans hd.symm)
      obtain ⟨l2, b2, gi2, -⟩ := Q.res goal g1 g2 nex0 hi1 e2
      have d2 : g2.drop = false := ginv_drop gi2
      rw [hgn]
      exact cr6s_lyn_dpRTG hYk h7 hcode env msup p q r region P.pf
        (fun yes nuh g' hd' => P.link _ g' ⟨hd', jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) P.res x hx g2 d2 nex0 nex1
        gi2.1.1 (lnb_mono l2 0 gi1.1.1) mono grest sup (condN g1) (condN g) (listNoun A region)
        (C (C (A tag) grest) (C (A tag) grest)) (A 0) tag htag)
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  rw [hgn] at hm
  rw [Nomm.toNoun, cr_disp_n6, cr6_eq, hgn]
  simp only [crSubj, compCore, Nomm.toNoun] at hm ⊢
  generalize comp.door = Dr at hm ⊢
  unfold cr6Head cr6NoLep cr6S0 cr6S1 cr6Lep cr6T2 cr6SA0 cr6SA1
  refine ⟨x, hY0, ?_⟩
  simp [nock_exec, htag', hm]

/-- **The `%next` branch of `cr6S6`, then `cr6S7`**: the asserts that both
branch goals are `%next`, the call of `+sect` on `[nex-0 nex-1 there.then.goal-0
there.then.goal-1 region-branch cond-before cond-between]`, and the rest
from `+past-fork` on (`cr6s_pRTG hYk`), given the links of `p` and that the needs of
the branches' results are below the counter. -/
theorem cr6s_lyn_nRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region rb : List Nat)
    (hpn : PastForkAt ctx env.cod p)
    (hP : ∀ (yes nuh : Nat) (g' : Gen (TreapMap mugF)), g'.drop = false →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region g')
    (hR : ResForR (runLCMR env true msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false)
    (nex0 nex1 : NextL CSet) (h0 : LAll (LNB g.re) nex0.laz) (h1 : LAll (LNB g.re) nex1.laz)
    (l0 l1 : Lazy CSet) (o0 o1 : Nat) (cb cbw : TreapMap mugF (Nat × List Nat))
    (mono grest sup LEP : Noun) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun (C (HoonMap.toNoun condValNoun cbw) (C nex1.goal.toNoun
      (C (HoonMap.toNoun condValNoun cb) (C (listNoun A rb)
      (C (C (CGoalL.next l0 (jmp0 o0)).toNoun (CGoalL.next l1 (jmp0 o1)).toNoun) (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun (C (A 0x7478656e) grest) (listNoun A region) sup
        (compCore g x ctx))))))))) cr6S6
      = (sixLynNRG env msup p region rb o0 o1 cb cbw nex0 nex1 g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hs := comp_sect (x := x) hc nex0 nex1 o0 o1 rb cb cbw g
  have hD := sect_at
  simp only [scSmp] at hs
  unfold sixLynNRG
  rw [bind_apply]
  cases e : sect nex0 nex1 o0 o1 rb cb cbw g with
  | none =>
    rw [e] at hs
    simp only [Option.map_none, Option.bind_none]
    rw [next_jmp0_noun, next_jmp0_noun]
    simp only [crSubj, compCore] at hs ⊢
    generalize nex0.goal.toNoun = N0 at hs ⊢
    generalize nex1.goal.toNoun = N1 at hs ⊢
    generalize comp.door = Dr at hs hD ⊢
    unfold cr6S6 cr6SA6
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, sect_arm, hs]
  | some v =>
    obtain ⟨⟨lazy, yes, nuh⟩, g'⟩ := v
    rw [e] at hs
    simp only [Option.map_some, Option.bind_some] at hs ⊢
    have hl := sect_lazy e
    obtain ⟨kr, -, kd⟩ := (km_sect nex0 nex1 o0 o1 rb cb cbw).keep _ _ _ e
    subst hl
    have hlz : ∀ y ∈ lregs (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet), y < g'.re := by
      intro y hy
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append] at hy
      rcases hy with hy | hy
      · exact Nat.lt_of_lt_of_le (lnb_regs h0 y hy) kr
      · exact Nat.lt_of_lt_of_le (lnb_regs h1 y hy) kr
    have hlok : LAll CrLok (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet) :=
      ⟨fun y hy => by simp [Sure.bunt] at hy; exact absurd hy (HoonSet.mem_empty y),
        ⟨by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h0,
         by rw [walkP_irrel]; exact lall_mono (fun _ h => h.1) h1, trivial⟩, trivial⟩
    obtain ⟨x, hy1, hpm⟩ := cr6s_pRTG hYk h7 hcode env msup p q r region hpn yes nuh (hP yes nuh) hR x hx g' (kd.trans hd)
      _ hlz hlok mono (C (A 0x7478656e) grest) sup nex0.goal.toNoun (HoonMap.toNoun condValNoun cbw)
      nex1.goal.toNoun (HoonMap.toNoun condValNoun cb) (listNoun A rb)
      (C (CGoalL.next l0 (jmp0 o0)).toNoun (CGoalL.next l1 (jmp0 o1)).toNoun) LEP
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [next_jmp0_noun, next_jmp0_noun] at hpm ⊢
    simp only [crSubj, compCore] at hs hpm ⊢
    generalize nex0.goal.toNoun = N0 at hs hpm ⊢
    generalize nex1.goal.toNoun = N1 at hs hpm ⊢
    generalize (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet).toNoun = LZ at hs hpm ⊢
    generalize comp.door = Dr at hs hD hpm ⊢
    unfold cr6S6 cr6SA6
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, sect_arm, hs, hpm]

/-- **The case `%6` of `+run` under a fork-free `%next` goal** (no fork, no
bond: phase S), on every state with the invariant, given the links and
results of the parts (`SixParts`): the test `p` in the case's region, the
branches `q` and `r` in every region `rid :: region` (they run in the
region of the fork). -/
theorem comp_run_n6_nfRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region))
    (s : Sure CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next (Lazy.mk s [] []) th)) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next (Lazy.mk s [] []) th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hd : g.drop = false := ginv_drop hinv
  have hl0 : CrLok s := hinv.1.1.1.1
  rw [cr6s_head_nf h7, runLC_n6_nfRG]
  refine cr6s_s01T hYk hc p q r s th region x g mono sup (sixNfKRG env msup p q r region) (fun s0 s1 g3 ef => ?_)
  obtain ⟨-, -, d3, lk0, lk1, D0, D1, -, fr⟩ := forkSure_inv ef
  have dI : (idG g3).drop = false := d3.trans hd
  have gi1 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) :=
    ginv_ofSure (fun y hy => hl0 y (lk1 ▸ hy)) (fun y hy => (fr y (Or.inr hy)).2) D1 dI
  have gi0 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_ofSure (fun y hy => hl0 y (lk0 ▸ hy)) (fun y hy => (fr y (Or.inl hy)).2) D0 dI
  exact xt_trans hYk hY0 (cr6s_midRTG hYk (ctx := ctx) env msup p q r (g3.id :: region) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo))
    (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) x hx (idG g3) mono
    (CGoalL.next (Lazy.mk s [] []) th).toNoun (listNoun A region) sup (A 0)
    (fun cb cbw nex0 nex1 => sixLynNRG env msup p region (g3.id :: region) g.bo (g.bo + 1) cb cbw nex0 nex1)
    ((R g3.id).link _ _ gi1)
    (fun nex1 g1 e1 => (Q g3.id).link _ g1 (by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      exact ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)))
    (fun nex1 g1 nex0 g2 e1 e2 x hx hX => by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      have hi0 := ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)
      obtain ⟨l2, -, gi2, -⟩ := (Q g3.id).res _ g1 g2 nex0 hi0 e2
      exact cr6s_lyn_nRTG hYk h7 hcode env msup p q r region (g3.id :: region) P.pf
        (fun yes nuh g' hd' => P.link _ g' ⟨hd', jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) P.res x hx g2 (ginv_drop gi2)
        nex0 nex1 gi2.1.1 (lnb_mono l2 0 gi1'.1.1) (Lazy.ofSure s0) (Lazy.ofSure s1) g.bo (g.bo + 1)
        (idG g3).cond g1.cond mono (C (Lazy.mk s [] []).toNoun th.toNoun) sup (A 0)))

/-- **Phase K** (`cr6K0`, `cr6K1`): `+kerf` of the goal (`comp_kerf_all`),
the state put back, then `$` again on the goal `[%next (lazy-from-need
this+pro) ~ out]`, given the link of that run. -/
theorem cr6k_eqRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (laz : Lazy CSet) (th : Jmp) (region : List Nat) (x : GenRest) (g : Gen (TreapMap mugF))
    (mono sup LEP : Noun) (hP : WalkP (mdP x) g.bo laz)
    (hK : ∀ out pro g', kerf ⟨laz, th⟩ g = some ((out, pro), g') →
      ∃ x', Y x x' ∧ nock (crSubj mono (Nomm.n6 p q r).toNoun
        (CGoalL.next (Lazy.ofSure (⟨Need.this pro, HoonSet.empty⟩ : Sure CSet)) (jmp0 out)).toNoun
          (listNoun A region) sup
        (compCore g' x ctx)) crDol
      = (runLCMR (S := CSet) env true msup (Nomm.n6 p q r)
          (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region g').map
          fun p => C p.1.goal.toNoun (genNoun p.2 x')) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C LEP (crSubj mono (Nomm.n6 p q r).toNoun (CGoalL.next laz th).toNoun (listNoun A region) sup
      (compCore g x ctx))) cr6K0
      = ((do
          let (out, pro) ← kerf ⟨laz, th⟩
          runLCMR env true msup (Nomm.n6 p q r)
            (CGoalL.next (Lazy.ofSure ⟨Need.this pro, HoonSet.empty⟩) (jmp0 out)) region :
            CM (TreapMap mugF) (NextL CSet)) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, hl, hm⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  have hkf := comp_kerf_all hc hl hm x g ⟨laz, th⟩ hP
  have hD := comp_kerf_at
  simp only [compCore] at hkf
  rw [bind_apply]
  cases ek : kerf ⟨laz, th⟩ g with
  | none =>
    rw [ek] at hkf
    simp only [Option.bind_none, Option.map_none]
    simp only [crSubj, compCore, CGoalL.toNoun] at hkf ⊢
    generalize comp.door = Dr at hD hkf ⊢
    unfold cr6K0
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, comp_kerf_arm, hkf]
  | some v =>
    obtain ⟨⟨out, pro⟩, g'⟩ := v
    rw [ek] at hkf
    obtain ⟨xK1, hy1, hr⟩ := hK out pro g' ek
    have hY0K1 := hYk.trans hY0 hy1
    rw [goalK_noun] at hr
    simp only [Option.bind_some, Option.map_some] at hkf ⊢
    simp only [crSubj, compCore, CGoalL.toNoun] at hkf hr ⊢
    generalize comp.door = Dr at hD hkf hr ⊢
    unfold cr6K0 cr6K1
    refine ⟨xK1, hY0K1, ?_⟩
    simp [nock_exec, hD, comp_kerf_arm, hkf, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, cr_bat_dol, hr]

/-- **The case `%6` of `+run` in phase K**: under a `%next` goal with
`GInv` whose `+leap` is `~` (`hlp`, in the model; the Nock of `+leap` is the
model's by `lp6_leap_none`, for `q` and `r` with no axis `0`, `hq`, `hr`),
whose need with the bunt sure is not `+none-equivalent` and whose `+kerf`
test holds, given the parts (`SixParts`, the branches in the regions
`rid :: region`): `+kerf`, then phase S on the fork-free goal
(`comp_run_n6_nfRTG hYk`). -/
theorem comp_run_n6_kRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (hlp : leap laz q r = some Option.none) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = true) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hd := ginv_drop hinv
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  rw [cr6k_head h7 p q r laz th region x hx g mono sup (lp6_leap_none h7 hl hq hr g hlp x hx) hne hkt,
    runLC_n6_kRG env msup p q r laz th region hlp hne hkt]
  exact xt_trans hYk hY0 (cr6k_eqRTG hYk h7 env msup p q r laz th region x g mono sup (A 0) (walk_mdP hx _ hl)
    (fun out pro g' ek => comp_run_n6_nfRTG hYk h7 hcode env msup p q r region P Q R ⟨Need.this pro, HoonSet.empty⟩
      (jmp0 out) g' (ginv_kerf ek hd) x mono sup hx hX))

/-- **Phase F from `+past-fork` on** (`cr6F9` ... `cr6F14`): `+past-fork`
over `p`, the `%brn` block on `r-cond` by `+emit`, `+lazy-shut` at it, the
run of `p` on `[%next (lazy-from-need this+r-cond) ~ o]`, and `+copy`, given
the link of `p` on that goal and what its runs return, `LInv` of `lazy`,
`r-cond` below the counter and not in `lazy`. -/
theorem cr6f_pRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (hpn : PastForkAt ctx env.cod p) (rc yes nuh : Nat)
    (hP : ∀ (o : Nat) (g' : Gen (TreapMap mugF)),
      GInv g' (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 o)) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 o)) region g')
    (hR : ResForR (runLCMR env true msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false) (hrc : rc < g.re)
    (lazy : Lazy CSet) (hl : LInv g.re g.bo lazy) (hap : rc ∉ lregs lazy)
    (mono goalN sup V8 V7 V6 V5 V4 V3 V2 V1 : Noun) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (C lazy.toNoun (C (A yes) (A nuh))) (C V8 (C V7 (C V6 (C V5 (C V4 (C V3 (C V2 (C (A rc) (C V1
      (crSubj mono (Nomm.n6 p q r).toNoun goalN (listNoun A region) sup (compCore g x ctx)))))))))))) cr6F9
      = (sixPFRG env msup p region rc lazy yes nuh g).map fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have h15 := cr_ctx15 h7
  have hpf := hpn (genNoun g x) lazy
  have hD1 := pf_at
  have hD2 := comp_cp_at
  have hD3 := comp_emit_at
  have hD4 := lsh_at
  unfold sixPFRG
  simp only [compCore] at hpf ⊢
  cases e1 : Lazy.pastFork env.cod lazy p with
  | none =>
    rw [e1] at hpf
    generalize comp.door = Dr at hpf hD1 hD2 hD3 hD4 ⊢
    unfold cr6F9
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind]
  | some lazy' =>
  rw [e1] at hpf
  simp only [Option.map_some] at hpf
  have hl' : LInv g.re g.bo lazy' := linv_pastFork e1 hl
  have hap' : rc ∉ lregs lazy' := by rw [lregs_pastFork e1]; exact hap
  have he := cf_emit (x := x) hc g ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩
  have hre := cf_emitG_re ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩ g
  have hbo := cf_emitG_bo ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩ g
  have hdr : (cfEmitG ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩ g).drop = false := by
    rw [cf_emitG_drop]; exact hd
  generalize hg1 : cfEmitG ⟨[], [], Termin.brn rc (jmp0 yes) (jmp0 nuh)⟩ g = g1 at he hre hbo hdr
  simp only [Blob.toNoun, listNoun, Termin.toNoun, Tag.brn, cr_jmp0] at he
  have hsh := comp_lazy_shut h7 x hx g1 g.bo lazy' (walk_mdP hx _ (lall_mono (fun _ h => h.1) hl'.1))
  simp only [compCore] at hsh
  cases e3 : lazyShut g.bo lazy' g1 with
  | none =>
    rw [e3] at hsh
    generalize comp.door = Dr at hpf hD1 hD2 hD3 hD4 he hsh ⊢
    unfold cr6F9 cr6F10 cr6F11
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hD3, comp_emit_arm, he,
      cf_emit_g, hg1, hD4, lsh_arm, hsh, e3, Blob.toNoun, listNoun, Termin.toNoun, Tag.brn, cr_jmp0]
  | some v3 =>
  obtain ⟨lazy'', g2⟩ := v3
  rw [e3] at hsh
  simp only [Option.map_some] at hsh
  obtain ⟨k2r, k2b, k2d, hl2, f2⟩ := lazyShut_inv (linv_mono hl' (by omega) (by omega)) e3
  have hd2 : g2.drop = false := k2d.trans hdr
  obtain ⟨x, hy1, hq1⟩ := hP g.bo g2 (ginv_rc (by omega) hd2) x mono sup hx hX
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  rw [goalK_noun] at hq1
  simp only [crSubj, compCore] at hq1
  cases e4 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup p
      (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 g.bo)) region g2 with
  | none =>
    rw [e4] at hq1
    generalize comp.door = Dr at hpf hD1 hD2 hD3 hD4 he hsh hq1 ⊢
    unfold cr6F9 cr6F10 cr6F11 cr6F12
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hD3, comp_emit_arm, he,
      cf_emit_g, hg1, hD4, lsh_arm, hsh, e3, hq1, e4, cr_bat_dol, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate,
      Blob.toNoun, listNoun, Termin.toNoun, Tag.brn, cr_jmp0]
  | some v4 =>
  obtain ⟨nexCond, g3⟩ := v4
  rw [e4] at hq1
  simp only [Option.map_some] at hq1
  obtain ⟨l3, -, gi3, fr3⟩ := hR _ g2 g3 nexCond (ginv_rc (by omega) hd2) e4
  have hf : ∀ y ∈ lregs nexCond.laz, y < g3.re := lnb_regs gi3.1.1
  have hs : ∀ y ∈ lregs lazy'', y < g3.re := fun y hy => by have := lnb_regs hl2.1 y hy; omega
  have ap : ∀ y ∈ lregs nexCond.laz, y ∉ lregs lazy'' := fun y hy hy' => by
    have := lnb_regs hl2.1 y hy'
    rcases fr3 y hy with e | e
    · omega
    · change y ∈ lregs (Lazy.ofSure (lazyReg rc : Sure CSet)) at e
      rw [lregs_reg, List.mem_singleton] at e
      subst e
      rcases f2 _ hy' with e' | e'
      · exact hap' e'
      · omega
  have hcp := comp_copy_all h7 x g3 nexCond lazy'' (copyH_of_regs hf hs ap)
  simp only [compCore] at hcp
  generalize comp.door = Dr at hpf hD1 hD2 hD3 hD4 he hsh hq1 hcp ⊢
  unfold cr6F9 cr6F10 cr6F11 cr6F12 cr6F13 cr6F14
  refine ⟨x, hY0, ?_⟩
  simp [nock_exec, crSubj, Nomm.toNoun, hD1, pf_arm, hpf, liftO, bind, StateT.bind, hD3, comp_emit_arm, he,
    cf_emit_g, hg1, hD4, lsh_arm, hsh, e3, hq1, e4, cr_bat_dol, h15, ct_lfn_at, ct_lfn_arm, ct_lfn_gate, hD2,
    cr_cp_arm, hcp, Blob.toNoun, listNoun, Termin.toNoun, Tag.brn, cr_jmp0]

/-- **`+sect` in phase F** (`cr6F8`, no asserts before it), then the rest
from `+past-fork` on (`cr6f_pRTG hYk`), given the links of `p`, `LInv` of the two
branch needs, apart, and `r-cond` below the counter and in neither. -/
theorem cr6f_lynRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region rb : List Nat)
    (hpn : PastForkAt ctx env.cod p) (rc : Nat)
    (hP : ∀ (o : Nat) (g' : Gen (TreapMap mugF)),
      GInv g' (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 o)) →
      CompRunAtXT (runLCMR env true msup) ctx X Y p (CGoalL.next (Lazy.ofSure ⟨Need.this rc, HoonSet.empty⟩) (jmp0 o)) region g')
    (hR : ResForR (runLCMR env true msup) p region)
    (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF)) (hd : g.drop = false) (hrc : rc < g.re)
    (nex0 nex1 : NextL CSet) (h0 : LInv g.re g.bo nex0.laz) (h1 : LInv g.re g.bo nex1.laz)
    (ap01 : ∀ y ∈ lregs nex0.laz, y ∉ lregs nex1.laz) (a0 : rc ∉ lregs nex0.laz) (a1 : rc ∉ lregs nex1.laz)
    (l0 l1 : Lazy CSet) (o0 o1 rid : Nat) (cb cbw : TreapMap mugF (Nat × List Nat)) (mono goalN sup : Noun) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun (C (HoonMap.toNoun condValNoun cbw) (C nex1.goal.toNoun
      (C (HoonMap.toNoun condValNoun cb) (C (listNoun A rb) (C (A rid)
      (C (C (CGoalL.next l0 (jmp0 o0)).toNoun (CGoalL.next l1 (jmp0 o1)).toNoun) (C (A rc) (C (A 0)
      (crSubj mono (Nomm.n6 p q r).toNoun goalN (listNoun A region) sup (compCore g x ctx))))))))))) cr6F8
      = (sixLynFRG env msup p region rb rc o0 o1 cb cbw nex0 nex1 g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hs := comp_sect (x := x) hc nex0 nex1 o0 o1 rb cb cbw g
  have hD := sect_at
  simp only [scSmp] at hs
  unfold sixLynFRG
  rw [bind_apply]
  cases e : sect nex0 nex1 o0 o1 rb cb cbw g with
  | none =>
    rw [e] at hs
    simp only [Option.map_none, Option.bind_none]
    rw [next_jmp0_noun, next_jmp0_noun]
    simp only [crSubj, compCore] at hs ⊢
    generalize nex0.goal.toNoun = N0 at hs ⊢
    generalize nex1.goal.toNoun = N1 at hs ⊢
    generalize comp.door = Dr at hs hD ⊢
    unfold cr6F8
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, sect_arm, hs]
  | some v =>
    obtain ⟨⟨lazy, yes, nuh⟩, g'⟩ := v
    rw [e] at hs
    simp only [Option.map_some, Option.bind_some] at hs ⊢
    have hl := sect_lazy e
    obtain ⟨kr, kb, kd⟩ := (km_sect nex0 nex1 o0 o1 rb cb cbw).keep _ _ _ e
    obtain ⟨hy, hn⟩ := sect_labels e
    subst hl
    have lvF := lyn_linv (linv_mono h0 kr kb) (linv_mono h1 kr kb) ap01 hy hn
    have hap : rc ∉ lregs (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet) := by
      simp only [lregs, fregs, bregs, flattenNeed, Sure.bunt, List.nil_append, List.append_nil,
        List.mem_append, not_or]
      exact ⟨a0, a1⟩
    obtain ⟨x, hy1, hpm⟩ := cr6f_pRTG hYk h7 hcode env msup p q r region hpn rc yes nuh hP hR x hx g' (kd.trans hd)
      (by omega) _ lvF hap mono goalN sup nex0.goal.toNoun (HoonMap.toNoun condValNoun cbw)
      nex1.goal.toNoun (HoonMap.toNoun condValNoun cb) (listNoun A rb) (A rid)
      (C (CGoalL.next l0 (jmp0 o0)).toNoun (CGoalL.next l1 (jmp0 o1)).toNoun) (A 0)
    replace hY0 := hYk.trans hY0 hy1
    replace hx := hYk.soft hx hy1
    replace hX := hYk.pres hX hy1
    rw [next_jmp0_noun, next_jmp0_noun] at hpm ⊢
    simp only [crSubj, compCore] at hs hpm ⊢
    generalize nex0.goal.toNoun = N0 at hs hpm ⊢
    generalize nex1.goal.toNoun = N1 at hs hpm ⊢
    generalize (Lazy.mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] [] : Lazy CSet).toNoun = LZ at hs hpm ⊢
    generalize comp.door = Dr at hs hD hpm ⊢
    unfold cr6F8
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, hD, sect_arm, hs, hpm]

/-- **The two runs of the branches in phase F** (`cr6F4` to `cr6F7`):
`cond-before`, the run of `r` for `goal-1` in `region-branch`,
`cond-between`, the run of `q` for `goal-0`, then a continuation `K` from
`cr6F8` on, given the links of the two runs (as `cr6s_midRTG hYk`, on the subject
of phase F, which holds `region-id` and `r-cond` too). -/
theorem cr6f_midRTG (hYk : YOk X Y) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (rb : List Nat)
    (goal0 goal1 : CGoalL CSet) (x : GenRest) (hx : x.NoSoft) (g : Gen (TreapMap mugF))
    (mono goalN regionN sup LEP : Noun) (rid rc : Nat)
    (K : TreapMap mugF (Nat × List Nat) → TreapMap mugF (Nat × List Nat) → NextL CSet → NextL CSet →
      CM (TreapMap mugF) (NextL CSet))
    (hr : CompRunAtXT (runLCMR env true msup) ctx X Y r goal1 rb g)
    (hq : ∀ nex1 g1, runLCMR env true msup r goal1 rb g = some (nex1, g1) → CompRunAtXT (runLCMR env true msup) ctx X Y q goal0 rb g1)
    (hK : ∀ nex1 g1 nex0 g2, runLCMR env true msup r goal1 rb g = some (nex1, g1) →
      runLCMR env true msup q goal0 rb g1 = some (nex0, g2) →
      ∀ x, x.NoSoft → X x mono sup → ∃ x', Y x x' ∧ nock (C nex0.goal.toNoun (C (condN g1) (C nex1.goal.toNoun (C (condN g) (C (listNoun A rb) (C (A rid)
        (C (C goal0.toNoun goal1.toNoun) (C (A rc) (C LEP
          (crSubj mono (Nomm.n6 p q r).toNoun goalN regionN sup (compCore g2 x ctx))))))))))) cr6F8
        = (K g.cond g1.cond nex0 nex1 g2).map fun p => C p.1.goal.toNoun (genNoun p.2 x')) (hX : X x mono sup := by assumption) :
    ∃ x', Y x x' ∧ nock (C (listNoun A rb) (C (A rid) (C (C goal0.toNoun goal1.toNoun) (C (A rc) (C LEP
      (crSubj mono (Nomm.n6 p q r).toNoun goalN regionN sup (compCore g x ctx))))))) cr6F4
      = ((do
          let cb ← getCond
          let nex1 ← runLCMR env true msup r goal1 rb
          let cbw ← getCond
          let nex0 ← runLCMR env true msup q goal0 rb
          K cb cbw nex0 nex1 : CM (TreapMap mugF) (NextL CSet)) g).map
          fun p => C p.1.goal.toNoun (genNoun p.2 x') := by
  have hY0 : Y x x := hYk.refl x
  obtain ⟨x, hy1, hr1⟩ := hr x mono sup hx hX
  replace hY0 := hYk.trans hY0 hy1
  replace hx := hYk.soft hx hy1
  replace hX := hYk.pres hX hy1
  simp only [crSubj, compCore, genNoun] at hr1
  simp only [bind_apply, getCond, Option.bind_some]
  cases e1 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup r goal1 rb g with
  | none =>
    rw [e1] at hr1
    unfold cr6F4 cr6F5
    refine ⟨x, hY0, ?_⟩
    simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, genNoun]
  | some rr =>
    obtain ⟨nex1, g1⟩ := rr
    rw [e1] at hr1
    simp only [Option.map_some] at hr1
    obtain ⟨x, hy2, hq1⟩ := hq nex1 g1 e1 x mono sup hx hX
    replace hY0 := hYk.trans hY0 hy2
    replace hx := hYk.soft hx hy2
    replace hX := hYk.pres hX hy2
    simp only [crSubj, compCore, genNoun] at hq1
    cases e2 : runLCMR (S := CSet) (Map := TreapMap mugF) env true msup q goal0 rb g1 with
    | none =>
      rw [e2] at hq1
      unfold cr6F4 cr6F5 cr6F6 cr6F7
      refine ⟨x, hY0, ?_⟩
      simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, hq1, genNoun, e2]
    | some rr =>
      obtain ⟨nex0, g2⟩ := rr
      rw [e2] at hq1
      simp only [Option.map_some] at hq1
      obtain ⟨xK3, hy3, hk⟩ := hK nex1 g1 nex0 g2 e1 e2 x hx hX
      have hY0K3 := hYk.trans hY0 hy3
      simp only [crSubj, compCore, condN, genNoun, Nomm.toNoun] at hk
      unfold cr6F4 cr6F5 cr6F6 cr6F7
      refine ⟨xK3, hY0K3, ?_⟩
      simp [nock_exec, crSubj, compCore, Nomm.toNoun, cr_bat_dol, hr1, hq1, hk, genNoun, e2]

/-- **The case `%6` of `+run` in phase F**: under a `%next` goal with
`GInv` whose `+leap` is `~` (`hlp`, in the model; the Nock of `+leap` by
`lp6_leap_none`, for `q` and `r` with no axis `0`, `hq`, `hr`), whose need
with the bunt sure is not `+none-equivalent` and whose `+kerf` test fails,
given the parts (`SixParts`, the branches in the regions `rid :: region`):
`+re`, `+fork`, `+id`, the two runs, `+sect`, `+past-fork`, the `%brn`
block, `+lazy-shut`, the run of `p` on `[%next [[%this r-cond] ~] ~ ~] ~ o]`,
`+copy`. -/
theorem comp_run_n6_fRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (hlp : leap laz q r = some Option.none) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = false)
    (hkt : kerfTest q r laz = false) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  rw [cr6f_head h7 p q r laz th region x hx g mono sup (lp6_leap_none h7 hl hq hr g hlp x hx) hne hkt,
    runLC_n6_fRG env msup p q r laz th region hlp hne hkt, sixNextForkC_eqRG]
  refine cr6f_s03T hYk h7 p q r laz th region x g mono sup (sixFKRG env msup p q r region) (fun n0 n1 g3 ef => ?_)
  have hR : GInv (reG g) (CGoalL.next laz th) := ginv_mono hinv (Nat.le_succ _) (Nat.le_refl _) rfl
  obtain ⟨gi0, gi1⟩ := ginv_forkL hR ef
  have gi1' : GInv (idG g3) n1.goal := gi1
  obtain ⟨e0, e1', -, -, -, -⟩ := forkL_spec hl ef
  obtain ⟨l0, t0⟩ := n0
  obtain ⟨l1, t1⟩ := n1
  simp only at e0 e1'
  subst e0 e1'
  exact xt_trans hYk hY0 (cr6f_midRTG hYk env msup p q r (g3.id :: region) (NextL.goal ⟨l0, jmp0 (reG g).bo⟩)
    (NextL.goal ⟨l1, jmp0 ((reG g).bo + 1)⟩) x hx (idG g3) mono (CGoalL.next laz th).toNoun (listNoun A region)
    sup (A 0) g3.id g.re
    (fun cb cbw nex0 nex1 => sixLynFRG env msup p region (g3.id :: region) g.re (reG g).bo ((reG g).bo + 1)
      cb cbw nex0 nex1)
    ((R g3.id).link _ _ gi1')
    (fun nex1 g1 e1 => (Q g3.id).link _ g1 (by
      obtain ⟨l1', b1', gj1, -⟩ := (R g3.id).res _ _ g1 nex1 gi1' e1
      exact ginv_mono gi0 l1' b1' ((ginv_drop gj1).trans (ginv_drop gi1').symm)))
    (fun nex1 g1 nex0 g2 e1 e2 x hx hX => by
      obtain ⟨lt2, -, d2, h0, h1, ap01, fr⟩ := six_f_runsRG (Q g3.id).res (R g3.id).res hinv ef e1 e2
      unfold condN
      exact cr6f_lynRTG hYk h7 hcode env msup p q r region (g3.id :: region) P.pf g.re
        (fun o g' hg' => P.link _ g' hg') P.res x hx g2 d2 lt2 nex0 nex1 h0 h1 ap01
        (fun h => by have := fr _ (List.mem_append_left _ h); omega)
        (fun h => by have := fr _ (List.mem_append_right _ h); omega)
        l0 l1 _ _ g3.id (idG g3).cond g1.cond mono _ sup))

/-- **The case `%6` of `+run` in phase L**: under a `%next` goal with `GInv`
whose `+leap` gives `[~ rest bys]` (`hlp`; the Nock is `lp6_leap`, which needs
`Bake.NoAx0` of the branches), with `LeapTwice`, given the link of the case on the goal `[%next rest then]` in
the same state (`hRe`, whatever phase it takes: `comp_run_n6_nfRTG hYk`,
`comp_run_n6_kRTG hYk`, phase F) and what that run returns (`hReR`): the run on the
rest, then `+copy` of each `by` (`copyAll`). -/
theorem comp_run_n6_lRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (region : List Nat) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (htw : LeapTwice laz q r)
    (hRe : CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next rest th) region g)
    (hReR : ∀ nex g', runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  have hli := leapInv hinv.1 hq hr
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  have hLp := lp6_leap h7 laz q r hl hq hr g x
  rw [hlp, Option.map_some] at hLp
  rw [cr6l_head p q r laz rest th bys region x g mono sup hLp,
    runLC_n6_lRG env msup p q r laz rest th bys region hlp (htw rest bys hlp)]
  exact xt_trans hYk hY0 (cr6l_eqT hYk h7 x g mono _ _ _ sup _ bys _ (hRe x mono sup hx hX)
    (fun nex g' e => (chain_l hli hlp (hReR nex g' e)).1))

/-- **Phase L** (`comp_run_n6_lRTG hYk`) without `LeapTwice`. -/
theorem comp_run_n6_l_twRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) (env : CallEnv) (msup : Option Nomm) (p q r : Nomm)
    (region : List Nat) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (hRe : CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next rest th) region g)
    (hReR : ∀ nex g', runLCMR env true msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g :=
  comp_run_n6_lRTG hYk h7 env msup p q r region hq hr laz th g hinv rest bys hlp (leapTwice_noAx0 hq hr) hRe hReR

/-- **The case `%6` of `+run` in phase S on a goal whose forks and bonds ask
nothing**: under a `%next` goal with `GInv` whose `+leap` is `~` (`hlp`; the
Nock by `lp6_leap_none`, with `Bake.NoAx0` of the branches) and whose need
with the bunt sure is `+none-equivalent` (`hne`), given the parts
(`SixParts`, the branches in the regions `rid :: region`). -/
theorem comp_run_n6_neRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region))
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (hlp : leap laz q r = some Option.none) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) = true) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  intro x mono sup hx hX
  have hY0 : Y x x := hYk.refl x
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hd : g.drop = false := ginv_drop hinv
  have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
  have hl0 : CrLok laz.sure := (ginv_sureOnly hinv).1.1.1.1
  rw [cr6s_head_ne h7 p q r laz th region x g mono sup (lp6_leap_none h7 hl hq hr g hlp x hx) hne,
    runLC_n6_neRG env msup p q r laz th region hlp hne]
  refine cr6s_s01_gT hYk hc p q r laz th region x g mono sup (sixNfKRG env msup p q r region) (fun s0 s1 g3 ef => ?_)
  obtain ⟨-, -, d3, lk0, lk1, D0, D1, -, fr⟩ := forkSure_inv ef
  have dI : (idG g3).drop = false := d3.trans hd
  have gi1 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) :=
    ginv_ofSure (fun y hy => hl0 y (lk1 ▸ hy)) (fun y hy => (fr y (Or.inr hy)).2) D1 dI
  have gi0 : GInv (idG g3) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo)) :=
    ginv_ofSure (fun y hy => hl0 y (lk0 ▸ hy)) (fun y hy => (fr y (Or.inl hy)).2) D0 dI
  exact xt_trans hYk hY0 (cr6s_midRTG hYk (ctx := ctx) env msup p q r (g3.id :: region) (CGoalL.next (Lazy.ofSure s0) (jmp0 g.bo))
    (CGoalL.next (Lazy.ofSure s1) (jmp0 (g.bo + 1))) x hx (idG g3) mono
    (CGoalL.next laz th).toNoun (listNoun A region) sup (A 0)
    (fun cb cbw nex0 nex1 => sixLynNRG env msup p region (g3.id :: region) g.bo (g.bo + 1) cb cbw nex0 nex1)
    ((R g3.id).link _ _ gi1)
    (fun nex1 g1 e1 => (Q g3.id).link _ g1 (by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      exact ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)))
    (fun nex1 g1 nex0 g2 e1 e2 x hx hX => by
      obtain ⟨l1, b1, gi1', -⟩ := (R g3.id).res _ _ g1 nex1 gi1 e1
      have hi0 := ginv_mono gi0 l1 b1 ((ginv_drop gi1').trans dI.symm)
      obtain ⟨l2, -, gi2, -⟩ := (Q g3.id).res _ g1 g2 nex0 hi0 e2
      exact cr6s_lyn_nRTG hYk h7 hcode env msup p q r region (g3.id :: region) P.pf
        (fun yes nuh g' hd' => P.link _ g' ⟨hd', jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩) P.res x hx g2 (ginv_drop gi2)
        nex0 nex1 gi2.1.1 (lnb_mono l2 0 gi1'.1.1) (Lazy.ofSure s0) (Lazy.ofSure s1) g.bo (g.bo + 1)
        (idG g3).cond g1.cond mono (C laz.toNoun th.toNoun) sup (A 0)))

/-- **The case `%6` under a `%next` goal whose `+leap` is `~`**: phase S
when the need with the bunt sure is `+none-equivalent`, else phase K when
the `+kerf` test holds, else phase F. -/
theorem comp_run_n6_nlRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th))
    (hlp : leap laz q r = some Option.none) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  cases hne : Lazy.noneEquivalentL (Lazy.mk Sure.bunt laz.fork laz.bond) with
  | true => exact comp_run_n6_neRTG hYk h7 hcode env msup p q r region P Q R laz th g hinv hlp hq hr hne
  | false =>
    cases hkt : kerfTest q r laz with
    | true => exact comp_run_n6_kRTG hYk h7 hcode env msup p q r region P Q R laz th g hinv hlp hq hr hne hkt
    | false => exact comp_run_n6_fRTG hYk h7 hcode env msup p q r region P Q R laz th g hinv hlp hq hr hne hkt

/-- **The case `%6` of `+run` under every `%next` goal with `GInv`**, given
the parts (`SixParts`) and `Bake.NoAx0` of the branches: `+leap` crashes
(so do the Hoon and the model), gives `~` (`comp_run_n6_nlRTG hYk`: phases S, K,
F), or gives a rest (phase L, `comp_run_n6_l_twRTG hYk`, re-entering
`comp_run_n6_nlRTG hYk` on the rest, whose `+leap` is `~` by
`leapTwice_noAx0`). -/
theorem comp_run_n6_nextRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (laz : Lazy CSet) (th : Jmp) (g : Gen (TreapMap mugF)) (hinv : GInv g (CGoalL.next laz th)) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) (CGoalL.next laz th) region g := by
  cases hlp : leap laz q r with
  | none =>
    intro x mono sup hx hX
    have hY0 : Y x x := hYk.refl x
    have hl : LAll CrLok laz := lall_mono (fun _ h => h.1) hinv.1.1
    have hLp := lp6_leap h7 laz q r hl hq hr g x
    rw [hlp, Option.map_none] at hLp
    rw [cr6_head_crash p q r laz th region x g mono sup hLp, runLC_n6_crashRG env msup p q r laz th region hlp g]
    exact ⟨x, hY0, rfl⟩
  | some l =>
    cases l with
    | none => exact comp_run_n6_nlRTG hYk h7 hcode env msup p q r region P Q R hq hr laz th g hinv hlp
    | some v =>
      obtain ⟨rest, bys⟩ := v
      have hi := ginv_rest hinv (leapInv hinv.1 hq hr) hlp
      have h2 := leapTwice_noAx0 (laz := laz) hq hr rest bys hlp
      exact comp_run_n6_l_twRTG hYk h7 env msup p q r region hq hr laz th g hinv rest bys hlp
        (comp_run_n6_nlRTG hYk h7 hcode env msup p q r region P Q R hq hr rest th g hi h2)
        (fun nex g' e => res_n6_nlRG P.res (fun rid => (Q rid).res) (fun rid => (R rid).res) rest th g g' nex hi h2 e)

/-- **The case `%6` of `+run` on every goal with `GInv`**: `%done` and
`%pick` by `comp_run_n6_dpRTG hYk` (the branches in the case's region), `%next` by
`comp_run_n6_nextRTG hYk` (the branches in the regions `rid :: region`). -/
theorem comp_run_n6_allRTG (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTG env msup ctx X Y p region) (Q0 : SixPartsRTG env msup ctx X Y q region)
    (R0 : SixPartsRTG env msup ctx X Y r region) (Q : ∀ rid, SixPartsRTG env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTG env msup ctx X Y r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCMR env true msup) ctx X Y (Nomm.n6 p q r) goal region g := by
  cases goal with
  | next laz th => exact comp_run_n6_nextRTG hYk h7 hcode env msup p q r region P Q R hq hr laz th g hinv
  | done => exact comp_run_n6_dpRTG hYk h7 hcode env msup p q r region P Q0 R0 _ (fun _ _ h => by cases h) g hinv
  | pick z o => exact comp_run_n6_dpRTG hYk h7 hcode env msup p q r region P Q0 R0 _ (fun _ _ h => by cases h) g hinv

end Compiler
