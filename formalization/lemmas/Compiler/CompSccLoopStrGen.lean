    (by rw [hB]; exact hwas) (wasN_shape _) (by rw [hB]; exact hput) hml
  rw [hB, hNN] at hg
  obtain ⟨s, hs⟩ := hfin
  have hsn : s.need = nn := by
    rw [← hNN]; exact finishLFC_need _ nm ord cape _ nex g1 hrunL nedF g2 hnoar s hs
  have hout' : ∀ np : NeedOrd, OutsHeld outC nout (upd st.ml B (some np)) (cacheN C1 C2 C3 C4 SURE') := by
    intro np b' hb' k hk
    obtain ⟨NR, u, h2, h3, h4⟩ := hout1 b' (by
      by_cases e : b' = B
      · exact Or.inr e
      · left; simpa [upd, e] using hb') k hk
    rw [cacheN_slot2] at h2
    exact ⟨NR, u, by rw [cacheN_slot2]; exact h2, h3, h4⟩
  rw [memMovedN_was] at hg
  cases hm : st.ml B with
  | none =>
    have hnone : getF mugF B ML = some (A 0) :=
      getF_none hml (fun v hv => by obtain ⟨n, t, hn, -⟩ := hR.1.2.1 B v hv; rw [hm] at hn; cases hn)
    obtain ⟨ML', hp, -, -⟩ := putF_spec mugF ML B s.toNoun hml
    have hp' : putF mugF B (C nn.toNoun (C (A s.nargs) (HoonMap.toNoun Blob.toNoun s.blocks))) ML = some ML' := by
      rw [← hsn]; exact hp
    refine ⟨ML', cacheN C1 C2 C3 C4 SURE', ?_, ?_⟩
    · rw [hg.1 hnone, hs]
      simp only [Option.bind_some, hp, Option.map_some, memChgN_loob]
      simp [member, hnone0, hcomp, hm]
    · have e1 : (member (cfgReal r order kids) (fun _ => (cfgReal r order kids).none) B Mode.done keep st).2.ml
          = upd st.ml B (some nn) := by simp [member, hnone0, hcomp, hm]
      have e2 : (member (cfgReal r order kids) (fun _ => (cfgReal r order kids).none) B Mode.done keep st).2.sure
          = upd st.sure B (some (if keep then (st.sure B).getD sur else sur)) := by simp [member, hnone0, hcomp, hm]
      rw [e1, e2]
      exact ⟨⟨csMlExact_put hR.1 hp', hSH', hout' nn, hQ'⟩, mlStr_put hRS ⟨s, rfl⟩ hml hp⟩
  | some prev =>
    obtain ⟨t, ht⟩ := hR.1.2.2 B prev hm
    have hprev : getF mugF B ML = some (C (A 0) (C prev.toNoun t)) := getF_some hml ht
    have hg2 := hg.2 prev t hprev
    have hmsg : (cfgReal r order kids).msg B nn prev = msgOrd nn prev cape := by simp [cfgReal, hinfo]
    by_cases hnp : msgOrd nn prev cape = nn
    · rw [if_pos (by rw [hnp]), hs] at hg2
      obtain ⟨ML', hp, -, -⟩ := putF_spec mugF ML B s.toNoun hml
      have hp' : putF mugF B (C (msgOrd nn prev cape).toNoun (C (A s.nargs) (HoonMap.toNoun Blob.toNoun s.blocks))) ML
          = some ML' := by rw [hnp, ← hsn]; exact hp
      refine ⟨ML', cacheN C1 C2 C3 C4 SURE', ?_, ?_⟩
      · rw [hg2]
        simp only [Option.map_some, Option.bind_some, hp, memChgO_loob]
        simp [member, hnone0, hcomp, hm, hmsg]
      · have e1 : (member (cfgReal r order kids) (fun _ => (cfgReal r order kids).none) B Mode.done keep st).2.ml
            = upd st.ml B (some (msgOrd nn prev cape)) := by simp [member, hnone0, hcomp, hm, hmsg]
        have e2 : (member (cfgReal r order kids) (fun _ => (cfgReal r order kids).none) B Mode.done keep st).2.sure
            = upd st.sure B (some (if keep then (st.sure B).getD sur else sur)) := by simp [member, hnone0, hcomp, hm]
        rw [e1, e2]
        exact ⟨⟨csMlExact_put hR.1 hp', hSH', hout' _, hQ'⟩, mlStr_put hRS ⟨s, rfl⟩ hml hp⟩
    · have hne : (msgOrd nn prev cape).toNoun ≠ nn.toNoun := fun h => hnp (needOrd_toNoun_inj h)
      rw [if_neg hne] at hg2
      obtain ⟨t', ⟨s', hs'⟩, ht'⟩ := hcs prev SURE' hm hnp
      rw [ht'] at hg2
      obtain ⟨ML', hp, -, -⟩ := putF_spec mugF ML B (C (msgOrd nn prev cape).toNoun t') hml
      refine ⟨ML', cacheN C1 C2 C3 C4 SURE', ?_, ?_⟩
      · rw [hg2]
        simp only [Option.bind_some, hp, Option.map_some, memChgO_loob]
        simp [member, hnone0, hcomp, hm, hmsg]
      · have e1 : (member (cfgReal r order kids) (fun _ => (cfgReal r order kids).none) B Mode.done keep st).2.ml
            = upd st.ml B (some (msgOrd nn prev cape)) := by simp [member, hnone0, hcomp, hm, hmsg]
        have e2 : (member (cfgReal r order kids) (fun _ => (cfgReal r order kids).none) B Mode.done keep st).2.sure
            = upd st.sure B (some (if keep then (st.sure B).getD sur else sur)) := by simp [member, hnone0, hcomp, hm]
        rw [e1, e2]
        exact ⟨⟨csMlExact_put hR.1 hp, hSH', hout' _, hQ'⟩, mlStr_put hRS ⟨s', hs'⟩ hml hp⟩

def MemDoneCallStr (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (outC : Noun → List Noun)
    (nout : Noun → NeedOrd) (envK : CallEnv) (RR : GenRest → Prop) (P : Noun → Prop) (S : Noun) (x : GenRest)
    (st : St Noun NeedOrd) (keep : Bool) (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun) : Prop :=
  ∃ (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat), b = C (C cape.toNoun DATA) FOL ∧
    r.info b = ⟨nm, cape, DATA, fuel⟩ ∧ ∃ CA1,
    nock (C inlBody (C (C b (C (C CODE LSR) (C JH CACHE))) compK)) inlBody = some (C nm.toNoun CA1) ∧
    ∃ (nex : NextL CSet) (g1 : Gen (TreapMap mugF)),
      runLC (envDone r order kids st) Option.none nm (CGoalL.done : CGoalL CSet) [] (gen0 : Gen (TreapMap mugF))
        = some (nex, g1) ∧
    ∃ (X : GenRest → Noun → Noun → Prop) (Y : GenRest → GenRest → Prop),
      CompRunAtXT (runLC (envDone r order kids st) Option.none) (memDCtx SCC (C CODE LSR) JH ML (A 0) b) X Y nm
        CGoalL.done [] genEntry ∧ X (cuRest CA1) (A 1) (A 0) ∧
      (∀ x1, Y (cuRest CA1) x1 → ∃ C1 C2 C3 C4 SURE, x1.cache = cacheN C1 C2 C3 C4 SURE ∧ x1.soft = A 0 ∧
        QK envK RR P S x (cacheN C1 C2 C3 C4 SURE) ∧ SureHolds r.scc st.sure (cacheN C1 C2 C3 C4 SURE) ∧
        ∀ b', ((st.ml b').isSome ∨ b' = b) → ∀ k ∈ outC b', ∃ NR u,
          slot? 2 (cacheN C1 C2 C3 C4 SURE) = some NR ∧ getF mugF k NR = some (C (A 0) u) ∧ slot? 2 u = some (nout k).toNoun) ∧
    ∃ ord, shapeCol fuel nex.laz cape = some ord ∧ nex.th.args = [] ∧
    ∃ (nedF : Need) (g2 : Gen (TreapMap mugF)), needOrdAllocRegs ord g1 = some (nedF, g2) ∧
      isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
        ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true ∧
    ∃ sur, sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur ∧
      (∃ s, finishLFC (S := CSet) (Map := TreapMap mugF) (envDone r order kids st) nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s) ∧
      ∀ (x1 : GenRest) (C1 C2 C3 C4 SURE' : Noun) (prev : NeedOrd), st.ml b = some prev →
        msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
        ∃ t, (∃ s : Straight (TreapMap mugF), C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t = s.toNoun) ∧ nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
              (memFCR keep (wasN (st.sure b)) sur.toNoun
                (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
                (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
                nex.th.there (genNoun g2 x1) nm.toNoun
                (memDCtx SCC (C CODE LSR) JH ML (A 0) b) b ML
                (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
          = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)

theorem memGate_done_realStr (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (outC : Noun → List Noun)
    (nout : Noun → NeedOrd) (envK : CallEnv) (RR : GenRest → Prop) (P : Noun → Prop) (S : Noun) (x : GenRest)
    (hRR : ∀ NR MO SC INL SU SU' s f : Noun, RR ⟨cacheN NR MO SC INL SU, s, f⟩ → RR ⟨cacheN NR MO SC INL SU', s, f⟩)
    (hS : ∀ b ∈ r.scc, b ∈ tapList S)
    (hxS : ∀ b ∈ r.scc, ∀ N u, slot? 31 x.cache = some N → getF mugF b N ≠ some (C (A 0) u))
    (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 : Noun)
    (hcall : ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
      LoopR r.scc outC nout (QK envK RR P S x) st.ml st.sure ML CACHE →
      MemDoneCallStr r order kids outC nout envK RR P S x st keep DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE) :
    MemGate (cfgReal r order kids) (LoopRS (cfgReal r order kids).scc outC nout (QK envK RR P S x))
      (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0) (fun _ => (cfgReal r order kids).none) (A 0) Mode.done
      (A 0x656e6f64) := by
  intro st keep b ML CA hb hR
  obtain ⟨cape, DATA, FOL, nm, fuel, rfl, hinfo, CA1, hinl, nex, g1, hrunL, X, Y, hXT, hX, hY, ord, hcol, hargs,
    nedF, g2, hnoar, hrun, sur, hsur, hfin, hcs⟩ := hcall st keep b ML CA hb hR.1
  obtain ⟨x1, hY1, heq⟩ := hXT (cuRest CA1) (A 1) (A 0) (cu_entry_nosoft CA1) hX
  have hge : (genEntry : Gen (TreapMap mugF)) = gen0 := rfl
  rw [hge, hrunL] at heq
  obtain ⟨C1, C2, C3, C4, SURE, hx1, hs1, hQ1, hsh1, hout1⟩ := hY x1 hY1
  exact mem_done_stepStr r order kids outC nout envK RR P S x hRR st keep cape DATA FOL nm fuel hinfo hb (hS _ hb)
    (hxS _ hb) ML CA DN KIDS ML0 CB SCC CODE LSR JH CACHE0 hR CA1 hinl nex g1 hrunL x1 heq C1 C2 C3 C4 SURE hx1 hs1
    hQ1 hsh1 hout1 ord hcol hargs nedF g2 hnoar hrun sur hsur hfin (fun prev SURE' hm hnp => hcs x1 C1 C2 C3 C4 SURE' prev hm hnp)

theorem memGate_done_KStr (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (outC : Noun → List Noun)
    (nout : Noun → NeedOrd) (env : CallEnv) (SC0 : Noun) (inl : Noun → Option Nomm) (P : Noun → Prop)
    (S CODE JETS CALLS JH : Noun) (x : GenRest) (NR CR : Noun)
    (hS : ∀ b ∈ r.scc, b ∈ tapList S)
    (hxS : ∀ b ∈ r.scc, ∀ N u, slot? 31 x.cache = some N → getF mugF b N ≠ some (C (A 0) u))
    (hcall : ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
      LoopR r.scc outC nout (QK env (RK SC0 inl) P S x) st.ml st.sure ML CACHE →
      MemDoneCallStr r order kids outC nout env (RK SC0 inl) P S x st keep (A 1)
        (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE) :
    MemGate (cfgReal r order kids) (LoopRS (cfgReal r order kids).scc outC nout (QK env (RK SC0 inl) P S x))
      (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
      (fun _ => (cfgReal r order kids).none) (A 0) Mode.done (A 0x656e6f64) :=
  memGate_done_realStr r order kids outC nout env (RK SC0 inl) P S x rK_sure hS hxS (A 1) _ (A 0) csiBody S CODE
    (C JETS CALLS) JH (C NR CR) hcall

theorem csi_gate_loop_dStr (c : Cfg Noun NeedOrd) (bs : List Noun) (outC : Noun → List Noun)
