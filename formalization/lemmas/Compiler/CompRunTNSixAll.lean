/-- **The case `%6` of `+run` on every goal with `GInv`**: `%done` and
`%pick` by `comp_run_n6_dpRTN hYk` (the branches in the case's region), `%next` by
`comp_run_n6_nextRTN hYk` (the branches in the regions `rid :: region`). -/
theorem comp_run_n6_allRTN (hYk : YOk X Y) (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (region : List Nat)
    (P : SixPartsRTN env msup ctx X Y p region) (Q0 : SixPartsRTN env msup ctx X Y q region)
    (R0 : SixPartsRTN env msup ctx X Y r region) (Q : ∀ rid, SixPartsRTN env msup ctx X Y q (rid :: region))
    (R : ∀ rid, SixPartsRTN env msup ctx X Y r (rid :: region)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hinv : GInv g goal) :
    CompRunAtXT (runLCM env false msup) ctx X Y (Nomm.n6 p q r) goal region g := by
  cases goal with
  | next laz th => exact comp_run_n6_nextRTN hYk h7 hcode env msup p q r region P Q R hq hr laz th g hinv
  | done => exact comp_run_n6_dpRTN hYk h7 hcode env msup p q r region P Q0 R0 _ (fun _ _ h => by cases h) g hinv
  | pick z o => exact comp_run_n6_dpRTN hYk h7 hcode env msup p q r region P Q0 R0 _ (fun _ _ h => by cases h) g hinv

