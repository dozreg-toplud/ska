/-- **The induction hypothesis below the height `h`**: every callee of the domain `D` of
height below `h` is `CalleeCompiledP` at every `(P', Pf')` above it, at every context with
`CtxK`, at its need. -/
def CCBelowD (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm) (ht : Noun → Nat)
    (D : Bell → Prop) (h : Nat) : Prop :=
  ∀ (b' : Bell) (P' Pf' : Noun → Prop) (ctx' : Noun) (nb' : NeedOrd), D b' → ht b'.toNoun < h →
    Above ht (ht b'.toNoun) P' Pf' → CtxK CODE JETS CALLS JH ctx' → env.need b' = some nb' →
    CalleeCompiledP env (RKD SC0 MO0 inl Pf') P' ctx' b' nb'

theorem cCBelowD_mono {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} {h h' : Nat} (hle : h' ≤ h)
    (H : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h) : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h' :=
  fun b' P' Pf' ctx' nb' hD hlt => H b' P' Pf' ctx' nb' hD (Nat.lt_of_lt_of_le hlt hle)

/-- **The loop data of an SCC callee at the bells in progress `(P, Pf)`** (`SccCalleeR` at any
`(P, Pf)`, with each `%done` call's `MemDoneRestD` under the hypothesis `IH`): at every rest
where the loop runs, a real configuration that is the pill's, ranked, the `%may` and `%must`
gates, `env` the model's at the members, and per `%done` call `MemDoneRestD`. -/
def SccLoopDataD (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm)
    (P Pf : Noun → Prop) (S : Noun) (IH : Prop) : Prop :=
  ∀ x NR CR, LoopRest env (RKD SC0 MO0 inl Pf) P S x NR CR → CsiDec S CODE JETS CALLS JH NR CR ∧
    ∃ (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (rk : Ranked (cfgReal r order kids))
      (nout : Noun → NeedOrd),
      CfgOf (cfgReal r order kids) S (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) ∧
      MemGate (cfgReal r order kids)
        (LoopR (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
        (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
        (fun _ => (cfgReal r order kids).none) (A 0) Mode.may (A 0x79616d) ∧
      (∀ TOP, TopN (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd)).ml TOP →
        MemGate (cfgReal r order kids)
          (LoopR (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
          (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
          (topOf (cfgReal r order kids) (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd))) TOP Mode.must
          (A 0x7473756d)) ∧
      (∀ (s : St Noun NeedOrd), compileSccIn (cfgReal r order kids) false (fuelR (cfgReal r order kids) rk) St.empty
        = some s → ∀ b' : Bell, b'.toNoun ∈ (cfgReal r order kids).scc →
          env.need b' = s.ml b'.toNoun ∧ ∀ v, s.sure b'.toNoun = some v → env.sure b' = v) ∧
      ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
        LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x) st.ml st.sure ML CACHE → IH →
        MemDoneRestD r order kids env SC0 MO0 inl P Pf S x st keep (A 1)
          (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE

/-- **The table's data of one callee `b`** (heights `ht`, domain `D`): a one-bell callee, or an
SCC `S` (its `sccs` entry, `hnd`) with `SccLoopDataD` at every `(P, Pf)` above `b`, whose
`%done` calls may use `CCBelowD` at `b`'s height (the outside callees of the members, lower). -/
def CalleeHD (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm) (ht : Noun → Nat)
    (D : Bell → Prop) (b : Bell) : Prop :=
  OneCalleeA env SC0 CODE CALLS inl b ∨
    ∃ S, getF mugF b.toNoun SC0 = some (C (A 0) S) ∧
      ((∀ n, S ≠ C n (C (A 0) (A 0))) ∨ ∃ n, S = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n) ∧
      ∀ P Pf, Above ht (ht b.toNoun) P Pf →
        SccLoopDataD env SC0 MO0 CODE JETS CALLS JH inl P Pf S (CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D (ht b.toNoun))

/-- **One step of the induction on height**: a callee with `CalleeHD` whose lower callees are
`CCBelowD` is `CalleeCompiledP` at every `(P, Pf)` above it (`calleeCompiled_oneKD`, or
`calleeCompiled_sccD` with `sccLoopAtD_real`). -/
theorem calleeCompiled_stepHD {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0)
    (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v) (hht : HtScc SC0 ht)
    {b : Bell} (hT : CalleeHD env SC0 MO0 CODE JETS CALLS JH inl ht D b)
    (hIH : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D (ht b.toNoun))
    {P Pf : Noun → Prop} (hab : Above ht (ht b.toNoun) P Pf) {ctx : Noun} (hctx : CtxK CODE JETS CALLS JH ctx)
    {nb : NeedOrd} (hnb : env.need b = some nb) :
    CalleeCompiledP env (RKD SC0 MO0 inl Pf) P ctx b nb := by
  obtain ⟨h7, hl, hj, h107⟩ := hctx
  have hnPf : ∀ k, Pf k → ht k ≠ ht b.toNoun := fun k hk e => Nat.lt_irrefl _ (e ▸ hab.2 k hk)
  rcases hT with hone | ⟨S, hsc, hnd, hdat⟩
  · obtain ⟨cape, DATA, FOL, nm, fuel, envb, p, st, rfl, hsc, hinl, hcalls, hcode, hn, hax, hfix, hone⟩ := hone
    have e : nb = st.need := Option.some.inj (hnb.symm.trans hone.2.2.1)
    subst e
    exact calleeCompiled_oneKD h7 hl hj h107 env envb cape DATA FOL nm fuel p st inl hsc hinl hcalls hcode hn hax
      hfix hone P Pf (fun h => hnPf _ (hab.1 _ h) rfl) (fun h => hnPf _ h rfl)
  · have hS : ∀ k ∈ tapList S, ht k = ht b.toNoun := hht _ _ hsc
    have hPfS : ∀ k ∈ tapList S, ¬ Pf k := fun k hk h => hnPf k h (hS k hk)
    have hPS : ∀ k ∈ tapList S, ¬ P k := fun k hk h => hPfS k hk (hab.1 k h)
    have hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k := fun k hk => ((hsg _ _ hsc).2.2 k hk).2
    refine calleeCompiled_sccD h7 hl hj h107 env inl P Pf b nb S hsg hcj hsc hnd hPS hPfS hnb fun x NR CR hx => ?_
    obtain ⟨hdec, r, order, kids, rk, nout, hcfg, hmay, hmust, henv, hcall⟩ := hdat P Pf hab x NR CR hx
    exact ⟨sccLoopAtD_real env SC0 MO0 inl P Pf S CODE JETS CALLS JH x NR CR hx hPS hbell r order kids rk nout
      hcfg hmay hmust henv fun st keep b0 ML CACHE hb hL => hcall st keep b0 ML CACHE hb hL hIH, hdec⟩

/-- **Every callee is compiled, by induction on height** (README Gaps 19 (g)): for a table
whose SCCs have heights (`HtScc`) and whose callees of the domain `D` have `CalleeHD`, every
callee of `D` is `CalleeCompiledP env (RKD SC0 MO0 inl Pf) P` at every `(P, Pf)` above it, at every
context with `CtxK`. -/
theorem calleeCompiled_heightsD {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0)
    (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v) (hht : HtScc SC0 ht)
    (hT : ∀ b, D b → CalleeHD env SC0 MO0 CODE JETS CALLS JH inl ht D b) :
    ∀ (b : Bell) (P Pf : Noun → Prop) (ctx : Noun) (nb : NeedOrd), D b → Above ht (ht b.toNoun) P Pf →
      CtxK CODE JETS CALLS JH ctx → env.need b = some nb → CalleeCompiledP env (RKD SC0 MO0 inl Pf) P ctx b nb := by
  have H : ∀ m, CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D m := by
    intro m
    induction m with
    | zero => intro b' P' Pf' ctx' nb' _ hlt; exact absurd hlt (Nat.not_lt_zero _)
    | succ m ih =>
      intro b' P' Pf' ctx' nb' hD hlt hab hctx hnb
      exact calleeCompiled_stepHD hsg hcj hht (hT b' hD) (cCBelowD_mono (Nat.le_of_lt_succ hlt) ih) hab hctx hnb
  exact fun b P Pf ctx nb hD hab hctx hnb => H (ht b.toNoun + 1) b P Pf ctx nb hD (Nat.lt_succ_self _) hab hctx hnb

/-- **At the gate** (`P = Pf = ∅`): `CalleeCompiled` with `RKD` at no bell in progress. -/
theorem calleeCompiled_heights0D {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0)
    (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v) (hht : HtScc SC0 ht)
    (hT : ∀ b, D b → CalleeHD env SC0 MO0 CODE JETS CALLS JH inl ht D b) {b : Bell} {ctx : Noun} {nb : NeedOrd}
    (hD : D b) (hctx : CtxK CODE JETS CALLS JH ctx) (hnb : env.need b = some nb) :
    CalleeCompiled env (RKD SC0 MO0 inl (fun _ => False)) ctx b nb := by
  intro x NR MO SC RS hA hR hc h0
  obtain ⟨CA', h1, h2, h3, h4, h5⟩ := calleeCompiled_heightsD hsg hcj hht hT b _ _ ctx nb hD (above_empty ht _) hctx hnb
    x NR MO SC RS (agreeIP_of_E _ hA) hR hc h0
  exact ⟨CA', h1, h2, agreeE_of_IP h3, h4, h5⟩

/-- **`callOkTN_out` with the loop's `r.env` agreeing with `env` at `b` only** (the iterated
`env`: `r.env` is the `env` of the lower heights). -/
theorem callOkTN_outD {r : RealCfg} {order : List Noun} {kids : Noun → List Noun} {st : St Noun NeedOrd}
    {env : CallEnv} {SC0 MO0 : Noun} {inl : Noun → Option Nomm} {P Pf : Noun → Prop} {S : Noun}
    {xs : GenRest} (hrs : r.scc = tapList S) (hPf : ∀ k, P k → Pf k) (hPS : ∀ k ∈ tapList S, ¬ P k)
    (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    {SCC LONG JH ML B cod : Noun} {msup : Option Nomm} {p q : Nomm} {b : Bell} {nb : NeedOrd}
    (hre : r.env.need b = env.need b ∧ r.env.sure b = env.sure b)
    (hcd : CodePure cod (envDone r order kids st) b)
    (hc : (envDone r order kids st).cod b = some ((envDone r order kids st).pure b))
    (hri : (envDone r order kids st).ring b = Option.none)
    (hnb : (envDone r order kids st).need b = some nb)
    (hsf : (envDone r order kids st).sof (made p msup) p q b nb = false)
    (hcole : ∃ cole, slot? 6846 (memDCtx SCC LONG JH ML (A 0) B) = some cole ∧ getF mugF b.toNoun cole = some (A 0))
    (hsof : ∀ x, SofRetN (envDone r order kids st) msup (memDCtx SCC LONG JH ML (A 0) B) p q b nb x)
    (hin : hasInF mugF b.toNoun SCC = some false)
    (hcc : CalleeCompiledP env (RKD SC0 MO0 inl (PfS Pf S)) (PeS P S st) (memDCtx SCC LONG JH ML (A 0) B) b nb) :
    CallOkTN (envDone r order kids st) cod (memDCtx SCC LONG JH ML (A 0) B) (EMD env SC0 MO0 inl P Pf S st xs)
      (ExtE (EMD env SC0 MO0 inl P Pf S st xs)) msup p q b := by
  refine callOkTN_of_IP rfl hcd hc hri hnb hsf hcole ⟨JH, by simp [memDCtx, nock_exec]⟩ hsof
    (by simp [memDCtx, nock_exec]) hin (envA := env) (Pf := PfS Pf S) (fun h => ?_) (fun x h => h.1) (fun x h => h.2.1)
    (fun x h => h.2.1.1.2) ?_ (fun x x' h he hA hR => eMD_step hPS hbell h he hA hR) hcc
  · have hb : b.toNoun ∉ r.scc := fun hb => h (Or.inr (hrs ▸ hb))
    rw [← hre.1, ← hre.2]; exact need_done_out hb
  · rintro k (h | ⟨h, -⟩)
    · exact Or.inl (hPf k h)
    · exact Or.inr h

/-- **`CallOkTN` at `EMD` from the static facts** (a member by `callOkTN_member`; an outside
callee by `callOkTN_out`, its nested compile `CalleeCompiledP` from the induction hypothesis
`CCBelowD` at the bells in progress of the member run, `above_memS`). -/
theorem callOkTN_memOkD {r : RealCfg} {order : List Noun} {kids : Noun → List Noun} {st : St Noun NeedOrd}
    {env : CallEnv} {SC0 MO0 : Noun} {inl : Noun → Option Nomm} {P Pf : Noun → Prop} {S : Noun} {xs : GenRest}
    {CODE JETS CALLS JH ML B SCC : Noun} {ht : Noun → Nat} {D : Bell → Prop} {h : Nat}
    (hre : (∀ b : Bell, D b → ht b.toNoun < h → r.env.need b = env.need b ∧ r.env.sure b = env.sure b)) (hrs : r.scc = tapList S) (hPS : ∀ k ∈ tapList S, ¬ P k)
    (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    (hab : Above ht h P Pf) (hS : ∀ k ∈ tapList S, ht k = h) (hml : MlExact st.ml ML)
    (hIH : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h) {ms : Option Nomm} {p q : Nomm} {b : Bell}
    (hok : MemCallOk r order kids st CODE (memDCtx SCC (C CODE (C JETS CALLS)) JH ML (A 0) B) SCC ht D h ms p q b) :
    CallOkTN (envDone r order kids st) CODE (memDCtx SCC (C CODE (C JETS CALLS)) JH ML (A 0) B)
      (EMD env SC0 MO0 inl P Pf S st xs) (ExtE (EMD env SC0 MO0 inl P Pf S st xs)) ms p q b := by
  obtain ⟨hcd, hc, hri, hcole, nb, hnb, hsf, hsof, hin⟩ := hok
  rcases hin with ⟨hin, hb⟩ | ⟨hin, hb, hD, hlt⟩
  · rw [need_done hb] at hnb
    obtain rfl := Option.some.inj hnb
    exact callOkTN_member hcd hc hri hsf hcole hsof hml hin hb fun x hx => by rw [hrs]; exact hx.2.2.2
  · have hnb' : env.need b = some nb := by rw [← (hre b hD hlt).1, ← (need_done_out hb).1]; exact hnb
    exact callOkTN_outD hrs hab.1 hPS hbell (hre b hD hlt) hcd hc hri hnb hsf hcole hsof hin
      (hIH b _ _ _ nb hD hlt (above_memS hab hS hlt) (ctxK_memD _ _ _ _ _ _ _ _) hnb')

/-- **`MemDoneRestD` with the calls by their static facts** (`DirCallsP MemCallOk` in place of
`DirCallsTN`). -/
def MemDoneRestSD (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (env : CallEnv) (SC0 MO0 : Noun)
    (inl : Noun → Option Nomm) (P Pf : Noun → Prop) (S : Noun) (xs : GenRest) (st : St Noun NeedOrd) (keep : Bool)
    (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun) (ht : Noun → Nat) (D : Bell → Prop) (h : Nat) : Prop :=
  ∃ (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat), b = C (C cape.toNoun DATA) FOL ∧
    r.info b = ⟨nm, cape, DATA, fuel⟩ ∧ ∃ CA1,
    nock (C inlBody (C (C b (C (C CODE LSR) (C JH CACHE))) compK)) inlBody = some (C nm.toNoun CA1) ∧
    InlKeep inl CACHE CA1 ∧ DirOk nm = true ∧
    DirCallsP (MemCallOk r order kids st CODE (memDCtx SCC (C CODE LSR) JH ML (A 0) b) SCC ht D h) Option.none nm ∧
    ∃ (nex : NextL CSet) (g1 : Gen (TreapMap mugF)),
      runLC (envDone r order kids st) Option.none nm (CGoalL.done : CGoalL CSet) [] (gen0 : Gen (TreapMap mugF))
        = some (nex, g1) ∧
    ∃ ord, shapeCol fuel nex.laz cape = some ord ∧ nex.th.args = [] ∧
    ∃ (nedF : Need) (g2 : Gen (TreapMap mugF)), needOrdAllocRegs ord g1 = some (nedF, g2) ∧
      isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
        ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true ∧
    ∃ sur, sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur ∧
      (∃ s, finishLFC (S := CSet) (Map := TreapMap mugF) (envDone r order kids st) nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s) ∧
      ∀ (x1 : GenRest) (C1 C2 C3 C4 SURE' : Noun) (prev : NeedOrd), st.ml b = some prev →
        msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
        ∃ t, nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
              (memFCR keep (wasN (st.sure b)) sur.toNoun
                (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
                (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
                nex.th.there (genNoun g2 x1) nm.toNoun
                (memDCtx SCC (C CODE LSR) JH ML (A 0) b) b ML
                (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
          = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)

theorem memDoneRest_of_SD {r : RealCfg} {order : List Noun} {kids : Noun → List Noun} {env : CallEnv} {SC0 MO0 : Noun}
    {inl : Noun → Option Nomm} {P Pf : Noun → Prop} {S : Noun} {xs : GenRest} {st : St Noun NeedOrd} {keep : Bool}
    {DN KIDS ML0 CB SCC CODE JETS CALLS JH CACHE0 b ML CACHE : Noun} {ht : Noun → Nat} {D : Bell → Prop} {h : Nat}
    (hre : (∀ b : Bell, D b → ht b.toNoun < h → r.env.need b = env.need b ∧ r.env.sure b = env.sure b)) (hrs : r.scc = tapList S) (hPS : ∀ k ∈ tapList S, ¬ P k)
    (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    (hab : Above ht h P Pf) (hS : ∀ k ∈ tapList S, ht k = h) (hml : MlExact st.ml ML)
    (hIH : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h)
    (H : MemDoneRestSD r order kids env SC0 MO0 inl P Pf S xs st keep DN KIDS ML0 CB SCC CODE (C JETS CALLS) JH CACHE0 b
      ML CACHE ht D h) :
    MemDoneRestD r order kids env SC0 MO0 inl P Pf S xs st keep DN KIDS ML0 CB SCC CODE (C JETS CALLS) JH CACHE0 b
      ML CACHE := by
  obtain ⟨cape, DATA, FOL, nm, fuel, hb, hinfo, CA1, hinl, hik, hn, hd, rest⟩ := H
  exact ⟨cape, DATA, FOL, nm, fuel, hb, hinfo, CA1, hinl, hik, hn,
    dirCallsTN_of (fun ms p q b' hok => callOkTN_memOkD hre hrs hPS hbell hab hS hml hIH hok) _ _ hd, rest⟩

/-- **`SccLoopDataD` with static calls** (`MemDoneRestSD`, no induction hypothesis) and the
real configuration's `env` agreeing with the table's at the callees of `D` below `h`. -/
def SccLoopDataSD (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm)
    (P Pf : Noun → Prop) (S : Noun) (ht : Noun → Nat) (D : Bell → Prop) (h : Nat) : Prop :=
  ∀ x NR CR, LoopRest env (RKD SC0 MO0 inl Pf) P S x NR CR → CsiDec S CODE JETS CALLS JH NR CR ∧
    ∃ (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (rk : Ranked (cfgReal r order kids))
      (nout : Noun → NeedOrd),
      (∀ b : Bell, D b → ht b.toNoun < h → r.env.need b = env.need b ∧ r.env.sure b = env.sure b) ∧ CfgOf (cfgReal r order kids) S (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) ∧
      MemGate (cfgReal r order kids)
        (LoopR (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
        (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
        (fun _ => (cfgReal r order kids).none) (A 0) Mode.may (A 0x79616d) ∧
      (∀ TOP, TopN (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd)).ml TOP →
        MemGate (cfgReal r order kids)
          (LoopR (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
          (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
          (topOf (cfgReal r order kids) (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd))) TOP Mode.must
          (A 0x7473756d)) ∧
      (∀ (s : St Noun NeedOrd), compileSccIn (cfgReal r order kids) false (fuelR (cfgReal r order kids) rk) St.empty
        = some s → ∀ b' : Bell, b'.toNoun ∈ (cfgReal r order kids).scc →
          env.need b' = s.ml b'.toNoun ∧ ∀ v, s.sure b'.toNoun = some v → env.sure b' = v) ∧
      ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
        LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x) st.ml st.sure ML CACHE →
        MemDoneRestSD r order kids env SC0 MO0 inl P Pf S x st keep (A 1)
          (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE ht D h

theorem sccLoopData_of_SD {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {P Pf : Noun → Prop} {S : Noun} {ht : Noun → Nat} {D : Bell → Prop} {h : Nat}
    (hPS : ∀ k ∈ tapList S, ¬ P k) (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    (hab : Above ht h P Pf) (hS : ∀ k ∈ tapList S, ht k = h)
    (H : SccLoopDataSD env SC0 MO0 CODE JETS CALLS JH inl P Pf S ht D h) :
    SccLoopDataD env SC0 MO0 CODE JETS CALLS JH inl P Pf S (CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h) := by
  intro x NR CR hx
  obtain ⟨hdec, r, order, kids, rk, nout, hre, hcfg, hmay, hmust, henv, hcall⟩ := H x NR CR hx
  exact ⟨hdec, r, order, kids, rk, nout, hcfg, hmay, hmust, henv, fun st keep b ML CACHE hb hL hIH =>
    memDoneRest_of_SD hre hcfg.scc hPS hbell hab hS hL.1 hIH (hcall st keep b ML CACHE hb hL)⟩

/-- **The table's data of one callee with static calls**: `CalleeHD` with `SccLoopDataSD`. -/
def CalleeHSD (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm) (ht : Noun → Nat)
    (D : Bell → Prop) (b : Bell) : Prop :=
  OneCalleeA env SC0 CODE CALLS inl b ∨
    ∃ S, getF mugF b.toNoun SC0 = some (C (A 0) S) ∧
      ((∀ n, S ≠ C n (C (A 0) (A 0))) ∨ ∃ n, S = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n) ∧
      ∀ P Pf, Above ht (ht b.toNoun) P Pf → SccLoopDataSD env SC0 MO0 CODE JETS CALLS JH inl P Pf S ht D (ht b.toNoun)

theorem calleeH_of_SD {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0) (hht : HtScc SC0 ht) {b : Bell}
    (H : CalleeHSD env SC0 MO0 CODE JETS CALLS JH inl ht D b) : CalleeHD env SC0 MO0 CODE JETS CALLS JH inl ht D b := by
  rcases H with hone | ⟨S, hsc, hnd, hdat⟩
  · exact Or.inl hone
  · refine Or.inr ⟨S, hsc, hnd, fun P Pf hab => ?_⟩
    have hS : ∀ k ∈ tapList S, ht k = ht b.toNoun := hht _ _ hsc
    have hPS : ∀ k ∈ tapList S, ¬ P k := fun k hk hp =>
      Nat.lt_irrefl _ ((hS k hk) ▸ hab.2 k (hab.1 k hp))
    exact sccLoopData_of_SD hPS (fun k hk => ((hsg _ _ hsc).2.2 k hk).2) hab hS (hdat P Pf hab)

