variable {ctx : Noun} {X : GenRest → Noun → Noun → Prop}

/-- The model of `%5` against `runLCMR` on a lazy goal. -/
theorem cr5_modelLRNG (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (goal : CGoalL CSet) (region : List Nat)
    (g : Gen (TreapMap mugF)) :
    (runLCMR env false msup (Nomm.n5 p q) goal region : CM (TreapMap mugF) (NextL CSet)) g = (do
      let o ← cr5BrML g.re (g.re + 1) goal
      let nexF ← runLCMR env false msup q (CGoal.toL (CGoal.next (lazyReg (S := CSet) (g.re + 1)) (jmp0 o))) region
      let nexF ← pastL env.cod nexF p region
      let nexS ← runLCMR env false msup p (CGoal.toL (CGoal.next (lazyReg (S := CSet) g.re) nexF.th)) region
      copyL nexS nexF.laz : CM (TreapMap mugF) (NextL CSet)) { g with re := g.re + 1 + 1 } := by
  cases goal <;> simp [runLCMR, CGoal.toL, cr5BrML, re, bind, StateT.bind, pure, StateT.pure] <;> rfl

/-- The model of the indirect call from `+kerf` on, with `+past` on the
empty code table. -/
noncomputable def cr2KfMLRNG (env : CallEnv) (msup : Option Nomm) (p q : Nomm) (region : List Nat) (nex : NextL CSet) :
    CM (TreapMap mugF) (NextL CSet) := do
  let (out, pro) ← kerf nex
  let rSub ← re
  let rFol ← re
  let o ← emit ⟨[], [Pole.nok rSub rFol pro], Termin.hop (jmp0 out)⟩
  let nexF ← runLCMR env false msup q (CGoal.toL (CGoal.next (lazyReg rFol) (jmp0 o))) region
  let nexF ← pastL env.cod nexF p region
  let nexS ← runLCMR env false msup p (CGoal.toL (CGoal.next (lazyReg rSub) nexF.th)) region
  copyL nexS nexF.laz

