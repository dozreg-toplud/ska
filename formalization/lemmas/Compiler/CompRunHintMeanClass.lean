import lemmas.Compiler.CompRunHintMeanP

/-!
# The run link with hints and `%mean`: the class `HintOkM` (README Gaps 25)

Generated by `tools/gen/runhintmclass.py` from `CompRunHintCall.lean` and
`CompRunHintTab.lean`: `HintOkC` with `[%mean p b q body k]` (parts in the
class), `HintCallsM` (also the code entry of `b` when `k` is `some`),
`HintSoundM` (also `SoundAt` of `q` and `p` under a `%mean`, and `snd p
[%none ~]` on a constant), every name `nC` as `nM`.

* **`comp_run_hintM`**: every member of `HintOkM` is a `PartH` at `XM E
  msup` (the case `%mean` by `partH_mean`).
* `sfSnd_none`, **`hintSound_of_tabM`**, `entries_of_callsM`,
  **`comp_run_hint_tabM`**, **`comp_run_hint_anaM`**, `comp_run_hint_anaXM`:
  `HintSoundM` from the code table, as in `CompRunHintTab.lean`.
-/

namespace Formalization
namespace Compiler

open Nock Pill Hoon SkaModel SkaModel.Comp

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

variable {ctx : Noun}

/-- `+sound-far` of `[%none ~]` is `&`. -/
theorem sfSnd_none (cod : Noun) (n : Nomm) : sfSnd cod n NeedOrd.none = true := by
  cases n <;> simp [sfSnd, soundFar, sfAt]

def HintOkM : Nomm → Bool
  | Nomm.cons p q => HintOkM p && HintOkM q
  | Nomm.n0 _ => true
  | Nomm.n1 _ => true
  | Nomm.n2 p q Option.none => HintOkM p && HintOkM q
  | Nomm.n2 p q (some (_, Option.none)) => HintOkM p && HintOkM q
  | Nomm.n3 p => HintOkM p
  | Nomm.n4 p => HintOkM p
  | Nomm.n5 p q => HintOkM p && HintOkM q
  | Nomm.n6 p q r => HintOkM p && HintOkM q && HintOkM r
  | Nomm.n7 p q => HintOkM p && HintOkM q
  | Nomm.n10 a v q => (a != 0 && HintOkM v) && HintOkM q
  | Nomm.n11s _ q _ => HintOkM q
  | Nomm.n11d _ h q _ => HintOkM h && HintOkM q
  | Nomm.n12 p q => HintOkM p && HintOkM q
  | Nomm.mean p _ q _ _ => HintOkM p && HintOkM q
  | _ => false

/-- **`CallOk` of every direct call**, also under a hint, each at the
`msup` its run gets. -/
def HintCallsM (env : CallEnv) (cod ctx : Noun) (E : GenRest → Prop) : Option Nomm → Nomm → Prop
  | ms, Nomm.cons p q => HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.n2 p q Option.none => HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.n2 p q (some (b, _)) =>
      CallOk env cod ctx E ms p q b ∧ HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.n3 p => HintCallsM env cod ctx E ms p
  | ms, Nomm.n4 p => HintCallsM env cod ctx E ms p
  | ms, Nomm.n5 p q => HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.n6 p q r =>
      HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q ∧ HintCallsM env cod ctx E ms r
  | ms, Nomm.n7 p q => HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E (some p) q
  | ms, Nomm.n10 _ v q => HintCallsM env cod ctx E ms v ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.n11s _ q _ => HintCallsM env cod ctx E ms q
  | ms, Nomm.n11d _ h q _ => HintCallsM env cod ctx E ms h ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.n12 p q => HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q
  | ms, Nomm.mean p b q _ k =>
      (k.isSome = true → CodePure cod env b) ∧ HintCallsM env cod ctx E ms p ∧ HintCallsM env cod ctx E ms q
  | _, _ => True

/-- **`+sound` returns `snd` on the formula under every kept hint**
(`SoundAt`, read by `+past-if`). -/
def HintSoundM (env : CallEnv) (ctx : Noun) (snd : Nomm → NeedOrd → Bool) : Nomm → Prop
  | Nomm.cons p q => HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q
  | Nomm.n2 p q _ => HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q
  | Nomm.n3 p => HintSoundM env ctx snd p
  | Nomm.n4 p => HintSoundM env ctx snd p
  | Nomm.n5 p q => HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q
  | Nomm.n6 p q r => HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q ∧ HintSoundM env ctx snd r
  | Nomm.n7 p q => HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q
  | Nomm.n10 _ v q => HintSoundM env ctx snd v ∧ HintSoundM env ctx snd q
  | Nomm.n11s tag q _ => (hintStatic tag = true → SoundAt ctx snd q) ∧ HintSoundM env ctx snd q
  | Nomm.n11d tag h q _ => (hintDynamic tag = true → SoundAt ctx snd q) ∧ HintSoundM env ctx snd h ∧ HintSoundM env ctx snd q
  | Nomm.n12 p q => HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q
  | Nomm.mean p b q _ k => SoundAt ctx snd q ∧ SoundAt ctx snd p ∧
      ((meanKonst env b k).isSome = true → snd p NeedOrd.none = true) ∧
      HintSoundM env ctx snd p ∧ HintSoundM env ctx snd q
  | _ => True

theorem callCode_of_hintM {env : CallEnv} {cod : Noun} {E : GenRest → Prop} :
    ∀ (n : Nomm), HintOkM n = true → ∀ (ms : Option Nomm), HintCallsM env cod ctx E ms n → CallCode cod env n
  | Nomm.cons p q, h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨callCode_of_hintM p h.1 ms hd.1, callCode_of_hintM q h.2 ms hd.2⟩
  | Nomm.n0 _, _, _, _ => trivial
  | Nomm.n1 _, _, _, _ => trivial
  | Nomm.n2 p q Option.none, h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨trivial, callCode_of_hintM p h.1 ms hd.1, callCode_of_hintM q h.2 ms hd.2⟩
  | Nomm.n2 p q (some (b, Option.none)), h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨⟨hd.1.1, hd.1.2.1⟩, callCode_of_hintM p h.1 ms hd.2.1, callCode_of_hintM q h.2 ms hd.2.2⟩
  | Nomm.n2 _ _ (some (_, some _)), h, _, _ => by simp [HintOkM] at h
  | Nomm.n3 p, h, ms, hd => by
    simp only [HintOkM] at h; simp only [HintCallsM] at hd; simp only [CallCode]; exact callCode_of_hintM p h ms hd
  | Nomm.n4 p, h, ms, hd => by
    simp only [HintOkM] at h; simp only [HintCallsM] at hd; simp only [CallCode]; exact callCode_of_hintM p h ms hd
  | Nomm.n5 p q, h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨callCode_of_hintM p h.1 ms hd.1, callCode_of_hintM q h.2 ms hd.2⟩
  | Nomm.n7 p q, h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨callCode_of_hintM p h.1 ms hd.1, callCode_of_hintM q h.2 (some p) hd.2⟩
  | Nomm.n10 a v q, h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨callCode_of_hintM v h.1.2 ms hd.1, callCode_of_hintM q h.2 ms hd.2⟩
  | Nomm.n6 p q r, h, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨callCode_of_hintM p h.1.1 ms hd.1, callCode_of_hintM q h.1.2 ms hd.2.1, callCode_of_hintM r h.2 ms hd.2.2⟩
  | Nomm.n11s _ q _, h, ms, hd => by
    simp only [HintOkM] at h; simp only [HintCallsM] at hd; simp only [CallCode]
    exact callCode_of_hintM q h ms hd
  | Nomm.n11d _ h q _, hn, ms, hd => by
    simp only [HintOkM, Bool.and_eq_true] at hn; simp only [HintCallsM] at hd; simp only [CallCode]
    exact ⟨callCode_of_hintM h hn.1 ms hd.1, callCode_of_hintM q hn.2 ms hd.2⟩
  | Nomm.n12 _ _, _, _, _ => trivial
  | Nomm.mean _ _ _ _ _, _, _, _ => by simp only [CallCode]

theorem noAx0_of_hintM : ∀ (n : Nomm), HintOkM n = true → Bake.NoAx0 n
  | Nomm.cons p q, h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩
  | Nomm.n0 _, _ => trivial
  | Nomm.n1 _, _ => trivial
  | Nomm.n2 p q Option.none, h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩
  | Nomm.n2 p q (some (b, Option.none)), h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩
  | Nomm.n2 _ _ (some (_, some _)), h => by simp [HintOkM] at h
  | Nomm.n3 p, h => by simp only [HintOkM] at h; exact noAx0_of_hintM p h
  | Nomm.n4 p, h => by simp only [HintOkM] at h; exact noAx0_of_hintM p h
  | Nomm.n5 p q, h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩
  | Nomm.n6 p q r, h => by
    simp only [HintOkM, Bool.and_eq_true] at h
    exact ⟨noAx0_of_hintM p h.1.1, noAx0_of_hintM q h.1.2, noAx0_of_hintM r h.2⟩
  | Nomm.n7 p q, h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩
  | Nomm.n10 a v q, h => by
    simp only [HintOkM, Bool.and_eq_true, bne_iff_ne, ne_eq] at h
    exact ⟨h.1.1, noAx0_of_hintM v h.1.2, noAx0_of_hintM q h.2⟩
  | Nomm.n11s _ q _, h => by
    simp only [HintOkM] at h; exact noAx0_of_hintM q h
  | Nomm.n11d _ h q _, hn => by
    simp only [HintOkM, Bool.and_eq_true] at hn; exact ⟨noAx0_of_hintM h hn.1, noAx0_of_hintM q hn.2⟩
  | Nomm.n12 p q, h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩
  | Nomm.mean p _ q _ _, h => by
    simp only [HintOkM, Bool.and_eq_true] at h; exact ⟨noAx0_of_hintM p h.1, noAx0_of_hintM q h.2⟩

/-- **The run link with hints inside direct calls, at `mono` `&`**: every
nomm of `HintOkM` whose direct calls meet `CallOk` (also under hints) and
whose kept hints meet `SoundAt` is a `PartH` at `XM E msup` (link against
`runLCH env snd true msup` on every goal with `GInv`, result, `+past`),
every `snd`, `msup` and region. -/
theorem comp_run_hintM (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (E : GenRest → Prop) :
    ∀ (n : Nomm), HintOkM n = true → ∀ (msup : Option Nomm) (region : List Nat),
      HintCallsM env cod ctx E msup n → HintSoundM env ctx snd n → PartH env snd msup ctx (XM E msup) n region
  | Nomm.cons p q, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hd.1 hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hd.2 hs.2
    exact ⟨fun goal g hi => comp_run_consLRH h7 hcode env msup p q P Q goal g hi, res_consRH P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n0 ax, h, msup, region, hd, hs =>
    partH_of_partR rfl (comp_run_dir h7 hcode env E (Nomm.n0 ax) rfl msup region trivial)
  | Nomm.n1 k, h, msup, region, hd, hs =>
    partH_of_partR rfl (comp_run_dir h7 hcode env E (Nomm.n1 k) rfl msup region trivial)
  | Nomm.n2 p q Option.none, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hd.1 hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hd.2 hs.2
    exact ⟨fun goal g hi => comp_run_n2LRH h7 hcode env msup p q P Q goal g hi, res_n2RH P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n2 p q (some (b, Option.none)), h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    obtain ⟨⟨hcd, -, hri, nb, hnb, hE⟩, hdp, hdq⟩ := hd
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hdp hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hdq hs.2
    exact ⟨fun goal g hi => crx_iff_mmH.2 (comp_run_n2_directMMH h7 hcode env msup p q P.past
        (partLMH_of_partH P) (partLMH_of_partH Q) b hcd nb hE hri hnb goal g hi),
      res_n2_directMonoH P.res Q.res hri hnb, pastAt_code h7 hcode env hc⟩
  | Nomm.n2 _ _ (some (_, some _)), h, _, _, _, hs => by simp [HintOkM] at h
  | Nomm.n3 p, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h msup region hd hs
    exact ⟨fun goal g hi => comp_run_n3LRH h7 env msup p goal region g hi P.link, res_n3RH P.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n4 p, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h msup region hd hs
    exact ⟨fun goal g hi => comp_run_n4LRH h7 env msup p goal region g hi P.link, res_n4RH P.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n5 p q, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hd.1 hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hd.2 hs.2
    exact ⟨fun goal g hi => comp_run_n5LRH h7 hcode env msup p q P Q goal g hi, res_n5RH P.res Q.res,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n7 p q, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hd.1 hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 (some p) region hd.2 hs.2
    exact ⟨fun goal g hi => comp_run_n7CRH env msup p q goal region g (Q.link goal g hi)
        (fun x mono sup hX => ⟨hX.1, hX.2.1, rfl⟩)
        (fun nex g1 e => P.link nex.goal g1 (Q.res goal g g1 nex hi e).2.2.1),
      res_n7RH Q.res P.res, pastAt_code h7 hcode env hc⟩
  | Nomm.n10 a v q, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true, bne_iff_ne, ne_eq] at h; simp only [HintCallsM] at hd
    simp only [HintSoundM] at hs
    have V := comp_run_hintM h7 hcode env snd E v h.1.2 msup region hd.1 hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hd.2 hs.2
    exact ⟨fun goal g hi => comp_run_n10LRH h7 hcode env msup a h.1.1 v q V Q goal g hi,
      res_n10RH h.1.1 V.res Q.res, pastAt_code h7 hcode env hc⟩
  | Nomm.n6 p q r, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    have ha := noAx0_of_hintM _ h
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [Bake.NoAx0] at ha
    have hc' := hc
    simp only [CallCode] at hc'
    simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1.1 msup region hd.1 hs.1
    have Q := fun rg => comp_run_hintM h7 hcode env snd E q h.1.2 msup rg hd.2.1 hs.2.1
    have R := fun rg => comp_run_hintM h7 hcode env snd E r h.2 msup rg hd.2.2 hs.2.2
    exact ⟨fun goal g hi => comp_run_n6_allRH h7 hcode env msup p q r region (sixRH_of h7 hcode P hc'.1)
        (sixRH_of h7 hcode (Q region) hc'.2.1) (sixRH_of h7 hcode (R region) hc'.2.2)
        (fun rid => sixRH_of h7 hcode (Q (rid :: region)) hc'.2.1)
        (fun rid => sixRH_of h7 hcode (R (rid :: region)) hc'.2.2) ha.2.1 ha.2.2 goal g hi,
      res_n6_allRH P.res (Q region).res (R region).res (fun rid => (Q (rid :: region)).res)
        (fun rid => (R (rid :: region)).res) ha.2.1 ha.2.2,
      pastAt_code h7 hcode env hc⟩
  | Nomm.n11s tag q body, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM] at h; simp only [HintCallsM] at hd; simp only [HintSoundM] at hs
    have Q := comp_run_hintM h7 hcode env snd E q h msup region hd hs.2
    cases ht : hintStatic tag with
    | false => exact partH_n11s ht body Q (pastAt_code h7 hcode env hc)
    | true => exact partH_n11s_kept h7 ht body Q (hs.1 ht) (pastAt_code h7 hcode env hc)
  | Nomm.n11d tag h q body, hn, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ hn msup hd
    simp only [HintOkM, Bool.and_eq_true] at hn; simp only [HintCallsM] at hd; simp only [HintSoundM] at hs
    have H := comp_run_hintM h7 hcode env snd E h hn.1 msup region hd.1 hs.2.1
    have Q := comp_run_hintM h7 hcode env snd E q hn.2 msup region hd.2 hs.2.2
    cases ht : hintDynamic tag with
    | false => exact partH_n11d_nd h7 ht body Q H (pastAt_code h7 hcode env hc)
    | true => exact partH_n11d_kept h7 ht body Q H (hs.1 ht) (pastAt_code h7 hcode env hc)
  | Nomm.n12 p q, h, msup, region, hd, hs => by
    have hc := callCode_of_hintM (ctx := ctx) _ h msup hd
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hd.1 hs.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hd.2 hs.2
    exact partH_n12 h7 hcode P Q (pastAt_code h7 hcode env hc)
  | Nomm.mean p b q body k, h, msup, region, hd, hs => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hd; simp only [HintSoundM] at hs
    have P := comp_run_hintM h7 hcode env snd E p h.1 msup region hd.2.1 hs.2.2.2.1
    have Q := comp_run_hintM h7 hcode env snd E q h.2 msup region hd.2.2 hs.2.2.2.2
    exact partH_mean h7 hcode b body k hd.1 P Q hs.1 hs.2.1 hs.2.2.1 (callCode_of_hintM p h.1 msup hd.2.1)
      (callCode_of_hintM q h.2 msup hd.2.2)

/-- **`HintSoundM` from a closed table**: every nomm with `Bake.NoAx0` whose
callees (under hints too) have entries, in a table closed for `+sound-far`,
meets `SoundAt` under each kept hint for `snd = sfSnd cod`. -/
theorem hintSound_of_tabM (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (ht : SfTable (nommOf cod)) :
    ∀ (n : Nomm), Bake.NoAx0 n → (∀ b ∈ hintBells n, ∃ m, nommOf cod b = some m) →
      HintSoundM env ctx (sfSnd cod) n
  | Nomm.cons p q, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n0 _, _, _ => by simp only [HintSoundM]
  | Nomm.n1 _, _, _ => by simp only [HintSoundM]
  | Nomm.n2 p q Option.none, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n2 p q (some (b0, k)), ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_cons, List.mem_append] at hb
    simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inr (Or.inl m)),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr (Or.inr m))⟩
  | Nomm.n3 p, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells] at hb; simp only [HintSoundM]
    exact hintSound_of_tabM h7 hcode ht p ha hb
  | Nomm.n4 p, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells] at hb; simp only [HintSoundM]
    exact hintSound_of_tabM h7 hcode ht p ha hb
  | Nomm.n5 p q, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n6 p q r, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl (Or.inl m)),
      hintSound_of_tabM h7 hcode ht q ha.2.1 fun b m => hb b (Or.inl (Or.inr m)),
      hintSound_of_tabM h7 hcode ht r ha.2.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n7 p q, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n10 _ v q, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht v ha.2.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n11s _ q _, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells] at hb; simp only [HintSoundM]
    exact ⟨fun _ => soundAt_tab h7 hcode ht ha hb, hintSound_of_tabM h7 hcode ht q ha hb⟩
  | Nomm.n11d _ h q _, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨fun _ => soundAt_tab h7 hcode ht ha.2 fun b m => hb b (Or.inr m),
      hintSound_of_tabM h7 hcode ht h ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.n12 p q, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩
  | Nomm.mean p b q _ k, ha, hb => by
    simp only [Bake.NoAx0] at ha; simp only [hintBells, List.mem_append] at hb; simp only [HintSoundM]
    exact ⟨soundAt_tab h7 hcode ht ha.2 fun b m => hb b (Or.inr m),
      soundAt_tab h7 hcode ht ha.1 fun b m => hb b (Or.inl m), fun _ => sfSnd_none cod p,
      hintSound_of_tabM h7 hcode ht p ha.1 fun b m => hb b (Or.inl m),
      hintSound_of_tabM h7 hcode ht q ha.2 fun b m => hb b (Or.inr m)⟩

/-- **The callees of a member of the class have nomm entries**, from
`CodeAna` and the code entries of its calls (`CallOk` in `HintCallsM`). -/
theorem entries_of_callsM {cod : Noun} {env : CallEnv} {E : GenRest → Prop} (hana : CodeAna cod) :
    ∀ (n : Nomm), HintOkM n = true → ∀ (ms : Option Nomm), HintCallsM env cod ctx E ms n →
      ∀ b ∈ hintBells n, ∃ m, nommOf cod b = some m
  | Nomm.cons p q, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana p h.1 ms hc.1 b) (entries_of_callsM hana q h.2 ms hc.2 b)
  | Nomm.n0 _, _, _, _, b, hb => by simp [hintBells] at hb
  | Nomm.n1 _, _, _, _, b, hb => by simp [hintBells] at hb
  | Nomm.n2 p q Option.none, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana p h.1 ms hc.1 b) (entries_of_callsM hana q h.2 ms hc.2 b)
  | Nomm.n2 p q (some (b0, Option.none)), h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_cons, List.mem_append] at hb
    rcases hb with e | e | e
    · subst e
      obtain ⟨V, hg, -⟩ := hc.1.1
      exact (sofBell_code hana hg).1
    · exact entries_of_callsM hana p h.1 ms hc.2.1 b e
    · exact entries_of_callsM hana q h.2 ms hc.2.2 b e
  | Nomm.n2 _ _ (some (_, some _)), h, _, _, _, _ => by simp [HintOkM] at h
  | Nomm.n3 p, h, ms, hc, b, hb => by
    simp only [HintOkM] at h; simp only [HintCallsM] at hc; simp only [hintBells] at hb
    exact entries_of_callsM hana p h ms hc b hb
  | Nomm.n4 p, h, ms, hc, b, hb => by
    simp only [HintOkM] at h; simp only [HintCallsM] at hc; simp only [hintBells] at hb
    exact entries_of_callsM hana p h ms hc b hb
  | Nomm.n5 p q, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana p h.1 ms hc.1 b) (entries_of_callsM hana q h.2 ms hc.2 b)
  | Nomm.n6 p q r, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    rcases hb with (e | e) | e
    · exact entries_of_callsM hana p h.1.1 ms hc.1 b e
    · exact entries_of_callsM hana q h.1.2 ms hc.2.1 b e
    · exact entries_of_callsM hana r h.2 ms hc.2.2 b e
  | Nomm.n7 p q, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana p h.1 ms hc.1 b) (entries_of_callsM hana q h.2 (some p) hc.2 b)
  | Nomm.n10 _ v q, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana v h.1.2 ms hc.1 b) (entries_of_callsM hana q h.2 ms hc.2 b)
  | Nomm.n11s _ q _, h, ms, hc, b, hb => by
    simp only [HintOkM] at h; simp only [HintCallsM] at hc; simp only [hintBells] at hb
    exact entries_of_callsM hana q h ms hc b hb
  | Nomm.n11d _ hh q _, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana hh h.1 ms hc.1 b) (entries_of_callsM hana q h.2 ms hc.2 b)
  | Nomm.n12 p q, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana p h.1 ms hc.1 b) (entries_of_callsM hana q h.2 ms hc.2 b)
  | Nomm.mean p _ q _ _, h, ms, hc, b, hb => by
    simp only [HintOkM, Bool.and_eq_true] at h; simp only [HintCallsM] at hc
    simp only [hintBells, List.mem_append] at hb
    exact hb.elim (entries_of_callsM hana p h.1 ms hc.2.1 b) (entries_of_callsM hana q h.2 ms hc.2.2 b)

/-- **The run link with hints, `+sound` from the table**: `comp_run_hintM` at
`snd = sfSnd cod` (the model of `+sound` on the table of `ctx`), with a table
closed for `+sound-far` and nomm entries for the callees of `n` in place of
`HintSoundM`. -/
theorem comp_run_hint_tabM (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (ht : SfTable (nommOf cod)) (env : CallEnv) (E : GenRest → Prop) (n : Nomm) (hn : HintOkM n = true)
    (msup : Option Nomm) (region : List Nat) (hd : HintCallsM env cod ctx E msup n)
    (he : ∀ b ∈ hintBells n, ∃ m, nommOf cod b = some m) :
    PartH env (sfSnd cod) msup ctx (XM E msup) n region :=
  comp_run_hintM h7 hcode env (sfSnd cod) E n hn msup region hd
    (hintSound_of_tabM h7 hcode ht n (noAx0_of_hintM n hn) he)

/-- **The run link with hints, from the facts of the analysis**: every
member of `HintOkM` whose direct calls (under hints too) meet `CallOk` is a
`PartH` at `XM E msup` against `runLCH env (sfSnd cod) true msup`, given
`CodeAna cod` of the code table. -/
theorem comp_run_hint_anaM (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (hana : CodeAna cod) (env : CallEnv) (E : GenRest → Prop) (n : Nomm) (hn : HintOkM n = true)
    (msup : Option Nomm) (region : List Nat) (hd : HintCallsM env cod ctx E msup n) :
    PartH env (sfSnd cod) msup ctx (XM E msup) n region :=
  comp_run_hint_tabM h7 hcode (sfTable_code hana) env E n hn msup region hd
    (entries_of_callsM hana n hn msup hd)

/-- **`comp_run_hint_ana` on every goal with `GInv`.** -/
theorem comp_run_hint_anaXM (h7 : slot? 7 ctx = some compK) {cod : Noun} (hcode : slot? 52 ctx = some cod)
    (hana : CodeAna cod) (env : CallEnv) (E : GenRest → Prop) (n : Nomm) (hn : HintOkM n = true)
    (msup : Option Nomm) (region : List Nat) (hd : HintCallsM env cod ctx E msup n)
    (goal : CGoalL CSet) (g : Gen (TreapMap mugF)) (hi : GInv g goal) :
    CompRunAtX (runLCH env (sfSnd cod) true msup) ctx (XM E msup) n goal region g :=
  (comp_run_hint_anaM h7 hcode hana env E n hn msup region hd).link goal g hi

