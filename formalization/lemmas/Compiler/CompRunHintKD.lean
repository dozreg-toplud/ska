theorem cd_eq : cr11DKept = cdHead := by kernel_rfl

/-- A dynamic tag: `crK11` is `cr11DKept`. -/
theorem cr11_dkept {tag : Nat} (hd : hintDynamic tag = true) (h q : Noun) (mono body goal region sup D : Noun) :
    nock (crSubj mono (C (A 11) (C (C (A tag) h) (C q body))) goal region sup D) crK11
      = nock (crSubj mono (C (A 11) (C (C (A tag) h) (C q body))) goal region sup D) cr11DKept := by
  rcases hd_dynamic_cases tag with ⟨-, e | e | e | e | e | e | e | e | e | e | e⟩ | ⟨e, -⟩
  all_goals first
    | (rw [hd] at e; exact absurd e (by decide))
    | (subst e; rw [cr11_eq]; unfold cr11Head cr11Dy cr11T cr11TD; simp [nock_exec, crSubj])

/-! ## The parts -/

/-- The blobs of the epilogue and the prologue. -/
abbrev cdEpil (tag toke : Nat) (body : Noun) (th : Jmp) : Blob := ⟨[], [Pole.hde tag toke body], Termin.hop th⟩
abbrev cdProl (tag toke : Nat) (body : Noun) (th : Jmp) : Blob := ⟨[], [Pole.hdp tag toke body], Termin.hop th⟩

/-- The goal of the clue. -/
noncomputable abbrev cdGoal (toke prol : Nat) : CGoalL CSet := CGoalL.next (Lazy.ofSure (lazyReg toke)) (jmp0 prol)

theorem cd_goal_noun (toke prol : Nat) : (cdGoal toke prol).toNoun
    = C (A 0x7478656e) (C (C (C (C (A 0x73696874) (A toke)) (A 0)) (C (A 0) (A 0))) (C (A 0) (A prol))) :=
  cr_goal_reg toke prol

/-- The model from the run of `h` on. -/
noncomputable def cdTail7 (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)) (h : Nomm)
    (laz : Lazy CSet) (prol toke : Nat) (region : List Nat) : CM (TreapMap mugF) (NextL CSet) := do
  let nexToke ← R h (cdGoal toke prol) region
  copyL nexToke laz

/-- **From the run of `h` on**: `h` under `[%next (lazy-from-reg toke) ~
prol]`, then `+copy` with the bound need. -/
theorem cd_p7 (h7 : slot? 7 ctx = some compK) {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)}
    {X : GenRest → Noun → Noun → Prop} (tag : Nat) (h q : Nomm) (body : Noun) (region : List Nat) (x : GenRest)
    (hx : x.NoSoft) (mono goalN sup nex0N nex1N nF1N : Noun) (nF2 : NextL CSet) (epil toke prol : Nat)
    (g7 : Gen (TreapMap mugF))
    (hh : CompRunAtX R ctx X h (cdGoal toke prol) region g7)
    (hcp : ∀ n g', R h (cdGoal toke prol) region g7 = some (n, g') → CopyH g'.re n.laz nF2.laz)
    (hX : X x mono sup) :
    nock (C (A prol) (C nF2.goal.toNoun (C nF1N (C (A epil) (C (A toke) (C nex1N (C nex0N
      (crSubj mono (Nomm.n11d tag h q body).toNoun goalN (listNoun A region) sup (compCore g7 x ctx))))))))) cdP7
      = (cdTail7 R h nF2.laz prol toke region g7).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  have h15 := cr_ctx15 h7
  have hh1 := hh x mono sup hx hX
  rw [cd_goal_noun] at hh1
  simp only [crSubj, compCore] at hh1
  have hD2 := comp_cp_at
  simp only [compCore, cr_next_nounL]
  cases e1 : R h (cdGoal toke prol) region g7 with
  | none =>
    rw [e1] at hh1
    generalize comp.door = Dr at hh1 hD2 ⊢
    unfold cdP7
    simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, cr_bat_dol, hh1, cdTail7, bind,
      StateT.bind, e1]
  | some r1 =>
    obtain ⟨n1, g8⟩ := r1
    have hcpy := comp_copy_all h7 x g8 n1 nF2.laz (hcp n1 g8 e1)
    simp only [compCore, cr_next_nounL] at hcpy
    rw [e1] at hh1
    simp only [Option.map_some, cr_next_nounL] at hh1
    generalize comp.door = Dr at hh1 hD2 hcpy ⊢
    unfold cdP7
    simp [nock_exec, crSubj, Nomm.toNoun, h15, ct_lfr_at, ct_lfr_arm, ct_lfr_gate, cr_bat_dol, hh1, cdTail7, bind,
      StateT.bind, e1, hD2, cr_cp_arm, hcpy]

/-- The model from the run of `q` on. -/
noncomputable def cdTail4 (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)) (q h : Nomm)
    (tag toke : Nat) (body : Noun) (laz : Lazy CSet) (epil : Nat) (region : List Nat) :
    CM (TreapMap mugF) (NextL CSet) := do
  let nexFol1 ← R q (CGoalL.next laz (jmp0 epil)) region
  let nexFol2 ← lazyBound nexFol1 region
  let prol ← emit (cdProl tag toke body nexFol2.th)
  cdTail7 R h nexFol2.laz prol toke region

/-- **What the part from the run of `q` takes**: the link of `q` at its goal,
the link of `h` at its goal after `+lazy-bound` and the prologue, the
`CopyH` of the `+copy`. -/
def CdRest (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)) (ctx : Noun)
    (X : GenRest → Noun → Noun → Prop) (q h : Nomm) (tag : Nat) (body : Noun) (region : List Nat)
    (laz : Lazy CSet) (toke epil : Nat) (g4 : Gen (TreapMap mugF)) : Prop :=
  CompRunAtX R ctx X q (CGoalL.next laz (jmp0 epil)) region g4 ∧
  (∀ n1 g5 n2 g6, R q (CGoalL.next laz (jmp0 epil)) region g4 = some (n1, g5) →
    lazyBound n1 region g5 = some (n2, g6) →
    CompRunAtX R ctx X h (cdGoal toke g6.bo) region (cfEmitG (cdProl tag toke body n2.th) g6)) ∧
  (∀ n1 g5 n2 g6 n3 g8, R q (CGoalL.next laz (jmp0 epil)) region g4 = some (n1, g5) →
    lazyBound n1 region g5 = some (n2, g6) →
    R h (cdGoal toke g6.bo) region (cfEmitG (cdProl tag toke body n2.th) g6) = some (n3, g8) →
    CopyH g8.re n3.laz n2.laz)

/-- **From the run of `q` on**: `q`, `+lazy-bound`, the prologue, `cd_p7`. -/
theorem cd_p4 (h7 : slot? 7 ctx = some compK) {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)}
    {X : GenRest → Noun → Noun → Prop} (tag : Nat) (h q : Nomm) (body : Noun) (region : List Nat) (x : GenRest)
    (hx : x.NoSoft) (mono goalN sup nex0N : Noun) (nex1 : NextL CSet) (epil toke : Nat) (g4 : Gen (TreapMap mugF))
    (hR : CdRest R ctx X q h tag body region nex1.laz toke epil g4) (hX : X x mono sup) :
    nock (C (A epil) (C (A toke) (C nex1.goal.toNoun (C nex0N (crSubj mono (Nomm.n11d tag h q body).toNoun goalN
      (listNoun A region) sup (compCore g4 x ctx)))))) cdP4
      = (cdTail4 R q h tag toke body nex1.laz epil region g4).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  obtain ⟨hq, hh, hcp⟩ := hR
  have hq1 := hq x mono sup hx hX
  simp only [crSubj, compCore, cgl_next_noun, cr_jmp0] at hq1
  have hD1 := comp_lb_at
  have hD2 := comp_emit_at
  simp only [compCore, cr_next_nounL]
  cases e1 : R q (CGoalL.next nex1.laz (jmp0 epil)) region g4 with
  | none =>
    rw [e1] at hq1
    generalize comp.door = Dr at hq1 hD1 hD2 ⊢
    nock_open cdP4
    simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, hq1, cdTail4, bind, StateT.bind, e1]
  | some r1 =>
    obtain ⟨n1, g5⟩ := r1
    rw [e1] at hq1
    simp only [Option.map_some, cr_next_nounL] at hq1
    have hlb := comp_lazy_bound hc x g5 n1 region
    simp only [compCore, cr_next_nounL] at hlb
    cases e2 : lazyBound (S := CSet) (Map := TreapMap mugF) n1 region g5 with
    | none =>
      rw [e2] at hlb
      generalize comp.door = Dr at hq1 hD1 hD2 hlb ⊢
      nock_open cdP4
      simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, hq1, cdTail4, bind, StateT.bind, e1, hD1, lb_arm, hlb, e2]
    | some r2 =>
      obtain ⟨n2, g6⟩ := r2
      rw [e2] at hlb
      simp only [Option.map_some, cr_next_nounL] at hlb
      have he := cf_emit (x := x) hc g6 (cdProl tag toke body n2.th)
      simp only [cdProl, Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.hop, Tag.hdp] at he
      have ht := cd_p7 h7 tag h q body region x hx mono goalN sup nex0N nex1.goal.toNoun n1.goal.toNoun n2 epil toke
        g6.bo _ (hh n1 g5 n2 g6 e1 e2) (fun n g' e => hcp n1 g5 n2 g6 n g' e1 e2 e) hX
      simp only [crSubj, compCore, cr_next_nounL, Nomm.toNoun] at ht
      generalize comp.door = Dr at hq1 hD1 hD2 hlb he ht ⊢
      nock_open cdP4
      simp [nock_exec, crSubj, Nomm.toNoun, cr_bat_dol, hq1, cdTail4, bind, StateT.bind, e1, hD1, lb_arm, hlb, e2,
        hD2, comp_emit_arm, he, cf_emit_g, ht]

/-- The model from `+past-if` on. -/
noncomputable def cdFrom (R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet))
    (snd : Nomm → NeedOrd → Bool) (q h : Nomm) (tag : Nat) (body : Noun) (region : List Nat) (nex : NextL CSet) :
    CM (TreapMap mugF) (NextL CSet) := do
  let nex ← pastIfL snd nex q region
  let toke ← re
  let epil ← emit (cdEpil tag toke body nex.th)
  cdTail4 R q h tag toke body nex.laz epil region

/-- The state after `+re` and the epilogue. -/
abbrev cdG4 (tag : Nat) (body : Noun) (th : Jmp) (g2 : Gen (TreapMap mugF)) : Gen (TreapMap mugF) :=
  cfEmitG (cdEpil tag g2.re body th) { g2 with re := g2.re + 1 }

/-- **From `+past-if` on**: `+past-if`, `+re`, the epilogue, `cd_p4`. -/
theorem cd_p1 (h7 : slot? 7 ctx = some compK) {R : Nomm → CGoalL CSet → List Nat → CM (TreapMap mugF) (NextL CSet)}
    {X : GenRest → Noun → Noun → Prop} {snd : Nomm → NeedOrd → Bool} (tag : Nat) (h q : Nomm) (body : Noun)
    (region : List Nat) (x : GenRest) (hx : x.NoSoft) (mono goalN sup : Noun) (nex0 : NextL CSet)
    (g1 : Gen (TreapMap mugF)) (hs : SoundAt ctx snd q)
    (hR : ∀ nex1 g2, pastIfL snd nex0 q region g1 = some (nex1, g2) →
      CdRest R ctx X q h tag body region nex1.laz g2.re g2.bo (cdG4 tag body nex1.th g2))
    (hX : X x mono sup) :
    nock (C nex0.goal.toNoun (crSubj mono (Nomm.n11d tag h q body).toNoun goalN (listNoun A region) sup
      (compCore g1 x ctx))) cdP1
      = (cdFrom R snd q h tag body region nex0 g1).map fun p => C p.1.goal.toNoun (genNoun p.2 x) := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  have hpi := comp_past_if h7 x g1 nex0 q region hs
  simp only [compCore, cr_next_nounL] at hpi ⊢
  have hD1 := comp_past_if_at
  have hD2 := comp_emit_at
  have hD3 := comp_re_at
  cases e1 : pastIfL snd nex0 q region g1 with
  | none =>
    rw [e1] at hpi
    generalize comp.door = Dr at hpi hD1 hD2 hD3 ⊢
    nock_open cdP1
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pi_arm, hpi, cdFrom, bind, StateT.bind, e1]
  | some r =>
    obtain ⟨nex1, g2⟩ := r
    rw [e1] at hpi
    simp only [Option.map_some, cr_next_nounL] at hpi
    have hre := comp_re' ctx x g2
    have he := cf_emit (x := x) hc { g2 with re := g2.re + 1 } (cdEpil tag g2.re body nex1.th)
    simp only [cdEpil, Blob.toNoun, listNoun, Termin.toNoun, Pole.toNoun, Tag.hop, Tag.hde] at he
    have ht := cd_p4 h7 tag h q body region x hx mono goalN sup nex0.goal.toNoun nex1 g2.bo g2.re _ (hR nex1 g2 e1) hX
    simp only [crSubj, compCore, cr_next_nounL, Nomm.toNoun, cdG4, cdEpil] at ht hre
    generalize comp.door = Dr at hpi hD1 hD2 hD3 he ht hre ⊢
    nock_open cdP1
    simp [nock_exec, crSubj, Nomm.toNoun, hD1, pi_arm, hpi, hD3, hre, hD2, comp_emit_arm, he, ht, cdFrom, bind,
      StateT.bind, e1, cf_emit_g, re]

/-! ## The case -/

theorem runLCH_n11d_kept (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (msup : Option Nomm) {tag : Nat}
    (hd : hintDynamic tag = true) (h q : Nomm) (body : Noun) (goal : CGoalL CSet) (region : List Nat) :
    (runLCH env snd true msup (Nomm.n11d tag h q body) goal region : CM (TreapMap mugF) (NextL CSet)) =
      simpleNextL goal >>= cdFrom (runLCH env snd true msup) snd q h tag body region := by
  simp only [runLCH, hd, Bool.not_true, Bool.false_eq_true, if_false]
  rfl

/-- **The kept dynamic tag on every goal** (`%spot`, `%slog`, `%hunk`, ...),
against `runLCH env snd true msup`: from `SoundAt` of `q` and, after
`+simple-next` and `+past-if`, what the part from the run of `q` takes
(`CdRest`: the links of `q` and `h` at their goals, the `CopyH`). -/
theorem comp_run_n11d_kept (h7 : slot? 7 ctx = some compK) (env : CallEnv) (snd : Nomm → NeedOrd → Bool)
    (msup : Option Nomm) {X : GenRest → Noun → Noun → Prop} {tag : Nat} (hd : hintDynamic tag = true)
    (h q : Nomm) (body : Noun) (goal : CGoalL CSet) (region : List Nat) (g : Gen (TreapMap mugF))
    (hs : SoundAt ctx snd q)
    (hR : ∀ nex0 g1 nex1 g2, simpleNextL goal g = some (nex0, g1) → pastIfL snd nex0 q region g1 = some (nex1, g2) →
      CdRest (runLCH env snd true msup) ctx X q h tag body region nex1.laz g2.re g2.bo (cdG4 tag body nex1.th g2)) :
    CompRunAtX (runLCH env snd true msup) ctx X (Nomm.n11d tag h q body) goal region g := by
  obtain ⟨hc, -, -⟩ := comp_ctx_pill ctx h7
  intro x mono sup hx hX
  rw [runLCH_n11d_kept env snd msup hd]
  simp only [Nomm.toNoun]
  rw [cr_disp_n11, cr11_dkept hd, cd_eq]
  have hsn := comp_simple_next hc x g goal mono (C (A 11) (C (C (A tag) h.toNoun) (C q.toNoun body)))
    (listNoun A region) sup
  rw [bind_apply]
  cases e : simpleNextL (S := CSet) (Map := TreapMap mugF) goal g with
  | none =>
    rw [e] at hsn
    simp only [Option.map_none] at hsn
    simp only [crSubj, compCore] at hsn ⊢
    generalize comp.door = Dr at hsn ⊢
    nock_open cdHead
    simp [nock_exec, crSubj, hsn, cr_bat_sn]
  | some r =>
    obtain ⟨nex0, g1⟩ := r
    rw [e] at hsn
    simp only [Option.map_some] at hsn
    have hk := cd_p1 h7 tag h q body region x hx mono goal.toNoun sup nex0 g1 hs
      (fun nex1 g2 e1 => hR nex0 g1 nex1 g2 e e1) hX
    simp only [crSubj, compCore, Nomm.toNoun] at hsn hk ⊢
    generalize comp.door = Dr at hsn hk ⊢
    nock_open cdHead
    simp [nock_exec, crSubj, hsn, cr_bat_sn, hk]

end Compiler
