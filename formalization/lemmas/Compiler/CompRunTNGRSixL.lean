/-- **The model of phase L**: where `+leap` gives `[~ rest bys]` and, on the
rest, `~` (`LeapTwice`), the case is the case on `[%next rest then]`, then
`copyAll` of `bys`. -/
theorem runLC_n6_lRNG (env : CallEnv) (msup : Option Nomm) (p q r : Nomm) (laz rest : Lazy CSet) (th : Jmp)
    (bys : List (Lazy CSet)) (region : List Nat) (hlp : leap laz q r = some (some (rest, bys)))
    (h2 : leap rest q r = some Option.none) :
    (runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region : CM (TreapMap mugF) (NextL CSet))
      = (do
          let nex ← runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next rest th) region
          copyAll nex bys) := by
  have e : ∀ L J, (runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next L J) region : CM (TreapMap mugF) (NextL CSet))
      = sixNextLC env.cod (runLCMR env false msup p) (runLCMR env false msup q) (runLCMR env false msup r) p q r 3 L J region :=
    fun _ _ => rfl
  rw [e, e, sixNextLC.eq_2]
  simp only [hlp]
  rw [sixNextLC_leap_none env.cod _ _ _ p q r 0 1 rest th region h2]

/-- **What `%6` returns in phase L**: `GRes`, given what the run on the rest
returns. -/
theorem res_n6_lRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (htw : LeapTwice laz q r) (hi : GInv g (CGoalL.next laz th)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hReR : ∀ nex g', runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex)
    (h : runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex := by
  rw [runLC_n6_lRNG env msup p q r laz rest th bys region hlp (htw rest bys hlp)] at h
  obtain ⟨n1, g1, e1, e2⟩ := bind_some h
  exact (chain_l (leapInv hi.1 hq hr) hlp (hReR n1 g1 e1)).2 nex g' e2

/-- **What phase L returns** (`res_n6_lRNG`) without `LeapTwice`. -/
theorem res_n6_l_twRNG {env : CallEnv} {msup : Option Nomm} {p q r : Nomm} {region : List Nat}
    (laz : Lazy CSet) (th : Jmp) (g g' : Gen (TreapMap mugF)) (nex : NextL CSet)
    (rest : Lazy CSet) (bys : List (Lazy CSet)) (hlp : leap laz q r = some (some (rest, bys)))
    (hi : GInv g (CGoalL.next laz th)) (hq : Bake.NoAx0 q) (hr : Bake.NoAx0 r)
    (hReR : ∀ nex g', runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next rest th) region g = some (nex, g') →
      GRes g (CGoalL.next rest th) g' nex)
    (h : runLCMR env false msup (Nomm.n6 p q r) (CGoalL.next laz th) region g = some (nex, g')) :
    GRes g (CGoalL.next laz th) g' nex :=
  res_n6_lRNG laz th g g' nex rest bys hlp (leapTwice_noAx0 hq hr) hi hq hr hReR h

