import lemmas.Ska.SccLoopSoftEq

/-! # `runLCS` is `runLC` with `sof` false at the nomm's own calls (README Gaps 19 (g), `sim`)

GENERATED by `tools/gen/simoff.py` from `Ska/SccLoopSoftEq.lean`: `callLS_sim` and `runLCS_sim` with
the hypothesis "`sof` false at every call of every nomm" (`∀ m p q b n, env.sof m p q b n = false`)
replaced by `SofOff env sup nm`: `sof` false at each direct call of `nm`, at the `made` of its
`sup`, for the callee's need (the fact `CallOkTN` records per call).  `runLCS_sim` asked it
everywhere, which fails in an SCC with a soft call; here it is asked of one member's nomm.

* `SofOff`, `sofOff_n2`; **`callLS_simB`**; **`runLCS_simD`**; `runLCS_eqD`.  Do not edit by hand. -/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

/-- **`sof` false at each direct call of the nomm**, at the `made` of the `sup` its run gets and
the callee's need. -/
def SofOff (env : CallEnv) : Option Nomm → Nomm → Prop
  | ms, Nomm.cons p q => SofOff env ms p ∧ SofOff env ms q
  | ms, Nomm.n2 p q Option.none => SofOff env ms p ∧ SofOff env ms q
  | ms, Nomm.n2 p q (some (b, _)) =>
      (∀ nb, env.need b = some nb → env.sof (made p ms) p q b nb = false) ∧ SofOff env ms p ∧ SofOff env ms q
  | ms, Nomm.n3 p => SofOff env ms p
  | ms, Nomm.n4 p => SofOff env ms p
  | ms, Nomm.n5 p q => SofOff env ms p ∧ SofOff env ms q
  | ms, Nomm.n6 p q r => SofOff env ms p ∧ SofOff env ms q ∧ SofOff env ms r
  | ms, Nomm.n7 p q => SofOff env ms p ∧ SofOff env (some p) q
  | ms, Nomm.n10 _ v q => SofOff env ms v ∧ SofOff env ms q
  | _, _ => True

theorem sofOff_n2 {env : CallEnv} {ms : Option Nomm} {p q : Nomm} {info : Option (Bell × Option Noun)}
    (h : SofOff env ms (Nomm.n2 p q info)) : SofOff env ms p ∧ SofOff env ms q ∧
      ∀ b k nb, info = some (b, k) → env.need b = some nb → env.sof (made p ms) p q b nb = false := by
  rcases info with _ | ⟨b, k⟩
  · exact ⟨h.1, h.2, fun _ _ _ e => by cases e⟩
  · exact ⟨h.2.1, h.2.2, fun b' k' nb e hn => by
      simp only [Option.some.injEq, Prod.mk.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      exact h.1 nb hn⟩

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

theorem callLS_simB (env : CallEnv) {rp' rq' : CGoalL S → List Nat → CMS Map (NextL S)}
    {rp rq : CGoalL S → List Nat → CM Map (NextL S)}
    (hp : ∀ g r, SimS (rp' g r) (rp g r)) (hq : ∀ g r, SimS (rq' g r) (rq g r))
    (p q : Nomm) (info : Option (Bell × Option Noun)) (sup : Option Nomm) (goal : CGoalL S) (region : List Nat)
    (hsof : ∀ b k nb, info = some (b, k) → env.need b = some nb → env.sof (made p sup) p q b nb = false) :
    SimS (callLS env rp' rq' p q info sup goal region) (callL env rp rq p q info sup goal region) := by
  unfold callLS callL
  rcases info with _ | ⟨b, key⟩
  · exact simS_bind (simS_liftS _) fun nex => simS_bind2 (kerfS_sim _) fun out pro =>
      simS_bind (simS_liftS _) fun rSub => simS_bind (simS_liftS _) fun rFol =>
      simS_bind (simS_liftS _) fun o => simS_bind (hq _ _) fun nexFol =>
      simS_bind (simS_liftS _) fun nexFol => simS_bind (hp _ _) fun nexSub => simS_liftS _
  · have hdrop : ∀ th, SimS (Map := Map) (do
        let nexFol ← (if safeFolFol q then pure ⟨ofSure Sure.bunt, th⟩
          else rq' (CGoalL.next (ofSure Sure.bunt) th) region : CMS Map (NextL S))
        let nexFol ← liftS (pastL env.cod nexFol p region)
        let nexSub ← rp' (CGoalL.next (ofSure Sure.bunt) nexFol.th) region
        liftS (copyL nexSub nexFol.laz)) (do
        let nexFol ← (if safeFolFol q then pure ⟨ofSure Sure.bunt, th⟩
          else rq (CGoalL.next (ofSure Sure.bunt) th) region : CM Map (NextL S))
        let nexFol ← pastL env.cod nexFol p region
        let nexSub ← rp (CGoalL.next (ofSure Sure.bunt) nexFol.th) region
        copyL nexSub nexFol.laz) := fun th =>
      simS_bind (simS_ite _ (simS_pure _) (hq _ _)) fun nexFol => simS_bind (simS_liftS _) fun nexFol =>
        simS_bind (hp _ _) fun nexSub => simS_liftS _
    have hrest : ∀ (c : Nat) (sn : Need), SimS (Map := Map) (do
        let nexFol ← (if safeFolFol q then pure ⟨ofSure Sure.bunt, (jmp0 c)⟩
          else rq' (CGoalL.next (ofSure Sure.bunt) (jmp0 c)) region : CMS Map (NextL S))
        let nexFol ← liftS (pastL env.cod nexFol p region)
        let nexSub ← rp' (CGoalL.next (ofSure ⟨sn, HoonSet.empty⟩) nexFol.th) region
        liftS (copyL nexSub nexFol.laz)) (do
        let nexFol ← (if safeFolFol q then pure ⟨ofSure Sure.bunt, (jmp0 c)⟩
          else rq (CGoalL.next (ofSure Sure.bunt) (jmp0 c)) region : CM Map (NextL S))
        let nexFol ← pastL env.cod nexFol p region
        let nexSub ← rp (CGoalL.next (ofSure ⟨sn, HoonSet.empty⟩) nexFol.th) region
        copyL nexSub nexFol.laz) := fun c sn =>
      simS_bind (simS_ite _ (simS_pure _) (hq _ _)) fun nexFol => simS_bind (simS_liftS _) fun nexFol =>
        simS_bind (hp _ _) fun nexSub => simS_liftS _
    cases goal with
    | next laz th =>
      by_cases hc : (env.pure b && noneEquivalentL laz) = true
      · simp only [hc, if_true]; exact hdrop th
      · simp only [hc, Bool.false_eq_true, if_false]
        rcases key with _ | k
        · rcases hr : env.ring b with _ | rg
          · rcases hn : env.need b with _ | bNed
            · exact simS_none
            · simp only [hsof b _ bNed rfl hn, Bool.false_eq_true, if_false]
              refine simS_bind (simS_liftS _) fun sn => ?_
              refine simS_bind (simS_bind (simS_liftS _) fun nex => simS_bind2 (kerfS_sim _) fun out pro =>
                simS_bind_pure (simS_liftS _) fun o => ?_) fun c => ?_
              · exact fun _ => rfl
              · refine simS_bind_left (a := (⟨ofSure ⟨sn, HoonSet.empty⟩, jmp0 c⟩ : NextL S)) (simS_withSoft ?_) ?_
                · rw [if_neg (by simp [noSoft])]; exact simS_pure _
                · exact hrest c sn
          · exact simS_none
        · exact simS_none
    | done =>
      simp only []
      rcases key with _ | k
      · rcases hr : env.ring b with _ | rg
        · rcases hn : env.need b with _ | bNed
          · exact simS_none
          · simp only [hsof b _ bNed rfl hn, Bool.false_eq_true, if_false]
            refine simS_bind (simS_liftS _) fun sn => ?_
            refine simS_bind (simS_bind_pure (simS_liftS _) fun o => ?_) fun c => ?_
            · exact fun _ => rfl
            · refine simS_bind_left (a := (⟨ofSure ⟨sn, HoonSet.empty⟩, jmp0 c⟩ : NextL S)) (simS_withSoft ?_) ?_
              · rw [if_neg (by simp [noSoft])]; exact simS_pure _
              · exact hrest c sn
        · exact simS_none
      · exact simS_none
    | pick z o =>
      simp only []
      rcases key with _ | k
      · rcases hr : env.ring b with _ | rg
        · rcases hn : env.need b with _ | bNed
          · exact simS_none
          · simp only [hsof b _ bNed rfl hn, Bool.false_eq_true, if_false]
            refine simS_bind (simS_liftS _) fun sn => ?_
            refine simS_bind (simS_bind (simS_liftS _) fun nex => simS_bind2 (kerfS_sim _) fun out pro =>
                simS_bind_pure (simS_liftS _) fun o => ?_) fun c => ?_
            · exact fun _ => rfl
            · refine simS_bind_left (a := (⟨ofSure ⟨sn, HoonSet.empty⟩, jmp0 c⟩ : NextL S)) (simS_withSoft ?_) ?_
              · rw [if_neg (by simp [noSoft])]; exact simS_pure _
              · exact hrest c sn
        · exact simS_none
      · exact simS_none

theorem runLCS_simD (env : CallEnv) (snd : Nomm → NeedOrd → Bool)
    : ∀ (nm : Nomm) (sup : Option Nomm), SofOff env sup nm → ∀ (goal : CGoalL S) (region : List Nat),
      SimS (runLCS (Map := Map) env snd sup nm goal region) (runLC env sup nm goal region) := by
  intro nm
  induction nm with
  | cons p q ihp ihq =>
    intro sup hs goal region
    obtain ⟨hsp, hsq⟩ := hs
    simp only [runLCS, runLC]
    refine simS_bind ?_ fun g' => ?_
    · cases goal with
      | done => exact simS_bind (simS_liftS _) fun r => simS_bind (simS_liftS _) fun o => simS_pure (Map := Map) _
      | pick _ _ => exact simS_pure _
      | next _ _ => exact simS_pure _
    · cases g' with
      | pick _ _ =>
        exact simS_bind (simS_liftS _) fun o => simS_bind (ihq _ hsq _ _) fun nex2 =>
              simS_bind (simS_liftS _) fun nex2 => simS_bind (ihp _ hsp _ _) fun nex1 => simS_liftS _
      | next laz th =>
        exact simS_bind3 (simS_liftS _) fun hed tel o => simS_bind (simS_liftS _) fun nexh =>
              simS_bind (ihq _ hsq _ _) fun nex2 => simS_bind (simS_liftS _) fun nex2 =>
              simS_bind (ihp _ hsp _ _) fun nex1 => simS_liftS _
      | done => exact simS_none
  | n0 _ => intro sup hs goal region; rw [runLCS]; exact simS_liftS _
  | n1 _ => intro sup hs goal region; rw [runLCS]; exact simS_liftS _
  | n2 p q info ihp ihq =>
    intro sup hs goal region
    obtain ⟨hsp, hsq, hsb⟩ := sofOff_n2 hs
    simp only [runLCS, runLC]
    exact callLS_simB env (fun g rg => ihp sup hsp g rg) (fun g rg => ihq sup hsq g rg) p q info sup goal region
      hsb
  | n3 p ihp =>
    intro sup hs goal region
    simp only [runLCS, runLC]
    cases goal with
    | next laz th =>
      refine simS_ite _ (ihp _ hs _ _) (simS_bind (simS_liftS _) fun a => ?_)
      rcases a with _ | ⟨r, o⟩
      · exact simS_none
      · exact simS_bind2 (simS_liftS _) fun z o' => simS_bind (simS_liftS _) fun r' =>
          simS_bind (simS_liftS _) fun oc => ihp _ hs _ _
    | pick z o => exact simS_bind (simS_liftS _) fun r => simS_bind (simS_liftS _) fun oc => ihp _ hs _ _
    | done =>
      exact simS_bind2 (simS_liftS _) fun o0 o1 => simS_bind (simS_liftS _) fun r =>
            simS_bind (simS_liftS _) fun oc => ihp _ hs _ _
  | n4 p ihp =>
    intro sup hs goal region
    simp only [runLCS, runLC]
    cases goal with
    | done =>
      exact simS_bind (simS_liftS _) fun pro => simS_bind (simS_liftS _) fun arg =>
            simS_bind (simS_liftS _) fun o => ihp _ hs _ _
    | pick z o =>
      exact simS_bind (simS_liftS _) fun pro => simS_bind (simS_liftS _) fun arg =>
            simS_bind (simS_liftS _) fun o => ihp _ hs _ _
    | next laz th =>
      refine simS_bind (simS_liftS _) fun a => simS_bind2 ?_ fun pro th' =>
        simS_bind (simS_liftS _) fun arg => simS_bind (simS_liftS _) fun o => ihp _ hs _ _
      rcases a with _ | x
      · exact simS_bind (simS_liftS _) fun r => simS_ite _ (simS_pure _) simS_none
      · exact simS_pure _
  | n5 p q ihp ihq =>
    intro sup hs goal region
    obtain ⟨hsp, hsq⟩ := hs
    simp only [runLCS, runLC]
    refine simS_bind (simS_liftS _) fun rp => simS_bind (simS_liftS _) fun rq => simS_bind ?_ fun o =>
      simS_bind (ihq _ hsq _ _) fun nexq => simS_bind (simS_liftS _) fun nexq =>
      simS_bind (ihp _ hsp _ _) fun nexp => simS_liftS _
    cases goal with
    | pick z o => exact simS_liftS _
    | done => exact simS_bind2 (simS_liftS _) fun o0 o1 => simS_liftS _
    | next laz th =>
      refine simS_bind (simS_liftS _) fun a => ?_
      rcases a with _ | ⟨r, o⟩
      · exact simS_ite _ (simS_liftS _) simS_none
      · exact simS_bind2 (simS_liftS _) fun z o' => simS_liftS _
  | n6 p q r ihp ihq ihr =>
    intro sup hs goal region
    obtain ⟨hsp, hsq, hsr⟩ := hs
    simp only [runLCS, runLC]
    have h6 : ∀ g : CGoalL S, SimS (Map := Map) (do
        let nex1 ← runLCS env snd sup r g region
        let nex0 ← runLCS env snd sup q g region
        let yes ← liftS (emit ⟨[], [], Termin.hop nex0.th⟩)
        let nuh ← liftS (emit ⟨[], [], Termin.hop nex1.th⟩)
        liftS (setTag yes region)
        liftS (setTag nuh region)
        if nex0.th.args ≠ [] then fun _ => Option.none else
        if nex1.th.args ≠ [] then fun _ => Option.none else
        let lazy ← liftS (liftO (pastFork env.cod (mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) p))
        let nexCond ← runLCS env snd sup p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region
        withSoft fun sf => if !(lazyBig (softLess sf lazy)) then liftS (copyL nexCond lazy) else do
          let o ← liftS (emit ⟨[], [], Termin.hop nexCond.th⟩)
          let lazy ← lazyShutS o lazy
          liftS (copyL ⟨nexCond.laz, jmp0 o⟩ lazy)) (do
        let nex1 ← runLC env sup r g region
        let nex0 ← runLC env sup q g region
        let yes ← emit ⟨[], [], Termin.hop nex0.th⟩
        let nuh ← emit ⟨[], [], Termin.hop nex1.th⟩
        setTag yes region
        setTag nuh region
        if nex0.th.args ≠ [] then fun _ => Option.none else
        if nex1.th.args ≠ [] then fun _ => Option.none else
        let lazy ← liftO (pastFork env.cod (mk Sure.bunt [((yes, nex0.laz), (nuh, nex1.laz))] []) p)
        let nexCond ← runLC env sup p (CGoalL.pick (jmp0 yes) (jmp0 nuh)) region
        if !(lazyBig (softLess noSoft lazy)) then copyL nexCond lazy else do
          let o ← emit ⟨[], [], Termin.hop nexCond.th⟩
          let lazy ← lazyShut o lazy
          copyL ⟨nexCond.laz, jmp0 o⟩ lazy) := fun g =>
      simS_bind (ihr _ hsr _ _) fun nex1 => simS_bind (ihq _ hsq _ _) fun nex0 => simS_bind (simS_liftS _) fun yes =>
        simS_bind (simS_liftS _) fun nuh => simS_bind (simS_liftS _) fun _ => simS_bind (simS_liftS _) fun _ =>
        simS_ite _ simS_none (simS_ite _ simS_none (simS_bind (simS_liftS _) fun lazy =>
          simS_bind (ihp _ hsp _ _) fun nexCond => simS_withSoft (simS_ite _ (simS_liftS _)
            (simS_bind (simS_liftS _) fun o => simS_bind (lazyShutS_sim _ _) fun lazy => simS_liftS _))))
    cases goal with
    | next laz th =>
      exact sixNextLCS_sim _ _ (fun g rg => ihp sup hsp g rg) (fun g rg => ihq sup hsq g rg)
            (fun g rg => ihr sup hsr g rg) p q r 3 laz th region
    | done => exact h6 _
    | pick z o => exact h6 _
  | n7 p q ihp ihq =>
    intro sup hs goal region
    obtain ⟨hsp, hsq⟩ := hs
    simp only [runLCS, runLC]
    exact simS_bind (ihq _ hsq _ _) fun nex => ihp _ hsp _ _
  | n10 a v q ihv ihq =>
    intro sup hs goal region
    obtain ⟨hsv, hsq⟩ := hs
    simp only [runLCS, runLC]
    exact simS_bind (simS_liftS _) fun next => simS_bind3 (simS_liftS _) fun don rec o =>
      simS_bind (simS_liftS _) fun nexR => simS_bind (ihv _ hsv _ _) fun nexDon =>
      simS_bind (simS_liftS _) fun nexDon => simS_bind (ihq _ hsq _ _) fun nexRec => simS_liftS _
  | n11s _ _ _ _ => intro sup hs goal region; exact fun _ => rfl
  | n11d _ _ _ _ _ _ => intro sup hs goal region; exact fun _ => rfl
  | n12 _ _ _ _ => intro sup hs goal region; exact fun _ => rfl
  | mean _ _ _ _ _ _ _ => intro sup hs goal region; exact fun _ => rfl

/-- **`runLCS_eqD`**: the equation of `runLCS_simD` at a state. -/
theorem runLCS_eqD (env : CallEnv) (snd : Nomm → NeedOrd → Bool) (nm : Nomm) (sup : Option Nomm)
    (hs : SofOff env sup nm) (goal : CGoalL S) (region : List Nat) (g : Gen Map) :
    runLCS env snd sup nm goal region (GenSf.ofGen g) = (runLC env sup nm goal region g).map embS :=
  runLCS_simD env snd nm sup hs goal region g

