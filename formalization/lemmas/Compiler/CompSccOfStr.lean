/-- **`SccLoopAt` without `PrintId`, at `LoopRS`** (`printId_pill` proves it): a configuration that is the
pill's, `Ranked`, the three `MemGate`s for `LoopRS` (track I: `LoopR` with `MlStr`) with `Q := QK env R P S x`, and `env` the
model's at the members. -/
def SccLoopAtAStr (env : CallEnv) (R : GenRest → Prop) (P : Noun → Prop) (S CODE JETS CALLS JH : Noun)
    (x : GenRest) (NR CR : Noun) : Prop :=
  ∃ (c : Cfg Noun NeedOrd) (r : Ranked c) (outC : Noun → List Noun) (nout : Noun → NeedOrd),
    CfgOf c S (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) ∧
    MemGate c (LoopRS c.scc outC nout (QK env R P S x))
      (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
      (fun _ => c.none) (A 0) Mode.may (A 0x79616d) ∧
    MemGate c (LoopRS c.scc outC nout (QK env R P S x))
      (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
      (fun _ => c.none) (A 0) Mode.done (A 0x656e6f64) ∧
    (∀ TOP, TopN (maySweep c (St.empty : St Noun NeedOrd)).ml TOP →
      MemGate c (LoopRS c.scc outC nout (QK env R P S x))
        (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
        (topOf c (maySweep c (St.empty : St Noun NeedOrd))) TOP Mode.must (A 0x7473756d)) ∧
    ∀ (s : St Noun NeedOrd), compileSccIn c false (fuelR c r) St.empty = some s → ∀ b' : Bell, b'.toNoun ∈ c.scc →
      env.need b' = s.ml b'.toNoun ∧ ∀ v, s.sure b'.toNoun = some v → env.sure b' = v

/-- **`CalleeCompiledP` for a callee of any SCC, with `RKD`** (`calleeCompiled_scc` with the loop
asked only at the rests where it runs, no `PrintId`, and the bells in progress `Pf` kept missing in
`nary.cache`: the new entries are the members of `S`, outside `Pf`). -/
theorem calleeCompiled_sccDStr {ctx CODE JETS CALLS JH SC0 MO0 : Noun} (h7 : slot? 7 ctx = some compK)
    (hl : slot? 26 ctx = some (C CODE (C JETS CALLS))) (hj : slot? 54 ctx = some JH)
    (h107 : slot? 107 ctx = some CALLS) (env : CallEnv) (inl : Noun → Option Nomm) (P Pf : Noun → Prop)
    (b : Bell) (nb : NeedOrd) (S : Noun)
    (hsg : SccsGood SC0) (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v)
    (hsc : getF mugF b.toNoun SC0 = some (C (A 0) S))
    (hnd : (∀ n, S ≠ C n (C (A 0) (A 0))) ∨ ∃ n, S = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n)
    (hPS : ∀ k ∈ tapList S, ¬ P k) (hPfS : ∀ k ∈ tapList S, ¬ Pf k) (hnb : env.need b = some nb)
    (hloop : ∀ x NR CR, LoopRest env (RKD SC0 MO0 inl Pf) P S x NR CR →
      SccLoopAtAStr env (RKD SC0 MO0 inl Pf) P S CODE JETS CALLS JH x NR CR) :
    CalleeCompiledP env (RKD SC0 MO0 inl Pf) P ctx b nb := by
  intro x NR MO SC RS hA hR hcx h0
  obtain ⟨xc, xs, xf⟩ := x
  simp only at hcx h0 ⊢
  subst hcx
  have hA0 := hA
  have hR0 := hR
  obtain ⟨hns, NR1, MO1, SC1, INL1, SU1, hc1, hnr, hsu, hag, hsa⟩ := hA
  obtain ⟨⟨⟨⟨NR2, MO2, INL2, SU2, hc2, hil, hin⟩, NRc, hNRc, hcl⟩, hPf0⟩, hD0⟩ := hR
  simp only [cacheN, Noun.cell.injEq] at hc1
  obtain ⟨e1, e2, e3, e4⟩ := hc1
  subst NR1 MO1 SC1 RS
  simp only [cacheN, Noun.cell.injEq] at hc2
  obtain ⟨e5, e6, e7, e8, e9⟩ := hc2
  subst NR2 MO2 INL2 SU2 SC
  have eNc : NRc = NR := by simpa [nock_exec] using hNRc.symm
  subst NRc
  obtain ⟨hSset, hbS, hSmem⟩ := hsg _ _ hsc
  have hmissS := members_miss hsg hsc hcl hnr h0
  have hsuS : ∀ k ∈ tapList S, getF mugF k SU1 = some (A 0) := by
    intro k hk
    rcases getF_cases (k := k) hsu with h | ⟨v, hv⟩
    · exact h
    · obtain ⟨b', rfl⟩ := (hSmem k hk).2
      obtain ⟨-, u, hu⟩ := hsa b' v hv (hPS _ hk)
      rw [hmissS _ hk] at hu
      cases hu
  obtain ⟨c, r, outC, nout, hcfg, hmay, hdone, hmust, henv⟩ :=
    hloop ⟨C NR (C MO (C SC0 (C INL1 SU1))), xs, xf⟩ NR (C MO (C SC0 (C INL1 SU1))) ⟨hA0, hR0, rfl, hmissS⟩
  have hcs : c.scc = tapList S := hcfg.scc
  have hq0 : QK env (RKD SC0 MO0 inl Pf) P S ⟨C NR (C MO (C SC0 (C INL1 SU1))), xs, xf⟩ (C NR (C MO (C SC0 (C INL1 SU1)))) :=
    ⟨agreeIP_mono (fun k h => Or.inl h) hA0, ext_refl _, hR0, NR, _, rfl, hmissS⟩
  have hsu0 : SureHolds c.scc (St.empty : St Noun NeedOrd).sure (C NR (C MO (C SC0 (C INL1 SU1)))) :=
    ⟨SU1, by simp [nock_exec], fun k hk => Or.inr ⟨rfl, hsuS k (hcs ▸ hk)⟩⟩
  obtain ⟨s, hs, hsome, hout, M, NR', REST, NARYU, ⟨hLR, -⟩, hNR', hNU, hus, hgate, mD, hmD, -⟩ :=
    csi_gate_ranked_dec c r c.scc outC nout (QK env (RKD SC0 MO0 inl Pf) P S ⟨C NR (C MO (C SC0 (C INL1 SU1))), xs, xf⟩)
      S CODE JETS CALLS JH NR (C MO (C SC0 (C INL1 SU1))) ⟨hSset, hcj.1, hcj.2, hnr⟩ ⟨_, hbS, h0⟩ hnd hcfg (fun k hk => (hSmem k hk).2)
      hmay hdone St.empty hmust
      (fun CA h => by
        obtain ⟨⟨-, NR, MO, SC, INL, SU, hc, hm, -⟩, -⟩ := h
        exact ⟨NR, _, hc, hm⟩)
      (fun _ => rfl) hsu0 hq0
  obtain ⟨hml, hsh, -, hAq, hEq, hRq, NRq, RESTq, eq, hmissq⟩ := hLR
  obtain ⟨eq1, eq2⟩ := Noun.cell.inj eq
  subst eq1 eq2
  have henv' := henv s hs
  have hssome := compileSccIn_sure_some c _ _ s hs
  have hmemM : ∀ k v, Get M k v → k ∈ tapList S := by
    intro k v hv
    obtain ⟨n, t, hn, -⟩ := hml.2.1 k v hv
    refine Classical.byContradiction fun hk => ?_
    rw [hout k (hcs ▸ hk)] at hn
    cases hn
  have hnotM : ∀ k u, getF mugF k NR' = some (C (A 0) u) → ¬ KIn M k := by
    rintro k u hu ⟨v, hv⟩
    rw [hmissq k (hmemM k v hv)] at hu
    cases hu
  have hbml : s.ml b.toNoun = some nb := by rw [← (henv' b (hcs ▸ hbS)).1, hnb]
  obtain ⟨hns', NRa, MOa, SCa, INLa, SUa, hca, hnra, hsua, haga, hsaa⟩ := hAq
  obtain ⟨ea1, ea2⟩ := Noun.cell.inj hca
  subst ea1
  have h31 : ∀ S31, slot? 31 (C NR' REST) = some S31 → S31 = SUa := by
    intro S31 h; rw [ea2] at h; simpa [nock_exec] using h.symm
  have hE2 : Ext ⟨C NR' REST, xs, xf⟩ ⟨C NARYU REST, xs, xf⟩ := by
    refine ⟨rfl, rfl, fun N hN => ?_, fun N hN => ⟨N, by simpa [nock_exec] using hN, mapSub_refl N⟩⟩
    have eN : N = NR' := by simpa [nock_exec] using hN.symm
    subst eN
    refine ⟨NARYU, by simp [nock_exec], fun k u hu => ?_⟩
    exact getF_some hNU ((hus _ _).2 (Or.inr ⟨getF_get_map hNR' hu, hnotM k u hu⟩))
  obtain ⟨S31, hS31, hall⟩ := hsh
  have eS := h31 S31 hS31
  subst eS
  obtain ⟨⟨⟨⟨NRb, MOb, INLb, SUb, hcb, hilb, hinb⟩, NRd, hNRd, hcld⟩, hPfq⟩, hDq⟩ := hRq
  have eNd : NRd = NR' := by simpa [nock_exec] using hNRd.symm
  subst eNd
  -- the bells in progress stay missing
  have hPfU : ∀ N, slot? 2 (C NARYU REST) = some N → ∀ k, Pf k → getF mugF k N = some (A 0) := by
    intro N hN k hk
    have eN : N = NARYU := by simpa [nock_exec] using hN.symm
    subst eN
    refine getF_none hNU fun v hv => ?_
    rcases (hus _ _).1 hv with hm | ⟨hn, -⟩
    · exact hPfS _ (hmemM _ _ hm) hk
    · have := hPfq NRd (by simp [nock_exec]) k hk
      rw [getF_some hNR' hn] at this
      cases this
  refine ⟨C NARYU REST, cccMiss_of_loop h7 hl hj b nb (fun g => ccc_scc_hit h7 h107 b hsc g) hgate hml hbml,
    ext_trans hEq hE2, ?_, ⟨⟨⟨⟨NARYU, MOb, INLb, SUb, congrArg (C NARYU) (Noun.cell.inj hcb).2, hilb, hinb⟩,
      NARYU, by simp [nock_exec], fun k u hu => ?_⟩, hPfU⟩, cacheDec_uni hDq ⟨mD, hmD⟩ hNU hus⟩, ?_⟩
  · refine ⟨hns', NARYU, MOa, SCa, INLa, S31, congrArg (C NARYU) ea2, hNU, hsua, fun b' u hu => ?_,
      fun b' v hv hP => ?_⟩
    · rcases (hus _ _).1 (getF_get_map hNU hu) with hm | ⟨hn, -⟩
      · obtain ⟨n, t, hn, rfl⟩ := hml.2.1 _ _ hm
        have hb'S := hmemM _ _ hm
        refine ⟨⟨n, by rw [(henv' b' (hcs ▸ hb'S)).1, hn], by simp [nock_exec]⟩, ?_⟩
        rcases hall _ (hcs ▸ hb'S) with ⟨v, -, hgv⟩ | ⟨hv, -⟩
        · exact ⟨_, hgv⟩
        · have := hssome _ (hcs ▸ hb'S); rw [hv] at this; cases this
      · exact haga b' u (getF_some hnra hn)
    · by_cases hbS' : b'.toNoun ∈ tapList S
      · rcases hall _ (hcs ▸ hbS') with ⟨w, hw, hgw⟩ | ⟨hw, -⟩
        · rw [hv] at hgw
          simp only [Option.some.injEq, Noun.cell.injEq, true_and] at hgw
          subst hgw
          refine ⟨by rw [(henv' b' (hcs ▸ hbS')).2 w hw], ?_⟩
          obtain ⟨n, hn⟩ := Option.isSome_iff_exists.mp (hsome _ (hcs ▸ hbS'))
          obtain ⟨t, hg⟩ := hml.2.2 _ _ hn
          exact ⟨_, uni_M hNU hus hg⟩
        · have := hssome _ (hcs ▸ hbS'); rw [hw] at this; cases this
      · obtain ⟨h1, u, hu⟩ := hsaa b' v hv (fun h => h.elim hP hbS')
        exact ⟨h1, uni_key hnra hNU hus hu⟩
  · rcases (hus _ _).1 (getF_get_map hNU hu) with hm | ⟨hn, -⟩
    · have hkS := hmemM _ _ hm
      refine ⟨S, ((hSmem k hkS).1), fun k' hk' => ?_⟩
      obtain ⟨n, hn⟩ := Option.isSome_iff_exists.mp (hsome _ (hcs ▸ hk'))
      obtain ⟨t, hg⟩ := hml.2.2 _ _ hn
      exact ⟨_, uni_M hNU hus hg⟩
    · obtain ⟨S', hS', hall'⟩ := hcld k u (getF_some hNR' hn)
      refine ⟨S', hS', fun k' hk' => ?_⟩
      obtain ⟨u', hu'⟩ := hall' k' hk'
      exact uni_key hNR' hNU hus hu'
  · obtain ⟨t, hg⟩ := hml.2.2 _ _ hbml
    exact ⟨NARYU, _, by simp [nock_exec], uni_M hNU hus hg⟩

/-- **`MemDoneCallStr` from the threaded run at `mono` `|`** (`comp_run_dirXTN` at `E := EMD`,
`Y := ExtE EMD`): the facts of the model and of track A's arms as in `MemDoneCallStr`, `+inlined`
keeping the cache (`InlKeep`), the class `DirOk` and `DirCallsTN` of the member's nomm (each call
by `callOkTN_member` or `callOkTN_out`), with no outside callees asked of `OutsHeld`
(`outC := fun _ => []`). -/
theorem memDoneCall_ofDStr (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (nout : Noun → NeedOrd)
    (env : CallEnv) (SC0 MO0 : Noun) (inl : Noun → Option Nomm) (P Pf : Noun → Prop) (S : Noun) (xs : GenRest)
    (hrs : r.scc = tapList S) (hPS : ∀ k ∈ tapList S, ¬ P k)
    (st : St Noun NeedOrd) (keep : Bool) (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun)
    (hR : LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S xs) st.ml st.sure ML CACHE)
    (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat) (hb : b = C (C cape.toNoun DATA) FOL)
    (hinfo : r.info b = ⟨nm, cape, DATA, fuel⟩) (CA1 : Noun)
    (hinl : nock (C inlBody (C (C b (C (C CODE LSR) (C JH CACHE))) compK)) inlBody = some (C nm.toNoun CA1))
    (hik : InlKeep inl CACHE CA1) (hn : DirOk nm = true)
    (hd : DirCallsTN (envDone r order kids st) CODE (memDCtx SCC (C CODE LSR) JH ML (A 0) b)
      (EMD env SC0 MO0 inl P Pf S st xs) (ExtE (EMD env SC0 MO0 inl P Pf S st xs)) Option.none nm)
    (nex : NextL CSet) (g1 : Gen (TreapMap mugF))
    (hrunL : runLC (envDone r order kids st) Option.none nm (CGoalL.done : CGoalL CSet) [] (gen0 : Gen (TreapMap mugF))
      = some (nex, g1))
    (ord : NeedOrd) (hcol : shapeCol fuel nex.laz cape = some ord) (hargs : nex.th.args = [])
    (nedF : Need) (g2 : Gen (TreapMap mugF)) (hnoar : needOrdAllocRegs ord g1 = some (nedF, g2))
    (hrun : isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
        ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true)
    (sur : NeedOrd) (hsur : sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur)
    (hfin : ∃ s, finishLFC (S := CSet) (Map := TreapMap mugF) (envDone r order kids st) nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s)
    (hcs : ∀ (x1 : GenRest) (C1 C2 C3 C4 SURE' : Noun) (prev : NeedOrd), st.ml b = some prev →
        msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
        ∃ t, (∃ s : Straight (TreapMap mugF), C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t = s.toNoun) ∧ nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
              (memFCR keep (wasN (st.sure b)) sur.toNoun
                (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
                (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
                nex.th.there (genNoun g2 x1) nm.toNoun
                (memDCtx SCC (C CODE LSR) JH ML (A 0) b) b ML
                (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
          = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)) :
    MemDoneCallStr r order kids (fun _ => []) nout env (RKD SC0 MO0 inl Pf) P S xs st keep DN KIDS ML0 CB SCC CODE LSR JH
      CACHE0 b ML CACHE := by
  have hE0 : EMD env SC0 MO0 inl P Pf S st xs (cuRest CA1) := eMD_start hPS hR.2.2.2 (hrs ▸ hR.2.1) hik
  have h7 : slot? 7 (memDCtx SCC (C CODE LSR) JH ML (A 0) b) = some compK := rfl
  have h52 : slot? 52 (memDCtx SCC (C CODE LSR) JH ML (A 0) b) = some CODE := by simp [memDCtx, nock_exec]
  have hrun' := comp_run_dirXTN h7 h52 (envDone r order kids st) (EMD env SC0 MO0 inl P Pf S st xs)
    (ExtE (EMD env SC0 MO0 inl P Pf S st xs))
    (fun msup => yOk_xn msup (fun x => ⟨ext_refl x, id⟩) (fun h1 h2 => ⟨ext_trans h1.1 h2.1, fun h => h2.2 (h1.2 h)⟩)
      (fun hx h => ext_noSoft hx h.1) (fun hE h => h.2 hE)) nm hn Option.none [] hd CGoalL.done genEntry rfl
  have hf : (runLCM (S := CSet) (Map := TreapMap mugF) (envDone r order kids st) false Option.none)
      = runLC (envDone r order kids st) Option.none := by
    funext n g rg; exact runLCM_false _ n _ g rg
  rw [hf] at hrun'
  refine ⟨cape, DATA, FOL, nm, fuel, hb, hinfo, CA1, hinl, nex, g1, hrunL, XN (EMD env SC0 MO0 inl P Pf S st xs) Option.none,
    ExtE (EMD env SC0 MO0 inl P Pf S st xs), hrun', ⟨hE0, rfl, rfl⟩, ?_, ord, hcol, hargs, nedF, g2, hnoar, hrun, sur, hsur,
    hfin, hcs⟩
  intro x1 hy
  obtain ⟨hA1, -, hQ1, hS1⟩ := hy.2 hE0
  obtain ⟨-, C1, C2, C3, C4, SU, hc, -⟩ := hA1
  refine ⟨C1, C2, C3, C4, SU, hc, hy.1.1, hc ▸ hQ1, hrs ▸ hc ▸ hS1, fun b' _ k hk => by simp at hk⟩

/-- **What a `%done` call of `member` still takes** once the run is linked: `MemDoneCallStr` with
the threaded run replaced by `+inlined` keeping the cache (`InlKeep`, track A), the class `DirOk`
and the per-call facts `DirCallsTN` at `EMD` (each by `callOkTN_member` or `callOkTN_out`). -/
def MemDoneRestDStr (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (env : CallEnv) (SC0 MO0 : Noun)
    (inl : Noun → Option Nomm) (P Pf : Noun → Prop) (S : Noun) (xs : GenRest) (st : St Noun NeedOrd) (keep : Bool)
    (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun) : Prop :=
  ∃ (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat), b = C (C cape.toNoun DATA) FOL ∧
    r.info b = ⟨nm, cape, DATA, fuel⟩ ∧ ∃ CA1,
    nock (C inlBody (C (C b (C (C CODE LSR) (C JH CACHE))) compK)) inlBody = some (C nm.toNoun CA1) ∧
    InlKeep inl CACHE CA1 ∧ DirOk nm = true ∧
    DirCallsTN (envDone r order kids st) CODE (memDCtx SCC (C CODE LSR) JH ML (A 0) b)
      (EMD env SC0 MO0 inl P Pf S st xs) (ExtE (EMD env SC0 MO0 inl P Pf S st xs)) Option.none nm ∧
    ∃ (nex : NextL CSet) (g1 : Gen (TreapMap mugF)),
      runLC (envDone r order kids st) Option.none nm (CGoalL.done : CGoalL CSet) [] (gen0 : Gen (TreapMap mugF))
        = some (nex, g1) ∧
    ∃ ord, shapeCol fuel nex.laz cape = some ord ∧ nex.th.args = [] ∧
    ∃ (nedF : Need) (g2 : Gen (TreapMap mugF)), needOrdAllocRegs ord g1 = some (nedF, g2) ∧
      isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
        ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true ∧
    ∃ sur, sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur ∧
      (∃ s, finishLFC (S := CSet) (Map := TreapMap mugF) (envDone r order kids st) nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s) ∧
      ∀ (x1 : GenRest) (C1 C2 C3 C4 SURE' : Noun) (prev : NeedOrd), st.ml b = some prev →
        msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
        ∃ t, (∃ s : Straight (TreapMap mugF), C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t = s.toNoun) ∧ nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
              (memFCR keep (wasN (st.sure b)) sur.toNoun
                (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
                (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
                nex.th.there (genNoun g2 x1) nm.toNoun
                (memDCtx SCC (C CODE LSR) JH ML (A 0) b) b ML
                (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
          = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)

theorem memDoneCall_of_restDStr {r : RealCfg} {order : List Noun} {kids : Noun → List Noun} {nout : Noun → NeedOrd}
    {env : CallEnv} {SC0 MO0 : Noun} {inl : Noun → Option Nomm} {P Pf : Noun → Prop} {S : Noun} {xs : GenRest}
    (hrs : r.scc = tapList S) (hPS : ∀ k ∈ tapList S, ¬ P k)
    {st : St Noun NeedOrd} {keep : Bool} {DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun}
    (hR : LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S xs) st.ml st.sure ML CACHE)
    (h : MemDoneRestDStr r order kids env SC0 MO0 inl P Pf S xs st keep DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE) :
    MemDoneCallStr r order kids (fun _ => []) nout env (RKD SC0 MO0 inl Pf) P S xs st keep DN KIDS ML0 CB SCC CODE LSR JH
      CACHE0 b ML CACHE := by
  obtain ⟨cape, DATA, FOL, nm, fuel, hb, hinfo, CA1, hinl, hik, hn, hd, nex, g1, hrunL, ord, hcol, hargs, nedF, g2,
    hnoar, hrun, sur, hsur, hfin, hcs⟩ := h
  exact memDoneCall_ofDStr r order kids nout env SC0 MO0 inl P Pf S xs hrs hPS st keep DN KIDS ML0 CB SCC CODE LSR JH CACHE0
    b ML CACHE hR cape DATA FOL nm fuel hb hinfo CA1 hinl hik hn hd nex g1 hrunL ord hcol hargs nedF g2 hnoar hrun sur
    hsur hfin hcs

/-- **`SccLoopAtAStr` with its `%done` third discharged** (`memGate_done_realStr` with `rKD_sure`,
`sure_miss_of_agree` at the rest of the loop, `memDoneCall_of_restDStr` at every call): at a rest where
`calleeCompiled_sccDStr` runs the loop (`LoopRest`), the configuration `cfgReal r order kids` with
`CfgOf` and `Ranked`, the `%may` and `%must` gates, the agreement of `env`, the members bells, and
per `%done` call `MemDoneRestDStr`. -/
theorem sccLoopAtD_realStr (env : CallEnv) (SC0 MO0 : Noun) (inl : Noun → Option Nomm) (P Pf : Noun → Prop)
    (S CODE JETS CALLS JH : Noun) (x : GenRest) (NR CR : Noun)
    (hx : LoopRest env (RKD SC0 MO0 inl Pf) P S x NR CR) (hPS : ∀ k ∈ tapList S, ¬ P k)
    (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (rk : Ranked (cfgReal r order kids))
    (nout : Noun → NeedOrd)
    (hcfg : CfgOf (cfgReal r order kids) S (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)))
    (hmay : MemGate (cfgReal r order kids) (LoopRS (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
      (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
      (fun _ => (cfgReal r order kids).none) (A 0) Mode.may (A 0x79616d))
    (hmust : ∀ TOP, TopN (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd)).ml TOP →
      MemGate (cfgReal r order kids) (LoopRS (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
        (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
        (topOf (cfgReal r order kids) (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd))) TOP Mode.must
        (A 0x7473756d))
    (henv : ∀ (s : St Noun NeedOrd), compileSccIn (cfgReal r order kids) false (fuelR (cfgReal r order kids) rk) St.empty
      = some s → ∀ b' : Bell, b'.toNoun ∈ (cfgReal r order kids).scc →
        env.need b' = s.ml b'.toNoun ∧ ∀ v, s.sure b'.toNoun = some v → env.sure b' = v)
    (hcall : ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
      LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x) st.ml st.sure ML CACHE →
      MemDoneRestDStr r order kids env SC0 MO0 inl P Pf S x st keep (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0)
        csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE) :
    SccLoopAtAStr env (RKD SC0 MO0 inl Pf) P S CODE JETS CALLS JH x NR CR := by
  obtain ⟨hA, hR, hc, hmiss⟩ := hx
  have hrs : r.scc = tapList S := hcfg.scc
  have hxS : ∀ b ∈ r.scc, ∀ N u, slot? 31 x.cache = some N → getF mugF b N ≠ some (C (A 0) u) := by
    intro b hb
    refine sure_miss_of_agree hA hPS hbell (fun N hN k hk => ?_) b (hrs ▸ hb)
    rw [hc] at hN
    have : N = NR := by simpa [nock_exec] using hN.symm
    subst this; exact hmiss k hk
  refine ⟨cfgReal r order kids, rk, fun _ => [], nout, hcfg, hmay, ?_, hmust, henv⟩
  exact memGate_done_realStr r order kids (fun _ => []) nout env (RKD SC0 MO0 inl Pf) P S x rKD_sure
    (fun b hb => hrs ▸ hb) hxS (A 1) _ (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR)
    (fun st keep b ML CACHE hb hL => memDoneCall_of_restDStr hrs hPS hL (hcall st keep b ML CACHE hb hL))

/-- **The loop data of an SCC callee at the bells in progress `(P, Pf)`** (`SccCalleeR` at any
`(P, Pf)`, with each `%done` call's `MemDoneRestDStr` under the hypothesis `IH`): at every rest
where the loop runs, a real configuration that is the pill's, ranked, the `%may` and `%must`
gates, `env` the model's at the members, and per `%done` call `MemDoneRestDStr`. -/
def SccLoopDataDStr (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm)
    (P Pf : Noun → Prop) (S : Noun) (IH : Prop) : Prop :=
  ∀ x NR CR, LoopRest env (RKD SC0 MO0 inl Pf) P S x NR CR →
    ∃ (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (rk : Ranked (cfgReal r order kids))
      (nout : Noun → NeedOrd),
      CfgOf (cfgReal r order kids) S (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) ∧
      MemGate (cfgReal r order kids)
        (LoopRS (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
        (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
        (fun _ => (cfgReal r order kids).none) (A 0) Mode.may (A 0x79616d) ∧
      (∀ TOP, TopN (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd)).ml TOP →
        MemGate (cfgReal r order kids)
          (LoopRS (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
          (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
          (topOf (cfgReal r order kids) (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd))) TOP Mode.must
          (A 0x7473756d)) ∧
      (∀ (s : St Noun NeedOrd), compileSccIn (cfgReal r order kids) false (fuelR (cfgReal r order kids) rk) St.empty
        = some s → ∀ b' : Bell, b'.toNoun ∈ (cfgReal r order kids).scc →
          env.need b' = s.ml b'.toNoun ∧ ∀ v, s.sure b'.toNoun = some v → env.sure b' = v) ∧
      ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
        LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x) st.ml st.sure ML CACHE → IH →
        MemDoneRestDStr r order kids env SC0 MO0 inl P Pf S x st keep (A 1)
          (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE

/-- **The table's data of one callee `b`** (heights `ht`, domain `D`): a one-bell callee, or an
SCC `S` (its `sccs` entry, `hnd`) with `SccLoopDataDStr` at every `(P, Pf)` above `b`, whose
`%done` calls may use `CCBelowD` at `b`'s height (the outside callees of the members, lower). -/
def CalleeHDStr (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm) (ht : Noun → Nat)
    (D : Bell → Prop) (b : Bell) : Prop :=
  OneCalleeA env SC0 CODE CALLS inl b ∨
    ∃ S, getF mugF b.toNoun SC0 = some (C (A 0) S) ∧
      ((∀ n, S ≠ C n (C (A 0) (A 0))) ∨ ∃ n, S = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n) ∧
      ∀ P Pf, Above ht (ht b.toNoun) P Pf →
        SccLoopDataDStr env SC0 MO0 CODE JETS CALLS JH inl P Pf S (CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D (ht b.toNoun))

/-- **One step of the induction on height**: a callee with `CalleeHDStr` whose lower callees are
`CCBelowD` is `CalleeCompiledP` at every `(P, Pf)` above it (`calleeCompiled_oneKD`, or
`calleeCompiled_sccDStr` with `sccLoopAtD_realStr`). -/
theorem calleeCompiled_stepHDStr {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0)
    (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v) (hht : HtScc SC0 ht)
    {b : Bell} (hT : CalleeHDStr env SC0 MO0 CODE JETS CALLS JH inl ht D b)
    (hIH : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D (ht b.toNoun))
    {P Pf : Noun → Prop} (hab : Above ht (ht b.toNoun) P Pf) {ctx : Noun} (hctx : CtxK CODE JETS CALLS JH ctx)
    {nb : NeedOrd} (hnb : env.need b = some nb) :
    CalleeCompiledP env (RKD SC0 MO0 inl Pf) P ctx b nb := by
  obtain ⟨h7, hl, hj, h107⟩ := hctx
  have hnPf : ∀ k, Pf k → ht k ≠ ht b.toNoun := fun k hk e => Nat.lt_irrefl _ (e ▸ hab.2 k hk)
  rcases hT with hone | ⟨S, hsc, hnd, hdat⟩
  · obtain ⟨cape, DATA, FOL, nm, fuel, envb, p, st, rfl, hsc, hinl, hcalls, hcode, hn, hax, hfix, hone⟩ := hone
    have e : nb = st.need := Option.some.inj (hnb.symm.trans hone.2.2.1)
    subst e
    exact calleeCompiled_oneKD h7 hl hj h107 env envb cape DATA FOL nm fuel p st inl hsc hinl hcalls hcode hn hax
      hfix hone P Pf (fun h => hnPf _ (hab.1 _ h) rfl) (fun h => hnPf _ h rfl)
  · have hS : ∀ k ∈ tapList S, ht k = ht b.toNoun := hht _ _ hsc
    have hPfS : ∀ k ∈ tapList S, ¬ Pf k := fun k hk h => hnPf k h (hS k hk)
    have hPS : ∀ k ∈ tapList S, ¬ P k := fun k hk h => hPfS k hk (hab.1 k h)
    have hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k := fun k hk => ((hsg _ _ hsc).2.2 k hk).2
    refine calleeCompiled_sccDStr h7 hl hj h107 env inl P Pf b nb S hsg hcj hsc hnd hPS hPfS hnb fun x NR CR hx => ?_
    obtain ⟨r, order, kids, rk, nout, hcfg, hmay, hmust, henv, hcall⟩ := hdat P Pf hab x NR CR hx
    exact sccLoopAtD_realStr env SC0 MO0 inl P Pf S CODE JETS CALLS JH x NR CR hx hPS hbell r order kids rk nout
      hcfg hmay hmust henv fun st keep b0 ML CACHE hb hL => hcall st keep b0 ML CACHE hb hL hIH

/-- **Every callee is compiled, by induction on height** (README Gaps 19 (g)): for a table
whose SCCs have heights (`HtScc`) and whose callees of the domain `D` have `CalleeHDStr`, every
callee of `D` is `CalleeCompiledP env (RKD SC0 MO0 inl Pf) P` at every `(P, Pf)` above it, at every
context with `CtxK`. -/
theorem calleeCompiled_heightsDStr {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0)
    (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v) (hht : HtScc SC0 ht)
    (hT : ∀ b, D b → CalleeHDStr env SC0 MO0 CODE JETS CALLS JH inl ht D b) :
    ∀ (b : Bell) (P Pf : Noun → Prop) (ctx : Noun) (nb : NeedOrd), D b → Above ht (ht b.toNoun) P Pf →
      CtxK CODE JETS CALLS JH ctx → env.need b = some nb → CalleeCompiledP env (RKD SC0 MO0 inl Pf) P ctx b nb := by
  have H : ∀ m, CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D m := by
    intro m
    induction m with
    | zero => intro b' P' Pf' ctx' nb' _ hlt; exact absurd hlt (Nat.not_lt_zero _)
    | succ m ih =>
      intro b' P' Pf' ctx' nb' hD hlt hab hctx hnb
      exact calleeCompiled_stepHDStr hsg hcj hht (hT b' hD) (cCBelowD_mono (Nat.le_of_lt_succ hlt) ih) hab hctx hnb
  exact fun b P Pf ctx nb hD hab hctx hnb => H (ht b.toNoun + 1) b P Pf ctx nb hD (Nat.lt_succ_self _) hab hctx hnb

/-- **At the gate** (`P = Pf = ∅`): `CalleeCompiled` with `RKD` at no bell in progress. -/
theorem calleeCompiled_heights0DStr {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0)
    (hcj : IsMap mugF CALLS ∧ ∀ k v, Get CALLS k v → IsSet mugF v) (hht : HtScc SC0 ht)
    (hT : ∀ b, D b → CalleeHDStr env SC0 MO0 CODE JETS CALLS JH inl ht D b) {b : Bell} {ctx : Noun} {nb : NeedOrd}
    (hD : D b) (hctx : CtxK CODE JETS CALLS JH ctx) (hnb : env.need b = some nb) :
    CalleeCompiled env (RKD SC0 MO0 inl (fun _ => False)) ctx b nb := by
  intro x NR MO SC RS hA hR hc h0
  obtain ⟨CA', h1, h2, h3, h4, h5⟩ := calleeCompiled_heightsDStr hsg hcj hht hT b _ _ ctx nb hD (above_empty ht _) hctx hnb
    x NR MO SC RS (agreeIP_of_E _ hA) hR hc h0
  exact ⟨CA', h1, h2, agreeE_of_IP h3, h4, h5⟩

/-- **`MemDoneRestDStr` with the calls by their static facts** (`DirCallsP MemCallOk` in place of
`DirCallsTN`). -/
def MemDoneRestSDStr (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (env : CallEnv) (SC0 MO0 : Noun)
    (inl : Noun → Option Nomm) (P Pf : Noun → Prop) (S : Noun) (xs : GenRest) (st : St Noun NeedOrd) (keep : Bool)
    (DN KIDS ML0 CB SCC CODE LSR JH CACHE0 b ML CACHE : Noun) (ht : Noun → Nat) (D : Bell → Prop) (h : Nat) : Prop :=
  ∃ (cape : Cape) (DATA FOL : Noun) (nm : Nomm) (fuel : Nat), b = C (C cape.toNoun DATA) FOL ∧
    r.info b = ⟨nm, cape, DATA, fuel⟩ ∧ ∃ CA1,
    nock (C inlBody (C (C b (C (C CODE LSR) (C JH CACHE))) compK)) inlBody = some (C nm.toNoun CA1) ∧
    InlKeep inl CACHE CA1 ∧ DirOk nm = true ∧
    DirCallsP (MemCallOk r order kids st CODE (memDCtx SCC (C CODE LSR) JH ML (A 0) b) SCC ht D h) Option.none nm ∧
    ∃ (nex : NextL CSet) (g1 : Gen (TreapMap mugF)),
      runLC (envDone r order kids st) Option.none nm (CGoalL.done : CGoalL CSet) [] (gen0 : Gen (TreapMap mugF))
        = some (nex, g1) ∧
    ∃ ord, shapeCol fuel nex.laz cape = some ord ∧ nex.th.args = [] ∧
    ∃ (nedF : Need) (g2 : Gen (TreapMap mugF)), needOrdAllocRegs ord g1 = some (nedF, g2) ∧
      isRun (flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1)
        ((flattenNeed (bakeNeed nedF (Sock.mk cape DATA)).1).headD 0) 0 = true ∧
    ∃ sur, sureOf (needToOrd nex.laz.sure.ned) nex.laz.sure.lok cape = some sur ∧
      (∃ s, finishLFC (S := CSet) (Map := TreapMap mugF) (envDone r order kids st) nm ord cape
        (fun n => bakeNeed n (Sock.mk cape DATA)) = some s) ∧
      ∀ (x1 : GenRest) (C1 C2 C3 C4 SURE' : Noun) (prev : NeedOrd), st.ml b = some prev →
        msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape ≠ needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1 →
        ∃ t, (∃ s : Straight (TreapMap mugF), C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t = s.toNoun) ∧ nock (C finBody (C (C (A 0) (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun)
              (memFCR keep (wasN (st.sure b)) sur.toNoun
                (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1).toNoun nex.laz.toNoun nedF.toNoun
                (bakeNeed nedF (Sock.mk cape DATA)).1.toNoun (immNoun (bakeNeed nedF (Sock.mk cape DATA)).2)
                nex.th.there (genNoun g2 x1) nm.toNoun
                (memDCtx SCC (C CODE LSR) JH ML (A 0) b) b ML
                (A 0) (cacheN C1 C2 C3 C4 SURE') (memCtx DN KIDS ML0 CB SCC (C CODE LSR) JH CACHE0)))) finBody
          = some (C (msgOrd (needToOrd (bakeNeed nedF (Sock.mk cape DATA)).1) prev cape).toNoun t)

theorem memDoneRest_of_SDStr {r : RealCfg} {order : List Noun} {kids : Noun → List Noun} {env : CallEnv} {SC0 MO0 : Noun}
    {inl : Noun → Option Nomm} {P Pf : Noun → Prop} {S : Noun} {xs : GenRest} {st : St Noun NeedOrd} {keep : Bool}
    {DN KIDS ML0 CB SCC CODE JETS CALLS JH CACHE0 b ML CACHE : Noun} {ht : Noun → Nat} {D : Bell → Prop} {h : Nat}
    (hre : (∀ b : Bell, D b → ht b.toNoun < h → r.env.need b = env.need b ∧ r.env.sure b = env.sure b)) (hrs : r.scc = tapList S) (hPS : ∀ k ∈ tapList S, ¬ P k)
    (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    (hab : Above ht h P Pf) (hS : ∀ k ∈ tapList S, ht k = h) (hml : MlExact st.ml ML)
    (hIH : CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h)
    (H : MemDoneRestSDStr r order kids env SC0 MO0 inl P Pf S xs st keep DN KIDS ML0 CB SCC CODE (C JETS CALLS) JH CACHE0 b
      ML CACHE ht D h) :
    MemDoneRestDStr r order kids env SC0 MO0 inl P Pf S xs st keep DN KIDS ML0 CB SCC CODE (C JETS CALLS) JH CACHE0 b
      ML CACHE := by
  obtain ⟨cape, DATA, FOL, nm, fuel, hb, hinfo, CA1, hinl, hik, hn, hd, rest⟩ := H
  exact ⟨cape, DATA, FOL, nm, fuel, hb, hinfo, CA1, hinl, hik, hn,
    dirCallsTN_of (fun ms p q b' hok => callOkTN_memOkD hre hrs hPS hbell hab hS hml hIH hok) _ _ hd, rest⟩

/-- **`SccLoopDataDStr` with static calls** (`MemDoneRestSDStr`, no induction hypothesis) and the
real configuration's `env` agreeing with the table's at the callees of `D` below `h`. -/
def SccLoopDataSDStr (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm)
    (P Pf : Noun → Prop) (S : Noun) (ht : Noun → Nat) (D : Bell → Prop) (h : Nat) : Prop :=
  ∀ x NR CR, LoopRest env (RKD SC0 MO0 inl Pf) P S x NR CR →
    ∃ (r : RealCfg) (order : List Noun) (kids : Noun → List Noun) (rk : Ranked (cfgReal r order kids))
      (nout : Noun → NeedOrd),
      (∀ b : Bell, D b → ht b.toNoun < h → r.env.need b = env.need b ∧ r.env.sure b = env.sure b) ∧ CfgOf (cfgReal r order kids) S (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) ∧
      MemGate (cfgReal r order kids)
        (LoopRS (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
        (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
        (fun _ => (cfgReal r order kids).none) (A 0) Mode.may (A 0x79616d) ∧
      (∀ TOP, TopN (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd)).ml TOP →
        MemGate (cfgReal r order kids)
          (LoopRS (cfgReal r order kids).scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x))
          (csiCtx (A 1) (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) S (C CODE (C JETS CALLS)) JH (C NR CR))
          (topOf (cfgReal r order kids) (maySweep (cfgReal r order kids) (St.empty : St Noun NeedOrd))) TOP Mode.must
          (A 0x7473756d)) ∧
      (∀ (s : St Noun NeedOrd), compileSccIn (cfgReal r order kids) false (fuelR (cfgReal r order kids) rk) St.empty
        = some s → ∀ b' : Bell, b'.toNoun ∈ (cfgReal r order kids).scc →
          env.need b' = s.ml b'.toNoun ∧ ∀ v, s.sure b'.toNoun = some v → env.sure b' = v) ∧
      ∀ (st : St Noun NeedOrd) (keep : Bool) (b ML CACHE : Noun), b ∈ r.scc →
        LoopR r.scc (fun _ => []) nout (QK env (RKD SC0 MO0 inl Pf) P S x) st.ml st.sure ML CACHE →
        MemDoneRestSDStr r order kids env SC0 MO0 inl P Pf S x st keep (A 1)
          (kidsOf S (C CODE (C JETS CALLS)) JH (C NR CR)) (A 0) csiBody S CODE (C JETS CALLS) JH (C NR CR) b ML CACHE ht D h

theorem sccLoopData_of_SDStr {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {P Pf : Noun → Prop} {S : Noun} {ht : Noun → Nat} {D : Bell → Prop} {h : Nat}
    (hPS : ∀ k ∈ tapList S, ¬ P k) (hbell : ∀ k ∈ tapList S, ∃ b' : Bell, b'.toNoun = k)
    (hab : Above ht h P Pf) (hS : ∀ k ∈ tapList S, ht k = h)
    (H : SccLoopDataSDStr env SC0 MO0 CODE JETS CALLS JH inl P Pf S ht D h) :
    SccLoopDataDStr env SC0 MO0 CODE JETS CALLS JH inl P Pf S (CCBelowD env SC0 MO0 CODE JETS CALLS JH inl ht D h) := by
  intro x NR CR hx
  obtain ⟨r, order, kids, rk, nout, hre, hcfg, hmay, hmust, henv, hcall⟩ := H x NR CR hx
  exact ⟨r, order, kids, rk, nout, hcfg, hmay, hmust, henv, fun st keep b ML CACHE hb hL hIH =>
    memDoneRest_of_SDStr hre hcfg.scc hPS hbell hab hS hL.1 hIH (hcall st keep b ML CACHE hb hL)⟩

/-- **The table's data of one callee with static calls**: `CalleeHDStr` with `SccLoopDataSDStr`. -/
def CalleeHSDStr (env : CallEnv) (SC0 MO0 CODE JETS CALLS JH : Noun) (inl : Noun → Option Nomm) (ht : Noun → Nat)
    (D : Bell → Prop) (b : Bell) : Prop :=
  OneCalleeA env SC0 CODE CALLS inl b ∨
    ∃ S, getF mugF b.toNoun SC0 = some (C (A 0) S) ∧
      ((∀ n, S ≠ C n (C (A 0) (A 0))) ∨ ∃ n, S = C n (C (A 0) (A 0)) ∧ CalleeIn CALLS n n) ∧
      ∀ P Pf, Above ht (ht b.toNoun) P Pf → SccLoopDataSDStr env SC0 MO0 CODE JETS CALLS JH inl P Pf S ht D (ht b.toNoun)

theorem calleeH_of_SDStr {env : CallEnv} {SC0 MO0 CODE JETS CALLS JH : Noun} {inl : Noun → Option Nomm}
    {ht : Noun → Nat} {D : Bell → Prop} (hsg : SccsGood SC0) (hht : HtScc SC0 ht) {b : Bell}
    (H : CalleeHSDStr env SC0 MO0 CODE JETS CALLS JH inl ht D b) : CalleeHDStr env SC0 MO0 CODE JETS CALLS JH inl ht D b := by
  rcases H with hone | ⟨S, hsc, hnd, hdat⟩
  · exact Or.inl hone
  · refine Or.inr ⟨S, hsc, hnd, fun P Pf hab => ?_⟩
    have hS : ∀ k ∈ tapList S, ht k = ht b.toNoun := hht _ _ hsc
    have hPS : ∀ k ∈ tapList S, ¬ P k := fun k hk hp =>
      Nat.lt_irrefl _ ((hS k hk) ▸ hab.2 k (hab.1 k hp))
    exact sccLoopData_of_SDStr hPS (fun k hk => ((hsg _ _ hsc).2.2 k hk).2) hab hS (hdat P Pf hab)

end Compiler
