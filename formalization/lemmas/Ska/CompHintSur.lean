import lemmas.Ska.CompHintRegKeep
import lemmas.Ska.CompSevenG

/-!
# Kept hints under a general flat goal, and `[7 p q]` with a hinted `p` (README Gaps 24.19)

Generated by `tools/gen/hintsur.py` (do not edit).

The `p` of a `[7 p q]` runs under `%next laz th`, `laz` the result of `q`.
When `laz` has no entries (every dumped `%7` and the 128 shapes of
`CompHintSevenCheck.lean`), that goal is `%next (ofSure sur) th`, `sur` any
sure need, not `lazy-from-reg`.  A kept hint there runs its formula under
`%next (ofSure sur) epil` when `+past-if` emits nothing (`SoundK`: the lock
small, `+sound` of the formula at the need), and then `frameOK_goes` needs
the formula's products to fit `sur`: `FitP`, the promise of `+sound`, a
premise (the check found it true wherever `+sound` holds, and false in 50
shapes where `+sound` fails and `+past-if` parks the need).

* `SurGBT snd lib N env P Ap f nm`: every run under `%next (ofSure sur) th`,
  `sur` with `Ap sur`, its registers allocated, free of conditions, distinct
  and clean, gives `RunOKGBT` at `%next sur th`.  Every member of `LOKSFH`
  is in it for any `Ap` (`SurGBT.of_loksf`).
* `surGBT_n11dKept`: a kept dynamic `stopTag` hint over a member of
  `SurGBT Ap` is in `SurGBT (Ap ∧ SoundK ∧ FitP)` (the text of
  `regGBT_n11dKept`); nested hints stack their conditions.
* `runOKGBT_sevenG`: `[7 p q]` for `RunOKGBT`, `q`'s result without
  entries, `p` at `%next q.sure q.th` (the text of `runOKGC_sevenG`).
* `surSeven_done`, `finishLUCH_contractSurSeven`: `[7 p q]` under `%done`
  with `p` in `SurGBT Ap`, `q` with `DoneAllT`, its result without entries
  and with `Ap` of its sure need; the contract at the top.

The case where `+sound` fails (the formula under a goal whose need is
parked in a bond, filled after the frame is popped) is not covered.
-/

set_option linter.unusedSectionVars false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- `AgreeUB` of a part of the run from the whole's (the text of `AgreeU.part`). -/
theorem AgreeUB.part {lib : Lib} {σ : Type} {O : Oracle σ} {c : Straight Map} {gul : Noun} {st : σ} {t : Trace}
    {cf : Map (Nat × List Nat)} {ned : Need} {g0 g3 ga gb : Gen Map} {L La : Lazy S} {s0 s : Noun}
    (ag : AgreeUB lib O c gul st t cf ned g0 g3 L s0 s) (h0 : g0.bo ≤ ga.bo) (eb : Ext gb g3)
    (hmem : ∀ e ∈ entries La, e ∈ entries L)
    (hout : ∀ k, ga.bo ≤ k → k < gb.bo → k ∈ (entries L).map Prod.fst → k ∈ (entries La).map Prod.fst)
    (hlab : ∀ e ∈ entries La, e.1 < gb.bo) :
    AgreeUB lib O c gul st t cf ned ga gb La s0 s := by
  refine ⟨fun o h0' h1 hn => by
    rw [ag.1 o (Nat.le_trans h0 h0') (Nat.lt_of_lt_of_le h1 eb.2.1) (fun hm => hn (hout o h0' h1 hm)),
      eb.2.2.2 o h1], fun e he => ?_⟩
  obtain ⟨A, B, th, h1, h2, h3⟩ := ag.2 e (hmem e he)
  exact ⟨A, B, th, by rw [← eb.2.2.2 _ (hlab e he)]; exact h1, h2, h3.mono eb.1⟩

/-- **`[7 p q]` with the agreement at every trace, `q`'s result without
entries** (the text of `runOKGC_sevenG` for `RunOKGBT`): `p` at the goal
`%next nx.laz.sure nx.th`, any `RunOKGBT` (a kept hint included). -/
theorem runOKGBT_sevenG {lib : Lib} {N : Needs} {P : Noun → Prop} {f fb fc : Noun} (M : MinkC7 lib P f fb fc)
    {goal : CGoal S} {g0 g1 g2 : Gen Map} {nx nex : NextL S}
    (Rq : RunOKGBT (Map := Map) lib N (Img lib P fb) fc goal g0 g1 nx) (hnx : entries nx.laz = [])
    (Rp : RunOKGBT (Map := Map) lib N P fb (CGoal.next nx.laz.sure nx.th) g1 g2 nex)
    (hg : ∀ r, GMem goal r → r < g0.re) :
    RunOKGBT lib N P f goal g0 g2 nex := by
  have q1 := Rq.ext.1
  have q2 := Rq.ext.2.1
  have p1 := Rp.ext.1
  have p2 := Rp.ext.2.1
  have nxL : ∀ r, NMem nx.laz.sure.ned r → r < g1.re := fun r hr => by
    rcases Rq.regs r hr with h | h
    · have := hg r h; omega
    · exact h.2
  have plab : ∀ e ∈ entries nex.laz, g1.bo ≤ e.1 := fun e he => (Rp.labs e he).1
  -- the `AgreeU` of the parts from the whole's
  have agP : ∀ (cf : Map (Nat × List Nat)) (c : Straight Map) (σ : Type) (O : Oracle σ) (gul : Noun) (st : σ)
      (t : Trace) (ned : Need) (s0 s : Noun), AgreeUB lib O c gul st t cf ned g0 g2 nex.laz s0 s →
      AgreeUB lib O c gul st t cf ned g1 g2 nex.laz s0 s :=
    fun cf c σ O gul st t ned s0 s ag => AgreeUB.part ag q2 (Ext.refl g2) (fun e he => he) (fun k _ _ hk => hk)
      (fun e he => (Rp.labs e he).2.1)
  have agQ : ∀ (cf : Map (Nat × List Nat)) (c : Straight Map) (σ : Type) (O : Oracle σ) (gul : Noun) (st st' : σ)
      (t t' : Trace) (ned : Need) (s0 s u : Noun), AgreeUB lib O c gul st t cf ned g0 g2 nex.laz s0 s →
      AgreeUB lib O c gul st' t' cf ned g0 g1 nx.laz s0 u := by
    intro cf c σ O gul st st' t t' ned s0 s u ag
    refine ⟨fun o h0 h1 _ => ?_, fun e he => by rw [hnx] at he; cases he⟩
    rw [ag.1 o h0 (by omega) (fun hm => by
      obtain ⟨e, he, e1⟩ := List.mem_map.mp hm
      have := plab e he; omega), Rp.ext.2.2.2 o h1]
  -- the registers that `p`'s goal keeps include the whole's
  have hK : ∀ (ned : Need), (∀ x, NMem ned x → g2.re ≤ x) → ∀ x,
      ((x < g0.re ∨ NMem ned x) ∧ ¬ GMem goal x) →
      ((x < g1.re ∨ NMem ned x) ∧ ¬ GMem (CGoal.next nx.laz.sure nx.th) x) := fun ned hned x hx => by
    refine ⟨hx.1.elim (fun h => Or.inl (by omega)) Or.inr, fun hm => ?_⟩
    rcases Rq.regs x hm with h | h
    · exact hx.2 h
    · rcases hx.1 with h' | h'
      · omega
      · have := hned x h'; omega
  refine ⟨Rq.ext.trans Rp.ext, Rq.grow.trans Rp.grow, Rq.cfr.trans Rp.cfr, Rp.lo, Rp.hi, ?_, fun r hr => ?_,
    Rp.dist, fun e he => ⟨(Rp.eregs e he).1, fun r hr => ?_⟩,
    fun e he => ⟨by have := (Rp.labs e he).1; omega, (Rp.labs e he).2⟩, Rp.nodup, fun s hs hf => ?_, Rp.ncond,
    Rp.econd, ?_, ?_⟩
  · -- ent
    rcases Rp.ent with fr | e
    · exact Or.inl fr
    · have e' : nex.th = nx.th := e
      rw [e']
      rcases Rq.ent with fr | e2
      · exact Or.inl (fr.growU Rq.hi Rp.grow)
      · exact Or.inr e2
  · -- regs
    rcases Rp.regs r hr with h | h
    · rcases Rq.regs r h with h' | h'
      · exact Or.inl h'
      · exact Or.inr ⟨h'.1, by omega⟩
    · exact Or.inr ⟨by omega, h.2⟩
  · -- eregs
    obtain ⟨h1, h2⟩ := (Rp.eregs e he).2 r hr
    refine ⟨?_, h2⟩
    rcases h1 with h | h
    · rcases Rq.regs r h with h' | h'
      · exact Or.inl h'
      · exact Or.inr h'.1
    · exact Or.inr (by omega)
  · -- nec
    obtain ⟨N1, N2⟩ := Rp.nec s hs hf
    refine ⟨fun gul n tm r hm => ?_, fun gul tm => ?_⟩
    · obtain ⟨n1, _, rb, hb, h | ⟨u, rfl, n2, _, hc⟩⟩ := M.fwd hs hm
      · obtain ⟨hn, hr⟩ := h
        rw [hr]
        rcases N1 gul n1 tm rb hb with e | ⟨q, e, _⟩
        · exact Or.inl e
        · exact absurd e (hn q)
      · rcases N1 gul n1 tm _ hb with e | ⟨q, e, hq⟩
        · cases e
        · cases e
          exact (Rq.nec u (img_of hs hb) hq).1 gul n2 tm r hc
    · obtain ⟨rb, hb, hbad⟩ := N2 gul tm
      rcases hbad with e | ⟨u, rfl, hq⟩
      · subst e
        exact ⟨_, (M.bwd hs hb).1 (fun _ e => by cases e), Or.inl rfl⟩
      · obtain ⟨r, hr, hbr⟩ := (Rq.nec u ⟨s, gul, hs, mink_nil_of_mink_zero hb⟩ hq).2 gul tm
        exact ⟨r, (M.bwd hs hb).2 u r rfl hr, hbr⟩
  · -- forward
    intro cf hcf c ned σ Inv ν O n gul hN hS hF st t tm s0 s r hI htr hs hm ag hned regs hh hn
    have hcf1 : ∀ k, k < g1.re → HoonMap.get cf k = HoonMap.get g1.cond k := fun k hk' =>
      (hcf k (by omega)).trans (Rp.cfr.get_lt hk')
    obtain ⟨n1, h1, rb, hb, hr⟩ := M.fwd hs hm
    have Gp := Rp.sem cf hcf c ned σ Inv ν O n1 gul hN hS (oracleFwd_le hF h1) st t tm s0 s rb hI htr hs hb
      (fun st' t' => agP cf c σ O gul st' t' ned s0 s (ag st' t')) hned regs hh hn
    rcases hr with ⟨hnz, rfl⟩ | ⟨u, rfl, n2, h2, hc⟩
    · exact goalSemCM_ret goal _ hnz (returnsC_of_goalSemCM _ _ hnz Gp)
    by_cases fit : FitsS nx.laz.sure u
    · obtain ⟨st', R1, hI', hν, h1', k1, e1⟩ := Gp.1 fit
      have hn1 : HoldsN ned R1 s0 := HoldsN.agree ned (fun x hx => k1 x ⟨Or.inr hx, fun hm => by
        have := nxL x hm; have := hned x hx; omega⟩) hn
      have Gq := Rq.sem cf hcf1 c ned σ Inv ν O n2 gul hN hS (oracleFwd_le hF h2) st' t tm s0 u r hI'
        (frames_mono hν htr) (img_of hs hb) hc (fun st'' t'' => agQ cf c σ O gul st st'' t t'' ned s0 s u (ag st t))
        (fun x hx => by have := hned x hx; omega) R1 ⟨h1', fit.2⟩ hn1
      exact goalSemCM_step hν (fun x hx => k1 x (hK ned hned x hx)) e1 goal r Gq
    · exact goalSemCM_of_badC ((Rq.nec u (img_of hs hb) fit).1 gul n2 tm r hc) (Gp.2 fit)
  · -- backward
    intro cf hcf c ned σ Inv ν O gul hN hS hB st t tm s0 s hI htr hs ag hned regs hh hn res hres
    have hcf1 : ∀ k, k < g1.re → HoonMap.get cf k = HoonMap.get g1.cond k := fun k hk' =>
      (hcf k (by omega)).trans (Rp.cfr.get_lt hk')
    obtain ⟨rb, hb, Gp⟩ := Rp.semB cf hcf c ned σ Inv ν O gul hN hS hB st t tm s0 s hI htr hs
      (fun st' t' => agP cf c σ O gul st' t' ned s0 s (ag st' t')) hned regs hh hn res hres
    cases rb with
    | one q =>
      exact ⟨_, (M.bwd hs hb).1 (fun _ e => by cases e),
        goalSemCM_ret goal _ (fun _ e => by cases e) (returnsC_of_goalSemCM _ _ (fun _ e => by cases e) Gp)⟩
    | two t' =>
      exact ⟨_, (M.bwd hs hb).1 (fun _ e => by cases e),
        goalSemCM_ret goal _ (fun _ e => by cases e) (returnsC_of_goalSemCM _ _ (fun _ e => by cases e) Gp)⟩
    | zero u =>
      have hu : Img lib P fb u := ⟨s, gul, hs, mink_nil_of_mink_zero hb⟩
      by_cases fit : FitsS nx.laz.sure u
      · obtain ⟨st', R1, hI', hν, h1', k1, e1⟩ := Gp.1 fit
        have hn1 : HoldsN ned R1 s0 := HoldsN.agree ned (fun x hx => k1 x ⟨Or.inr hx, fun hm => by
          have := nxL x hm; have := hned x hx; omega⟩) hn
        obtain ⟨r, hr, Gq⟩ := Rq.semB cf hcf1 c ned σ Inv ν O gul hN hS hB st' t tm s0 u hI' (frames_mono hν htr) hu
          (fun st'' t'' => agQ cf c σ O gul st st'' t t'' ned s0 s u (ag st t)) (fun x hx => by have := hned x hx; omega)
          R1 ⟨h1', fit.2⟩ hn1 res (by rw [← e1]; exact hres)
        exact ⟨r, (M.bwd hs hb).2 u r rfl hr, goalSemCM_step hν (fun x hx => k1 x (hK ned hned x hx)) e1 goal r Gq⟩
      · obtain ⟨r, hr, hbad⟩ := (Rq.nec u hu fit).2 gul tm
        exact ⟨r, (M.bwd hs hb).2 u r rfl hr, goalSemCM_of_badC hbad (Gp.2 fit)⟩

section Frame
variable {σ : Type} {lib : Lib} {O : Oracle σ} {c : Straight Map} {gul : Noun} {Inv : σ → Prop} {ν : σ → Needs}

/-- **The frame part, the fit asked of the formula's tone only** (the text
of `frameOK_goes`): what `+sound` promises is about the products of the
formula, not about every noun. -/
theorem frameOK_goesR {tag toke : Nat} {body : Noun} {prol o epil : Nat} {th : Jmp} (F : FrameOK c tag toke body prol o epil th)
    {sur : Sure S} {r : Tone} (hfit : ∀ p, r = Tone.zero p → FitsS sur p) {K : Nat → Prop} {st : σ} {regs : Map (Option Noun)} {v : Noun}
    (hv : SkaModel.read toke regs = some v) {t tm : Trace}
    (G : GoalSemCM lib O c gul Inv ν K st regs ((tag, v) :: t) ((tag, v) :: tm) (jmp0 o) (CGoal.next sur (jmp0 epil)) r) :
    GoalSemCM lib O c gul Inv ν K st regs t tm (jmp0 prol) (CGoal.next sur th) r := by
  have epush : ∀ st regs, SkaModel.read toke regs = some v →
      goJ lib O c gul st regs t (jmp0 prol) = goJ lib O c gul st regs ((tag, v) :: t) (jmp0 o) :=
    fun st regs h => goJ_push F.1 F.2.1 st regs h t
  have epop : ∀ st regs, goJ lib O c gul st regs ((tag, v) :: t) (jmp0 epil) = goJ lib O c gul st regs t th :=
    fun st regs => goJ_pop F.1 F.2.2 st regs (tag, v) t
  cases r with
  | zero p =>
    refine ⟨fun hf => ?_, fun hf => absurd (hfit p rfl) hf⟩
    obtain ⟨st', regs', hI, hle, hh, hk, e⟩ := G.1 hf
    exact ⟨st', regs', hI, hle, hh, hk, by rw [epush st regs hv, e, epop]⟩
  | one b =>
    obtain ⟨ton, st', hI, hle, e, hrel⟩ := G
    exact ⟨ton, st', hI, hle, by rw [epush st regs hv]; exact e, hrel⟩
  | two tr =>
    obtain ⟨ton, st', hI, hle, e, hrel⟩ := G
    exact ⟨ton, st', hI, hle, by rw [epush st regs hv]; exact e, hrel⟩

end Frame

/-! ## The class -/

/-- The test of `+past-if` that emits nothing: the lock small, `+sound` of
the formula at the need. -/
def SoundK (snd : Nomm → NeedOrd → Bool) (q : Nomm) (sur : Sure S) : Prop :=
  HoonSet.small sur.lok = true ∧ snd q (needToOrd sur.ned) = true

/-- **The promise of `+sound`**: every product of `f` on a subject of `P`,
at any trace, fits `sur`. -/
def FitP (lib : Lib) (P : Noun → Prop) (f : Noun) (sur : Sure S) : Prop :=
  ∀ s, P s → ∀ gul tm p, Mink lib gul tm s f (Tone.zero p) → FitsS sur p

/-- **Runs under a general flat goal**: every run under `%next (ofSure sur)
th`, for `sur` with `Ap sur`, its registers allocated and free of
conditions, gives `RunOKGBT` at `%next sur th`. -/
def SurGBT (snd : Nomm → NeedOrd → Bool) (lib : Lib) (N : Needs) (env : CallEnv) (P : Noun → Prop)
    (Ap : Sure S → Prop) (f : Noun) (nm : Nomm) : Prop :=
  ∀ {sup : Option Nomm} {sur : Sure S} {th : Jmp} {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S},
    Ap sur → 1 ≤ g0.bo → g0.drop = false → UpBelow g0 → Clear g0 → CondBelow g0 →
    1 ≤ th.there → th.there < g0.bo → th.args = [] → Distinct sur.ned → Clean sur.ned →
    (∀ x, NMem sur.ned x → x < g0.re ∧ HoonMap.get g0.cond x = Option.none) →
    runLCH (S := S) (Map := Map) env snd true sup nm (CGoalL.next (ofSure sur) th) region g0 = some (nex, g1) →
    RunOKGBT lib N P f (CGoal.next sur th) g0 g1 nex

section Kept
variable {snd : Nomm → NeedOrd → Bool}

/-- **A member of `LOKSFH` is in `SurGBT`**, for any `Ap` (`RunOKLB.toGB`,
`RunOKGB.toT`; the text of `RegGBT.of_loksf`). -/
theorem SurGBT.of_loksf {lib : Lib} {N : Needs} {env : CallEnv} {P : Noun → Prop} {f : Noun} {nm : Nomm}
    (Ap : Sure S → Prop) (H : LOKSFH (S := S) (Map := Map) (snd := snd) lib N env P f nm) (hc : sixCount nm ≤ 255) :
    SurGBT (S := S) (Map := Map) snd lib N env P Ap f nm := by
  intro sup sur th region g0 g1 nex _ b0 d0 hu hcl hcb th1 th2 hta hsd hcs hsl hr
  have e0 : entries (ofSure sur : Lazy S) = [] := entries_ofSure _
  obtain ⟨⟨Q, RS⟩, -, -, -, -⟩ := H.run (sup := sup) (L := ofSure sur) (th := th) (region := region)
    (Or.inr e0) hc b0 d0 hu hcl hcb th1 th2 hta (by rw [e0]; simp) hsd hsl
    (fun e he => by rw [e0] at he; cases he) (by rw [e0]; simp) (fun e he => by rw [e0] at he; cases he)
    (flat_ofSure _) hcs (fun e he => by rw [e0] at he; cases he) hr
  exact (RS.toRunOKLB.toGB (fun x hx => (hsl x hx).1)).toT

/-- The run of a kept dynamic hint under `%next (ofSure sur) th` when
`+past-if` emits nothing (the text of `runLCH_n11d_kept_next`). -/
theorem runLCH_n11d_kept_sur {env : CallEnv} {tag : Nat} (hs : hintDynamic tag = true) {h q : Nomm} {body : Noun}
    {sur : Sure S} (hp : HoonSet.small sur.lok = true ∧ snd q (needToOrd sur.ned) = true) {sup : Option Nomm} {th : Jmp} {region : List Nat}
    {g0 g1 : Gen Map} {nex : NextL S}
    (hr : runLCH env snd true sup (Nomm.n11d tag h q body) (CGoalL.next (ofSure sur) th) region g0 =
      some (nex, g1)) :
    ∃ nq gc nh gh, runLCH env snd true sup q (CGoalL.next (ofSure sur) (jmp0 g0.bo)) region
        (genN g0 tag body th) = some (nq, gc) ∧
      nq.th.args = [] ∧
      runLCH env snd true sup h (CGoalL.next (ofSure (lazyReg g0.re)) (jmp0 (gc.bo + 1))) region
        (((gc.emitted ⟨[], [], Termin.hop nq.th⟩).tagged gc.bo region).emitted
          ⟨[], [Pole.hdp tag g0.re body], Termin.hop (jmp0 gc.bo)⟩) = some (nh, gh) ∧
      copyL nh (mk Sure.bunt [] [(gc.bo, nq.laz)]) gh = some (nex, g1) := by
  simp only [runLCH, hs, Bool.not_true, Bool.false_eq_true, ↓reduceIte] at hr
  obtain ⟨n0, ga, h0, hr⟩ := bind_some hr
  simp only [simpleNextL, pure_apply, Option.some.injEq, Prod.mk.injEq] at h0
  obtain ⟨rfl, rfl⟩ := h0
  obtain ⟨n1, gb, h1, hr⟩ := bind_some hr
  have hp' : HoonSet.small (ofSure sur : Lazy S).sure.lok = true ∧
      snd q (needToOrd (ofSure sur : Lazy S).sure.ned) = true := hp
  unfold pastIfL at h1
  rw [if_pos hp'] at h1
  simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h1
  obtain ⟨rfl, rfl⟩ := h1
  obtain ⟨tk, gt, ht, hr⟩ := bind_some hr
  rw [re_apply] at ht
  simp only [Option.some.injEq, Prod.mk.injEq] at ht
  obtain ⟨rfl, rfl⟩ := ht
  obtain ⟨ep, gb', h2, hr⟩ := bind_some hr
  rw [emit_apply] at h2
  simp only [Option.some.injEq, Prod.mk.injEq] at h2
  obtain ⟨rfl, rfl⟩ := h2
  obtain ⟨nq, gc, h3, hr⟩ := bind_some hr
  obtain ⟨nb, gd, h4, hr⟩ := bind_some hr
  have hta : nq.th.args = [] := by
    cases hne : nq.th.args with
    | nil => rfl
    | cons a l =>
      unfold lazyBound at h4
      simp [bind_apply, emit_apply, setTag_apply, hne] at h4
  rw [lazyBound_apply hta] at h4
  simp only [Option.some.injEq, Prod.mk.injEq] at h4
  obtain ⟨rfl, rfl⟩ := h4
  obtain ⟨pr, ge, h5, hr⟩ := bind_some hr
  rw [emit_apply] at h5
  simp only [Option.some.injEq, Prod.mk.injEq] at h5
  obtain ⟨rfl, rfl⟩ := h5
  obtain ⟨nh, gh, h6, hr⟩ := bind_some hr
  refine ⟨nq, gc, nh, gh, ?_, hta, ?_, hr⟩
  · simpa only [genN, Gen.emitted] using h3
  · simpa only [Gen.emitted, tagged_bo] using h6

/-- **A kept dynamic `stopTag` hint over a member of `SurGBT A` is in
`SurGBT (A ∧ SoundK ∧ FitP)`** (the text of `regGBT_n11dKept`, the goal
`%next (ofSure sur) th`, the fit of `frameOK_goesR` from `FitP`). -/
theorem surGBT_n11dKept {lib : Lib} {N : Needs} {env : CallEnv} {P : Noun → Prop} {fh fq : Noun} {h q : Nomm}
    {Ap : Sure S → Prop} (Hq : SurGBT (S := S) (Map := Map) snd lib N env P Ap fq q)
    (Hh : LOKSFH (S := S) (Map := Map) (snd := snd) lib N env P fh h) (hch : sixCount h ≤ 255)
    (hnh : NoBondH (S := S) (Map := Map) snd env h)
    {tag : Nat} (hs : hintDynamic tag = true) (hst : stopTag tag = true) (body : Noun) :
