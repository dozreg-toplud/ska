        (sixBlkNT_fwd Ra (fun y hy => by have := (r01 y (Or.inl hy)).2; omega) hN hSt
          (oracleFwd_le hFw (Nat.le_of_lt hn')) hcfQ (by omega) hned hs yesB agA' hth hok.1 hbarg hob0 l0 cp0 ujs0
