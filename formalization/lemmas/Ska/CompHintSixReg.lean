        (sixBlkNT_fwd Rb (fun y hy => (r01 y (Or.inr hy)).2) hN hSt
          (oracleFwd_le hFw (Nat.le_of_lt hn')) hcfR (by omega) hned hs nuhB agB' hth hok.1 hbarg hob1 l1 cp1 ujs1
