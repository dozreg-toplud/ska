open Nock Compiler Laze

/-- A set as a list without repeats. -/
structure RL where
  l : List Nat

instance : HoonSet RL where
  empty := ⟨[]⟩
  toList s := s.l
  put s x := if x ∈ s.l then s else ⟨s.l ++ [x]⟩
  uni a b := ⟨a.l ++ b.l.filter (fun x => x ∉ a.l)⟩
  isEmpty s := s.l.isEmpty
  small s := s.l.all (· == 1)
  toNoun _ := A 0
  mem_empty x := by simp
  mem_put s x y := by
    show y ∈ (if x ∈ s.l then s else (⟨s.l ++ [x]⟩ : RL)).l ↔ y = x ∨ y ∈ s.l
    by_cases h : x ∈ s.l
    · simp only [h, if_true]
      constructor
      · exact Or.inr
      · rintro (rfl | h')
        · exact h
        · exact h'
    · simp only [h, if_false, List.mem_append, List.mem_singleton]
      exact Or.comm
  mem_uni a b y := by
    show y ∈ a.l ++ b.l.filter (fun x => x ∉ a.l) ↔ _
    simp only [List.mem_append, List.mem_filter, decide_eq_true_eq]
    by_cases h : y ∈ a.l <;> simp [h]
  isEmpty_iff s := by simp [List.isEmpty_iff]
  small_iff s := by simp
  toNoun_empty := rfl

/-- A sorted list as a noun. -/
def sortN (l : List Nat) : Noun := listNoun A ((l.eraseDups).mergeSort (fun a b => decide (a ≤ b)))

mutual
/-- The noun of a `laze` with its sets sorted. -/
def normN : Laze RL → Noun
  | mk s f b => C (C s.ned.toNoun (sortN s.lok.l)) (C (normF f) (normB b))
def normF : List ((Nat × Laze RL) × (Nat × Laze RL)) → Noun
  | [] => A 0
  | ((oy, ly), (on, ln)) :: rest => C (C (C (A oy) (normN ly)) (C (A on) (normN ln))) (normF rest)
def normB : List (Nat × Laze RL) → Noun
  | [] => A 0
  | (o, l) :: rest => C (C (A o) (normN l)) (normB rest)
end


def bellA : Bell := (⟨Sock.mk Cape.no (A 0), (C (A 0) (A 2))⟩ : Bell)
def bellB : Bell := (⟨Sock.mk Cape.no (A 0), (C (A 0) (A 3))⟩ : Bell)
def bellC : Bell := (⟨Sock.mk Cape.no (A 0), (C (A 0) (A 6))⟩ : Bell)
def bellD : Bell := (⟨Sock.mk Cape.no (A 0), (C (A 0) (A 7))⟩ : Bell)
def bellE : Bell := (⟨Sock.mk (Cape.cell Cape.yes Cape.no) (C (A 5) (A 0)), (C (A 0) (A 14))⟩ : Bell)
/-- The environment of the driver. -/
def rsEnv : ShapeEnv where
  need b := if b = bellA then some (NeedOrd.pair NeedOrd.this NeedOrd.none) else if b = bellB then some (NeedOrd.both NeedOrd.this NeedOrd.none) else if b = bellC then some NeedOrd.none else if b = bellD then some NeedOrd.this else if b = bellE then some (NeedOrd.pair NeedOrd.none (NeedOrd.pair NeedOrd.this NeedOrd.this)) else Option.none
  sure b := if b = bellA then NeedOrd.this else if b = bellB then NeedOrd.none else if b = bellC then NeedOrd.none else if b = bellD then NeedOrd.none else if b = bellE then (NeedOrd.pair NeedOrd.none NeedOrd.this) else NeedOrd.none
  jet _ := false
  pure b := if b = bellA then some true else if b = bellB then some false else if b = bellC then some true else if b = bellD then some true else if b = bellE then some false else Option.none
  cod b := if b = bellA then some (Nomm.cons (Nomm.n0 2) (Nomm.n0 3)) else if b = bellB then some (Nomm.n0 6) else if b = bellC then some (Nomm.n1 (A 5)) else if b = bellD then some (Nomm.n0 1) else if b = bellE then some (Nomm.cons (Nomm.n0 6) (Nomm.n0 7)) else Option.none

/-- The output: the laze with sorted sets, `id-gen`, `sofs` sorted. -/
def rsOut (o : Option (Laze RL × RSt RL)) : Option (Noun × Nat × Noun) :=
  o.map fun (l, st) => (normN l, st.idg, sortN st.sofs.l)

