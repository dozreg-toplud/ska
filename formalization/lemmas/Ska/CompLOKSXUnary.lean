/-- **`[3 p]` meets `ApartS`**: where the goal asks nothing the operand runs
under the goal itself (its `ApartS`), and else under a goal with no entry. -/
theorem apartS_three (env : CallEnv) {p : Nomm} {lib : Lib} {N : Needs} {P : Noun → Prop} {fb : Noun}
    (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p) (Ap : ApartS (S := S) (Map := Map) env p) :
    ApartS (S := S) (Map := Map) env (Nomm.n3 p) := by
  intro sup L th region g0 g1 nex hcount b0 d0 hu hcl0 hcb h1 h2 hta ht hsd hsl hlab hnd hed hfl hcs hce hr
  have hc : sixCount p ≤ 255 := by simpa only [sixCount] using hcount
  rw [runLC_n3_next] at hr
  by_cases en : noneEquivalentL L = true
  · rw [if_pos en] at hr
    exact Ap hc b0 d0 hu hcl0 hcb h1 h2 hta ht hsd hsl hlab hnd hed hfl hcs hce hr
  rw [if_neg en] at hr
  obtain ⟨a, gA, hc2, h⟩ := bind_some hr
  rcases a with _ | ⟨r, o⟩
  · cases h
  have CP := collapsePre_spec (r := r) (there := o) hc2 rfl d0 hcb (fun x hx => (hsl x hx).1)
    (fun x hx => (hsl x hx).2) (List.nodup_cons.mpr ⟨ht, hnd⟩)
    (fun e he => ⟨(hlab e he).1, by obtain ⟨B, th'', hb⟩ := (hlab e he).2; exact ⟨B, _, hb⟩⟩)
    (fun e he x hx => ((hed e he).2 x hx).1)
  obtain ⟨⟨z, o'⟩, g3, h3, h⟩ := bind_some h
  have c1 := CP.le
  have c2 := CP.bo1
  have hth' : 1 ≤ o ∧ o < gA.bo := by
    rcases CP.shape with ⟨e, eb, -⟩ | ⟨e, eb, -⟩ <;> (rw [e]; omega)
  obtain ⟨E23, r3, b3, -⟩ := forl_ok h3 CP.rlt
  have Fd := forl_down h3 hth'.1 hth'.2 (by omega)
  have c3 : g3.cond = gA.cond := (kc_forl r o).keep gA _ g3 h3
  have d2 : gA.drop = false := CP.drop.trans d0
  have d3 : g3.drop = false := E23.2.2.1.trans d2
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  obtain ⟨g4, hg4⟩ : ∃ g4 : Gen Map, g4 = { g3 with re := g3.re + 1 } := ⟨_, rfl⟩
  obtain ⟨blk, hblk⟩ : ∃ blk : Blob, blk = ⟨[], [], Termin.clq g3.re (jmp0 z) (jmp0 o')⟩ := ⟨_, rfl⟩
  obtain ⟨gE, hgE⟩ : ∃ gE : Gen Map, gE = g4.emitted blk := ⟨_, rfl⟩
  have hbo4 : g4.bo = g3.bo := by rw [hg4]
  have hre4 : g4.re = g3.re + 1 := by rw [hg4]
  have hcn4 : g4.cond = g3.cond := by rw [hg4]
  have hdr4 : g4.drop = false := by rw [hg4]; exact d3
  rw [← hg4, ← hblk, ← hgE] at h
  have hboE : gE.bo = g3.bo + 1 := by rw [hgE, emitted_bo, hbo4]
  have hreE : gE.re = g3.re + 1 := by rw [hgE, emitted_re, hre4]
  have hcnE : gE.cond = g3.cond := by rw [hgE, ← hcn4]; rfl
  have hdE : gE.drop = false := by rw [hgE, emitted_drop]; exact hdr4
  have hbE : HoonMap.get gE.blocks g3.bo = some blk := by rw [hgE, ← hbo4]; exact emitted_get g4 blk hdr4
  have G3E : Grow g3 gE := by
    have g34 : Grow g3 g4 := by rw [hg4]; exact grow_re g3
    have g4E : Grow g4 gE := by
      rw [hgE]; refine grow_emit ?_
      rw [hblk, hbo4]; exact jumpsBelow_two rfl Fd.2.1 Fd.2.2
    exact g34.trans g4E
  have GUA : GrowU g0 gA := CP.grow.toU hu
  have huA : UpBelow gA := GUA.up hu
  have GU : GrowU gA gE := (Fd.1.trans G3E).toU huA
  have E3E : Ext g3 gE := by rw [hgE, hg4]; exact (ext_re _).trans (ext_emit _ _)
  have cbA : CondBelow gA := CP.pfor.1.below hcb
  have cbE : CondBelow gE := fun x hx => by rw [hcnE, c3] at hx; have := cbA x hx; omega
  have eR : entries (ofSure (lazyReg g3.re : Sure S)) = [] := entries_ofSure _
  obtain ⟨⟨Qp, Rp⟩, pne, pj, pfl, pec⟩ := Sp.run (sup := sup) (L := ofSure (lazyReg g3.re)) (th := jmp0 g3.bo)
    (region := region) (Or.inr eR) hc (by omega) hdE (GU.up huA)
    ((hcl0.growU GUA).growU GU) cbE
    (by simp only [jmp0]; omega) (by simp only [jmp0]; omega) rfl (by rw [eR]; simp) trivial
    (fun x hx => by
      simp only [lazyReg, ofSure, NMem] at hx; subst hx
      exact ⟨by omega, by rw [hcnE, c3]; exact condBelow_none cbA (by omega)⟩)
    (fun e he => by rw [eR] at he; cases he) (by rw [eR]; simp) (fun e he => by rw [eR] at he; cases he)
    (flat_ofSure _) trivial (fun e he => by rw [eR] at he; cases he) h

  refine apart_of_new fun e1 he1 hl => ?_
  obtain ⟨e, he, el⟩ := List.mem_map.mp hl
  rcases (Rp.labs e1 he1).1 with h0 | h0
  · rw [eR] at h0; cases h0
  · have := (hlab e he).1; have := CP.bo1; omega

/-- **The indirect call meets `ApartS`**: its result is the inner pair's,
run under a goal with no entry. -/
theorem apartS_indirect (env : CallEnv) {p q : Nomm} {lib : Lib} {N : Needs} {P : Noun → Prop} {f fb fc : Noun}
    (M : MinkC2 lib P f fb fc) (hfb : ∃ a b, fb = C a b)
    (Kp : (p.pure = true ∧ MinkEq lib P fb p) ∨ hinted env.cod p = some true)
    (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p) (Sq : LOKSF (S := S) (Map := Map) lib N env P fc q) :
    ApartS (S := S) (Map := Map) env (Nomm.n2 p q Option.none) := by
  intro sup L th region g0 g1 nex hcount b0 d0 hu hcl0 hcb h1 h2 hta ht hsd hsl hlab hnd hed hfl hcs hce hr
  obtain ⟨nex0, g1', out, pro, g2, o, g3, nexF, g4, nexF', g5, nexS, g6, k1, k2, k3, k4, k5, k6, k7⟩ :=
    runLC_n2_none hr
  simp only [simpleNextL, pure_apply, Option.some.injEq, Prod.mk.injEq] at k1
  obtain ⟨rfl, rfl⟩ := k1
  have hlab' : ∀ e ∈ entries L, e.1 < g0.bo ∧ ∃ B fin, HoonMap.get g0.blocks e.1 = some ⟨[], B, fin⟩ :=
    fun e he => ⟨(hlab e he).1, by obtain ⟨_, B, th', hb⟩ := hlab e he; exact ⟨B, _, hb⟩⟩
  have hk2 := k2
  obtain ⟨rfl, rfl, b2, dr2, l2, PF, G2, -, -, -, c0, -⟩ := kerf_specL k2 d0 hcb hu h1 h2 hlab' hnd
  have d2 : g2.drop = false := dr2.trans d0
  have u2 : UpBelow g2 := G2.up hu
  have cl2 : Clear g2 := hcl0.growU G2
  have cb2 : CondBelow g2 := PF.1.below hcb
  have hc : sixCount p ≤ 255 ∧ sixCount q ≤ 255 := by simp only [sixCount] at hcount; omega
  -- the `%nok` block (as `indirectC_inner`)
  rw [emit_apply] at k3
  simp only [Option.some.injEq, Prod.mk.injEq] at k3
  obtain ⟨rfl, rfl⟩ := k3
  have nk : ∀ x, g2.re ≤ x → HoonMap.get g2.cond x = Option.none := fun x hx => condBelow_none cb2 hx
  have eb3 : ∀ k, HoonMap.get ({ { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 }.emitted
      ⟨[], [Pole.nok g2.re (g2.re + 1) g0.re], Termin.hop (jmp0 g0.bo)⟩).blocks k =
      if k = g2.bo then some ⟨[], [Pole.nok g2.re (g2.re + 1) g0.re], Termin.hop (jmp0 g0.bo)⟩ else
        HoonMap.get g2.blocks k := fun k => by
    simp only [Gen.emitted, d2, Bool.false_eq_true, ↓reduceIte, HoonMap.get_put]
  have G0 := growU_emit (g := { { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 })
    (b := ⟨[], [Pole.nok g2.re (g2.re + 1) g0.re], Termin.hop (jmp0 g0.bo)⟩)
    (fun j hj => by
      simp only [finJumps, List.mem_singleton] at hj; subst hj; simp only [jmp0]; exact ⟨b0, (by omega)⟩) u2
  have G3 : GrowU g2 ({ { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 }.emitted
      ⟨[], [Pole.nok g2.re (g2.re + 1) g0.re], Termin.hop (jmp0 g0.bo)⟩) := ⟨G0.bo, G0.drop, G0.keep, G0.new⟩
  generalize hg3 : ({ { g2 with re := g2.re + 1 } with re := g2.re + 1 + 1 }.emitted
      ⟨[], [Pole.nok g2.re (g2.re + 1) g0.re], Termin.hop (jmp0 g0.bo)⟩ : Gen Map) = g3 at G3 eb3 k4
  have r3 : g3.re = g2.re + 2 := by rw [← hg3]; simp [Gen.emitted]
  have b3 : g3.bo = g2.bo + 1 := by rw [← hg3]; simp [Gen.emitted]
  have d3 : g3.drop = false := by rw [← hg3]; simp [Gen.emitted, d2]
  have cn3 : g3.cond = g2.cond := by rw [← hg3]; simp [Gen.emitted]
  have k3o : HoonMap.get g3.blocks g2.bo = some ⟨[], [Pole.nok g2.re (g2.re + 1) g0.re], Termin.hop (jmp0 g0.bo)⟩ := by
    rw [eb3, if_pos rfl]
  have E3 : Ext g2 g3 := ⟨by omega, by omega, by rw [d3, d2], fun k hk => by rw [eb3, if_neg (by omega)]⟩
  have u3 : UpBelow g3 := G3.up u2
  have cl3 : Clear g3 := cl2.growU G3
  have cb3 : CondBelow g3 := fun k hk => by rw [cn3] at hk; have := cb2 k hk; omega
  have e3 : ∀ (r : Nat), entries (ofSure (lazyReg r : Sure S)) = [] := fun r => entries_ofSure _
  -- the formula part `q`
  obtain ⟨⟨Qt, Rq⟩, -, -, fq, cqE⟩ := Sq.run (sup := sup) (region := region)
    (L := ofSure (lazyReg (g2.re + 1))) (th := jmp0 g2.bo) (Or.inr (entries_ofSure _)) hc.2 (by omega) d3 u3 cl3 cb3
    (by simp only [jmp0]; omega) (by simp only [jmp0]; omega) rfl (by rw [e3]; simp) trivial
    (fun x hx => by
      simp only [ofSure, sure_mk, lazyReg, NMem] at hx; subst hx
      exact ⟨by omega, by rw [cn3]; exact nk _ (by omega)⟩)
    (fun e he => by rw [e3] at he; cases he) (by rw [e3]; simp) (fun e he => by rw [e3] at he; cases he)
    (flat_ofSure _) trivial (fun e he => by rw [e3] at he; cases he) k4
  -- its `+past` behind `p`
  have tcase : (nexF' = nexF ∧ g5 = g4 ∧ ((∀ s, FitsS nexF.laz.sure s) ∨ TotalC lib P fb)) ∨
      (nexF' = ⟨Lazy.mk Sure.bunt [] ((g4.bo, Lazy.mk nexF.laz.sure nexF.laz.fork []) :: nexF.laz.bond),
          jmp0 g4.bo⟩ ∧
        g5 = (g4.emitted ⟨[], [], Termin.hop nexF.th⟩).tagged g4.bo region) := by
    rcases Kp with ⟨pp, Mp⟩ | hp
    · rw [pastL_pure _ _ pp, pure_apply] at k5
      simp only [Option.some.injEq, Prod.mk.injEq] at k5
      exact Or.inl ⟨k5.1.symm, k5.2.symm, Or.inr (totalC_of_minkEq Mp)⟩
    · rcases pastL_hinted hp k5 with ⟨x1, x2, en, es, _⟩ | ⟨x1, x2⟩
      · exact Or.inl ⟨x1, x2, Or.inl (fun x => fitsS_trivial en es x)⟩
      · exact Or.inr ⟨x1, x2⟩
  have Rq' : RunOKLS (Map := Map) lib N P fc (ofSure (lazyReg (g2.re + 1))) (jmp0 g2.bo) Qt false g3 g5 nexF' := by
    rcases tcase with ⟨rfl, rfl, -⟩ | ⟨rfl, rfl⟩
    · exact Rq
    · exact Rq.past (fun r hr => by simp only [ofSure, sure_mk, lazyReg, NMem] at hr; subst hr; omega)
        (fun e he => by rw [e3] at he; cases he) rfl (Rq.drop.trans d3) (Rq.grow.up u3) region
  have fq' : Flat nexF'.laz ∧ (∀ e ∈ entries nexF'.laz, Clean e.2.sure.ned) ∧ Clean nexF'.laz.sure.ned ∧
      ((∀ s, FitsS nexF'.laz.sure s) ∨ TotalC lib P fb) := by
    rcases tcase with ⟨rfl, rfl, hf⟩ | ⟨rfl, rfl⟩
    · exact ⟨fq, cqE, Sq.clean (L := ofSure (lazyReg (g2.re + 1))) trivial k4, hf⟩
    · have fl : Flat (Lazy.mk (Sure.bunt : Sure S) [] ((g4.bo, Lazy.mk nexF.laz.sure nexF.laz.fork []) ::
          nexF.laz.bond)) := flat_mk (fun e he => by
        rcases List.mem_cons.mp he with rfl | he
        · show Lazy.mk nexF.laz.sure nexF.laz.fork [] = ofSure nexF.laz.sure
          rw [fq.1]; rfl
        · exact fq.2 e he)
      refine ⟨fl, fun e he => ?_, trivial, Or.inl (fun s => fitsS_bunt s)⟩
      rw [entries_flat fl] at he
      rcases List.mem_cons.mp he with rfl | he
      · exact Sq.clean (L := ofSure (lazyReg (g2.re + 1))) trivial k4
      · exact cqE e (by rw [entries_flat fq]; exact he)
  have d5 : g5.drop = false := Rq'.drop.trans d3
  have u5 : UpBelow g5 := Rq'.grow.up u3
  have cl5 : Clear g5 := cl3.growU Rq'.grow
  have cb5 : CondBelow g5 := Rq'.cfr.below cb3
  have r5 := Rq'.re
  have bo5 := Rq'.bo
  -- the subject part `p`
  obtain ⟨⟨Qh, Rp⟩, -, -, fp, cpE⟩ := Sp.run (sup := sup) (region := region)
    (L := ofSure (lazyReg g2.re)) (th := nexF'.th) (Or.inr (entries_ofSure _)) hc.1 (by omega) d5 u5 cl5 cb5 Rq'.lo Rq'.hi
    (nextArgs_nil Rq'.ent rfl) (by rw [e3]; simp) trivial
    (fun x hx => by
      simp only [ofSure, sure_mk, lazyReg, NMem] at hx; subst hx
      exact ⟨by omega, by rw [Rq'.cfr.get_lt (by omega), cn3]; exact nk _ (Nat.le_refl _)⟩)
    (fun e he => by rw [e3] at he; cases he) (by rw [e3]; simp) (fun e he => by rw [e3] at he; cases he)
    (flat_ofSure _) trivial (fun e he => by rw [e3] at he; cases he) k6
  -- the copy and the pair
  obtain ⟨n, g3', r, hcp, hM, rfl⟩ := copyL_flat' fp fq'.1 k7
  have nfit : ∀ (x y : Noun), ¬ (¬ FitsS (ofSure (lazyReg g2.re : Sure S)).sure x ∨
      ¬ FitsS (ofSure (lazyReg (g2.re + 1) : Sure S)).sure y) :=
    fun x y h => h.elim (fun h => h (fitsS_lazyReg _ x)) (fun h => h (fitsS_lazyReg _ y))
  have hrg : ∀ x, NMem (ofSure (pairReg g2.re : Sure S)).sure.ned x → x = g2.re ∨ x = g2.re + 1 := fun x hx => by
    simpa only [ofSure, sure_mk, pairReg, NMem] using hx
  obtain ⟨R, hth, eth, fR, cR, lR⟩ := pairLS_ok (Fin := fun _ _ _ x y r => r = Tone.zero (C x y))
    (FinB := fun _ _ x y r => r = Tone.zero (C x y)) (L := ofSure (pairReg g2.re)) (th := jmp0 g2.bo)
    (hed := ofSure (lazyReg g2.re)) (tel := ofSure (lazyReg (g2.re + 1))) (o := g2.bo) (PB := fun _ => [])
    (fun _ hm => minkF_consG hfb hm) (fun _ hh => mink_consG_bwd (ft := fc) hfb hh)
    (fun _ _ _ _ _ _ h => h) (fun _ _ _ _ _ h => h)
    (flat_ofSure _) (by simp [ofSure])
    (fun x hx => by rcases hrg x hx with rfl | rfl <;> (rw [cn3]; exact nk _ (by omega)))
    (fun e he => by simp [ofSure] at he)
    ⟨⟨trivial, trivial, fun x a b => by simp only [NMem] at a b; omega⟩,
      fun x hx => by rcases hrg x hx with rfl | rfl <;> omega⟩
    (Ext.refl g3) (GrowU.refl g3) rfl cb3
    (fun r hr => by simp only [ofSure, sure_mk, lazyReg, NMem] at hr; subst hr; exact Or.inl (Or.inl rfl))
    (fun r hr => by simp only [ofSure, sure_mk, lazyReg, NMem] at hr; subst hr; exact Or.inl (Or.inr rfl))
    (fun r a b => by simp only [ofSure, sure_mk, lazyReg, NMem] at a b; omega)
    (Pref.refl g3) (fun _ _ => rfl) (flat_ofSure _) (flat_ofSure _) (fun e he => by simp [ofSure] at he)
    (fun e he => by simp [ofSure] at he) (fun e he => by simp [ofSure] at he) (by simp [ofSure]) (by simp [ofSure])
    (Ext.refl g3) (GrowU.refl g3) rfl rfl
    (Or.inl ⟨rfl, rfl, Or.inl (fun x => fitsS_lazyReg _ x)⟩) fq'.2.2.2
    Rq' Rp fq'.1 fp fq'.2.1 cpE fq'.2.2.1 (Sp.clean (L := ofSure (lazyReg g2.re)) trivial k6) hcp hM u3 d3
    (fun cf _ k h0 h1' => absurd h1' (by omega))
    (fun _ _ _ x y r hn hr => absurd hn (nfit x y)) (fun _ _ x y hn => absurd hn (nfit x y))
    (fun c hc σ Inv ν O n gul hS hF st' regs t tm x y n' r _ hI htr fx fy hx hy hr => by
      subst hr
      exact ⟨fun _ => ⟨st', regs, hI, Needs.le_refl _, ⟨hx, hy⟩, fun _ _ => rfl, rfl⟩,
        fun nf => absurd (fitsS_pairReg _ x y) nf⟩)
    (fun c hc σ Inv ν O gul hS hB st' regs t tm x y hI htr fx fy hx hy res _ =>
      ⟨_, rfl, ⟨fun _ => ⟨st', regs, hI, Needs.le_refl _, ⟨hx, hy⟩, fun _ _ => rfl, rfl⟩,
        fun nf => absurd (fitsS_pairReg _ x y) nf⟩⟩)
  have eP : entries (ofSure (pairReg g2.re : Sure S)) = [] := entries_ofSure _
  refine apart_of_new fun e1 he1 hl => ?_
  obtain ⟨e, he, el⟩ := List.mem_map.mp hl
  rcases (R.labs e1 he1).1 with h0 | h0
  · rw [eP] at h0; cases h0
  · have := (hlab e he).1; omega

/-- **`[5 p q]` meets `ApartS`**: its result is the inner pair's, run under
a goal with no entry, in both cases of the goal. -/
theorem apartS_five (env : CallEnv) {p q : Nomm} {lib : Lib} {N : Needs} {P : Noun → Prop} {f fb fc : Noun}
    (M : MinkC5 lib P f fb fc) (hfb : ∃ a b, fb = C a b)
    (Kp : (p.pure = true ∧ MinkEq lib P fb p) ∨ hinted env.cod p = some true)
    (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p) (Sq : LOKSF (S := S) (Map := Map) lib N env P fc q) :
    ApartS (S := S) (Map := Map) env (Nomm.n5 p q) := by
  intro sup L th region g0 g1 nex hcount b0 d0 hu hcl0 hcb h1 h2 hta ht hsd hsl hlab hnd hed hfl hcs hce hr
  have hc : sixCount p ≤ 255 ∧ sixCount q ≤ 255 := by simp only [sixCount] at hcount; omega
  obtain ⟨o, gE, nexF, g4, nexF', g5, nexS, g6, hE, k4, k5, k6, k7⟩ := runLC_n5_split hr
  obtain ⟨g0', hg0'⟩ : ∃ g : Gen Map, g = { { g0 with re := g0.re + 1 } with re := g0.re + 1 + 1 } := ⟨_, rfl⟩
  rw [← hg0'] at hE
  have r0' : g0'.re = g0.re + 2 := by rw [hg0']
  have b0' : g0'.bo = g0.bo := by rw [hg0']
  have c0' : g0'.cond = g0.cond := by rw [hg0']
  have d0' : g0'.drop = false := by rw [hg0']; exact d0
  have bl0' : g0'.blocks = g0.blocks := by rw [hg0']
  have cb0' : CondBelow g0' := fun k hk => by rw [c0'] at hk; have := hcb k hk; omega
  have nk0 : ∀ x, g0.re ≤ x → HoonMap.get g0.cond x = Option.none := fun x hx => condBelow_none hcb hx
  obtain ⟨a, gA, hc2, hE⟩ := bind_some hE
  by_cases en : noneEquivalentL L = true
  · -- the goal asks nothing: the block `[equ r-p r-q] hop th`
    rw [collapseL_noneEq hta en, pure_apply] at hc2
    simp only [Option.some.injEq, Prod.mk.injEq] at hc2
    obtain ⟨rfl, rfl⟩ := hc2
    simp only [if_pos hta, emit_apply, Option.some.injEq, Prod.mk.injEq] at hE
    obtain ⟨rfl, rfl⟩ := hE
    obtain ⟨blk, hblk⟩ : ∃ blk : Blob, blk = ⟨[], [Pole.equ g0.re (g0.re + 1)], Termin.hop (jmp0 th.there)⟩ :=
      ⟨_, rfl⟩
    rw [← hblk, b0'] at k4
    have reE : (g0'.emitted blk).re = g0.re + 2 := by rw [emitted_re, r0']
    have boE : (g0'.emitted blk).bo = g0.bo + 1 := by rw [emitted_bo, b0']
    have cnE : (g0'.emitted blk).cond = g0.cond := by rw [← c0']; rfl
    have dE : (g0'.emitted blk).drop = false := by rw [emitted_drop]; exact d0'
    have kE : HoonMap.get (g0'.emitted blk).blocks g0.bo = some blk := by rw [← b0']; exact emitted_get g0' blk d0'
    have E0 : Ext g0 g0' := by rw [hg0']; exact (ext_re _).trans (ext_re _)
    have EE : Ext g0 (g0'.emitted blk) := E0.trans (ext_emit _ _)
    have G0 : Grow g0 (g0'.emitted blk) := by
      have g00 : Grow g0 g0' := by rw [hg0']; exact (grow_re _).trans (grow_re _)
      exact g00.trans (grow_emit (by rw [hblk, b0']; exact jumpsBelow_hop (j := jmp0 th.there) h1 h2))
    have GU : GrowU g0 (g0'.emitted blk) := G0.toU hu
    obtain ⟨⟨Qp, Rp⟩, pne, pj, pfl, pec⟩ := pairRun_ok (a := g0.re) (o := g0.bo) lib env hfb Kp Sp Sq hc b0
      (by omega) dE (GU.up hu) (hcl0.growU GU) (fun k hk => by rw [cnE] at hk; have := hcb k hk; omega)
      (by omega) (by rw [cnE]; exact nk0 _ (Nat.le_refl _)) (by rw [cnE]; exact nk0 _ (by omega)) k4 k5 k6 k7
    have eP : entries (ofSure (pairReg g0.re : Sure S)) = [] := entries_ofSure _
    refine apart_of_new fun e1 he1 hl => ?_
    obtain ⟨e, he, el⟩ := List.mem_map.mp hl
    rcases (Rp.labs e1 he1).1 with h0 | h0
    · rw [eP] at h0; cases h0
    · have := (hlab e he).1; omega
  · -- the collapse, `+forl`, the block `[eqq r-p r-q z o']`
    have en' : noneEquivalentL L = false := by simpa using en
    rcases a with _ | ⟨r, o0⟩
    · exact absurd (collapseL_isSome hc2 en') (by simp)
    have CP0 := collapsePre_spec (r := r) (there := o0) hc2 rfl d0' cb0' (fun x hx => by have := (hsl x hx).1; omega)
      (fun x hx => by rw [c0']; exact (hsl x hx).2) (List.nodup_cons.mpr ⟨ht, hnd⟩)
      (fun e he => ⟨by rw [b0']; exact (hlab e he).1, by
        obtain ⟨B, th'', hb⟩ := (hlab e he).2; exact ⟨B, _, by rw [bl0']; exact hb⟩⟩)
      (fun e he x hx => by have := ((hed e he).2 x hx).1; omega)
    have CP : CollPre L th g0 gA r o0 := CollPre.lower (k := g0.re + 1 + 1) (by omega) (by subst hg0'; exact CP0)
    have c1 := CP0.le
    have c2 := CP.bo1
    obtain ⟨⟨z, o'⟩, g3, h3, hE⟩ := bind_some hE
    simp only [emit_apply, Option.some.injEq, Prod.mk.injEq] at hE
    obtain ⟨rfl, rfl⟩ := hE
    obtain ⟨blk, hblk⟩ : ∃ blk : Blob, blk = ⟨[], [], Termin.eqq g0.re (g0.re + 1) (jmp0 z) (jmp0 o')⟩ := ⟨_, rfl⟩
    rw [← hblk] at k4
    have hth' : 1 ≤ o0 ∧ o0 < gA.bo := by
      rcases CP.shape with ⟨e, eb, -⟩ | ⟨e, eb, -⟩ <;> (rw [e]; omega)
    obtain ⟨E23, r3, b3, -⟩ := forl_ok h3 CP.rlt
    have Fd := forl_down h3 hth'.1 hth'.2 (by omega)
    have c3 : g3.cond = gA.cond := (kc_forl r o0).keep gA _ g3 h3
    have d2 : gA.drop = false := CP.drop.trans d0
    have d3 : g3.drop = false := E23.2.2.1.trans d2
    have reE : (g3.emitted blk).re = g3.re := by rw [emitted_re]
    have boE : (g3.emitted blk).bo = g3.bo + 1 := by rw [emitted_bo]
    have cnE : (g3.emitted blk).cond = g3.cond := rfl
    have dE : (g3.emitted blk).drop = false := by rw [emitted_drop]; exact d3
    have kE : HoonMap.get (g3.emitted blk).blocks g3.bo = some blk := emitted_get g3 blk d3
    have G3E : Grow g3 (g3.emitted blk) := grow_emit (by rw [hblk]; exact jumpsBelow_two rfl Fd.2.1 Fd.2.2)
    have GUA : GrowU g0 gA := CP.grow.toU hu
    have huA : UpBelow gA := GUA.up hu
    have GU : GrowU gA (g3.emitted blk) := (Fd.1.trans G3E).toU huA
    have E3E : Ext g3 (g3.emitted blk) := ext_emit _ _
    have cbA : CondBelow gA := CP.pfor.1.below hcb
    have cbE : CondBelow (g3.emitted blk) := fun x hx => by rw [cnE, c3] at hx; have := cbA x hx; omega
    have hak : ∀ k, k < g0.re + 2 → HoonMap.get gA.cond k = HoonMap.get g0.cond k := fun k hk => by
      rw [CP0.pfor.1.get_lt (by omega), c0']
    obtain ⟨⟨Qp, Rp⟩, pne, pj, pfl, pec⟩ := pairRun_ok (a := g0.re) (o := g3.bo) lib env hfb Kp Sp Sq hc
      (by omega) (by omega) dE (GU.up huA) ((hcl0.growU GUA).growU GU) cbE (by omega)
      (by rw [cnE, c3, hak _ (by omega)]; exact nk0 _ (Nat.le_refl _))
      (by rw [cnE, c3, hak _ (by omega)]; exact nk0 _ (by omega)) k4 k5 k6 k7
    have eP : entries (ofSure (pairReg g0.re : Sure S)) = [] := entries_ofSure _
    refine apart_of_new fun e1 he1 hl => ?_
    obtain ⟨e, he, el⟩ := List.mem_map.mp hl
    rcases (Rp.labs e1 he1).1 with h0 | h0
    · rw [eP] at h0; cases h0
    · have := (hlab e he).1; omega

theorem lokSX_four (lib : Lib) {N : Needs} (env : CallEnv) {p : Nomm} {P : Noun → Prop} {f fb : Noun}
    (M : MinkC4 lib P f fb) (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p) :
    LOKSX (S := S) (Map := Map) true lib N env P f (Nomm.n4 p) :=
  (lokS_four lib env M Sp).toX (apartS_four env Sp)

theorem lokSX_three (lib : Lib) {N : Needs} (env : CallEnv) {p : Nomm} {P : Noun → Prop} {f fb : Noun}
    (M : MinkC3 lib P f fb) (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p)
    (Ap : ApartS (S := S) (Map := Map) env p) :
    LOKSX (S := S) (Map := Map) true lib N env P f (Nomm.n3 p) :=
  (lokS_three lib env M Sp).toX (apartS_three env Sp Ap)

theorem lokSX_indirectF (lib : Lib) {N : Needs} (env : CallEnv) {p q : Nomm} {P : Noun → Prop} {f fb fc : Noun}
    (M : MinkC2 lib P f fb fc) (hfb : ∃ a b, fb = C a b)
    (Kp : (p.pure = true ∧ MinkEq lib P fb p) ∨ hinted env.cod p = some true)
    (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p) (Sq : LOKSF (S := S) (Map := Map) lib N env P fc q) :
    LOKSX (S := S) (Map := Map) false lib N env P f (Nomm.n2 p q Option.none) :=
  (lokS_indirectF lib env M hfb Kp Sp Sq).toX (apartS_indirect env M hfb Kp Sp Sq)

theorem lokSX_five (lib : Lib) {N : Needs} (env : CallEnv) {p q : Nomm} {P : Noun → Prop} {f fb fc : Noun}
    (M : MinkC5 lib P f fb fc) (hfb : ∃ a b, fb = C a b)
    (Kp : (p.pure = true ∧ MinkEq lib P fb p) ∨ hinted env.cod p = some true)
    (Sp : LOKSF (S := S) (Map := Map) lib N env P fb p) (Sq : LOKSF (S := S) (Map := Map) lib N env P fc q) :
    LOKSX (S := S) (Map := Map) true lib N env P f (Nomm.n5 p q) :=
  (lokS_five lib env M hfb Kp Sp Sq).toX (apartS_five env M hfb Kp Sp Sq)

