import lemmas.Ska.CompWhole
import lemmas.Ska.CompCollapseGate
import lemmas.Ska.CompUnproxyBelow

/-!
# `+kern` over a whole lazy tree

README Gaps 12.10.  `+kern o laz` (the end of `+kerf`, and of the
whole-subject version `finishLU`) allocates one register `r` and walks the
lazy need: at the block `o` the ops of `+kern-need` from `r` into
`+sure-require-look` of the sure need, at every other lazy block the same
from a fresh proxy for `r`.

* `kernBoth_split`, `kernLoop_head`: the source register of `+kern-need`
  appears in its first op only (`[%mov src d]`), so the ops from a proxy,
  renamed, are the ops from `r` (`kernLoop_ren`).
* `KernP r cond`: what the ops at one block do, for the `cond` of the end of
  the walk: their source unproxies to `r`, the other registers allocated at
  that block are no keys of `cond`, and the ops renamed by any `u` that
  agrees with `unproxy cond` below the end fill the block's need from `r`.
* `kernGate_ok`: the gate meets it, from a state whose keys of `cond` lie
  below `re` (`CondBelow`).  `walkLazy_okDI`: `walkLazy_okD` with an
  invariant of the states (here `CondBelow`), which the gate needs.
* `kern_spec`: `+kern` over the whole tree.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map]

/-! ## The source of `+kern-need` -/

/-- The ops of `kernBoth` before its last `[%mov r d]`. -/
def kernPre (d : Nat) (kh kt : Nat → List Pole → CM Map (List Pole)) (ops : List Pole) :
    CM Map (List Pole) := do
  let rt ← re
  let ops1 ← kt rt ops
  let ops := if ops1 ≠ ops then Pole.tal d rt :: ops1 else ops1
  let rh ← re
  let ops1 ← kh rh ops
  let ops := if ops1 ≠ ops then Pole.hed d rh :: ops1 else ops1
  pure (Pole.cel d :: ops)

theorem kernBoth_split (r d : Nat) (kh kt : Nat → List Pole → CM Map (List Pole)) (ops : List Pole) :
    (kernBoth r d kh kt ops : CM Map (List Pole)) =
      (kernPre d kh kt ops >>= fun o => if r = d then crashM else pure (Pole.mov r d :: o)) := by
  simp only [kernBoth, kernPre, bind_assoc, pure_bind]

/-- **The source of `+kern-need` is read by its first op only.** -/
theorem kernLoop_head (tgt : Need) (a b : Nat) (acc : List Pole) (g g' : Gen Map) (ops : List Pole)
    (h : kernLoop a tgt acc g = some (ops, g')) (hb : ¬ NMem tgt b) (hbg : b < g.re) :
    (tgt = Need.none ∧ ops = acc ∧ kernLoop b tgt acc g = some (acc, g')) ∨
    ∃ d rest, ops = Pole.mov a d :: rest ∧ kernLoop b tgt acc g = some (Pole.mov b d :: rest, g') := by
  cases tgt with
  | none =>
    simp only [kernLoop, pure_apply, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact Or.inl ⟨rfl, rfl, rfl⟩
  | this d =>
    simp only [kernLoop] at h ⊢
    by_cases e : a = d
    · rw [if_pos e] at h; cases h
    rw [if_neg e] at h
    simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    have nb : b ≠ d := fun e' => hb e'
    exact Or.inr ⟨d, acc, rfl, by rw [if_neg nb]; rfl⟩
  | pair p q =>
    simp only [kernLoop] at h ⊢
    obtain ⟨rn, g1, h1, h⟩ := bind_some h
    rw [re_apply] at h1
    simp only [Option.some.injEq, Prod.mk.injEq] at h1
    obtain ⟨rfl, rfl⟩ := h1
    rw [kernBoth_split] at h
    obtain ⟨o, g2, h2, h3⟩ := bind_some h
    by_cases e : a = g.re
    · rw [if_pos e] at h3; cases h3
    rw [if_neg e] at h3
    simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h3
    obtain ⟨rfl, rfl⟩ := h3
    refine Or.inr ⟨g.re, o, rfl, ?_⟩
    rw [bind_apply, re_apply, Option.bind_some]
    simp only
    rw [kernBoth_split, bind_apply, h2, Option.bind_some, if_neg (by omega)]
    rfl
  | both d hh tt =>
    simp only [kernLoop] at h ⊢
    rw [kernBoth_split] at h ⊢
    obtain ⟨o, g2, h2, h3⟩ := bind_some h
    by_cases e : a = d
    · rw [if_pos e] at h3; cases h3
    rw [if_neg e] at h3
    simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h3
    obtain ⟨rfl, rfl⟩ := h3
    have nb : b ≠ d := fun e' => hb (Or.inl e')
    refine Or.inr ⟨d, o, rfl, ?_⟩
    rw [bind_apply, h2, Option.bind_some, if_neg nb]
    rfl

/-! ## The registers of `+kern-need`, bounded (generated by `tools/gen/kernlt.py`) -/

/-- `kernBoth_regs` with the fresh registers below the end's `re`. -/
theorem kernBoth_lt (P : Nat → Prop) {r d : Nat} {kh kt : Nat → List Pole → CM Map (List Pole)}
    (sh : ∀ r' acc (g g' : Gen Map) ops, kh r' acc g = some (ops, g') → g.re ≤ g'.re ∧
      (P r' → (∀ x, g.re ≤ x → x < g'.re → P x) → RegsIn P acc → RegsIn P ops))
    (st : ∀ r' acc (g g' : Gen Map) ops, kt r' acc g = some (ops, g') → g.re ≤ g'.re ∧
      (P r' → (∀ x, g.re ≤ x → x < g'.re → P x) → RegsIn P acc → RegsIn P ops))
    {acc : List Pole} {g g' : Gen Map} {ops : List Pole} (hk : kernBoth r d kh kt acc g = some (ops, g')) :
    g.re ≤ g'.re ∧ (P r → P d → (∀ x, g.re ≤ x → x < g'.re → P x) → RegsIn P acc → RegsIn P ops) := by
  unfold kernBoth at hk
  obtain ⟨rt, g1, h1, hk⟩ := bind_some hk
  rw [re_apply] at h1
  simp only [Option.some.injEq, Prod.mk.injEq] at h1
  obtain ⟨rfl, rfl⟩ := h1
  obtain ⟨o1, g2, h2, hk⟩ := bind_some hk
  obtain ⟨le2, R2⟩ := st _ _ _ _ _ h2
  obtain ⟨rh, g3, h3, hk⟩ := bind_some hk
  rw [re_apply] at h3
  simp only [Option.some.injEq, Prod.mk.injEq] at h3
  obtain ⟨rfl, rfl⟩ := h3
  obtain ⟨o2, g4, h4, hk⟩ := bind_some hk
  obtain ⟨le4, R4⟩ := sh _ _ _ _ _ h4
  simp only at le2 le4
  by_cases e : r = d
  · rw [if_pos e] at hk; cases hk
  rw [if_neg e] at hk
  simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at hk
  obtain ⟨rfl, rfl⟩ := hk
  refine ⟨by omega, fun hr hd hg ha => ?_⟩
  have hg1 : ∀ x, g.re + 1 ≤ x → x < g2.re → P x := fun x hx hx' => hg x (by omega) (by omega)
  have hg3 : ∀ x, g2.re + 1 ≤ x → x < g4.re → P x := fun x hx hx' => hg x (by omega) hx'
  have A2 : RegsIn P o1 := R2 (hg g.re (Nat.le_refl _) (by omega)) hg1 ha
  have A2' : RegsIn P (if o1 ≠ acc then Pole.tal d g.re :: o1 else o1) := by
    split
    · exact RegsIn.cons (p := Pole.tal d g.re) (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with hx | hx
        · rw [hx]; exact hd
        · rw [hx]; exact hg _ (Nat.le_refl _) (by omega)) A2
    · exact A2
  have A4 := R4 (hg g2.re (by omega) (by omega)) hg3 A2'
  have A4' : RegsIn P (Pole.cel d :: if o2 ≠ (if o1 ≠ acc then Pole.tal d g.re :: o1 else o1) then
      Pole.hed d g2.re :: o2 else o2) := by
    refine RegsIn.cons (p := Pole.cel d) (fun x hx => by simp only [poleRegs, List.mem_singleton] at hx; rw [hx]; exact hd) ?_
    by_cases e2 : o2 ≠ (if o1 ≠ acc then Pole.tal d g.re :: o1 else o1)
    · rw [if_pos e2]
      exact RegsIn.cons (p := Pole.hed d g2.re) (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with hx | hx
        · rw [hx]; exact hd
        · rw [hx]; exact hg _ (by omega) (by omega)) A4
    · rw [if_neg e2]; exact A4
  refine RegsIn.cons (p := Pole.mov r d) (fun x hx => ?_) A4'
  simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
  rcases hx with hx | hx
  · rw [hx]; exact hr
  · rw [hx]; exact hd

/-- **`kernLoop_regs` with the fresh registers below the end's `re`.** -/
theorem kernLoop_lt (P : Nat → Prop) : ∀ (tgt : Need) (r : Nat) (acc : List Pole) (g g' : Gen Map)
    (ops : List Pole), kernLoop r tgt acc g = some (ops, g') →
      P r → (∀ x, NMem tgt x → P x) → (∀ x, g.re ≤ x → x < g'.re → P x) → RegsIn P acc → RegsIn P ops := by
  intro tgt
  induction tgt with
  | none =>
    intro r acc g g' ops h _ _ _ ha
    simp only [kernLoop, pure_apply, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ha
  | this d =>
    intro r acc g g' ops h hr ht _ ha
    simp only [kernLoop] at h
    by_cases e : r = d
    · rw [if_pos e] at h; cases h
    rw [if_neg e] at h
    simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    refine RegsIn.cons (p := Pole.mov r d) (fun x hx => ?_) ha
    simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
    rcases hx with hx | hx
    · rw [hx]; exact hr
    · rw [hx]; exact ht _ rfl
  | pair p q ihp ihq =>
    intro r acc g g' ops h hr ht hg ha
    simp only [kernLoop] at h
    obtain ⟨rn, g1, h1, h⟩ := bind_some h
    rw [re_apply] at h1
    simp only [Option.some.injEq, Prod.mk.injEq] at h1
    obtain ⟨rfl, rfl⟩ := h1
    exact (kernBoth_lt P
      (fun r' acc g g' ops h => ⟨(kernLoop_spec p r' acc g g' ops h).choose_spec.2.le,
        fun a b c => ihp r' acc g g' ops h a (fun x hx => ht x (Or.inl hx)) b c⟩)
      (fun r' acc g g' ops h => ⟨(kernLoop_spec q r' acc g g' ops h).choose_spec.2.le,
        fun a b c => ihq r' acc g g' ops h a (fun x hx => ht x (Or.inr hx)) b c⟩)
      h).2 hr (hg _ (Nat.le_refl _) (by
        have := (kernBoth_lt P (fun r' acc g g' ops h => ⟨(kernLoop_spec p r' acc g g' ops h).choose_spec.2.le,
          fun a b c => ihp r' acc g g' ops h a (fun x hx => ht x (Or.inl hx)) b c⟩)
          (fun r' acc g g' ops h => ⟨(kernLoop_spec q r' acc g g' ops h).choose_spec.2.le,
          fun a b c => ihq r' acc g g' ops h a (fun x hx => ht x (Or.inr hx)) b c⟩) h).1
        simp only at this; omega))
        (fun x hx hx' => hg x (by simp only at hx; omega) hx') ha
  | both d h t ihh iht =>
    intro r acc g g' ops hk hr ht hg ha
    simp only [kernLoop] at hk
    exact (kernBoth_lt P
      (fun r' acc g g' ops h' => ⟨(kernLoop_spec h r' acc g g' ops h').choose_spec.2.le,
        fun a b c => ihh r' acc g g' ops h' a (fun x hx => ht x (Or.inr (Or.inl hx))) b c⟩)
      (fun r' acc g g' ops h' => ⟨(kernLoop_spec t r' acc g g' ops h').choose_spec.2.le,
        fun a b c => iht r' acc g g' ops h' a (fun x hx => ht x (Or.inr (Or.inr hx))) b c⟩)
      hk).2 hr (ht d (Or.inl rfl)) hg ha

/-- **The ops of `+kern-need` from `src`, renamed by a `u` that sends `src`
to `r` and fixes the rest, are the ops from `r`.** -/
theorem kernLoop_ren {tgt : Need} {src r : Nat} {g g' : Gen Map} {A : List Pole}
    (h : kernLoop src tgt [] g = some (A, g')) (hr : ¬ NMem tgt r) (hrg : r < g.re)
    {u : Nat → Nat} (us : u src = r) (ur : u r = r) (ut : ∀ x, NMem tgt x → u x = x)
    (uf : ∀ x, g.re ≤ x → x < g'.re → u x = x) :
    kernLoop r tgt [] g = some (A.map (renPole u), g') := by
  rcases kernLoop_head tgt src r [] g g' A h hr hrg with ⟨_, rfl, e⟩ | ⟨d, rest, rfl, e⟩
  · simpa using e
  · have R := kernLoop_lt (fun x => x = r ∨ NMem tgt x ∨ (g.re ≤ x ∧ x < g'.re)) tgt r [] g g' _ e (Or.inl rfl)
      (fun x hx => Or.inr (Or.inl hx)) (fun x hx hx' => Or.inr (Or.inr ⟨hx, hx'⟩)) (RegsIn.nil _)
    have uP : ∀ x, (x = r ∨ NMem tgt x ∨ (g.re ≤ x ∧ x < g'.re)) → u x = x := fun x hx => by
      rcases hx with rfl | hx | ⟨hx, hx'⟩
      · exact ur
      · exact ut x hx
      · exact uf x hx hx'
    have hd : u d = d := uP d (R _ List.mem_cons_self d (by simp [poleRegs]))
    have hrest : rest.map (renPole u) = rest := renOps_fix uP (fun p hp => R p (List.mem_cons_of_mem _ hp))
    rw [e]
    simp only [List.map_cons, renPole, us, hd, hrest]

/-! ## The gate of `+kern` -/

/-- The gate that `+kern` walks the lazy need with (`kern` of
`CompLazyRun.lean`, line 5071 of the Hoon). -/
def kernGate (r o : Nat) : Nat → Sure S → CM Map Unit := fun oLaz sur => do
  let ned ← sureRequireLook sur
  if ned = Need.none then pure () else do
  let src ← (if oLaz = o then pure r else proxy r oLaz : CM Map Nat)
  if noSoft oLaz then fun _ => Option.none else do
  let ops ← kernNeed src ned
  addOps oLaz ops

theorem kern_eq (o : Nat) (laz : Lazy S) :
    (kern o laz : CM Map Nat) = (do
      let r ← re
      let g ← get
      if g.drop then pure r else do
        walkLazy (kernGate r o) o laz
        pure r) := rfl

/-- What ops do that fill the need of `sur` from `r`. -/
def KernSemS (sur : Sure S) (r lo : Nat) (A : List Pole) : Prop :=
  ∀ (lib : Lib) (σ : Type) (O : Oracle σ) (c : Straight Map) (gul : Noun) (st : σ) (t : Trace)
    (R : Map (Option Noun)) (v : Noun), SkaModel.read r R = some v →
    (FitsS sur v → ∃ R', Runs lib O c gul st t A R R' ∧ HoldsS sur R' v ∧
        ∀ x, x < lo → ¬ NMem sur.ned x → SkaModel.read x R' = SkaModel.read x R) ∧
    (¬ FitsS sur v → Crashes lib O c gul st t A R)

/-- **What the ops of the gate at one block do**, for the registers
`[lo, hi)` the gate allocated: the source unproxies to `r` by `cond`, the
other registers of the range are no keys of `cond`, and the ops renamed by
any `u` that agrees with `unproxy cond` below `hi` fill the need of `sur`
from `r`. -/
def KernQ (r : Nat) (cond : Map (Nat × List Nat)) (lo hi : Nat) (sur : Sure S) (ops : List Pole) : Prop :=
  ∃ src, (src = r ∨ (lo ≤ src ∧ src < hi ∧ unproxy cond src = r)) ∧
    (∀ x, lo ≤ x → x < hi → x ≠ src → HoonMap.get cond x = Option.none) ∧
    (r < lo → Distinct sur.ned → (∀ x, NMem sur.ned x → x < r) →
      ∀ u : Nat → Nat, u r = r → (∀ x, NMem sur.ned x → u x = x) → (∀ x, x < hi → u x = unproxy cond x) →
        KernSemS (Map := Map) sur r lo (ops.map (renPole u)))

/-- `KernQ` within a wider range. -/
def KernP (r : Nat) (cond : Map (Nat × List Nat)) (lo hi : Nat) (_o : Nat) (sur : Sure S) (ops : List Pole) :
    Prop :=
  ∃ lo0 hi0, lo ≤ lo0 ∧ hi0 ≤ hi ∧ KernQ r cond lo0 hi0 sur ops

theorem kernP_mono (r : Nat) : PMonoD (KernP (S := S) (Map := Map) r) := by
  intro c c' lo hi lo' hi' o s A h hc hl hh
  obtain ⟨lo0, hi0, l0, h0, src, hs, hk, hsem⟩ := h
  have uc : ∀ x, x < hi0 → unproxy c' x = unproxy c x := fun x hx => by
    simp only [unproxy, hc x (Nat.lt_of_lt_of_le hx h0)]
  refine ⟨lo0, hi0, Nat.le_trans hl l0, Nat.le_trans h0 hh, src, ?_, fun x a b e => ?_, ?_⟩
  · rcases hs with e | ⟨a, b, e⟩
    · exact Or.inl e
    · exact Or.inr ⟨a, b, by rw [uc src b, e]⟩
  · rw [hc x (Nat.lt_of_lt_of_le b h0)]; exact hk x a b e
  · intro a b d u ur us uu
    exact hsem a b d u ur us fun x hx => (uu x hx).trans (uc x hx)

/-- A gate that needs the invariant `I` of the state it starts from. -/
def GateOKDI (C : Gen Map → Gen Map → Prop) (I : Gen Map → Prop)
    (P : Map (Nat × List Nat) → Nat → Nat → Nat → Sure S → List Pole → Prop)
    (f : Nat → Sure S → CM Map Unit) : Prop :=
  ∀ (o : Nat) (l : Lazy S) (g g' : Gen Map), f o l.sure g = some ((), g') → g.drop = false → I g →
    WalkOKD C P g g' [(o, l)]

/-- **The gate of `+kern`**: from a state whose keys of `cond` lie below
`re`, it puts the ops of `KernP r` at the one block it is given and makes
proxies for `r` only. -/
theorem kernGate_ok (r o : Nat) :
    GateOKDI (ProxyFor r) CondBelow (KernP (S := S) (Map := Map) r) (kernGate (S := S) (Map := Map) r o) := by
  intro oL l g g' h hd hI
  unfold kernGate at h
  obtain ⟨ned, g1, h1, h2⟩ := bind_some h
  have L := sureRequireLook_spec h1
  obtain ⟨kk, e1⟩ := L.gen
  subst e1
  have pf1 : ProxyFor r g { g with re := kk } := ProxyFor.of_eq L.le rfl
  have nk : ∀ x, g.re ≤ x → HoonMap.get g.cond x = Option.none := fun x hx => by
    cases e : HoonMap.get g.cond x with
    | none => rfl
    | some _ => have := hI x (by simp [e]); omega
  have lk : g.re ≤ kk := L.le
  by_cases en : ned = Need.none
  · rw [if_pos en] at h2
    simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h2
    obtain ⟨-, rfl⟩ := h2
    subst en
    refine ⟨rfl, rfl, L.le, pf1, fun _ _ => rfl, fun e he => ?_⟩
    simp only [List.mem_singleton] at he
    subst he
    refine ⟨[], fun B fin hb => by simpa using hb, g.re, kk, Nat.le_refl _, Nat.le_refl _, r, Or.inl rfl,
      fun x hx _ _ => nk x hx, ?_⟩
    intro _ _ _ u _ _ _ lib σ O c gul st t R v _
    exact ⟨fun _ => ⟨R, Runs.nil R, holdsS_of_sure L trivial, fun _ _ _ => rfl⟩,
      fun nf => absurd ((fits_sure L v).mp trivial) nf⟩
  rw [if_neg en] at h2
  obtain ⟨src, g2, hs, h3⟩ := bind_some h2
  -- the source: `r` at the block `o`, a fresh proxy elsewhere
  have SRC : g2.blocks = g.blocks ∧ g2.drop = g.drop ∧ g2.bo = g.bo ∧ ProxyFor r { g with re := kk } g2 ∧
      kk ≤ g2.re ∧ g2.re ≤ kk + 1 ∧ (src = r ∨ (src = kk ∧ g2.re = kk + 1 ∧ unproxy g2.cond src = r)) ∧
      (∀ x, g.re ≤ x → x ≠ src → HoonMap.get g2.cond x = Option.none) := by
    obtain ⟨PF, hb2, hd2, hbo2, _, _⟩ := collSrc_spec hs hd
    by_cases e : oL = o
    · rw [if_pos e] at hs
      simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at hs
      obtain ⟨rfl, rfl⟩ := hs
      exact ⟨rfl, rfl, rfl, PF, Nat.le_refl _, Nat.le_succ _, Or.inl rfl, fun x hx _ => nk x hx⟩
    · rw [if_neg e] at hs
      obtain ⟨ep, er, -, -, CF, hu⟩ := proxy_condFresh hs
      obtain ⟨tag, -, hu'⟩ := hu hd
      simp only at ep er
      refine ⟨hb2, hd2, hbo2, PF, by omega, by omega, Or.inr ⟨ep, er, hu'⟩, fun x hx hne => ?_⟩
      rcases CF.2 x with e' | ⟨a, b⟩
      · rw [e']; exact nk x hx
      · simp only at a b; exact absurd (by omega) hne
  obtain ⟨hb2, hd2, hbo2, PF, l2, u2, hsrc, kf2⟩ := SRC
  rw [show noSoft oL = false from rfl] at h3
  simp only [Bool.false_eq_true, ↓reduceIte] at h3
  obtain ⟨ops, g3, h4, h5⟩ := bind_some h3
  obtain ⟨A, hA, K⟩ := kernLoop_spec ned src [] g2 g3 ops h4
  simp only [List.append_nil] at hA
  subst hA
  obtain ⟨n, rfl⟩ := K.gen
  have l3 : g2.re ≤ n := K.le
  obtain ⟨b, hb, rfl⟩ := addOps_spec h5 (hd2.trans hd)
  refine ⟨hbo2, hd2, by simp only; omega,
    pf1.trans (PF.trans (ProxyFor.of_eq (g := g2) (by simp only; omega) rfl)), fun o' ho' => ?_, fun e he => ?_⟩
  · simp only [List.map_cons, List.map_nil, List.mem_singleton] at ho'
    simp only [HoonMap.get_put, if_neg ho']
    exact congrArg (fun m => HoonMap.get m o') hb2
  simp only [List.mem_singleton] at he
  subst he
  rw [hb2] at hb
  refine ⟨ops, fun B fin hb' => ?_, g.re, n, Nat.le_refl _, Nat.le_refl _, src, ?_, ?_, ?_⟩
  · rw [hb] at hb'
    cases hb'
    simp [HoonMap.get_put]
  · rcases hsrc with e | ⟨e, e', hu⟩
    · exact Or.inl e
    · exact Or.inr ⟨by omega, by omega, hu⟩
  · intro x a _ c
    exact kf2 x a c
  intro hrlo dist hlt u ur uS uc
  have kf : ∀ x, g.re ≤ x → x < n → x ≠ src → u x = x := fun x a b c => by
    rw [uc x b]; exact unproxy_none (kf2 x a c)
  have us : u src = r := by
    rcases hsrc with e | ⟨e, e', hu⟩
    · rw [e]; exact ur
    · rw [uc src (by omega)]; exact hu
  have srcl : src < g2.re := by
    rcases hsrc with e | ⟨e, e', _⟩
    · omega
    · omega
  have ut : ∀ x, NMem ned x → u x = x := fun x hx => by
    rcases L.mem x hx with h' | ⟨a, b⟩
    · exact uS x h'
    · simp only at b
      refine kf x a (by omega) fun e => ?_
      rcases hsrc with e' | ⟨e', _, _⟩
      · omega
      · omega
  have hnr : ¬ NMem ned r := fun hx => by
    rcases L.mem r hx with h' | ⟨a, _⟩
    · have := hlt r h'; omega
    · omega
  have e2 := kernLoop_ren h4 hnr (by omega) us ur ut (fun x a b => kf x (by omega) b (by omega))
  obtain ⟨A', hA', K'⟩ := kernLoop_spec ned r [] g2 _ _ e2
  simp only [List.append_nil] at hA'
  have dn : Distinct ned := L.dist dist (fun x hx => by have := hlt x hx; omega)
  have lt2 : ∀ x, NMem ned x → x < g2.re := fun x hx => by
    rcases L.mem x hx with h' | ⟨_, b⟩
    · have := hlt x h'; omega
    · simp only at b; omega
  have KS := K'.sem dn lt2
  intro lib σ O c gul st t R v hR
  obtain ⟨S1, S2⟩ := KS lib σ O c gul st t R v hR
  rw [hA']
  refine ⟨fun f => ?_, fun nf => S2 fun f => nf ((fits_sure L v).mp f)⟩
  obtain ⟨R', hr', hh, hk⟩ := S1 ((fits_sure L v).mpr f)
  exact ⟨R', hr', holdsS_of_sure L hh, fun x hx hn => hk x (by omega) fun hm => by
    rcases L.mem x hm with h' | ⟨a, _⟩
    · exact hn h'
    · omega⟩

end Comp
end SkaModel
end Formalization
