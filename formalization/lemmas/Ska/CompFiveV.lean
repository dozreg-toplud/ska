/-- **`[5 p q]` with operands that may make proxies** (`runOKG_n5` with
`OKNV` operands), for every fork-free goal whose registers are no keys. -/
theorem runOKGV_n5 (lib : Lib) {p q : Nomm} (hp : OKNV (S := S) (Map := Map) lib p)
    (hq : OKNV (S := S) (Map := Map) lib q) (cp : CleanN S Map p) (cq : CleanN S Map q) (hpp : p.pure = true)
    {goal : CGoal S} {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S}
    (hg : GoalOK g0 goal) (hj : GJ g0.bo goal) (hcount : sixCount (Nomm.n5 p q) ≤ 255) (b0 : 1 ≤ g0.bo)
    (d0 : g0.drop = false) (hu : UpBelow g0) (hcl0 : Clear g0) (hcb : CondBelow g0) (gin : GoalIn g0.re goal)
    (gak : GoalA (fun r => HoonMap.get g0.cond r = Option.none) goal)
    (h : runL (Nomm.n5 p q) (CGoal.toL goal) region g0 = some (nex, g1)) :
    RunOKGV (Map := Map) lib (Nomm.n5 p q) goal g0 g1 nex := by
  rw [runL_n5_toL] at h
  obtain ⟨rp, gA, hA, h⟩ := bind_some h
  obtain ⟨rq, gB, hB, h⟩ := bind_some h
  rw [re_apply] at hA hB
  simp only [Option.some.injEq, Prod.mk.injEq] at hA hB
  obtain ⟨rfl, rfl⟩ := hA
  obtain ⟨rfl, rfl⟩ := hB
  obtain ⟨o, g2, h2, h⟩ := bind_some h
  have c2 : g2.cond = g0.cond := ((kc_n5Pre _ _ goal).keep _ o g2 h2).trans rfl
  obtain ⟨E2, G2, hre, o1, o2, B⟩ := n5Pre_ok (lib := lib) h2 hg hj b0
  obtain ⟨nexq, g3, h3, h⟩ := bind_some h
  obtain ⟨nexq', g3', hp2, h⟩ := bind_some h
  rw [pastL_pure _ _ hpp, pure_apply] at hp2
  simp only [Option.some.injEq, Prod.mk.injEq] at hp2
  obtain ⟨rfl, rfl⟩ := hp2
  obtain ⟨nexp, g4, h4, hc⟩ := bind_some h
  rw [sixCount_n5] at hcount
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have u2 : UpBelow g2 := (G2.toU hu).up hu
  have cl2 : Clear g2 := hcl0.growU (G2.toU hu)
  have cb2 : CondBelow g2 := (condFresh_of_eq E2.1 c2).below hcb
  have Rq := hq (sur := lazyReg (g0.re + 1)) (th := jmp0 o) ⟨o1, o2⟩ rfl
    ⟨trivial, fun r hr => by simp only [lazyReg, NMem] at hr; omega⟩ trivial (by omega)
    (Nat.le_trans b0 G2.bo) d2 u2 cl2 cb2
    (fun r hr => by simp only [lazyReg, NMem] at hr; rw [c2]; exact condBelow_none hcb (by omega)) h3
  have Rp := hp (sur := lazyReg g0.re) (th := nexq.th) ⟨Rq.lo, Rq.hi⟩ (nextArgs_nil Rq.ent rfl)
    ⟨trivial, fun r hr => by simp only [lazyReg, NMem] at hr; have := Rq.ext.1; omega⟩ trivial (by omega)
    (Nat.le_trans b0 (Nat.le_trans G2.bo Rq.grow.bo)) (Rq.ext.2.2.1.trans d2) (Rq.grow.up u2)
    (cl2.growU Rq.grow) (Rq.cfr.below cb2)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr
      rw [Rq.cfr.get_lt (show r < g2.re by omega), c2]; exact condBelow_none hcb (by omega)) h4
  have AS : AboveIn (fun r => HoonMap.get g0.cond r = Option.none) g0.bo g2 :=
    (keepsA_n5Pre (P := fun r => HoonMap.get g0.cond r = Option.none)
      (g := { { g0 with re := g0.re + 1 } with re := g0.re + 1 + 1 }) d0 gak
      (condBelow_none hcb (show g0.re ≤ g0.re by omega)) (condBelow_none hcb (show g0.re ≤ g0.re + 1 by omega))
      (fun r hr => condBelow_none hcb (Nat.le_trans (show g0.re ≤ g0.re + 1 + 1 by omega) hr)) h2).ab _
      (aboveIn_start _ _)
  have BS : BelowIn g0.bo g2 :=
    (keeps_n5Pre (g := { { g0 with re := g0.re + 1 } with re := g0.re + 1 + 1 }) d0 (gin.mono (show g0.re ≤ g0.re + 1 + 1 by omega))
      (show g0.re < g0.re + 1 + 1 by omega) (show g0.re + 1 < g0.re + 1 + 1 by omega) h2).bel _
      (belowIn_start { { g0 with re := g0.re + 1 } with re := g0.re + 1 + 1 })
  exact binaryGV_ok (pureEval_n5 p q) hg E2 (G2.toU hu) c2 hcb
    (fun r hr => by simp only [lazyReg, NMem] at hr; exact Or.inr ⟨by omega, by omega⟩)
    (fun r hr => by simp only [lazyReg, NMem] at hr; exact Or.inr ⟨by omega, by omega⟩)
    (fun r h1 h2 => by simp only [lazyReg, NMem] at h1 h2; omega) Rq Rp
    (cq (sur := lazyReg _) trivial h3) (cp (sur := lazyReg _) trivial h4) hc hu d0 (Nat.le_of_eq (sixCount_n5 p q).symm)
    (fun x y hn => absurd (hn.elim (fun a => a (fitsS_lazyReg _ x)) (fun a => a (fitsS_lazyReg _ y))) id)
    (fun cf hcf k h0 h1 => by
      have u0 : ∀ x, x < g2.re → unproxy cf x = unproxy g0.cond x := unproxy_agree (fun k hk => hcf k hk)
      have u1 : ∀ x, HoonMap.get g0.cond x = Option.none → unproxy g0.cond x = id x :=
        fun x hx => unproxy_none hx
      cases hgb : HoonMap.get g2.blocks k with
      | none => rfl
      | some b =>
        simp only [Option.map_some]
        rw [unproxyBlob, renBlob_congr u0 (BS k b h0 h1 hgb), renBlob_congr u1 (AS k b h0 h1 hgb),
          renBlob_id])
    (fun c hc σ O st regs t gul x y _ _ hx hy => B c hc d0 σ O st regs t gul x y hx hy)

/-- **The tag clause of `[5 p q]`** for every fork-free goal. -/
theorem five_tagG (lib : Lib) {p q : Nomm} (hp : OKNV (S := S) (Map := Map) lib p)
    (hq : OKNV (S := S) (Map := Map) lib q) (tp : TagNV (S := S) (Map := Map) p)
    (tq : TagNV (S := S) (Map := Map) q) (hpp : p.pure = true)
    {goal : CGoal S} {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S}
    (hg : GoalOK g0 goal) (hj : GJ g0.bo goal) (hcount : sixCount (Nomm.n5 p q) ≤ 255) (b0 : 1 ≤ g0.bo)
    (d0 : g0.drop = false) (hu : UpBelow g0) (hcl0 : Clear g0) (hcb : CondBelow g0)
    (h : runL (Nomm.n5 p q) (CGoal.toL goal) region g0 = some (nex, g1)) :
    CondTag region g0.cond g1.cond := by
  rw [runL_n5_toL] at h
  obtain ⟨rp, gA, hA, h⟩ := bind_some h
  obtain ⟨rq, gB, hB, h⟩ := bind_some h
  rw [re_apply] at hA hB
  simp only [Option.some.injEq, Prod.mk.injEq] at hA hB
  obtain ⟨rfl, rfl⟩ := hA
  obtain ⟨rfl, rfl⟩ := hB
  obtain ⟨o, g2, h2, h⟩ := bind_some h
  have c2 : g2.cond = g0.cond := ((kc_n5Pre _ _ goal).keep _ o g2 h2).trans rfl
  obtain ⟨E2, G2, hre, o1, o2, B⟩ := n5Pre_ok (lib := lib) h2 hg hj b0
  obtain ⟨nexq, g3, h3, h⟩ := bind_some h
  obtain ⟨nexq', g3', hp2, h⟩ := bind_some h
  rw [pastL_pure _ _ hpp, pure_apply] at hp2
  simp only [Option.some.injEq, Prod.mk.injEq] at hp2
  obtain ⟨rfl, rfl⟩ := hp2
  obtain ⟨nexp, g4, h4, hc⟩ := bind_some h
  rw [sixCount_n5] at hcount
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have u2 : UpBelow g2 := (G2.toU hu).up hu
  have cl2 : Clear g2 := hcl0.growU (G2.toU hu)
  have cb2 : CondBelow g2 := (condFresh_of_eq E2.1 c2).below hcb
  have Rq := hq (sur := lazyReg (g0.re + 1)) (th := jmp0 o) ⟨o1, o2⟩ rfl
    ⟨trivial, fun r hr => by simp only [lazyReg, NMem] at hr; omega⟩ trivial (by omega)
    (Nat.le_trans b0 G2.bo) d2 u2 cl2 cb2
    (fun r hr => by simp only [lazyReg, NMem] at hr; rw [c2]; exact condBelow_none hcb (by omega)) h3
  have Rp := hp (sur := lazyReg g0.re) (th := nexq.th) ⟨Rq.lo, Rq.hi⟩ (nextArgs_nil Rq.ent rfl)
    ⟨trivial, fun r hr => by simp only [lazyReg, NMem] at hr; have := Rq.ext.1; omega⟩ trivial (by omega)
    (Nat.le_trans b0 (Nat.le_trans G2.bo Rq.grow.bo)) (Rq.ext.2.2.1.trans d2) (Rq.grow.up u2)
    (cl2.growU Rq.grow) (Rq.cfr.below cb2)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr
      rw [Rq.cfr.get_lt (show r < g2.re by omega), c2]; exact condBelow_none hcb (by omega)) h4
  have Tq := tq (sur := lazyReg (g0.re + 1)) (th := jmp0 o) ⟨o1, o2⟩ rfl
    ⟨trivial, fun r hr => by simp only [lazyReg, NMem] at hr; omega⟩ trivial (by omega)
    (Nat.le_trans b0 G2.bo) d2 u2 cl2 cb2
    (fun r hr => by simp only [lazyReg, NMem] at hr; rw [c2]; exact condBelow_none hcb (by omega)) h3
  have Tp := tp (sur := lazyReg g0.re) (th := nexq.th) ⟨Rq.lo, Rq.hi⟩ (nextArgs_nil Rq.ent rfl)
    ⟨trivial, fun r hr => by simp only [lazyReg, NMem] at hr; have := Rq.ext.1; omega⟩ trivial (by omega)
    (Nat.le_trans b0 (Nat.le_trans G2.bo Rq.grow.bo)) (Rq.ext.2.2.1.trans d2) (Rq.grow.up u2)
    (cl2.growU Rq.grow) (Rq.cfr.below cb2)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr
      rw [Rq.cfr.get_lt (show r < g2.re by omega), c2]; exact condBelow_none hcb (by omega)) h4
  have c1 : g1.cond = g4.cond := (kc_copyL _ _).keep _ _ _ hc
  exact (CondTag.of_eq c2).trans (Tq.trans (Tp.trans (CondTag.of_eq c1)))

/-- **`CleanA` of `[5 p q]` from `CleanA` of its parts** (the case of
`runX_clean`). -/
theorem cleanA_five {p q : Nomm} (hpp : p.pure = true) (ihp : CleanA S Map p) (ihq : CleanA S Map q) :
    CleanA S Map (Nomm.n5 p q) := by
  intro goal region g0 g1 nex _ h
  rw [runL_n5_toL] at h
  obtain ⟨_, _, _, h⟩ := bind_some h
  obtain ⟨_, _, _, h⟩ := bind_some h
  obtain ⟨_, _, _, h⟩ := bind_some h
  obtain ⟨nexq, _, h3, h⟩ := bind_some h
  obtain ⟨nexq', _, hp2, h⟩ := bind_some h
  rw [pastL_pure _ _ hpp, pure_apply] at hp2
  simp only [Option.some.injEq, Prod.mk.injEq] at hp2
  obtain ⟨rfl, rfl⟩ := hp2
  obtain ⟨nexp, _, h4, h⟩ := bind_some h
  exact clean_copyL h (ihp (goal := CGoal.next (lazyReg _) _) trivial h4)
    (ihq (goal := CGoal.next (lazyReg _) _) trivial h3)

