    · refine ⟨(Rb.eregs e h).1, fun r hr => ?_⟩
      have := (Rb.eregs e h).2 r hr
      have h1' := this.1.resolve_left (fun e => e)
      exact ⟨Or.inr (by omega), by omega⟩
  · -- labs
    intro e he
    rcases (memE e).mp he with h | rfl | h | rfl | h
    · obtain ⟨_, _, B, th, hth⟩ := Rc.labs e h
      have := lc e h
      exact ⟨by omega, by omega, B, th, (h4k _ (by omega)).trans hth⟩
    · exact ⟨by dsimp only; omega, by dsimp only; omega, [], x0.th, h4y⟩
    · obtain ⟨_, _, B, th, hth⟩ := Ra.labs e h
      have := la e h
      exact ⟨by omega, by omega, B, th, (h42 _ this.2).trans hth⟩
    · exact ⟨by dsimp only; omega, by dsimp only; omega, [], x1.th, h4n⟩
    · obtain ⟨l1, _, B, th, hth⟩ := Rb.labs e h
      have := lb e h
      exact ⟨l1, by omega, B, th, (h41 _ this.2).trans hth⟩
  · -- nodup
    rw [en, List.map_append, List.nodup_append, List.map_append, List.nodup_append]
    simp only [List.map_cons, List.nodup_cons, List.mem_cons, List.mem_append]
    refine ⟨Rc.nodup, ⟨⟨fun hm => by have := la' _ hm; omega, Ra.nodup⟩,
      ⟨fun hm => by have := lb' _ hm; omega, Rb.nodup⟩, fun x hx y hy => ?_⟩, fun x hx y hy => ?_⟩
    · have hx' : g1.bo ≤ x ∧ x ≤ g2.bo := by
        rcases hx with e | e
        · omega
        · have := la' x e; omega
      rcases hy with e | e
      · omega
      · have := lb' y e; omega
    · have := lc' x hx
      rcases hy with (e | e) | (e | e)
      · omega
      · have := la' y e; omega
      · omega
      · have := lb' y e; omega
  · -- nec
    have fo' : ¬ FitsS xc.laz.sure s := fun f => hfs ⟨f.1, (looks_uni_empty _ _).mpr f.2⟩
    obtain ⟨N1, N2⟩ := Rc.nec s hs fo'
    refine ⟨fun gul n tm r hm => ?_, fun gul tm => ?_⟩
    · obtain ⟨n', hn', rb, hb, hcase⟩ := minkF_sixC hm
      have e2 : rb = Tone.two tm := by
        rcases N1 gul n' tm rb hb with e | ⟨p, _, hp⟩
        · exact e
        · exact hp.elim
      subst e2
      rcases hcase with ⟨_, e⟩ | ⟨e, _⟩ | ⟨e, _⟩ | ⟨p, e, _⟩
      · exact Or.inl e
      · cases e
      · cases e
      · cases e
    · obtain ⟨rb, hb, hbad⟩ := N2 gul tm
      have e2 : rb = Tone.two tm := by
        rcases hbad with e | ⟨p, _, hp⟩
        · exact e
        · exact hp.elim
      subst e2
      exact ⟨_, (mink_sixC_bwd (fc := fa) (fd := fb) hb).1 (fun _ e => by cases e), Or.inl rfl⟩
  · -- econd
    intro e he r hr
    rcases (memE e).mp he with h | rfl | h | rfl | h
    · rw [hc43]; exact Rc.econd e h r hr
    · rw [cf24.get_lt (raR r hr).2]; exact Ra.ncond r hr
    · rw [cf24.get_lt ((Ra.eregs e h).2 r hr).2]; exact Ra.econd e h r hr
    · rw [cf14.get_lt (rbR r hr).2]; exact Rb.ncond r hr
    · rw [cf14.get_lt ((Rb.eregs e h).2 r hr).2]; exact Rb.econd e h r hr
  · -- forward
    intro cf hcf cc ned σ Inv ν O n gul hN hS hF st t tm s0 s r hI htr hs hm ag hned regs hh hn
    obtain ⟨hc3, agC, yesB, agA, nuhB, agB⟩ := core cf cc ned σ O gul t s0 s st ag
    have hcf3 : ∀ k, k < g3.re → HoonMap.get cf k = HoonMap.get g3.cond k := fun k hk =>
      (hcf k (by omega)).trans (by rw [hc43])
    have hcf2 : ∀ k, k < g2.re → HoonMap.get cf k = HoonMap.get g2.cond k := fun k hk =>
      (hcf k (by omega)).trans (cf24.get_lt hk)
    have hcf1 : ∀ k, k < g1.re → HoonMap.get cf k = HoonMap.get g1.cond k := fun k hk =>
      (hcf k (by omega)).trans (cf14.get_lt hk)
    obtain ⟨n', hn', rb, hb, hcase⟩ := minkF_sixC hm
    have Gc := Rc.sem cf hcf3 cc ned σ Inv ν O n' gul hN hS (oracleFwd_le hF (Nat.le_of_lt hn')) st t tm s0 s rb
      hI htr hs hb agC (fun x hx => by have := hned x hx; omega) regs ⟨hh.1, (looks_uni_empty _ _).mp hh.2⟩ hn
    have e0 : goJ lib O cc gul st regs t (jmp0 g3.bo) = goJ lib O cc gul st regs t xc.th := by
      rw [goJ_jmp0 _ _ _ _ hc3, execBlob_hop]
    show ReturnsC lib O cc gul Inv ν st regs t (jmp0 g3.bo) r
    rcases hcase with ⟨hnz, hrr⟩ | ⟨rfl, ha⟩ | ⟨rfl, hb'⟩ | ⟨p, rfl, h0, h1, rfl⟩
    · rw [hrr]
      cases rb with
        | zero q => exact absurd rfl (hnz q)
        | one q => exact returnsC_step (Needs.le_refl _) e0 Gc
        | two q => exact returnsC_step (Needs.le_refl _) e0 Gc
    · obtain ⟨G0, -, -⟩ := Gc
      obtain ⟨st', regs', hI', hν, -, k2, e2⟩ := G0 rfl
      exact returnsC_step hν (e0.trans e2) (sixBlk_fwd Ra hN hS (oracleFwd_le hF (Nat.le_of_lt hn')) hcf2
        (by omega) hned hs yesB agA hI' (frames_mono hν htr)
        (HoldsN.agree ned (fun x hx => k2 x ⟨Or.inr hx, fun e => e⟩) hn) ha)
    · obtain ⟨-, G1, -⟩ := Gc
      obtain ⟨st', regs', hI', hν, -, k2, e2⟩ := G1 rfl
      exact returnsC_step hν (e0.trans e2) (sixBlk_fwd Rb hN hS (oracleFwd_le hF (Nat.le_of_lt hn')) hcf1
        (by omega) hned hs nuhB agB hI' (frames_mono hν htr)
        (HoldsN.agree ned (fun x hx => k2 x ⟨Or.inr hx, fun e => e⟩) hn) hb')
    · obtain ⟨-, -, G2⟩ := Gc
      exact returnsC_step (Needs.le_refl _) e0 (G2 h0 h1)
  · -- backward
    intro cf hcf cc ned σ Inv ν O gul hN hS hB st t tm s0 s hI htr hs ag hned regs hh hn res hres
    obtain ⟨hc3, agC, yesB, agA, nuhB, agB⟩ := core cf cc ned σ O gul t s0 s st ag
    have hcf3 : ∀ k, k < g3.re → HoonMap.get cf k = HoonMap.get g3.cond k := fun k hk =>
      (hcf k (by omega)).trans (by rw [hc43])
    have hcf2 : ∀ k, k < g2.re → HoonMap.get cf k = HoonMap.get g2.cond k := fun k hk =>
      (hcf k (by omega)).trans (cf24.get_lt hk)
    have hcf1 : ∀ k, k < g1.re → HoonMap.get cf k = HoonMap.get g1.cond k := fun k hk =>
      (hcf k (by omega)).trans (cf14.get_lt hk)
    have e0 : goJ lib O cc gul st regs t (jmp0 g3.bo) = goJ lib O cc gul st regs t xc.th := by
      rw [goJ_jmp0 _ _ _ _ hc3, execBlob_hop]
    obtain ⟨rb, hmb, Gc⟩ := Rc.semB cf hcf3 cc ned σ Inv ν O gul hN hS hB st t tm s0 s hI htr hs agC
      (fun x hx => by have := hned x hx; omega) regs ⟨hh.1, (looks_uni_empty _ _).mp hh.2⟩ hn res
      (e0.symm.trans hres)
    have MB := mink_sixC_bwd (fc := fa) (fd := fb) hmb
    show ∃ r, Mink lib gul tm s (n4 (A 6) fc fa fb) r ∧ ReturnsC lib O cc gul Inv ν st regs t (jmp0 g3.bo) r
    cases rb with
    | zero p =>
      by_cases h0 : p = A 0
      · subst h0
        obtain ⟨G0, -, -⟩ := Gc
        obtain ⟨st', regs', hI', hν, -, k2, e2⟩ := G0 rfl
        obtain ⟨r, hr, G⟩ := sixBlk_bwd Ra hN hS hB hcf2 (by omega) hned hs yesB agA hI' (frames_mono hν htr)
          (HoldsN.agree ned (fun x hx => k2 x ⟨Or.inr hx, fun e => e⟩) hn) ((e0.trans e2).symm.trans hres)
        exact ⟨r, MB.2.1 r rfl hr, returnsC_step hν (e0.trans e2) G⟩
      · by_cases h1 : p = A 1
        · subst h1
          obtain ⟨-, G1, -⟩ := Gc
          obtain ⟨st', regs', hI', hν, -, k2, e2⟩ := G1 rfl
          obtain ⟨r, hr, G⟩ := sixBlk_bwd Rb hN hS hB hcf1 (by omega) hned hs nuhB agB hI' (frames_mono hν htr)
            (HoldsN.agree ned (fun x hx => k2 x ⟨Or.inr hx, fun e => e⟩) hn) ((e0.trans e2).symm.trans hres)
          exact ⟨r, MB.2.2.1 r rfl hr, returnsC_step hν (e0.trans e2) G⟩
        · obtain ⟨-, -, G2⟩ := Gc
          exact ⟨_, MB.2.2.2 p rfl h0 h1, returnsC_step (Needs.le_refl _) e0 (G2 h0 h1)⟩
    | one q => exact ⟨_, MB.1 (fun _ e => by cases e), returnsC_step (Needs.le_refl _) e0 Gc⟩
    | two q => exact ⟨_, MB.1 (fun _ e => by cases e), returnsC_step (Needs.le_refl _) e0 Gc⟩
  · -- the bound
    rw [en]; simp only [List.length_append, List.length_cons]
    omega
  · -- the jump at no entry: the block of `+copy`, above every label
    intro hm
    obtain ⟨e, he, hee⟩ := List.mem_map.mp hm
    simp only [jmp0] at hee
    rcases (memE e).mp he with h | rfl | h | rfl | h
    · have := lc e h; omega
    · dsimp only at hee; omega
    · have := la e h; omega
    · dsimp only at hee; omega
    · have := lb e h; omega

/-- **`finishLFC_contractGB` from `RunOKGB` and the jump at no entry**, the
two fields of `DoneOK` it reads (a `%6` meets no `DoneOK`: its result is
not flat).  The text of `finishLFC_contractGB`. -/
theorem finishLFC_contractGBN (lib : Lib) {env : CallEnv} {P : Noun → Prop} {f : Noun} {nm : Nomm} (N : Needs)
    (hR : ∀ {nex : NextL S} {gE : Gen Map}, runLC env Option.none nm (CGoalL.done : CGoalL S) [] (gen0 : Gen Map) =
      some (nex, gE) → RunOKGB lib N P f (CGoal.done : CGoal S) gen0 gE nex ∧
        nex.th.there ∉ (entries nex.laz).map Prod.fst)
    {ord : NeedOrd} {less : Cape} {bake : Need → Need × List (Nat × Noun)} (hbake : ∀ ned, bake ned = (ned, []))
    {c : Straight Map} (h : finishLFC (S := S) env nm ord less bake = some c) :
    ∀ s, P s → CapeAxes less s → ∀ args, SkaModel.split c.need s = some args →
      ContractFwd lib N s f args c ∧ ContractBwd lib N s f args c := by
  unfold finishLFC at h
  obtain ⟨⟨nex, gE⟩, hr, h⟩ := Option.bind_eq_some_iff.mp h
  have D := hR hr
  have R := D.1
  simp only at h
  split at h
  · cases h
  obtain ⟨⟨nedF, g2⟩, h2, h⟩ := Option.bind_eq_some_iff.mp h
  simp only [hbake, List.map_nil] at h
  obtain ⟨⟨u3, g3⟩, h3, h⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨⟨u4, g4⟩, h4, hts⟩ := Option.bind_eq_some_iff.mp h
  have T : TopSB gE nex :=
    { ext := R.ext
      grow := R.grow
      cfr := R.cfr
      lo := R.lo
      hi := R.hi
      args := by
        rcases R.ent with ⟨b, _, _, ha⟩ | e
        · exact ha
        · exact e.elim
      regs := fun r hr => by
        rcases R.regs r hr with e | e
        · exact e.elim
        · exact e
      dist := R.dist
      eregs := fun e he => ⟨(R.eregs e he).1, fun r hr => ⟨by
        rcases ((R.eregs e he).2 r hr).1 with a | a
        · exact a.elim
        · exact a, ((R.eregs e he).2 r hr).2⟩⟩
      labs := R.labs
      nodup := R.nodup
      ncond := R.ncond
      econd := R.econd }
  have bad : ∀ {tm : Trace} {r : Tone}, BadC (CGoal.done : CGoal S) tm r → r = Tone.two tm := fun hb => by
    rcases hb with e | ⟨_, _, hp⟩
    · exact e
    · exact hp.elim
  have F := finishTopF_genB lib T R.ent D.2 (fwdPhi lib N P f)
    (fun cf hcf c ned σ O st t gul s ag hned regs hh hn Inv ν n tm r hs hN hS hF hm hI htr => by
      obtain ⟨ton, st', -, -, he, hrel⟩ :=
        R.sem cf hcf c ned σ Inv ν O n gul hN hS hF st t tm s s r hI htr hs hm ag hned regs hh hn
      exact ⟨ton, st', he, hrel⟩)
    (fun σ O st t gul s hfs Inv ν n tm r hs _ _ _ hm _ htr =>
      ⟨Tone.two t, st, rfl, by rw [bad ((R.nec s hs hfs).1 gul n tm r hm)]; exact ToneRel.two htr⟩) h2 h3 h4 hts
  have B := finishTopF_genB lib T R.ent D.2 (bwdPhi lib N P f)
    (fun cf hcf c ned σ O st t gul s ag hned regs hh hn Inv ν tm hs hN hS hB hI htr ton st'' hx => by
      obtain ⟨r, hm, G⟩ := R.semB cf hcf c ned σ Inv ν O gul hN hS hB st t tm s s hI htr hs ag hned regs hh hn _ hx
      obtain ⟨ton', st', -, -, he, hrel⟩ := G
      rw [he] at hx
      cases hx
      exact ⟨r, hm, hrel⟩)
    (fun σ O st t gul s hfs Inv ν tm hs _ _ _ _ htr ton st' hx => by
      cases hx
      obtain ⟨r, hm, hb⟩ := (R.nec s hs hfs).2 gul tm
      rw [bad hb] at hm
      exact ⟨_, hm, ToneRel.two htr⟩) h2 h3 h4 hts
  intro s hs hca args hsp
  refine ⟨fun σ Inv ν O n gul ti tm r hN hS hF hm st hI htr => ?_,
    fun σ Inv ν O gul ti tm hN hS hB st ton st' hI htr hx => ?_⟩
  · exact F σ O st s args ti gul hca hsp Inv ν n tm r hs hN hS hF hm hI htr
  · exact B σ O st s args ti gul hca hsp Inv ν tm hs hN hS hB hI htr ton st' hx
/-! ## The tree of `R` -/

theorem nommR_eq : nommR = Nomm.n6 (Nomm.n3 (Nomm.n0 3)) (Nomm.n7 tenR callR) (Nomm.n0 3) := rfl

/-- The formula of `R`, with `fR` the formula of its call. -/
def nommRFOf (fR : Noun) : Noun := n4 (A 6) (n2 (A 3) (slot 3)) (n3 (A 7) tenRF fR) (slot 3)

/-- `[3 [0 3]]`, the test of `R`: `PickD` with the bound `0`. -/
theorem pickD_three3 (lib : Lib) {N : Needs} (env : CallEnv) (P : Noun → Prop) :
    PickD (S := S) (Map := Map) lib N env P (n2 (A 3) (slot 3)) (Nomm.n3 (Nomm.n0 3)) 0 :=
  pickD_of_uok lib env (uok_x lib (FragX.three (FragX.frag (nm := Nomm.n0 3) fun _ => trivial)))
    (fun s hs gul tm r => mink_pure (codeOK_none lib) rfl ((CallTreeA.three (CallTreeA.n0 3)).annot P) hs gul tm r)
    (by decide)

/-- `[0 3]`, the no branch of `R`: `SixD` with the bound `0`. -/
theorem sixD_slot3 (lib : Lib) {N : Needs} (env : CallEnv) (P : Noun → Prop) :
    SixD (S := S) (Map := Map) lib N env P (slot 3) (Nomm.n0 3) 0 :=
  sixD_of_callTreeA lib env (CallTreeA.n0 3) (NoEntF.pure rfl rfl) P

/-- **The yes branch of `R`, `[7 [10 [3 [0 7]] [0 1]] R-call]`, meets
`DoneE`** when the call does on the products of the `%10`. -/
theorem doneE_yesR (lib : Lib) {N : Needs} {env : CallEnv} {P : Noun → Prop} {fR : Noun}
    (Hcall : DoneE (S := S) (Map := Map) lib N env (Img lib P tenRF) fR callR) :
    DoneE (S := S) (Map := Map) lib N env P (n3 (A 7) tenRF fR) (Nomm.n7 tenR callR) :=
  doneE_seven lib (lokSE_tenR lib env P) (noEnt_pure env rfl rfl) (by decide) Hcall

/-- **`R` under `%done` meets `SixDN`**, given `Hcall`. -/
theorem sixDN_nommR (lib : Lib) {N : Needs} (env : CallEnv) {P : Noun → Prop} {fR : Noun}
    (Hcall : DoneE (S := S) (Map := Map) lib N env (Img lib P tenRF) fR callR) :
    SixDN (S := S) (Map := Map) lib N env P (nommRFOf fR) nommR (0 + 0 + 0 + 2) :=
  six_doneGBN lib env (c := Nomm.n3 (Nomm.n0 3)) rfl (pickD_three3 lib env P) (sixD_of_doneE (doneE_yesR lib Hcall))
    (sixD_slot3 lib env P) (by decide)

/-- **The n-ary contract of `R`** (the code `finishLFC` makes for `nommR`,
entered with the split of a subject with the cape's axes), given `Hcall`. -/
theorem finishLFC_contractR (lib : Lib) {env : CallEnv} {P : Noun → Prop} {fR : Noun} (N : Needs)
    (Hcall : DoneE (S := S) (Map := Map) lib N env (Img lib P tenRF) fR callR)
    {ord : NeedOrd} {less : Cape} {bake : Need → Need × List (Nat × Noun)} (hbake : ∀ ned, bake ned = (ned, []))
    {c : Straight Map} (h : finishLFC (S := S) env nommR ord less bake = some c) :
    ∀ s, P s → CapeAxes less s → ∀ args, SkaModel.split c.need s = some args →
      ContractFwd lib N s (nommRFOf fR) args c ∧ ContractBwd lib N s (nommRFOf fR) args c :=
  finishLFC_contractGBN lib N (fun hr =>
    ⟨(sixDN_nommR lib env Hcall (by simp [gen0]) rfl upBelow_gen0 clear_gen0 condBelow_gen0 hr).1,
      (sixDN_nommR lib env Hcall (by simp [gen0]) rfl upBelow_gen0 clear_gen0 condBelow_gen0 hr).2.2⟩) hbake h

/-- **The whole-subject contract of `R` with `runLC`**, given `Hcall`. -/
theorem finishLUC_contractR (lib : Lib) (env : CallEnv) {P : Noun → Prop} {fR : Noun} (N : Needs)
    (Hcall : DoneE (S := S) (Map := Map) lib N env (Img lib P tenRF) fR callR)
    {c : Straight Map} (hc : finishLUC (S := S) env nommR = some c) :
    c.need = NeedOrd.this ∧ ∀ s, P s → ContractFwd lib N s (nommRFOf fR) [s] c ∧ ContractBwd lib N s (nommRFOf fR) [s] c :=
  finishLUC_contractGB lib N (fun hr =>
    (sixDN_nommR lib env Hcall (by simp [gen0]) rfl upBelow_gen0 clear_gen0 condBelow_gen0 hr).1) hc

