import lemmas.Ska.CompConsCall
import lemmas.Ska.CompIndirectWrapTop

/-!
# The cons with the call in its head, at the top

README Gaps 12.14 (eighteenth session).  The whole-subject code of the nomm
`[[2 b c] d]` (`finishLUC`) meets the forward half of the contract on the
subject whole.

* `finishTop_genA`: `finishTop_gen` with the program agreeing with the run
  at every state of the oracle (generated by `tools/gen/topall.py`).
* `returnsC_done`: `GoalSemCM` under `%next (lazy-from-reg r)` into a block
  `[don r]` is `ReturnsC`.
* `finishLUC_fwdC`: the forward contract of the whole-subject code of any
  nomm whose run for `%done` is the block `[don 0]` and `RunOKNC` under
  `%next (lazy-from-reg 0)` into it, and whose formula crashes where the
  run's pure part does.
* `runLC_cons_done`, `consCH_runD`: the cons under `%done`.
* `consCHTop_fwd`, `consCHTop_fwdA`: the forward contract of `[[2 b c] d]`,
  and `consCH_example` for `[[2 [0 3] [0 2]] [0 1]]`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

-- BEGIN finishTop_genA
/-- **`finishTop_gen` with the program agreeing at every state**: the
`AgreeU` handed to `hsem` holds at every state of the oracle, as a run that
calls asks (`SemNC`).  Generated by `tools/gen/topall.py`. -/
theorem finishTop_genA (lib : Lib) {g1 : Gen Map} {nex : NextL S} (R : TopS g1 nex)
    (Φ : (σ : Type) → Oracle σ → σ → Trace → Noun → Noun → Option (Tone × σ) → Prop)
    (hsem : ∀ (cf : Map (Nat × List Nat)), (∀ k, k < g1.re → HoonMap.get cf k = HoonMap.get g1.cond k) →
      ∀ (c : Straight Map) (ned : Need) (σ : Type) (O : Oracle σ) (st : σ) (t : Trace) (gul : Noun) (s : Noun),
      (∀ st' : σ, AgreeU lib O c gul st' t cf ned gen0 g1 nex.laz s s) → (∀ r, NMem ned r → g1.re ≤ r) →
      ∀ regs, HoldsS nex.laz.sure regs s → HoldsN ned regs s →
      Φ σ O st t gul s (goJ lib O c gul st regs t nex.th))
    (hnec : ∀ (σ : Type) (O : Oracle σ) (st : σ) (t : Trace) (gul : Noun) (s : Noun),
      ¬ FitsS nex.laz.sure s → Φ σ O st t gul s (some (Tone.two t, st)))
    {o sub : Nat} {g3 : Gen Map} (h2 : kerf nex g1 = some ((o, sub), g3))
    {c' : Straight Map} (hts : toStraightF g3.cond g3.blocks (Need.this sub) o = some c') :
    c'.need = NeedOrd.this ∧ ∀ (σ : Type) (O : Oracle σ) (st : σ) (s : Noun) (t : Trace) (gul : Noun),
      Φ σ O st t gul s (execEntry lib O st c' [s] t gul) := by
  have d1 : g1.drop = false := R.ext.2.2.1
  have cb1 : CondBelow g1 := R.cfr.below condBelow_gen0
  -- `+kerf`: the hop block, then `+kern`
  unfold kerf at h2
  obtain ⟨o', ge, he, h2⟩ := bind_some h2
  rw [emit_apply] at he
  simp only [Option.some.injEq, Prod.mk.injEq] at he
  obtain ⟨rfl, rfl⟩ := he
  obtain ⟨r, g4, h3, h4⟩ := bind_some h2
  simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h4
  obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h4
  have lt0 : nex.th.there < g1.bo := R.hi
  have hlab : ∀ e ∈ entries nex.laz, e.1 < g1.bo := fun e he => Nat.lt_trans (R.labs e he).2.1 lt0
  have hn : (((g1.bo, nex.laz) :: entries nex.laz).map Prod.fst).Nodup := by
    simp only [List.map_cons, List.nodup_cons]
    exact ⟨fun hm => by obtain ⟨e, he, e1⟩ := List.mem_map.mp hm; have := hlab e he; omega, R.nodup⟩
  have cbe : CondBelow (g1.emitted ⟨[], [], Termin.hop nex.th⟩) := cb1
  obtain ⟨hr, W⟩ := kern_spec h3 d1 cbe hn
  simp only [Gen.emitted] at hr
  subst hr
  have eblk : ∀ k, HoonMap.get (g1.emitted ⟨[], [], Termin.hop nex.th⟩).blocks k =
      if k = g1.bo then some ⟨[], [], Termin.hop nex.th⟩ else HoonMap.get g1.blocks k := fun k => by
    simp only [Gen.emitted, d1, Bool.false_eq_true, ↓reduceIte, HoonMap.get_put]
  -- the blocks after `+kern`
  obtain ⟨A0, hA0, P0⟩ := W.at_ (g1.bo, nex.laz) List.mem_cons_self
  have hB0 : HoonMap.get g4.blocks g1.bo = some ⟨[], A0, Termin.hop nex.th⟩ := by
    have := hA0 [] (Termin.hop nex.th) (by simp only [eblk]; simp)
    simpa using this
  have hE : ∀ e ∈ entries nex.laz, ∃ A th, HoonMap.get g1.blocks e.1 = some ⟨[], [], Termin.hop th⟩ ∧
      HoonMap.get g4.blocks e.1 = some ⟨[], A, Termin.hop th⟩ ∧
      KernP g1.re g4.cond (g1.re + 1) g4.re e.1 e.2.sure A := by
    intro e he
    obtain ⟨_, _, th, hth⟩ := R.labs e he
    obtain ⟨A, hA, P⟩ := W.at_ e (List.mem_cons_of_mem _ he)
    refine ⟨A, th, hth, ?_, P⟩
    have := hA [] (Termin.hop th) (by
      have ne : e.1 ≠ g1.bo := by have := hlab e he; omega
      simp only [eblk, ne, ↓reduceIte]; exact hth)
    simpa using this
  have hO : ∀ k, k ≠ g1.bo → k ∉ (entries nex.laz).map Prod.fst → HoonMap.get g4.blocks k = HoonMap.get g1.blocks k := by
    intro k k1 k2
    rw [W.other k (by simp only [List.map_cons, List.mem_cons, not_or]; exact ⟨k1, k2⟩)]
    simp only [eblk, k1, ↓reduceIte]
  -- the program: the blocks unproxied
  let c1 : Straight Map := ⟨NeedOrd.none, 0, mapVals (unproxyBlob g4.cond) g4.blocks⟩
  have hag : ∀ k, HoonMap.get c1.blocks k = (HoonMap.get g4.blocks k).map (unproxyBlob g4.cond) :=
    fun k => get_mapVals _ _ k
  have D1 := downRk_gen0 (R.grow.trans (growU_emit (b := ⟨[], [], Termin.hop nex.th⟩)
    (fun j hj => by simp [finJumps] at hj; subst hj; exact ⟨R.lo, lt0⟩) (upBelow_of_growU R.grow)))
  have D4 := downRk_of_fins D1 (bs' := g4.blocks) fun k b' hk => by
    by_cases e1 : k = g1.bo
    · subst e1; rw [hB0] at hk; cases hk; exact ⟨⟨[], [], Termin.hop nex.th⟩, by rw [eblk]; simp, rfl⟩
    by_cases e2 : k ∈ (entries nex.laz).map Prod.fst
    · obtain ⟨e, he, rfl⟩ := List.mem_map.mp e2
      obtain ⟨A, th, h1', h4', _⟩ := hE e he
      rw [h4'] at hk; cases hk
      exact ⟨⟨[], [], Termin.hop th⟩, by rw [eblk, if_neg e1]; exact h1', rfl⟩
    · rw [hO k e1 e2] at hk; exact ⟨b', by rw [eblk, if_neg e1]; exact hk, rfl⟩
  have Dc : DownRk (upRk (g1.emitted ⟨[], [], Termin.hop nex.th⟩).blocks) c1.blocks := by
    intro k b hk
    rw [hag k] at hk
    obtain ⟨b0, hb0, rfl⟩ := Option.map_eq_some_iff.mp hk
    exact downRk_unproxy _ (D4 k b0 hb0)
  obtain ⟨hneed, start, hst, hent⟩ := toStraightF_entryU hts (by simp [flattenNeed, isRun]) D4 Dc
    (fun k _ => hag k)
  rw [hB0] at hst; cases hst
  refine ⟨hneed, fun σ O st s t gul => ?_⟩
  obtain ⟨R0, hR0, he⟩ := hent lib O st s [s] t gul (by rw [hneed]; rfl)
  rw [he]
  have ag4 : ∀ k, k < g1.re + 1 → HoonMap.get g4.cond k = HoonMap.get g1.cond k := fun k hk => W.cnd.1.get_lt hk
  have u4r : HoonMap.get g4.cond g1.re = Option.none := by
    rw [ag4 _ (Nat.lt_succ_self _)]; exact condBelow_none cb1 (Nat.le_refl _)
  have regs1 : ∀ x, NMem nex.laz.sure.ned x → x < g1.re := fun x hx => (R.regs x hx).2
  have hj : nex.th.args = [] := R.args
  have hrj : renJmp (unproxy g4.cond) nex.th = nex.th := by
    rcases hth : nex.th with ⟨args', there⟩; rw [hth] at hj; simp only at hj; subst hj; rfl
  -- the agreement of the program with the run's blocks
  have ag : ∀ st' : σ, AgreeU lib O c1 gul st' t g4.cond (Need.this g1.re) gen0 g1 nex.laz s s := fun st' => by
    refine ⟨fun o' _ u hnl => ?_, fun e he => ?_⟩
    · rw [hag o', hO o' (by omega) hnl]
    · obtain ⟨A, th, h1', h4', P⟩ := hE e he
      refine ⟨A.map (renPole (unproxy g4.cond)), th, h1', ?_, ?_⟩
      · rw [hag, h4']; simp only [Option.map_some, unproxyBlob, renBlob, List.map_nil, renFin]
      · obtain ⟨lo0, hi0, l0, _, src, _, _, sem⟩ := P
        have l0' : g1.re + 1 ≤ lo0 := l0
        have regsE : ∀ x, NMem e.2.sure.ned x → x < g1.re := fun x hx => ((R.eregs e he).2 x hx).2
        have KS := sem (by omega) (R.eregs e he).1 regsE (unproxy g4.cond) (unproxy_none u4r)
          (fun x hx => unproxy_none (by rw [ag4 x (by have := regsE x hx; omega)]; exact R.econd e he x hx))
          (fun _ _ => rfl)
        intro R hR
        obtain ⟨S1, S2⟩ := KS lib σ O c1 gul st' t R s hR
        refine ⟨fun f => ?_, S2⟩
        obtain ⟨R', a, b, k⟩ := S1 f
        exact ⟨R', a, b, fun x hx hn => k x (by
          rcases hx with hx | hx
          · simp only [NMem] at hx; omega
          · omega) hn⟩
  -- the ops at the hop block, then the run
  obtain ⟨lo0, hi0, l0, _, src, _, _, sem⟩ := P0
  have l0' : g1.re + 1 ≤ lo0 := l0
  have KS := sem (by omega) R.dist regs1 (unproxy g4.cond) (unproxy_none u4r)
    (fun x hx => unproxy_none (by rw [ag4 x (by have := regs1 x hx; omega)]; exact R.ncond x hx))
    (fun _ _ => rfl)
  obtain ⟨S1, S2⟩ := KS lib σ O c1 gul st t R0 s hR0
  simp only [unproxyBlob, renBlob, List.map_nil, renFin, hrj]
  by_cases fo : FitsS nex.laz.sure s
  · obtain ⟨R1, hr1, hh1, kr1⟩ := S1 fo
    have e1 := hr1 [] (Termin.hop nex.th)
    simp only [List.append_nil] at e1
    rw [e1, execBlob_hop]
    have hn1 : HoldsN (Need.this g1.re) R1 s := by
      show SkaModel.read g1.re R1 = some s
      rw [kr1 g1.re (by omega) (fun hm => by have := regs1 _ hm; omega)]; exact hR0
    exact hsem g4.cond (fun k hk => ag4 k (by omega)) c1 (Need.this g1.re) σ O st t gul s ag
      (fun x hx => by simp only [NMem] at hx; omega) R1 hh1 hn1
  · have e2 := S2 fo [] (Termin.hop nex.th)
    simp only [List.append_nil] at e2
    rw [e2]; exact hnec σ O st t gul s fo
-- END finishTop_genA

/-- **`GoalSemCM` under `%next (lazy-from-reg r)` into a block `[don r]`
returns.** -/
theorem returnsC_done {lib : Lib} {σ : Type} {O : Oracle σ} {c : Straight Map} {gul : Noun}
    {Inv : σ → Prop} {ν : σ → Needs} {K : Nat → Prop} {st : σ} {regs : Map (Option Noun)} {t tm : Trace}
    {je : Jmp} {r0 b : Nat} (hb : HoonMap.get c.blocks b = some ⟨[], [], Termin.don r0⟩) :
    ∀ {r : Tone}, GoalSemCM lib O c gul Inv ν K st regs t tm je (CGoal.next (lazyReg r0 : Sure S) (jmp0 b)) r →
      ReturnsC lib O c gul Inv ν st regs t je r
  | Tone.zero p, H => by
    obtain ⟨st', regs', hI', hle, hh, -, e⟩ := H.1 (fitsS_lazyReg r0 p)
    refine ⟨Tone.zero p, st', hI', hle, ?_, ToneRel.zero p⟩
    have hr : SkaModel.read r0 regs' = some p := hh
    rw [e, goJ_jmp0 _ _ _ _ hb, execBlob_don', hr]; rfl
  | Tone.one _, H => H
  | Tone.two _, H => H

/-- **The forward contract of the whole-subject code from `RunOKNC`**: for
a nomm whose run for `%done` from `gen0` is the block `[don 0]` at `1` and a
run that calls under `%next (lazy-from-reg 0)` into it (`RunOKNC` for the
formula `f` on the subjects of `P`), and whose formula's `+mink` crashes
where the run's pure part `pq` has no value (`Mnec`), the code has the need
`this` and meets `ContractFwd` on every subject of `P`. -/
theorem finishLUC_fwdC (lib : Lib) {nm pq : Nomm} {P : Noun → Prop} {f : Noun} {env : CallEnv}
    (hrun : ∀ {nex : NextL S} {g' : Gen Map},
      runLC env Option.none nm (CGoalL.done : CGoalL S) [] (gen0 : Gen Map) = some (nex, g') →
      HoonMap.get g'.blocks (gen0 : Gen Map).bo = some ⟨[], [], Termin.don (gen0 : Gen Map).re⟩ ∧
      RunOKNC lib P f pq (lazyReg (gen0 : Gen Map).re) (jmp0 (gen0 : Gen Map).bo)
        ({ (gen0 : Gen Map) with re := (gen0 : Gen Map).re + 1 }.emitted ⟨[], [], Termin.don (gen0 : Gen Map).re⟩)
        g' nex)
    (Mnec : ∀ {s gul : Noun} {n : Nat} {tm : Trace} {r : Tone}, P s → pureEval pq s = none →
      minkF lib gul n tm s f = some r → r = Tone.two tm)
    {c : Straight Map} (h : finishLUC (S := S) env nm = some c) (N : Needs) :
    c.need = NeedOrd.this ∧ ∀ s, P s → ContractFwd lib N s f [s] c := by
  unfold finishLUC at h
  obtain ⟨⟨nex, gE⟩, hr, h⟩ := Option.bind_eq_some_iff.mp h
  obtain ⟨⟨⟨o', sub⟩, g8⟩, hk, hts⟩ := Option.bind_eq_some_iff.mp h
  simp only at hts
  obtain ⟨hb1, R⟩ := hrun hr
  have l1 := R.ext.1
  have l2 := R.ext.2.1
  simp only [Gen.emitted, gen0] at l1 l2
  have T : TopS gE nex :=
    { ext := ((ext_re _).trans (ext_emit _ _)).trans R.ext
      grow := (((grow_re (gen0 : Gen Map)).trans (grow_emit (fun j hj => by simp [finJumps] at hj))).toU
        upBelow_gen0).trans R.grow
      cfr := (condFresh_of_eq (g0 := (gen0 : Gen Map)) (g1 := { (gen0 : Gen Map) with
        re := (gen0 : Gen Map).re + 1 }.emitted ⟨[], [], Termin.don (gen0 : Gen Map).re⟩)
        (by simp [Gen.emitted]) rfl).trans R.cfr
      lo := R.lo
      hi := R.hi
      args := nextArgs_nil R.ent rfl
      regs := fun r hr => ⟨Nat.zero_le _, by
        rcases R.regs r hr with e | ⟨_, e⟩
        · simp only [lazyReg, NMem] at e; simp only [gen0] at e; omega
        · exact e⟩
      dist := R.dist
      eregs := fun e he => ⟨(R.eregs e he).1, fun r hr => ⟨Nat.zero_le _, ((R.eregs e he).2 r hr).2⟩⟩
      labs := fun e he => ⟨by have := (R.labs e he).1; simp only [Gen.emitted, gen0] at this ⊢; omega,
        (R.labs e he).2⟩
      nodup := R.nodup
      ncond := R.ncond
      econd := R.econd }
  have F := finishTop_genA lib T (fwdPhi lib N P f)
    (fun cf hcf c ned σ O st t gul s ag hned regs hh hn Inv ν n tm r hs _ hS hF hm hI htr => by
      have ag' : ∀ st' : σ, AgreeU lib O c gul st' t cf ned
          ({ (gen0 : Gen Map) with re := (gen0 : Gen Map).re + 1 }.emitted
            ⟨[], [], Termin.don (gen0 : Gen Map).re⟩) gE nex.laz s s := fun st' =>
        AgreeU.part (ag st') (by simp [Gen.emitted]) (Ext.refl gE) (fun e he => he) (fun k _ _ hk => hk)
          (fun e he => Nat.lt_trans (R.labs e he).2.1 R.hi)
      have G := R.sem cf hcf c ned σ Inv ν O n gul hS hF st t tm s s r hI htr hs hm ag' hned regs hh hn
      have c0 : HoonMap.get cf (gen0 : Gen Map).re = Option.none := by
        rw [hcf _ (by simp only [gen0]; omega), R.cfr.get_lt (by simp [Gen.emitted])]
        exact HoonMap.get_empty _
      have hb : HoonMap.get c.blocks (gen0 : Gen Map).bo = some ⟨[], [], Termin.don (gen0 : Gen Map).re⟩ := by
        rw [(ag st).1 _ (Nat.le_refl _) (by simp only [gen0]; omega) (fun hm => by
          obtain ⟨e, he, e1⟩ := List.mem_map.mp hm
          have := (R.labs e he).1; simp only [Gen.emitted, gen0] at this e1; omega), hb1]
        simp only [Option.map_some, unproxyBlob, renBlob, List.map_nil, renFin, unproxy_none c0]
      obtain ⟨ton, st', -, -, he, hrel⟩ := returnsC_done hb G
      exact ⟨ton, st', he, hrel⟩)
    (fun σ O st t gul s hfs Inv ν n tm r hs _ _ _ hm _ htr =>
      ⟨Tone.two t, st, rfl, by rw [Mnec hs (R.nec s hfs) hm]; exact ToneRel.two htr⟩) hk hts
  refine ⟨F.1, fun s hs σ Inv ν O n gul ti tm r hN hS hF hm st hI htr => ?_⟩
  exact F.2 σ O st s ti gul Inv ν n tm r hs hN hS hF hm hI htr

/-! ## The cons under `%done` -/

theorem runLC_cons_done (env : CallEnv) (sup : Option Nomm) (p q : Nomm) (region : List Nat) :
    (runLC env sup (Nomm.cons p q) CGoalL.done region : CM Map (NextL S)) = (do
      let r ← re
      let o ← emit ⟨[], [], Termin.don r⟩
      runLC env sup (Nomm.cons p q) (CGoalL.next (ofSure (lazyReg r)) (jmp0 o)) region) := by
  conv => lhs; unfold runLC
  rfl

/-- **The cons `[[2 b c] d]` under `%done`, from any state**: the block
`[don re]` at `bo` (kept to the end), and the rest of the run meets
`RunOKNC` under `%next (lazy-from-reg re)` into it (`consCH_runN`). -/
theorem consCH_runD (lib : Lib) {b c d : Nomm} (ub : UOK (S := S) (Map := Map) lib b)
    (uc : UOK (S := S) (Map := Map) lib c) (ud : UOK (S := S) (Map := Map) lib d)
    {P : Noun → Prop} {fh ft : Noun} (M : MinkN2 lib P fh b c) (hfh : ∃ x y, fh = C x y)
    (Mq : ∀ {s gul : Noun} {n : Nat} {tm : Trace} {r : Tone}, P s → minkF lib gul n tm s ft = some r →
      r = toneOf tm (pureEval d s))
    (hcount : sixCount b + sixCount c + sixCount d ≤ 255) {env : CallEnv} {sup : Option Nomm}
    {region : List Nat} {g0 g' : Gen Map} {nex : NextL S}
    (b0 : 1 ≤ g0.bo) (d0 : g0.drop = false) (hu : UpBelow g0) (hcl : Clear g0) (hcb : CondBelow g0)
    (h : runLC env sup (Nomm.cons (Nomm.n2 b c Option.none) d) CGoalL.done region g0 = some (nex, g')) :
    HoonMap.get g'.blocks g0.bo = some ⟨[], [], Termin.don g0.re⟩ ∧
    RunOKNC lib P (C fh ft) (Nomm.cons b c) (lazyReg g0.re) (jmp0 g0.bo)
      ({ g0 with re := g0.re + 1 }.emitted ⟨[], [], Termin.don g0.re⟩) g' nex := by
  rw [runLC_cons_done] at h
  obtain ⟨r, ga, ha, h⟩ := bind_some h
  rw [re_apply] at ha
  simp only [Option.some.injEq, Prod.mk.injEq] at ha
  obtain ⟨rfl, rfl⟩ := ha
  obtain ⟨od, gb, hb, h⟩ := bind_some h
  rw [emit_apply] at hb
  simp only [Option.some.injEq, Prod.mk.injEq] at hb
  obtain ⟨rfl, rfl⟩ := hb
  have G1 : GrowU ({ g0 with re := g0.re + 1 } : Gen Map) ({ g0 with re := g0.re + 1 }.emitted ⟨[], [], Termin.don g0.re⟩) :=
    growU_emit (g := { g0 with re := g0.re + 1 }) (b := ⟨[], [], Termin.don g0.re⟩)
      (fun j hj => by simp [finJumps] at hj) hu
  have R := consCH_runN (sur := lazyReg g0.re) (th := jmp0 g0.bo) lib ub uc ud M hfh Mq hcount
    ⟨b0, by simp only [jmp0, Gen.emitted]; omega⟩ rfl
    ⟨trivial, fun x hx => by simp only [lazyReg, NMem] at hx; subst hx; simp only [Gen.emitted]; omega⟩ trivial
    (by simp only [Gen.emitted]; omega) (by simp only [Gen.emitted]; exact d0) (G1.up hu)
    (Clear.growU (g := ({ g0 with re := g0.re + 1 } : Gen Map)) hcl G1)
    (fun k hk => by have := hcb k hk; simp only [Gen.emitted] at this ⊢; omega)
    (fun x hx => by
      simp only [lazyReg, NMem] at hx; subst hx
      exact condBelow_none hcb (Nat.le_refl _)) h
  refine ⟨?_, R⟩
  rw [R.ext.2.2.2 _ (by simp only [Gen.emitted]; omega)]
  simp only [Gen.emitted, d0, Bool.false_eq_true, ↓reduceIte, HoonMap.get_put]

/-- **The forward contract of `[[2 b c] d]`**: the whole-subject code of the
nomm `[[2 b c] d]` (no callee) for a formula `[fh ft]`, with `b`, `c`, `d`
meeting `UOK`, at most 255 `%6`, `fh` a cell with `MinkN2` (any `Annot` of
`[2 b c]` but the bare ones) and `ft` whose `+mink` is `d`'s value, has the
need `this` and meets `ContractFwd` on every subject that fits the bell. -/
theorem consCHTop_fwd {lib : Lib} {bl : Bell} {b c d : Nomm} {fh ft : Noun} (hfol : bl.fol = C fh ft)
    (ub : UOK (S := S) (Map := Map) lib b) (uc : UOK (S := S) (Map := Map) lib c)
    (ud : UOK (S := S) (Map := Map) lib d) (M : MinkN2 lib (SkaModel.Fits bl.less) fh b c)
    (hfh : ∃ x y, fh = C x y)
    (Mq : ∀ {s gul : Noun} {n : Nat} {tm : Trace} {r : Tone}, SkaModel.Fits bl.less s →
      minkF lib gul n tm s ft = some r → r = toneOf tm (pureEval d s))
    (hcount : sixCount b + sixCount c + sixCount d ≤ 255) {env : CallEnv} {cd : Straight Map}
    (h : finishLUC (S := S) env (Nomm.cons (Nomm.n2 b c Option.none) d) = some cd) (N : Needs) :
    cd.need = NeedOrd.this ∧ ∀ s, SkaModel.Fits bl.less s → ContractFwd lib N s bl.fol [s] cd := by
  rw [hfol]
  refine finishLUC_fwdC lib (pq := Nomm.cons b c)
    (fun hr => consCH_runD lib ub uc ud M hfh Mq hcount (by simp [gen0]) rfl upBelow_gen0 clear_gen0
      condBelow_gen0 hr) (fun {s gul n tm r} hs e hm => ?_) h N
  obtain ⟨n', rh, _, hmh, hr⟩ := minkF_consC hfh Mq hs hm
  rcases M.fwd hs hmh with ⟨n'', x, y, _, ex, ey, _⟩ | ⟨_, er⟩
  · rw [pureEval_cons, ex, ey] at e; simp at e
  · rcases hr with ⟨_, rfl⟩ | ⟨x, ex, _⟩
    · exact er
    · rw [er] at ex; cases ex

/-- **The forward contract of `[[2 b c] d]` on `Annot`**: the formula
`[[2 fb fc] fd]` with `b`, `c`, `d` in `FragU` standing for `fb`, `fc`, `fd`
on the subjects that fit the bell. -/
theorem consCHTop_fwdA {lib : Lib} {code : Bell → Option Nomm} (hok : CodeOK lib code) {bl : Bell}
    {b c d : Nomm} {fb fc fd : Noun} (hfol : bl.fol = C (n3 (A 2) fb fc) fd)
    (hAb : Annot lib code (SkaModel.Fits bl.less) fb b) (hAc : Annot lib code (SkaModel.Fits bl.less) fc c)
    (hAd : Annot lib code (SkaModel.Fits bl.less) fd d)
    (hb : FragU (S := S) b) (hc : FragU (S := S) c) (hd : FragU (S := S) d)
    (hcount : sixCount b + sixCount c + sixCount d ≤ 255) {env : CallEnv} {cd : Straight Map}
    (h : finishLUC (S := S) env (Nomm.cons (Nomm.n2 b c Option.none) d) = some cd) (N : Needs) :
    cd.need = NeedOrd.this ∧ ∀ s, SkaModel.Fits bl.less s → ContractFwd lib N s bl.fol [s] cd :=
  consCHTop_fwd hfol (runU_uok lib hb) (runU_uok lib hc) (runU_uok lib hd)
    (minkN2_indirect hok (fragU_pure hb) (fragU_pure hc) hAb hAc) ⟨_, _, rfl⟩
    (fun {s gul n tm r} hs hm => (mink_pure hok (fragU_pure hd) hAd hs gul tm r).mp ⟨n, hm⟩) hcount h N

/-- **`[[2 [0 3] [0 2]] [0 1]]` end to end, forward**: its whole-subject
code (the raw blocks of `CompCallParent.lean`) has the need `this` and meets
`ContractFwd` on every subject that fits the bell. -/
theorem consCH_example {lib : Lib} {code : Bell → Option Nomm} (hok : CodeOK lib code) {bl : Bell}
    (hfol : bl.fol = C (n3 (A 2) (slot 3) (slot 2)) (slot 1)) {env : CallEnv} {cd : Straight Map}
    (h : finishLUC (S := S) env (Nomm.cons (Nomm.n2 (Nomm.n0 3) (Nomm.n0 2) Option.none) (Nomm.n0 1)) = some cd)
    (N : Needs) :
    cd.need = NeedOrd.this ∧ ∀ s, SkaModel.Fits bl.less s → ContractFwd lib N s bl.fol [s] cd :=
  consCHTop_fwdA hok hfol Annot.n0 Annot.n0 Annot.n0 (FragU.x (FragX.frag fun _ => trivial))
    (FragU.x (FragX.frag fun _ => trivial)) (FragU.x (FragX.frag fun _ => trivial)) (by simp [sixCount]) h N

end Comp
