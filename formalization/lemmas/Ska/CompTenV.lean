import lemmas.Ska.CompFourV
import lemmas.Ska.CompN10N

/-!
# `[10 [a v] q]` with operands whose runs make proxies

README Gaps 12.2 (eleventh session).  Generated by `tools/gen/tenv.py` from
`n10N_body`, `runOKN_n10`, `runOKP_n10D`, `runOKP_n10P` (`CompN10N.lean`) and
the case `ten` of `runX_clean`; do not edit by hand.  The donor `v` runs
under the fork-free `%next` of the donor need of `+into`, the recipient `q`
under that of the recipient need (`OKNV`); the `%con` blocks of `+into`
mention the goal's registers and fresh ones, so unproxying by a later `cond`
leaves them alone (`keepsA_into`, `keeps_into`, `fix_of_keeps`).

* `n10NV_body`, `runOKNV_n10`: under `%next`, through `binaryNV_ok`.
* `runOKV_n10D`, `runOKV_n10P`: for `%done` and `%pick` (`unaryGV_ok`).
* `n10NV_tagBody`, `ten_tagNV`, `ten_tagD`, `ten_tagP`: the tag clauses
  (`+into` and `+copy` keep `cond`).
* `cleanA_ten`: `CleanA` of `[10 [a v] q]`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- **`%10` under a fork-free `%next` with `OKNV` operands**, after
`+simple-next` (`n10N_body` with `binaryNV_ok`). -/
theorem n10NV_body (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (cv : CleanN S Map v) (cq : CleanN S Map q)
    (hvp : v.pure = true) (hqp : q.pure = true) {sur : Sure S} {th : Jmp} {region : List Nat} {g0 g1 : Gen Map}
    {nex : NextL S} (hj : GJ g0.bo (CGoal.next sur th)) (hth : th.args = [])
    (hok : GoalOK g0 (CGoal.next sur th)) (hcl : Clean sur.ned)
    (hcount : sixCount (Nomm.n10 a v q) ≤ 255) (b0 : 1 ≤ g0.bo) (d0 : g0.drop = false) (hu : UpBelow g0)
    (hcl0 : Clear g0) (hcb : CondBelow g0) (hkg : ∀ r, NMem sur.ned r → HoonMap.get g0.cond r = Option.none)
    (h : n10Body a v q ⟨ofSure sur, th⟩ region g0 = some (nex, g1)) :
    RunOKNV (Map := Map) lib (Nomm.n10 a v q) sur th g0 g1 nex := by
  unfold n10Body at h
  obtain ⟨⟨don', rec', o⟩, g2x, h2, h⟩ := bind_some h
  rw [intoL_mk, map_apply] at h2
  obtain ⟨⟨⟨don, rec, o'⟩, g2⟩, hs2, e2⟩ := Option.map_eq_some_iff.mp h2
  simp only [Prod.mk.injEq] at e2
  obtain ⟨⟨rfl, rfl, rfl⟩, rfl⟩ := e2
  clear h2
  simp only at h
  obtain ⟨nexR, g2', hpr, h⟩ := bind_some h
  rw [pastL_mk _ _ _ hvp, pure_apply] at hpr
  simp only [Option.some.injEq, Prod.mk.injEq] at hpr
  obtain ⟨rfl, rfl⟩ := hpr
  obtain ⟨nexDon, g3, h3, h⟩ := bind_some h
  obtain ⟨nexDon', g3', hpd, h⟩ := bind_some h
  rw [pastL_pure _ _ hqp, pure_apply] at hpd
  simp only [Option.some.injEq, Prod.mk.injEq] at hpd
  obtain ⟨rfl, rfl⟩ := hpd
  obtain ⟨nexRec, g4, h4, hcp⟩ := bind_some h
  have ID := into_down hs2 hj.1 hj.2 d0
  obtain ⟨a1, eo, E2, _, Md, Mr, Fe, SP⟩ := into_ok hs2
  subst eo
  obtain ⟨Dd, Dr, Ddr, F, B⟩ := SP hok.1 hok.2
  have CI := clean_into hs2 hcl
  have c2 : g2.cond = g0.cond := (kc_into _ _).keep _ _ _ hs2
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have u2 : UpBelow g2 := (ID.1.toU hu).up hu
  have lt2 : ∀ (n : Need), (∀ y, NMem n y → NMem sur.ned y ∨ (g0.re ≤ y ∧ y < g2.re)) →
      ∀ y, NMem n y → y < g2.re := fun n M y hy => by
    rcases M y hy with e | ⟨_, e⟩
    · exact Nat.lt_of_lt_of_le (hok.2 y e) E2.1
    · exact e
  simp only [sixCount] at hcount
  have cl2 : Clear g2 := hcl0.growU (ID.1.toU hu)
  have cb2 : CondBelow g2 := (condFresh_of_eq E2.1 c2).below hcb
  have nk2 : ∀ (n : Need), (∀ y, NMem n y → NMem sur.ned y ∨ (g0.re ≤ y ∧ y < g2.re)) →
      ∀ y, NMem n y → HoonMap.get g2.cond y = Option.none := fun n M y hy => by
    rw [c2]
    rcases M y hy with e | ⟨e, _⟩
    · exact hkg y e
    · exact condBelow_none hcb e
  have Rv := hv (sur := don) (th := jmp0 g0.bo) ⟨b0, by simp only [jmp0]; omega⟩ rfl ⟨Dd, lt2 _ Md⟩ CI.1
    (by omega) (by omega) d2 u2 cl2 cb2 (nk2 _ Md) h3
  have Rq := hq (sur := rec) (th := nexDon.th) ⟨Rv.lo, Rv.hi⟩ (nextArgs_nil Rv.ent rfl)
    ⟨Dr, fun y hy => Nat.lt_of_lt_of_le (lt2 _ Mr y hy) Rv.ext.1⟩ CI.2 (by omega)
    (by have := Rv.lo; have := Rv.hi; omega) (Rv.ext.2.2.1.trans d2) (Rv.grow.up u2) (cl2.growU Rv.grow)
    (Rv.cfr.below cb2) (fun y hy => by rw [Rv.cfr.get_lt (lt2 _ Mr y hy)]; exact nk2 _ Mr y hy) h4
  refine binaryNV_ok (pureEval_n10 (by omega) v q) hok E2 (ID.1.toU hu) c2 hcb Mr Md (fun r hr hd => Ddr r hd hr)
    Rv Rq (cv CI.1 h3) (cq CI.2 h4) hcp hu d0 (by simp only [sixCount]; omega)
    (fun x y hn => ?_)
    (fix_of_keeps (gs := g0) rfl
      (keepsA_into (P := (fun r => HoonMap.get g0.cond r = Option.none)) (nex := ⟨sur, th⟩) d0 ⟨hkg, jmpIn_nil hth⟩
        (fun r hr => condBelow_none hcb hr) hs2).1
      (keeps_into (nex := ⟨sur, th⟩) d0 ⟨fun r hr => hok.2 r hr, jmpIn_nil hth⟩ hs2).1)
    (fun c hc σ O st regs t gul x y fx fy hx hy => ?_)
  · cases e : edit? a y x with
    | none => exact Or.inl rfl
    | some n =>
      refine Or.inr ⟨n, rfl, fun hf => ?_⟩
      rcases hn with b | b
      · exact b ((F y x n e).mp hf).2
      · exact b ((F y x n e).mp hf).1
  · obtain ⟨n, e⟩ := Option.isSome_iff_exists.mp (Fe y x fx)
    rw [e]
    refine ⟨fun _ => ?_, fun hn => absurd ((F y x n e).mpr ⟨fy, fx⟩) hn⟩
    obtain ⟨R', hl, u, ej⟩ := B d0 c hc lib σ O st t regs y x n gul e hy hx
    exact ⟨R', hl, fun r ⟨k1, k2⟩ => u r k2 k1, ej⟩

/-- **The tag clause of the body of `%10`.** -/
