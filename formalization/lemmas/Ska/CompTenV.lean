    (hok : GoalOK g0 (CGoal.next sur th)) (hcl : Clean sur.ned)
    (hcount : sixCount (Nomm.n10 a v q) ≤ 255) (b0 : 1 ≤ g0.bo) (d0 : g0.drop = false) (hu : UpBelow g0)
    (hcl0 : Clear g0) (hcb : CondBelow g0) (hkg : ∀ r, NMem sur.ned r → HoonMap.get g0.cond r = Option.none)
    (h : n10Body a v q ⟨ofSure sur, th⟩ region g0 = some (nex, g1)) :
    CondTag region g0.cond g1.cond := by
  unfold n10Body at h
  obtain ⟨⟨don', rec', o⟩, g2x, h2, h⟩ := bind_some h
  rw [intoL_mk, map_apply] at h2
  obtain ⟨⟨⟨don, rec, o'⟩, g2⟩, hs2, e2⟩ := Option.map_eq_some_iff.mp h2
  simp only [Prod.mk.injEq] at e2
  obtain ⟨⟨rfl, rfl, rfl⟩, rfl⟩ := e2
  clear h2
  simp only at h
  obtain ⟨nexR, g2', hpr, h⟩ := bind_some h
  rw [pastL_mk _ _ _ hvp, pure_apply] at hpr
  simp only [Option.some.injEq, Prod.mk.injEq] at hpr
  obtain ⟨rfl, rfl⟩ := hpr
  obtain ⟨nexDon, g3, h3, h⟩ := bind_some h
  obtain ⟨nexDon', g3', hpd, h⟩ := bind_some h
  rw [pastL_pure _ _ hqp, pure_apply] at hpd
  simp only [Option.some.injEq, Prod.mk.injEq] at hpd
  obtain ⟨rfl, rfl⟩ := hpd
  obtain ⟨nexRec, g4, h4, hcp⟩ := bind_some h
  have ID := into_down hs2 hj.1 hj.2 d0
  obtain ⟨a1, eo, E2, _, Md, Mr, Fe, SP⟩ := into_ok hs2
  subst eo
  obtain ⟨Dd, Dr, Ddr, F, B⟩ := SP hok.1 hok.2
  have CI := clean_into hs2 hcl
  have c2 : g2.cond = g0.cond := (kc_into _ _).keep _ _ _ hs2
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have u2 : UpBelow g2 := (ID.1.toU hu).up hu
  have lt2 : ∀ (n : Need), (∀ y, NMem n y → NMem sur.ned y ∨ (g0.re ≤ y ∧ y < g2.re)) →
      ∀ y, NMem n y → y < g2.re := fun n M y hy => by
    rcases M y hy with e | ⟨_, e⟩
    · exact Nat.lt_of_lt_of_le (hok.2 y e) E2.1
    · exact e
  simp only [sixCount] at hcount
  have cl2 : Clear g2 := hcl0.growU (ID.1.toU hu)
  have cb2 : CondBelow g2 := (condFresh_of_eq E2.1 c2).below hcb
  have nk2 : ∀ (n : Need), (∀ y, NMem n y → NMem sur.ned y ∨ (g0.re ≤ y ∧ y < g2.re)) →
      ∀ y, NMem n y → HoonMap.get g2.cond y = Option.none := fun n M y hy => by
    rw [c2]
    rcases M y hy with e | ⟨e, _⟩
    · exact hkg y e
    · exact condBelow_none hcb e
  have Rv := hv (sur := don) (th := jmp0 g0.bo) ⟨b0, by simp only [jmp0]; omega⟩ rfl ⟨Dd, lt2 _ Md⟩ CI.1
    (by omega) (by omega) d2 u2 cl2 cb2 (nk2 _ Md) h3
  have Rq := hq (sur := rec) (th := nexDon.th) ⟨Rv.lo, Rv.hi⟩ (nextArgs_nil Rv.ent rfl)
    ⟨Dr, fun y hy => Nat.lt_of_lt_of_le (lt2 _ Mr y hy) Rv.ext.1⟩ CI.2 (by omega)
    (by have := Rv.lo; have := Rv.hi; omega) (Rv.ext.2.2.1.trans d2) (Rv.grow.up u2) (cl2.growU Rv.grow)
    (Rv.cfr.below cb2) (fun y hy => by rw [Rv.cfr.get_lt (lt2 _ Mr y hy)]; exact nk2 _ Mr y hy) h4
  have Tv := tv (sur := don) (th := jmp0 g0.bo) ⟨b0, by simp only [jmp0]; omega⟩ rfl ⟨Dd, lt2 _ Md⟩ CI.1
    (by omega) (by omega) d2 u2 cl2 cb2 (nk2 _ Md) h3
  have Tq := tq (sur := rec) (th := nexDon.th) ⟨Rv.lo, Rv.hi⟩ (nextArgs_nil Rv.ent rfl)
    ⟨Dr, fun y hy => Nat.lt_of_lt_of_le (lt2 _ Mr y hy) Rv.ext.1⟩ CI.2 (by omega)
    (by have := Rv.lo; have := Rv.hi; omega) (Rv.ext.2.2.1.trans d2) (Rv.grow.up u2) (cl2.growU Rv.grow)
    (Rv.cfr.below cb2) (fun y hy => by rw [Rv.cfr.get_lt (lt2 _ Mr y hy)]; exact nk2 _ Mr y hy) h4
  exact (CondTag.of_eq c2).trans (Tv.trans (Tq.trans (CondTag.of_eq ((kc_copyL _ _).keep _ _ _ hcp))))

/-- **`%10` under a fork-free `%next` with `OKNV` operands.** -/
theorem runOKNV_n10 (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (cv : CleanN S Map v) (cq : CleanN S Map q)
    (hvp : v.pure = true) (hqp : q.pure = true) : OKNV (S := S) (Map := Map) lib (Nomm.n10 a v q) :=
  fun hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h => by
    rw [runL_n10_body] at h
    obtain ⟨next, gs, hs, h⟩ := bind_some h
    simp only [simpleNextL, pure_apply, Option.some.injEq, Prod.mk.injEq] at hs
    obtain ⟨rfl, rfl⟩ := hs
    exact n10NV_body lib hv hq cv cq hvp hqp hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h

/-- **The tag clause of `%10` under `%next`.** -/
theorem ten_tagNV (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (tv : TagNV (S := S) (Map := Map) v)
    (tq : TagNV (S := S) (Map := Map) q) (cv : CleanN S Map v)
    (hvp : v.pure = true) (hqp : q.pure = true) : TagNV (S := S) (Map := Map) (Nomm.n10 a v q) :=
  fun hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h => by
    rw [runL_n10_body] at h
    obtain ⟨next, gs, hs, h⟩ := bind_some h
    simp only [simpleNextL, pure_apply, Option.some.injEq, Prod.mk.injEq] at hs
    obtain ⟨rfl, rfl⟩ := hs
    exact n10NV_tagBody lib hv hq tv tq cv hvp hqp hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h

/-- **`%10` for `%done` with `OKNV` operands.** -/
theorem runOKV_n10D (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (cv : CleanN S Map v) (cq : CleanN S Map q)
    (hvp : v.pure = true) (hqp : q.pure = true) :
    OKV (Map := Map) lib (CGoal.done : CGoal S) (Nomm.n10 a v q) := by
  intro region g0 g1 nex _ _ hcount b0 d0 hu hcl0 hcb h
  rw [runL_n10_body] at h
  obtain ⟨next, gs, hs, h⟩ := bind_some h
  simp only [CGoal.toL, simpleNextL, bind_apply, re_apply, emit_apply, Option.bind_some, pure_apply,
    Option.some.injEq, Prod.mk.injEq] at hs
  obtain ⟨rfl, rfl⟩ := hs
  have G : Grow g0 ({ g0 with re := g0.re + 1 }.emitted ⟨[], [], Termin.don g0.re⟩) :=
    (grow_re g0).trans (grow_emit (fun j hj => by simp [finJumps] at hj))
  have Hn := n10NV_body lib hv hq cv cq hvp hqp (sur := lazyReg g0.re) (th := jmp0 g0.bo)
    ⟨b0, by simp [jmp0, emitted_bo]⟩ rfl ⟨trivial, fun r hr => by
      simp only [lazyReg, NMem] at hr; simp [hr, emitted_re]⟩ trivial hcount (by simp [emitted_bo])
    (by simpa [emitted_drop] using d0) ((G.toU hu).up hu) (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_succ _) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (Nat.le_refl _)) h
  refine unaryGV_ok (goal := CGoal.done) trivial (f := some) (fun s => by cases pureEval (Nomm.n10 a v q) s <;> rfl)
    ((ext_re _).trans (ext_emit _ _)) (G.toU hu) rfl ⟨Nat.le_refl _, by simp [emitted_re]⟩ (by simp [emitted_bo])
    (fresh_emitted (by simpa using d0) rfl rfl) Hn rfl
    (fix_of_keeps (gs := g0) rfl ((keepsA_reg _ g0 _ (Nat.le_succ _)).trans (keepsA_emitted d0
        (blobIn_fin (condBelow_none hcb (Nat.le_refl _)))))
      ((keeps_reg g0 _ (Nat.le_succ _)).trans (keeps_emitted d0 (blobIn_fin (Nat.lt_succ_self _)))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d0) (hc _ (by simp) (by simp [emitted_bo]))
  show goJ lib O c gul st regs t (jmp0 _) = some (toneOf t (some x), st)
  rw [goJ_jmp0 _ _ _ _ hb, execBlob_don', hx]; rfl

/-- **The tag clause of `%10` for `%done`.** -/
theorem ten_tagD (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (tv : TagNV (S := S) (Map := Map) v)
    (tq : TagNV (S := S) (Map := Map) q) (cv : CleanN S Map v) (cq : CleanN S Map q)
    (hvp : v.pure = true) (hqp : q.pure = true) :
    TagV (Map := Map) (CGoal.done : CGoal S) (Nomm.n10 a v q) := by
  intro region g0 g1 nex _ _ hcount b0 d0 hu hcl0 hcb h
  rw [runL_n10_body] at h
  obtain ⟨next, gs, hs, h⟩ := bind_some h
  simp only [CGoal.toL, simpleNextL, bind_apply, re_apply, emit_apply, Option.bind_some, pure_apply,
    Option.some.injEq, Prod.mk.injEq] at hs
  obtain ⟨rfl, rfl⟩ := hs
  have G : Grow g0 ({ g0 with re := g0.re + 1 }.emitted ⟨[], [], Termin.don g0.re⟩) :=
    (grow_re g0).trans (grow_emit (fun j hj => by simp [finJumps] at hj))
  have Tn := n10NV_tagBody lib hv hq tv tq cv hvp hqp (sur := lazyReg g0.re) (th := jmp0 g0.bo)
    ⟨b0, by simp [jmp0, emitted_bo]⟩ rfl ⟨trivial, fun r hr => by
      simp only [lazyReg, NMem] at hr; simp [hr, emitted_re]⟩ trivial hcount (by simp [emitted_bo])
    (by simpa [emitted_drop] using d0) ((G.toU hu).up hu) (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_succ _) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (Nat.le_refl _)) h
  exact Tn

/-- **`%10` for `%pick` with `OKNV` operands.** -/
theorem runOKV_n10P (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (cv : CleanN S Map v) (cq : CleanN S Map q)
    (hvp : v.pure = true) (hqp : q.pure = true) (z o : Jmp)
    (hz : z.args = []) (hzo : o.args = []) :
    OKV (Map := Map) lib (CGoal.pick z o : CGoal S) (Nomm.n10 a v q) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  rw [runL_n10_body] at h
  obtain ⟨next, gs, hs, h⟩ := bind_some h
  simp only [CGoal.toL, simpleNextL, bind_apply, re_apply, emit_apply, Option.bind_some, pure_apply,
    Option.some.injEq, Prod.mk.injEq] at hs
  obtain ⟨rfl, rfl⟩ := hs
  have G : Grow g0 ({ g0 with re := g0.re + 1 }.emitted ⟨[], [], Termin.brn g0.re z o⟩) :=
    (grow_re g0).trans (grow_emit (jumpsBelow_two rfl hj.1 hj.2))
  have Hn := n10NV_body lib hv hq cv cq hvp hqp (sur := lazyReg g0.re) (th := jmp0 g0.bo)
    ⟨b0, by simp [jmp0, emitted_bo]⟩ rfl ⟨trivial, fun r hr => by
      simp only [lazyReg, NMem] at hr; simp [hr, emitted_re]⟩ trivial hcount (by simp [emitted_bo])
    (by simpa [emitted_drop] using d0) ((G.toU hu).up hu) (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_succ _) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (Nat.le_refl _)) h
  refine unaryGV_ok (goal := CGoal.pick z o) trivial (f := some)
    (fun s => by cases pureEval (Nomm.n10 a v q) s <;> rfl)
    ((ext_re _).trans (ext_emit _ _)) (G.toU hu) rfl ⟨Nat.le_refl _, by simp [emitted_re]⟩ (by simp [emitted_bo])
    (fresh_emitted (by simpa using d0) rfl rfl) Hn rfl
    (fix_of_keeps (gs := g0) rfl ((keepsA_reg _ g0 _ (Nat.le_succ _)).trans (keepsA_emitted d0
        (blobIn_fin ⟨condBelow_none hcb (Nat.le_refl _), jmpIn_nil hz, jmpIn_nil hzo⟩)))
      ((keeps_reg g0 _ (Nat.le_succ _)).trans (keeps_emitted d0 (blobIn_fin ⟨Nat.lt_succ_self _, jmpIn_nil hz, jmpIn_nil hzo⟩))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d0) (hc _ (by simp) (by simp [emitted_bo]))
  have hj' := goJ_jmp0 (lib := lib) (O := O) (gul := gul) (st := st) regs t _ _ hb
  rw [execBlob_brn, hx, Option.bind_some] at hj'
  by_cases x0 : x = A 0
  · subst x0
    exact ⟨regs, fun _ _ => rfl, by rw [hj']; simp⟩
  by_cases x1 : x = A 1
  · subst x1
    exact ⟨regs, fun _ _ => rfl, by rw [hj']; simp⟩
  exact goalSem_pick_other x0 x1 (by rw [hj']; simp [x0, x1])

/-- **The tag clause of `%10` for `%pick`.** -/
theorem ten_tagP (lib : Lib) {a : Nat} {v q : Nomm} (hv : OKNV (S := S) (Map := Map) lib v)
    (hq : OKNV (S := S) (Map := Map) lib q) (tv : TagNV (S := S) (Map := Map) v)
    (tq : TagNV (S := S) (Map := Map) q) (cv : CleanN S Map v) (cq : CleanN S Map q)
    (hvp : v.pure = true) (hqp : q.pure = true) (z o : Jmp) :
    TagV (Map := Map) (CGoal.pick z o : CGoal S) (Nomm.n10 a v q) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  rw [runL_n10_body] at h
  obtain ⟨next, gs, hs, h⟩ := bind_some h
  simp only [CGoal.toL, simpleNextL, bind_apply, re_apply, emit_apply, Option.bind_some, pure_apply,
    Option.some.injEq, Prod.mk.injEq] at hs
  obtain ⟨rfl, rfl⟩ := hs
  have G : Grow g0 ({ g0 with re := g0.re + 1 }.emitted ⟨[], [], Termin.brn g0.re z o⟩) :=
    (grow_re g0).trans (grow_emit (jumpsBelow_two rfl hj.1 hj.2))
  have Tn := n10NV_tagBody lib hv hq tv tq cv hvp hqp (sur := lazyReg g0.re) (th := jmp0 g0.bo)
    ⟨b0, by simp [jmp0, emitted_bo]⟩ rfl ⟨trivial, fun r hr => by
      simp only [lazyReg, NMem] at hr; simp [hr, emitted_re]⟩ trivial hcount (by simp [emitted_bo])
    (by simpa [emitted_drop] using d0) ((G.toU hu).up hu) (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_succ _) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (Nat.le_refl _)) h
  exact Tn

/-- **`CleanA` of `[10 [a v] q]`** (the case of `runX_clean`). -/
theorem cleanA_ten {a : Nat} {v q : Nomm} (ihv : CleanA S Map v) (ihq : CleanA S Map q) (hvp : v.pure = true)
    (hqp : q.pure = true) : CleanA S Map (Nomm.n10 a v q) := by
  intro goal region g0 g1 nex hc h
  rw [runL_n10_body] at h
  obtain ⟨next, gs, hs, h⟩ := bind_some h
  have hn : ∃ (sur : Sure S) (th : Jmp), next = ⟨ofSure sur, th⟩ ∧ Clean sur.ned := by
    cases goal with
    | next sur th =>
      simp only [CGoal.toL, simpleNextL, pure_apply, Option.some.injEq, Prod.mk.injEq] at hs
      exact ⟨sur, th, hs.1.symm, hc⟩
    | done =>
      simp only [CGoal.toL, simpleNextL, bind_apply, re_apply, emit_apply, Option.bind_some, pure_apply,
        Option.some.injEq, Prod.mk.injEq] at hs
      exact ⟨lazyReg _, _, hs.1.symm, trivial⟩
    | pick z o =>
      simp only [CGoal.toL, simpleNextL, bind_apply, re_apply, emit_apply, Option.bind_some, pure_apply,
        Option.some.injEq, Prod.mk.injEq] at hs
      exact ⟨lazyReg _, _, hs.1.symm, trivial⟩
  obtain ⟨sur, th, rfl, hcl⟩ := hn
  exact clean_n10Body ihv ihq hvp hqp hcl h

