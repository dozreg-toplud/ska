import lemmas.Ska.CompFragUJGen

/-!
# `[7 p q]` with a `p` whose runs make proxies

README Gaps 12.2 (tenth session).  Generated by `tools/gen/sevenv.py` from
`runOKP_n7g`, `runOKN_n7` (`CompFragM.lean`) and the case `seven` of
`runX_clean`; do not edit by hand.  `q` is in `Frag` (no `%6`), so it runs
through `run`, makes no proxy and returns a fork-free `next`, under which `p`
runs with `OKNV`.  `q`'s blocks mention its goal's registers and registers
allocated in its run, no key of any later `cond`, so unproxying leaves them
alone (`run_below`, `run_above`).

* `runOKV_n7g`: `RunOKV` of `[7 p q]` for `%done` and `%pick`.
* `runOKNV_n7`: `RunOKNV` of `[7 p q]` under a fork-free `%next`.
* `seven_tagV`, `seven_tagNV`: the tag clauses (`q` keeps `cond`, `p`'s
  `TagNV`).
* `cleanA_seven`: `CleanA` of `[7 p q]` from `CleanA` of `p`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- **`[7 p q]` for `%done` or `%pick` with a `p` that may make proxies**
(`runOKP_n7g` with `OKNV` of `p`): `q` makes no proxy and its blocks mention
registers allocated in its run, which unproxying leaves alone. -/
theorem runOKV_n7g (lib : Lib) {p q : Nomm} {goal : CGoal S} (hg : NotNext goal) (hq : Frag q goal)
    (hp : OKNV (S := S) (Map := Map) lib p) (hargs : ∀ j, GoalJ goal j → j.args = []) {region : List Nat}
    {g0 g2 : Gen Map} {nex : NextL S} (hj : GJ g0.bo goal) (hcount : sixCount p ≤ 255) (b0 : 1 ≤ g0.bo)
    (d0 : g0.drop = false) (hu : UpBelow g0) (hcl0 : Clear g0) (hcb0 : CondBelow g0)
    (gin : GoalIn g0.re goal) (gab : GoalA (g0.re ≤ ·) goal)
    (h : runL (Nomm.n7 p q) (CGoal.toL goal) region g0 = some (nex, g2)) :
    RunOKV (Map := Map) lib (Nomm.n7 p q) goal g0 g2 nex := by
  rw [runL_n7] at h
  obtain ⟨nx, g, h1, h2⟩ := bind_some h
  rw [runL_frag hq] at h1
  obtain ⟨⟨n, g'⟩, hr, e⟩ := Option.map_eq_some_iff.mp h1
  simp only [Prod.mk.injEq] at e
  obtain ⟨rfl, rfl⟩ := e
  have hok : GoalOK g0 goal := by cases goal with | next => exact hg.elim | _ => trivial
  have hcl : GClean goal := by cases goal with | next => exact hg.elim | _ => trivial
  have Rq := run_ok lib q goal g0 g' n hq hok hcl hr
  have Dq := run_down (S := S) (Map := Map) q goal g0 g' n hj b0 d0 hr
  have dg : g'.drop = false := Rq.ext.2.2.1.trans d0
  have fa : n.th.args = [] := by
    rcases Dq.entry with ⟨_, _, _, fa⟩ | e
    · exact fa
    · exact hargs _ e
  have hcl' : Clean n.laz.ned := run_clean q goal g0 g' n hcl hr
  have hok' : GoalOK g' (CGoal.next n.laz n.th) := ⟨Rq.dist, fun r hr => by
    rcases Rq.regs r hr with h' | h'
    · exact (notNext_gmem hg r h').elim
    · exact h'.2⟩
  have GQ : GrowU g0 g' := Dq.grow.toU hu
  have cq : g'.cond = g0.cond := (kc_run q goal).keep g0 n g' hr
  have cbq : CondBelow g' := (condFresh_of_eq Rq.ext.1 cq).below hcb0
  have hkq : ∀ r, NMem n.laz.ned r → HoonMap.get g'.cond r = Option.none := fun r hr => by
    rw [cq]
    rcases Rq.regs r hr with h' | h'
    · exact (notNext_gmem hg r h').elim
    · exact condBelow_none hcb0 h'.1
  have Rp := hp (sur := n.laz) (th := n.th) (region := region) (g0 := g') (g1 := g2) (nex := nex)
    ⟨Dq.lo, Dq.hi⟩ fa hok' hcl' hcount (Nat.le_trans b0 Dq.grow.bo) dg (GQ.up hu) (hcl0.growU GQ) cbq hkq h2
  have Bq : BelowIn g0.bo g' := run_below d0 gin hr
  have Aq : AboveIn (g0.re ≤ ·) g0.bo g' := run_above d0 gab (ple_le (Nat.le_refl _)) hr
  have l1 := Rq.ext.1
  have l2 := Rp.ext.1
  refine ⟨Rq.ext.trans Rp.ext, GQ.trans Rp.grow, (condFresh_of_eq Rq.ext.1 cq).trans Rp.cfr,
    Rp.lo, Rp.hi, ?_, fun r hr => ?_, Rp.dist, fun e he => ?_, fun e he => ?_, Rp.nodup, ?_,
    fun s hs => ?_, Rp.ncond, Rp.econd, ?_⟩
  · rcases Rp.ent with f | e
    · exact Or.inl f
    · simp only [GoalJ] at e
      rw [e]
      rcases Dq.entry with f' | e'
      · exact Or.inl (f'.growU Dq.hi Rp.grow)
      · exact Or.inr e'
  · rcases Rp.regs r hr with h' | h'
    · rcases Rq.regs r h' with h'' | h''
      · exact (notNext_gmem hg r h'').elim
      · exact ⟨h''.1, by omega⟩
    · exact ⟨by omega, h'.2⟩
  · exact ⟨(Rp.eregs e he).1, fun r hr => by have := (Rp.eregs e he).2 r hr; omega⟩
  · obtain ⟨a, b, c⟩ := Rp.labs e he
    exact ⟨by have := Rq.ext.2.1; omega, b, c⟩
  · simp only [sixCount, sixCount_frag hq]; have := Rp.size; omega
  · rcases Rp.nec s hs with e | ⟨v, e, nf⟩
    · simp [pureEval, e]
    · rcases Rq.nec v nf with e' | ⟨w, _, x⟩
      · simp [pureEval, e, e']
      · exact (notNext_gnot hg w x).elim
  · intro cf hcf c ned σ O st t gul s0 s ag hned regs hh hn
    have agP : AgreeU lib O c gul st t cf ned g' g2 nex.laz s0 s :=
      ⟨fun o h0 h1 hnl => ag.1 o (Nat.le_trans Rq.ext.2.1 h0) h1 hnl, ag.2⟩
    have Sp := Rp.sem cf hcf c ned σ O st t gul s0 s agP hned regs hh hn
    have u0 : ∀ x, x < g'.re → unproxy cf x = unproxy g'.cond x :=
      unproxy_agree (fun k hk => (hcf k (by omega)).trans (Rp.cfr.get_lt hk))
    have u1 : ∀ x, g0.re ≤ x → unproxy g'.cond x = id x := fun x hx => unproxy_none (by rw [cq]; exact condBelow_none hcb0 hx)
    have agQ : Agree c g0 g' := fun o h0 h1 => by
      rw [ag.1 o h0 (Nat.lt_of_lt_of_le h1 Rp.ext.2.1) (fun hm => ?_)]
      · rw [Rp.ext.2.2.2 o h1]
        cases hgb : HoonMap.get g'.blocks o with
        | none => rfl
        | some b =>
          simp only [Option.map_some]
          rw [unproxyBlob, renBlob_congr u0 (Bq o b h0 h1 hgb), renBlob_congr u1 (Aq o b h0 h1 hgb),
            renBlob_id]
      · obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
        have := (Rp.labs e he).1; omega
    show GoalSem lib O c gul st _ regs t nex.th goal (pureEval (Nomm.n7 p q) s)
    cases ev : pureEval p s with
    | none =>
      rw [ev] at Sp
      have e7 : pureEval (Nomm.n7 p q) s = none := by simp [pureEval, ev]
      rw [e7]; exact goalSem_none _ Sp
    | some v =>
      rw [ev] at Sp
      have e7 : pureEval (Nomm.n7 p q) s = pureEval q v := by simp [pureEval, ev]
      rw [e7]
      by_cases f : FitsS n.laz v
      · obtain ⟨R, hR, kR, e⟩ := Sp.1 f
        have Sq := Rq.sem d0 c agQ σ O st v R t gul ⟨hR, f.2⟩
        refine goalSem_pre (fun r hr => kR r ⟨?_, ?_⟩) e _ _ (goalSem_mono (fun r hr => ?_) _ _ Sq)
        · rcases hr with h' | h'
          · exact Or.inl (by omega)
          · exact Or.inr h'
        · intro hm
          rcases Rq.regs r hm with h' | h'
          · exact notNext_gmem hg r h'
          · rcases hr with h'' | h''
            · omega
            · have := hned r h''; omega
        · refine ⟨?_, notNext_gmem hg r⟩
          rcases hr with h' | h'
          · exact Or.inl h'
          · have := hned r h'; exact Or.inr (by omega)
      · rcases Rq.nec v f with e' | ⟨w, _, x⟩
        · rw [e']; exact goalSem_none _ (Sp.2 f)
        · exact (notNext_gnot hg w x).elim

/-- **`[7 p q]` under a fork-free `%next` with a `p` that may make
proxies** (`runOKN_n7` with `OKNV` of `p`): `q`'s blocks mention the goal's
registers (no keys, `hkg`) and registers allocated in its run. -/
theorem runOKNV_n7 (lib : Lib) {p q : Nomm} {sur : Sure S} {th : Jmp} (hq : Frag q (CGoal.next sur th))
    (hp : OKNV (S := S) (Map := Map) lib p) {region : List Nat} {g0 g2 : Gen Map} {nex : NextL S}
    (hj : GJ g0.bo (CGoal.next sur th)) (hth : th.args = []) (hok : GoalOK g0 (CGoal.next sur th))
    (hcl : Clean sur.ned) (hcount : sixCount p ≤ 255) (b0 : 1 ≤ g0.bo) (d0 : g0.drop = false) (hu : UpBelow g0)
    (hcl0 : Clear g0) (hcb0 : CondBelow g0) (hkg : ∀ r, NMem sur.ned r → HoonMap.get g0.cond r = Option.none)
    (h : runL (Nomm.n7 p q) (CGoalL.next (ofSure sur) th) region g0 = some (nex, g2)) :
    RunOKNV (Map := Map) lib (Nomm.n7 p q) sur th g0 g2 nex := by
  rw [runL_n7] at h
  obtain ⟨nx, g, h1, h2⟩ := bind_some h
  rw [show (CGoalL.next (ofSure sur) th : CGoalL S) = CGoal.toL (CGoal.next sur th) from rfl, runL_frag hq] at h1
  obtain ⟨⟨n, g'⟩, hr, e⟩ := Option.map_eq_some_iff.mp h1
  simp only [Prod.mk.injEq] at e
  obtain ⟨rfl, rfl⟩ := e
  have Rq := run_ok lib q _ g0 g' n hq hok hcl hr
  have Dq := run_down (S := S) (Map := Map) q _ g0 g' n hj b0 d0 hr
  have dg : g'.drop = false := Rq.ext.2.2.1.trans d0
  have fa : n.th.args = [] := by
    rcases Dq.entry with ⟨_, _, _, fa⟩ | e
    · exact fa
    · simp only [GoalJ] at e; rw [e]; exact hth
  have hcl' : Clean n.laz.ned := run_clean q (CGoal.next sur th) g0 g' n hcl hr
  have hok' : GoalOK g' (CGoal.next n.laz n.th) := ⟨Rq.dist, fun r hr => by
    rcases Rq.regs r hr with h' | h'
    · exact Nat.lt_of_lt_of_le (hok.2 r h') Rq.ext.1
    · exact h'.2⟩
  have GQ : GrowU g0 g' := Dq.grow.toU hu
  have cq : g'.cond = g0.cond := (kc_run q _).keep g0 n g' hr
  have cbq : CondBelow g' := (condFresh_of_eq Rq.ext.1 cq).below hcb0
  have hkq : ∀ r, NMem n.laz.ned r → HoonMap.get g'.cond r = Option.none := fun r hr => by
    rw [cq]
    rcases Rq.regs r hr with h' | h'
    · exact hkg r h'
    · exact condBelow_none hcb0 h'.1
  have Rp := hp (sur := n.laz) (th := n.th) (region := region) (g0 := g') (g1 := g2) (nex := nex)
    ⟨Dq.lo, Dq.hi⟩ fa hok' hcl' hcount (Nat.le_trans b0 Dq.grow.bo) dg (GQ.up hu) (hcl0.growU GQ) cbq hkq h2
  have Bq : BelowIn g0.bo g' := run_below (goal := CGoal.next sur th) d0 ⟨fun r hr => hok.2 r hr, jmpIn_nil hth⟩ hr
  have Aq : AboveIn (fun r => HoonMap.get g0.cond r = Option.none) g0.bo g' :=
    run_above (goal := CGoal.next sur th) d0 ⟨hkg, jmpIn_nil hth⟩ (fun r hr => condBelow_none hcb0 hr) hr
  have l1 := Rq.ext.1
  have l2 := Rp.ext.1
  refine ⟨Rq.ext.trans Rp.ext, GQ.trans Rp.grow, (condFresh_of_eq Rq.ext.1 cq).trans Rp.cfr,
    Rp.lo, Rp.hi, ?_, fun r hr => ?_, Rp.dist, fun e he => ?_, fun e he => ?_, Rp.nodup, ?_,
    fun s hs => ?_, Rp.ncond, Rp.econd, ?_⟩
  · rcases Rp.ent with f | e
    · exact Or.inl f
    · simp only [GoalJ] at e
      rw [e]
      rcases Dq.entry with f' | e'
      · exact Or.inl (f'.growU Dq.hi Rp.grow)
      · exact Or.inr e'
  · rcases Rp.regs r hr with h' | h'
    · rcases Rq.regs r h' with h'' | h''
      · exact Or.inl h''
      · exact Or.inr ⟨h''.1, by omega⟩
    · exact Or.inr ⟨by omega, h'.2⟩
  · exact ⟨(Rp.eregs e he).1, fun r hr => by have := (Rp.eregs e he).2 r hr; omega⟩
  · obtain ⟨a, b, c⟩ := Rp.labs e he
    exact ⟨by have := Rq.ext.2.1; omega, b, c⟩
  · simp only [sixCount, sixCount_frag hq]; have := Rp.size; omega
  · rcases Rp.nec s hs with e | ⟨v, e, nf⟩
    · left; simp [pureEval, e]
    · rcases Rq.nec v nf with e' | ⟨w, e', x⟩
      · left; simp [pureEval, e, e']
      · right; exact ⟨w, by simp [pureEval, e, e'], x⟩
  · intro cf hcf c ned σ O st t gul s0 s ag hned regs hh hn
    have agP : AgreeU lib O c gul st t cf ned g' g2 nex.laz s0 s :=
      ⟨fun o h0 h1 hnl => ag.1 o (Nat.le_trans Rq.ext.2.1 h0) h1 hnl, ag.2⟩
    have Sp := Rp.sem cf hcf c ned σ O st t gul s0 s agP hned regs hh hn
    have u0 : ∀ x, x < g'.re → unproxy cf x = unproxy g'.cond x :=
      unproxy_agree (fun k hk => (hcf k (by omega)).trans (Rp.cfr.get_lt hk))
    have u1 : ∀ x, HoonMap.get g0.cond x = Option.none → unproxy g'.cond x = id x := fun x hx => unproxy_none (by rw [cq]; exact hx)
    have agQ : Agree c g0 g' := fun o h0 h1 => by
      rw [ag.1 o h0 (Nat.lt_of_lt_of_le h1 Rp.ext.2.1) (fun hm => ?_)]
      · rw [Rp.ext.2.2.2 o h1]
        cases hgb : HoonMap.get g'.blocks o with
        | none => rfl
        | some b =>
          simp only [Option.map_some]
          rw [unproxyBlob, renBlob_congr u0 (Bq o b h0 h1 hgb), renBlob_congr u1 (Aq o b h0 h1 hgb),
            renBlob_id]
      · obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
        have := (Rp.labs e he).1; omega
    show GoalSem lib O c gul st _ regs t nex.th (CGoal.next sur th) (pureEval (Nomm.n7 p q) s)
    cases ev : pureEval p s with
    | none =>
      rw [ev] at Sp
      have e7 : pureEval (Nomm.n7 p q) s = none := by simp [pureEval, ev]
      rw [e7]; exact goalSem_none _ Sp
    | some v =>
      rw [ev] at Sp
      have e7 : pureEval (Nomm.n7 p q) s = pureEval q v := by simp [pureEval, ev]
      rw [e7]
      by_cases f : FitsS n.laz v
      · obtain ⟨R, hR, kR, e⟩ := Sp.1 f
        have Sq := Rq.sem d0 c agQ σ O st v R t gul ⟨hR, f.2⟩
        refine goalSem_pre (fun r hr => kR r ⟨?_, ?_⟩) e _ _ (goalSem_mono (fun r hr => ?_) _ _ Sq)
        · rcases hr.1 with h' | h'
          · exact Or.inl (by omega)
          · exact Or.inr h'
        · intro hm
          rcases Rq.regs r hm with h' | h'
          · exact hr.2 h'
          · rcases hr.1 with h'' | h''
            · omega
            · have := hned r h''; omega
        · simp only [Keep, GMem]
          refine ⟨?_, hr.2⟩
          rcases hr.1 with h' | h'
          · exact Or.inl h'
          · have := hned r h'; exact Or.inr (by omega)
      · rcases Rq.nec v f with e' | ⟨w, e', x⟩
        · rw [e']; exact goalSem_none _ (Sp.2 f)
        · rw [e']; exact ⟨fun fw => absurd fw x, fun _ => Sp.2 f⟩

/-- **The tag clause of `[7 p q]` for `%done` or `%pick`.** -/
theorem seven_tagV (lib : Lib) {p q : Nomm} {goal : CGoal S} (hg : NotNext goal) (hq : Frag q goal)
    (tp : TagNV (S := S) (Map := Map) p) (hargs : ∀ j, GoalJ goal j → j.args = []) {region : List Nat}
    {g0 g2 : Gen Map} {nex : NextL S} (hj : GJ g0.bo goal) (hcount : sixCount p ≤ 255) (b0 : 1 ≤ g0.bo)
    (d0 : g0.drop = false) (hu : UpBelow g0) (hcl0 : Clear g0) (hcb0 : CondBelow g0)
    (gin : GoalIn g0.re goal) (gab : GoalA (g0.re ≤ ·) goal)
    (h : runL (Nomm.n7 p q) (CGoal.toL goal) region g0 = some (nex, g2)) :
    CondTag region g0.cond g2.cond := by
  rw [runL_n7] at h
  obtain ⟨nx, g, h1, h2⟩ := bind_some h
  rw [runL_frag hq] at h1
  obtain ⟨⟨n, g'⟩, hr, e⟩ := Option.map_eq_some_iff.mp h1
  simp only [Prod.mk.injEq] at e
  obtain ⟨rfl, rfl⟩ := e
  have hok : GoalOK g0 goal := by cases goal with | next => exact hg.elim | _ => trivial
  have hcl : GClean goal := by cases goal with | next => exact hg.elim | _ => trivial
  have Rq := run_ok lib q goal g0 g' n hq hok hcl hr
  have Dq := run_down (S := S) (Map := Map) q goal g0 g' n hj b0 d0 hr
  have dg : g'.drop = false := Rq.ext.2.2.1.trans d0
  have fa : n.th.args = [] := by
    rcases Dq.entry with ⟨_, _, _, fa⟩ | e
    · exact fa
    · exact hargs _ e
  have hcl' : Clean n.laz.ned := run_clean q goal g0 g' n hcl hr
  have hok' : GoalOK g' (CGoal.next n.laz n.th) := ⟨Rq.dist, fun r hr => by
    rcases Rq.regs r hr with h' | h'
    · exact (notNext_gmem hg r h').elim
    · exact h'.2⟩
  have GQ : GrowU g0 g' := Dq.grow.toU hu
  have cq : g'.cond = g0.cond := (kc_run q goal).keep g0 n g' hr
  have cbq : CondBelow g' := (condFresh_of_eq Rq.ext.1 cq).below hcb0
  have hkq : ∀ r, NMem n.laz.ned r → HoonMap.get g'.cond r = Option.none := fun r hr => by
    rw [cq]
    rcases Rq.regs r hr with h' | h'
    · exact (notNext_gmem hg r h').elim
    · exact condBelow_none hcb0 h'.1
  have Tp := tp (sur := n.laz) (th := n.th) (region := region) (g0 := g') (g1 := g2) (nex := nex)
    ⟨Dq.lo, Dq.hi⟩ fa hok' hcl' hcount (Nat.le_trans b0 Dq.grow.bo) dg (GQ.up hu) (hcl0.growU GQ) cbq hkq h2
  exact (CondTag.of_eq cq).trans Tp

/-- **The tag clause of `[7 p q]` under a fork-free `%next`.** -/
theorem seven_tagNV (lib : Lib) {p q : Nomm} {sur : Sure S} {th : Jmp} (hq : Frag q (CGoal.next sur th))
    (tp : TagNV (S := S) (Map := Map) p) {region : List Nat} {g0 g2 : Gen Map} {nex : NextL S}
    (hj : GJ g0.bo (CGoal.next sur th)) (hth : th.args = []) (hok : GoalOK g0 (CGoal.next sur th))
    (hcl : Clean sur.ned) (hcount : sixCount p ≤ 255) (b0 : 1 ≤ g0.bo) (d0 : g0.drop = false) (hu : UpBelow g0)
    (hcl0 : Clear g0) (hcb0 : CondBelow g0) (hkg : ∀ r, NMem sur.ned r → HoonMap.get g0.cond r = Option.none)
    (h : runL (Nomm.n7 p q) (CGoalL.next (ofSure sur) th) region g0 = some (nex, g2)) :
    CondTag region g0.cond g2.cond := by
  rw [runL_n7] at h
  obtain ⟨nx, g, h1, h2⟩ := bind_some h
  rw [show (CGoalL.next (ofSure sur) th : CGoalL S) = CGoal.toL (CGoal.next sur th) from rfl, runL_frag hq] at h1
  obtain ⟨⟨n, g'⟩, hr, e⟩ := Option.map_eq_some_iff.mp h1
  simp only [Prod.mk.injEq] at e
  obtain ⟨rfl, rfl⟩ := e
  have Rq := run_ok lib q _ g0 g' n hq hok hcl hr
  have Dq := run_down (S := S) (Map := Map) q _ g0 g' n hj b0 d0 hr
  have dg : g'.drop = false := Rq.ext.2.2.1.trans d0
  have fa : n.th.args = [] := by
    rcases Dq.entry with ⟨_, _, _, fa⟩ | e
    · exact fa
    · simp only [GoalJ] at e; rw [e]; exact hth
  have hcl' : Clean n.laz.ned := run_clean q (CGoal.next sur th) g0 g' n hcl hr
  have hok' : GoalOK g' (CGoal.next n.laz n.th) := ⟨Rq.dist, fun r hr => by
    rcases Rq.regs r hr with h' | h'
    · exact Nat.lt_of_lt_of_le (hok.2 r h') Rq.ext.1
    · exact h'.2⟩
  have GQ : GrowU g0 g' := Dq.grow.toU hu
  have cq : g'.cond = g0.cond := (kc_run q _).keep g0 n g' hr
  have cbq : CondBelow g' := (condFresh_of_eq Rq.ext.1 cq).below hcb0
  have hkq : ∀ r, NMem n.laz.ned r → HoonMap.get g'.cond r = Option.none := fun r hr => by
    rw [cq]
    rcases Rq.regs r hr with h' | h'
    · exact hkg r h'
    · exact condBelow_none hcb0 h'.1
  have Tp := tp (sur := n.laz) (th := n.th) (region := region) (g0 := g') (g1 := g2) (nex := nex)
    ⟨Dq.lo, Dq.hi⟩ fa hok' hcl' hcount (Nat.le_trans b0 Dq.grow.bo) dg (GQ.up hu) (hcl0.growU GQ) cbq hkq h2
  exact (CondTag.of_eq cq).trans Tp

/-- **`CleanA` of `[7 p q]` with `q` in `Frag` from `CleanA` of `p`** (the
case of `runX_clean`). -/
theorem cleanA_seven {p q : Nomm} (hq : ∀ goal : CGoal S, Frag q goal) (ih : CleanA S Map p) :
    CleanA S Map (Nomm.n7 p q) := by
  intro goal region g0 g1 nex hc h
  rw [runL_n7] at h
  obtain ⟨nx, g, h1, h2⟩ := bind_some h
  rw [runL_frag (hq goal)] at h1
  obtain ⟨⟨n, g'⟩, hr, e⟩ := Option.map_eq_some_iff.mp h1
  simp only [Prod.mk.injEq] at e
  obtain ⟨rfl, rfl⟩ := e
  exact ih (goal := CGoal.next n.laz n.th) (run_clean _ goal _ _ n hc hr) h2

