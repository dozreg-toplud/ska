import lemmas.Ska.BakeNeed

/-!
# `+bake-need` and the n-ary final pass with a bake against the real compiler

Generated by `tools/gen/bakecheck.py` from the output of
`tools/hoon/bakedump.hoon` (part A, README Gaps 9, the MAP of 2026-11-27):
for each bell `[[cape data] formula]` of call-free code, the real arms of the
final pass of `member` (`+run`, `+shape-collapse`, `+collapse-shape`,
`+bake-need`, `+bake-need-ord`, `+coerce-lazy`, `+add-ops`, `+to-straight`).
Per case:
* `bakeNeed` of the dumped `ned-final` and sock is the dumped `bak`;
* `bakeNeedOrd` of the dumped shape is the dumped `+bake-need-ord` and the
  `+need-to-ordered` of `ned.bak`;
* the model's whole final pass `finishLF` with `bakeNeed` gives the dumped
  straight (its need, argument count and every block, as nouns); where the
  residual registers are not a run (`MP`, the map path of `+to-straight`,
  case `%m03`), the need, the argument count and block `0` (the prologue
  with the immediates): there `+to-straight` numbers the registers that are
  not arguments in the order of its `~(rep by blocks)`, which the model
  takes from `HoonMapKeys` (the order of `FM` here, not the treap's), and
  the other blocks agree up to that numbering;
* a subject that does not have the cells of the residual need gives a
  crash (the caller's fetch crashes);
* the model's code run by the model's interpreter (`execEntry`, the
  arguments the leaves of the residual need in preorder) agrees with
  `minkF` on the formula, on three subjects that fit the sock (its data with
  the unknown parts as dumped, replaced by the cell `[11 12]`, and by `13`).
-/

namespace Formalization
namespace SkaModel
namespace Comp
namespace BakeCheck

open Nock

def capeOf : Noun → Cape
  | Noun.atom 0 => Cape.yes
  | Noun.atom _ => Cape.no
  | Noun.cell h t => Cape.cell (capeOf h) (capeOf t)

def sockOf : Noun → Sock
  | Noun.cell c d => Sock.mk (capeOf c) d
  | Noun.atom _ => Sock.void

def needOf : Noun → Option Need
  | Noun.cell (Noun.atom t) (Noun.atom r) =>
    if t = Tag.this then some (Need.this r) else if t = Tag.none then some Need.none else none
  | Noun.cell (Noun.atom t) (Noun.cell (Noun.atom r) (Noun.cell h tl)) =>
    if t = Tag.both then (needOf h).bind fun a => (needOf tl).map fun b => Need.both r a b else none
  | Noun.cell p q => (needOf p).bind fun a => (needOf q).map fun b => Need.pair a b
  | Noun.atom _ => none

def ordOf : Noun → Option NeedOrd
  | Noun.cell (Noun.atom t) (Noun.atom _) =>
    if t = Tag.this then some NeedOrd.this else if t = Tag.none then some NeedOrd.none else none
  | Noun.cell (Noun.atom t) (Noun.cell h tl) =>
    if t = Tag.both then (ordOf h).bind fun a => (ordOf tl).map fun b => NeedOrd.both a b else none
  | Noun.cell p q => (ordOf p).bind fun a => (ordOf q).map fun b => NeedOrd.pair a b
  | Noun.atom _ => none

def nommOf : Noun → Option Nomm
  | Noun.cell (Noun.cell a b) q => (nommOf (Noun.cell a b)).bind fun x => (nommOf q).map fun y => Nomm.cons x y
  | Noun.cell (Noun.atom 0) (Noun.atom p) => some (Nomm.n0 p)
  | Noun.cell (Noun.atom 1) x => some (Nomm.n1 x)
  | Noun.cell (Noun.atom 3) p => (nommOf p).map Nomm.n3
  | Noun.cell (Noun.atom 4) p => (nommOf p).map Nomm.n4
  | Noun.cell (Noun.atom 5) (Noun.cell p q) => (nommOf p).bind fun x => (nommOf q).map fun y => Nomm.n5 x y
  | Noun.cell (Noun.atom 6) (Noun.cell p (Noun.cell q r)) =>
    (nommOf p).bind fun x => (nommOf q).bind fun y => (nommOf r).map fun z => Nomm.n6 x y z
  | Noun.cell (Noun.atom 7) (Noun.cell p q) => (nommOf p).bind fun x => (nommOf q).map fun y => Nomm.n7 x y
  | Noun.cell (Noun.atom 10) (Noun.cell (Noun.cell (Noun.atom a) v) q) =>
    (nommOf v).bind fun x => (nommOf q).map fun y => Nomm.n10 a x y
  | _ => none

/-- The arguments of a function with the need `n` on the subject `s`: the
leaves in preorder, a `%both` before its halves. -/
def argsOf : NeedOrd → Noun → Option (List Noun)
  | NeedOrd.none, _ => some []
  | NeedOrd.this, s => some [s]
  | NeedOrd.pair p q, Noun.cell a b => (argsOf p a).bind fun x => (argsOf q b).map fun y => x ++ y
  | NeedOrd.both h t, Noun.cell a b =>
    (argsOf h a).bind fun x => (argsOf t b).map fun y => Noun.cell a b :: (x ++ y)
  | _, Noun.atom _ => none

def lib0 : Lib := ⟨fun _ _ => none, fun _ => none, fun _ _ => none, fun _ => A 0⟩

/-- The oracle that answers no call (the code here makes none). -/
def silent0 : Oracle Unit := ⟨fun _ _ _ _ _ _ => none, fun _ _ _ _ => none⟩

def product : Option Tone → Option Noun
  | some (Tone.zero v) => some v
  | _ => none

/-- The final pass of the model with the bake, as nouns. -/
def passN (nm : Nomm) (ord : NeedOrd) (less : Sock) (n : Nat) : Option (Noun × Nat × List (Nat × Option Noun)) :=
  (finishLF (S := LS) (Map := FM) nm ord (sockCape less) (fun x => bakeNeed x less)).map fun c =>
    (c.need.toNoun, c.nargs, (List.range n).map fun k => (k, (c.blocks.f k).map Blob.toNoun))

/-- The model's code against `+mink` on the subject `s`. -/
def semOK (nm : Nomm) (ord : NeedOrd) (less : Sock) (fol s : Noun) : Bool :=
  match finishLF (S := LS) (Map := FM) nm ord (sockCape less) (fun x => bakeNeed x less) with
  | none => false
  | some c =>
    let ran := match argsOf c.need s with
      | none => none
      | some vs => product ((execEntry lib0 silent0 () c vs [] (A 0)).map Prod.fst)
    ran == product (minkF lib0 (A 0) 1000 [] s fol)

/-- One case: the decoders invert `toNoun`, the bake, the shapes, the pass,
and the semantics on the subjects. -/
def check (LESS NOM ORD NEDF BAK BNO NTO SNEED : Noun) (NARGS : Nat) (MP : Bool) (BLOCKS : List (Nat × Option Noun))
    (FOL : Noun) (SUBS : List Noun) : Bool :=
  let less := sockOf LESS
  match nommOf NOM, ordOf ORD, needOf NEDF with
  | some nm, some ord, some nedF =>
    nm.toNoun == NOM && ord.toNoun == ORD && nedF.toNoun == NEDF &&
    bakedNoun (bakeNeed nedF less) == BAK &&
    (bakeNeedOrd ord less).toNoun == BNO && (bakeNeedOrd ord less).toNoun == NTO &&
    (if MP then (passN nm ord less BLOCKS.length).map (fun p => (p.1, p.2.1, p.2.2.head?)) == some (SNEED, NARGS, BLOCKS.head?)
     else passN nm ord less BLOCKS.length == some (SNEED, NARGS, BLOCKS)) &&
    SUBS.all fun s => semOK nm ord less FOL s
  | _, _, _ => false

