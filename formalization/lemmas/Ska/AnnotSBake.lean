import lemmas.Ska.AnnotSKnow
import lemmas.Ska.AnnotSPoke

/-!
# `InvBSR`: the bake keeps `CodeOKS` (track Q, README Gaps 27)

Generated by `tools/gen/annots_bake.py` from `variant_annot`
(`BakeGraph.lean`) and `skaPokeB_sound` (`PokeBake.lean`).

`variant_annotK`: a variant of the final pass of `+bake-graph`, from a datum
whose nomm satisfies `AnnotK` (the analysis's, `pokeDat_annotK`), satisfies
`AnnotS` (`know_annotK`: `+know` keeps `DetK` or `KC`, so a droppable folded
formula part returns).

`skaPokeB_soundK`: a whole poke keeps `InvB` (by `skaPokeB_sound`), the
ghost `PokeInvK` of the memo (by `skaPoke_soundK`; its table need not be the
ghost table of `InvB`), and `CodeOKS` of the real table: an old entry by
`Glue.AnnotS.mono_code`, a new variant by `variant_annotK` on the subjects of
its bake.
-/

namespace Formalization
namespace SkaModel

open Nock Ana AnnotSF

namespace Bake

variable {M : Type → Type → Type} [Treap M] {R : Type}

theorem variant_annotK {lib : Lib} {code code' : Bell → Option Nomm} {E : BEnv M} {n : Nat} {st : BSt M}
    (hc : CodeOK lib code) (hdat : DatOK lib E.dat)
    (hloop : bakeLoop E n [E.root] (Treap.put Treap.empty E.root ()) (bakeInit E) = some st)
    (hvars : ∀ c v, Treap.has (Treap.gut E.vars c Treap.empty) v = true → v.fol = c.fol ∧ ∃ nb, code' v = some nb)
    (hcode : ∀ c s, Treap.get st.bak c = some s → ∃ nb, code' ⟨s, c.fol⟩ = some nb)
    {t : Bell} {s : Sock} {d : Datum} {nomm : Nomm} {sites : List Site}
    (hd : E.dat t = some d) (hs : Treap.get st.bak t = some s) (hA : AnnotK lib code (Fits t.less) t.fol d.nomm)
    (hk : know E.fold d.nomm s E.dat (bakeRes E st) = some (nomm, sites)) :
    Glue.AnnotS lib code' (fun x => Fits t.less x ∧ Fits s x) t.fol nomm :=
  know_annotK hc hdat hA hk (bakeRes_ok hloop hvars hcode hd hs hk)

theorem skaPokeB_soundK {lib : Lib} (hK : FolTopK lib) (env : Env R) {jet : (Bell → Option Datum) → R → Bell → Bool}
    {fold frozen : Bool} {n : Nat} {bf : BEnv M → Nat} {root : Ident} {L L' : LongB M} {reg reg' : R} {rb : Bell}
    (hinv : InvB lib L) (hpk : ∃ code, PokeInvK lib L.memo code)
    (hS : Glue.CodeOKS lib (realOf L.code)) (hw : WellFormed root.1) (hnr : NormSock root.1) (hnvr : root.1 ≠ Sock.void)
    (h : skaPokeB env jet fold frozen n bf root L reg = some (rb, L', reg')) :
    InvB lib L' ∧ (∃ code, PokeInvK lib L'.memo code) ∧ Glue.CodeOKS lib (realOf L'.code) ∧
      ∃ nb, realOf L'.code rb = some nb := by
  have hB := skaPokeB_sound env hinv hw hnr hnvr h
  obtain ⟨code, hpi⟩ := hpk
  unfold skaPokeB at h
  simp only [Option.bind_eq_some_iff, Option.map_eq_some_iff] at h
  obtain ⟨⟨pr, dats, memo', rd, reg''⟩, hsk, ⟨baked, vars'⟩, hbg, he⟩ := h
  simp only [Prod.mk.injEq] at he
  obtain ⟨rfl, rfl, rfl⟩ := he
  dsimp only at hbg ⊢
  generalize hE : pokeEnv (jet (pokeDat dats memo') reg'') fold frozen L.vars root dats memo' rd = E at hbg
  have himpE := bakesImply E
  -- the analysis
  obtain ⟨hpi', hdsK⟩ := skaPoke_soundK hK env hpi hw hnr hnvr hsk
  have hds := skaPoke_dats env hpi.base hw hnr hnvr hsk
  have hlk' : LessKeys memo' := by
    unfold skaPoke at hsk
    simp only [Option.bind_eq_some_iff, Option.map_eq_some_iff] at hsk
    obtain ⟨_, _, pr', _, _, _, he⟩ := hsk
    simp only [Prod.mk.injEq] at he
    obtain ⟨-, -, rfl, -, -⟩ := he
    exact lessKeys_pokeMemo _ hinv.lessKeys
  obtain ⟨hdatOK, -⟩ := pokeDat_ok hpi'.base hlk' hds
  have hA := pokeDat_annotK hpi' hlk' hdsK
  have hEdat : E.dat = pokeDat dats memo' := by rw [← hE]; rfl
  have hEvars : E.vars = L.vars := by rw [← hE]; rfl
  rw [← hEdat] at hdatOK hA
  -- the bake
  unfold bakeGraph at hbg
  simp only [Option.bind_eq_some_iff] at hbg
  obtain ⟨st, hloop, hfin⟩ := hbg
  obtain ⟨f1, -, f3, -⟩ := finalFold_spec E st _ _ _ _ _ hfin
  generalize hc' : realOf (addCode L.code (newCode L.code baked)) = code'
  have hold : ∀ bl nb, realOf L.code bl = some nb → ∃ nb', code' bl = some nb' := by
    rw [← hc']; exact realOf_add_old
  have hbake : ∀ c s, Treap.get st.bak c = some s → ∃ nb, code' ⟨s, c.fol⟩ = some nb := by
    intro c s hs
    have := f3 (c, s) ((Treap.mem_rap _ _ _).mpr hs)
    obtain ⟨ve, hve⟩ := Option.isSome_iff_exists.mp this
    rw [← hc', realOf_add]
    cases hr : realOf L.code ⟨s, c.fol⟩ with
    | some nb => exact ⟨nb, rfl⟩
    | none =>
      have : Treap.get baked ⟨s, c.fol⟩ = some ve := by
        simpa [Treap.get_empty] using hve
      exact ⟨ve.nomm, by simp [this]⟩
  have hvars : ∀ c v, Treap.has (Treap.gut E.vars c Treap.empty) v = true → v.fol = c.fol ∧ ∃ nb, code' v = some nb := by
    intro c v hv
    rw [hEvars] at hv
    obtain ⟨hf, nb, hnb⟩ := hinv.vars c v hv
    exact ⟨hf, hold v nb hnb⟩
  have hcodeOK : Glue.CodeOKS lib code' := by
    intro bl nb hb
    have hb' := hb
    rw [← hc', realOf_add] at hb'
    split at hb'
    · rename_i nb0 hr
      cases hb'
      exact (hS bl _ hr).mono_code hold
    · simp only [Option.map_eq_some_iff] at hb'
      obtain ⟨ve, hve, rfl⟩ := hb'
      rcases f1 bl ve hve with h0 | ⟨e, hel, rfl, d, sites, hd, hk⟩
      · simp [Treap.get_empty] at h0
      · have hs : Treap.get st.bak e.1 = some e.2 := (Treap.mem_rap _ _ _).mp hel
        have hva := variant_annotK (code := extendCode code dats) (code' := code') hpi'.base.codeOK hdatOK hloop
          hvars hbake hd hs (hA e.1 d hd) hk
        exact hva.mono fun x hx => ⟨himpE _ st hloop e.1 e.2 hs x hx, hx⟩
  refine ⟨hB.1, ⟨_, hpi'⟩, hcodeOK, ?_⟩
  rw [← hc', ← hE]; exact hB.2

end Bake

end SkaModel
end Formalization
