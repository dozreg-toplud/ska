import lemmas.Ska.CompSixNextV
import lemmas.Ska.CompConsV

/-!
# The clean and tag clauses of `%6` and cons with proxy runs

README Gaps 12.2 (tenth session).  Generated by `tools/gen/fraguj.py` from
the openings of `runX_clean` (`cleanA_six`, `cleanA_cons`), `sixNext_okNV`
(`sixNext_tagNV`), `sixP_okV` (`sixP_tagV`), `consNV_body` (`cons_tagNV`)
and `runOKV_consP` (`cons_tagP`): each opening establishes the hypotheses at
the start of every part, then the parts' clauses are chained.  Do not edit by
hand: change the script and rerun it.

* `TagV goal nm`: with the hypotheses of `OKV`, every key a run adds to
  `cond` has a tag with its region as a suffix (`TagNV` for `%done` and
  `%pick`).
* `cleanA_six`, `cleanA_cons`: `CleanA` of `%6` from `CleanA` of its test,
  of cons from `CleanA` of its parts.
* `sixNext_tagNV`, `sixP_tagV`: the tag clauses of `%6` from those of its
  parts; the branches under `%next` run in the region `rid :: region`, which
  `Sfx.tail` weakens to `region`, `+fork-sure`, `+sect` and `+copy` keep
  `cond`.
* `cons_tagNV`, `cons_tagP`: the tag clauses of cons; `+split`, the
  `[%bom ~]` block and `+copy` keep `cond`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Formalization
namespace SkaModel
namespace Comp

open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- **The tag clause of a run for `%done` or `%pick`**, with the hypotheses
of `OKV`: every key it adds to `cond` has a tag with its region as a
suffix. -/
abbrev TagV (goal : CGoal S) (nm : Nomm) : Prop :=
  ∀ {region : List Nat} {g0 g1 : Gen Map} {nex : NextL S}, NotNext goal → GJ g0.bo goal →
    sixCount nm ≤ 255 → 1 ≤ g0.bo → g0.drop = false → UpBelow g0 → Clear g0 → CondBelow g0 →
    runL nm (CGoal.toL goal) region g0 = some (nex, g1) → CondTag region g0.cond g1.cond

/-- **`CleanA` of `%6` from `CleanA` of its test** (the case of
`runX_clean`): the sure need of the result is that of the test's run for
`%pick`, copied. -/
theorem cleanA_six {c : Nomm} (a b : Nomm) (hcp : c.pure = true) (ihc : CleanA S Map c) :
    CleanA S Map (Nomm.n6 c a b) := by
  intro goal region g0 g1 nex hc h
  cases goal with
  | next sur th =>
    simp only [CGoal.toL] at h
    rw [runL_n6_next, sixNextL_ofSure] at h
    simp only [sixNextSimple] at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨⟨lz, yes, nuh⟩, gS, hS, h⟩ := bind_some h
    obtain ⟨lz', gP, hP, h⟩ := bind_some h
    simp only [liftO, pastFork_pure _ _ hcp, Option.map_some, Option.some.injEq, Prod.mk.injEq] at hP
    obtain ⟨rfl, rfl⟩ := hP
    obtain ⟨xc, gC, hC, h⟩ := bind_some h
    exact clean_sixTail h (ihc (goal := CGoal.pick _ _) trivial hC) (by rw [sect_sure hS]; trivial)
  | done => exact clean_sixBody (goal := CGoal.done) hcp (fun hC => ihc (goal := CGoal.pick _ _) trivial hC) trivial h
  | pick z o =>
    exact clean_sixBody (goal := CGoal.pick z o) hcp (fun hC => ihc (goal := CGoal.pick _ _) trivial hC) trivial h

/-- **`CleanA` of cons from `CleanA` of its parts** (the case of
`runX_clean`). -/
theorem cleanA_cons {p q : Nomm} (hpp : p.pure = true) (hqp : q.pure = true) (ihp : CleanA S Map p)
    (ihq : CleanA S Map q) : CleanA S Map (Nomm.cons p q) := by
  intro goal region g0 g1 nex hc h
  cases goal with
  | next sur th =>
    simp only [CGoal.toL] at h
    rw [runL_cons_next] at h
    exact clean_consBody ihp ihq hpp hqp hc h
  | done =>
    simp only [CGoal.toL] at h
    rw [runL_cons_done] at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    rw [runL_cons_next] at h
    exact clean_consBody (sur := lazyReg _) ihp ihq hpp hqp trivial h
  | pick z o =>
    simp only [CGoal.toL] at h
    rw [runL_cons_pick] at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨nex2, _, h3, h⟩ := bind_some h
    obtain ⟨nex2', _, hp2, h⟩ := bind_some h
    rw [pastL_pure _ _ hpp, pure_apply] at hp2
    simp only [Option.some.injEq, Prod.mk.injEq] at hp2
    obtain ⟨rfl, rfl⟩ := hp2
    obtain ⟨nex1, _, h4, h⟩ := bind_some h
    exact clean_copyL h (ihp (goal := CGoal.next Sure.bunt _) trivial h4)
      (ihq (goal := CGoal.next Sure.bunt _) trivial h3)

/-- **The tag clause of `%6` under a fork-free `%next`**: `+fork-sure` keeps
`cond`, the branches run in the region `gF.id :: region` (`TagNV`, weakened
by `Sfx.tail`), `+sect` keeps `cond` (`sect_specV`), the test runs for
`%pick` in `region` (`TagV`), `+copy` keeps `cond`. -/
theorem sixNext_tagNV (lib : Lib) {c a b : Nomm} (hcp : c.pure = true)
    (tgc : ∀ z o : Jmp, z.args = [] → o.args = [] → TagV (Map := Map) (CGoal.pick z o : CGoal S) c)
    (iha : OKNV (S := S) (Map := Map) lib a) (ihb : OKNV (S := S) (Map := Map) lib b)
    (tga : TagNV (S := S) (Map := Map) a) (tgb : TagNV (S := S) (Map := Map) b) :
    TagNV (S := S) (Map := Map) (Nomm.n6 c a b) := by
  intro sur th region g0 g9 nex hj hth hok hcl hcount b0 d0 hu hcl0 hcb0 hkg h
  rw [runL_n6_next, sixNextL_ofSure] at h
  obtain ⟨u0, u1, x1, x0, xc, lz, yes, nuh, gF, gR, gQ, gS, gC, hF, hR, hQ, hS, hC, hrest⟩ :=
    sixNextSimple_apart hcp h
  have hF' : forkSure sur th.there g0.bo (g0.bo + 1) { g0 with bo := g0.bo + 2 } = some ((u0, u1), gF) := hF
  obtain ⟨l0, l1, cp0, cp1, du0, du1, j01, r01, reF, boF, drF, cnF, idF, bk0, bk1, bk2, keepF⟩ :=
    forkSure_spec hF' d0
  simp only [sixCount] at hcount
  have dF : gF.drop = false := drF.trans d0
  have GF : GrowU g0 gF := growU_forkSure hF' d0 hj.1 hj.2 hu
  have uF : UpBelow { gF with id := gF.id + 1 } := GF.up hu
  have GF' : GrowU g0 { gF with id := gF.id + 1 } :=
    GF.trans (growU_same (g := gF) (g' := { gF with id := gF.id + 1 }) rfl rfl (fun _ => rfl))
  have clF : Clear { gF with id := gF.id + 1 } := hcl0.growU GF'
  have cbF : CondBelow { gF with id := gF.id + 1 } := fun k hk => by
    simp only at hk ⊢; rw [cnF] at hk; have := hcb0 k hk; omega
  have nkF : ∀ r, g0.re ≤ r → HoonMap.get gF.cond r = Option.none := fun r hr => by
    rw [cnF]; exact condBelow_none hcb0 hr
  -- the no branch
  have Rb := ihb (sur := u1) (th := jmp0 (g0.bo + 1)) (region := gF.id :: region)
    (g0 := { gF with id := gF.id + 1 }) ⟨by simp [jmp0], by simp [jmp0]; omega⟩ rfl
    ⟨du1, fun r hr => (r01 r (Or.inr hr)).2⟩ (cp1.clean hcl) (by omega) (by simp; omega) dF uF clF cbF
    (fun r hr => nkF r (r01 r (Or.inr hr)).1) hR
  have Tb := tgb (sur := u1) (th := jmp0 (g0.bo + 1)) (region := gF.id :: region)
    (g0 := { gF with id := gF.id + 1 }) ⟨by simp [jmp0], by simp [jmp0]; omega⟩ rfl
    ⟨du1, fun r hr => (r01 r (Or.inr hr)).2⟩ (cp1.clean hcl) (by omega) (by simp; omega) dF uF clF cbF
    (fun r hr => nkF r (r01 r (Or.inr hr)).1) hR
  have clR : Clear gR := clF.growU Rb.grow
  have cbR : CondBelow gR := Rb.cfr.below cbF
  have dR : gR.drop = false := Rb.ext.2.2.1.trans dF
  have bFR : gF.bo ≤ gR.bo := Rb.ext.2.1
  have rFR : gF.re ≤ gR.re := Rb.ext.1
  have uR : UpBelow gR := Rb.grow.up uF
  -- the yes branch
  have Ra := iha (sur := u0) (th := jmp0 g0.bo) (region := gF.id :: region) (g0 := gR)
    ⟨by simp [jmp0]; omega, by simp [jmp0]; omega⟩ rfl
    ⟨du0, fun r hr => by have := (r01 r (Or.inl hr)).2; omega⟩ (cp0.clean hcl) (by omega) (by omega) dR uR clR cbR
    (fun r hr => by
      rw [Rb.cfr.get_lt (show r < ({ gF with id := gF.id + 1 } : Gen Map).re from (r01 r (Or.inl hr)).2)]
      exact nkF r (r01 r (Or.inl hr)).1) hQ
  have Ta := tga (sur := u0) (th := jmp0 g0.bo) (region := gF.id :: region) (g0 := gR)
    ⟨by simp [jmp0]; omega, by simp [jmp0]; omega⟩ rfl
    ⟨du0, fun r hr => by have := (r01 r (Or.inl hr)).2; omega⟩ (cp0.clean hcl) (by omega) (by omega) dR uR clR cbR
    (fun r hr => by
      rw [Rb.cfr.get_lt (show r < ({ gF with id := gF.id + 1 } : Gen Map).re from (r01 r (Or.inl hr)).2)]
      exact nkF r (r01 r (Or.inl hr)).1) hQ
  have dQ : gQ.drop = false := Ra.ext.2.2.1.trans dR
  have bRQ : gR.bo ≤ gQ.bo := Ra.ext.2.1
  have rRQ : gR.re ≤ gQ.re := Ra.ext.1
  -- `+sect`
  obtain ⟨rfl, rfl, a0, a1, rfl, SB⟩ := sect_specV dQ (sect_h0 Ta) (sect_h1 (cb := gF.cond) Tb) hS
  have dS : gS.drop = false := SB.2.2.2.1.trans (by simp [dQ])
  have boS : gS.bo = gQ.bo + 2 := SB.2.1.trans (sixGenL_bo _ _ _ _)
  have reS : gS.re = gQ.re := SB.1.trans (sixGenL_re _ _ _ _)
  have cS : gS.cond = gQ.cond := SB.2.2.2.2.2.1.trans (sixGenL_cond _ _ _ _)
  have blkS := SB.2.2.2.2.2.2
  have uQ : UpBelow gQ := Ra.grow.up uR
  have GQS : GrowU gQ gS := ((grow_sixGenL (gF.id :: region) (jumpsBelow_hop Ra.lo Ra.hi)
    (jumpsBelow_hop Rb.lo (by have := Rb.hi; omega))).toU uQ).trans
    (growU_same SB.2.1 SB.2.2.2.1 SB.2.2.2.2.2.2)
  have uS : UpBelow gS := GQS.up uQ
  have clS : Clear gS := (clR.growU Ra.grow).growU GQS
  have cbS : CondBelow gS := fun k hk => by
    rw [cS] at hk; rw [reS]; exact Ra.cfr.below cbR k hk
  -- the test
  have Tc := tgc (jmp0 gQ.bo) (jmp0 (gQ.bo + 1)) rfl rfl (region := region)
    trivial ⟨⟨by simp only [jmp0]; omega, by simp only [jmp0]; omega⟩, by simp only [jmp0]; omega,
      by simp only [jmp0]; omega⟩ (by omega) (by omega) dS uS clS cbS hC
  have hbig : lazyBig (mk (Sure.bunt : Sure S) [((gQ.bo, x0.laz), (gQ.bo + 1, x1.laz))] []) = false := by
    apply lazyBig_entries
    rw [entries_six]; simp only [List.length_append, List.length_cons]
    have := Ra.size; have := Rb.size; simp only [lazyMax]; omega
  have hc9 : g9.cond = gC.cond := (kc_copyL _ _).keep _ _ _ (hrest hbig)
  exact (CondTag.of_eq cnF).trans ((CondTag.mono (fun t ht => Sfx.tail ht) Tb).trans
    ((CondTag.mono (fun t ht => Sfx.tail ht) Ta).trans ((CondTag.of_eq cS).trans (Tc.trans (CondTag.of_eq hc9)))))

/-- **The tag clause of `%6` for `%done` or `%pick`**: the branches and the
test run in `region`, the yes and no blocks and `+copy` keep `cond`. -/
theorem sixP_tagV (lib : Lib) {goal : CGoal S} {c a b : Nomm} (hcp : c.pure = true)
    (tgc : ∀ z o : Jmp, z.args = [] → o.args = [] → TagV (Map := Map) (CGoal.pick z o : CGoal S) c)
    (iha : OKV (Map := Map) lib goal a) (ihb : OKV (Map := Map) lib goal b)
    (tga : TagV (Map := Map) goal a) (tgb : TagV (Map := Map) goal b) :
    TagV (Map := Map) goal (Nomm.n6 c a b) := by
  intro region g0 g4 nex hg hj hcount b0 d0 hu hcl0 hcb0 h
  rw [runL_n6_body c a b hg] at h
  obtain ⟨x1, x0, xc, g1, g2, g3, h1, h2, hx0a, hx1a, h3, hrest⟩ := sixBody_apart hcp h
  simp only [sixCount] at hcount
  have Rb := ihb hg hj (by omega) b0 d0 hu hcl0 hcb0 h1
  have Tb := tgb hg hj (by omega) b0 d0 hu hcl0 hcb0 h1
  have u1 : UpBelow g1 := Rb.grow.up hu
  have d1 : g1.drop = false := Rb.ext.2.2.1.trans d0
  have b01 : g0.bo ≤ g1.bo := Rb.ext.2.1
  have b1 : 1 ≤ g1.bo := Nat.le_trans b0 b01
  have cl1 : Clear g1 := hcl0.growU Rb.grow
  have cb1 : CondBelow g1 := Rb.cfr.below hcb0
  have Ra := iha hg (hj.mono b01) (by omega) b1 d1 u1 cl1 cb1 h2
  have Ta := tga hg (hj.mono b01) (by omega) b1 d1 u1 cl1 cb1 h2
  have cl2 : Clear g2 := cl1.growU Ra.grow
  have cb2 : CondBelow g2 := Ra.cfr.below cb1
  have u2 : UpBelow g2 := Ra.grow.up u1
  have d2 : g2.drop = false := Ra.ext.2.2.1.trans d1
  have b12 : g1.bo ≤ g2.bo := Ra.ext.2.1
  have GU : GrowU g2 (sixGenL g2 x0.th x1.th region) := (grow_sixGenL region (jumpsBelow_hop Ra.lo Ra.hi)
    (jumpsBelow_hop Rb.lo (by have := Rb.hi; omega))).toU u2
  have uG : UpBelow (sixGenL g2 x0.th x1.th region) := GU.up u2
  have hbig : lazyBig (mk (Sure.bunt : Sure S) [((g2.bo, x0.laz), (g2.bo + 1, x1.laz))] []) = false := by
    apply lazyBig_entries
    rw [entries_six]; simp only [List.length_append, List.length_cons]
    have := Ra.size; have := Rb.size; simp only [lazyMax]; omega
  -- the test
  have dG : (sixGenL g2 x0.th x1.th region).drop = false := by simp [d2]
  have Tc := tgc (jmp0 g2.bo) (jmp0 (g2.bo + 1)) rfl rfl trivial
    ⟨⟨by simp only [jmp0]; omega, by simp only [jmp0, sixGenL_bo]; omega⟩,
      by simp only [jmp0]; omega, by simp only [jmp0, sixGenL_bo]; omega⟩ (by omega)
    (by simp only [sixGenL_bo]; omega) dG uG (cl2.growU GU)
    (fun k hk => by simp only [sixGenL_cond, sixGenL_re] at hk ⊢; exact cb2 k hk) h3
  have hc4 : g4.cond = g3.cond := (kc_copyL _ _).keep _ _ _ (hrest hbig)
  exact Tb.trans (Ta.trans ((CondTag.of_eq (sixGenL_cond g2 x0.th x1.th region)).trans
    (Tc.trans (CondTag.of_eq hc4))))

/-- **The tag clause of cons under a fork-free `%next`**: `+split` keeps
`cond`, the tail and the head run in `region`, `+copy` keeps `cond`. -/
theorem cons_tagNV (lib : Lib) {p q : Nomm} (hp : OKNV (S := S) (Map := Map) lib p)
    (hq : OKNV (S := S) (Map := Map) lib q) (tp : TagNV (S := S) (Map := Map) p)
    (tq : TagNV (S := S) (Map := Map) q) (hpp : p.pure = true) (hqp : q.pure = true) :
    TagNV (S := S) (Map := Map) (Nomm.cons p q) := by
  intro sur th region g0 g1 nex hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h
  rw [runL_cons_next] at h
  obtain ⟨⟨hed', tel', o⟩, g2x, h2, h⟩ := bind_some h
  rw [splitL_mk, map_apply] at h2
  obtain ⟨⟨⟨hed, tel, o'⟩, g2⟩, hs2, e2⟩ := Option.map_eq_some_iff.mp h2
  simp only [Prod.mk.injEq] at e2
  obtain ⟨⟨rfl, rfl, rfl⟩, rfl⟩ := e2
  clear h2
  simp only at h
  obtain ⟨nexh, g2', hph, h⟩ := bind_some h
  rw [pastL_mk _ _ _ hqp, pure_apply] at hph
  simp only [Option.some.injEq, Prod.mk.injEq] at hph
  obtain ⟨rfl, rfl⟩ := hph
  obtain ⟨nex2, g3, h3, h⟩ := bind_some h
  obtain ⟨nex2', g3', hp2, h⟩ := bind_some h
  rw [pastL_pure _ _ hpp, pure_apply] at hp2
  simp only [Option.some.injEq, Prod.mk.injEq] at hp2
  obtain ⟨rfl, rfl⟩ := hp2
  obtain ⟨nex1, g4, h4, hcp⟩ := bind_some h
  obtain ⟨eo, E2, _, Mh, Mt, SP⟩ := split_ok hs2
  obtain ⟨Dh, Dt, Dht, F, B⟩ := SP hok.1 hok.2
  obtain ⟨G2, eo', lt2, _⟩ := split_down hs2 hj.1 hj.2 d0
  simp only at eo'
  subst eo
  have CS := clean_split hs2 hcl
  simp only at CS
  have c2 : g2.cond = g0.cond := (kc_split _).keep _ _ _ hs2
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have u2 : UpBelow g2 := (G2.toU hu).up hu
  have lt2' : ∀ (n : Need), (∀ y, NMem n y → NMem sur.ned y ∨ (g0.re ≤ y ∧ y < g2.re)) →
      ∀ y, NMem n y → y < g2.re := fun n M y hy => by
    rcases M y hy with a | ⟨_, a⟩
    · exact Nat.lt_of_lt_of_le (hok.2 y a) E2.1
    · exact a
  simp only [sixCount] at hcount
  have G2U : GrowU g0 g2 := G2.toU hu
  have cl2 : Clear g2 := hcl0.growU G2U
  have cf2 : CondFresh g0 g2 := condFresh_of_eq E2.1 c2
  have cb2 : CondBelow g2 := cf2.below hcb
  have nk2 : ∀ (n : Need), (∀ y, NMem n y → NMem sur.ned y ∨ (g0.re ≤ y ∧ y < g2.re)) →
      ∀ y, NMem n y → HoonMap.get g2.cond y = Option.none := fun n M y hy => by
    rw [c2]
    rcases M y hy with a | ⟨a, _⟩
    · exact hkg y a
    · exact condBelow_none hcb a
  have Rq := hq (sur := tel) (th := jmp0 g0.bo) ⟨b0, by simp only [jmp0]; omega⟩ rfl ⟨Dt, lt2' _ Mt⟩ CS.2
    (by omega) (by omega) d2 u2 cl2 cb2 (nk2 _ Mt) h3
  have d3 : g3.drop = false := Rq.ext.2.2.1.trans d2
  have u3 : UpBelow g3 := Rq.grow.up u2
  have Rp := hp (sur := hed) (th := nex2.th) ⟨Rq.lo, Rq.hi⟩ (nextArgs_nil Rq.ent rfl)
    ⟨Dh, fun y hy => Nat.lt_of_lt_of_le (lt2' _ Mh y hy) Rq.ext.1⟩ CS.1 (by omega)
    (by have := Rq.lo; have := Rq.hi; omega) d3 u3 (cl2.growU Rq.grow) (Rq.cfr.below cb2)
    (fun y hy => by rw [Rq.cfr.get_lt (lt2' _ Mh y hy)]; exact nk2 _ Mh y hy) h4
  have Tq := tq (sur := tel) (th := jmp0 g0.bo) ⟨b0, by simp only [jmp0]; omega⟩ rfl ⟨Dt, lt2' _ Mt⟩ CS.2
    (by omega) (by omega) d2 u2 cl2 cb2 (nk2 _ Mt) h3
  have Tp := tp (sur := hed) (th := nex2.th) ⟨Rq.lo, Rq.hi⟩ (nextArgs_nil Rq.ent rfl)
    ⟨Dh, fun y hy => Nat.lt_of_lt_of_le (lt2' _ Mh y hy) Rq.ext.1⟩ CS.1 (by omega)
    (by have := Rq.lo; have := Rq.hi; omega) d3 u3 (cl2.growU Rq.grow) (Rq.cfr.below cb2)
    (fun y hy => by rw [Rq.cfr.get_lt (lt2' _ Mh y hy)]; exact nk2 _ Mh y hy) h4
  have c4 : g1.cond = g4.cond := (kc_copyL _ _).keep _ _ _ hcp
  exact (CondTag.of_eq c2).trans (Tq.trans (Tp.trans (CondTag.of_eq c4)))

/-- **The tag clause of cons for `%pick`**: the `[%bom ~]` block keeps
`cond`, the tail and the head run in `region`, `+copy` keeps `cond`. -/
theorem cons_tagP (lib : Lib) {p q : Nomm} (hp : OKNV (S := S) (Map := Map) lib p)
    (hq : OKNV (S := S) (Map := Map) lib q) (tp : TagNV (S := S) (Map := Map) p)
    (tq : TagNV (S := S) (Map := Map) q) (hpp : p.pure = true) (z o : Jmp) :
    TagV (Map := Map) (CGoal.pick z o : CGoal S) (Nomm.cons p q) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  simp only [CGoal.toL] at h
  rw [runL_cons_pick] at h
  obtain ⟨o', g2, h2, h⟩ := bind_some h
  rw [emit_apply] at h2
  simp only [Option.some.injEq, Prod.mk.injEq] at h2
  obtain ⟨rfl, rfl⟩ := h2
  obtain ⟨nex2, g3, h3, h⟩ := bind_some h
  obtain ⟨nex2', g3', hp2, h⟩ := bind_some h
  rw [pastL_pure _ _ hpp, pure_apply] at hp2
  simp only [Option.some.injEq, Prod.mk.injEq] at hp2
