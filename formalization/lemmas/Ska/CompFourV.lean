open Nock Lazy

variable {S : Type} [HoonSet S] {Map : Type → Type} [HoonMap Map] [HoonMapKeys Map]

/-- `omega` after reducing the projections of the states. -/
local macro "romega" : tactic =>
  `(tactic| first | omega | (simp only [emitted_re, emitted_bo] at *; omega) | (dsimp only at *; omega))

/-- **Unproxying leaves the blocks before a part alone** when they mention
only registers below the part's start (`Keeps`) and no key of the first
state's `cond` (`KeepsA`), against every `cf` that agrees with that `cond`
below the part's start. -/
theorem fix_of_keeps {g0 gs g' : Gen Map} (hbo : gs.bo = g0.bo)
    (KA : KeepsA (fun r => HoonMap.get g0.cond r = Option.none) gs g') (KB : Keeps gs g') :
    ∀ (cf : Map (Nat × List Nat)), (∀ k, k < g'.re → HoonMap.get cf k = HoonMap.get g0.cond k) →
      ∀ k, g0.bo ≤ k → k < g'.bo → (HoonMap.get g'.blocks k).map (unproxyBlob cf) = HoonMap.get g'.blocks k := by
  intro cf hcf k h0 h1
  have AS := KA.ab _ (aboveIn_start _ gs)
  have BS := KB.bel _ (belowIn_start gs)
  rw [hbo] at AS BS
  have u0 : ∀ x, x < g'.re → unproxy cf x = unproxy g0.cond x := unproxy_agree (fun k hk => hcf k hk)
  have u1 : ∀ x, HoonMap.get g0.cond x = Option.none → unproxy g0.cond x = id x := fun x hx => unproxy_none hx
  cases hgb : HoonMap.get g'.blocks k with
  | none => rfl
  | some b =>
    simp only [Option.map_some]
    rw [unproxyBlob, renBlob_congr u0 (BS k b h0 h1 hgb), renBlob_congr u1 (AS k b h0 h1 hgb), renBlob_id]

/-- **A unary case for a fork-free `%next` whose operand may make proxies**
(`unaryN_ok` with a `RunOKNV` operand); the blocks before the operand are
left alone by unproxying by hypothesis (`hfix`). -/
theorem unaryNV_ok {lib : Lib} {nm p : Nomm} {sur : Sure S} {th : Jmp} {g0 g' g1 : Gen Map} {a o : Nat}
    {nexp : NextL S} {f : Noun → Option Noun} (hev : ∀ s, pureEval nm s = (pureEval p s).bind f)
    (hpre : Ext g0 g') (hgr : GrowU g0 g') (hcnd : g'.cond = g0.cond) (ha : g0.re ≤ a ∧ a < g'.re)
    (ho : o < g'.bo) (hfr : Fresh g' (jmp0 o)) (hp : RunOKNV (Map := Map) lib p (lazyReg a) (jmp0 o) g' g1 nexp)
    (hsz : sixCount nm = sixCount p)
    (hfix : ∀ (cf : Map (Nat × List Nat)), (∀ k, k < g'.re → HoonMap.get cf k = HoonMap.get g0.cond k) →
      ∀ k, g0.bo ≤ k → k < g'.bo → (HoonMap.get g'.blocks k).map (unproxyBlob cf) = HoonMap.get g'.blocks k)
    (hblk : ∀ (c : Straight Map), Agree c g0 g' → ∀ (σ : Type) (O : Oracle σ) st regs t gul x,
      SkaModel.read a regs = some x →
      GoalSem lib O c gul st (Keep g0 g' (CGoal.next sur th)) regs t (jmp0 o) (CGoal.next sur th) (f x)) :
    RunOKNV (Map := Map) lib nm sur th g0 g1 nexp := by
  refine ⟨hpre.trans hp.ext, hgr.trans hp.grow, (condFresh_of_eq hpre.1 hcnd).trans hp.cfr, hp.lo, hp.hi, ?_,
    fun r hr => ?_, hp.dist, fun e he => ?_, fun e he => ?_, hp.nodup, by rw [hsz]; exact hp.size, fun s hs => ?_,
    hp.ncond, hp.econd, ?_⟩
  · rcases hp.ent with f | e
    · exact Or.inl f
    · simp only [GoalJ] at e
      rw [e]; exact Or.inl (hfr.growU ho hp.grow)
  · have := hp.ext.1; have := hpre.1
    rcases hp.regs r hr with h | h
    · simp only [lazyReg, NMem] at h; subst h; exact Or.inr ⟨ha.1, by omega⟩
    · exact Or.inr ⟨by omega, h.2⟩
  · exact ⟨(hp.eregs e he).1, fun r hr => by have := (hp.eregs e he).2 r hr; have := hpre.1; omega⟩
  · obtain ⟨x, y, z⟩ := hp.labs e he
    exact ⟨by have := hpre.2.1; omega, y, z⟩
  · left; rw [hev]
    rcases hp.nec s hs with h | ⟨x, _, h2⟩
    · rw [h]; rfl
    · exact absurd ⟨trivial, looks_empty x⟩ h2
  · intro cf hcf c ned σ O st t gul s0 s ag hned regs hh hn
    have agP : AgreeU lib O c gul st t cf ned g' g1 nexp.laz s0 s :=
      ⟨fun o' h0 h1 hnl => ag.1 o' (Nat.le_trans hpre.2.1 h0) h1 hnl, ag.2⟩
    have Sp := hp.sem cf hcf c ned σ O st t gul s0 s agP hned regs hh hn
    have hcf0 : ∀ k, k < g'.re → HoonMap.get cf k = HoonMap.get g0.cond k := fun k hk =>
      (hcf k (Nat.lt_of_lt_of_le hk hp.ext.1)).trans ((hp.cfr.get_lt hk).trans (by rw [hcnd]))
    have agQ : Agree c g0 g' := fun o' h0 h1 => by
      rw [ag.1 o' h0 (Nat.lt_of_lt_of_le h1 hp.ext.2.1) (fun hm => ?_)]
      · rw [hp.ext.2.2.2 o' h1]; exact hfix cf hcf0 o' h0 h1
      · obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
        have := (hp.labs e he).1; omega
    have l1 := hp.ext.1
    rw [hev]
    cases e : pureEval p s with
    | none => rw [e] at Sp; exact goalSem_none _ Sp
    | some x =>
      rw [e] at Sp
      obtain ⟨R, hR, k, he⟩ := Sp.1 ⟨trivial, looks_empty x⟩
      refine goalSem_pre (fun r hr => k r ⟨?_, ?_⟩) he _ _
        (goalSem_mono (fun r hr => ?_) _ _ (hblk c agQ σ O st R t gul x hR))
      · rcases hr.1 with h | h
        · exact Or.inl (by omega)
        · exact Or.inr h
      · simp only [lazyReg, NMem]
        intro ea; subst ea
        rcases hr.1 with h | h
        · omega
        · have := hned _ h; omega
      · simp only [Keep, GMem]
        refine ⟨?_, hr.2⟩
        rcases hr.1 with h | h
        · exact Or.inl h
        · have := hned r h; exact Or.inr (by omega)

/-- **`[4 p]` for `%done`** with an `OKNV` operand. -/
theorem runOKV_n4D (lib : Lib) {p : Nomm} (hp : OKNV (S := S) (Map := Map) lib p) :
    OKV (Map := Map) lib (CGoal.done : CGoal S) (Nomm.n4 p) := by
  intro region g0 g1 nex _ _ hcount b0 d0 hu hcl0 hcb h
  simp only [sixCount] at hcount
  have e4 : (runL (Nomm.n4 p) (CGoal.toL (CGoal.done : CGoal S)) region : CM Map (NextL S)) = (do
      let pro ← re
      let arg ← re
      let o ← emit ⟨[], [Pole.inc arg pro], Termin.don pro⟩
      runL p (CGoalL.next (ofSure (lazyReg arg)) (jmp0 o)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e4] at h
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have Rp := hp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount
    (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d0)
    (((grow_reg g0 _).trans (grow_emit (jumpsBelow_nil rfl _))).toU hu |>.up hu)
    (hcl0.growU (((grow_reg g0 _).trans (grow_emit (jumpsBelow_nil rfl _))).toU hu)) (CondFresh.below (condFresh_of_eq (g0 := g0) (by romega) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (by romega)) h
  refine unaryGV_ok (goal := CGoal.done) trivial (pureEval_n4 p) ((ext_re _).trans ((ext_re _).trans (ext_emit _ _)))
    (((grow_reg g0 _).trans (grow_emit (jumpsBelow_nil rfl _))).toU hu) rfl
    ⟨Nat.le_succ _, by simp [emitted_re]⟩ (by simp [emitted_bo]) (fresh_emitted (by simpa using d0) rfl rfl) Rp rfl
    (fix_of_keeps (gs := g0) rfl ((keepsA_reg _ g0 _ (by romega)).trans (keepsA_emitted d0 (blobIn_one
      (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with rfl | rfl
        <;> exact condBelow_none hcb (by romega)) (condBelow_none hcb (by romega)))))
      ((keeps_reg g0 _ (by romega)).trans (keeps_emitted d0 (blobIn_one
      (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with rfl | rfl
        <;> romega) (by simp only [FinIn]; romega)))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d0) (hc _ (by simp) (by simp [emitted_bo]))
  show goJ lib O c gul st regs t _ = _
  rw [goJ_jmp0 _ _ _ _ hb]
  cases x with
  | atom n =>
    rw [show [Pole.inc _ _] = [Pole.inc _ _] ++ [] from rfl, runs_inc hx]
    simp [incF, toneOf, execBlob_don', read_store_eq]
  | cell u v =>
    rw [show [Pole.inc _ _] = [Pole.inc _ _] ++ [] from rfl, crashes_inc hx]
    rfl

/-- **`[4 p]` for `%pick`** with an `OKNV` operand. -/
theorem runOKV_n4P (lib : Lib) {p : Nomm} (hp : OKNV (S := S) (Map := Map) lib p) (z o : Jmp)
    (hz : z.args = []) (hzo : o.args = []) : OKV (Map := Map) lib (CGoal.pick z o : CGoal S) (Nomm.n4 p) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  simp only [sixCount] at hcount
  have e4 : (runL (Nomm.n4 p) (CGoal.toL (CGoal.pick z o : CGoal S)) region : CM Map (NextL S)) = (do
      let pro ← re
      let arg ← re
      let o' ← emit ⟨[], [Pole.inc arg pro], Termin.brn pro z o⟩
      runL p (CGoalL.next (ofSure (lazyReg arg)) (jmp0 o')) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e4] at h
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have G := (grow_reg g0 (g0.re + 1 + 1)).trans (grow_emit (b := ⟨[], [Pole.inc (g0.re + 1) g0.re],
    Termin.brn g0.re z o⟩) (jumpsBelow_two rfl hj.1 hj.2))
  have Rp := hp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d0) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu)) (CondFresh.below (condFresh_of_eq (g0 := g0) (by romega) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (by romega)) h
  refine unaryGV_ok (goal := CGoal.pick z o) trivial (pureEval_n4 p)
    ((ext_re _).trans ((ext_re _).trans (ext_emit _ _))) (G.toU hu) rfl
    ⟨Nat.le_succ _, by simp [emitted_re]⟩ (by simp [emitted_bo]) (fresh_emitted (by simpa using d0) rfl rfl) Rp rfl
    (fix_of_keeps (gs := g0) rfl ((keepsA_reg _ g0 _ (by romega)).trans (keepsA_emitted d0 (blobIn_one
      (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with rfl | rfl
        <;> exact condBelow_none hcb (by romega))
      ⟨condBelow_none hcb (by romega), jmpIn_nil hz, jmpIn_nil hzo⟩)))
      ((keeps_reg g0 _ (by romega)).trans (keeps_emitted d0 (blobIn_one
      (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with rfl | rfl
        <;> romega) ⟨by romega, jmpIn_nil hz, jmpIn_nil hzo⟩))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d0) (hc _ (by simp) (by simp [emitted_bo]))
  have hj' := goJ_jmp0 (lib := lib) (O := O) (gul := gul) (st := st) regs t _ _ hb
  cases x with
  | atom n =>
    rw [show [Pole.inc _ _] = [Pole.inc _ _] ++ [] from rfl, runs_inc hx, execBlob_brn, read_store_eq,
      Option.bind_some] at hj'
    rcases n with _ | n
    · simp only [incF]
      refine ⟨store g0.re (A (0 + 1)) regs, fun r ⟨h1, _⟩ =>
        read_store_ne (show r ≠ g0.re by simp [emitted_re] at h1; omega) _ _, ?_⟩
      rw [hj']; simp
    · simp only [incF]
      exact goalSem_pick_other (by simp) (by simp) (by rw [hj']; simp)
  | cell u v =>
    simp only [incF]
    apply goalSem_crash
    rw [hj', show [Pole.inc _ _] = [Pole.inc _ _] ++ [] from rfl, crashes_inc hx]

/-- **`[4 p]` under a fork-free `%next`** with an `OKNV` operand. -/
theorem runOKNV_n4 (lib : Lib) {p : Nomm} (hp : OKNV (S := S) (Map := Map) lib p) :
    OKNV (S := S) (Map := Map) lib (Nomm.n4 p) := by
  intro sur th region g0 g1 nex hj _ hok _ hcount b0 d0 hu hcl0 hcb hkg h
  simp only [sixCount] at hcount
  have e4 : (runL (Nomm.n4 p) (CGoalL.next (ofSure sur) th) region : CM Map (NextL S)) = (do
      let a ← collapseLazyAtomL ⟨ofSure sur, th⟩
      let (pro, th') ← (match a with
        | some x => pure x
        | Option.none => do
            let r ← re
            if th.args = [] then pure (r, th.there) else fun _ => Option.none : CM Map (Nat × Nat))
      let arg ← re
      let o ← emit ⟨[], [Pole.inc arg pro], Termin.hop (jmp0 th')⟩
      runL p (CGoalL.next (ofSure (lazyReg arg)) (jmp0 o)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e4, collapseLazyAtomL_mk] at h
  obtain ⟨a, g2, h2, h⟩ := bind_some h
  obtain ⟨E2, ea, hnone, hsome⟩ := collapse_ok h2
  have C := collapse_down h2 hj.1 hj.2 b0
  have c2 : g2.cond = g0.cond := (kc_collapseLazyAtom _).keep g0 a g2 h2
  obtain ⟨⟨pro, th'⟩, g3, h3, h⟩ := bind_some h
  have P : Ext g2 g3 ∧ g3.cond = g2.cond ∧ Grow g2 g3 ∧ (1 ≤ th' ∧ th' < g3.bo) ∧
      (NMem sur.ned pro ∨ (g0.re ≤ pro ∧ pro < g3.re)) ∧
      (g0.drop = false → ∀ (c : Straight Map), Agree c g0 g2 → ∀ (σ : Type) (O : Oracle σ) (st : σ) regs t gul n,
        SkaModel.read pro regs = some (A n) → ∀ {K : Nat → Prop},
        GoalSem lib O c gul st K regs t (jmp0 th') (CGoal.next sur th) (some (A n))) := by
    cases a with
    | some x =>
      simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h3
      obtain ⟨e1, rfl⟩ := h3
      subst e1
      obtain ⟨hm, _, hs⟩ := hsome pro th' rfl
      exact ⟨Ext.refl _, rfl, Grow.refl _, C.2 pro th' rfl, hm,
        fun hd c hc σ O st regs t gul n hr => hs hd c hc lib σ O st regs t gul n hr⟩
    | none =>
      obtain ⟨hn, hl⟩ := hnone rfl
      simp only [bind_apply, re_apply, Option.bind_some, ea, if_true, pure_apply, Option.some.injEq,
        Prod.mk.injEq] at h3
      obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h3
      refine ⟨ext_re _, rfl, grow_re _, ⟨hj.1, by have := C.1.bo; have := hj.2; show th.there < g2.bo; omega⟩,
        Or.inr ⟨E2.1, Nat.lt_succ_self _⟩, fun _ c _ σ O st regs t gul n hr => ?_⟩
      refine ⟨fun _ => ⟨regs, by rw [hn]; trivial, fun _ _ => rfl, by rw [jmp0_of_args ea]⟩, fun hf => ?_⟩
      exact absurd ⟨by rw [hn]; trivial, fun y hy => by rw [hl y hy]; simp⟩ hf
  have AB : (KeepsA (fun r => HoonMap.get g0.cond r = Option.none) g0 g3 ∧ HoonMap.get g0.cond pro = Option.none) ∧
      (Keeps g0 g3 ∧ pro < g3.re) := by
    obtain ⟨ka, ra⟩ := keepsA_collapseLazyAtom (P := (fun r => HoonMap.get g0.cond r = Option.none)) (nex := ⟨sur, th⟩)
      d0 hkg (fun r hr => condBelow_none hcb hr) h2
    obtain ⟨kb, rb⟩ := keeps_collapseLazyAtom (nex := ⟨sur, th⟩) d0 (fun r hr => hok.2 r hr) h2
    cases a with
    | some x =>
      simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h3
      obtain ⟨rfl, rfl⟩ := h3
      exact ⟨⟨ka, ra _ _ rfl⟩, ⟨kb, rb _ _ rfl⟩⟩
    | none =>
      simp only [bind_apply, re_apply, Option.bind_some, ea, if_true, pure_apply, Option.some.injEq,
        Prod.mk.injEq] at h3
      obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h3
      exact ⟨⟨ka.trans (keepsA_reg _ _ _ (Nat.le_succ _)), condBelow_none hcb ka.le⟩,
        ⟨kb.trans (keeps_reg _ _ (Nat.le_succ _)), Nat.lt_succ_self _⟩⟩
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have d3 : g3.drop = false := P.1.2.2.1.trans (E2.2.2.1.trans d0)
  have bo3 : g0.bo ≤ g3.bo := Nat.le_trans C.1.bo P.1.2.1
  have G : Grow g0 ({ g3 with re := g3.re + 1 }.emitted ⟨[], [Pole.inc g3.re pro], Termin.hop (jmp0 th')⟩) :=
    C.1.trans (P.2.2.1.trans ((grow_re _).trans (grow_emit (jumpsBelow_hop P.2.2.2.1.1 P.2.2.2.1.2))))
  have Rp := hp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d3) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_trans AB.2.1.le (Nat.le_succ _)) (P.2.1.trans c2)) hcb)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr; subst hr
      show HoonMap.get g3.cond _ = _
      rw [P.2.1, c2]; exact condBelow_none hcb AB.2.1.le) h
  refine unaryNV_ok (pureEval_n4 p) (E2.trans (P.1.trans ((ext_re _).trans (ext_emit _ _)))) (G.toU hu)
    (P.2.1.trans c2) ⟨by have := E2.1; have := P.1.1; omega, by simp [emitted_re]⟩ (by simp [emitted_bo])
    (fresh_emitted (by simpa using d3) rfl rfl) Rp rfl
    (fix_of_keeps (gs := g0) rfl (AB.1.1.trans ((keepsA_reg _ g3 _ (Nat.le_succ _)).trans (keepsA_emitted d3
      (blobIn_one (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with rfl | rfl
        · exact condBelow_none hcb AB.2.1.le
        · exact AB.1.2) (jmpIn_jmp0 _ _)))))
      (AB.2.1.trans ((keeps_reg g3 _ (Nat.le_succ _)).trans (keeps_emitted d3
      (blobIn_one (fun x hx => by
        simp only [poleRegs, List.mem_cons, List.mem_nil_iff, or_false] at hx
        rcases hx with rfl | rfl
        · exact Nat.lt_succ_self _
        · exact Nat.lt_succ_of_lt AB.2.2) (jmpIn_jmp0 _ _))))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d3) (hc _ bo3 (by simp [emitted_bo]))
  have hj' := goJ_jmp0 (lib := lib) (O := O) (gul := gul) (st := st) regs t _ _ hb
  cases x with
  | atom n =>
    rw [show [Pole.inc _ _] = [Pole.inc _ _] ++ [] from rfl, runs_inc hx, execBlob_hop] at hj'
    refine GoalSem.transfer hj' (fun r ⟨h1, h2⟩ => read_store_ne (fun e => ?_) _ _)
      (P.2.2.2.2.2 d0 c (hc.left E2 (P.1.trans ((ext_re _).trans (ext_emit _ _)))) σ O st
        (store pro (A (n + 1)) regs) t gul (n + 1) (read_store_eq _ _ _))
    subst e
    rcases P.2.2.2.2.1 with hm | ⟨hm, hm'⟩
    · exact h2 hm
    · simp [emitted_re] at h1; omega
  | cell u v =>
    apply goalSem_crash
    rw [hj', show [Pole.inc _ _] = [Pole.inc _ _] ++ [] from rfl, crashes_inc hx]

/-- **The tag clause of `[4 p]` under `%next`**: `+collapse-lazy-atom`, `re` and
the block keep `cond`. -/
theorem four_tagNV (lib : Lib) {p : Nomm} (tp : TagNV (S := S) (Map := Map) p) :
    TagNV (S := S) (Map := Map) (Nomm.n4 p) := by
  intro sur th region g0 g1 nex hj _ hok _ hcount b0 d0 hu hcl0 hcb hkg h
  simp only [sixCount] at hcount
  have e4 : (runL (Nomm.n4 p) (CGoalL.next (ofSure sur) th) region : CM Map (NextL S)) = (do
      let a ← collapseLazyAtomL ⟨ofSure sur, th⟩
      let (pro, th') ← (match a with
        | some x => pure x
        | Option.none => do
            let r ← re
            if th.args = [] then pure (r, th.there) else fun _ => Option.none : CM Map (Nat × Nat))
      let arg ← re
      let o ← emit ⟨[], [Pole.inc arg pro], Termin.hop (jmp0 th')⟩
      runL p (CGoalL.next (ofSure (lazyReg arg)) (jmp0 o)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e4, collapseLazyAtomL_mk] at h
  obtain ⟨a, g2, h2, h⟩ := bind_some h
  obtain ⟨E2, ea, hnone, hsome⟩ := collapse_ok h2
  have C := collapse_down h2 hj.1 hj.2 b0
  have c2 : g2.cond = g0.cond := (kc_collapseLazyAtom _).keep g0 a g2 h2
  obtain ⟨⟨pro, th'⟩, g3, h3, h⟩ := bind_some h
  have P : Ext g2 g3 ∧ g3.cond = g2.cond ∧ Grow g2 g3 ∧ (1 ≤ th' ∧ th' < g3.bo) ∧
      (NMem sur.ned pro ∨ (g0.re ≤ pro ∧ pro < g3.re)) ∧
      (g0.drop = false → ∀ (c : Straight Map), Agree c g0 g2 → ∀ (σ : Type) (O : Oracle σ) (st : σ) regs t gul n,
        SkaModel.read pro regs = some (A n) → ∀ {K : Nat → Prop},
        GoalSem lib O c gul st K regs t (jmp0 th') (CGoal.next sur th) (some (A n))) := by
    cases a with
    | some x =>
      simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h3
      obtain ⟨e1, rfl⟩ := h3
      subst e1
      obtain ⟨hm, _, hs⟩ := hsome pro th' rfl
      exact ⟨Ext.refl _, rfl, Grow.refl _, C.2 pro th' rfl, hm,
        fun hd c hc σ O st regs t gul n hr => hs hd c hc lib σ O st regs t gul n hr⟩
    | none =>
      obtain ⟨hn, hl⟩ := hnone rfl
      simp only [bind_apply, re_apply, Option.bind_some, ea, if_true, pure_apply, Option.some.injEq,
        Prod.mk.injEq] at h3
      obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h3
      refine ⟨ext_re _, rfl, grow_re _, ⟨hj.1, by have := C.1.bo; have := hj.2; show th.there < g2.bo; omega⟩,
        Or.inr ⟨E2.1, Nat.lt_succ_self _⟩, fun _ c _ σ O st regs t gul n hr => ?_⟩
      refine ⟨fun _ => ⟨regs, by rw [hn]; trivial, fun _ _ => rfl, by rw [jmp0_of_args ea]⟩, fun hf => ?_⟩
      exact absurd ⟨by rw [hn]; trivial, fun y hy => by rw [hl y hy]; simp⟩ hf
  have AB : (KeepsA (fun r => HoonMap.get g0.cond r = Option.none) g0 g3 ∧ HoonMap.get g0.cond pro = Option.none) ∧
      (Keeps g0 g3 ∧ pro < g3.re) := by
    obtain ⟨ka, ra⟩ := keepsA_collapseLazyAtom (P := (fun r => HoonMap.get g0.cond r = Option.none)) (nex := ⟨sur, th⟩)
      d0 hkg (fun r hr => condBelow_none hcb hr) h2
    obtain ⟨kb, rb⟩ := keeps_collapseLazyAtom (nex := ⟨sur, th⟩) d0 (fun r hr => hok.2 r hr) h2
    cases a with
    | some x =>
      simp only [pure_apply, Option.some.injEq, Prod.mk.injEq] at h3
      obtain ⟨rfl, rfl⟩ := h3
      exact ⟨⟨ka, ra _ _ rfl⟩, ⟨kb, rb _ _ rfl⟩⟩
    | none =>
      simp only [bind_apply, re_apply, Option.bind_some, ea, if_true, pure_apply, Option.some.injEq,
        Prod.mk.injEq] at h3
      obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h3
      exact ⟨⟨ka.trans (keepsA_reg _ _ _ (Nat.le_succ _)), condBelow_none hcb ka.le⟩,
        ⟨kb.trans (keeps_reg _ _ (Nat.le_succ _)), Nat.lt_succ_self _⟩⟩
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have d3 : g3.drop = false := P.1.2.2.1.trans (E2.2.2.1.trans d0)
  have bo3 : g0.bo ≤ g3.bo := Nat.le_trans C.1.bo P.1.2.1
  have G : Grow g0 ({ g3 with re := g3.re + 1 }.emitted ⟨[], [Pole.inc g3.re pro], Termin.hop (jmp0 th')⟩) :=
    C.1.trans (P.2.2.1.trans ((grow_re _).trans (grow_emit (jumpsBelow_hop P.2.2.2.1.1 P.2.2.2.1.2))))
  have Tp := tp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d3) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_trans AB.2.1.le (Nat.le_succ _)) (P.2.1.trans c2)) hcb)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr; subst hr
      show HoonMap.get g3.cond _ = _
      rw [P.2.1, c2]; exact condBelow_none hcb AB.2.1.le) h
  exact (CondTag.of_eq (P.2.1.trans c2)).trans Tp

/-- **The tag clause of `[4 p]` for `%pick`.** -/
theorem four_tagP (lib : Lib) {p : Nomm} (tp : TagNV (S := S) (Map := Map) p) (z o : Jmp) :
    TagV (Map := Map) (CGoal.pick z o : CGoal S) (Nomm.n4 p) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  simp only [sixCount] at hcount
  have e4 : (runL (Nomm.n4 p) (CGoal.toL (CGoal.pick z o : CGoal S)) region : CM Map (NextL S)) = (do
      let pro ← re
      let arg ← re
      let o' ← emit ⟨[], [Pole.inc arg pro], Termin.brn pro z o⟩
      runL p (CGoalL.next (ofSure (lazyReg arg)) (jmp0 o')) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e4] at h
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have G := (grow_reg g0 (g0.re + 1 + 1)).trans (grow_emit (b := ⟨[], [Pole.inc (g0.re + 1) g0.re],
    Termin.brn g0.re z o⟩) (jumpsBelow_two rfl hj.1 hj.2))
  have Tp := tp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d0) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu)) (CondFresh.below (condFresh_of_eq (g0 := g0) (by romega) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (by romega)) h
  exact Tp

/-- **`CleanA` of `[4 p]`** (the case of `runX_clean`). -/
theorem cleanA_four {p : Nomm} (ih : CleanA S Map p) : CleanA S Map (Nomm.n4 p) := by
  intro goal region g0 g1 nex hc h
  cases goal with
  | next sur th =>
    simp only [CGoal.toL] at h
    unfold runL at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨arg, _, _, h⟩ := bind_some h
    obtain ⟨o, _, _, h⟩ := bind_some h
    exact ih (goal := CGoal.next (lazyReg arg) (jmp0 o)) trivial h
  | done =>
    simp only [CGoal.toL] at h
    unfold runL at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨arg, _, _, h⟩ := bind_some h
    obtain ⟨o, _, _, h⟩ := bind_some h
    exact ih (goal := CGoal.next (lazyReg arg) (jmp0 o)) trivial h
  | pick z o =>
    simp only [CGoal.toL] at h
    unfold runL at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨arg, _, _, h⟩ := bind_some h
    obtain ⟨o, _, _, h⟩ := bind_some h
    exact ih (goal := CGoal.next (lazyReg arg) (jmp0 o)) trivial h

/-- **`[3 p]` for `%done`** with an `OKNV` operand. -/
theorem runOKV_n3D (lib : Lib) {p : Nomm} (hp : OKNV (S := S) (Map := Map) lib p) :
    OKV (Map := Map) lib (CGoal.done : CGoal S) (Nomm.n3 p) := by
  intro region g0 g1 nex _ _ hcount b0 d0 hu hcl0 hcb h
  simp only [sixCount] at hcount
  have e3 : (runL (Nomm.n3 p) (CGoal.toL (CGoal.done : CGoal S)) region : CM Map (NextL S)) = (do
      let (o0, o1) ← doneBlocks
      let r ← re
      let oc ← emit ⟨[], [], Termin.clq r (jmp0 o0) (jmp0 o1)⟩
      runL p (CGoalL.next (ofSure (lazyReg r)) (jmp0 oc)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e3] at h
  obtain ⟨⟨o0, o1⟩, g2, h2, h⟩ := bind_some h
  have B := doneBlocks_down h2 b0
  obtain ⟨D, er, eb, rfl, rfl, DB⟩ := doneBlocks_ok h2
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have d2 : g2.drop = false := D.2.2.1.trans d0
  have G : Grow g0 ({ g2 with re := g2.re + 1 }.emitted ⟨[], [], Termin.clq g2.re (jmp0 g0.bo) (jmp0 (g0.bo + 1))⟩) :=
    B.1.trans ((grow_re _).trans (grow_emit (jumpsBelow_two rfl B.2.1 B.2.2)))
  have Rp := hp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d2) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_trans D.1 (Nat.le_succ _))
      ((kc_doneBlocks.keep g0 _ g2 h2))) hcb)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr; subst hr
      show HoonMap.get g2.cond _ = _
      rw [kc_doneBlocks.keep g0 _ g2 h2]; exact condBelow_none hcb D.1) h
  refine unaryGV_ok (goal := CGoal.done) trivial (pureEval_n3 p) (D.trans ((ext_re _).trans (ext_emit _ _))) (G.toU hu)
    (kc_doneBlocks.keep g0 _ g2 h2)
    ⟨by omega, by simp [emitted_re]⟩ (by simp [emitted_bo]) (fresh_emitted (by simpa using d2) rfl rfl) Rp rfl
    (fix_of_keeps (gs := g0) rfl ((keepsA_doneBlocks d0 (fun r hr => condBelow_none hcb hr) h2).trans
      ((keepsA_reg _ g2 _ (Nat.le_succ _)).trans (keepsA_emitted d2
        (blobIn_fin ⟨condBelow_none hcb D.1, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩))))
      ((keeps_doneBlocks d0 h2).trans ((keeps_reg g2 _ (Nat.le_succ _)).trans (keeps_emitted d2
        (blobIn_fin ⟨Nat.lt_succ_self _, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩)))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d2) (hc _ (by show g0.bo ≤ g2.bo; omega) (by simp [emitted_bo]))
  have hj := goJ_jmp0 (lib := lib) (O := O) (gul := gul) (st := st) regs t _ _ hb
  rw [execBlob_clq, hx, Option.bind_some] at hj
  have DB' := DB c d0 (hc.left D ((ext_re _).trans (ext_emit _ _))) lib σ O st regs t gul
  show goJ lib O c gul st regs t _ = _
  refine hj.trans ?_
  cases x with
  | atom n => exact DB'.2
  | cell u v => exact DB'.1

/-- **`[3 p]` for `%pick`** with an `OKNV` operand. -/
theorem runOKV_n3P (lib : Lib) {p : Nomm} (hp : OKNV (S := S) (Map := Map) lib p) (z o : Jmp)
    (hz : z.args = []) (hzo : o.args = []) : OKV (Map := Map) lib (CGoal.pick z o : CGoal S) (Nomm.n3 p) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  simp only [sixCount] at hcount
  have e3 : (runL (Nomm.n3 p) (CGoal.toL (CGoal.pick z o : CGoal S)) region : CM Map (NextL S)) = (do
      let r ← re
      let oc ← emit ⟨[], [], Termin.clq r z o⟩
      runL p (CGoalL.next (ofSure (lazyReg r)) (jmp0 oc)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e3] at h
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have G := (grow_re g0).trans (grow_emit (b := ⟨[], [], Termin.clq g0.re z o⟩) (jumpsBelow_two rfl hj.1 hj.2))
  have Rp := hp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d0) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu)) (CondFresh.below (condFresh_of_eq (g0 := g0) (by romega) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (by romega)) h
  refine unaryGV_ok (goal := CGoal.pick z o) trivial (pureEval_n3 p) ((ext_re _).trans (ext_emit _ _)) (G.toU hu)
    rfl ⟨Nat.le_refl _, by simp [emitted_re]⟩ (by simp [emitted_bo]) (fresh_emitted (by simpa using d0) rfl rfl)
    Rp rfl
    (fix_of_keeps (gs := g0) rfl ((keepsA_reg _ g0 _ (Nat.le_succ _)).trans (keepsA_emitted d0
        (blobIn_fin ⟨condBelow_none hcb (Nat.le_refl _), jmpIn_nil hz, jmpIn_nil hzo⟩)))
      ((keeps_reg g0 _ (Nat.le_succ _)).trans (keeps_emitted d0
        (blobIn_fin ⟨Nat.lt_succ_self _, jmpIn_nil hz, jmpIn_nil hzo⟩))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d0) (hc _ (by simp) (by simp [emitted_bo]))
  have hj' := goJ_jmp0 (lib := lib) (O := O) (gul := gul) (st := st) regs t _ _ hb
  rw [execBlob_clq, hx, Option.bind_some] at hj'
  cases x with
  | atom n => exact ⟨regs, fun _ _ => rfl, by rw [hj']⟩
  | cell u v => exact ⟨regs, fun _ _ => rfl, by rw [hj']⟩

/-- `[3 p]` under a `%next` that asks nothing of the product, with a
`RunOKNV` operand. -/
theorem runOKNV_n3_of_none {lib : Lib} {p : Nomm} {sur : Sure S} {th : Jmp} {g0 g1 : Gen Map} {nex : NextL S}
    (hn : sur.ned = Need.none) (hl : ∀ x ∈ HoonSet.toList sur.lok, x = 1)
    (hp : RunOKNV (Map := Map) lib p sur th g0 g1 nex) : RunOKNV (Map := Map) lib (Nomm.n3 p) sur th g0 g1 nex := by
  have hfit : ∀ v, FitsS sur v := fun v => ⟨by rw [hn]; trivial, fun y hy => by rw [hl y hy]; simp⟩
  refine ⟨hp.ext, hp.grow, hp.cfr, hp.lo, hp.hi, hp.ent, hp.regs, hp.dist, hp.eregs, hp.labs, hp.nodup,
    by simp only [sixCount]; exact hp.size, fun s hs => ?_, hp.ncond, hp.econd, ?_⟩
  · left; rw [pureEval_n3]
    rcases hp.nec s hs with h | ⟨x, _, h2⟩
    · rw [h]; rfl
    · exact absurd (hfit x) h2
  · intro cf hcf c ned σ O st t gul s0 s ag hned regs hh hn'
    have H := hp.sem cf hcf c ned σ O st t gul s0 s ag hned regs hh hn'
    rw [pureEval_n3]
    cases e : pureEval p s with
    | none => rw [e] at H; exact goalSem_none _ H
    | some x =>
      rw [e] at H
      obtain ⟨regs', _, hk, he⟩ := H.1 (hfit x)
      exact ⟨fun _ => ⟨regs', by rw [hn]; trivial, hk, he⟩, fun hf => absurd (hfit _) hf⟩

/-- **`[3 p]` under a fork-free `%next`** with an `OKNV` operand. -/
theorem runOKNV_n3 (lib : Lib) {p : Nomm} (hp : OKNV (S := S) (Map := Map) lib p) :
    OKNV (S := S) (Map := Map) lib (Nomm.n3 p) := by
  intro sur th region g0 g1 nex hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h
  simp only [sixCount] at hcount
  have e3 : (runL (Nomm.n3 p) (CGoalL.next (ofSure sur) th) region : CM Map (NextL S)) =
      if noneEquivalentL (ofSure sur) then runL p (CGoalL.next (ofSure sur) th) region else (do
        let a ← collapseLazyAtomL ⟨ofSure sur, th⟩
        match a with
        | Option.none => fun _ => Option.none
        | some (r, o) => do
            let (z, o') ← forl r o
            let r' ← re
            let oc ← emit ⟨[], [], Termin.clq r' (jmp0 z) (jmp0 o')⟩
            runL p (CGoalL.next (ofSure (lazyReg r')) (jmp0 oc)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e3, noneEquivalentL_ofSure] at h
  by_cases en : noneEquivalent sur = true
  · rw [if_pos en] at h
    have en' := en
    simp only [noneEquivalent, Bool.and_eq_true, decide_eq_true_eq, HoonSet.small_iff] at en'
    exact runOKNV_n3_of_none en'.1 en'.2 (hp hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h)
  rw [if_neg en, collapseLazyAtomL_mk] at h
  obtain ⟨a, g2, h2, h⟩ := bind_some h
  obtain ⟨E2, ea, _, hsome⟩ := collapse_ok h2
  have C := collapse_down h2 hj.1 hj.2 b0
  have c2 : g2.cond = g0.cond := (kc_collapseLazyAtom _).keep g0 a g2 h2
  rcases a with _ | ⟨r, o⟩
  · cases h
  obtain ⟨hmr, _, hs⟩ := hsome r o rfl
  obtain ⟨ka, ra⟩ := keepsA_collapseLazyAtom (P := (fun r => HoonMap.get g0.cond r = Option.none)) (nex := ⟨sur, th⟩)
    d0 hkg (fun r hr => condBelow_none hcb hr) h2
  have kb := (keeps_collapseLazyAtom (nex := ⟨sur, th⟩) d0 (fun r hr => hok.2 r hr) h2).1
  obtain ⟨⟨z, o'⟩, g3, h3, h⟩ := bind_some h
  have hr : r < g2.re := by
    rcases hmr with hm | ⟨_, h2⟩
    · exact Nat.lt_of_lt_of_le (hok.2 r hm) E2.1
    · exact h2
  obtain ⟨E3, er3, eb3, F⟩ := forl_ok h3 hr
  have Co := C.2 r o rfl
  have Fd := forl_down h3 Co.1 Co.2 (Nat.le_trans b0 C.1.bo)
  have c3 : g3.cond = g2.cond := (kc_forl r o).keep g2 _ g3 h3
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have Ep := (ext_re g3).trans (ext_emit { g3 with re := g3.re + 1 } ⟨[], [], Termin.clq g3.re (jmp0 z) (jmp0 o')⟩)
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have d3 : g3.drop = false := E3.2.2.1.trans d2
  have bo3 : g0.bo ≤ g3.bo := Nat.le_trans C.1.bo E3.2.1
  have G : Grow g0 ({ g3 with re := g3.re + 1 }.emitted ⟨[], [], Termin.clq g3.re (jmp0 z) (jmp0 o')⟩) :=
    C.1.trans (Fd.1.trans ((grow_re _).trans (grow_emit (jumpsBelow_two rfl Fd.2.1 Fd.2.2))))
  have Rp := hp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d3) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_trans (Nat.le_trans E2.1 E3.1) (Nat.le_succ _))
      (c3.trans c2)) hcb)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr; subst hr
      show HoonMap.get g3.cond _ = _
      rw [c3, c2]; exact condBelow_none hcb (Nat.le_trans E2.1 E3.1)) h
  refine unaryNV_ok (pureEval_n3 p) (E2.trans (E3.trans Ep)) (G.toU hu) (c3.trans c2)
    ⟨by have := E2.1; have := E3.1; omega, by simp [emitted_re]⟩ (by simp [emitted_bo])
    (fresh_emitted (by simpa using d3) rfl rfl) Rp rfl
    (fix_of_keeps (gs := g0) rfl (ka.trans ((keepsA_forl d2 (ra r o rfl) (fun r' hr' => condBelow_none hcb
        (Nat.le_trans E2.1 hr')) h3).trans ((keepsA_reg _ g3 _ (Nat.le_succ _)).trans (keepsA_emitted d3
        (blobIn_fin ⟨condBelow_none hcb (Nat.le_trans E2.1 E3.1), jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩)))))
      (kb.trans ((keeps_forl d2 hr h3).trans ((keeps_reg g3 _ (Nat.le_succ _)).trans (keeps_emitted d3
        (blobIn_fin ⟨Nat.lt_succ_self _, jmpIn_jmp0 _ _, jmpIn_jmp0 _ _⟩))))))
    ?_
  intro c hc σ O st regs t gul x hx
  have hb := emitted_get' (by simpa using d3) (hc _ bo3 (by simp [emitted_bo]))
  have hj' := goJ_jmp0 (lib := lib) (O := O) (gul := gul) (st := st) regs t _ _ hb
  rw [execBlob_clq, hx, Option.bind_some] at hj'
  have F' := F d2 c ((hc.right E2).left E3 Ep) lib σ O st regs t gul
  have hag2 : Agree c g0 g2 := hc.left E2 (E3.trans Ep)
  have keep : ∀ (v : Noun) (k : Nat) (rr : Nat), (k = g2.re ∨ k = g2.re + 1) → (rr < g0.re ∨ g3.re + 1 ≤ rr) →
      ¬ NMem sur.ned rr → SkaModel.read rr (store r v (store k v regs)) = SkaModel.read rr regs := by
    intro v k rr hk k1 k2
    have := er3
    have hne : rr ≠ r := fun e => by
      subst e
      rcases hmr with hm | ⟨hm, _⟩
      · exact k2 hm
      · omega
    rw [read_store_ne hne, read_store_ne (show rr ≠ k by have := E2.1; omega)]
  cases x with
  | cell u v =>
    exact GoalSem.transfer (hj'.trans F'.1)
      (fun rr ⟨k1, k2⟩ => keep (A 0) g2.re rr (Or.inl rfl) (by simpa [emitted_re] using k1) k2)
      (hs d0 c hag2 lib σ O st (store r (A 0) (store g2.re (A 0) regs)) t gul 0 (read_store_eq _ _ _))
  | atom n =>
    exact GoalSem.transfer (hj'.trans F'.2)
      (fun rr ⟨k1, k2⟩ => keep (A 1) (g2.re + 1) rr (Or.inr rfl) (by simpa [emitted_re] using k1) k2)
      (hs d0 c hag2 lib σ O st (store r (A 1) (store (g2.re + 1) (A 1) regs)) t gul 1 (read_store_eq _ _ _))

/-- **The tag clause of `[3 p]` under `%next`.** -/
theorem three_tagNV (lib : Lib) {p : Nomm} (tp : TagNV (S := S) (Map := Map) p) :
    TagNV (S := S) (Map := Map) (Nomm.n3 p) := by
  intro sur th region g0 g1 nex hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h
  simp only [sixCount] at hcount
  have e3 : (runL (Nomm.n3 p) (CGoalL.next (ofSure sur) th) region : CM Map (NextL S)) =
      if noneEquivalentL (ofSure sur) then runL p (CGoalL.next (ofSure sur) th) region else (do
        let a ← collapseLazyAtomL ⟨ofSure sur, th⟩
        match a with
        | Option.none => fun _ => Option.none
        | some (r, o) => do
            let (z, o') ← forl r o
            let r' ← re
            let oc ← emit ⟨[], [], Termin.clq r' (jmp0 z) (jmp0 o')⟩
            runL p (CGoalL.next (ofSure (lazyReg r')) (jmp0 oc)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e3, noneEquivalentL_ofSure] at h
  by_cases en : noneEquivalent sur = true
  · rw [if_pos en] at h
    have en' := en
    simp only [noneEquivalent, Bool.and_eq_true, decide_eq_true_eq, HoonSet.small_iff] at en'
    exact tp hj hth hok hcl hcount b0 d0 hu hcl0 hcb hkg h
  rw [if_neg en, collapseLazyAtomL_mk] at h
  obtain ⟨a, g2, h2, h⟩ := bind_some h
  obtain ⟨E2, ea, _, hsome⟩ := collapse_ok h2
  have C := collapse_down h2 hj.1 hj.2 b0
  have c2 : g2.cond = g0.cond := (kc_collapseLazyAtom _).keep g0 a g2 h2
  rcases a with _ | ⟨r, o⟩
  · cases h
  obtain ⟨hmr, _, hs⟩ := hsome r o rfl
  obtain ⟨ka, ra⟩ := keepsA_collapseLazyAtom (P := (fun r => HoonMap.get g0.cond r = Option.none)) (nex := ⟨sur, th⟩)
    d0 hkg (fun r hr => condBelow_none hcb hr) h2
  have kb := (keeps_collapseLazyAtom (nex := ⟨sur, th⟩) d0 (fun r hr => hok.2 r hr) h2).1
  obtain ⟨⟨z, o'⟩, g3, h3, h⟩ := bind_some h
  have hr : r < g2.re := by
    rcases hmr with hm | ⟨_, h2⟩
    · exact Nat.lt_of_lt_of_le (hok.2 r hm) E2.1
    · exact h2
  obtain ⟨E3, er3, eb3, F⟩ := forl_ok h3 hr
  have Co := C.2 r o rfl
  have Fd := forl_down h3 Co.1 Co.2 (Nat.le_trans b0 C.1.bo)
  have c3 : g3.cond = g2.cond := (kc_forl r o).keep g2 _ g3 h3
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have Ep := (ext_re g3).trans (ext_emit { g3 with re := g3.re + 1 } ⟨[], [], Termin.clq g3.re (jmp0 z) (jmp0 o')⟩)
  have d2 : g2.drop = false := E2.2.2.1.trans d0
  have d3 : g3.drop = false := E3.2.2.1.trans d2
  have bo3 : g0.bo ≤ g3.bo := Nat.le_trans C.1.bo E3.2.1
  have G : Grow g0 ({ g3 with re := g3.re + 1 }.emitted ⟨[], [], Termin.clq g3.re (jmp0 z) (jmp0 o')⟩) :=
    C.1.trans (Fd.1.trans ((grow_re _).trans (grow_emit (jumpsBelow_two rfl Fd.2.1 Fd.2.2))))
  have Tp := tp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d3) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu))
    (CondFresh.below (condFresh_of_eq (g0 := g0) (Nat.le_trans (Nat.le_trans E2.1 E3.1) (Nat.le_succ _))
      (c3.trans c2)) hcb)
    (fun r hr => by
      simp only [lazyReg, NMem] at hr; subst hr
      show HoonMap.get g3.cond _ = _
      rw [c3, c2]; exact condBelow_none hcb (Nat.le_trans E2.1 E3.1)) h
  exact (CondTag.of_eq (c3.trans c2)).trans Tp

/-- **The tag clause of `[3 p]` for `%pick`.** -/
theorem three_tagP (lib : Lib) {p : Nomm} (tp : TagNV (S := S) (Map := Map) p) (z o : Jmp) :
    TagV (Map := Map) (CGoal.pick z o : CGoal S) (Nomm.n3 p) := by
  intro region g0 g1 nex _ hj hcount b0 d0 hu hcl0 hcb h
  simp only [sixCount] at hcount
  have e3 : (runL (Nomm.n3 p) (CGoal.toL (CGoal.pick z o : CGoal S)) region : CM Map (NextL S)) = (do
      let r ← re
      let oc ← emit ⟨[], [], Termin.clq r z o⟩
      runL p (CGoalL.next (ofSure (lazyReg r)) (jmp0 oc)) region) := by
    conv => lhs; unfold runL
    rfl
  rw [e3] at h
  simp only [bind_apply, re_apply, emit_apply, Option.bind_some] at h
  have G := (grow_re g0).trans (grow_emit (b := ⟨[], [], Termin.clq g0.re z o⟩) (jumpsBelow_two rfl hj.1 hj.2))
  have Tp := tp ⟨by simp only [jmp0]; omega, by simp only [jmp0, emitted_bo]; omega⟩ rfl
    (by exact ⟨trivial, fun r hr => by simp [lazyReg, NMem] at hr; subst hr; simp [emitted_re]⟩) (by exact trivial)
    hcount (by simp only [emitted_bo]; omega) (by simpa [emitted_drop] using d0) ((G.toU hu).up hu)
    (hcl0.growU (G.toU hu)) (CondFresh.below (condFresh_of_eq (g0 := g0) (by romega) rfl) hcb)
    (fun r hr => by simp only [lazyReg, NMem] at hr; subst hr; exact condBelow_none hcb (by romega)) h
  exact Tp

/-- **`CleanA` of `[3 p]`** (the case of `runX_clean`). -/
theorem cleanA_three {p : Nomm} (ih : CleanA S Map p) : CleanA S Map (Nomm.n3 p) := by
  intro goal region g0 g1 nex hc h
  cases goal with
  | next sur th =>
    simp only [CGoal.toL] at h
    unfold runL at h
    dsimp only at h
    revert h; split
    · exact fun h => ih (goal := CGoal.next sur th) hc h
    intro h
    obtain ⟨a, _, _, h⟩ := bind_some h
    rcases a with _ | ⟨r, o⟩
    · cases h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨r', _, _, h⟩ := bind_some h
    obtain ⟨oc, _, _, h⟩ := bind_some h
    exact ih (goal := CGoal.next (lazyReg r') (jmp0 oc)) trivial h
  | done =>
    simp only [CGoal.toL] at h
    unfold runL at h
    obtain ⟨_, _, _, h⟩ := bind_some h
    obtain ⟨r, _, _, h⟩ := bind_some h
    obtain ⟨oc, _, _, h⟩ := bind_some h
    exact ih (goal := CGoal.next (lazyReg r) (jmp0 oc)) trivial h
  | pick z o =>
    simp only [CGoal.toL] at h
    unfold runL at h
    obtain ⟨r, _, _, h⟩ := bind_some h
    obtain ⟨oc, _, _, h⟩ := bind_some h
    exact ih (goal := CGoal.next (lazyReg r) (jmp0 oc)) trivial h

