import lemmas.Ska.RunShapeCheck

/-!
# Step 3: is the shape of `+run-shape` the shape of `+run`'s lazy need?

Generated by `tools/gen/runshapecheck.py agree` (2026-11-27).  What the disabled debug flag
`shape-check` of `member` would assert, executed and not proved: on every distinct nomm of
`RunShapeCheck.lean`, under `[%done ~]` with `sup` `~`, from a fresh state, `runShape rsEnv`
against `runLC agEnv` (the model of `+run` with calls, `CompRunLC.lean`; `agEnv` is the
environment of the driver as a `CallEnv`, its `sof` the soft test of `+run`, which `runLC`
does not model).  Kinds: `lcNone` (`runLC` has no result: a hint, `%12`, a soft call),
`rsNone`, `same` (the two lazy needs are equal once the registers and the identifiers are
erased), `col` (they differ, but `+laze-collapse` and `+shape-collapse` give the same shape for
the capes `|` and `[| |]`), `diff` (the collapsed shapes differ).
-/

namespace Formalization
namespace SkaModel
namespace Comp
namespace RunShapeCheck

open Nock Compiler Laze

/-- `rsEnv` as the `CallEnv` of `runLC`. -/
def agEnv : CallEnv :=
  ⟨rsEnv.need, rsEnv.sure, fun b => (rsEnv.pure b).getD false, fun _ => Option.none, rsEnv.pure,
   fun mp p q b ned => softTest rsEnv p q b Option.none ned (rsEnv.sure b) (some mp) == some true⟩

mutual
/-- A `laze` with its identifiers erased. -/
def eraseS : Laze RL → Noun
  | mk s f b => C (C s.ned.toNoun (sortN s.lok.l)) (C (eraseSF f) (eraseSB b))
def eraseSF : List ((Nat × Laze RL) × (Nat × Laze RL)) → Noun
  | [] => A 0
  | ((_, ly), (_, ln)) :: rest => C (C (C (A 0) (eraseS ly)) (C (A 0) (eraseS ln))) (eraseSF rest)
def eraseSB : List (Nat × Laze RL) → Noun
  | [] => A 0
  | (_, l) :: rest => C (C (A 0) (eraseS l)) (eraseSB rest)
end

mutual
/-- A `need-lazy` with its registers and blocks erased. -/
def eraseL : Lazy RL → Noun
  | Lazy.mk s f b => C (C (needToOrd s.ned).toNoun (sortN s.lok.l)) (C (eraseLF f) (eraseLB b))
def eraseLF : List ((Nat × Lazy RL) × (Nat × Lazy RL)) → Noun
  | [] => A 0
  | ((_, ly), (_, ln)) :: rest => C (C (C (A 0) (eraseL ly)) (C (A 0) (eraseL ln))) (eraseLF rest)
def eraseLB : List (Nat × Lazy RL) → Noun
  | [] => A 0
  | (_, l) :: rest => C (C (A 0) (eraseL l)) (eraseLB rest)
end

/-- A hint, `%12` or `%mean` anywhere (`runLC` has none of them). -/
def hintedAny : Nomm → Bool
  | Nomm.cons p q => hintedAny p || hintedAny q
  | Nomm.n2 p q _ => hintedAny p || hintedAny q
  | Nomm.n3 p => hintedAny p
  | Nomm.n4 p => hintedAny p
  | Nomm.n5 p q => hintedAny p || hintedAny q
  | Nomm.n6 p q r => hintedAny p || hintedAny q || hintedAny r
  | Nomm.n7 p q => hintedAny p || hintedAny q
  | Nomm.n10 _ v q => hintedAny v || hintedAny q
  | Nomm.n11s .. => true
  | Nomm.n11d .. => true
  | Nomm.n12 .. => true
  | Nomm.mean .. => true
  | _ => false

/-- The kind of a nomm: 5 a hint, `%12` or `%mean` somewhere (not compared), 0 `lcNone`, 1 `rsNone`, 2 `same`, 3 `col`, 4 `diff`. -/
def kind (n : Nomm) : Nat :=
  if hintedAny n then 5 else
  match (runLC (Map := FM) agEnv Option.none n CGoalL.done [] (genAt 0 1)).map (·.1.laz),
        (runShape (S := RL) rsEnv Option.none n GoalS.done ⟨0, ⟨[]⟩⟩).map (·.1) with
  | Option.none, _ => 0
  | _, Option.none => 1
  | some a, some b =>
    if eraseL a = eraseS b then 2 else
    let capes := [Cape.no, Cape.cell Cape.no Cape.no]
    if capes.all (fun c => shapeCol 64 a c == lazeCollapse 64 b c) then 3 else 4

/-- The tally: how many nomms of each kind. -/
def tally (ns : List Nomm) : List Nat :=
  [0, 1, 2, 3, 4, 5].map fun k => (ns.filter fun n => kind n == k).length

/-- The first nomm of a kind. -/
def firstOf (ns : List Nomm) (k : Nat) : Option Nat := ns.findIdx? fun n => kind n == k


