/+  *nock-compilation
/+  hoot-spotted
/+  hoot-spotted-fol
::
::  FOL <mug of the formula with %spot and %mean hints stripped> <file:line:col>,
::  every identity of the ride graph on the spotted build
::
:-  %say  |=  *
:-  %noun
=/  res
  %-  ~(mule vi |)
  |.
  ~>  %jinx.~m5
  =|  =long-ska
  =.   long-ska  +:(ska-poke [&+~ hoot-spotted-fol] long-ska)
  =/  subject  ..scow:hoot-spotted
  =/  formula=^
    =>  subject
    ;;  ^
    !=
    (scow %ud 5)
  ::
  =^  func=bell  long-ska  (ska-poke [&+subject formula] long-ska)
  =/  subject  ..ride:hoot-spotted
  =/  formula=^
    =>  subject
    ;;  ^
    !=
    (ride %noun '42')
  ::
  =^  func=bell  long-ska  (ska-poke [&+subject formula] long-ska)
  =/  strip
    |=  f=*
    ^-  *
    =*  strip  .
    ?@  f  f
    ~+
    ?:  ?&  =(11 -.f)
            ?=([[?(%spot %mean) *] *] +.f)
        ==
      (strip +>.f)
    [(strip -.f) (strip +.f)]
  ::
  =/  rows=(list tape)
    %+  turn  ~(tap by graph.final.long-ska)
    |=  [id=identity d=datum]
    =/  where=tape
      ?~  area.d  "?"
      :(weld (spud p.u.area.d) ":" (scow %ud p.p.q.u.area.d) ":" (scow %ud q.p.q.u.area.d))
    :(weld "FOL " (scow %ud (mug (strip fol.id))) " " where)
  ::
  %-  (slog (turn rows |=(t=tape leaf+t)))
  [%fols (lent rows)]
?:  ?=(%& -.res)  p.res
(mean p.res)
